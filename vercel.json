{
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/audit-bill",
      "destination": "/api/audit-bill.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/website/$1"
    }
  ]
}
