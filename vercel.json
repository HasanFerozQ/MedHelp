{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/es/medical-calculator", "destination": "/medical-calculator" },
    { "source": "/es/calculators/:path*", "destination": "/calculators/:path*" },
    { "source": "/blog/:slug", "destination": "/blog-post?slug=:slug" },
    { "source": "/usmle-preparation", "destination": "/medical-exam-usmle" }
  ],
  "headers": [
    {
      "source": "/es/(.*)",
      "headers": [{ "key": "X-Language", "value": "es" }]
    }
  ],
  "redirects": [
    {
      "source": "/audit",
      "destination": "/medical-bill-audit",
      "permanent": true
    },
    {
      "source": "/medical-exam-usmle",
      "destination": "/usmle-preparation",
      "permanent": true
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 25
    }
  }
}
