{
  "headers": [
    {
      "source": "/tabs/health-stats/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400, immutable" }
      ]
    }
  ]
}
{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/global-health-statistics",
      "destination": "/global-health-statistics"
    },
    {
      "source": "/global-health-statistics/:category",
      "destination": "/global-health-statistics-detail?category=:category"
    },
    {
      "source": "/es/medical-calculator",
      "destination": "/medical-calculator"
    },
    {
      "source": "/es/calculators/:path*",
      "destination": "/calculators/:path*"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog-post?slug=:slug"
    },
    {
      "source": "/usmle-preparation",
      "destination": "/medical-exam-usmle"
    },
    {
      "source": "/medical-exam-preparation/first-year-mbbs",
      "destination": "/medical-exam-semester?year=1"
    },
    {
      "source": "/medical-exam-preparation/second-year-mbbs",
      "destination": "/medical-exam-semester?year=2"
    },
    {
      "source": "/medical-exam-preparation/third-year-mbbs",
      "destination": "/medical-exam-semester?year=3"
    },
    {
      "source": "/medical-exam-preparation/fourth-year-mbbs",
      "destination": "/medical-exam-semester?year=4"
    }
  ],
  "headers": [
    {
      "source": "/es/(.*)",
      "headers": [
        {
          "key": "X-Language",
          "value": "es"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/audit",
      "destination": "/medical-bill-audit",
      "permanent": true
    },
    {
      "source": "/medical-exam-usmle",
      "destination": "/usmle-preparation",
      "permanent": true
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 25
    }
  }
}