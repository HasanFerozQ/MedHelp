{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/global-health-statistics",
      "destination": "/global-health-statistics"
    },
    {
      "source": "/global-health-statistics/:category",
      "destination": "/api/health-stats?category=:category"
    },
    {
      "source": "/es/tabs/:path*",
      "destination": "/tabs/:path*"
    },
    {
      "source": "/es/styles.css",
      "destination": "/styles.css"
    },
    {
      "source": "/es/medical-calculator",
      "destination": "/api/es-calculator"
    },
    {
      "source": "/es/calculators/:path*",
      "destination": "/api/es-calculator"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog.html"
    },
    {
      "source": "/blog-post",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?slug=:slug"
    },
    {
      "source": "/flash-cards",
      "destination": "/flash-cards.html"
    },
    {
      "source": "/flash-cards/(.*)",
      "destination": "/flash-cards.html"
    },
    {
      "source": "/usmle-preparation",
      "destination": "/medical-exam-usmle"
    },
    {
      "source": "/medical-exam-preparation/first-year-mbbs",
      "destination": "/medical-exam-semester?year=1"
    },
    {
      "source": "/medical-exam-preparation/second-year-mbbs",
      "destination": "/medical-exam-semester?year=2"
    },
    {
      "source": "/medical-exam-preparation/third-year-mbbs",
      "destination": "/medical-exam-semester?year=3"
    },
    {
      "source": "/medical-exam-preparation/fourth-year-mbbs",
      "destination": "/medical-exam-semester?year=4"
    }
  ],
  "headers": [
    {
      "source": "/tabs/health-stats/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400, immutable"
        }
      ]
    },
    {
      "source": "/es/(.*)",
      "headers": [
        {
          "key": "X-Language",
          "value": "es"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/management-education",
      "destination": "/medical-exam-preparation",
      "permanent": true
    },
    {
      "source": "/audit",
      "destination": "/medical-bill-audit",
      "permanent": true
    },
    {
      "source": "/medical-exam-usmle",
      "destination": "/usmle-preparation",
      "permanent": true
    },
    {
      "source": "/medical-exam-preparation.html",
      "destination": "/medical-exam-preparation",
      "permanent": true
    },
    {
      "source": "/medical-exam-semester.html",
      "destination": "/medical-exam-semester",
      "permanent": true
    },
    {
      "source": "/medical-exam-usmle.html",
      "destination": "/usmle-preparation",
      "permanent": true
    },
    {
      "source": "/flash-cards.html",
      "destination": "/flash-cards",
      "permanent": true
    },
    {
      "source": "/medical-exam-mock.html",
      "destination": "/medical-exam-mock",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog-post",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>[^/]+)"
        }
      ],
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/blog-post.html",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>[^/]+)"
        }
      ],
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/blog-post",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog-post.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cpt-code-search.html",
      "destination": "/cpt-code-search",
      "permanent": true
    },
    {
      "source": "/claim-denial-codes.html",
      "destination": "/claim-denial-codes",
      "permanent": true
    },
    {
      "source": "/medical-bill-audit.html",
      "destination": "/medical-bill-audit",
      "permanent": true
    },
    {
      "source": "/audit.html",
      "destination": "/medical-bill-audit",
      "permanent": true
    },
    {
      "source": "/medical-calculator.html",
      "destination": "/medical-calculator",
      "permanent": true
    },
    {
      "source": "/rx-savings.html",
      "destination": "/rx-savings",
      "permanent": true
    },
    {
      "source": "/providers.html",
      "destination": "/providers",
      "permanent": true
    },
    {
      "source": "/global-health-statistics.html",
      "destination": "/global-health-statistics",
      "permanent": true
    },
    {
      "source": "/medical-exam-nbme.html",
      "destination": "/medical-exam-nbme",
      "permanent": true
    },
    {
      "source": "/medical-exam-simulator.html",
      "destination": "/medical-exam-simulator",
      "permanent": true
    },
    {
      "source": "/medical-exam-simulator-step3.html",
      "destination": "/medical-exam-simulator-step3",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/editorial-policy.html",
      "destination": "/editorial-policy",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/refund.html",
      "destination": "/refund",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 25
    }
  }
}
