          cards: [
            { q: "Primary site of involvement in Crohn’s Disease?", a: "Terminal ileum (though it can affect any part of the GI tract)." },
            { q: "Defining endoscopic appearance of Crohn’s Disease?", a: "Cobblestoning and skip lesions." },
            { q: "Characteristic biopsy finding in Crohn’s Disease?", a: "Non-caseating granulomas." },
            { q: "Most common site for Ulcerative Colitis (UC)?", a: "Rectum (always involved) with continuous proximal spread." },
            { q: "Depth of inflammation in Ulcerative Colitis?", a: "Mucosa and submucosa only." },
            { q: "Depth of inflammation in Crohn’s Disease?", a: "Transmural inflammation." },
            { q: "Radiographic sign associated with chronic Ulcerative Colitis?", a: "\"Lead pipe\" appearance due to loss of haustra." },
            { q: "Serologic marker often positive in UC?", a: "p-ANCA." },
            { q: "Serologic marker often positive in Crohn’s Disease?", a: "ASCA (Anti-Saccharomyces cerevisiae antibodies)." },
            { q: "Most common fistula type in Crohn's Disease?", a: "Perianal fistula." },
            { q: "IBD subtype associated with Primary Sclerosing Cholangitis (PSC)?", a: "Ulcerative Colitis." },
            { q: "Extra-intestinal manifestation common to both UC and Crohn's?", a: "Erythema nodosum or Pyoderma gangrenosum." },
            { q: "Maintenance therapy for mild-to-moderate UC?", a: "5-ASA compounds (Mesalamine, Sulfasalazine)." },
            { q: "Standard treatment for an acute IBD flare?", a: "Corticosteroids (Prednisone or IV Methylprednisolone)." },
            { q: "Curative surgical procedure for Ulcerative Colitis?", a: "Total proctocolectomy. Part 2: Gastrointestinal Bleeding (GIB)" },
            { q: "Anatomical landmark separating Upper from Lower GI bleed?", a: "Ligament of Treitz." },
            { q: "Most common cause of Upper GI Bleed (UGIB)?", a: "Peptic Ulcer Disease (PUD)." },
