                            {
                                      "q": "Precise molecular mutation in <b>Sickle Cell Anemia</b>?",
                                      "a": "Glutamic acid replaced by Valine at position 6 of the &beta;-globin chain."
                            },
                            {
                                      "q": "Primary cause of RBC sickling in HbS patients?",
                                      "a": "Deoxygenation (hypoxia), dehydration, or acidosis."
                            },
                            {
                                      "q": "Most common cause of osteomyelitis in <b>Sickle Cell</b> patients?",
                                      "a": "<i>Salmonella</i>."
                            },
                            {
                                      "q": "Mutation in Hemoglobin C (HbC)?",
                                      "a": "Glutamic acid replaced by Lysine at position 6 of the &beta;-globin chain."
                            },
                            {
                                      "q": "Mechanism of <b>Paroxysmal Nocturnal Hemoglobinuria</b> (<b>PNH</b>)?",
                                      "a": "Acquired PIGA gene mutation leading to loss of GPI anchor and decay-accelerating factor (CD55/59)."
                            },
                            {
                                      "q": "Classic presentation of <b>PNH</b>?",
                                      "a": "Dark urine in the morning and increased risk of venous thrombosis (e.g., Budd-Chiari syndrome)."
