            {
              "q": "Cause of \"Rabbit Fever\" (Tularemia)?",
              "a": "<i><i>Francisella</i> tularensis</i>."
            },
            {
              "q": "Primary vector for <i>Borrelia burgdorferi</i>?",
              "a": "<i>Ixodes</i> tick (also carries Babesia and Anaplasma)."
            },
            {
              "q": "Common infection following a dog or cat bite?",
              "a": "<i>Pasteurella</i> multocida (cellulitis within 24 hours)."
            },
            {
              "q": "Organism causing \"Q Fever\"?",
              "a": "<i>Coxiella burnetii</i> (atypical pneumonia, no rash, negative Weil-Felix)."
            },
            {
              "q": "Presentation of <i>Leptospira interrogans</i> (<b>Weil Disease</b>)?",
              "a": "Jaundice, photophobia, conjunctival suffusion (redness without exudate)."
            },
            {
              "q": "Vector for Leishmaniasis?",
              "a": "Sandfly."
            },
            {
              "q": "Definition of \"<b>Cold Agglutinins</b>\"?",
              "a": "IgM antibodies that agglutinate RBCs at low temperatures; seen in <i>Mycoplasma pneumoniae</i>."
            },
            {
              "q": "Mechanism of <i><i>Vibrio</i> cholerae</i> diarrhea?",
              "a": "Permanent activation of Gs protein &rarr; &uarr; cAMP &rarr; secretion of Cl<sup>-</sup> into gut lumen."
            },
            {
              "q": "Most common cause of bacterial enterocolitis in the US?",
              "a": "<i>Campylobacter jejuni</i>."
            },
            {
              "q": "Bug associated with reactive arthritis (Reiter\u2019s Syndrome)?",
              "a": "Shigella, <i>Salmonella</i>, Campylobacter, <i>Chlamydia</i>."
            },
            {
              "q": "Identifying feature of Corynebacterium diphtheriae?",
              "a": "Gram-positive rods with \"Chinese letter\" or club-shaped appearance; metachromatic granules."
            },
            {
              "q": "Cause of \"<b>Biliary Tract Disease</b>\" and Cholangiocarcinoma in Asia?",
              "a": "<i>Clonorchis sinensis</i> (Chinese liver fluke)."
            },
            {
              "q": "Mechanism of Vitamin B12 deficiency via parasite?",
              "a": "<i>Diphyllobothrium latum</i> (Fish tapeworm) competes for B12 in the intestine."
            },
            {
              "q": "Parasite associated with Portal Hypertension and Splenomegaly?",
              "a": "<i>Schistosoma mansoni</i> or <i>Schistosoma japonicum</i> (eggs in mesenteric veins)."
            },
            {
              "q": "Classic symptom of <i>Sarcoptes scabiei</i>?",
              "a": "Intense pruritus (worse at night) and serpiginous burrows in finger webs/wrists."
            },
            {
              "q": "Finding in <i>Strongyloides stercoralis</i> infection?",
              "a": "Rhabditiform larvae in the stool (can cause hyperinfection syndrome in immunocompromised)."
            },
            {
              "q": "Appearance of <i>Coccidioides immitis</i> in tissue?",
              "a": "Spherules filled with endospores (found in Southwestern US/San Joaquin Valley)."
            },
            {
              "q": "Culture method for most fungi?",
              "a": "Sabouraud dextrose agar."
            },
            {
              "q": "\"Captain's Wheel\" yeast formation?",
              "a": "<i>Paracoccidiodes brasiliensis</i> (Latin America)."
            },
            {
              "q": "Primary risk factor for <i>Mucor</i> or <i>Rhizopus</i> infection?",
              "a": "Diabetic Ketoacidosis (DKA) or neutropenia (fungus invades cribriform plate)."
            },
            {
              "q": "Bug associated with \"Currant Jelly\" sputum?",
              "a": "<i>Klebsiella pneumoniae</i>."
            },
            {
              "q": "Cause of \"Water-house Friderichsen Syndrome\"?",
              "a": "<i>Neisseria meningitidis</i> (leads to adrenal insufficiency/hemorrhage)."
            },
            {
              "q": "Most common cause of \"Otitis Externa\"?",
              "a": "<i>Pseudomonas</i> aeruginosa."
            },
            {
              "q": "Characteristic rash of \"Secondary Syphilis\"?",
              "a": "Maculopapular rash on palms and soles; condylomata lata."
            },
            {
              "q": "Finding in \"Congenital Syphilis\"?",
              "a": "<b>Hutchinson teeth</b>, saddle nose, <b>saber shins</b>, deafness."
            },
            {
              "q": "\"<b>Double zone of hemolysis</b>\" on blood agar?",
              "a": "<i>Clostridium</i> perfringens."
            },
            {
              "q": "Mechanism of <b>Vancomycin</b> resistance?",
              "a": "Mutation of D-Ala-D-Ala to D-Ala-D-Lac."
            },
            {
              "q": "Mechanism of Tetracyclines?",
              "a": "Bind 30S subunit; prevent attachment of aminoacyl-tRNA."
            },
            {
              "q": "Effect of Rifampin on the liver?",
              "a": "Potent inducer of Cytochrome P450 (interacts with Warfarin, OCPs)."
            },
            {
              "q": "Mechanism of Trimethoprim?",
              "a": "Inhibits dihydrofolate reductase (DHFR)."
            },
            {
              "q": "Which antibiotic causes \"<b>Red Man Syndrome</b>\"?",
              "a": "<b>Vancomycin</b> (due to rapid histamine release; prevented by slow infusion)."
            },
            {
              "q": "Unique side effect of Linezolid?",
              "a": "Bone marrow suppression (thrombocytopenia) and Serotonin Syndrome."
            },
            {
              "q": "Family of Hepatitis C Virus?",
              "a": "Flaviviridae."
            },
            {
              "q": "Marker of \"Immunity\" to Hepatitis B?",
              "a": "Anti-HBs antibody (and negative HBsAg)."
            },
            {
              "q": "Virus causing \"Hemorrhagic Cystitis\"?",
              "a": "Adenovirus (usually types 11 or 21)."
            },
            {
              "q": "Major characteristic of Reovirus (Rotavirus)?",
              "a": "Segmented, double-stranded RNA virus; major cause of infantile diarrhea."
            },
            {
              "q": "Virus associated with \"Progressive Multifocal Leukoencephalopathy\" (PML)?",
              "a": "JC Virus (Polyomavirus)."
            },
            {
              "q": "Which RNA virus is \"Ambisese\"?",
              "a": "Arenavirus (e.g., Lassa fever)."
            },
            {
              "q": "Defining feature of Prion diseases on histology?",
              "a": "Spongiform encephalopathy (vacuolation of neurons)."
            },
            {
              "q": "Bug associated with infective endocarditis in Colorectal Cancer?",
              "a": "Streptococcus bovis (now <i>S. gallolyticus</i>)."
            },
            {
              "q": "Cause of \"Lemierre Syndrome\"?",
              "a": "<i>Fusobacterium</i> necrophorum (internal jugular vein thrombosis following pharyngitis)."
            },
            {
              "q": "\"Fried-egg\" appearance of colonies?",
              "a": "Mycoplasma species."
            },
            {
              "q": "Common cause of food poisoning from \"Reheated Rice\"?",
              "a": "<i>Bacillus cereus</i>."
            },
            {
              "q": "Bug associated with \"Rose Spots\" on the abdomen?",
              "a": "<i><i>Salmonella</i> typhi</i>."
            },
            {
              "q": "Morphology of Neisseria?",
              "a": "Gram-negative \"kidney-bean\" shaped diplococci."
            },
            {
              "q": "Cause of \"Pseudoappendicitis\"?",
              "a": "<i>Yersinia enterocolitica</i>."
            },
            {
              "q": "Patient with \"descending paralysis\" after eating home-canned food?",
              "a": "<i>Clostridium</i> botulinum (Botulism)."
            },
            {
              "q": "Child with \"barking\" cough and \"steeple sign\" on X-ray?",
              "a": "Parainfluenza virus (Croup)."
            },
            {
              "q": "\"Thumbprint sign\" on lateral neck X-ray?",
              "a": "Epiglottitis (typically <i>Haemophilus influenzae</i> type b)."
            },
            {
              "q": "Patient with \"watery diarrhea\" after traveling to Mexico; Lab shows \"comma-shaped\" organisms?",
              "a": "<i><i>Vibrio</i> cholerae</i>."
            },
            {
              "q": "\"Currant jelly\" sputum in an alcoholic patient?",
              "a": "<i>Klebsiella pneumoniae</i>."
            },
            {
              "q": "High fever and login-bradycardia (Faget sign) with \"rose spots\" on abdomen?",
              "a": "<i><i>Salmonella</i> typhi</i> (Typhoid fever)."
            },
            {
              "q": "\"Bulging fontanelle\" and stiff neck in a 2-week-old neonate?",
              "a": "Streptococcus agalactiae (Group B Strep), E. coli, or Listeria."
            },
            {
              "q": "Facial \"<b>sulfur granules</b>\" draining from a jaw abscess?",
              "a": "<i><i>Actinomyces</i> israelii</i>."
            },
            {
              "q": "Splenic rupture following a sore throat and extreme fatigue?",
              "a": "Epstein-Barr Virus (Infectious <b>Mononucleosis</b>)."
            },
            {
              "q": "\"Owl\u2019s eye\" intranuclear inclusions in a biopsy?",
              "a": "Cytomegalovirus (CMV)."
            },
            {
              "q": "\"Spaghetti and meatballs\" appearance on KOH prep?",
              "a": "<i>Malassezia furfur</i> (<i>Tinea versicolor</i>)."
            },
            {
              "q": "Yeast with \"narrow-based budding\" and a thick capsule?",
              "a": "<i>Cryptococcus neoformans</i>."
            },
            {
              "q": "\"<b>Maltese cross</b>\" inside Red Blood Cells?",
              "a": "<i>Babesia microti</i>."
            },
            {
              "q": "Flask-shaped colonic ulcers?",
              "a": "<i>Entamoeba histolytica</i>."
            },
            {
              "q": "Peri-anal itching in a child, diagnosed with a \"Scotch Tape\" test?",
              "a": "<i>Enterobius vermicularis</i> (Pinworm)."
            },
            {
              "q": "Worm infection associated with B12 deficiency?",
              "a": "<i>Diphyllobothrium latum</i> (Fish tapeworm)."
            },
            {
              "q": "Organism causing \"Mega-colon\" and \"Mega-esophagus\" in South America?",
              "a": "<i>Trypanosoma cruzi</i> (<b>Chagas</b> disease)."
            },
            {
              "q": "Antibiotic that causes \"Yellow Teeth\" in children?",
              "a": "Tetracyclines."
            },
            {
              "q": "Mechanism of Methicillin resistance in <i>S. aureus</i> (<b>MRSA</b>)?",
              "a": "Alteration of Penicillin-Binding Protein (PBP 2a) via mecA gene."
            },
            {
              "q": "Antibiotic associated with \"<b>Red Man Syndrome</b>\"?",
              "a": "<b>Vancomycin</b> (infusion-related histamine release)."
            },
            {
              "q": "Antibiotic class that can cause Achilles tendon rupture?",
              "a": "<b>Fluoroquinolones</b> (e.g., Ciprofloxacin)."
            },
            {
              "q": "Medication used for \"prophylaxis\" in someone exposed to <i>Neisseria meningitidis</i>?",
              "a": "Rifampin (or Ciprofloxacin/Ceftriaxone)."
            },
            {
              "q": "Treatment for <i>Pneumocystis jirovecii</i> pneumonia (PCP)?",
              "a": "Trimethoprim-Sulfamethoxazole (TMP-SMX)."
            },
            {
              "q": "Mechanism of Macrolide resistance?",
              "a": "Methylation of the 23S rRNA binding site."
            },
            {
              "q": "Viral family of HIV?",
              "a": "Retroviridae (Lentivirus genus)."
            },
            {
              "q": "Only DNA virus that replicates in the cytoplasm?",
              "a": "<i>Poxvirus</i> (e.g., Smallpox, Molluscum contagiosum)."
            },
            {
              "q": "Only RNA virus that replicates in the nucleus?",
              "a": "Orthomyxovirus (<i>Influenza</i>) and <i>Retroviruses</i>."
            },
            {
              "q": "Definition of \"<b>Antigenic Shift</b>\" in <i>Influenza</i>?",
              "a": "Genetic reassortment of segments (causes pandemics)."
            },
            {
              "q": "Definition of \"<b>Antigenic Drift</b>\" in <i>Influenza</i>?",
              "a": "Random mutation of Hemagglutinin/Neuraminidase (causes epidemics/seasonal flu)."
            },
            {
              "q": "Virus causing \"<b>slapped cheek</b>\" rash (Erythema Infectiosum)?",
              "a": "<i>Parvovirus B19</i>."
            },
            {
              "q": "High-risk <b>HPV</b> types for cervical cancer?",
              "a": "<b>HPV</b> 16 and 18."
            },
            {
              "q": "Viral cause of \"Hemorrhagic Cystitis\"?",
              "a": "Adenovirus (Types 11 and 21)."
            },
            {
              "q": "Staining method for Mycobacterium tuberculosis?",
              "a": "Ziehl-Neelsen (Acid-Fast) stain."
            },
            {
              "q": "Medium used to culture Corynebacterium diphtheriae?",
              "a": "<b>L\u00f6ffler</b>\u2019s medium or <b>Tellurite</b> agar."
            },
            {
              "q": "Medium used to culture Neisseria species?",
              "a": "<b>Thayer-Martin</b> (<b>VPN</b>) Agar."
            },
            {
              "q": "Organism that requires \"Charcoal Yeast Extract\" agar?",
              "a": "<i>Legionella</i> pneumophila."
            },
            {
              "q": "\"Fried-egg\" appearance on culture?",
              "a": "<i>Mycoplasma pneumoniae</i>."
            },
            {
              "q": "Which bug is \"<b>Urease</b> Positive\"?",
              "a": "Proteus, H. pylori, Ureaplasma, <i>Nocardia</i>, Cryptococcus, <i>S. saprophyticus</i>. (Mnemonic: PUNCH)."
            },
            {
              "q": "Infection from a \"Dog or Cat bite\"?",
              "a": "<i>Pasteurella</i> multocida."
            },
            {
              "q": "\"Undulant fever\" from unpasteurized dairy?",
              "a": "<i>Brucella</i> species."
            },
            {
              "q": "Infection from skinning rabbits?",
              "a": "<i><i>Francisella</i> tularensis</i>."
            },
            {
              "q": "Vector for \"Lyme Disease\"?",
              "a": "<i>Ixodes</i> tick."
            },
            {
              "q": "Vector for \"Rocky Mountain Spotted Fever\"?",
              "a": "<i>Dermacentor</i> tick."
            },
            {
              "q": "Diagnostic test for <i>Legionella</i> pneumophila?",
              "a": "Urine antigen test (fastest) or culture on BCYE agar."
            },
            {
              "q": "Virulence factor of <i>H. influenzae</i> type b (Hib)?",
              "a": "Polyribosylribitol phosphate (PRP) capsule."
            },
            {
              "q": "Why is <i>Pseudomonas</i> aeruginosa common in Cystic Fibrosis?",
              "a": "It forms a mucoid polysaccharide biofilm (alginate) in the lungs."
            },
            {
              "q": "\"Whooping cough\" toxin mechanism?",
              "a": "Pertussis toxin: Disables Gi, increasing cAMP (leads to impaired phagocytosis)."
            },
            {
              "q": "Difference between <i>H. influenzae</i> and H. ducreyi?",
              "a": "<i>H. influenzae</i> causes respiratory issues; H. ducreyi causes \"painful\" chancroid (STD)."
            },
            {
              "q": "Late neurological complication of Measles (Rubeola)?",
              "a": "Subacute Sclerosing Panencephalitis (SSPE) occurring years later."
            },
            {
              "q": "Virus associated with \"Nasopharyngeal Carcinoma\"?",
              "a": "Epstein-Barr Virus (EBV)."
            },
            {
              "q": "Typical CBC finding in Infectious <b>Mononucleosis</b>?",
              "a": "Atypical lymphocytes (reactive CD8+ T cells) on peripheral smear."
            },
            {
              "q": "Only RNA virus with a \"Double-Stranded\" genome?",
              "a": "Reovirus (Rotavirus)."
            },
            {
              "q": "Most common cause of \"Bronchiolitis\" in infants?",
              "a": "Respiratory Syncytial Virus (RSV)."
            },
            {
              "q": "Leading cause of \"Fatal Sporadic Encephalitis\" in the US?",
              "a": "Herpes Simplex Virus-1 (HSV-1) (affects temporal lobes)."
            },
            {
              "q": "Best initial test for suspected <i>C. difficile</i>?",
              "a": "Stool PCR or Enzyme Immunoassay (EIA) for toxins A and B."
            },
            {
              "q": "Gold standard test for \"Malaria\"?",
              "a": "Thick and thin blood smears."
            },
            {
              "q": "Most sensitive test for \"<i>Chlamydia</i>\" and \"Gonorrhea\"?",
              "a": "Nucleic Acid Amplification Test (NAAT)."
            },
            {
              "q": "Diagnostic test for \"Pinworm\" (Enterobius)?",
              "a": "Cellulose tape (Scotch tape) test to find eggs perianally."
            },
            {
              "q": "Appearance of Plasmodium falciparum on blood smear?",
              "a": "Crescent-shaped (banana-shaped) gametocytes and multiple ring forms."
            },
            {
              "q": "Intermediate host of Schistosoma species?",
              "a": "Freshwater snails."
            },
            {
              "q": "Parasite causing \"<b>Elephantiasis</b>\" (lymphatic filariasis)?",
              "a": "Wuchereria bancrofti."
            },
            {
              "q": "Treatment for \"Neurocysticercosis\" (T. solium)?",
              "a": "Albendazole and Praziquantel (+ steroids to reduce inflammation)."
            },
            {
              "q": "Cytokine that stimulates \"Isotype Switching\" to IgE?",
              "a": "IL-4."
            },
            {
              "q": "Immune deficiency making patients susceptible to \"Catalase Positive\" organisms?",
              "a": "Chronic Granulomatous Disease (CGD) due to NADPH oxidase deficiency."
            },
            {
              "q": "\"Opsonins\" that enhance phagocytosis?",
              "a": "IgG and C3b."
            },
            {
              "q": "Mechanism of \"Type II\" Hypersensitivity?",
              "a": "Cytotoxic: Antibodies (IgG/IgM) bind to antigens on cell surfaces (e.g., Rheumatic Fever)."
            },
            {
              "q": "Component of Gram-negative cell walls that triggers \"Septic Shock\"?",
              "a": "<b>Lipid A</b> (part of Lipopolysaccharide/<b>LPS</b>)."
            },
            {
              "q": "\"<b>Saber shins</b>\" and \"<b>Hutchinson teeth</b>\" are signs of?",
              "a": "Congenital Syphilis."
            },
            {
              "q": "Bug associated with \"Reiter Syndrome\" (can't see, can't spit, can't climb a tree)?",
              "a": "<i>Chlamydia</i> trachomatis."
            },
            {
              "q": "Most common cause of \"Subacute Endocarditis\" after dental work?",
              "a": "Viridans group Streptococci."
            },
            {
              "q": "Bacteria that causes \"Struvite\" (Staghorn) renal stones?",
              "a": "<i>Proteus mirabilis</i> (via <b>Urease</b> production)."
            },
            {
              "q": "\"<b>Ecthyma gangrenosum</b>\" is pathognomonic for?",
              "a": "<i>Pseudomonas</i> aeruginosa sepsis."
            },
            {
              "q": "\"<b>Waterhouse-Friderichsen</b> Syndrome\" involves which gland?",
              "a": "Adrenal glands (hemorrhagic necrosis)."
            },
            {
              "q": "Mechanism of \"Sulfonamides\"?",
              "a": "PABA antimetabolites; inhibit Dihydropteroate synthase."
            },
            {
              "q": "Mechanism of \"Trimethoprim\"?",
              "a": "Inhibits Dihydrofolate reductase."
            },
            {
              "q": "Side effect of \"Ethambutol\"?",
              "a": "Optic neuritis (red-green color blindness)."
            },
            {
              "q": "Mechanism of \"<b>Amphotericin B</b>\"?",
              "a": "Binds ergosterol and forms pores in the fungal cell membrane."
            },
            {
              "q": "Mechanism of \"Caspo-fungin\"?",
              "a": "Inhibits synthesis of &beta;-glucan in the fungal cell wall."
            },
            {
              "q": "Definition of Bacterial \"Transformation\"?",
              "a": "Uptake of naked DNA from the environment (notably <i>S. pneumoniae</i>, <i>H. influenzae</i>, Neisseria)."
            },
            {
              "q": "Mechanism of Specialized Transduction?",
              "a": "Lysogenic phage packages specific bacterial genes (e.g., <b>Shiga toxin</b>, <b>Diphtheria toxin</b>)."
            },
            {
              "q": "Function of the bacterial \"Sex Pilus\"?",
              "a": "Mediates conjugation (transfer of plasmids from F^+ to F^- cells)."
            },
            {
              "q": "Difference between \"Exotoxin\" and \"Endotoxin\"?",
              "a": "Exotoxins are secreted proteins (high toxicity); Endotoxin is <b>Lipid A</b> of the cell wall (triggers cytokines)."
            },
            {
              "q": "Most common cause of \"Prosthetic Valve\" Endocarditis?",
              "a": "Staphylococcus epidermidis."
            },
            {
              "q": "Identification of Streptococcus agalactiae (GBS)?",
              "a": "CAMP test positive (enlarges area of hemolysis formed by <i>S. aureus</i>)."
            },
            {
              "q": "Complication of <i>S. pyogenes</i> that follows only pharyngitis?",
              "a": "Rheumatic Fever (PSGN can follow both pharyngitis and impetigo)."
            },
            {
              "q": "Bug associated with \"Gas Gangrene\" and \"Myonecrosis\"?",
              "a": "<i>Clostridium</i> perfringens (Alpha toxin/Lecithinase)."
            },
            {
              "q": "Distinction between <i>Salmonella</i> and Shigella?",
              "a": "<i>Salmonella</i> is motile and produces H<sub>2</sub>S (black on Hektoen); Shigella is non-motile and no H<sub>2</sub>S."
            },
            {
              "q": "Main virulence factor of E. coli causing neonatal meningitis?",
              "a": "K1 capsular antigen."
            },
            {
              "q": "\"Comma-shaped\" rod that grows at 42&deg;C?",
              "a": "<i>Campylobacter jejuni</i>."
            },
            {
              "q": "Mechanism of <i>Pseudomonas</i> Exotoxin A?",
              "a": "Inactivates Elongation Factor-2 (EF-2) (same mechanism as <b>Diphtheria toxin</b>)."
            },
            {
              "q": "Bug causing \"Cat Scratch Disease\" vs. \"Bacillary Angiomatosis\"?",
              "a": "Both caused by <i>Bartonella henselae</i> (Angiomatosis occurs in immunocompromised)."
            },
            {
              "q": "Which Hepatitis virus requires HBV for coinfection?",
              "a": "Hepatitis D (Deltavirus)."
            },
            {
              "q": "Mode of transmission for Hepatitis E?",
              "a": "Fecal-oral (Enteric); high mortality in pregnant women."
            },
            {
              "q": "Key structural protein used to diagnose early HIV infection?",
              "a": "p24 capsid protein."
            },
            {
              "q": "Which HIV gene encodes for Reverse Transcriptase, Protease, and Integrase?",
              "a": "pol gene."
            },
            {
              "q": "Target of the \"Maraviroc\" drug in HIV?",
              "a": "CCR5 co-receptor on the host cell."
            },
            {
              "q": "Fungus with \"Broad-based budding\" found in the Great Lakes region?",
              "a": "<i>Blastomyces dermatitidis</i>."
            },
            {
              "q": "\"Cigar-shaped\" yeast associated with rose bushes/gardening?",
              "a": "<i>Sporothrix schenckii</i>."
            },
            {
              "q": "Distinguishing feature of <i>Mucor</i> vs. Aspergillus?",
              "a": "<i>Mucor</i> has non-septate hyphae with wide-angle (90&deg;) branching."
            },
            {
              "q": "Soap bubble lesions in the brain (Virchow-Robin spaces)?",
              "a": "<i>Cryptococcus neoformans</i>."
            },
            {
              "q": "Parasite associated with \"Squamous Cell Carcinoma of the Bladder\"?",
              "a": "<i>Schistosoma haematobium</i>."
            },
            {
              "q": "Treatment for Toxoplasma gondii?",
              "a": "Sulfadiazine + Pyrimethamine."
            },
            {
              "q": "\"Anchovy paste\" liver abscess?",
              "a": "<i>Entamoeba histolytica</i>."
            },
            {
              "q": "Periorbital edema and muscle pain after eating \"undercooked wild game\"?",
              "a": "<i>Trichinella spiralis</i>."
            },
            {
              "q": "Antibiotic that causes \"Disulfiram-like reaction\" with alcohol?",
              "a": "Metronidazole (also some Cephalosporins)."
            },
            {
              "q": "Classic side effect of \"Dapsone\"?",
              "a": "Hemolysis in G6PD deficiency."
            },
            {
              "q": "Unique side effect of \"Rifampin\"?",
              "a": "Orange-colored body fluids (tears, urine, sweat)."
            },
            {
              "q": "Side effect of \"Tetracyclines\" involving the skin?",
              "a": "Photosensitivity."
            },
            {
              "q": "Which antibiotic class causes \"Fanconi Syndrome\" if expired?",
              "a": "Tetracyclines."
            },
            {
              "q": "\"<b>Quellung Reaction</b>\" positive?",
