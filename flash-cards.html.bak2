                            {
                                      "q": "Major hormone elevated in Gestational Trophoblastic Disease?",
                                      "a": "beta-<b>hCG</b>."
                            },
                            {
                                      "q": "Characteristic of <b>Eclampsia</b> vs. <b>Preeclampsia</b>?",
                                      "a": "<b>Preeclampsia</b> (hypertension, edema, proteinuria) + Seizures."
                            },
                            {
                                      "q": "Definition of <b>Placenta Previa</b>?",
                                      "a": "Attachment of the placenta to the lower uterine segment, covering the internal os."
                            },
