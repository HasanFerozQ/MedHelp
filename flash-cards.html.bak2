                            },
                            {
                                      "q": "Gene mutations in <b>ADPKD</b>?",
                                      "a": "PKD1 (Chromosome 16) or PKD2 (Chromosome 4)."
                            },
                            {
                                      "q": "Common extra-renal complication of <b>ADPKD</b>?",
                                      "a": "Berry aneurysms (Subarachnoid hemorrhage) and hepatic cysts."
                            },
                            {
                                      "q": "<b>ARPKD</b> association in infants?",
                                      "a": "Congenital hepatic fibrosis and <b>Potter sequence</b>."
                            },
                            {
                                      "q": "Cause of <b>Potter Sequence</b>?",
                                      "a": "Oligohydramnios (due to renal agenesis or posterior urethral valves) leading to lung hypoplasia."
                            },
                            {
                                      "q": "Most common cause of bladder outlet obstruction in male infants?",
                                      "a": "Posterior Urethral Valves."
                            },
                            {
                                      "q": "Multicystic Dysplastic Kidney (MCDK) pathogenesis?",
                                      "a": "Abnormal interaction between ureteric bud and metanephric mesenchyme; non-inherited."
                            },
                            {
                                      "q": "Medullary Sponge Kidney clinical risk?",
                                      "a": "Increased risk of calcium stones but usually maintains normal renal function.\n\nIV. Metabolic and Systemic Involvement"
                            },
                            {
                                      "q": "Earliest clinical sign of <b>Diabetic Nephropathy</b>?",
                                      "a": "Microalbuminuria."
                            },
                            {
                                      "q": "Pathognomonic histological lesion in <b>Diabetic Nephropathy</b>?",
                                      "a": "<b>Kimmelstiel-Wilson nodules</b> (nodular glomerulosclerosis)."
                            },
                            {
                                      "q": "Effect of ACE inhibitors in <b>Diabetic Nephropathy</b>?",
                                      "a": "Dilates efferent arteriole to reduce intraglomerular pressure and slow progression."
                            },
                            {
                                      "q": "Renal Amyloidosis stain and microscopy?",
                                      "a": "Congo Red stain; Apple-green birefringence under polarized light."
                            },
                            {
                                      "q": "Most common kidney stone composition?",
                                      "a": "Calcium oxalate."
                            },
                            {
                                      "q": "Appearance of Calcium Oxalate stones?",
                                      "a": "Envelope or dumbbell-shaped crystals."
                            },
                            {
                                      "q": "Stone type associated with <i>Proteus</i>/Urease-positive infections?",
                                      "a": "Ammonium magnesium phosphate (Struvite) stones."
                            },
                            {
                                      "q": "Classic shape of <b>Struvite stones</b>?",
                                      "a": "Coffin lid crystals; can form Staghorn calculi."
                            },
                            {
                                      "q": "Hexagonal crystals in urine indicate?",
                                      "a": "<b>Cystinuria</b> (defect in COLA transporter)."
                            },
                            {
                                      "q": "Treatment for Uric Acid stones?",
                                      "a": "Alkalinization of urine and hydration.\n\nV. Neoplasia of the Urinary System"
                            },
                            {
                                      "q": "Most common primary renal malignancy in adults?",
                                      "a": "<b>Renal Cell Carcinoma</b> (<b>RCC</b>)."
                            },
                            {
                                      "q": "Origin of <b>Renal Cell Carcinoma</b> cells?",
                                      "a": "Proximal convoluted tubule cells."
                            },
                            {
                                      "q": "Paraneoplastic syndromes associated with <b>RCC</b>?",
                                      "a": "EPO (polycythemia), Renin (HTN), PTHrP (hypercalcemia), and ACTH (Cushing)."
                            },
                            {
                                      "q": "Genetic association with Clear Cell <b>RCC</b>?",
                                      "a": "Loss of VHL gene on Chromosome 3."
                            },
                            {
                                      "q": "Classic triad of <b>RCC</b> (only in 10% of cases)?",
                                      "a": "Hematuria, palpable mass, and flank pain."
                            },
                            {
                                      "q": "Most common site of metastasis for <b>RCC</b>?",
                                      "a": "Lung (via hematogenous spread to the renal vein)."
                            },
                            {
                                      "q": "<b>Wilms Tumor</b> (Nephroblastoma) typical patient?",
                                      "a": "Child aged 2\u20134 years."
                            },
                            {
                                      "q": "<b>WAGR Syndrome</b> components?",
                                      "a": "<b>Wilms tumor</b>, Aniridia, Genitourinary malformations, and Retardation."
                            },
                            {
                                      "q": "Histology of <b>Wilms Tumor</b>?",
                                      "a": "Blastema, primitive tubules/glomeruli, and stromal cells (triphasic)."
                            },
                            {
                                      "q": "Most common tumor of the urinary collecting system?",
                                      "a": "Transitional Cell (Urothelial) Carcinoma."
                            },
                            {
                                      "q": "Major risk factors for <b>Urothelial Carcinoma</b>?",
                                      "a": "Smoking, Aniline dyes, Phenacetin, and Cyclophosphamide (Pee SAC)."
                            },
                            {
                                      "q": "Classic presentation of Bladder Cancer?",
                                      "a": "Painless gross hematuria in an older patient."
                            },
                            {
                                      "q": "Risk factor for Squamous Cell Carcinoma of the bladder?",
                                      "a": "Chronic irritation (<i>Schistosoma haematobium</i>, chronic stones, long-term catheters).\n\nVI. Clinical Pathology & Laboratory Correlation"
                            },
                            {
                                      "q": "Formula for Fractional Excretion of Sodium (<b>FENA</b>)?",
                                      "a": "(U<sub>Na</sub> &times; P<sub>Cr</sub>) / (P<sub>Na</sub> &times; U<sub>Cr</sub>) &times; 100."
                            },
                            {
                                      "q": "Meaning of <b>FENA</b> < 1%?",
                                      "a": "Prerenal azotemia (kidneys are conserving sodium)."
                            },
                            {
                                      "q": "Urine Osmolality in Prerenal Azotemia?",
                                      "a": "High (> 500 mOsm/kg) as the kidney concentrates urine to save volume."
                            },
                            {
                                      "q": "BUN/Creatinine ratio in Prerenal Azotemia?",
                                      "a": "> 20:1 (Urea is reabsorbed with water; Creatinine is not)."
                            },
                            {
                                      "q": "Hyaline casts clinical significance?",
                                      "a": "Non-specific; seen in concentrated urine or dehydration."
                            },
                            {
                                      "q": "WBC casts signify?",
                                      "a": "Pyelonephritis or <b>Acute Interstitial Nephritis</b> (Inflammation)."
                            },
                            {
                                      "q": "Fatty casts (\"Maltese Cross\") signify?",
                                      "a": "<b>Nephrotic Syndrome</b>."
                            },
                            {
                                      "q": "Broad/Waxy casts signify?",
                                      "a": "End-stage renal disease/Chronic renal failure."
                            },
                            {
                                      "q": "RBC casts signify?",
                                      "a": "Glomerulonephritis or Malignant HTN.\n\nVII. Electrolytes and Acid-Base (Renal Focus)"
                            },
                            {
                                      "q": "Type 1 <b>Renal Tubular Acidosis</b> (<b>RTA</b>) defect?",
                                      "a": "Inability of distal tubule to secrete H<sup>+</sup>."
                            },
                            {
                                      "q": "Urinary pH in Type 1 <b>RTA</b>?",
                                      "a": "High (> 5.5)."
                            },
                            {
                                      "q": "Type 2 <b>RTA</b> defect?",
                                      "a": "Inability of proximal tubule to reabsorb HCO<sub>3</sub><sup>-</sup>."
                            },
                            {
                                      "q": "Association for Type 2 <b>RTA</b>?",
                                      "a": "<b>Fanconi Syndrome</b>."
                            },
                            {
                                      "q": "Type 4 <b>RTA</b> cause?",
                                      "a": "Hypoaldosteronism or aldosterone resistance; leads to hyperkalemia."
                            },
                            {
                                      "q": "Renal response to metabolic acidosis?",
                                      "a": "Increased ammonia (NH<sub>3</sub>) production to buffer H<sup>+</sup> as NH<sub>4</sub><sup>+</sup>.\n\nVIII. Pharmacology of the Renal System"
                            },
                            {
                                      "q": "Mechanism of Acetazolamide?",
                                      "a": "Carbonic anhydrase inhibitor in the proximal convoluted tubule."
                            },
                            {
                                      "q": "Main clinical use for Acetazolamide (non-renal)?",
                                      "a": "Glaucoma and altitude sickness."
                            },
                            {
                                      "q": "Mechanism of Loop Diuretics (e.g., Furosemide)?",
                                      "a": "Inhibits Na<sup>+</sup>/K<sup>+</sup>/2Cl<sup>-</sup> cotransporter in the thick ascending limb."
                            },
                            {
                                      "q": "Major side effect of Loop Diuretics on calcium?",
                                      "a": "Hypocalcemia (\"Loops Lose calcium\")."
                            },
                            {
                                      "q": "Mechanism of Thiazide Diuretics?",
                                      "a": "Inhibits Na<sup>+</sup>/Cl<sup>-</sup> cotransporter in the distal convoluted tubule."
                            },
                            {
                                      "q": "Effect of Thiazides on calcium?",
                                      "a": "Hypercalcemia (increases reabsorption)."
                            },
                            {
                                      "q": "Mechanism of Spironolactone?",
                                      "a": "Aldosterone receptor antagonist in the cortical collecting duct."
                            },
                            {
                                      "q": "Life-threatening side effect of Potassium-sparing diuretics?",
                                      "a": "Hyperkalemia.\n\nIX. Pathology of the Lower Urinary Tract"
                            },
                            {
                                      "q": "Most common cause of UTI (Cystitis)?",
                                      "a": "<i>E. coli</i>."
                            },
                            {
                                      "q": "Sterile pyuria (WBCs in urine with negative culture) suggests?",
                                      "a": "<i>Chlamydia trachomatis</i> or <i>Neisseria gonorrhoeae</i>."
                            },
                            {
                                      "q": "Morphological hallmark of <b>Malakoplakia</b>?",
                                      "a": "<b>Michaelis-Gutmann bodies</b> (calcified siderotic bodies)."
                            },
                            {
                                      "q": "Urachal cyst/adenocarcinoma remnant?",
                                      "a": "Allantois."
                            },
                            {
                                      "q": "Location of Urachal cancer?",
                                      "a": "Dome of the bladder."
                            },
                            {
                                      "q": "Definition of Exstrophy of the bladder?",
                                      "a": "Failure of the abdominal wall to close, exposing the bladder."
                            },
                            {
                                      "q": "Association of Bladder Exstrophy?",
                                      "a": "Increased risk of Adenocarcinoma."
                            },
                            {
                                      "q": "Hallmark of Chronic Cystitis?",
                                      "a": "Brunn nests (inward growth of urothelium)."
                            },
                            {
                                      "q": "Cystitis Glandularis?",
                                      "a": "Transformation of Brunn nests into cuboidal or columnar epithelium."
                            },
                            {
                                      "q": "Common cause of obstruction in elderly men?",
                                      "a": "Benign Prostatic Hyperplasia (<b>BPH</b>)."
                            },
                            {
                                      "q": "<b>BPH</b> vs Prostate Cancer location?",
                                      "a": "<b>BPH</b> occurs in the periurethral/transition zone; Cancer in the peripheral zone."
                            },
                            {
                                      "q": "Histological finding in Interstitial Cystitis (Hunner Ulcer)?",
                                      "a": "Chronic inflammation and mast cells; negative cultures."
                            },
                            {
                                      "q": "Emphysematous Cystitis is most common in?",
                                      "a": "Diabetic patients (due to gas-forming organisms like <i>E. coli</i>)."
                            },
                            {
                                      "q": "Xanthogranulomatous Pyelonephritis appearance?",
                                      "a": "Yellow-orange nodules; associated with <i>Proteus</i> and \"foamy\" macrophages."
                            },
                            {
                                      "q": "Renal Infarction gross appearance?",
                                      "a": "Pale, wedge-shaped cortical infarct."
                            },
                            {
                                      "q": "<b>Fanconi Syndrome</b> electrolyte losses?",
                                      "a": "Loss of glucose, amino acids, HCO<sub>3</sub><sup>-</sup>, and PO<sub>4</sub><sup>3-</sup> in urine."
                            },
                            {
                                      "q": "<b>Bartter Syndrome</b> mimicry?",
                                      "a": "Mimics chronic Loop Diuretic use (defect in thick ascending limb)."
                            },
                            {
                                      "q": "<b>Gitelman Syndrome</b> mimicry?",
                                      "a": "Mimics chronic Thiazide Diuretic use (defect in distal tubule)."
                            },
                            {
                                      "q": "<b>Liddle Syndrome</b> pathophysiology?",
                                      "a": "Gain-of-function mutation increasing ENaC activity (presents like hyperaldosteronism but low aldosterone)."
                            },
                            {
                                      "q": "Most common cause of \"Wire Loop\" glomerular lesions?",
                                      "a": "<b>Lupus Nephritis</b> (specifically Class IV: Diffuse Proliferative GN)."
                            },
                            {
                                      "q": "Immunofluorescence pattern in <b>Lupus Nephritis</b>?",
                                      "a": "\"Full House\" pattern (granular staining for IgG, IgA, IgM, C3, and C1q)."
                            },
                            {
                                      "q": "Components of the Glomerular Filtration Barrier?",
                                      "a": "Fenestrated endothelium, basement membrane (Type IV collagen/heparan sulfate), and podocyte foot processes."
                            },
                            {
                                      "q": "Function of Heparan Sulfate in the GBM?",
                                      "a": "Provides a negative charge barrier to repel proteins like albumin."
                            },
                            {
                                      "q": "Genetic defect in Finnish-type Congenital <b>Nephrotic Syndrome</b>?",
                                      "a": "Mutation in the NPHS1 gene encoding Nephrin."
                            },
                            {
                                      "q": "Pathogenesis of Dense Deposit Disease (<b>MPGN</b> Type II)?",
                                      "a": "Autoantibody (C3 Nephritic Factor) stabilizes C3 convertase, leading to hypocomplementemia."
                            },
                            {
                                      "q": "Primary location of IgA deposits in <b>Berger Disease</b>?",
                                      "a": "Mesangium."
                            },
                            {
                                      "q": "What defines \"Rapidly Progressive\" Glomerulonephritis?",
                                      "a": "Loss of renal function >50% within weeks to months, histologically characterized by crescents."
                            },
                            {
                                      "q": "Major cytokine responsible for mesangial cell proliferation?",
                                      "a": "PDGF (Platelet-Derived Growth Factor)."
                            },
                            {
                                      "q": "Primary composition of the \"crescents\" in <b>RPGN</b>?",
                                      "a": "Fibrin, plasma proteins, and parietal epithelial cells (macrophages).\n\nXI. Renal Vascular & Ischemic Pathology"
                            },
                            {
                                      "q": "Pathogenesis of <b>Hemolytic Uremic Syndrome</b> (<b>HUS</b>)?",
                                      "a": "Shiga-like toxin (<i>E. coli</i> O157:H7) damages endothelium, causing microthrombi and mechanical hemolysis."
                            },
                            {
                                      "q": "Clinical pentad of Thrombotic Thrombocytopenic Purpura (<b>TTP</b>)?",
                                      "a": "Fever, Microangiopathic Hemolytic Anemia, Thrombocytopenia, Neurological symptoms, and Renal failure."
                            },
                            {
                                      "q": "Enzyme deficiency in <b>TTP</b>?",
                                      "a": "ADAMTS13 (vWF-cleaving protease)."
                            },
                            {
                                      "q": "\"Flea-bitten\" kidney appearance (gross) indicates?",
                                      "a": "Malignant Hypertension or Hyperplastic Arteriolosclerosis."
                            },
                            {
                                      "q": "Typical cause of <b>Renal Artery Stenosis</b> in elderly men?",
                                      "a": "Atherosclerosis."
                            },
                            {
                                      "q": "Typical cause of <b>Renal Artery Stenosis</b> in young women?",
                                      "a": "Fibromuscular Dysplasia (\"string of beads\" appearance on imaging)."
                            },
                            {
                                      "q": "Effect of <b>Renal Artery Stenosis</b> on the affected kidney size?",
                                      "a": "Atrophy due to chronic ischemia."
                            },
                            {
                                      "q": "Effect of <b>Renal Artery Stenosis</b> on the unaffected kidney?",
                                      "a": "Hyaline arteriolosclerosis due to exposure to high systemic blood pressure."
                            },
                            {
                                      "q": "Most common cause of Renal Vein Thrombosis?",
                                      "a": "<b>Nephrotic Syndrome</b> (loss of Antithrombin III in urine)."
                            },
                            {
                                      "q": "Classic presentation of Renal Vein Thrombosis in males?",
                                      "a": "Left-sided varicocele (left gonadal vein drains into left renal vein).\n\nXII. Tubular, Interstitial & Metabolic Fine Details"
                            },
                            {
                                      "q": "<b>Fanconi Syndrome</b> occurs in which part of the nephron?",
                                      "a": "Proximal Convoluted Tubule."
                            },
                            {
                                      "q": "Hartnup Disease clinical presentation?",
                                      "a": "Pellagra-like symptoms (dermatitis, diarrhea, dementia) due to urinary loss of Tryptophan."
                            },
                            {
                                      "q": "Major cause of Secondary Hyperparathyroidism in Chronic Kidney Disease?",
                                      "a": "Phosphate retention and decreased 1,25-dihydroxyvitamin D (Calcitriol)."
                            },
                            {
                                      "q": "Mechanism of \"Renal Osteodystrophy\"?",
                                      "a": "Hypocalcemia and hyperphosphatemia lead to increased PTH, causing bone resorption."
                            },
                            {
                                      "q": "Most common type of metabolic alkalosis seen with diuretics?",
                                      "a": "Contraction alkalosis (volume depletion leading to RAAS activation and H<sup>+</sup> secretion)."
                            },
                            {
                                      "q": "Mechanism of Ethylene Glycol renal toxicity?",
                                      "a": "Metabolized to Oxalic Acid, causing <b>ATN</b> and Calcium Oxalate crystals."
                            },
                            {
                                      "q": "Histological finding in Acute Biliary Nephrosis (Cholemic Nephrosis)?",
                                      "a": "Greenish-yellow bile pigment casts in tubules."
                            },
                            {
                                      "q": "What are \"Bence-Jones\" proteins?",
                                      "a": "Immunoglobulin light chains found in the urine of Multiple Myeloma patients."
                            },
                            {
                                      "q": "Appearance of Myeloma Kidney on histology?",
                                      "a": "Hard, eosinophilic, \"fractured\" intratubular casts with giant cell reaction."
                            },
                            {
                                      "q": "Common cause of renal stones in patients with Crohn\u2019s disease?",
                                      "a": "Increased oxalate absorption in the gut (hyperoxaluria).\n\nXIII. Congenital, Cystic & Structural Anomalies"
                            },
                            {
                                      "q": "Horseshoe Kidney is trapped under which artery during ascent?",
                                      "a": "Inferior Mesenteric Artery (IMA)."
                            },
                            {
                                      "q": "Horseshoe Kidney increases the risk of which cancer?",
                                      "a": "Renal Pelvis <b>Transitional Cell Carcinoma</b>."
                            },
                            {
                                      "q": "Renal Agenesis (Bilateral) leads to what amniotic fluid volume?",
                                      "a": "Oligohydramnios."
                            },
                            {
                                      "q": "<b>Potter Sequence</b> face appearance?",
                                      "a": "Flattened nose, recessed chin, and low-set ears."
                            },
                            {
                                      "q": "Difference between Simple Cysts and <b>RCC</b> on CT?",
                                      "a": "Simple cysts are smooth-walled, fluid-filled, and do not enhance with contrast."
                            },
                            {
                                      "q": "Acquired Cystic Disease of the Kidney is associated with?",
                                      "a": "Long-term Dialysis (increased risk of <b>RCC</b>)."
                            },
                            {
                                      "q": "Medullary Cystic Disease (Nephronophthisis) vs. Medullary Sponge Kidney?",
                                      "a": "Nephronophthisis leads to renal failure and shrunken kidneys; Sponge Kidney is benign."
                            },
                            {
                                      "q": "Autosomal Dominant Tubulointerstitial Kidney Disease (ADTKD) symptom?",
                                      "a": "Hyperuricemia and early-onset gout.\n\nXIV. Further Neoplasia & Urologic Pathology"
                            },
                            {
                                      "q": "Angiomyolipoma is a classic renal finding in which systemic disease?",
                                      "a": "Tuberous Sclerosis."
                            },
                            {
                                      "q": "Components of an Angiomyolipoma?",
                                      "a": "Blood vessels, smooth muscle, and adipose tissue."
                            },
                            {
                                      "q": "Oncocytoma gross appearance?",
                                      "a": "Tan/Mahogany brown with a well-circumscribed central stellate scar."
                            },
                            {
                                      "q": "Ultrastructural hallmark of Oncocytoma?",
                                      "a": "Cells packed with numerous mitochondria."
                            },
                            {
                                      "q": "Clear Cell <b>RCC</b> arises from which specific tubule?",
                                      "a": "Proximal Tubule."
                            },
                            {
                                      "q": "Chromophobe <b>RCC</b> arises from which cells?",
                                      "a": "Intercalated cells of the Collecting Duct."
                            },
                            {
                                      "q": "Most common benign tumor of the bladder?",
                                      "a": "Inverted Papilloma."
                            },
                            {
                                      "q": "Typical location of <b>Urothelial Carcinoma</b> \"in situ\"?",
                                      "a": "Flat lesion of malignant cells within the basement membrane; high risk of progression."
                            },
                            {
                                      "q": "Primary difference between Stage and Grade in Bladder Cancer?",
                                      "a": "Stage (depth of invasion into the muscle) is the most important prognostic factor."
                            },
                            {
                                      "q": "Gene mutation associated with Fibroepithelial polyp?",
                                      "a": "None typically, but it is the most common benign mass of the ureter in children.\n\nXV. Practical Lab & Imaging Correlation"
                            },
                            {
                                      "q": "\"Muddy brown\" casts vs. Hyaline casts?",
                                      "a": "Muddy brown = <b>ATN</b>; Hyaline = Normal/Dehydration."
                            },
                            {
                                      "q": "Presence of \"Glitter Cells\" in urine indicates?",
                                      "a": "Pyelonephritis (neutrophils with Brownian motion)."
                            },
                            {
                                      "q": "Urine pH in Uric Acid stones?",
                                      "a": "Acidic (pH < 5.5)."
                            },
                            {
                                      "q": "Best imaging modality to visualize kidney stones?",
                                      "a": "Non-contrast CT scan."
                            },
                            {
                                      "q": "Significance of \"Esmarch\u2019s\" sign or high urinary Nitrites?",
                                      "a": "Presence of Gram-negative bacteria (e.g., <i>E. coli</i>, <i>Proteus</i>, <i>Klebsiella</i>)."
                            },
                            {
                                      "q": "Why are Nitrites negative in some UTIs?",
                                      "a": "Some organisms (<i>Enterococcus</i>, <i>S. saprophyticus</i>) do not reduce nitrate to nitrite."
                            },
                            {
                                      "q": "What does \"Telescoped Sediment\" mean?",
                                      "a": "A urine sediment showing features of Nephritic, Nephrotic, and Chronic syndromes simultaneously (seen in SLE)."
                            },
                            {
                                      "q": "Formula for Serum Osmolality?",
                                      "a": "2[Na<sup>+</sup>] + Glucose/18 + BUN/2.8."
                            },
                            {
                                      "q": "Immunofluorescence pattern in <b>Henoch-Sch\u00f6nlein Purpura</b> (<b>HSP</b>)?",
                                      "a": "Granular IgA deposits in the mesangium (identical to <b>IgA Nephropathy</b>)."
                            },
                            {
                                      "q": "The \"Three D's\" of Dense Deposit Disease?",
                                      "a": "Dense deposits, Decreased C3, and Drusen (retinal deposits)."
                            },
                            {
                                      "q": "Most common cause of \"Pauci-immune\" Glomerulonephritis?",
                                      "a": "ANCA-associated vasculitides (<b>GPA</b>, MPA, or EGPA)."
                            },
                            {
                                      "q": "Target antigen in <b>Goodpasture Syndrome</b>?",
                                      "a": "Non-collagenous domain of the alpha-3 chain of Type IV Collagen."
                            },
                            {
                                      "q": "Significance of C1q deposits in a \"Full House\" IF pattern?",
                                      "a": "Highly suggestive of Systemic Lupus Erythematosus (SLE) involvement."
                            },
                            {
                                      "q": "Gene mutation in Von Hippel-Lindau (VHL) disease?",
                                      "a": "VHL gene on Chromosome 3p."
                            },
                            {
                                      "q": "Retinal finding associated with VHL disease?",
                                      "a": "Hemangioblastoma."
                            },
                            {
                                      "q": "Major renal complication of Tuberous Sclerosis?",
                                      "a": "Bilateral Renal Angiomyolipomas.\n\nXVII. Advanced Renal Physiology & Lab Interpretation"
                            },
                            {
                                      "q": "Primary site of Magnesium reabsorption in the nephron?",
                                      "a": "Thick Ascending Limb of the Loop of Henle (paracellularly)."
                            },
                            {
                                      "q": "Effect of PTH on the Proximal Tubule?",
                                      "a": "Inhibits Na<sup>+</sup>/PO<sub>4</sub><sup>3-</sup> cotransport, leading to phosphaturia."
                            },
                            {
                                      "q": "Effect of PTH on the Distal Tubule?",
                                      "a": "Stimulates Ca<sup>2+</sup>/Na<sup>+</sup> exchange, increasing calcium reabsorption."
                            },
                            {
                                      "q": "How does Glucose cause osmotic diuresis in Diabetes?",
                                      "a": "Filtered load exceeds the T<sub>m</sub> (transport maximum) of the PCT, keeping water in the tubule."
                            },
                            {
                                      "q": "Urea recycling occurs in which part of the nephron?",
                                      "a": "Collecting Ducts (stimulated by ADH)."
                            },
                            {
                                      "q": "What is \"Winter\u2019s Formula\" used for?",
                                      "a": "To calculate the expected respiratory compensation (pCO<sub>2</sub>) in metabolic acidosis."
                            },
                            {
                                      "q": "Winter\u2019s Formula?",
                                      "a": "pCO<sub>2</sub> = 1.5 &times; [HCO<sub>3</sub><sup>-</sup>] + 8 &plusmn; 2."
                            },
                            {
                                      "q": "Definition of \"Renal Clearance\"?",
                                      "a": "Volume of plasma from which a substance is completely removed per unit time.\n\nXVIII. Toxicology & Drug-Induced Pathology"
                            },
                            {
                                      "q": "Renal side effect of Amphotericin B?",
                                      "a": "Distal <b>Renal Tubular Acidosis</b> (Type 1) and nephrogenic diabetes insipidus."
                            },
                            {
                                      "q": "Renal side effect of Lithium?",
                                      "a": "Nephrogenic Diabetes Insipidus (antagonizes ADH at the collecting duct)."
                            },
                            {
                                      "q": "Mechanism of Cisplatin-induced kidney injury?",
                                      "a": "Direct tubular toxicity (<b>ATN</b>), often prevented with Amifostine and saline diuresis."
                            },
                            {
                                      "q": "How do NSAIDs cause \"Analgesic Nephropathy\"?",
                                      "a": "Inhibition of Prostaglandins leads to afferent arteriole vasoconstriction and papillary necrosis."
                            },
                            {
                                      "q": "Renal complication of high-dose Acyclovir?",
                                      "a": "Obstructive crystalline nephropathy (crystal precipitation in tubules)."
                            },
                            {
                                      "q": "Class of diuretics that causes \"Ototoxicity\"?",
                                      "a": "Loop Diuretics (e.g., Furosemide, Ethacrynic acid)."
                            },
                            {
                                      "q": "Why is Ethacrynic acid used instead of Furosemide?",
                                      "a": "It is not a sulfonamide; used in patients with sulfa allergies.\n\nXIX. Urological Conditions & Miscellaneous"
                            },
                            {
                                      "q": "Most common location for a \"Ureteropelvic Junction\" (UPJ) obstruction?",
                                      "a": "The junction between the renal pelvis and the ureter."
                            },
                            {
                                      "q": "Classic presentation of a UPJ obstruction in a neonate?",
                                      "a": "Palpable flank mass; most common cause of neonatal hydronephrosis."
                            },
                            {
                                      "q": "Pathogenesis of Retroperitoneal Fibrosis (Ormond Disease)?",
                                      "a": "Proliferation of fibrous tissue (often IgG4-related) compressing the ureters."
                            },
                            {
                                      "q": "Renal finding in \"Nutcracker Syndrome\"?",
                                      "a": "Compression of the left renal vein between the SMA and Aorta; causes hematuria and flank pain."
                            },
                            {
                                      "q": "Most common malignant tumor of the ureter?",
                                      "a": "Urothelial (Transitional Cell) Carcinoma."
                            },
                            {
                                      "q": "Defining feature of <b>Malakoplakia</b>?",
                                      "a": "Chronic inflammatory reaction with soft, yellow mucosal plaques (<b>Michaelis-Gutmann bodies</b>)."
                            },
                            {
                                      "q": "Risk factor for primary Renal Lymphoma?",
                                      "a": "Usually occurs in the setting of systemic Non-Hodgkin Lymphoma."
                            },
                            {
                                      "q": "Mechanism of \"Overflow Incontinence\"?",
                                      "a": "Impaired detrusor contractility or bladder outlet obstruction (bladder never fully empties)."
                            },
                            {
                                      "q": "Mechanism of \"Stress Incontinence\"?",
                                      "a": "Urethral hypermobility or sphincter weakness (leakage with coughing/sneezing).\n\nXX. Final \"Quick Fire\" High-Yields"
                            },
                            {
                                      "q": "\"Phrygian cap\" refers to?",
                                      "a": "A gallbladder anomaly (not renal, but often confused in abdominal imaging cards)."
                            },
                            {
                                      "q": "\"Miley-tous\" appearance of the kidney surface?",
                                      "a": "Benign Nephrosclerosis (from chronic hypertension)."
                            },
                            {
                                      "q": "Gold standard for diagnosing <b>Renal Artery Stenosis</b>?",
                                      "a": "Renal Arteriography."
                            },
                            {
                                      "q": "Most common cause of death in <b>ADPKD</b>?",
                                      "a": "Cardiovascular disease or complications of Chronic Kidney Disease (CKD)."
                            },
                            {
                                      "q": "Primary renal cell type that senses Cl<sup>-</sup> concentration?",
                                      "a": "Macula Densa cells."
                            },
                            {
                                      "q": "Effect of ANP on the afferent arteriole?",
                                      "a": "Vasodilation (increases GFR)."
                            },
                            {
                                      "q": "Effect of ANP on the efferent arteriole?",
                                      "a": "Vasoconstriction (increases GFR)."
                            },
                            {
                                      "q": "Classic hormone elevated in Choriocarcinoma/Testicular tumors that can cause hyperthyroidism?",
                                      "a": "hCG (shares an alpha-subunit with TSH)."
                            },
                            {
                                      "q": "Most common type of renal stone in children?",
                                      "a": "Calcium oxalate (just like adults), but always screen for metabolic defects."
                            },
                            {
                                      "q": "Type of amyloidosis seen in long-term hemodialysis?",
                                      "a": "&beta;<sub>2</sub>-microglobulin amyloidosis."
                            },
                            {
                                      "q": "Most common glomerulopathy associated with Malignancy (Solid Tumors)?",
                                      "a": "<b>Membranous Nephropathy</b>."
                            },
                            {
                                      "q": "Glomerulopathy associated with Hodgkin Lymphoma?",
                                      "a": "<b>Minimal Change Disease</b>."
                            },
                            {
                                      "q": "Pathogenesis of \"Linear\" IF in <b>Goodpasture Syndrome</b>?",
                                      "a": "Anti-GBM antibodies bind evenly to the Type IV collagen of the basement membrane."
                            },
                            {
                                      "q": "Define \"Pauci-immune\" in the context of GN?",
                                      "a": "Glomerulonephritis with minimal to no immunoglobulin or complement deposits on IF."
                            },
                            {
                                      "q": "Microscopic Polyangiitis (MPA) vs. <b>Granulomatosis with Polyangiitis</b> (<b>GPA</b>) renal findings?",
                                      "a": "Both cause pauci-immune <b>RPGN</b>; <b>GPA</b> involves granulomatous inflammation and c-ANCA, while MPA lacks granulomas and is p-ANCA positive."
                            },
                            {
                                      "q": "Primary location of \"Subendothelial\" deposits in <b>MPGN</b> Type I?",
                                      "a": "Between the endothelial cell and the basement membrane."
                            },
                            {
                                      "q": "Morphological feature of \"Wire Loop\" lesions in SLE?",
                                      "a": "Massive subendothelial immune complex deposits."
                            },
                            {
                                      "q": "Fibrillary Glomerulonephritis pathology?",
                                      "a": "Congo Red-negative extracellular fibrils (larger than amyloid fibrils) in the mesangium.\n\nXXII. Extended Tubulointerstitial & Obstructive Pathology"
                            },
                            {
                                      "q": "Definition of \"Hydronephrosis\"?",
                                      "a": "Dilation of the renal pelvis and calyces due to obstruction of urine outflow."
                            },
                            {
                                      "q": "Common causes of acquired bilateral hydronephrosis?",
                                      "a": "<b>BPH</b>, bladder tumors, and retroperitoneal fibrosis."
                            },
                            {
                                      "q": "<b>Renal Papillary Necrosis</b> (RPN) mnemonic \"SAAD\"?",
                                      "a": "Sickle cell, Acute pyelonephritis, Analgesics (NSAIDs), and Diabetes."
                            },
                            {
                                      "q": "Mechanism of \"Urate Nephropathy\" in Tumor Lysis Syndrome?",
                                      "a": "Precipitation of uric acid crystals in the acidic environment of the distal tubules/collecting ducts."
                            },
                            {
                                      "q": "Prevention of Urate Nephropathy during chemotherapy?",
                                      "a": "Allopurinol or Rasburicase and aggressive hydration."
                            },
                            {
                                      "q": "Major electrolyte abnormality in \"<b>Fanconi Syndrome</b>\"?",
                                      "a": "Type 2 (proximal) <b>RTA</b> leading to metabolic acidosis, hypophosphatemia, and hypokalemia.\n\nXXIII. Genetic & Molecular Drivers in Renal Tumors"
                            },
                            {
                                      "q": "Gene involved in Papillary <b>Renal Cell Carcinoma</b>?",
                                      "a": "MET proto-oncogene."
                            },
                            {
                                      "q": "Distinction between Birt-Hogg-Dub\u00e9 syndrome and <b>RCC</b>?",
                                      "a": "Genetic syndrome involving skin tumors, lung cysts, and Chromophobe <b>RCC</b>."
                            },
                            {
                                      "q": "<b>Denys-Drash Syndrome</b> triad?",
                                      "a": "<b>Wilms tumor</b>, male pseudohermaphroditism, and early-onset renal failure (diffuse mesangial sclerosis)."
                            },
                            {
                                      "q": "<b>Beckwith-Wiedemann Syndrome</b> clinical features?",
                                      "a": "<b>Wilms tumor</b>, macroglossia, organomegaly, and hemihyperplasia (WT2 gene)."
                            },
                            {
                                      "q": "Distinction between Sporadic and Hereditary <b>RCC</b>?",
                                      "a": "Sporadic is typically single/unilateral in older adults; Hereditary is often multiple/bilateral in younger patients.\n\nXXIV. Lower Urinary Tract & Bladder Pathology"
                            },
                            {
                                      "q": "Pathogenesis of <b>Malakoplakia</b>?",
                                      "a": "Defective phagocytosis by macrophages leading to the accumulation of partially digested bacteria (<b>Michaelis-Gutmann bodies</b>)."
                            },
                            {
                                      "q": "Most common location for \"Ectopic Ureter\" in females?",
                                      "a": "Vestibule or vagina (bypasses the sphincter, leading to constant dribbling)."
                            },
                            {
                                      "q": "Predominant cell type in a \"Urachal Adenocarcinoma\"?",
                                      "a": "Glandular cells (resembling colonic mucosa) at the bladder dome."
                            },
                            {
                                      "q": "Distinction between \"Cystitis Cystica\" and \"Cystitis Glandularis\"?",
                                      "a": "Both involve Brunn nests; Cystica has cystic spaces, Glandularis has intestinal-type goblet cells."
                            },
                            {
                                      "q": "Typical risk factor for Squamous Cell Carcinoma of the Bladder in the Middle East?",
                                      "a": "Chronic Schistosomiasis (<i>Schistosoma haematobium</i>).\n\nXXV. Renal Pharmacology & Acid-Base Integration"
                            },
                            {
                                      "q": "Primary acid-base disturbance in Aspirin (Salicylate) overdose?",
                                      "a": "Mixed Respiratory Alkalosis and <b>Anion Gap</b> Metabolic Acidosis."
                            },
                            {
                                      "q": "Diuretic used to treat idiopathic hypercalciuria (stone prevention)?",
                                      "a": "Thiazides (they increase distal Ca<sup>2+</sup> reabsorption)."
                            },
                            {
                                      "q": "Effect of Loop Diuretics on Magnesium?",
                                      "a": "Hypomagnesemia (disrupts the positive lumen potential needed for paracellular reabsorption)."
                            },
                            {
                                      "q": "Mechanism of Mannitol?",
                                      "a": "Osmotic diuretic that increases tubular fluid osmolarity, primarily in the PCT and descending limb of Henle."
                            },
                            {
                                      "q": "Contraindication for Mannitol use?",
                                      "a": "Congestive Heart Failure and Pulmonary Edema (causes initial volume expansion)."
                            },
                            {
                                      "q": "Primary renal mechanism for compensating for Respiratory Acidosis?",
                                      "a": "Increased HCO<sub>3</sub><sup>-</sup> reabsorption and increased H<sup>+</sup> secretion (via NH<sub>4</sub><sup>+</sup> excretion)."
                            },
                            {
                                      "q": "Lab definition of \"Azotemia\"?",
                                      "a": "Elevation of BUN and Creatinine levels without clinical symptoms."
                            },
                            {
                                      "q": "Lab definition of \"Uremia\"?",
                                      "a": "Azotemia accompanied by clinical symptoms (e.g., pericarditis, asterixis, encephalopathy).\n\nXXVI. Microscopic \"Buzzwords\" for Pathology"
                            },
                            {
                                      "q": "Buzzword: \"Subepithelial Humps\"?",
                                      "a": "Post-Streptococcal Glomerulonephritis (<b>PSGN</b>)."
                            },
                            {
                                      "q": "Buzzword: \"Subendothelial Deposits\"?",
                                      "a": "<b>MPGN</b> Type I or <b>Lupus Nephritis</b>."
                            },
                            {
                                      "q": "Buzzword: \"Intramembranous Deposits\"?",
                                      "a": "<b>MPGN</b> Type II (Dense Deposit Disease)."
                            },
                            {
                                      "q": "Buzzword: \"Linear IgG\"?",
                                      "a": "<b>Goodpasture Syndrome</b>."
                            },
                            {
                                      "q": "Buzzword: \"Granular IgG/C3\"?",
                                      "a": "<b>PSGN</b> or <b>Membranous Nephropathy</b>."
                            },
                            {
                                      "q": "Buzzword: \"Mesangial IgA\"?",
                                      "a": "<b>Berger Disease</b> or <b>Henoch-Sch\u00f6nlein Purpura</b>."
                            },
                            {
                                      "q": "Buzzword: \"Orphan Annie Eye\" nuclei in the kidney?",
                                      "a": "Not standard\u2014usually Thyroid, but can be seen in some variants of Papillary <b>RCC</b> (rarely tested, stick to Thyroid)."
                            },
                            {
                                      "q": "Buzzword: \"Eosinophilic granular cytoplasm\" in a well-circumscribed renal mass?",
                                      "a": "Renal Oncocytoma."
                            },
                            {
                                      "q": "Definition of Hyperacute Transplant Rejection?",
                                      "a": "Occurs within minutes; mediated by pre-formed antibodies (Type II hypersensitivity) causing thrombosis."
                            },
                            {
                                      "q": "Most common cause of Hyperacute Rejection?",
                                      "a": "ABO blood group incompatibility or anti-HLA antibodies."
                            },
                            {
                                      "q": "Hallmark of Acute Cellular Rejection?",
                                      "a": "Endothelialitis or interstitial infiltration by T-cells (Type IV hypersensitivity)."
                            },
                            {
                                      "q": "Histological finding in Chronic Transplant Rejection?",
                                      "a": "Intimal thickening (vascular fibrosis) and interstitial fibrosis with tubular atrophy."
                            },
                            {
                                      "q": "Viral infection frequently causing graft failure in renal transplants?",
                                      "a": "<i>BK Polyomavirus</i>."
                            },
                            {
                                      "q": "Diagnostic histological finding for <i>BK Virus</i> nephropathy?",
                                      "a": "Intranuclear viral inclusions in tubular epithelial cells.\n\nXXVIII. Pregnancy and the Kidney"
                            },
                            {
                                      "q": "Normal physiological change in GFR during pregnancy?",
                                      "a": "GFR increases by approximately 50% due to increased plasma volume."
                            },
                            {
                                      "q": "Definition of Preeclampsia?",
                                      "a": "New-onset hypertension (>140/90) and proteinuria (or end-organ dysfunction) after 20 weeks gestation."
                            },
                            {
                                      "q": "Pathognomonic renal lesion in Preeclampsia?",
                                      "a": "Glomerular Endotheliosis (swelling of endothelial cells obliterating capillary lumens)."
                            },
                            {
                                      "q": "Significance of HELLP syndrome in renal context?",
                                      "a": "Hemolysis, Elevated Liver enzymes, and Low Platelets; high risk for <b>Acute Kidney Injury</b> and DIC.\n\nXXIX. Advanced Acid-Base & Electrolyte Pathophysiology"
                            },
                            {
                                      "q": "Formula for the <b>Anion Gap</b>?",
                                      "a": "Na<sup>+</sup> - (Cl<sup>-</sup> + HCO<sub>3</sub><sup>-</sup>)."
                            },
                            {
                                      "q": "Normal range for the Serum <b>Anion Gap</b>?",
                                      "a": "8 to 12 mEq/L."
                            },
                            {
                                      "q": "Mnemonic for High <b>Anion Gap</b> Metabolic Acidosis (<b>HAGMA</b>)?",
                                      "a": "MUDPILES (Methanol, Uremia, DKA, Propylene glycol, Iron/INH, Lactic acidosis, Ethylene glycol, Salicylates)."
                            },
                            {
                                      "q": "Calculation for the Urinary <b>Anion Gap</b>?",
                                      "a": "Na<sup>+</sup> + K<sup>+</sup> - Cl<sup>-</sup>."
                            },
                            {
                                      "q": "Significance of a negative Urinary <b>Anion Gap</b> in <b>NAGMA</b>?",
                                      "a": "Suggests the kidney is appropriately excreting NH<sub>4</sub>Cl (e.g., diarrhea)."
                            },
                            {
                                      "q": "Significance of a positive Urinary <b>Anion Gap</b> in <b>NAGMA</b>?",
                                      "a": "Suggests a renal defect in H<sup>+</sup> excretion (e.g., <b>Renal Tubular Acidosis</b>)."
                            },
                            {
                                      "q": "Primary renal compensation for Chronic Respiratory Alkalosis?",
                                      "a": "Decreased HCO<sub>3</sub><sup>-</sup> reabsorption in the proximal tubule.\n\nXXX. Specialized Morphology & Molecular Markers"
                            },
                            {
                                      "q": "Staining method to identify the basement membrane \"spikes\" in <b>Membranous Nephropathy</b>?",
                                      "a": "Jones Silver Stain."
                            },
                            {
                                      "q": "Difference between \"Primary\" and \"Secondary\" <b>FSGS</b>?",
                                      "a": "Primary is podocyte injury (effacement); Secondary is due to reduced nephron mass and hyperfiltration."
                            },
                            {
                                      "q": "Major ultrastructural difference between <b>MCD</b> and <b>FSGS</b>?",
                                      "a": "<b>MCD</b> shows diffuse foot process effacement; <b>FSGS</b> shows effacement plus focal detachment of podocytes from the GBM."
                            },
                            {
                                      "q": "Characterize \"Collapsing Glomerulopathy\"?",
                                      "a": "A severe variant of <b>FSGS</b> typically associated with HIV or APOL1 high-risk genotypes."
                            },
                            {
                                      "q": "Function of the \"Mesangial Cell\"?",
                                      "a": "Contractile cell that provides structural support and regulates GFR surface area.\n\nXXXI. Clinical Syndromes & Manifestations"
                            },
                            {
                                      "q": "Definition of \"Fractional Excretion of Urea\" (FEUrea)?",
                                      "a": "Used instead of <b>FENA</b> when the patient is on diuretics; <35% suggests prerenal etiology."
                            },
                            {
                                      "q": "Relationship between GFR and Serum Creatinine?",
                                      "a": "Non-linear/Inversely proportional; a doubling of Creatinine represents a ~50% loss of GFR."
                            },
                            {
                                      "q": "Most common electrolyte cause of Nephrogenic Diabetes Insipidus?",
                                      "a": "Hypercalcemia or Hypokalemia."
                            },
                            {
                                      "q": "Clinical finding of \"Asterixis\" in a renal patient indicates?",
                                      "a": "Uremic Encephalopathy (an urgent indication for dialysis)."
                            },
                            {
                                      "q": "The \"AEIOU\" indications for urgent Dialysis?",
                                      "a": "Acidosis, Electrolytes (Hyperkalemia), Ingestions (Toxins), Overload (Volume), and Uremia.\n\nXXXII. Final \"Mastery\" Cards"
                            },
                            {
                                      "q": "Distinction between \"Isolated Hematuria\" and \"<b>Nephritic Syndrome</b>\"?",
                                      "a": "Isolated hematuria (e.g., IgA, Thin Basement Membrane) lacks HTN, edema, or impaired GFR."
                            },
                            {
                                      "q": "Thin Basement Membrane Disease (Benign Familial Hematuria) cause?",
                                      "a": "Mutation in Type IV Collagen (alpha-3 or alpha-4 chains), but milder than Alport."
                            },
                            {
                                      "q": "Common renal complication of Sarcoidosis?",
                                      "a": "Hypercalciuria and Hypercalcemia (due to 1-alpha-hydroxylase activity in granulomas)."
                            },
                            {
                                      "q": "Mechanism of \"Salt-Wasting\" in Medullary Cystic Kidney Disease?",
                                      "a": "Inability of damaged distal tubules to reabsorb sodium, leading to polyuria and hypotension."
                            },
                            {
                                      "q": "Renal cell type responsible for EPO (Erythropoietin) production?",
                                      "a": "Interstitial cells in the peritubular capillary bed of the renal cortex."
                            },
                            {
                                      "q": "Most common use for the \"PAS (Periodic Acid-Schiff)\" stain in renal pathology?",
                                      "a": "Highlighting the Basement Membrane and mesangial matrix (stains glycogen and mucopolysaccharides)."
                            },
                            {
                                      "q": "Histological appearance of \"Fibrinoid Necrosis\" in the kidney?",
                                      "a": "Smudgy, bright pink (eosinophilic) areas in the vessel wall, typically seen in Malignant HTN or Vasculitis."
                            },
                            {
                                      "q": "What does \"Mesangial Matrix Expansion\" look like on Light Microscopy?",
                                      "a": "Increased pink material between glomerular capillaries, seen in Diabetes and Amyloidosis."
                            },
                            {
                                      "q": "Significance of \"Extracapillary Proliferation\"?",
                                      "a": "Synonym for Crescent formation in <b>RPGN</b>."
                            },
                            {
                                      "q": "Appearance of \"Subepithelial Deposits\" on EM?",
                                      "a": "Electron-dense deposits located between the visceral epithelial cell (podocyte) and the GBM.\n\nXXXIV. Pediatric & Developmental Renal Pathology"
                            },
                            {
                                      "q": "Most common cause of \"Multicystic Dysplastic Kidney\" (MCDK)?",
                                      "a": "Atresia of the ureteric bud during development."
                            },
                            {
                                      "q": "Is Multicystic Dysplastic Kidney (MCDK) usually unilateral or bilateral?",
                                      "a": "Usually unilateral; bilateral is incompatible with life."
                            },
                            {
                                      "q": "Clinical finding in \"Ureterocele\"?",
                                      "a": "Cystic dilation of the terminal ureter, often presenting with a \"cobra head\" sign on imaging."
                            },
                            {
                                      "q": "Define \"Prune Belly Syndrome\" (Eagle-Barrett)?",
                                      "a": "Triad of abdominal muscle deficiency, undescended testes, and urinary tract anomalies (e.g., megaureter)."
                            },
                            {
                                      "q": "Pathogenesis of \"Megaureter\"?",
                                      "a": "Aperistaltic distal ureteral segment causing functional obstruction and dilation.\n\nXXXV. Advanced Renal Vascular Physiology-Pathology"
                            },
                            {
                                      "q": "Mechanism of \"Pressure Natriuresis\"?",
                                      "a": "Increase in sodium excretion by the kidney in response to an elevated arterial pressure."
                            },
                            {
                                      "q": "Define \"Autoregulation\" of GFR?",
                                      "a": "The ability of the kidney to maintain constant GFR between Mean Arterial Pressures of 80\u2013180 mmHg."
                            },
                            {
                                      "q": "Myogenic mechanism of GFR regulation?",
                                      "a": "Afferent arteriole constricts in response to high stretch (increased pressure) to protect the glomerulus."
                            },
                            {
                                      "q": "Tubuloglomerular Feedback (TGF) mechanism?",
                                      "a": "Macula densa senses high NaCl \u2192 releases adenosine \u2192 constricts afferent arteriole to decrease GFR."
                            },
                            {
                                      "q": "Primary renal site of \"Dopamine\" synthesis?",
                                      "a": "Proximal tubule cells."
                            },
                            {
                                      "q": "Effect of low-dose Dopamine on renal blood flow?",
                                      "a": "Dilates interlobular arteries and afferent/efferent arterioles, increasing RBF.\n\nXXXVI. Metabolic and Rare Systemic States"
                            },
                            {
                                      "q": "Renal manifestation of \"Fabry Disease\"?",
                                      "a": "Accumulation of Gb3 in podocytes (appears as \"Zebra bodies\" on EM), leading to ESRD."
                            },
                            {
                                      "q": "Typical urinary finding in \"Alkaptonuria\"?",
                                      "a": "Urine turns black when left standing (Homogentisic acid oxidation)."
                            },
                            {
                                      "q": "Renal pathology in \"Cystinosis\"?",
                                      "a": "Accumulation of cystine crystals in lysosomes, leading to PCT damage and <b>Fanconi Syndrome</b>."
                            },
                            {
                                      "q": "Distinction between \"Primary Hyperoxaluria\" and \"Enteric Hyperoxaluria\"?",
                                      "a": "Primary is a liver enzyme defect; Enteric is due to increased fat malabsorption (e.g., Crohn's) binding calcium and leaving oxalate free for absorption.\n\nXXXVII. Integrated Pharmacology Fine Print"
                            },
                            {
                                      "q": "Class of drugs that can cause \"Retroperitoneal Fibrosis\"?",
                                      "a": "Ergot alkaloids (e.g., Methysergide) and certain Beta-blockers."
                            },
                            {
                                      "q": "Renal effect of \"Cyclosporine\" toxicity?",
                                      "a": "Potent vasoconstriction of afferent arterioles leading to chronic interstitial fibrosis."
                            },
                            {
                                      "q": "Difference in mechanism between \"Conivaptan\" and \"Furosemide\"?",
                                      "a": "Conivaptan is a V2-receptor antagonist (aquaretic); Furosemide is a natriuretic."
                            },
                            {
                                      "q": "Effect of \"Spironolactone\" on the heart in CKD?",
                                      "a": "Reduces cardiac fibrosis but carries a high risk of life-threatening hyperkalemia."
                            },
                            {
                                      "q": "Mechanism of \"Sevelamer\"?",
                                      "a": "Non-absorbable phosphate binder used in CKD to prevent hyperphosphatemia.\n\nXXXVIII. Final \"Red Flag\" Clinical Findings"
                            },
                            {
                                      "q": "Presence of \"Pneumaturia\" (air in urine) suggests?",
                                      "a": "Vesicocolic fistula (often from Diverticulitis) or emphysematous cystitis."
                            },
                            {
                                      "q": "\"Hard\" prostate on DRE with elevated PSA and \"Blastic\" bone lesions?",
                                      "a": "Metastatic Prostate Adenocarcinoma."
                            },
                            {
                                      "q": "\"Soft\" boggy prostate with exquisite tenderness and fever?",
                                      "a": "Acute Prostatitis (usually <i>E. coli</i>)."
                            },
                            {
                                      "q": "Definition of \"Microscopic Hematuria\"?",
                                      "a": ">3 RBCs per high-power field in a settled urine sediment."
                            },
                            {
                                      "q": "Key difference between \"Primary\" and \"Secondary\" Hyperaldosteronism?",
                                      "a": "Primary has low Renin (Conn\u2019s); Secondary has high Renin (e.g., <b>Renal Artery Stenosis</b>)."
                            },
                            {
                                      "q": "Most common renal manifestation of Systemic Sclerosis (Scleroderma)?",
                                      "a": "Scleroderma Renal Crisis (abrupt malignant hypertension and oligo-anuric <b>AKI</b>)."
                            },
                            {
                                      "q": "Histological hallmark of Scleroderma Renal Crisis?",
                                      "a": "\"Onion-skin\" hyperplastic arteriolosclerosis and thrombotic microangiopathy."
                            },
                            {
                                      "q": "Mechanism of \"Churg-Strauss\" (EGPA) renal involvement?",
                                      "a": "Necrotizing glomerulonephritis (pauci-immune) associated with asthma and peripheral eosinophilia."
                            },
                            {
                                      "q": "Difference in ANCA specificity for <b>GPA</b> vs. MPA?",
                                      "a": "<b>GPA</b> is typically PR3-ANCA (c-ANCA); MPA is typically MPO-ANCA (p-ANCA)."
                            },
                            {
                                      "q": "Target of the autoantibody in Anti-GBM Disease?",
                                      "a": "The NC1 domain of the alpha-3 chain of Type IV Collagen.\n\nXL. Rare Syndromes and Hereditary Conditions"
                            },
                            {
                                      "q": "<b>Gitelman Syndrome</b> vs. <b>Bartter Syndrome</b>: Primary difference in urinary calcium?",
                                      "a": "Gitelman has hypocalciuria; Bartter has hypercalciuria (or normal)."
                            },
                            {
                                      "q": "Clinical features of \"<b>Liddle Syndrome</b>\"?",
                                      "a": "Early-onset hypertension, hypokalemia, and metabolic alkalosis with low renin and low aldosterone."
                            },
                            {
                                      "q": "Treatment for <b>Liddle Syndrome</b>?",
                                      "a": "Amiloride or Triamterene (to block the overactive ENaC channels)."
                            },
                            {
                                      "q": "Genetic defect in \"Syndrome of Apparent Mineralocorticoid Excess\" (SAME)?",
                                      "a": "Deficiency of 11&beta;-HSD2 enzyme, allowing cortisol to activate mineralocorticoid receptors."
                            },
                            {
                                      "q": "Substance in black licorice that mimics \"SAME\"?",
                                      "a": "Glycyrrhetinic acid (inhibits 11&beta;-HSD2).\n\nXLI. Advanced Tubular & Interstitial Fine Print"
                            },
                            {
                                      "q": "Renal \"Tylosis\" (thickening) is associated with which rare condition?",
                                      "a": "Howel-Evans Syndrome (also associated with esophageal cancer)."
                            },
                            {
                                      "q": "Most common cause of \"Granulomatous Interstitial Nephritis\"?",
                                      "a": "Sarcoidosis or Tuberculosis."
                            },
                            {
                                      "q": "What are \"Balkan Endemic Nephropathy\" risks?",
                                      "a": "Aristolochic acid exposure; leads to interstitial fibrosis and high risk of <b>Urothelial Carcinoma</b>."
                            },
                            {
                                      "q": "Mechanism of \"Lead Nephropathy\"?",
                                      "a": "Chronic tubulointerstitial nephritis and \"saturnine gout\" due to reduced urate excretion."
                            },
                            {
                                      "q": "Diagnostic finding in Lead poisoning histology?",
                                      "a": "Eosinophilic intranuclear inclusion bodies in proximal tubule cells.\n\nXLII. Complex Electrolyte & Acid-Base Scenarios"
                            },
                            {
                                      "q": "Definition of \"Type 3 <b>RTA</b>\"?",
                                      "a": "A rare combination of Type 1 and Type 2 <b>RTA</b> (usually due to Carbonic Anhydrase II deficiency)."
                            },
                            {
                                      "q": "Renal response to \"Hypokalemia\"?",
                                      "a": "K<sup>+</sup> is reabsorbed in exchange for H<sup>+</sup> in the alpha-intercalated cells, potentially causing metabolic alkalosis."
                            },
                            {
                                      "q": "What is the \"Osmolar Gap\" in renal toxicology?",
                                      "a": "Measured Osmolality minus Calculated Osmolality; >10 suggests presence of unmeasured toxins (e.g., Ethanol, Ethylene Glycol)."
                            },
                            {
                                      "q": "Effect of Hypermagnesemia on the kidney?",
                                      "a": "Acts as a calcium-channel blocker; inhibits PTH release and can lead to hypocalcemia.\n\nXLIII. Final Neoplasia and Surgical Pathology"
                            },
                            {
                                      "q": "Difference between \"Cystic Nephroma\" and \"Multilocular Cystic <b>RCC</b>\"?",
                                      "a": "Cystic Nephroma is benign; Multilocular Cystic <b>RCC</b> is a low-malignant-potential tumor."
                            },
                            {
                                      "q": "Defining feature of \"Medullary Thyroid Carcinoma\" in MEN 2A/2B?",
                                      "a": "Not renal, but often associated with Pheochromocytoma, which causes secondary renal hypertension."
                            },
                            {
                                      "q": "Most common site for a \"Ureteral Calculi\" to lodge?",
                                      "a": "The Ureterovesical Junction (UVJ)."
                            },
                            {
                                      "q": "Hallmark of \"Xanthogranulomatous Pyelonephritis\" on CT?",
                                      "a": "\"Bear Paw Sign\" (dilated calyces mimicking a paw print)."
                            },
                            {
                                      "q": "Characteristic IHC marker for <b>Renal Cell Carcinoma</b>?",
                                      "a": "PAX8 (positive in most renal and thyroid tumors)."
                            },
                            {
                                      "q": "Appearance of \"Hobnail Cells\" in the kidney?",
                                      "a": "Suggestive of Collecting Duct Carcinoma or Clear Cell Adenocarcinoma of the urinary tract.\n\nXLIV. Wrap-Up High-Yield Facts"
                            },
                            {
                                      "q": "Normal value for the \"Albumin-to-Creatinine Ratio\" (ACR)?",
                                      "a": "< 30 mg/g."
                            },
                            {
                                      "q": "Definition of \"Macroscopic Proteinuria\"?",
                                      "a": "> 300 mg/day."
                            },
                            {
                                      "q": "Common renal side effect of \"VEGF Inhibitors\" (e.g., Bevacizumab)?",
                                      "a": "Hypertension and Thrombotic Microangiopathy (TMA)."
                            },
                            {
                                      "q": "Distinction between \"Ureteritis Cystica\" and \"Cystitis Cystica\"?",
                                      "a": "Location; Ureteritis Cystica occurs in the ureter, often due to chronic inflammation/stones."
                            },
                            {
                                      "q": "Primary nerve responsible for bladder contraction?",
                                      "a": "Pelvic Splanchnic Nerves (Parasympathetic S2-S4)."
                            },
                            {
                                      "q": "Definition of \"Pseudohypoaldosteronism Type I\"?",
                                      "a": "Genetic resistance to aldosterone; presents with salt-wasting, hyperkalemia, and high renin/aldosterone."
                            },
                            {
                                      "q": "Difference between \"Primary\" and \"Secondary\" Pseudohypoaldosteronism?",
                                      "a": "Primary is a genetic receptor defect; Secondary is often due to urinary tract obstruction or infection in infants."
                            },
                            {
                                      "q": "Genetic defect in \"<b>Gitelman Syndrome</b>\"?",
                                      "a": "Mutation in the SLC12A3 gene encoding the Na<sup>+</sup>-Cl<sup>-</sup> cotransporter in the distal tubule."
                            },
                            {
                                      "q": "Typical urinary Ca<sup>2+</sup> finding in <b>Bartter Syndrome</b>?",
                                      "a": "Hypercalciuria (leads to nephrocalcinosis)."
                            },
                            {
                                      "q": "Major electrolyte risk when rapidly correcting Hyponatremia?",
                                      "a": "Osmotic Demyelination Syndrome (Central Pontine Myelinolysis)."
                            },
                            {
                                      "q": "Major electrolyte risk when rapidly correcting Hypernatremia?",
                                      "a": "Cerebral Edema.\n\nXLVI. Advanced Vascular & Ischemic Pathology"
                            },
                            {
                                      "q": "Pathophysiology of \"Atheroembolic Renal Disease\"?",
                                      "a": "Cholesterol crystals break off from the aorta (often after catheterization) and lodge in small renal arteries."
                            },
                            {
                                      "q": "Pathognomonic histological finding in Atheroembolic Renal Disease?",
                                      "a": "Biconvex, needle-shaped \"cholesterol clefts\" within the arterial lumen."
                            },
                            {
                                      "q": "Classic \"triad\" of physical findings in Atheroembolic Disease?",
                                      "a": "Livedo reticularis, eosinophilia, and acute/subacute renal failure."
                            },
                            {
                                      "q": "Definition of \"Abdominal Compartment Syndrome\" in renal failure?",
                                      "a": "Intra-abdominal pressure > 20 mmHg causing extrinsic compression of renal veins and decreased GFR.\n\nXLVII. Pregnancy-Related Renal Physiology"
                            },
                            {
                                      "q": "What happens to Serum Creatinine levels in normal pregnancy?",
                                      "a": "They decrease (typical range 0.4\u20130.8 mg/dL) due to increased GFR."
                            },
                            {
                                      "q": "Cause of \"Acute Fatty Liver of Pregnancy\" (AFLP) renal involvement?",
                                      "a": "Microvesicular steatosis can lead to hepatorenal-like syndrome and <b>AKI</b>."
                            },
                            {
                                      "q": "Primary risk factor for \"Renal Cortical Necrosis\"?",
                                      "a": "Massive obstetric hemorrhage or abruptio placentae causing vasospasm and DIC.\n\nXLVIII. Clinical Signs and Physical Exam Correlation"
                            },
                            {
                                      "q": "Meaning of a \"Positive Lloyd's Sign\"?",
                                      "a": "Costovertebral angle tenderness (CVAT), indicative of pyelonephritis or renal calculi."
                            },
                            {
                                      "q": "Cause of \"Bruit\" heard over the renal arteries?",
                                      "a": "Turbulent blood flow due to <b>Renal Artery Stenosis</b>."
                            },
                            {
                                      "q": "Significance of \"Palpable Kidneys\" in a neonate?",
                                      "a": "Often represents Multicystic Dysplastic Kidney or <b>ARPKD</b>.\n\nXLIX. Specialized Diagnostic Tests"
                            },
                            {
                                      "q": "What is the \"Water Deprivation Test\" used for?",
                                      "a": "Distinguishing between Central Diabetes Insipidus, Nephrogenic DI, and Primary Polydipsia."
                            },
                            {
                                      "q": "Result of Water Deprivation Test in Primary Polydipsia?",
                                      "a": "Increase in urine osmolality (> 800 mOsm/kg) after water restriction alone."
                            },
                            {
                                      "q": "Response to Desmopressin (dDAVP) in Central Diabetes Insipidus?",
                                      "a": "Significant increase in urine osmolality (> 50% increase)."
                            },
                            {
                                      "q": "Response to Desmopressin (dDAVP) in Nephrogenic Diabetes Insipidus?",
