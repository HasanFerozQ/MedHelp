                            {
                                      "q": "Most common type of invasive breast cancer?",
                                      "a": "<b>Invasive Ductal Carcinoma</b> (No Special Type)."
                            },
                            {
                                      "q": "Histologic feature of <b>Invasive Lobular Carcinoma</b>?",
                                      "a": "\"Single-file\" pattern of cells due to loss of E-cadherin."
                            },
                            {
                                      "q": "Clinical presentation of <b>Inflammatory Breast Cancer</b>?",
                                      "a": "Peau d\u2019orange (orange peel skin) due to lymphatic obstruction."
                            },
                            {
                                      "q": "Significance of <b>Paget Disease</b> of the Nipple?",
                                      "a": "Indicates underlying Ductal Carcinoma In Situ (<b>DCIS</b>).\n\nInfectious & Inflammatory"
                            },
                            {
                                      "q": "Causative agent of <i>Syphilis</i>?",
                                      "a": "<i>Treponema pallidum</i>."
                            },
                            {
                                      "q": "Characteristic lesion of Primary <i>Syphilis</i>?",
                                      "a": "Chancre (painless ulcer)."
                            },
