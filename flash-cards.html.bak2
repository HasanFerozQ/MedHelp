                            },
                            {
                                      "q": "Normal value for the <b>A-a gradient</b> in a young adult?",
                                      "a": "5\u201315 mmHg."
                            },
                            {
                                      "q": "Calculation for the age-adjusted upper limit of normal <b>A-a gradient</b>?",
                                      "a": "(Age / 4) + 4."
                            },
                            {
                                      "q": "Only cause of hypoxemia that cannot be corrected with 100% O<sub>2</sub>?",
                                      "a": "Right-to-Left Shunt."
                            },
                            {
                                      "q": "Oxygen content formula (CaO<sub>2</sub>)?",
                                      "a": "(1.34 &times; Hb &times; SaO<sub>2</sub>) + (0.003 &times; PaO<sub>2</sub>).\n\nX. Detailed Pathology (Robbins Focus)"
                            },
                            {
                                      "q": "Microscopic appearance of \"Heart Failure Cells\"?",
                                      "a": "Hemosiderin-laden macrophages in the alveoli."
                            },
                            {
                                      "q": "Pathogenesis of \"Brown Induration\" of the lungs?",
                                      "a": "Chronic pulmonary congestion due to left-sided heart failure."
                            },
                            {
                                      "q": "Histologic hallmark of <b>Goodpasture Syndrome</b>?",
                                      "a": "Linear IgG deposits along the alveolar basement membrane."
                            },
                            {
                                      "q": "Classic triad of <b>Wegener Granulomatosis</b> (<b>Granulomatosis with Polyangiitis</b>)?",
                                      "a": "Focal necrotizing vasculitis, necrotizing granulomas of the lung, and necrotizing glomerulonephritis."
                            },
                            {
                                      "q": "Serological marker for <b>Granulomatosis with Polyangiitis</b>?",
                                      "a": "c-ANCA (PR3-ANCA)."
                            },
                            {
                                      "q": "Serological marker for <b>Churg-Strauss Syndrome</b> (Eosinophilic <b>Granulomatosis with Polyangiitis</b>)?",
                                      "a": "p-ANCA (MPO-ANCA)."
                            },
                            {
                                      "q": "Type of hypersensitivity reaction in <b>Hypersensitivity Pneumonitis</b>?",
                                      "a": "Mixed Type III and Type IV."
                            },
                            {
                                      "q": "Common name for <b>Hypersensitivity Pneumonitis</b> caused by actinomycetes in hay?",
                                      "a": "<b>Farmer\u2019s Lung</b>."
                            },
                            {
                                      "q": "Most common location for Intralobar Sequestration?",
                                      "a": "Left lower lobe."
                            },
                            {
                                      "q": "Difference between Sequestration and normal lung tissue?",
                                      "a": "Sequestration lacks communication with the tracheobronchial tree and has systemic arterial supply."
                            },
                            {
                                      "q": "Definition of Resorption Atelectasis?",
                                      "a": "Lung collapse due to complete obstruction of an airway."
                            },
                            {
                                      "q": "Most common cause of Compression Atelectasis?",
                                      "a": "Accumulation of fluid (effusion), blood, or air within the pleural cavity.\n\nXI. Detailed Microbiology & Clinical Presentations"
                            },
                            {
                                      "q": "<b>Pneumonia</b> in an alcoholic with \"Current Jelly\" sputum?",
                                      "a": "<i><i>Klebsiella</i> pneumoniae</i>."
                            },
                            {
                                      "q": "Common cause of <b>pneumonia</b> following a viral influenza infection?",
                                      "a": "<i>Staphylococcus aureus</i>."
                            },
                            {
                                      "q": "Only DNA virus causing lower respiratory tract infections in children?",
                                      "a": "Adenovirus."
                            },
                            {
                                      "q": "Major virulence factor of <i>Streptococcus pneumoniae</i>?",
                                      "a": "Polysaccharide capsule."
                            },
                            {
                                      "q": "Lab finding in <i>Legionella</i> <b>pneumonia</b>?",
                                      "a": "Hyponatremia (low sodium)."
                            },
                            {
                                      "q": "Culture medium required for <i><i>Legionella</i> pneumophila</i>?",
                                      "a": "Charcoal Yeast Extract (CYE) agar buffered with iron and cysteine."
                            },
                            {
                                      "q": "Morphological stage of Lobar <b>Pneumonia</b> characterized by fibrinous exudate and RBCs?",
                                      "a": "Red Hepatization."
                            },
                            {
                                      "q": "Morphological stage of Lobar <b>Pneumonia</b> where RBCs disintegrate but fibrin remains?",
                                      "a": "Gray Hepatization."
                            },
                            {
                                      "q": "Common cause of Nosocomial (hospital-acquired) <b>pneumonia</b>?",
                                      "a": "<i><i>Pseudomonas</i> aeruginosa</i> or MRSA."
                            },
                            {
                                      "q": "Primary risk factor for developing a <b>Lung Abscess</b>?",
                                      "a": "Aspiration (often due to alcoholism, epilepsy, or poor dentition)."
                            },
                            {
                                      "q": "Most common organisms isolated from Lung Abscesses?",
                                      "a": "Anaerobes (Bacteroides, Fusobacterium, Peptostreptococcus).\n\nXII. Pharmacology (Standard Board Prep)"
                            },
                            {
                                      "q": "Mechanism of action of Theophylline?",
                                      "a": "Phosphodiesterase inhibition (increases cAMP) and adenosine receptor antagonism."
                            },
                            {
                                      "q": "Major limiting side effect of Theophylline?",
                                      "a": "Narrow therapeutic index (cardiotoxicity and neurotoxicity/seiers)."
                            },
                            {
                                      "q": "Mechanism of action of Cromolyn sodium?",
                                      "a": "Stabilizes mast cell membranes to prevent degranulation."
                            },
                            {
                                      "q": "Monoclonal antibody used in severe, refractory <b>asthma</b>?",
                                      "a": "Omalizumab."
                            },
                            {
                                      "q": "Target of Omalizumab?",
                                      "a": "IgE (binds unbound IgE to prevent mast cell sensitization)."
                            },
                            {
                                      "q": "Mechanism of Mepolizumab?",
                                      "a": "IL-5 antagonist (inhibits eosinophil recruitment)."
                            },
                            {
                                      "q": "Drug of choice for treating exercise-induced bronchospasm?",
                                      "a": "Albuterol (SABA)."
                            },
                            {
                                      "q": "First-line treatment for a COPD exacerbation?",
                                      "a": "SABA (Albuterol) + SAMA (Ipratropium)."
                            },
                            {
                                      "q": "Use of Guaifenesin?",
                                      "a": "Expectorant (thins respiratory secretions)."
                            },
                            {
                                      "q": "Mechanism of action of N-acetylcysteine in <b>CF</b> patients?",
                                      "a": "Mucolytic (breaks disulfide bonds in mucus)."
                            },
                            {
                                      "q": "Antidote for Acetaminophen toxicity?",
                                      "a": "N-acetylcysteine (replenishes glutathione)."
                            },
                            {
                                      "q": "Primary toxicity of Isoniazid?",
                                      "a": "Hepatotoxicity and peripheral neuropathy (B6 deficiency)."
                            },
                            {
                                      "q": "Reason for adding Vitamin B6 (Pyridoxine) to Isoniazid therapy?",
                                      "a": "To prevent peripheral neuropathy."
                            },
                            {
                                      "q": "Drug causing \"Red-Orange\" discoloration of body fluids?",
                                      "a": "Rifampin.\n\nXIII. Radiography & Physical Exam Signs"
                            },
                            {
                                      "q": "Radiographic sign for <b>Croup</b> (<b>Laryngotracheobronchitis</b>)?",
                                      "a": "Steeple Sign (subglottic narrowing)."
                            },
                            {
                                      "q": "Radiographic sign for <b>Epiglottitis</b>?",
                                      "a": "Thumbprint Sign (swollen epiglottis)."
                            },
                            {
                                      "q": "Most common cause of <b>Epiglottitis</b>?",
                                      "a": "<i><i>Haemophilus influenzae</i> type b</i> (Hib)."
                            },
                            {
                                      "q": "Physical exam finding: Increased tactile fremitus?",
                                      "a": "Consolidation (e.g., Lobar <b>Pneumonia</b>)."
                            },
                            {
                                      "q": "Physical exam finding: Decreased tactile fremitus with hyperresonance?",
                                      "a": "<b>Pneumothorax</b> or <b>Emphysema</b>."
                            },
                            {
                                      "q": "Physical exam finding: Decreased tactile fremitus with dullness to percussion?",
                                      "a": "Pleural Effusion."
                            },
                            {
                                      "q": "Definition of <b>Egophony</b>?",
                                      "a": "\"E\" to \"A\" change heard over areas of lung consolidation."
                            },
                            {
                                      "q": "Appearance of Pulmonary Edema on Chest X-ray?",
                                      "a": "Kerley B lines, cephalization of vessels, and perihilar \"Batwing\" opacities."
                            },
                            {
                                      "q": "Definition of the \"<b>Westermark Sign</b>\" on CXR?",
                                      "a": "Regional oligemia (decreased vascularity) distal to a <b>pulmonary embolism</b>."
                            },
                            {
                                      "q": "Definition of \"<b>Hampton\u2019s Hump</b>\" on CXR?",
                                      "a": "Shallow, wedge-shaped opacification in the periphery (represents lung infarction).\n\nXIV. Respiratory Acid-Base"
                            },
                            {
                                      "q": "Primary disturbance in Respiratory Acidosis?",
                                      "a": "Increased PaCO<sub>2</sub> (> 40 mmHg)."
                            },
                            {
                                      "q": "Common causes of Respiratory Alkalosis?",
                                      "a": "Hyperventilation (anxiety, <b>PE</b>, high altitude, salicylate poisoning early)."
                            },
                            {
                                      "q": "Renal compensation for chronic respiratory acidosis?",
                                      "a": "Increased HCO<sub>3</sub><sup>-</sup> reabsorption and H<sup>+</sup> excretion."
                            },
                            {
                                      "q": "Metabolic disturbance in Salicylate (Aspirin) overdose?",
                                      "a": "Mixed Respiratory Alkalosis and Anion Gap Metabolic Acidosis."
                            },
                            {
                                      "q": "Histologic finding in <b>Small Cell Carcinoma</b>?",
                                      "a": "Small blue cells with \"Azzopardi effect\" (DNA staining of vessel walls)."
                            },
                            {
                                      "q": "Most common lung cancer associated with non-smokers and EGFR mutations?",
                                      "a": "<b>Adenocarcinoma</b>."
                            },
                            {
                                      "q": "Histologic appearance of Bronchioloalveolar Carcinoma (<b>Adenocarcinoma</b> in situ)?",
                                      "a": "Tall, columnar cells growing along existing alveolar septa (lepidic growth)."
                            },
                            {
                                      "q": "Definition of a Hamartoma in the lung?",
                                      "a": "Benign tumor composed of \"disorganized\" lung tissue, often containing cartilage and fat."
                            },
                            {
                                      "q": "Radiographic appearance of a Hamartoma?",
                                      "a": "\"Popcorn\" calcification on CT or CXR."
                            },
                            {
                                      "q": "Most common primary site for \"cannonball\" metastases to the lung?",
                                      "a": "Renal cell carcinoma or Choriocarcinoma."
                            },
                            {
                                      "q": "Definition of a \"Pleural Tail\" on imaging?",
                                      "a": "Linear opacity extending from a peripheral lung nodule to the visceral pleura."
                            },
                            {
                                      "q": "Pathogenesis of Silicotic nodules?",
                                      "a": "Macrophages ingest silica, die, and release fibrogenic factors."
                            },
                            {
                                      "q": "Major risk factor for developing Mesothelioma?",
                                      "a": "Asbestos exposure (long latency period of 25\u201340 years)."
                            },
                            {
                                      "q": "Histologic marker for Mesothelioma?",
                                      "a": "Calretinin positive and long, slender microvilli on electron microscopy.\n\nXVI. West's Respiratory Physiology: Gas Exchange & Transport"
                            },
                            {
                                      "q": "Definition of Diffusing Capacity (DL<sub>CO</sub>)?",
                                      "a": "Measurement of the lung's ability to transfer gas from inspired air to RBCs using Carbon Monoxide."
                            },
                            {
                                      "q": "Condition that increases DL<sub>CO</sub>?",
                                      "a": "Alveolar hemorrhage (e.g., Goodpasture) or polycythemia."
                            },
                            {
                                      "q": "Conditions that decrease DL<sub>CO</sub>?",
                                      "a": "<b>Emphysema</b>, Pulmonary Fibrosis, and <b>Pulmonary Embolism</b>."
                            },
                            {
                                      "q": "Oxygen transport: Definition of <b>Methemoglobinemia</b>?",
                                      "a": "Iron in hemoglobin is in the Fe<sup>3+</sup> (ferric) state instead of Fe<sup>2+</sup> (ferrous)."
                            },
                            {
                                      "q": "Classic clinical sign of <b>Methemoglobinemia</b>?",
                                      "a": "Cyanosis unresponsive to supplemental oxygen and \"chocolate-colored\" blood."
                            },
                            {
                                      "q": "Treatment for <b>Methemoglobinemia</b>?",
                                      "a": "Methylene blue or Vitamin C."
                            },
                            {
                                      "q": "Definition of the <b>Bohr Effect</b>?",
                                      "a": "Increased CO<sub>2</sub> and decreased pH lower hemoglobin's affinity for O<sub>2</sub>."
                            },
                            {
                                      "q": "Effect of 2,3-BPG on the Oxygen-Hemoglobin dissociation curve?",
                                      "a": "Stabilizes the T-state (deoxygenated) and shifts the curve to the right."
                            },
                            {
                                      "q": "Respiratory center responsible for the rhythm of breathing?",
                                      "a": "Pre-B\u00f6tzinger complex in the medulla."
                            },
                            {
                                      "q": "Primary stimulus for central chemoreceptors?",
                                      "a": "H<sup>+</sup> concentration in the brain extracellular fluid (derived from arterial CO<sub>2</sub>)."
                            },
                            {
                                      "q": "Primary stimulus for peripheral chemoreceptors (Carotid/Aortic bodies)?",
                                      "a": "Decreased PaO<sub>2</sub> (< 60 mmHg).\n\nXVII. Clinical Syndromes & Emergencies"
                            },
                            {
                                      "q": "Definition of Sleep Apnea-Hypopnea Syndrome?",
                                      "a": "Repeated episodes of obstructive or central airflow cessation during sleep."
                            },
                            {
                                      "q": "Common complication of untreated <b>Obstructive Sleep Apnea</b>?",
                                      "a": "<b>Pulmonary hypertension</b> and Cor Pulmonale."
                            },
                            {
                                      "q": "Clinical triad of Fat Embolism Syndrome?",
                                      "a": "Hypoxemia, neurologic abnormalities, and petechial rash."
                            },
                            {
                                      "q": "Common trigger for Fat Embolism?",
                                      "a": "Fracture of long bones (e.g., femur)."
                            },
                            {
                                      "q": "Definition of Scimitar Syndrome?",
                                      "a": "Anomalous pulmonary venous return from the right lung to the IVC."
                            },
                            {
                                      "q": "Classic presentation of Loffler Syndrome?",
                                      "a": "Transient pulmonary opacities and eosinophilia, often due to parasitic migration."
                            },
                            {
                                      "q": "Primary treatment for Anaphylaxis causing airway obstruction?",
                                      "a": "Intramuscular Epinephrine."
                            },
                            {
                                      "q": "Definition of <b>Kartagener Syndrome</b>?",
                                      "a": "Triad of Situs inversus, chronic sinusitis, and <b>bronchiectasis</b>."
                            },
                            {
                                      "q": "Underlying defect in <b>Kartagener Syndrome</b>?",
                                      "a": "Dynein arm defect in cilia.\n\nXVIII. Detailed Pharmacology (High-Yield Additions)"
                            },
                            {
                                      "q": "Mechanism of action of Bosentan?",
                                      "a": "Endothelin-1 receptor antagonist (used for Pulmonary HTN)."
                            },
                            {
                                      "q": "Mechanism of action of Sildenafil in pulmonary context?",
                                      "a": "PDE-5 inhibitor; increases cGMP to cause vasodilation."
                            },
                            {
                                      "q": "Mechanism of action of Epoprostenol?",
                                      "a": "Prostacyclin (PGI<sub>2</sub>) analog with direct vasodilatory effects."
                            },
                            {
                                      "q": "Drug used to treat respiratory depression in opioid overdose?",
                                      "a": "Naloxone (Mu-opioid receptor antagonist)."
                            },
                            {
                                      "q": "Major side effect of Bleomycin?",
                                      "a": "Pulmonary fibrosis."
                            },
                            {
                                      "q": "Major side effect of Amiodarone regarding the lungs?",
                                      "a": "Chronic interstitial pneumonitis (Pulmonary fibrosis)."
                            },
                            {
                                      "q": "Mechanism of action of Dextromethorphan?",
                                      "a": "Antitussive; NMDA receptor antagonist."
                            },
                            {
                                      "q": "First-line treatment for <i>Pneumocystis jirovecii</i> <b>pneumonia</b>?",
                                      "a": "Trimethoprim-sulfamethoxazole (TMP-SMX).\n\nXIX. Physical Exam & Diagnostics"
                            },
                            {
                                      "q": "Sound heard on auscultation in Pleuritis?",
                                      "a": "Pleural friction rub."
                            },
                            {
                                      "q": "Definition of Bronchophony?",
                                      "a": "Patient's voice remains loud and distinct over areas of consolidation."
                            },
                            {
                                      "q": "Sign of a large Pleural Effusion on physical exam?",
                                      "a": "Tracheal deviation away from the affected side."
                            },
                            {
                                      "q": "Sign of massive Atelectasis on physical exam?",
                                      "a": "Tracheal deviation toward the affected side."
                            },
                            {
                                      "q": "Meaning of \"Percussion Dullness\" at the lung base?",
                                      "a": "Presence of fluid (effusion) or solid (consolidation/tumor)."
                            },
                            {
                                      "q": "Meaning of \"Hyperresonance\" on percussion?",
                                      "a": "Excess air in the pleural space (<b>pneumothorax</b>) or lungs (<b>emphysema</b>)."
                            },
                            {
                                      "q": "Primary clearance mechanism for particles < 2 micrometers in the alveoli?",
                                      "a": "Alveolar macrophages (mucociliary escalator only goes to terminal bronchioles)."
                            },
                            {
                                      "q": "Protein deficiency in <b>Kartagener syndrome</b>?",
                                      "a": "Dynein arms (structural component of microtubule doublets)."
                            },
                            {
                                      "q": "Major chemotactic factor for neutrophils in the lung?",
                                      "a": "Interleukin-8 (IL-8)."
                            },
                            {
                                      "q": "Cell type that proliferates to repair alveolar epithelium after Type I pneumocyte injury?",
                                      "a": "<b>Type II pneumocytes</b>."
                            },
                            {
                                      "q": "Primary antioxidant enzyme in the lung?",
                                      "a": "Superoxide dismutase.\n\nXXI. Rare Pathologies & Specialized Syndromes"
                            },
                            {
                                      "q": "Definition of Pulmonary Langerhans Cell Histiocytosis?",
                                      "a": "Smoking-related interstitial lung disease characterized by \"Birbeck granules\" (tennis racket shape) on EM."
                            },
                            {
                                      "q": "Classic radiographic finding in Pulmonary Alveolar Proteinosis?",
                                      "a": "\"Crazy paving\" pattern (ground-glass opacities with thickened interlobular septa)."
                            },
                            {
                                      "q": "Treatment for Pulmonary Alveolar Proteinosis?",
                                      "a": "Whole-lung lavage."
                            },
                            {
                                      "q": "Definition of Lymphangioleiomyomatosis (LAM)?",
                                      "a": "Cystic lung disease in women of childbearing age associated with tuberous sclerosis."
                            },
                            {
                                      "q": "Marker used to identify LAM cells?",
                                      "a": "HMB-45 (a melanoma marker)."
                            },
                            {
                                      "q": "Cause of \"Inhalation Anthrax\"?",
                                      "a": "<i>Bacillus anthracis</i> (presents with widened mediastinum on CXR)."
                            },
                            {
                                      "q": "Pathogenesis of Alpha-1 Antitrypsin (AAT) deficiency-related liver disease?",
                                      "a": "Misfolding of the AAT protein (PiZ allele) which accumulates in the ER of hepatocytes.\n\nXXII. Advanced Physiology & Gas Laws"
                            },
                            {
                                      "q": "Meaning of a \"Left Shift\" in the P50 of hemoglobin?",
                                      "a": "Hemoglobin has a higher affinity for O<sub>2</sub> (holds on tighter)."
                            },
                            {
                                      "q": "Boyle\u2019s Law application in the lungs?",
                                      "a": "Pressure and volume are inversely proportional; used to measure FRC via plethysmography."
                            },
                            {
                                      "q": "Definition of \"Closing Volume\"?",
                                      "a": "The volume at which the airways in the dependent (lower) parts of the lung begin to close."
                            },
                            {
                                      "q": "Effect of aging on Closing Volume?",
                                      "a": "Closing volume increases with age."
                            },
                            {
                                      "q": "Definition of Physiological Shunt (Q<sub>s</sub>/Q<sub>t</sub>)?",
                                      "a": "The fraction of the total cardiac output that traverses the systemic circulation without being oxygenated.\n\nXXIII. High-Yield Microbiology & Fungal Infections"
                            },
                            {
                                      "q": "Fungal <b>pneumonia</b> common in the Southwestern US (California/Arizona)?",
                                      "a": "<i><i>Coccidioides</i> immitis</i>."
                            },
                            {
                                      "q": "Microscopic hallmark of <i>Coccidioides</i> in tissue?",
                                      "a": "Spherules filled with endospores."
                            },
                            {
                                      "q": "Fungal <b>pneumonia</b> associated with bird or bat droppings (Ohio/Mississippi River Valleys)?",
                                      "a": "<i><i>Histoplasma</i> capsulatum</i>."
                            },
                            {
                                      "q": "Microscopic hallmark of <i>Histoplasma</i>?",
                                      "a": "Small yeast cells residing within macrophages."
                            },
                            {
                                      "q": "Fungal <b>pneumonia</b> with \"broad-based budding\" yeast?",
                                      "a": "<i><i>Blastomyces</i> dermatitidis</i>."
                            },
                            {
                                      "q": "Opportunistic fungus causing a \"fungus ball\" (Aspergilloma) in pre-existing cavities?",
                                      "a": "<i><i>Aspergillus</i> fumigatus</i>."
                            },
                            {
                                      "q": "Condition characterized by hypersensitivity to <i>Aspergillus</i> in <b>asthma</b>/<b>CF</b> patients?",
                                      "a": "Allergic Bronchopulmonary Aspergillosis (ABPA).\n\nXXIV. Acid-Base & Ventilation-Perfusion"
                            },
                            {
                                      "q": "Formula for Alveolar Ventilation (V<sub>A</sub>)?",
                                      "a": "V<sub>A</sub> = (Tidal Volume - Dead Space) &times; Respiratory Rate."
                            },
                            {
                                      "q": "Effect of <b>Pulmonary Embolism</b> on Dead Space?",
                                      "a": "Increases physiological dead space (ventilation without perfusion)."
                            },
                            {
                                      "q": "Calculation of Anion Gap?",
                                      "a": "Na<sup>+</sup> - (Cl<sup>-</sup> + HCO<sub>3</sub><sup>-</sup>)."
                            },
                            {
                                      "q": "Normal Anion Gap value?",
                                      "a": "8 to 12 mEq/L."
                            },
                            {
                                      "q": "Winter\u2019s Formula for respiratory compensation in metabolic acidosis?",
                                      "a": "Expected PaCO<sub>2</sub> = 1.5[HCO<sub>3</sub><sup>-</sup>] + 8 &plusmn; 2.\n\nXXV. Pharmacology: Extra High-Yield"
                            },
                            {
                                      "q": "Mechanism of action of Varenicline?",
                                      "a": "Nicotinic ACh receptor partial agonist (used for smoking cessation)."
                            },
                            {
                                      "q": "Mechanism of action of Benralizumab?",
                                      "a": "IL-5 receptor alpha antagonist (depletes eosinophils)."
                            },
                            {
                                      "q": "Drug used to prevent Respiratory Syncytial Virus (RSV) in high-risk infants?",
                                      "a": "Palivizumab (monoclonal antibody against RSV F protein)."
                            },
                            {
                                      "q": "Effect of Beta-blockers (non-selective) on asthmatic patients?",
                                      "a": "Bronchoconstriction (blocks &beta;<sub>2</sub> receptors).\n\nXXVI. Clinical Pearls & Physical Diagnosis"
                            },
                            {
                                      "q": "Definition of \"<b>Kussmaul breathing</b>\"?",
                                      "a": "Deep, labored breathing pattern often associated with severe metabolic acidosis (DKA)."
                            },
                            {
                                      "q": "Definition of \"<b>Cheyne-Stokes respiration</b>\"?",
                                      "a": "Cycles of crescendo-decrescendo breathing followed by apnea (seen in heart failure or stroke)."
                            },
                            {
                                      "q": "Significance of a pleural fluid pH < 7.2?",
                                      "a": "Suggests an empyema or complicated parapneumonic effusion (requires drainage)."
                            },
                            {
                                      "q": "Significance of \"pulsus paradoxus\" in status asthmaticus?",
                                      "a": "Drop in systolic BP > 10 mmHg during inspiration; indicates severe airway obstruction."
                            },
                            {
                                      "q": "Most common cause of superior vena cava (SVC) syndrome?",
                                      "a": "Lung cancer (especially <b>Small Cell Carcinoma</b>)."
                            },
                            {
                                      "q": "Safe zone for needle thoracostomy (<b>tension pneumothorax</b>)?",
                                      "a": "Second intercostal space at the midclavicular line."
                            },
                            {
                                      "q": "Level for performing a thoracentesis (needle decompression of effusion)?",
                                      "a": "Between ribs 6 and 8 (midaxillary line) or 8 and 10 (paravertebral line)."
                            },
                            {
                                      "q": "Structure most at risk during a thoracentesis if the needle is inserted below the rib?",
                                      "a": "The intercostal nerve, artery, and vein (VAN bundle)."
                            },
                            {
                                      "q": "Proper placement of a chest tube (tube thoracostomy)?",
                                      "a": "4th or 5th intercostal space at the anterior axillary line."
                            },
                            {
                                      "q": "Level at which the trachea bifurcates (Carina)?",
                                      "a": "T4 vertebral level (sternal angle).\n\nXXVIII. Advanced Clinical Pathophysiology"
                            },
                            {
                                      "q": "Definition of the \"Shunt Equation\"?",
                                      "a": "Qs/Qt = (CcO<sub>2</sub> - CaO<sub>2</sub>) / (CcO<sub>2</sub> - CvO<sub>2</sub>)."
                            },
                            {
                                      "q": "Primary cause of hypoxemia in a patient with a massive <b>pulmonary embolism</b>?",
                                      "a": "V/Q mismatch (increased dead space)."
                            },
                            {
                                      "q": "The \"<b>Haldane Effect</b>\" describes CO<sub>2</sub> release in which organ?",
                                      "a": "The lungs (binding of O<sub>2</sub> to Hb promotes CO<sub>2</sub> dissociation)."
                            },
                            {
                                      "q": "Definition of \"Orthodeoxia\"?",
                                      "a": "Hypoxemia that worsens when moving from a supine to an upright position (seen in Hepatopulmonary Syndrome)."
                            },
                            {
                                      "q": "Definition of \"Platypnea\"?",
                                      "a": "Dyspnea that worsens when upright.\n\nXXIX. Specific Histopathology & Cytology"
                            },
                            {
                                      "q": "Cytological finding in Bronchoalveolar Lavage (BAL) of a patient with <b>Asbestosis</b>?",
                                      "a": "Ferruginous bodies (asbestos fibers coated with iron)."
                            },
                            {
                                      "q": "Histological finding in <b>Silicosis</b>?",
                                      "a": "Whorled collagenous nodules with peripheral \"eggshell\" calcification."
                            },
                            {
                                      "q": "Appearance of Coal Worker\u2019s Pneumoconiosis (CWP) on histology?",
                                      "a": "Carbon-laden macrophages (coal macules) around bronchioles."
                            },
                            {
                                      "q": "Most common location for \"Caplan Syndrome\" nodules?",
                                      "a": "Peripheral lung (seen in patients with both Rheumatoid Arthritis and Pneumoconiosis).\n\nXXX. Pulmonary Pharmacology: Toxicity & Interactions"
                            },
                            {
                                      "q": "Drug-induced interstitial lung disease: Mechanism of Amiodarone?",
                                      "a": "Phospholipidosis (accumulation of foamy macrophages in the alveoli)."
                            },
                            {
                                      "q": "Respiratory side effect of Methotrexate?",
                                      "a": "<b>Hypersensitivity pneumonitis</b> (granulomatous reaction)."
                            },
                            {
                                      "q": "Mechanism of Nitrofurantoin-induced lung injury?",
                                      "a": "Direct oxidative damage to lung parenchyma (can be acute or chronic)."
                            },
                            {
                                      "q": "Why is the use of 100% Oxygen avoided in patients with Paraquat poisoning?",
                                      "a": "Oxygen exacerbates the oxidative lung injury caused by Paraquat.\n\nXXXI. High-Yield Pediatric Respiratory Facts"
                            },
                            {
                                      "q": "Most common cause of bronchiolitis in infants?",
                                      "a": "Respiratory Syncytial Virus (RSV)."
                            },
                            {
                                      "q": "Common complication of Neonatal Respiratory Distress Syndrome (NRDS) treatment?",
                                      "a": "Bronchopulmonary Dysplasia (due to oxygen toxicity and barotrauma)."
                            },
                            {
                                      "q": "Most common cause of Stridor in a neonate?",
                                      "a": "Laryngomalacia (collapsible supraglottic structures)."
                            },
                            {
                                      "q": "Character of the cough in <i><i>Bordetella</i> pertussis</i>?",
                                      "a": "Paroxysmal cough followed by an inspiratory \"whoop.\"\n\nXXXII. Final \"Board-Style\" Rapid Fire"
                            },
                            {
                                      "q": "Most likely diagnosis: Smoker, hypercalcemia, central lung mass?",
                                      "a": "<b>Squamous cell carcinoma</b>."
                            },
                            {
                                      "q": "Most likely diagnosis: Non-smoker, female, peripheral lung mass?",
                                      "a": "<b>Adenocarcinoma</b>."
                            },
                            {
                                      "q": "Most likely diagnosis: Weight loss, night sweats, apical cavitary lesion?",
                                      "a": "Reactivation (Secondary) <b>Tuberculosis</b>."
                            },
                            {
                                      "q": "Most likely diagnosis: Sudden pleuritic chest pain, tall thin male, hyperresonance?",
                                      "a": "Spontaneous <b>Pneumothorax</b>."
                            },
                            {
                                      "q": "Most likely diagnosis: 24 hours post-femur fracture, confusion, petechiae?",
                                      "a": "Fat Embolism Syndrome."
                            }
                  ]
        },
        {
                  "topic": "Reproductive Pathology",
