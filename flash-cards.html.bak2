                        "q": "What is the most common histological type of esophageal cancer worldwide vs. in the United States?",
                        "a": "Squamous cell carcinoma worldwide; Adenocarcinoma in the United States."
            },
            {
                        "q": "What chronic gastrointestinal condition is the primary predisposing driver for esophageal adenocarcinoma?",
                        "a": "Chronic gastroesophageal reflux disease (GERD) leading to Barrett's esophagus (intestinal metaplasia)."
            },
            {
                        "q": "What standard surgical procedure is performed for a resectable mid-to-lower esophageal cancer?",
                        "a": "Esophagectomy (e.g., Ivor Lewis esophagectomy involving a laparotomy and right thoracotomy)."
            },
