                            {
                                      "q": "Treatment for Methanol or Ethylene Glycol poisoning?",
                                      "a": "<b>Fomepizole</b>."
                            },
                            {
                                      "q": "Mechanism of action of <b>Heparin</b>-Induced Thrombocytopenia (<b>HIT</b>)?",
                                      "a": "IgG antibodies against <b>Heparin</b>-Platelet Factor 4 (PF4) complex."
                            },
                            {
                                      "q": "Treatment for <b>HIT</b>?",
                                      "a": "Stop <b>Heparin</b>; start Direct Thrombin Inhibitor (e.g., Argatroban)."
                            },
                            {
                                      "q": "Mechanism of action of <b>Abciximab</b>?",
                                      "a": "Monoclonal antibody against GPIIb/IIIa receptors."
                            },
                            {
                                      "q": "Reversal agent for <b>Dabigatran</b>?",
                                      "a": "Idarucizumab."
                            },
                            {
                                      "q": "Mechanism of action of Thionamides (<b>PTU</b>/<b>Methimazole</b>)?",
                                      "a": "Inhibit thyroid peroxidase, blocking iodine organification and coupling."
                            },
                            {
                                      "q": "Primary side effect of <b>Flutamide</b>?",
                                      "a": "Gynecomastia and hepatotoxicity (Competitive androgen receptor antagonist)."
                            },
                            {
                                      "q": "Mechanism of action of <b>Finasteride</b>?",
                                      "a": "5-alpha-reductase inhibitor (decreases conversion of Testosterone to DHT)."
                            },
                            {
                                      "q": "Drug used to induce ovulation in patients with PCOS?",
                                      "a": "<b>Clomiphene</b> (SERM that inhibits negative feedback by estrogen on the hypothalamus)."
                            },
                            {
                                      "q": "Mechanism of action of <b>Anastrozole</b>?",
                                      "a": "Aromatase inhibitor (decreases peripheral conversion of androgens to estrogen)."
                            },
                            {
                                      "q": "Mechanism of action of <b>Mifepristone</b>?",
                                      "a": "Progesterone receptor antagonist used for medical abortion."
                            },
                            {
                                      "q": "Mechanism of action of <b>Tamsulosin</b>?",
                                      "a": "Alpha-1A/D selective antagonist (targets prostate smooth muscle, minimizes systemic hypotension).\n\nCNS Pharmacology (Part 2 - Anesthetics & Addiction)"
                            },
                            {
                                      "q": "Intravenous anesthetic associated with \"dissociative anesthesia\" and hallucinations?",
                                      "a": "<b>Ketamine</b> (NMDA receptor antagonist)."
                            },
                            {
                                      "q": "Intravenous anesthetic that is a potent GABA-A agonist and causes \"milk of amnesia\"?",
                                      "a": "<b>Propofol</b>."
                            },
                            {
                                      "q": "Mechanism of action of Local Anesthetics?",
                                      "a": "Blockade of voltage-gated sodium channels from the intracellular side."
                            },
                            {
                                      "q": "Effect of adding Epinephrine to a local anesthetic?",
                                      "a": "Vasoconstriction (decreases systemic absorption, reduces bleeding, increases duration of action)."
                            },
                            {
                                      "q": "Drug used to treat opioid-induced constipation that does not cross the BBB?",
                                      "a": "Methylnaltrexone."
                            },
                            {
                                      "q": "Mechanism of action of Modafinil?",
                                      "a": "Promotes wakefulness by increasing synaptic <b>Dopamine</b> (used for Narcolepsy)."
                            },
                            {
                                      "q": "Treatment for Restless Leg Syndrome?",
                                      "a": "<b>Dopamine</b> agonists (e.g., Pramipexole or Ropinirole).\n\nImmunology & Autoimmunity"
                            },
                            {
                                      "q": "Mechanism of action of <b>Mycophenolate Mofetil</b>?",
                                      "a": "Reversibly inhibits IMP dehydrogenase, preventing purine synthesis in B and T cells."
                            },
                            {
                                      "q": "Targeted protein of <b>Adalimumab</b> and <b>Etanercept</b>?",
                                      "a": "TNF-alpha."
                            },
                            {
                                      "q": "Mechanism of action of <b>Thalidomide</b>?",
                                      "a": "Inhibits TNF-alpha and has anti-angiogenic properties (major teratogen: Phocomelia)."
                            },
                            {
                                      "q": "Mechanism of action of <b>Leflunomide</b>?",
                                      "a": "Inhibits dihydroorotate dehydrogenase, preventing pyrimidine synthesis.\n\nAntimicrobials (Part 2 - Specialized Coverage)"
                            },
                            {
                                      "q": "Mechanism of action of Polymyxins (<b>Colistin</b>)?",
                                      "a": "Act as detergents to disrupt the bacterial cell membrane (Gram-negative coverage)."
                            },
                            {
                                      "q": "Mechanism of action of <b>Daptomycin</b>?",
                                      "a": "Lipopeptide that disrupts the cell membrane of Gram-positive cocci via depolarization."
                            },
                            {
                                      "q": "Common side effect of <b>Daptomycin</b>?",
                                      "a": "Myopathy and elevated Creatine Kinase (CK)."
                            },
                            {
                                      "q": "Drug of choice for prophylaxis against Mycobacterium avium complex (MAC) in AIDS?",
                                      "a": "<b>Azithromycin</b>."
                            },
                            {
                                      "q": "Mechanism of action of <b>Griseofulvin</b>?",
                                      "a": "Interferes with microtubule function to inhibit mitosis in dermatophytes."
                            },
                            {
                                      "q": "Mechanism of action of <b>Permethrin</b>?",
                                      "a": "Inhibits sodium channel deactivation, leading to paralysis in mites/lice."
                            },
                            {
                                      "q": "Mechanism of action of <b>Albendazole</b>?",
                                      "a": "Inhibits microtubule synthesis in helminths.\n\nAutacoids & Respiratory (Part 2)"
                            },
                            {
                                      "q": "Mechanism of action of <b>Guaifenesin</b>?",
                                      "a": "Expectorant that thins respiratory secretions (does not suppress cough)."
                            },
                            {
                                      "q": "Mechanism of action of <b>Dextromethorphan</b>?",
                                      "a": "NMDA receptor antagonist that acts on the medullary cough center to suppress cough."
                            },
                            {
                                      "q": "Mechanism of action of <b>Bosentan</b>?",
                                      "a": "Endothelin-1 receptor antagonist used for Pulmonary Arterial Hypertension."
                            },
                            {
                                      "q": "Common side effect of <b>Bosentan</b>?",
                                      "a": "Hepatotoxicity."
                            },
                            {
                                      "q": "Mechanism of action of <b>Omalizumab</b>?",
                                      "a": "Monoclonal antibody that binds unbound IgE (used in refractory asthma).\n\nToxicology & Antidotes (Comprehensive)"
                            },
                            {
                                      "q": "Antidote for Iron toxicity?",
                                      "a": "Deferoxamine."
                            },
                            {
                                      "q": "Antidote for Lead poisoning?",
                                      "a": "<b>EDTA</b>, <b>Dimercaprol</b>, <b>Succimer</b> (in children)."
                            },
                            {
                                      "q": "Antidote for Copper toxicity (Wilson\u2019s Disease)?",
                                      "a": "<b>Penicillamine</b> or Trientine."
                            },
                            {
                                      "q": "Antidote for Cyanide poisoning?",
                                      "a": "Nitrites (to form methemoglobin) and Hydroxocobalamin (Vitamin B12a)."
                            },
                            {
                                      "q": "Antidote for Ethylene Glycol or Methanol?",
                                      "a": "<b>Fomepizole</b> (inhibits Alcohol Dehydrogenase)."
                            },
                            {
                                      "q": "Mechanism of action of <b>Sugammadex</b>?",
                                      "a": "Encapsulates and inactivates Rocuronium/Vecuronium (Neuromuscular blockade reversal)."
                            },
                            {
                                      "q": "Antidote for Beta-blocker overdose?",
                                      "a": "<b>Glucagon</b> (increases cAMP in cardiac myocytes via non-adrenergic pathway)."
                            },
                            {
                                      "q": "Antidote for Salicylate (<b>Aspirin</b>) overdose?",
                                      "a": "Sodium Bicarbonate (alkalinizes urine to trap the drug)."
                            },
                            {
                                      "q": "Drug class that causes \"Fanconi Syndrome\" if taken after expiration?",
                                      "a": "Tetracyclines.\n\nHigh-Yield Miscellany (The \"Odds and Ends\")"
                            },
                            {
                                      "q": "Mechanism of action of Orlistat?",
                                      "a": "Inhibits gastric and pancreatic lipases to decrease fat absorption."
                            },
                            {
                                      "q": "Mechanism of action of Ursodeoxycholic acid (Ursodiol)?",
                                      "a": "Decreases cholesterol secretion into bile; used to dissolve gallstones."
                            },
                            {
                                      "q": "Mechanism of action of Cinacalcet?",
                                      "a": "Sensitizes calcium-sensing receptors (CaSR) in the parathyroid gland to decrease PTH."
                            },
                            {
                                      "q": "Drug used to treat SIADH that is a Vasopressin antagonist?",
                                      "a": "Conivaptan or Tolvaptan."
                            },
                            {
                                      "q": "Mechanism of action of Sevelamer?",
                                      "a": "Phosphate binder used in Chronic Kidney Disease to prevent hyperphosphatemia."
                            },
                            {
                                      "q": "Mechanism of action of Riluzole?",
                                      "a": "Decreases glutamate excitotoxicity; used to extend survival in ALS."
                            },
                            {
                                      "q": "Mechanism of action of <b>Varenicline</b>?",
                                      "a": "Partial agonist at \u03b14\u03b22 nicotinic <b>acetylcholine</b> receptors."
                            },
                            {
                                      "q": "Mechanism of action of Sacubitril?",
                                      "a": "Neprilysin inhibitor (prevents degradation of Natriuretic Peptides)."
                            },
                            {
                                      "q": "Standard dual therapy for Heart Failure with Reduced Ejection Fraction (HFrEF)?",
                                      "a": "Sacubitril/Valsartan (ARNI)."
                            },
                            {
                                      "q": "Definition of <b>Zero-order</b> elimination?",
                                      "a": "Rate of elimination is constant regardless of plasma concentration (e.g., Ethanol, <b>Aspirin</b> at high doses)."
                            },
                            {
                                      "q": "Definition of <b>First-order</b> elimination?",
                                      "a": "Constant fraction of drug is eliminated per unit time (rate depends on concentration)."
                            },
                            {
                                      "q": "Formula for Loading Dose?",
                                      "a": "LD = (C<sub>p</sub> \\times V<sub>d</sub>) / F."
                            },
                            {
                                      "q": "Formula for Maintenance Dose?",
                                      "a": "MD = (C<sub>p</sub> \\times CL \\times &tau;) / F."
                            },
                            {
                                      "q": "Number of half-lives required to reach steady state?",
                                      "a": "Approximately 4 to 5."
                            },
                            {
                                      "q": "Effect of a competitive antagonist on V<sub>max</sub> and K<sub>m</sub>?",
                                      "a": "V<sub>max</sub> remains unchanged; K<sub>m</sub> increases."
                            },
                            {
                                      "q": "Effect of a non-competitive antagonist on V<sub>max</sub> and K<sub>m</sub>?",
                                      "a": "V<sub>max</sub> decreases; K<sub>m</sub> remains unchanged."
                            },
                            {
                                      "q": "Primary Phase 1 metabolism reaction?",
                                      "a": "Oxidation, reduction, or hydrolysis (usually via Cytochrome P450)."
                            },
                            {
                                      "q": "Primary Phase 2 metabolism reaction?",
                                      "a": "Conjugation (Glucuronidation, Acetylation, Sulfation) to make drugs polar for excretion.\n\nAdvanced Oncology & Immunotherapy"
                            },
                            {
                                      "q": "Mechanism of action of <b>Imatinib</b> (Gleevec)?",
                                      "a": "Tyrosine kinase inhibitor of BCR-ABL (Philadelphia chromosome)."
                            },
                            {
                                      "q": "Mechanism of action of <b>Trastuzumab</b> (Herceptin)?",
                                      "a": "Monoclonal antibody against HER2/neu (ERBB2) receptor."
                            },
                            {
                                      "q": "Mechanism of action of <b>Rituximab</b>?",
                                      "a": "Monoclonal antibody against CD20 found on B-cells."
                            },
                            {
                                      "q": "Mechanism of action of <b>Tamoxifen</b>?",
                                      "a": "Selective Estrogen Receptor Modulator (SERM); antagonist in breast, agonist in bone/uterus."
                            },
                            {
                                      "q": "Common side effect of <b>Tamoxifen</b>?",
                                      "a": "Increased risk of endometrial cancer and thromboembolism."
                            },
                            {
                                      "q": "Mechanism of action of <b>5-Fluorouracil</b> (5-FU)?",
                                      "a": "Pyrimidine analog that covalently inhibits Thymidylate Synthase."
                            },
                            {
                                      "q": "Mechanism of action of <b>Etoposide</b>?",
                                      "a": "Inhibits Topoisomerase II, causing DNA strand breaks."
                            },
                            {
                                      "q": "Mechanism of action of Irinotecan/Topotecan?",
                                      "a": "Inhibits Topoisomerase I."
                            },
                            {
                                      "q": "Mechanism of action of <b>Pembrolizumab</b>/<b>Nivolumab</b>?",
                                      "a": "PD-1 inhibitors that \"release the brakes\" on T-cells to attack tumors.\n\nAdvanced Infectious Disease (Rare/High-Yield)"
                            },
                            {
                                      "q": "Treatment for prophylaxis against Pneumocystis jirovecii (PCP) in HIV?",
                                      "a": "<b>TMP-SMX</b> (Bactrim)."
                            },
                            {
                                      "q": "Mechanism of action of <b>Linezolid</b>?",
                                      "a": "Binds 50S subunit to prevent formation of the initiation complex."
                            },
                            {
                                      "q": "Unique side effect of <b>Linezolid</b> related to antidepressants?",
                                      "a": "Serotonin Syndrome (due to weak MAO inhibition)."
                            },
                            {
                                      "q": "Mechanism of action of <b>Nitrofurantoin</b>?",
                                      "a": "Bactericidal; damages bacterial DNA (used primarily for uncomplicated UTIs)."
                            },
                            {
                                      "q": "Drug of choice for treating Neurosyphilis?",
                                      "a": "Penicillin G (IV).\n\nClinical Interactions & Contraindications"
                            },
                            {
                                      "q": "Interaction between St. John\u2019s Wort and <b>Cyclosporine</b>?",
                                      "a": "St. John\u2019s Wort induces CYP3A4, decreasing <b>Cyclosporine</b> levels and causing transplant rejection."
                            },
                            {
                                      "q": "Interaction between Grapefruit juice and <b>Statins</b>?",
                                      "a": "Grapefruit juice inhibits CYP3A4, increasing Statin levels and risk of myopathy."
                            },
                            {
                                      "q": "Why are Tetracyclines contraindicated in children and pregnancy?",
                                      "a": "Chelation of calcium causes permanent tooth discoloration and bone growth inhibition."
                            },
                            {
                                      "q": "\"Sulfa drugs\" list (common cross-reactivity)?",
                                      "a": "<b>Sulfonamides</b>, Thiazides, <b>Loop diuretics</b>, Sulfonylureas, <b>Acetazolamide</b>, <b>Celecoxib</b>."
                            },
                            {
                                      "q": "Drug-induced Lupus is most commonly associated with which drugs?",
                                      "a": "<b>Hydralazine</b>, <b>Isoniazid</b>, Procainamide, <b>Phenytoin</b> (SHIPP)."
                            },
                            {
                                      "q": "Characteristic finding of <b>Digoxin</b> toxicity on ECG?",
                                      "a": "\"Scooped\" ST segment and various arrhythmias (most common is PVCs).\n\nFinal High-Yield Potpourri"
                            },
                            {
                                      "q": "Mechanism of action of Ranolazine?",
                                      "a": "Inhibits the late inward sodium current in cardiac myocytes (used for refractory angina)."
                            },
                            {
                                      "q": "Mechanism of action of <b>Milrinone</b>?",
                                      "a": "PDE-3 inhibitor; increases cAMP causing inotropy and vasodilation."
                            },
                            {
                                      "q": "Mechanism of action of <b>Ivabradine</b>?",
                                      "a": "Selective inhibition of \"funny\" sodium channels (I<sub>f</sub>) in the SA node."
                            },
                            {
                                      "q": "Mechanism of action of Aprepitant?",
                                      "a": "Substance P antagonist (NK1 receptor blocker) used for chemotherapy-induced vomiting."
                            },
                            {
                                      "q": "Drug used to prevent uric acid stones by alkalinizing urine?",
                                      "a": "Potassium Citrate."
                            },
                            {
                                      "q": "Mechanism of action of Denosumab?",
                                      "a": "Monoclonal antibody against RANKL (inhibits osteoclast maturation)."
                            },
                            {
                                      "q": "Mechanism of action of Mupirocin?",
                                      "a": "Inhibits bacterial isoleucyl-tRNA synthetase (topical for Impetigo/<b>MRSA</b> colonization)."
                            },
                            {
                                      "q": "Drug of choice for Wilson\u2019s Disease?",
                                      "a": "<b>Penicillamine</b>."
                            },
                            {
                                      "q": "Mechanism of action of <b>Octreotide</b>?",
                                      "a": "Somatostatin analog used for acromegaly, carcinoid syndrome, and variceal bleeding."
                            },
                            {
                                      "q": "Primary side effect of <b>Amiodarone</b> relating to the skin?",
                                      "a": "Blue-gray skin discoloration (photodermatitis)."
                            },
                            {
                                      "q": "Mechanism of action of Dipyridamole?",
                                      "a": "Inhibits phosphodiesterase and <b>adenosine</b> uptake to inhibit platelet aggregation."
                            },
                            {
                                      "q": "Mechanism of action of <b>Isotretinoin</b> in acne treatment?",
                                      "a": "Vitamin A derivative that reduces sebum production and induces apoptosis of sebaceous glands."
                            },
                            {
                                      "q": "Side effect of Topical Steroids used chronically on the skin?",
                                      "a": "Skin atrophy, striae, and telangiectasia."
                            },
                            {
                                      "q": "Mechanism of <b>Latanoprost</b> in Glaucoma?",
                                      "a": "Prostaglandin F2\u03b1 analog that increases uveoscleral outflow."
                            },
                            {
                                      "q": "First-line medication for Acute Angle-Closure Glaucoma to rapidly lower IOP?",
                                      "a": "<b>Acetazolamide</b> (IV) or Pilocarpine."
                            },
                            {
                                      "q": "Side effect of Alpha-agonists (e.g., Brimonidine) in the eye?",
                                      "a": "Blurry vision, ocular hyperemia, and foreign body sensation."
                            },
                            {
                                      "q": "Mechanism of action of <b>Timolol</b> in Glaucoma?",
                                      "a": "Non-selective beta-blocker that decreases aqueous humor production.\n\nReproductive & Obstetric Pharmacology"
                            },
                            {
                                      "q": "Drug used to prevent cerebral palsy and seizures in Preeclampsia?",
                                      "a": "Magnesium Sulfate."
                            },
                            {
                                      "q": "Signs of Magnesium Sulfate toxicity?",
                                      "a": "Loss of deep tendon reflexes, respiratory depression, and cardiac arrest."
                            },
                            {
                                      "q": "Antidote for Magnesium Sulfate toxicity?",
                                      "a": "Calcium Gluconate."
                            },
                            {
                                      "q": "Mechanism of action of <b>Oxytocin</b>?",
                                      "a": "Stimulates Gq-coupled receptors to increase uterine contractions and milk let-down."
                            },
                            {
                                      "q": "Mechanism of Terbutaline/Ritodrine in obstetrics?",
                                      "a": "Beta-2 agonists used as tocolytics to relax the uterus and delay preterm labor.\n\nClinical Biochemical Pharmacology"
                            },
                            {
                                      "q": "Mechanism of action of <b>Allopurinol</b> vs. Probenecid?",
                                      "a": "<b>Allopurinol</b> inhibits xanthine oxidase; Probenecid inhibits renal reabsorption of uric acid."
                            },
                            {
                                      "q": "Enzyme inhibited by <b>Mycophenolate Mofetil</b>?",
                                      "a": "Inosine Monophosphate Dehydrogenase (IMPDH)."
                            },
                            {
                                      "q": "Mechanism of action of Azathioprine?",
                                      "a": "Pro-drug of 6-Mercaptopurine; inhibits de novo purine synthesis."
                            },
                            {
                                      "q": "Key interaction between <b>Allopurinol</b> and Azathioprine?",
                                      "a": "<b>Allopurinol</b> inhibits Xanthine Oxidase, leading to toxic levels of 6-MP/Azathioprine."
                            },
                            {
                                      "q": "Mechanism of Pegloticase?",
                                      "a": "Recombinant uricase that converts uric acid to allantoin (more soluble).\n\nSpecialized Infectious Disease & Vaccines"
                            },
                            {
                                      "q": "Mechanism of action of Sofosbuvir in Hepatitis C?",
                                      "a": "Inhibits HCV RNA-dependent RNA polymerase (NS5B)."
                            },
                            {
                                      "q": "Mechanism of action of Ribavirin?",
                                      "a": "Inhibits IMP dehydrogenase and viral RNA polymerase."
                            },
                            {
                                      "q": "Major side effect of Ribavirin?",
                                      "a": "Dose-dependent hemolytic anemia and severe teratogenicity."
                            },
                            {
                                      "q": "Treatment for prophylaxis in a patient with a needle-stick injury from an HIV+ source?",
                                      "a": "Post-Exposure Prophylaxis (PEP) with Tenofovir, Emtricitabine, and Raltegravir/Dolutegravir.\n\nMusculoskeletal & Connective Tissue"
                            },
                            {
                                      "q": "Mechanism of action of Cyclobenzaprine?",
                                      "a": "Centrally acting skeletal muscle relaxant (structurally related to TCAs)."
                            },
                            {
                                      "q": "Mechanism of action of <b>Leflunomide</b> in RA?",
                                      "a": "Inhibits dihydroorotate dehydrogenase, arresting T-cell proliferation."
                            },
                            {
                                      "q": "Mechanism of action of Abatacept?",
                                      "a": "Binds to CD80/86 on APCs to prevent T-cell costimulation via CD28.\n\nToxicology & Critical Care"
                            },
                            {
                                      "q": "Treatment for Salicylate-induced hyperventilation/respiratory alkalosis?",
                                      "a": "Supportive care (alkalinization of urine for the metabolic acidosis component)."
                            },
                            {
                                      "q": "Clinical presentation of \"<b>Atropine</b> Fever\"?",
                                      "a": "Hyperpyrexia due to suppression of sweat gland activity (anhidrosis)."
                            },
                            {
                                      "q": "Difference between Succinylcholine and Rocuronium mechanism?",
                                      "a": "Succinylcholine is a depolarizing blocker (ACh agonist); Rocuronium is a non-depolarizing blocker (competitive antagonist)."
                            },
                            {
                                      "q": "Phase of blockade for Succinylcholine that can be reversed by AChE inhibitors?",
                                      "a": "Phase II (prolonged exposure/desensitization); Phase I is worsened by AChE inhibitors."
                            },
                            {
                                      "q": "Mechanism of action of Theophylline?",
                                      "a": "Inhibits Phosphodiesterase (PDE), increasing cAMP, and antagonizes <b>Adenosine</b> receptors."
                            },
                            {
                                      "q": "Why is Theophylline rarely used now?",
                                      "a": "Narrow therapeutic index and many drug interactions (CYP450 metabolism).\n\nFinal Scrutiny Cards"
                            },
                            {
                                      "q": "Mechanism of action of Prucalopride?",
                                      "a": "5-HT4 receptor agonist used for chronic idiopathic constipation."
                            },
                            {
                                      "q": "Mechanism of action of Rifaximin in Hepatic Encephalopathy?",
                                      "a": "Non-absorbable antibiotic that kills ammonia-producing gut bacteria."
                            },
                            {
                                      "q": "Mechanism of action of Lactulose in Hepatic Encephalopathy?",
                                      "a": "Converted by gut bacteria to lactic acid, trapping NH<sub>3</sub> as NH<sub>4</sub><sup>+</sup> in the lumen."
                            },
                            {
                                      "q": "Mechanism of action of Fenoldopam?",
                                      "a": "<b>Dopamine</b> D1 receptor agonist; used in hypertensive emergencies to dilate renal/coronary vessels."
                            },
                            {
                                      "q": "Mechanism of action of Midodrine?",
                                      "a": "Alpha-1 agonist used to treat symptomatic orthostatic hypotension."
                            },
                            {
                                      "q": "Genetic deficiency that increases the risk of hemolytic anemia with Primaquine or <b>Sulfonamides</b>?",
                                      "a": "Glucose-6-Phosphate Dehydrogenase (G6PD) deficiency."
                            },
                            {
                                      "q": "Genetic variation that necessitates a lower dose of <b>Warfarin</b>?",
                                      "a": "Polymorphisms in CYP2C9 or VKORC1."
                            },
                            {
                                      "q": "Effect of being a \"Slow Acetylator\" on <b>Isoniazid</b> (INH) therapy?",
                                      "a": "Increased risk of peripheral neuropathy and drug-induced lupus."
                            },
                            {
                                      "q": "HLA allele associated with a high risk of Stevens-Johnson Syndrome (<b>SJS</b>) when taking Abacavir?",
                                      "a": "HLA-B*5701."
                            },
                            {
                                      "q": "HLA allele associated with <b>SJS</b> in Asian populations taking Carbamazepine?",
                                      "a": "HLA-B*1502.\n\nAdvanced Cardiovascular & Autonomic Nuances"
                            },
                            {
                                      "q": "Effect of \"Low Dose\" vs \"High Dose\" Epinephrine on Blood Pressure?",
                                      "a": "Low dose decreases BP (Beta-2 vasodilation); High dose increases BP (Alpha-1 vasoconstriction)."
                            },
                            {
                                      "q": "Primary side effect of Minoxidil (other than hypertrichosis)?",
                                      "a": "Reflex tachycardia and fluid retention (should be given with a beta-blocker and diuretic)."
                            },
                            {
                                      "q": "Mechanism of action of Sacubitril?",
                                      "a": "Inhibits Neprilysin, increasing levels of atrial natriuretic peptide (ANP) and BNP."
                            },
                            {
                                      "q": "Why must <b>ACE inhibitors</b> be stopped 36 hours before starting Sacubitril/Valsartan?",
                                      "a": "To avoid a significant increase in the risk of angioedema."
                            },
                            {
                                      "q": "Mechanism of \"Nitrate Tolerance\"?",
                                      "a": "Depletion of sulfhydryl groups or oxidative stress; managed by a \"nitrate-free interval\" (usually at night).\n\nSpecialized Toxicology & Environmental"
                            },
                            {
                                      "q": "Treatment for Lead poisoning in an adult with severe symptoms?",
                                      "a": "<b>Dimercaprol</b> and <b>EDTA</b>."
                            },
                            {
                                      "q": "Mechanism of Arsenic poisoning?",
                                      "a": "Inhibits lipoic acid, a necessary cofactor for Pyruvate Dehydrogenase."
                            },
                            {
                                      "q": "Classic clinical presentation of Arsenic poisoning?",
                                      "a": "Garlic breath, rice-water stools, and \"mees lines\" (white lines on nails)."
                            },
                            {
                                      "q": "Antidote for Arsenic poisoning?",
                                      "a": "<b>Dimercaprol</b>."
                            },
                            {
                                      "q": "Mechanism of action of Cyanide?",
                                      "a": "Inhibits Cytochrome c oxidase in the electron transport chain (inhibits aerobic respiration).\n\nNeuro-Psychiatry & Behavioral Health (Advanced)"
                            },
                            {
                                      "q": "Mechanism of action of Ramelteon?",
                                      "a": "Melatonin receptor (MT1 and MT2) agonist used for insomnia."
                            },
                            {
                                      "q": "Mechanism of action of Suvorexant?",
                                      "a": "Orexin (hypocretin) receptor antagonist used for insomnia."
                            },
                            {
                                      "q": "Drug of choice for Bulimia Nervosa?",
                                      "a": "<b>Fluoxetine</b>."
                            },
                            {
                                      "q": "Mechanism of action of Atomoxetine?",
                                      "a": "Selective Norepinephrine Reuptake Inhibitor (SNRI) used for ADHD."
                            },
                            {
                                      "q": "Why are MAO inhibitors contraindicated with Tyramine-rich foods (cheese, wine)?",
                                      "a": "Tyramine displaces stored Norepinephrine, leading to a hypertensive crisis.\n\nHematology & Oncology (Niche Agents)"
                            },
                            {
                                      "q": "Mechanism of action of Bortezomib?",
                                      "a": "Proteasome inhibitor; induces apoptosis (used in Multiple Myeloma)."
                            },
                            {
                                      "q": "Mechanism of action of Bevacizumab?",
                                      "a": "Monoclonal antibody against VEGF (inhibits angiogenesis)."
                            },
