            { q: "Stimulus and response for the Moro reflex?", a: "Sudden head drop causes arm abduction/extension followed by adduction/flexion." },
            { q: "Normal disappearance age for the Moro reflex?", a: "4 months." },
            { q: "Stimulus and response for the Rooting reflex?", a: "Stroking the cheek causes the infant to turn the head toward the stimulus." },
            { q: "Normal disappearance age for the Rooting reflex?", a: "4 months." },
            { q: "Normal disappearance age for the Palmar Grasp reflex?", a: "4 months." },
            { q: "Normal disappearance age for the Plantar Grasp reflex?", a: "9 to 12 months." },
            { q: "Stimulus and response for the Asymmetric Tonic Neck Reflex (ATNR/Fencing)?", a: "Turning the head causes ipsilateral extremity extension and contralateral extremity flexion." },
            { q: "Normal disappearance age for the Asymmetric Tonic Neck Reflex (ATNR)?", a: "4 to 6 months." },
            { q: "Normal disappearance age for the Galant reflex (lateral trunk incurvation)?", a: "4 to 6 months." },
            { q: "Description and appearance age of the Parachute reflex?", a: "Protective extension of arms when tilted forward; appears at 7 to 9 months and persists for life." },
            { q: "Normal disappearance age for the Babinski reflex in healthy infants?", a: "12 to 24 months." },
            { q: "Average weight of a term newborn?", a: "3.5 kg." },
            { q: "Expected weight change in the first 3 to 4 days of life?", a: "Loss of up to 10% of birth weight." },
            { q: "Age by which a normal infant regains birth weight?", a: "10 to 14 days of life." },
            { q: "Age by which birth weight doubles?", a: "4 to 5 months." },
            { q: "Age by which birth weight triples?", a: "12 months (1 year)." },
            { q: "Age by which birth weight quadruples?", a: "24 months (2 years)." },
            { q: "Average length of a term newborn?", a: "50 cm (20 inches)." },
            { q: "Age by which birth length increases by 50%?", a: "12 months (1 year)." },
            { q: "Age by which birth length doubles?", a: "48 months (4 years)." },
            { q: "Age by which birth length triples?", a: "13 years." },
            { q: "Average occipitofrontal head circumference (OFC) at birth?", a: "35 cm." },
            { q: "Average head circumference increase per month in the first 3 months?", a: "2 cm per month." },
            { q: "Total head circumference increase expected across the entire first year of life?", a: "12 cm." },
            { q: "Timeframe for the closure of the posterior fontanelle?", a: "2 months of age." },
            { q: "Timeframe for the closure of the anterior fontanelle?", a: "9 to 18 months of age." },
            { q: "Average eruption time of the first primary (deciduous) tooth?", a: "6 months." },
            { q: "What type of tooth is typically the first primary tooth to erupt?", a: "Central mandibular incisor." },
            { q: "Total number of primary (deciduous) teeth expected by age 3?", a: "20 teeth." },
            { q: "Age at which secondary (permanent) teeth begin to erupt?", a: "6 years." },
            { q: "Gross motor red flag: Failure to sit independently by what age?", a: "9 months." },
            { q: "Gross motor red flag: Failure to walk independently by what age?", a: "18 months." },
            { q: "Fine motor red flag: Persistent fisting of hands past what age?", a: "3 months." },
            { q: "Fine motor red flag: Failure to transfer objects between hands by what age?", a: "6 to 9 months." },
            { q: "Language red flag: Lack of babbling by what age?", a: "12 months." },
            { q: "Language red flag: Lack of single words by what age?", a: "15 to 18 months." },
            { q: "Language red flag: Lack of 2-word spontaneous phrases by what age?", a: "24 months." },
            { q: "Social red flag: Lack of social smile by what age?", a: "3 months." },
            { q: "Social red flag: Lack of joint attention or declarative pointing by what age?", a: "18 months." },
            { q: "Global developmental delay (GDD) definition?", a: "Significant delay in 2 or more developmental domains in children under 5 years old." },
            { q: "Most common inherited cause of intellectual disability?", a: "Fragile X Syndrome." },
            { q: "Most common genetic (non-inherited) cause of intellectual disability?", a: "Down Syndrome (Trisomy 21)." },
            { q: "Universal screening age for Autism Spectrum Disorder (ASD) via M-CHAT?", a: "18 months and 24 months." },
            { q: "Average daily sleep duration required for a neonate?", a: "16 to 18 hours." },
            { q: "Age at which an infant typically consolidates sleep through the night?", a: "6 months." },
            { q: "Physiological readiness age window for toilet training?", a: "18 to 24 months." },
            { q: "Psychological milestone required before starting toilet training?", a: "Ability to communicate the need to eliminate and desire to please parents." },
            { q: "Average age window when girls achieve day bladder control?", a: "2.5 to 3 years." },
            { q: "Average age window when boys achieve day bladder control?", a: "3 to 3.5 years." },
            { q: "Age after which bedwetting is formally classified as nocturnal enuresis?", a: "5 years." },
            { q: "Formula for estimating lower limit of systolic blood pressure (5th percentile) for ages 1 to 10?", a: "70 + (2 × age in years) mmHg." },
            { q: "Minimum systolic blood pressure defining hypotension in a term neonate (0 to 28 days)?", a: "Less than 60 mmHg." },
            { q: "Minimum systolic blood pressure defining hypotension in an infant (1 to 12 months)?", a: "Less than 70 mmHg." },
            { q: "Normal resting respiratory rate for a newborn?", a: "40 to 60 breaths per minute." },
            { q: "Normal resting heart rate range for an awake neonate?", a: "100 to 180 beats per minute." },
            { q: "First physical sign of puberty in genetic females?", a: "Thelarche (breast budding)." },
            { q: "Tanner Stage of a female with a projection of the papilla only?", a: "Tanner Stage 1." },
            { q: "Tanner Stage characterized by elevation of breast and papilla as a small mound, with enlargement of areolar diameter?", a: "Tanner Stage 2." },
            { q: "Tanner Stage characterized by further enlargement of breast and areola without separation of their contours?", a: "Tanner Stage 3." },
            { q: "Tanner Stage where the areola and papilla project to form a secondary mound above the level of the breast?", a: "Tanner Stage 4." },
            { q: "Tanner Stage showing recession of the areola to the general contour of the breast, with projection of the papilla only?", a: "Tanner Stage 5." },
            { q: "Timeline of menarche relative to the onset of thelarche?", a: "Approximately 2 to 2.5 years after thelarche." },
            { q: "Tanner stage during which the female growth spurt typically peaks?", a: "Tanner Stage 3." },
            { q: "First physical sign of puberty in genetic males?", a: "Testicular enlargement (volume greater than or equal to 4 mL)." },
            { q: "Tanner Stage 2 male genital characteristics?", a: "Enlargement of scrotum and testes; scrotal skin reddens and thins." },
            { q: "Tanner Stage 3 male genital characteristics?", a: "Enlargement of penis (lengthwise) and further growth of testes." },
            { q: "Tanner Stage 4 male genital characteristics?", a: "Increased size of penis (breadth/glans development) and darkening of scrotal skin." },
            { q: "Tanner stage during which the male growth spurt typically peaks?", a: "Tanner Stage 4." },
            { q: "Tanner Stage 2 pubic hair characteristics?", a: "Sparse growth of long, slightly pigmented, straight hair at the base of the penis or labia." },
            { q: "Tanner Stage 3 pubic hair characteristics?", a: "Darker, coarser, and more curled hair spreading sparsely over the junction of the pubes." },
            { q: "Tanner Stage 4 pubic hair characteristics?", a: "Hair is adult in type, but covers an area smaller than in most adults; no spread to medial thighs." },
            { q: "Tanner Stage 5 pubic hair characteristics?", a: "Adult hair in quantity and type, distributed in an inverse triangle pattern extending to the medial thighs." },
            { q: "Average age of onset for female puberty?", a: "8 to 13 years of age." },
            { q: "Average age of onset for male puberty?", a: "9 to 14 years of age." },
            { q: "Definition of precocious puberty in girls?", a: "Development of secondary sexual characteristics before age 8." },
            { q: "Definition of precocious puberty in boys?", a: "Development of secondary sexual characteristics before age 9." },
            { q: "Definition of delayed puberty in girls?", a: "No breast development by age 13." },
            { q: "Definition of delayed puberty in boys?", a: "No testicular enlargement by age 14." },
            { q: "Recommended age for universal autism screening using the M-CHAT?", a: "18 and 24 months." },
            { q: "Recommended ages for universal developmental screening using validated tools (e.g., ASQ)?", a: "9, 18, and 30 months." },
            { q: "Standardized screening tool used to assess a child's development from birth to 6 years across four domains?", a: "Denver Developmental Screening Test II (Denver II)." },
            { q: "Primary purpose of the Modified Checklist for Autism in Toddlers (M-CHAT)?", a: "To identify children at risk for Autism Spectrum Disorder (ASD)." },
            { q: "Next step after a positive or high-risk score on an M-CHAT screening?", a: "Referral for formal diagnostic evaluation and early intervention services." },
            { q: "Piaget stage from birth to 2 years characterized by object permanence?", a: "Sensorimotor stage." },
            { q: "Piaget stage from 2 to 7 years characterized by egocentrism and magical thinking?", a: "Preoperational stage." },
            { q: "Piaget stage from 7 to 11 years where a child understands conservation of volume and mass?", a: "Concrete operational stage." },
            { q: "Piaget stage from age 11 onward characterized by abstract and hypothetical thinking?", a: "Formal operational stage." },
            { q: "Erikson psychosocial crisis for infants from birth to 1 year?", a: "Trust vs. Mistrust." },
            { q: "Erikson psychosocial crisis for toddlers from 1 to 3 years?", a: "Autonomy vs. Shame and Doubt." },
            { q: "Erikson psychosocial crisis for preschool children from 3 to 6 years?", a: "Initiative vs. Guilt." },
            { q: "Erikson psychosocial crisis for school-aged children from 6 to 12 years?", a: "Industry vs. Inferiority." },
            { q: "Erikson psychosocial crisis for adolescents from 12 to 18 years?", a: "Identity vs. Role Confusion." },
            { q: "Definition of microcephaly based on head circumference percentiles?", a: "Occipitofrontal circumference (OFC) less than the 3rd percentile (or < -2 standard deviations)." },
            { q: "Definition of macrocephaly based on head circumference percentiles?", a: "Occipitofrontal circumference (OFC) greater than the 97th percentile (or > +2 standard deviations)." },
            { q: "Classic diagnostic criteria for Failure to Thrive (FTT)?", a: "Weight below the 3rd to 5th percentile, or weight crossing two major percentile lines downward." },
            { q: "Most common etiology of Failure to Thrive (FTT) in the United States?", a: "Non-organic (psychosocial/inadequate caloric intake)." },
            { q: "First growth parameter affected in nutritional (organic or non-organic) Failure to Thrive?", a: "Weight." },
            { q: "Second growth parameter affected in progressive nutritional Failure to Thrive?", a: "Height/Length." },
            { q: "Final growth parameter affected in severe, chronic nutritional Failure to Thrive?", a: "Head circumference." },
            { q: "Condition suspected when head circumference is normal but weight and height drop early?", a: "Constitutional growth delay or endocrine pathology." },
            { q: "Condition suspected when head circumference drops disproportionately to weight and height?", a: "Congenital infection, genetic syndrome, or central nervous system insult." },
            { q: "Clinical feature distinguishing Constitutional Delay of Growth from Familial Short Stature?", a: "Constitutional delay features a delayed bone age; Familial short stature features a normal bone age." },
            { q: "Formula to calculate Mid-Parental Height (Target Height) for a boy?", a: "[Father's height + Mother's height + 13 cm (or 5 inches)] / 2." },
            { q: "Formula to calculate Mid-Parental Height (Target Height) for a girl?", a: "[Father's height + Mother's height - 13 cm (or 5 inches)] / 2." },
            { q: "Age at which iron-fortified single-grain infant cereal should be introduced?", a: "4 to 6 months." },
            { q: "Maximum age window to exclusively breastfeed an infant before introducing solids?", a: "6 months." },
            { q: "Why should whole cow's milk be avoided until 12 months of age?", a: "Risk of iron-deficiency anemia due to occult GI blood loss and low iron bioavailability." },
            { q: "Why should honey be strictly avoided before 12 months of age?", a: "Risk of infant botulism from Clostridium botulinum spores." },
            { q: "Age at which juice can be introduced to a child's diet, according to AAP guidelines?", a: "Not recommended before 12 months of age." },
            { q: "Age at which the first visit to a pediatric dentist is recommended?", a: "Within 6 months of the first tooth eruption or by 12 months of age." },
            { q: "Supplementation required for exclusively breastfed infants starting in the first few days of life?", a: "Vitamin D (400 IU daily)." },
            { q: "Supplementation required for exclusively breastfed term infants starting at 4 months of age?", a: "Oral iron supplementation (1 mg/kg/day) until iron-containing solid foods are introduced." },
            { q: "Age until which an infant should ride in a rear-facing car safety seat?", a: "At least 2 years of age (or until reaching the highest weight/height limit allowed by the manufacturer)." },
            { q: "Age at which a child can typically safely transition from a booster seat to a vehicle lap-and-shoulder belt?", a: "When they reach 4 feet 9 inches (145 cm) in height, typically between 8 and 12 years old." },
            { q: "Crucial positioning recommendation to reduce the risk of Sudden Infant Death Syndrome (SIDS)?", a: "Prone-to-supine sleep position (\"Back to Sleep\") on a firm surface." },
            { q: "Fine motor milestone that correlates with an increased risk of household choking hazards?", a: "Pincer grasp (9 to 12 months)." },
            { q: "Gross motor milestone that requires immediate installation of safety gates at stairs?", a: "Crawling (9 months)." },
            { q: "Only paranasal sinuses present and radiographically visible at birth?", a: "Ethmoid sinuses (maxillary are present but pneumatize later)." },
            { q: "Age at which the frontal sinuses typically become radiographically apparent?", a: "5 to 7 years of age." },
            { q: "Age at which the sphenoid sinuses finish development and pneumatization?", a: "Puberty (begins around 3 to 5 years)." },
            { q: "Percentage of adult brain volume achieved by an infant by 1 year of age?", a: "Approximately 70%." },
            { q: "Percentage of adult brain volume achieved by a child by 2 years of age?", a: "Approximately 80%." },
            { q: "Most common cause of gonadotropin-dependent (central) precocious puberty in girls?", a: "Idiopathic (constitutional)." },
            { q: "Most common cause of gonadotropin-dependent (central) precocious puberty in boys?", a: "Central nervous system tumors (e.g., hypothalamic hamartoma)." },
            { q: "Genetic condition to suspect in a phenotypic male with delayed puberty, small/firm testes, and gynecomastia?", a: "Klinefelter Syndrome (47, XXY)." },
            { q: "Genetic condition to suspect in a phenotypic female with delayed puberty, short stature, and low-set ears?", a: "Turner Syndrome (45, X)." },
            { q: "Condition characterized by isolated breast development in girls under age 2 with no other signs of puberty?", a: "Benign premature thelarche." },
            { q: "Diagnostic step to differentiate central precocious puberty from peripheral precocious puberty?", a: "GnRH stimulation test (central shows an LH response; peripheral does not)." },
            { q: "Most concerning developmental history finding regardless of domain or age?", a: "Loss of any previously acquired milestone (developmental regression)." },
            { q: "Developmental regression in a 15-month-old female with hand-wringing stereotypies points to?", a: "Rett Syndrome." },
            { q: "Motor milestone indicating a child is delayed if they cannot run or walk up stairs by what age?", a: "24 months (2 years)." },
            { q: "Language milestone indicating a child is delayed if they do not use single words by what age?", a: "16 months." },
            { q: "Fine motor delay indicated if a child cannot copy a circle by what age?", a: "4 years (48 months)." },
            { q: "Asymmetric Moro reflex with lack of movement in one arm suggests?", a: "Brachial plexus injury (Erb-Duchenne palsy) or clavicle fracture." },
            { q: "Retention of primitive reflexes past the first year of life is highly associated with?", a: "Cerebral Palsy." },
            { q: "Nerve roots evaluated by the Moro reflex?", a: "C5 and C6." },
            { q: "Neonatal reflex where stroking the spine causes lateral flexion of the lower trunk toward the stimulated side?", a: "Galant reflex." },
            { q: "Absence of the Galant reflex may indicate?", a: "Spinal cord transection or lower motor neuron lesion." },
            { q: "Expected response to the Landau reflex when an infant is held horizontally in prone position?", a: "The infant lifts the head and extends the neck and spine (disappears by 12 to 24 months)." },
            { q: "Well-child visit age where an infant should receive the first dose of MMR and Varicella vaccines alongside walking milestones?", a: "12 to 15 months." },
            { q: "Well-child visit age that pairs the 4th DTaP dose with running and a 10-word vocabulary?", a: "18 months." },
            { q: "Well-child visit age where toilet training readiness and parallel play are assessed before kindergarten vaccine discussions?", a: "24 months (2 years)." },
            { q: "Age at which the final booster doses of DTaP, IPV, MMR, and Varicella are administered alongside skipping milestones?", a: "4 to 6 years (Kindergarten entry)." },
            { q: "Principal psychological mechanism driving risk-taking behavior in middle adolescence (ages 14 to 17)?", a: "Belief of omnipotence and invulnerability (\"it won't happen to me\")." },
            { q: "Primary source of behavioral validation during early and middle adolescence?", a: "Peer groups." },
            { q: "Most common somatic symptom of depression in school-aged children and adolescents?", a: "Recurrent abdominal pain or headaches." },
            { q: "Tanner stage in males where axillary hair and facial hair growth typically begin?", a: "Tanner Stage 4." },
            { q: "Normal variance characterized by transient, tender breast tissue under the areola in pubertal boys?", a: "Adolescent physiologic gynecomastia (typically resolves spontaneously within 1 to 2 years)." },
            { q: "Term for a child whose growth parameters are low but parallel to the normal growth curves, with normal bone age?", a: "Genetic (Familial) Short Stature." },
            { q: "Most common presentation of growth chart deviation due to psychosocial deprivation?", a: "Sudden drop in weight percentile while height remains stable initially." },
            { q: "Main endocrine disorder causing a child to stop growing in height while simultaneously gaining weight?", a: "Hypothyroidism." },
            { q: "Immediate next step in management for a child with a downward deviation crossing two major weight percentiles?", a: "Detailed dietary intake history and calorie count." }
          ]
        },
{
          section: 'Pediatrics (Introductory)',
          topic: "Neonatal conditions — jaundice, RDS, sepsis",
          icon: 'baby',
          cards: [
            { q: "Definition of physiological jaundice peak timeline in a term infant?", a: "Total serum bilirubin (TSM) peaks at 3 to 5 days of life." },
            { q: "Definition of physiological jaundice peak timeline in a preterm infant?", a: "Total serum bilirubin peaks at 5 to 7 days of life." },
            { q: "Maximum normal velocity of bilirubin rise in physiological jaundice?", a: "Less than 5 mg/dL per 24 hours (or $\\1$ mg/dL per hour)." },
            { q: "Definition of pathological jaundice based on onset timing?", a: "Any visible jaundice presenting within the first 24 hours of life." },
            { q: "Definition of pathological jaundice based on direct (conjugated) bilirubin levels?", a: "Direct bilirubin greater than 1.0 mg/dL if TSB is $\\1$ mg/dL, or $\\1$ of the TSB if TSB is $\\1$ mg/dL." },
            { q: "Mechanism of Breast Milk Jaundice?", a: "High levels of $\\beta$-glucuronidase in breast milk deconjugate bilirubin in the intestine, increasing enterohepatic circulation." },
            { q: "Typical onset timing for Breast Milk Jaundice?", a: "Starts after the first week of life, peaking at 2 to 3 weeks." },
            { q: "Mechanism of Breastfeeding Jaundice (Breastfeeding Failure Jaundice)?", a: "Inadequate milk intake leads to dehydration, slow gut motility, and increased enterohepatic bilirubin reabsorption." },
            { q: "Typical onset timing for Breastfeeding Jaundice?", a: "Occurs within the first 3 to 5 days of life." },
            { q: "Cephalocaudal progression of jaundice means what clinically?", a: "Dermal icterus progresses from head to toe as serum bilirubin levels rise." },
            { q: "Primary enzyme deficient in Crigler-Najjar Syndrome Type I?", a: "Complete absence of Uridine Diphosphate Glucuronosyltransferase (UGT1A1)." },
            { q: "Primary enzyme deficiency in Gilbert Syndrome?", a: "Mildly decreased activity (around 10-30% of normal) of UGT1A1." },
            { q: "Diagnostic response to phenobarbital in Crigler-Najjar Type II (Arias Syndrome)?", a: "Phenobarbital induces UGT1A1 activity, causing a significant decrease in serum bilirubin." },
            { q: "Most common hemolytic cause of severe neonatal unconjugated hyperbilirubinemia?", a: "ABO incompatibility (usually Mother type O, Infant type A or B)." },
            { q: "Key peripheral blood smear finding in ABO incompatibility?", a: "Microspherocytes." },
            { q: "Why does Rh incompatibility cause more severe hydrops fetalis than ABO incompatibility?", a: "Maternal anti-D antibodies (IgG) are highly destructive, whereas anti-A/B antibodies are often IgM or neutralized by tissue antigens." },
            { q: "What does a positive Direct Antiglobulin Test (DAT/Coombs) indicate?", a: "Antibody-coated red blood cells are present in the newborn's circulation." },
            { q: "Most common red cell enzyme deficiency causing neonatal jaundice?", a: "Glucose-6-Phosphate Dehydrogenase (G6PD) deficiency." },
            { q: "Trigger factors for hemolysis in a G6PD-deficient neonate?", a: "Oxidative stress from maternal infection, naphthalene (mothballs), or certain medications." },
            { q: "Classic triad of Encephalopathy due to acute bilirubin toxicity?", a: "Hypotonia/hypertonia (retrocollis/opisthotonos), high-pitched cry, and poor feeding." },
            { q: "Chronic, irreversible brain damage from bilirubin deposition is called?", a: "Kernicterus." },
            { q: "Specific neuroanatomical site targeted by unconjugated bilirubin toxicity?", a: "Basal ganglia (specifically the globus pallidus) and subthalamic nuclei." },
            { q: "Long-term neurologic sequelae of Kernicterus?", a: "Choreoathetoid cerebral palsy, sensorineural hearing loss, and upward gaze palsy." },
            { q: "Mechanism of action of phototherapy for neonatal jaundice?", a: "Converts unconjugated bilirubin into structural isomers (lumirubin) via photoisomerization, which are excreted in bile and urine without conjugation." },
            { q: "Wavelength of light most effective for neonatal phototherapy?", a: "Blue-green light in the 460 to 490 nm spectrum." },
            { q: "Crucial physical protection needed for a neonate under phototherapy?", a: "Eye shields to prevent retinal damage." },
            { q: "Benign skin complication seen in infants with conjugated hyperbilirubinemia undergoing phototherapy?", a: "Bronze Baby Syndrome." },
            { q: "Definitive immediate therapy for neonates with TSB at or near exchange levels despite intensive phototherapy?", a: "Double-volume exchange transfusion." },
            { q: "Major immediate risk/complication of exchange transfusion?", a: "Hypocalcemia (due to citrate anticoagulant), thrombocytopenia, and portal vein thrombosis." },
            { q: "First-line screening test to differentiate biliary atresia from neonatal hepatitis?", a: "Abdominal ultrasound (looking for the triangular cord sign or absent gallbladder)." },
            { q: "Gold standard diagnostic test for Biliary Atresia?", a: "Intraoperative cholangiogram." },
            { q: "Definitive temporary surgical management for Biliary Atresia?", a: "Kasai hepatoportoenterostomy." },
            { q: "Ideal timeframe for performing a Kasai procedure to ensure optimal prognosis?", a: "Before 45 to 60 days of life." },
            { q: "Direct hyperbilirubinemia accompanied by cataracts and hepatomegaly suggests?", a: "Galactosemia (Galactose-1-phosphate uridyltransferase deficiency)." },
            { q: "Direct hyperbilirubinemia with a lack of interlobular bile ducts on liver biopsy describes?", a: "Alagille Syndrome (associated with JAG1 mutation)." },
            { q: "Cardinal facial features of Alagille Syndrome?", a: "Broad forehead, pointed chin, and deep-set, hypertoric eyes." },
            { q: "Cardiac anomaly most highly associated with Alagille Syndrome?", a: "Peripheral pulmonary artery stenosis." },
            { q: "Skeletal abnormality visible on X-ray in Alagille Syndrome?", a: "Butterfly vertebrae." },
            { q: "Most common cause of conjugated hyperbilirubinemia in a preterm infant on long-term parental nutrition?", a: "Intravenous Lipid/PN-associated cholestasis (PNAC)." },
            { q: "Alternative medical term for Respiratory Distress Syndrome?", a: "Hyaline Membrane Disease (HMD)." },
            { q: "Primary biochemical composition of pulmonary surfactant?", a: "Dipalmitoylphosphatidylcholine (lecithin) and surfactant proteins (A, B, C, D)." },
            { q: "Primary cell type responsible for producing and secreting surfactant?", a: "Type II alveolar pneumocytes." },
            { q: "Gestational age when surfactant production begins to rise significantly?", a: "Between 24 and 28 weeks of gestation." },
            { q: "Gestational age when surfactant production reaches mature levels?", a: "35 weeks of gestation." },
            { q: "Pathophysiology of atelectasis in RDS?", a: "High alveolar surface tension leads to alveolar collapse at end-expiration." },
            { q: "Consequence of progressive atelectasis on ventilation-perfusion matching?", a: "Intrapulmonary right-to-left shunting leading to severe hypoxemia." },
            { q: "Key maternal metabolic condition that delays fetal lung maturation?", a: "Maternal diabetes mellitus (hyperinsulinemia inhibits surfactant synthesis)." },
            { q: "Physical stress factor that accelerates fetal lung maturation?", a: "Chronic intrauterine stress (e.g., maternal hypertension, PPROM) via endogenous corticosteroid release." },
            { q: "Classical triad of physical signs of neonatal respiratory distress?", a: "Tachypnea, intercostal/subcostal retractions, and expiratory grunting." },
            { q: "Pathophysiology behind the expiratory grunt in RDS?", a: "Partial closure of the glottis during expiration to maintain positive end-expiratory pressure (PEEP)." },
            { q: "Pathognomonic chest X-ray findings in severe RDS?", a: "Diffuse, uniform \"ground-glass\" reticulogranular appearance with air bronchograms." },
            { q: "Reason for air bronchograms on an RDS chest X-ray?", a: "Aerated bronchioles are silhouetted against surrounding collapsed, fluid-filled alveoli." },
            { q: "Classic arterial blood gas (ABG) findings in untreated RDS?", a: "Hypoxemia, hypercapnia, and mixed respiratory-metabolic acidosis." },
            { q: "Preferred pharmacological strategy for a mother at 30 weeks gestation in active preterm labor?", a: "Antenatal corticosteroids (Betamethasone or Dexamethasone)." },
            { q: "Standard timeframe for maximum benefit of antenatal corticosteroids?", a: "At least 24 hours and up to 7 days before delivery." },
            { q: "First-line non-invasive respiratory support for a preterm infant with mild-to-moderate RDS?", a: "Nasal Continuous Positive Airway Pressure (nCPAP)." },
            { q: "Primary physiological benefit of CPAP in RDS?", a: "Recruits collapsed alveoli and stabilizes Functional Residual Capacity (FRC)." },
            { q: "What does the \"INSURE\" strategy stand for in RDS management?", a: "Intubate, Surfactant administration, and Extubate to CPAP immediately." },
            { q: "Route of administration for exogenous surfactant?", a: "Endotracheal instillation directly into the lungs." },
            { q: "Major acute risk during the rapid administration of exogenous surfactant?", a: "Transient airway obstruction and bradycardia." },
            { q: "Physiological change after surfactant that necessitates rapid weaning of ventilator pressures?", a: "A sharp, rapid increase in pulmonary compliance." },
            { q: "Failure to properly wean ventilator settings after surfactant can cause?", a: "Pulmonary barotrauma/volutrauma leading to pneumothorax." },
            { q: "Chronic lung disease condition resulting from prolonged mechanical ventilation and oxygen toxicity?", a: "Bronchopulmonary Dysplasia (BPD)." },
            { q: "Diagnostic definition of Bronchopulmonary Dysplasia (BPD)?", a: "Requirement for supplemental oxygen at 36 weeks postmenstrual age (for infants born $\\1$ weeks)." },
            { q: "Diagnostic alternative for BPD if the infant was born at or after 32 weeks gestation?", a: "Requirement for supplemental oxygen beyond 28 days of life." },
            { q: "Characteristic chest X-ray finding in chronic Bronchopulmonary Dysplasia?", a: "\"Coarse lucencies\" or a \"sponge-like\" cystic appearance with areas of atelectasis and hyperinflation." },
            { q: "Major cardiovascular complication of severe Bronchopulmonary Dysplasia?", a: "Pulmonary hypertension leading to cor pulmonale." },
            { q: "Prophylactic medication recommended to prevent RSV infection in infants with severe BPD?", a: "Palivizumab (monoclonal antibody against RSV F glycoprotein)." },
            { q: "Acute neurological complication associated with severe hypoxia and fluctuations in blood pressure in RDS?", a: "Intraventricular Hemorrhage (IVH)." },
            { q: "Screen tool used to detect Intraventricular Hemorrhage in preterm infants?", a: "Cranial ultrasound through the anterior fontanelle." },
            { q: "Origin site of bleeding in neonatal Intraventricular Hemorrhage?", a: "The fragile subependymal germinal matrix." },
            { q: "Main differential diagnosis for a term infant with respiratory distress and a \"wet lung\" chest X-ray?", a: "Transient Tachypnea of the Newborn (TTN)." },
            { q: "Pathophysiology of Transient Tachypnea of the Newborn (TTN)?", a: "Delayed clearance of fetal lung fluid by lung epithelial sodium channels ($ENaC$)." },
            { q: "Classic chest X-ray findings in Transient Tachypnea of the Newborn (TTN)?", a: "Prominent perihilar vascular markings, fluid in the interlobar fissures, and hyperinflation." },
            { q: "Major risk factor for the development of Transient Tachypnea of the Newborn?", a: "Elective Cesarean delivery without a trial of labor." },
            { q: "Definition of Early-Onset Neonatal Sepsis (EOS) by timing?", a: "Onset of systemic infection within the first 72 hours of life." },
            { q: "Definition of Late-Onset Neonatal Sepsis (LOS) by timing?", a: "Onset of systemic infection after 72 hours of life up to 28 days." },
            { q: "Primary mode of transmission for Early-Onset Sepsis?", a: "Vertical transmission from the maternal genital tract during labor or delivery." },
            { q: "Primary mode of transmission for Late-Onset Sepsis?", a: "Horizontal transmission from the environment, caregivers, or nosocomial sources." },
            { q: "Most common bacterial pathogen responsible for Early-Onset Neonatal Sepsis?", a: "Group B Streptococcus (Streptococcus agalactiae)." },
            { q: "Second most common pathogen causing EOS, particularly in preterm infants?", a: "Escherichia coli." },
            { q: "Gram-positive rod associated with neonatal sepsis via maternal ingestion of unpasteurized dairy?", a: "Listeria monocytogenes." },
            { q: "Most common pathogen group responsible for Late-Onset Sepsis in NICU patients with central lines?", a: "Coagulase-negative Staphylococci (Staphylococcus epidermidis)." },
            { q: "Major maternal risk factor for Early-Onset Sepsis involving amniotic fluid?", a: "Maternal Chorioamnionitis (intra-amniotic infection)." },
            { q: "Clinical diagnostic criteria for Maternal Chorioamnionitis?", a: "Maternal fever plus maternal/fetal tachycardia, uterine tenderness, or foul-smelling amniotic fluid." },
            { q: "Time cutoff defining Prolonged Rupture of Membranes (PROM) as a sepsis risk factor?", a: "Rupture of membranes greater than or equal to 18 hours prior to delivery." },
            { q: "Standard screening protocol timing for maternal Group B Streptococcus carriage?", a: "Rectovaginal swab culture performed at 36 0/7 to 37 6/7 weeks of gestation." },
            { q: "Preferred agent for maternal intrapartum antibiotic prophylaxis against GBS?", a: "Intravenous Penicillin G (or Ampicillin)." },
            { q: "Alternative intrapartum antibiotic for GBS prophylaxis if the mother has a non-severe penicillin allergy?", a: "Cefazolin." },
            { q: "Alternative intrapartum antibiotic for GBS prophylaxis if the mother has a severe penicillin allergy and resistant isolates?", a: "Vancomycin." },
            { q: "Minimum duration of intrapartum antibiotic prophylaxis prior to delivery to be considered \"adequate\"?", a: "4 hours or more before birth." },
            { q: "Most common, yet non-specific, clinical sign of neonatal sepsis?", a: "Temperature instability (hypothermia or hyperthermia)." },
            { q: "Why is hypothermia more common than hyperthermia in sick preterm neonates?", a: "Immature thermoregulation and lack of brown fat stores to generate metabolic heat." },
            { q: "Cardiovascular indicator of early neonatal septic shock?", a: "Prolonged capillary refill time ($\\1$ seconds), tachycardia, and mottled skin." },
            { q: "Standard, absolute diagnostic test required prior to starting empiric antibiotics for suspected sepsis?", a: "Blood culture." },
            { q: "Minimum adequate volume of blood required for a neonatal blood culture bottles?", a: "1 mL of blood." },
            { q: "Why must a Lumbar Puncture be strongly considered in neonatal sepsis workups?", a: "Up to 30% of neonates with bacteremia have concurrent meningitis without focal meningeal signs." },
            { q: "Cerebrospinal fluid (CSF) findings indicative of bacterial neonatal meningitis?", a: "Elevated WBC count (with polymorphonuclear predominance), elevated protein, and low glucose." },
            { q: "First-line empiric antibiotic regimen for suspected Early-Onset Neonatal Sepsis?", a: "Ampicillin plus an Aminoglycoside (typically Gentamicin)." },
            { q: "Why is Ampicillin explicitly included in the early-onset empiric regimen?", a: "To provide specific, empirical coverage for Listeria monocytogenes." },
            { q: "Empiric antibiotic regimen for suspected Late-Onset Sepsis/Nosocomial NICU infections?", a: "Vancomycin (for MRSA/CoNS) plus an antipseudomonal $\\beta$-lactam (like Cefepime or Piperacillin-Tazobactam)." },
            { q: "Why is Ceftriaxone avoided in neonates requiring empiric therapy?", a: "It displaces bilirubin from albumin (increasing kernicterus risk) and can precipitate with calcium in biliary sludge." },
            { q: "Preferred alternative third-generation cephalosporin used for neonatal bacterial meningitis?", a: "Cefotaxime." },
            { q: "Target trough level timing for monitoring Gentamicin toxicity in a neonate?", a: "Measured immediately before the 3rd or 4th dose." },
            { q: "Primary toxicities associated with Aminoglycoside (Gentamicin) use?", a: "Ototoxicity and nephrotoxicity." },
            { q: "Primary toxicity associated with Vancomycin use if infused too rapidly?", a: "Red Man Syndrome (Histamine release)." },
            { q: "Complete Blood Count (CBC) finding that has a high negative predictive value for neonatal sepsis?", a: "A normal absolute neutrophil count (ANC) and low immature-to-total (I:T) neutrophil ratio." },
            { q: "Formula to calculate the Immature-to-Total (I:T) neutrophil ratio?", a: "(Bands + Metamyelocytes) divided by (Segmented Neutrophils + Bands + Metamyelocytes)." },
            { q: "An I:T ratio greater than what value suggests acute neonatal infection?", a: "Greater than or equal to 0.2." },
            { q: "Acute hematologic sign of severe sepsis due to platelet consumption?", a: "Thrombocytopenia (platelets $\\1$,000/uL)." },
            { q: "Systemic inflammatory biomarker commonly used to track the treatment response of neonatal sepsis?", a: "C-Reactive Protein (CRP)." },
            { q: "Why is a single normal CRP at onset insufficient to rule out neonatal sepsis?", a: "CRP synthesis lags and can take 12 to 24 hours from the onset of infection to elevate significantly." },
            { q: "Serious gastrointestinal complication of prematurity linked to severe systemic sepsis?", a: "Necrotizing Enterocolitis (NEC)." },
            { q: "Pathognomonic radiographic sign seen on abdominal X-ray in Necrotizing Enterocolitis?", a: "Pneumatosis intestinalis (gas within the bowel wall)." },
            { q: "Metabolic complication of sepsis caused by increased peripheral glucose consumption and poor reserves?", a: "Hypoglycemia." },
            { q: "Target serum glucose level for immediate intervention in a symptomatic neonate?", a: "Less than 40 to 45 mg/dL." },
            { q: "Standard management for a completely asymptomatic well-appearing infant born to a mother with inadequately treated GBS prophylaxis?", a: "Routine clinical observation in the hospital for at least 48 hours without diagnostic tests." },
            { q: "Neonatal condition characterized by a generalized petechial rash (\"blueberry muffin spots\") and hepatosplenomegaly?", a: "Congenital TORCH infection." },
            { q: "Classic triad of congenital Toxoplasmosis?", a: "Chorioretinitis, hydrocephalus, and intracranial calcifications." },
            { q: "Pattern of intracranial calcifications in congenital Toxoplasmosis?", a: "Diffuse throughout the brain parenchyma." },
            { q: "Pattern of intracranial calcifications in congenital Cytomegalovirus (CMV)?", a: "Periventricular calcifications." },
            { q: "Classic long-term neurological sequela of congenital CMV infection?", a: "Sensorineural hearing loss." },
            { q: "Classic triad of congenital Rubella Syndrome?", a: "Cataracts, sensorineural deafness, and congenital heart disease (Patent Ductus Arteriosus)." },
            { q: "Primary physical finding in early congenital Syphilis involving the nose?", a: "Snuffles (copious, highly infectious mucoid or bloody nasal discharge)." },
            { q: "Definitive diagnostic test for neonatal Herpes Simplex Virus (HSV) central nervous system infection?", a: "CSF HSV Polymerase Chain Reaction (PCR)." },
            { q: "Standard antiviral therapy for documented or highly suspected neonatal HSV infection?", a: "High-dose intravenous Acyclovir ($60 \\text{ mg/kg/day}$ divided every 8 hours)." },
            { q: "What is the primary hazard of rapid, aggressive correction of profound chronic hyponatremia during exchange transfusion?", a: "Central pontine myelinolysis (Osmotic Demyelination Syndrome)." },
            { q: "Why does an infant with a large cephalohematoma have an increased risk of severe hyperbilirubinemia?", a: "Extravascular RBC destruction and breakdown of trapped hemoglobin increases the systemic bilirubin load." },
            { q: "Which congenital cardiac lesion is classically associated with an increased incidence of neonatal hyperbilirubinemia due to polycythemia?", a: "Infants of diabetic mothers or transposition of the great arteries." },
            { q: "What is the rule of thumb for when to initiate phototherapy based on a healthy term infant's age in hours?", a: "Use the AAP (American Academy of Pediatrics) nomogram, tracking risk zones based on hour-specific bilirubin levels." },
            { q: "What is the effect of maternal epidural anesthesia on neonatal jaundice?", a: "It can sometimes cause poor initial feeding, exacerbating breastfeeding jaundice." },
            { q: "What underlying structural liver anomaly must be ruled out in an infant presenting with clay-colored (acholic) stools?", a: "Biliary atresia." },
            { q: "What nutritional deficiency must be proactively managed in infants with chronic cholestatic jaundice?", a: "Deficiencies in fat-soluble vitamins (Vitamins A, D, E, K) due to poor bile acid-mediated micelle formation." },
            { q: "What is the significance of a \"double bubble\" sign on abdominal X-ray in a neonate with conjugated hyperbilirubinemia?", a: "Suggests Duodenal Atresia, classically associated with Down Syndrome, which also carries an increased risk of neonatal transient myeloproliferative disorder and cholestasis." },
            { q: "Why does hypothyroidism cause prolonged unconjugated hyperbilirubinemia?", a: "Hepatic glucuronide conjugation is delayed because thyroid hormone is required for UGT enzyme maturation." },
            { q: "What is the inheritance pattern of Crigler-Najjar Syndrome Type I?", a: "Autosomal recessive." },
            { q: "What is the inheritance pattern of Gilbert Syndrome?", a: "Autosomal recessive (most commonly a promoter mutation variant)." },
            { q: "What is the target pre-ductal oxygen saturation range for a preterm infant at 5 minutes of life?", a: "80% to 85% (per Neonatal Resuscitation Program/NRP guidelines)." },
            { q: "Where should a pulse oximeter probe be placed on a neonate to measure pre-ductal oxygen saturation?", a: "On the right wrist or palmar surface of the right hand." },
            { q: "What causes the difference between pre-ductal and post-ductal oxygen saturations in severe respiratory distress?", a: "Persistent Pulmonary Hypertension of the Newborn (PPHN) causing a right-to-left shunt across the patent ductus arteriosus (PDA)." },
            { q: "What is the definitive echocardiographic finding that confirms Persistent Pulmonary Hypertension of the Newborn (PPHN)?", a: "Right-to-left shunting through the PDA or foramen ovale, and flattened interventricular septum from high right ventricular pressures." },
            { q: "What is the first-line inhaled vasodilator therapy used for PPHN?", a: "Inhaled Nitric Oxide (iNO)." },
            { q: "What is the primary mechanism of action of Inhaled Nitric Oxide?", a: "Selectively relaxes pulmonary vascular smooth muscle without causing systemic hypotension." },
            { q: "What respiratory condition is characterized by a \"patchy, asymmetric infiltrates with rope-like density\" and hyperinflation on chest X-ray?", a: "Meconium Aspiration Syndrome (MAS)." },
            { q: "What is the major mechanical complication of Meconium Aspiration Syndrome in the airway?", a: "A \"ball-valve\" effect leading to air trapping, subpleural emphysema, and high risk of pneumothorax." },
            { q: "What is the current standard management for a non-vigorous infant born through meconium-stained amniotic fluid?", a: "Direct routine resuscitation at the warmer under NRP guidelines (routine endotracheal suctioning is no longer recommended)." },
            { q: "What defines Apnea of Prematurity?", a: "Cessation of breathing for more than 20 seconds, or any pause accompanied by bradycardia or cyanosis in an infant $\\1$ weeks." },
            { q: "What is the first-line pharmacological treatment for Apnea of Prematurity?", a: "Caffeine citrate." },
            { q: "What is the mechanism of action of Caffeine Citrate in treating Apnea of Prematurity?", a: "Stimulates the central respiratory center in the medulla and increases medullary sensitivity to $CO_2$." },
            { q: "At what postmenstrual age does Apnea of Prematurity typically resolve spontaneously?", a: "Usually by 36 to 37 weeks postmenstrual age." },
            { q: "What underlying vascular complication of extreme prematurity is exacerbated by high, fluctuating oxygen saturations?", a: "Retinopathy of Prematurity (ROP)." },
            { q: "What is the pathophysiology of Retinopathy of Prematurity?", a: "Hyperoxia causes initial vessel vasoconstriction and cessation of growth, followed by hypoxia-driven abnormal neovascularization." },
            { q: "What is the screening timeline for Retinopathy of Prematurity?", a: "Infants born $\\le 30$ weeks gestation or weighing $<1500\\text{ g}$ should be screened at 4 weeks chronologic age or 31 weeks postmenstrual age (whichever is later)." },
            { q: "What cardiac lesion classically remains open due to chronic hypoxia and respiratory distress in preterm infants?", a: "Patent Ductus Arteriosus (PDA)." },
            { q: "What is the classic physical exam finding of a hemodynamically significant PDA?", a: "A continuous, machine-like murmur heard best at the left upper sternal border, accompanied by bounding peripheral pulses." },
            { q: "What is the standard first-line medical therapy to induce closure of a symptomatic PDA in a preterm infant?", a: "Cyclooxygenase (COX) inhibitors such as Indomethacin or Ibuprofen." },
            { q: "What is a major absolute contraindication to administering Indomethacin for PDA closure?", a: "Active necrotizing enterocolitis (NEC), significant renal impairment, or active bleeding." },
            { q: "What clinical tool is now widely recommended to determine the need for antibiotics in early-onset sepsis instead of empirical treatment based on risk factors alone?", a: "The Kaiser Permanente Neonatal Sepsis Risk Calculator." },
            { q: "What are the three main clinical categories evaluated by the Neonatal Sepsis Risk Calculator?", a: "Maternal risk factors, the infant's clinical status (well-appearing, equivocal, or critically ill), and hour-specific risk." },
            { q: "What is the significance of a high direct or band count on a neonatal differential without a change in total WBC?", a: "Left shift, indicating early bone marrow release of immature neutrophils in response to acute infection." },
            { q: "Why can severe neonatal sepsis cause a normal or even low total white blood cell count?", a: "Depletion of the bone marrow's limited neutrophil storage pool in the face of overwhelming infection." },
            { q: "What is the significance of a high serum lactate level in a neonate with suspected sepsis?", a: "Indicates tissue hypoperfusion and anaerobic metabolism, pointing toward septic shock." },
            { q: "What fluid volume bolus is recommended for a neonate in septic shock?", a: "$10\\text{ to }20 \\text{ mL/kg}$ of isotonic crystalloid (Normal Saline) administered slowly over 10-20 minutes." },
            { q: "Why should fluid boluses be delivered carefully in preterm neonates compared to older children?", a: "Rapid volume expansion can cause sudden shifts in cranial blood pressure, increasing the risk of Intraventricular Hemorrhage (IVH)." },
            { q: "What is the first-choice inotrope/vasopressor for neonatal fluid-refractory septic shock with low systemic vascular resistance?", a: "Dopamine or Epinephrine." },
            { q: "What viral infection should be suspected in a neonate with sepsis-like symptoms, negative bacterial cultures, and markedly elevated transaminases (AST/ALT)?", a: "Neonatal Herpes Simplex Virus (HSV) or Enterovirus." },
            { q: "What is the most common presentation of late-onset GBS infection?", a: "Meningitis (often presenting with irritability, fever, and focal neurological signs after week 1)." },
            { q: "Does maternal intrapartum antibiotic prophylaxis effectively prevent Late-Onset GBS disease?", a: "No, it only significantly reduces the incidence of Early-Onset GBS disease." },
            { q: "What metabolic disturbance can mimic the lethargy and poor feeding of neonatal sepsis in a small-for-gestational-age (SGA) infant?", a: "Neonatal polycythemia (hematocrit $>65\\\\%$) leading to hyperviscosity syndrome." },
            { q: "What is the definitive treatment for symptomatic neonatal polycythemia hyperviscosity syndrome?", a: "Partial exchange transfusion with normal saline." },
            { q: "What classic electrolyte abnormality is seen in neonatal sepsis due to temporary adrenal insufficiency or tissue damage?", a: "Hyponatremia or hyperkalemia." },
            { q: "What complication of neonatal central venous access lines increases the risk of fungal late-onset sepsis?", a: "Biofilm formation, most commonly by Candida albicans or Candida parapsilosis." },
            { q: "What is the preferred empiric treatment for documented systemic neonatal candidiasis?", a: "Amphotericin B deoxycholate." },
            { q: "Why is Amphotericin B exceptionally well-tolerated in neonates compared to adults?", a: "Neonates have lower baseline nephrotoxicity and structural differences in renal tubules that minimize damage." },
            { q: "What does an elevated cerebrospinal fluid (CSF) protein level without an elevated WBC count suggest in a neonate with neurological symptoms?", a: "Normal variant (neonates naturally have higher baseline CSF protein, up to $150\\text{ mg/dL}$ in preterms)." },
            { q: "What is the next diagnostic step if a neonate has persistently positive blood cultures 48 hours after starting appropriate antibiotics?", a: "Repeat the culture, check a lumbar puncture (if not done), and perform an echocardiogram or renal ultrasound to rule out an infectious focus (e.g., endocarditis or abscess)." },
            { q: "What is the primary criteria to discontinue empiric antibiotics in an asymptomatic infant evaluated for early-onset sepsis?", a: "Negative blood cultures at 36 to 48 hours of incubation." },
            { q: "What is the primary hazard of rapid, aggressive correction of profound chronic hyponatremia during exchange transfusion?", a: "Central pontine myelinolysis (Osmotic Demyelination Syndrome)." },
            { q: "Why does an infant with a large cephalohematoma have an increased risk of severe hyperbilirubinemia?", a: "Extravascular RBC destruction and breakdown of trapped hemoglobin increases the systemic bilirubin load." },
            { q: "Which congenital cardiac lesion is classically associated with an increased incidence of neonatal hyperbilirubinemia due to polycythemia?", a: "Infants of diabetic mothers or transposition of the great arteries." },
            { q: "What is the rule of thumb for when to initiate phototherapy based on a healthy term infant's age in hours?", a: "Use the AAP (American Academy of Pediatrics) nomogram, tracking risk zones based on hour-specific bilirubin levels." },
            { q: "What is the effect of maternal epidural anesthesia on neonatal jaundice?", a: "It can sometimes cause poor initial feeding, exacerbating breastfeeding jaundice." },
            { q: "What underlying structural liver anomaly must be ruled out in an infant presenting with clay-colored (acholic) stools?", a: "Biliary atresia." },
            { q: "What nutritional deficiency must be proactively managed in infants with chronic cholestatic jaundice?", a: "Deficiencies in fat-soluble vitamins (Vitamins A, D, E, K) due to poor bile acid-mediated micelle formation." },
            { q: "What is the significance of a \"double bubble\" sign on abdominal X-ray in a neonate with conjugated hyperbilirubinemia?", a: "Suggests Duodenal Atresia, classically associated with Down Syndrome, which also carries an increased risk of neonatal transient myeloproliferative disorder and cholestasis." },
            { q: "Why does hypothyroidism cause prolonged unconjugated hyperbilirubinemia?", a: "Hepatic glucuronide conjugation is delayed because thyroid hormone is required for UGT enzyme maturation." },
            { q: "What is the inheritance pattern of Crigler-Najjar Syndrome Type I?", a: "Autosomal recessive." },
            { q: "What is the inheritance pattern of Gilbert Syndrome?", a: "Autosomal recessive (most commonly a promoter mutation variant)." },
            { q: "What is the target pre-ductal oxygen saturation range for a preterm infant at 5 minutes of life?", a: "80% to 85% (per Neonatal Resuscitation Program/NRP guidelines)." },
            { q: "Where should a pulse oximeter probe be placed on a neonate to measure pre-ductal oxygen saturation?", a: "On the right wrist or palmar surface of the right hand." },
            { q: "What causes the difference between pre-ductal and post-ductal oxygen saturations in severe respiratory distress?", a: "Persistent Pulmonary Hypertension of the Newborn (PPHN) causing a right-to-left shunt across the patent ductus arteriosus (PDA)." },
            { q: "What is the definitive echocardiographic finding that confirms Persistent Pulmonary Hypertension of the Newborn (PPHN)?", a: "Right-to-left shunting through the PDA or foramen ovale, and flattened interventricular septum from high right ventricular pressures." },
            { q: "What is the first-line inhaled vasodilator therapy used for PPHN?", a: "Inhaled Nitric Oxide (iNO)." },
            { q: "What is the primary mechanism of action of Inhaled Nitric Oxide?", a: "Selectively relaxes pulmonary vascular smooth muscle without causing systemic hypotension." },
            { q: "What respiratory condition is characterized by a \"patchy, asymmetric infiltrates with rope-like density\" and hyperinflation on chest X-ray?", a: "Meconium Aspiration Syndrome (MAS)." },
            { q: "What is the major mechanical complication of Meconium Aspiration Syndrome in the airway?", a: "A \"ball-valve\" effect leading to air trapping, subpleural emphysema, and high risk of pneumothorax." },
            { q: "What is the current standard management for a non-vigorous infant born through meconium-stained amniotic fluid?", a: "Direct routine resuscitation at the warmer under NRP guidelines (routine endotracheal suctioning is no longer recommended)." },
            { q: "What defines Apnea of Prematurity?", a: "Cessation of breathing for more than 20 seconds, or any pause accompanied by bradycardia or cyanosis in an infant $\\1$ weeks." },
            { q: "What is the first-line pharmacological treatment for Apnea of Prematurity?", a: "Caffeine citrate." },
            { q: "What is the mechanism of action of Caffeine Citrate in treating Apnea of Prematurity?", a: "Stimulates the central respiratory center in the medulla and increases medullary sensitivity to $CO_2$." },
            { q: "At what postmenstrual age does Apnea of Prematurity typically resolve spontaneously?", a: "Usually by 36 to 37 weeks postmenstrual age." },
            { q: "What underlying vascular complication of extreme prematurity is exacerbated by high, fluctuating oxygen saturations?", a: "Retinopathy of Prematurity (ROP)." },
            { q: "What is the pathophysiology of Retinopathy of Prematurity?", a: "Hyperoxia causes initial vessel vasoconstriction and cessation of growth, followed by hypoxia-driven abnormal neovascularization." },
            { q: "What is the screening timeline for Retinopathy of Prematurity?", a: "Infants born $\\le 30$ weeks gestation or weighing $<1500\\text{ g}$ should be screened at 4 weeks chronologic age or 31 weeks postmenstrual age (whichever is later)." },
            { q: "What cardiac lesion classically remains open due to chronic hypoxia and respiratory distress in preterm infants?", a: "Patent Ductus Arteriosus (PDA)." },
            { q: "What is the classic physical exam finding of a hemodynamically significant PDA?", a: "A continuous, machine-like murmur heard best at the left upper sternal border, accompanied by bounding peripheral pulses." },
            { q: "What is the standard first-line medical therapy to induce closure of a symptomatic PDA in a preterm infant?", a: "Cyclooxygenase (COX) inhibitors such as Indomethacin or Ibuprofen." },
            { q: "What is a major absolute contraindication to administering Indomethacin for PDA closure?", a: "Active necrotizing enterocolitis (NEC), significant renal impairment, or active bleeding." },
            { q: "What clinical tool is now widely recommended to determine the need for antibiotics in early-onset sepsis instead of empirical treatment based on risk factors alone?", a: "The Kaiser Permanente Neonatal Sepsis Risk Calculator." },
            { q: "What are the three main clinical categories evaluated by the Neonatal Sepsis Risk Calculator?", a: "Maternal risk factors, the infant's clinical status (well-appearing, equivocal, or critically ill), and hour-specific risk." },
            { q: "What is the significance of a high direct or band count on a neonatal differential without a change in total WBC?", a: "Left shift, indicating early bone marrow release of immature neutrophils in response to acute infection." },
            { q: "Why can severe neonatal sepsis cause a normal or even low total white blood cell count?", a: "Depletion of the bone marrow's limited neutrophil storage pool in the face of overwhelming infection." },
            { q: "What is the significance of a high serum lactate level in a neonate with suspected sepsis?", a: "Indicates tissue hypoperfusion and anaerobic metabolism, pointing toward septic shock." },
            { q: "What fluid volume bolus is recommended for a neonate in septic shock?", a: "$10\\text{ to }20 \\text{ mL/kg}$ of isotonic crystalloid (Normal Saline) administered slowly over 10-20 minutes." },
            { q: "Why should fluid boluses be delivered carefully in preterm neonates compared to older children?", a: "Rapid volume expansion can cause sudden shifts in cranial blood pressure, increasing the risk of Intraventricular Hemorrhage (IVH)." },
            { q: "What is the first-choice inotrope/vasopressor for neonatal fluid-refractive septic shock with low systemic vascular resistance?", a: "Dopamine or Epinephrine." },
            { q: "What viral infection should be suspected in a neonate with sepsis-like symptoms, negative bacterial cultures, and markedly elevated transaminases (AST/ALT)?", a: "Neonatal Herpes Simplex Virus (HSV) or Enterovirus." },
            { q: "What is the most common presentation of late-onset GBS infection?", a: "Meningitis (often presenting with irritability, fever, and focal neurological signs after week 1)." },
            { q: "Does maternal intrapartum antibiotic prophylaxis effectively prevent Late-Onset GBS disease?", a: "No, it only significantly reduces the incidence of Early-Onset GBS disease." },
            { q: "What metabolic disturbance can mimic the lethargy and poor feeding of neonatal sepsis in a small-for-gestational-age (SGA) infant?", a: "Neonatal polycythemia (hematocrit $>65\\\\%$) leading to hyperviscosity syndrome." },
            { q: "What is the definitive treatment for symptomatic neonatal polycythemia hyperviscosity syndrome?", a: "Partial exchange transfusion with normal saline." },
            { q: "What classic electrolyte abnormality is seen in neonatal sepsis due to temporary adrenal insufficiency or tissue damage?", a: "Hyponatremia or hyperkalemia." },
            { q: "What complication of neonatal central venous access lines increases the risk of fungal late-onset sepsis?", a: "Biofilm formation, most commonly by Candida albicans or Candida parapsilosis." },
            { q: "What is the preferred empiric treatment for documented systemic neonatal candidiasis?", a: "Amphotericin B deoxycholate." },
            { q: "Why is Amphotericin B exceptionally well-tolerated in neonates compared to adults?", a: "Neonates have lower baseline nephrotoxicity and structural differences in renal tubules that minimize damage." },
            { q: "What does an elevated cerebrospinal fluid (CSF) protein level without an elevated WBC count suggest in a neonate with neurological symptoms?", a: "Normal variant (neonates naturally have higher baseline CSF protein, up to $150\\text{ mg/dL}$ in preterms)." },
            { q: "What is the next diagnostic step if a neonate has persistently positive blood cultures 48 hours after starting appropriate antibiotics?", a: "Repeat the culture, check a lumbar puncture (if not done), and perform an echocardiogram or renal ultrasound to rule out an infectious focus (e.g., endocarditis or abscess)." },
            { q: "What is the primary criteria to discontinue empiric antibiotics in an asymptomatic infant evaluated for early-onset sepsis?", a: "Negative blood cultures at 36 to 48 hours of incubation." },
            { q: "Why does a neonate with Congenital Hypothyroidism display prolonged unconjugated hyperbilirubinemia?", a: "Hepatic glucuronide conjugation is delayed because thyroid hormone is required for the structural maturation of hepatic UGT1A1." },
            { q: "What rare, life-threatening metabolic cause of conjugated hyperbilirubinemia presents with vomiting, hypoglycemia, and cataracts after introduction of milk?", a: "Galactosemia (Galactose-1-phosphate uridyltransferase deficiency)." },
            { q: "Why are infants with Galactosemia at a vastly increased risk for Early-Onset Neonatal Sepsis?", a: "High systemic galactose concentrations inhibit leukocyte bactericidal activity, predisposing them specifically to Escherichia coli sepsis." },
            { q: "What feature on a liver biopsy distinguishes Dubin-Johnson Syndrome from Rotor Syndrome in a neonate with direct hyperbilirubinemia?", a: "A dark-brown/black pigmented liver due to epinephrine metabolite accumulation is present in Dubin-Johnson but completely absent in Rotor Syndrome." },
            { q: "What genetic mutation confirms Alagille Syndrome in a neonate presenting with cholestasis, butterfly vertebrae, and a harsh systolic murmur?", a: "Mutation in the JAG1 or NOTCH2 gene resulting in paucity of interlobular bile ducts." },
            { q: "What is the primary diagnostic utility of a Technetium-99m hepatobiliary iminodiacetic acid (HIDA) scan in a 3-week-old with direct hyperbilirubinemia?", a: "Failure of the radiotracer to excrete into the duodenum after 24 hours strongly supports a diagnosis of Biliary Atresia over neonatal hepatitis." },
            { q: "What medical therapy can be used to stimulate bile flow in infants experiencing Total Parenteral Nutrition (TPN)-induced cholestasis?", a: "Ursodeoxycholic acid (Ursodiol)." },
            { q: "Why does a Coombs-negative hemolytic anemia with Heinz bodies and bite cells on a peripheral smear point to G6PD deficiency during a jaundice workup?", a: "Heinz bodies represent denatured hemoglobin from oxidative stress, which are subsequently \"bitten\" out by splenic macrophages." },
            { q: "What is the critical total serum bilirubin threshold level above which a term infant is at immediate risk for acute bilirubin encephalopathy?", a: "Typically greater than or equal to 25 to 30 mg/dL, depending on the infant’s hourly age and risk factors." },
            { q: "What specific ocular manifestation is seen in neonates with severe Type 1 Tyrosinemia causing conjugated hyperbilirubinemia?", a: "Corneal ulcers or crystalline corneal plaques (due to tyrosine crystal deposition)." },
            { q: "What structural component of the alveolus collapses first when there is a genetic deficiency of Surfactant Protein B (SP-B)?", a: "The terminal alveolar air-spaces, causing fatal, refractory respiratory failure at birth despite exogenous surfactant treatment." },
            { q: "What rare congenital structural anomaly mimics severe RDS but presents with a scaphoid abdomen and bowel sounds heard in the chest?", a: "Congenital Diaphragmatic Hernia (CDH)." },
            { q: "What is the immediate, non-negotiable delivery room management for an infant born with a known Congenital Diaphragmatic Hernia?", a: "Immediate endotracheal intubation and mechanical ventilation (avoid bag-valve-mask ventilation to prevent gastric distension and lung compression)." },
            { q: "What respiratory syndrome presents identically to RDS on day one but occurs in a term infant born via scheduled Cesarean delivery?", a: "Transient Tachypnea of the Newborn (TTN)." },
            { q: "What specific fluid-clearance mechanism fails in Transient Tachypnea of the Newborn (TTN)?", a: "Delayed activation of epithelial sodium channels ($ENaC$) which normally reabsorb fetal lung fluid during labor." },
            { q: "What chest X-ray finding definitively differentiates Meconium Aspiration Syndrome (MAS) from classic RDS?", a: "MAS shows asymmetric, patchy infiltrates with lung hyperinflation and flattened diaphragms, whereas RDS shows symmetric, diffuse ground-glass opacities with low lung volumes." },
            { q: "What is the primary pulmonary vascular consequence of severe, chronic tissue hypoxia in an infant with Meconium Aspiration Syndrome?", a: "Persistent Pulmonary Hypertension of the Newborn (PPHN) due to reactive pulmonary vasoconstriction." },
            { q: "What diagnostic test confirms a right-to-left shunt in a neonate suspected of having PPHN?", a: "Simultaneous pre-ductal (right hand) and post-ductal (either foot) arterial blood gas or pulse oximetry showing a $PaO_2$ gradient $>10-15\\text{ mmHg}$ or an $SpO_2$ difference $>5-10\\\\%$." },
            { q: "What chronic structural remodeling occurs in the pulmonary vasculature during prolonged, unresolved PPHN?", a: "Hypertrophy and hyperplasia of the smooth muscle layer of pulmonary arterioles." },
            { q: "Why does maternal use of Selective Serotonin Reuptake Inhibitors (SSRIs) late in pregnancy increase the risk of neonatal PPHN?", a: "Accumulation of serotonin in the fetal lung can act as a direct pulmonary vasoconstrictor and alter vascular remodeling." },
            { q: "What is the primary mechanism of action of Sildenafil when used as an adjunctive treatment for neonatal pulmonary hypertension?", a: "Inhibits phosphodiesterase-5 (PDE-5), preventing the breakdown of cyclic GMP ($cGMP$) to promote pulmonary smooth muscle relaxation." },
            { q: "What mechanical ventilator strategy is optimized to minimize barotrauma in an infant with severe, non-compliant RDS failing conventional ventilation?", a: "High-Frequency Oscillatory Ventilation (HFOV) or High-Frequency Jet Ventilation (HFJV)." },
            { q: "What is the primary mechanism of gas exchange during High-Frequency Oscillatory Ventilation (HFOV)?", a: "Continuous alveolar recruitment via a constant mean airway pressure, paired with rapid, sub-anatomical dead-space tidal volume oscillations." },
            { q: "Why do neonates have an impaired ability to localize infections, making them highly susceptible to rapid systemic bacteremia?", a: "They possess deficient chemotaxis of neutrophils and low levels of circulating complement proteins (C3 and C4)." },
            { q: "What specific bacterial virulence factor allows neonatal Escherichia coli strains to selectively cross the blood-brain barrier to cause meningitis?", a: "The K1 capsular polysaccharide antigen." },
            { q: "Why is the absolute neutrophil count (ANC) often completely unreliable in the first 4 hours of life when screening for Early-Onset Sepsis?", a: "Normal physiological delivery-stress causes a transient, dramatic surge in the ANC immediately after birth." },
            { q: "What does a persistently low or dropping platelet count in a neonate being treated for sepsis indicate?", a: "Ongoing consumptive coagulopathy (Disseminated Intravascular Coagulation/DIC) or persistent endotoxemia." },
            { q: "What is the definitive, standard criteria for a positive cerebrospinal fluid (CSF) culture to rule out sample contamination in neonatal meningitis?", a: "Growth of a single pathogenic organism within 24 to 48 hours of incubation." },
            { q: "Why is a lumbar puncture mandatory in any neonate with a positive blood culture, even if they look clinically stable?", a: "Up to 15-30% of neonates with bacteremia have concurrent meningitis, and treating meningitis requires significantly higher doses and a longer duration of antibiotics." },
            { q: "What is the standard duration of antibiotic therapy for uncomplicated neonatal bacteremia versus confirmed GBS meningitis?", a: "7 to 10 days for uncomplicated bacteremia; 14 to 21 days for bacterial meningitis." },
            { q: "Why must Aminoglycoside (Gentamicin) serum levels be carefully tracked via peak and trough monitoring in neonates?", a: "High troughs increase the risk of nephrotoxicity (acute tubular necrosis), while inadequate peaks result in treatment failure due to insufficient bactericidal activity." },
            { q: "What is the first-line empiric antibiotic choice for a neonate presenting with late-onset sepsis who has an indwelling central venous catheter?", a: "Vancomycin (to cover Coagulase-Negative Staphylococci and MRSA) combined with an antipseudomonal aminoglycoside or cephalosporin." },
            { q: "What severe systemic complication arises if a neonate with underlying septic shock develops profound, bilateral adrenal hemorrhage?", a: "Waterhouse-Friderichsen Syndrome, leading to acute adrenal crisis and refractory hypotension." },
            { q: "What stress-dose hormone therapy is indicated for a neonate with septic shock that remains completely refractory to both volume resuscitation and high-dose vasopressors?", a: "Intravenous Hydrocortisone (to treat relative adrenal insufficiency)." },
            { q: "What specific clinical criteria from the Neonatal Sepsis Risk Calculator automatically mandates immediate empiric antibiotic therapy, regardless of maternal risk history?", a: "A clinical status classification of \"Clinically Ill\" (defined as persistent respiratory distress, hypotonia, lethargy, or poor perfusion)." },
            { q: "What classic, benign skin condition can be mistaken for a septic vesicular rash but is characterized by eosinophils on a Wright-stained pustule smear?", a: "Erythema Toxicum Neonatorum." },
            { q: "What dermatological finding in a neonate with sepsis suggests systemic Pseudomonas aeruginosa infection?", a: "Ecthyma gangrenosum (pustules that rapidly progress to necrotic, ulcerated lesions with central black eschars)." },
            { q: "What classic intracranial ultrasound finding is seen in a neonate who survived severe, late-onset bacterial meningitis?", a: "Encephalomalacia, porencephaly, or ventricular septation (leading to obstructive hydrocephalus)." },
            { q: "What is the most common long-term neurodevelopmental disability seen in infants who survive neonatal sepsis combined with severe RDS?", a: "Cerebral palsy, often accompanied by varying degrees of cognitive impairment or sensorineural hearing loss." },
            { q: "Why does profound metabolic acidosis ($pH < 7.1$) in a septic neonate drastically impair cardiac contractility?", a: "Severe acidemia alters intracellular calcium availability and blunts myocardial responsiveness to endogenous and exogenous catecholamines." },
            { q: "Why does a neonate with Congenital Hypothyroidism display prolonged unconjugated hyperbilirubinemia?", a: "Hepatic glucuronide conjugation is delayed because thyroid hormone is required for the structural maturation of hepatic UGT1A1." },
            { q: "What rare, life-threatening metabolic cause of conjugated hyperbilirubinemia presents with vomiting, hypoglycemia, and cataracts after introduction of milk?", a: "Galactosemia (Galactose-1-phosphate uridyltransferase deficiency)." },
            { q: "Why are infants with Galactosemia at a vastly increased risk for Early-Onset Neonatal Sepsis?", a: "High systemic galactose concentrations inhibit leukocyte bactericidal activity, predisposing them specifically to Escherichia coli sepsis." },
            { q: "What feature on a liver biopsy distinguishes Dubin-Johnson Syndrome from Rotor Syndrome in a neonate with direct hyperbilirubinemia?", a: "A dark-brown/black pigmented liver due to epinephrine metabolite accumulation is present in Dubin-Johnson but completely absent in Rotor Syndrome." },
            { q: "What genetic mutation confirms Alagille Syndrome in a neonate presenting with cholestasis, butterfly vertebrae, and a harsh systolic murmur?", a: "Mutation in the JAG1 or NOTCH2 gene resulting in paucity of interlobular bile ducts." },
            { q: "What is the primary diagnostic utility of a Technetium-99m hepatobiliary iminodiacetic acid (HIDA) scan in a 3-week-old with direct hyperbilirubinemia?", a: "Failure of the radiotracer to excrete into the duodenum after 24 hours strongly supports a diagnosis of Biliary Atresia over neonatal hepatitis." },
            { q: "What medical therapy can be used to stimulate bile flow in infants experiencing Total Parenteral Nutrition (TPN)-induced cholestasis?", a: "Ursodeoxycholic acid (Ursodiol)." },
            { q: "Why does a Coombs-negative hemolytic anemia with Heinz bodies and bite cells on a peripheral smear point to G6PD deficiency during a jaundice workup?", a: "Heinz bodies represent denatured hemoglobin from oxidative stress, which are subsequently \"bitten\" out by splenic macrophages." },
            { q: "What is the critical total serum bilirubin threshold level above which a term infant is at immediate risk for acute bilirubin encephalopathy?", a: "Typically greater than or equal to 25 to 30 mg/dL, depending on the infant’s hourly age and risk factors." },
            { q: "What specific ocular manifestation is seen in neonates with severe Type 1 Tyrosinemia causing conjugated hyperbilirubinemia?", a: "Corneal ulcers or crystalline corneal plaques (due to tyrosine crystal deposition)." },
            { q: "What structural component of the alveolus collapses first when there is a genetic deficiency of Surfactant Protein B (SP-B)?", a: "The terminal alveolar air-spaces, causing fatal, refractory respiratory failure at birth despite exogenous surfactant treatment." },
            { q: "What rare congenital structural anomaly mimics severe RDS but presents with a scaphoid abdomen and bowel sounds heard in the chest?", a: "Congenital Diaphragmatic Hernia (CDH)." },
            { q: "What is the immediate, non-negotiable delivery room management for an infant born with a known Congenital Diaphragmatic Hernia?", a: "Immediate endotracheal intubation and mechanical ventilation (avoid bag-valve-mask ventilation to prevent gastric distension and lung compression)." },
            { q: "What respiratory syndrome presents identically to RDS on day one but occurs in a term infant born via scheduled Cesarean delivery?", a: "Transient Tachypnea of the Newborn (TTN)." },
            { q: "What specific fluid-clearance mechanism fails in Transient Tachypnea of the Newborn (TTN)?", a: "Delayed activation of epithelial sodium channels ($ENaC$) which normally reabsorb fetal lung fluid during labor." },
            { q: "What chest X-ray finding definitively differentiates Meconium Aspiration Syndrome (MAS) from classic RDS?", a: "MAS shows asymmetric, patchy infiltrates with lung hyperinflation and flattened diaphragms, whereas RDS shows symmetric, diffuse ground-glass opacities with low lung volumes." },
            { q: "What is the primary pulmonary vascular consequence of severe, chronic tissue hypoxia in an infant with Meconium Aspiration Syndrome?", a: "Persistent Pulmonary Hypertension of the Newborn (PPHN) due to reactive pulmonary vasoconstriction." },
            { q: "What diagnostic test confirms a right-to-left shunt in a neonate suspected of having PPHN?", a: "Simultaneous pre-ductal (right hand) and post-ductal (either foot) arterial blood gas or pulse oximetry showing a $PaO_2$ gradient $>10-15\\text{ mmHg}$ or an $SpO_2$ difference $>5-10\\\\%$." },
            { q: "What chronic structural remodeling occurs in the pulmonary vasculature during prolonged, unresolved PPHN?", a: "Hypertrophy and hyperplasia of the smooth muscle layer of pulmonary arterioles." },
            { q: "Why does maternal use of Selective Serotonin Reuptake Inhibitors (SSRIs) late in pregnancy increase the risk of neonatal PPHN?", a: "Accumulation of serotonin in the fetal lung can act as a direct pulmonary vasoconstrictor and alter vascular remodeling." },
            { q: "What is the primary mechanism of action of Sildenafil when used as an adjunctive treatment for neonatal pulmonary hypertension?", a: "Inhibits phosphodiesterase-5 (PDE-5), preventing the breakdown of cyclic GMP ($cGMP$) to promote pulmonary smooth muscle relaxation." },
            { q: "What mechanical ventilator strategy is optimized to minimize barotrauma in an infant with severe, non-compliant RDS failing conventional ventilation?", a: "High-Frequency Oscillatory Ventilation (HFOV) or High-Frequency Jet Ventilation (HFJV)." },
            { q: "What is the primary mechanism of gas exchange during High-Frequency Oscillatory Ventilation (HFOV)?", a: "Continuous alveolar recruitment via a constant mean airway pressure, paired with rapid, sub-anatomical dead-space tidal volume oscillations." },
            { q: "Why do neonates have an impaired ability to localize infections, making them highly susceptible to rapid systemic bacteremia?", a: "They possess deficient chemotaxis of neutrophils and low levels of circulating complement proteins (C3 and C4)." },
            { q: "What specific bacterial virulence factor allows neonatal Escherichia coli strains to selectively cross the blood-brain barrier to cause meningitis?", a: "The K1 capsular polysaccharide antigen." },
            { q: "Why is the absolute neutrophil count (ANC) often completely unreliable in the first 4 hours of life when screening for Early-Onset Sepsis?", a: "Normal physiological delivery-stress causes a transient, dramatic surge in the ANC immediately after birth." },
            { q: "What does a persistently low or dropping platelet count in a neonate being treated for sepsis indicate?", a: "Ongoing consumptive coagulopathy (Disseminated Intravascular Coagulation/DIC) or persistent endotoxemia." },
            { q: "What is the definitive, standard criteria for a positive cerebrospinal fluid (CSF) culture to rule out sample contamination in neonatal meningitis?", a: "Growth of a single pathogenic organism within 24 to 48 hours of incubation." },
            { q: "Why is a lumbar puncture mandatory in any neonate with a positive blood culture, even if they look clinically stable?", a: "Up to 15-30% of neonates with bacteremia have concurrent meningitis, and treating meningitis requires significantly higher doses and a longer duration of antibiotics." },
            { q: "What is the standard duration of antibiotic therapy for uncomplicated neonatal bacteremia versus confirmed GBS meningitis?", a: "7 to 10 days for uncomplicated bacteremia; 14 to 21 days for bacterial meningitis." },
            { q: "Why must Aminoglycoside (Gentamicin) serum levels be carefully tracked via peak and trough monitoring in neonates?", a: "High troughs increase the risk of nephrotoxicity (acute tubular necrosis), while inadequate peaks result in treatment failure due to insufficient bactericidal activity." },
            { q: "What is the first-line empiric antibiotic choice for a neonate presenting with late-onset sepsis who has an indwelling central venous catheter?", a: "Vancomycin (to cover Coagulase-Negative Staphylococci and MRSA) combined with an antipseudomonal aminoglycoside or cephalosporin." },
            { q: "What severe systemic complication arises if a neonate with underlying septic shock develops profound, bilateral adrenal hemorrhage?", a: "Waterhouse-Friderichsen Syndrome, leading to acute adrenal crisis and refractory hypotension." },
            { q: "What stress-dose hormone therapy is indicated for a neonate with septic shock that remains completely refractory to both volume resuscitation and high-dose vasopressors?", a: "Intravenous Hydrocortisone (to treat relative adrenal insufficiency)." },
            { q: "What specific clinical criteria from the Neonatal Sepsis Risk Calculator automatically mandates immediate empiric antibiotic therapy, regardless of maternal risk history?", a: "A clinical status classification of \"Clinically Ill\" (defined as persistent respiratory distress, hypotonia, lethargy, or poor perfusion)." },
            { q: "What classic, benign skin condition can be mistaken for a septic vesicular rash but is characterized by eosinophils on a Wright-stained pustule smear?", a: "Erythema Toxicum Neonatorum." },
            { q: "What dermatological finding in a neonate with sepsis suggests systemic Pseudomonas aeruginosa infection?", a: "Ecthyma gangrenosum (pustules that rapidly progress to necrotic, ulcerated lesions with central black eschars)." },
            { q: "What classic intracranial ultrasound finding is seen in a neonate who survived severe, late-onset bacterial meningitis?", a: "Encephalomalacia, porencephaly, or ventricular septation (leading to obstructive hydrocephalus)." },
            { q: "What is the most common long-term neurodevelopmental disability seen in infants who survive neonatal sepsis combined with severe RDS?", a: "Cerebral palsy, often accompanied by varying degrees of cognitive impairment or sensorineural hearing loss." },
            { q: "Why does profound metabolic acidosis ($pH < 7.1$) in a septic neonate drastically impair cardiac contractility?", a: "Severe acidemia alters intracellular calcium availability and blunts myocardial responsiveness to endogenous and exogenous catecholamines." }
          ]
        },
{
          section: 'Pediatrics (Introductory)',
          topic: "Common pediatric infections — otitis, RSV, meningitis",
          icon: 'baby',
          cards: [
            { q: "Most common bacterial pathogen isolated in Acute Otitis Media (AOM)?", a: "Streptococcus pneumoniae." },
            { q: "Two most common non-typeable bacterial pathogens in AOM after S. pneumoniae?", a: "Non-typeable Haemophilus influenzae and Moraxella catarrhalis." },
            { q: "Bacterial pathogen most likely to cause bilateral AOM concurrent with purulent conjunctivitis?", a: "Non-typeable Haemophilus influenzae (Otitis-Conjunctivitis Syndrome)." },
            { q: "Primary viral pathogens predisposed to causing secondary AOM?", a: "Respiratory Syncytial Virus (RSV) and Influenza virus." },
            { q: "Gold standard physical exam finding required to diagnose AOM?", a: "Bulging of the tympanic membrane with impaired mobility on pneumatic otoscopy." },
            { q: "Color change of the tympanic membrane most indicative of acute infection in AOM?", a: "Distinct erythema or pale yellow/cloudy discoloration behind the membrane." },
            { q: "Meaning of a flat, non-mobile tympanogram (Type B) on tympanometry?", a: "Presence of fluid in the middle ear space (effusion)." },
            { q: "Defining clinical feature that differentiates Otitis Media with Effusion (OME) from AOM?", a: "OME has middle ear effusion without signs of acute inflammation or systemic illness." },
            { q: "Standard first-line antibiotic choice for pediatric AOM without penicillin allergy?", a: "High-dose Amoxicillin (80 to 90 mg/kg/day)." },
            { q: "Rationale for using high-dose Amoxicillin in treating pediatric AOM?", a: "To overcome penicillin-binding protein resistance in Streptococcus pneumoniae." },
            { q: "Preferred initial antibiotic for AOM if the child has concurrent purulent conjunctivitis?", a: "Amoxicillin-Clavulanate (Augmentin) to cover $\\beta$-lactamase producing H. influenzae." },
            { q: "Preferred initial antibiotic for AOM if the patient received amoxicillin in the past 30 days?", a: "Amoxicillin-Clavulanate." },
            { q: "Alternative oral antibiotic choice for AOM in a patient with a non-anaphylactic penicillin allergy?", a: "Cefdinir, Cefuroxime, or Cefpodoxime (second or third-generation cephalosporins)." },
            { q: "Alternative antibiotic therapy for AOM in a patient with an anaphylactic penicillin allergy?", a: "Azithromycin or Clindamycin." },
            { q: "First-line parenteral treatment for AOM in a child unable to tolerate oral medications?", a: "Intramuscular Ceftriaxone (1 to 3 daily doses)." },
            { q: "Strict criteria for \"watchful waiting\" (observation without antibiotics) in pediatric AOM?", a: "Age 6 to 23 months with unilateral, mild symptoms, or age over 2 years with mild symptoms." },
            { q: "Minimum age below which all patients with certain or suspected AOM must receive immediate antibiotics?", a: "Six months of age." },
            { q: "Recommended duration of antibiotic therapy for AOM in children under two years of age?", a: "10 days." },
            { q: "Recommended duration of antibiotic therapy for AOM in children aged six years or older with mild symptoms?", a: "5 to 7 days." },
            { q: "Most common intracranial complication of poorly treated Acute Otitis Media?", a: "Meningitis." },
            { q: "Most common extracranial, bony complication of Acute Otitis Media?", a: "Acute Mastoiditis." },
            { q: "Classic physical exam finding in a child presenting with Acute Mastoiditis?", a: "Displacement of the pinna downward and outward with postauricular erythema and tenderness." },
            { q: "Initial diagnostic imaging modality of choice for suspected mastoiditis or intracranial extension?", a: "CT scan of the temporal bones with contrast." },
            { q: "Defining feature of Chronic Otitis Media with Effusion?", a: "Middle ear effusion persisting for 3 months or longer." },
            { q: "Standard management for asymptomatic Otitis Media with Effusion noted after an episode of AOM?", a: "Clinical observation and reassurance, as most cases resolve spontaneously within 3 months." },
            { q: "Absolute indication for tympanostomy tube insertion in chronic OME?", a: "Effusion persisting for 3 or more months with documented structural damage or bilateral hearing loss." },
            { q: "Clinical criteria for tympanostomy tube placement due to recurrent AOM?", a: "3 or more distinct episodes in 6 months, or 4 or more episodes in 12 months with at least one in the preceding 6 months." },
            { q: "First-line treatment for uncomplicated otorrhea in a child with functional tympanostomy tubes?", a: "Topical antibiotic eardrops (e.g., Fluoroquinolones) rather than systemic oral antibiotics." },
            { q: "Pathophysiologic mechanism underlying Otitis Media with Effusion in children with cleft palate?", a: "Tensor veli palatini muscle dysfunction leading to chronic Eustachian tube obstruction." },
            { q: "Classic otoscopic finding associated with Bullous Myringitis?", a: "Fluid-filled blisters or vesicles visible on the surface of the tympanic membrane." },
            { q: "Most common clinical manifestation of primary Respiratory Syncytial Virus (RSV) infection in infants under one year old?", a: "Bronchiolitis." },
            { q: "Peak age range for severe RSV bronchiolitis manifestations in infants?", a: "2 to 6 months of age." },
            { q: "Primary pathophysiologic mechanism of airway obstruction in RSV bronchiolitis?", a: "Necrosis of airway epithelium, inflammatory mucus plugging, and submucosal edema in the bronchioles." },
            { q: "Classic initial upper respiratory symptoms of RSV infection before lower tract involvement?", a: "Clear rhinorrhea, sneezing, and a low-grade fever." },
            { q: "Standard auscultatory findings on lung examination during the peak of RSV bronchiolitis?", a: "Diffuse, high-pitched expiratory wheezing and scattered fine crackles throughout both lung fields." },
            { q: "Visual physical exam signs indicative of severe respiratory distress in an infant with RSV?", a: "Intercostal, subcostal, and suprasternal retractions, along with nasal flaring and expiratory grunting." },
            { q: "Life-threatening respiratory symptom that can be the presenting sign of RSV in premature infants?", a: "Apnea." },
            { q: "Standard method of confirming RSV diagnosis in a hospitalized patient?", a: "Polymerase Chain Reaction (PCR) assay or rapid antigen detection from a nasopharyngeal aspirate." },
            { q: "Typical chest radiograph findings in an infant with classic RSV bronchiolitis?", a: "Bilateral hyperinflation, flattened diaphragms, peribronchial cuffing, and patchy areas of atelectasis." },
            { q: "Role of routine chest radiography in the evaluation of mild, uncomplicated pediatric bronchiolitis?", a: "Not routinely recommended, as it often leads to inappropriate antibiotic use for atelectasis misidentified as pneumonia." },
            { q: "Cornerstone of management for an infant admitted with typical RSV bronchiolitis?", a: "Supportive care, including frequent nasopharyngeal suctioning, supplemental oxygen, and hydration." },
            { q: "Primary indication for hospital admission in an infant with RSV bronchiolitis?", a: "Persistent hypoxemia (oxygen saturation below 90 to 92%), respiratory distress, or inadequate oral hydration." },
            { q: "Role of systemic or inhaled corticosteroids in the routine management of RSV bronchiolitis?", a: "Not recommended, as clinical trials show no benefit in reducing hospitalization or improving clinical scores." },
            { q: "Role of bronchodilators (e.g., Albuterol) in the routine treatment of a first episode of bronchiolitis?", a: "Not recommended routinely due to lack of impact on disease course or hospital stay duration." },
            { q: "Only definitive clinical scenario where a trial of nebulized epinephrine might be evaluated in bronchiolitis?", a: "As a rescue trial in a hospital setting, discontinued immediately if no objective clinical improvement is documented." },
            { q: "Preferred method of hydration for a tachypneic infant with bronchiolitis and a respiratory rate over 60 to 70 breaths per minute?", a: "Intravenous fluids or nasogastric tube feeding to minimize the high risk of aspiration." },
            { q: "Target oxygen saturation parameter for discontinuing supplemental oxygen in a recovering bronchiolitis patient?", a: "Stable oxygen saturation at or above 90% on room air during periods of awake activity and sleep." },
            { q: "Monoclonal antibody used for immunoprophylaxis against RSV in high-risk infants?", a: "Palivizumab." },
            { q: "Absolute candidate group for Palivizumab prophylaxis during their first RSV season?", a: "Infants born before 29 weeks of gestation." },
            { q: "Chronic medical condition qualifying an infant under 12 months for Palivizumab prophylaxis?", a: "Chronic Lung Disease of prematurity requiring medical intervention within six months of the RSV season." },
            { q: "Maximum number of monthly doses of Palivizumab recommended during a single RSV season?", a: "Five monthly doses." },
            { q: "Preventive immunization option for pregnant individuals to protect newborns from severe RSV?", a: "RSV prefusion F protein vaccine (Abrysvo) administered between 32 and 36 weeks of gestation." },
            { q: "Long-acting monoclonal antibody recommended for all infants under 8 months entering their first RSV season?", a: "Nirsevimab." },
            { q: "Most common long-term pulmonary sequela observed in children who had severe RSV bronchiolitis in infancy?", a: "Recurrent wheezing episodes and an increased risk of childhood asthma." },
            { q: "Primary mode of transmission for Respiratory Syncytial Virus in healthcare settings?", a: "Large-particle droplets and fomites via direct contact with contaminated surfaces or hands." },
            { q: "Essential infection control precautions required for a patient hospitalized with RSV?", a: "Contact and Droplet precautions." },
            { q: "Acid-base disturbance typically seen on a blood gas in an infant with impending respiratory failure from RSV?", a: "Respiratory acidosis due to profound alveolar hypoventilation and carbon dioxide retention." },
            { q: "Definition of a positive response to a trial of hypertonic saline nebulization in bronchiolitis?", a: "Reduced length of hospital stay in infants, though its routine emergency department use remains controversial." },
            { q: "Specific antiviral agent reserved exclusively for severe, life-threatening RSV in highly immunocompromised patients?", a: "Ribavirin (administered via aerosol)." },
            { q: "Typical incubation period for Respiratory Syncytial Virus after exposure?", a: "4 to 6 days." },
            { q: "Most common bacterial pathogen causing meningitis in neonates (0 to 28 days old)?", a: "Group B Streptococcus (Streptococcus agalactiae)." },
            { q: "Second and third most common bacterial pathogens causing neonatal meningitis?", a: "Escherichia coli (and other Gram-negative bacilli) and Listeria monocytogenes." },
            { q: "Most common bacterial pathogen causing meningitis in infants and children over 1 month of age?", a: "Streptococcus pneumoniae." },
            { q: "Bacterial pathogen responsible for meningitis outbreaks in college dorms or military barracks, characterized by a rapid purpuric rash?", a: "Neisseria meningitidis." },
            { q: "Classic triad of symptoms seen in older children and adults with bacterial meningitis?", a: "Fever, headache, and nuchal rigidity (stiff neck)." },
            { q: "Definition of Kernig sign?", a: "Resistance or pain upon extension of the patient's knee when the hip is flexed at a 90-degree angle." },
            { q: "Definition of Brudzinski sign?", a: "Involuntary flexion of the patient's hips and knees when the neck is passively flexed forward." },
            { q: "Why are Kernig and Brudzinski signs frequently absent in infants under 12 months with meningitis?", a: "Due to the immature development of neuromuscular reflexes and lack of meningeal stretch response at that age." },
            { q: "Most reliable clinical signs of meningitis in a young infant under 3 months?", a: "Hypothermia or fever, paradoxically increased irritability when held, lethargy, poor feeding, and a bulging fontanelle." },
            { q: "Definitive diagnostic procedure required to confirm or rule out suspected pediatric meningitis?", a: "Lumbar puncture for cerebrospinal fluid (CSF) analysis." },
            { q: "Absolute clinical contraindications to performing an immediate lumbar puncture in a suspected meningitis patient?", a: "Signs of increased intracranial pressure (papilledema, unequal pupils), focal neurologic deficits, or cardiopulmonary instability." },
            { q: "Immediate course of action if a lumbar puncture must be delayed due to clinical instability or focal deficits?", a: "Obtain blood cultures and immediately administer empiric intravenous antibiotics." },
            { q: "Typical CSF opening pressure finding in acute bacterial meningitis?", a: "Elevated (usually greater than 200 mm $\\text{H}_2\\text{O}$)." },
            { q: "Typical CSF white blood cell count and differential in bacterial meningitis?", a: "Markedly elevated WBC count (often $\\1$/microL) with a strong predominance of polymorphonuclear neutrophils (PMNs)." },
            { q: "Typical CSF glucose concentration relative to serum glucose in bacterial meningitis?", a: "Significantly decreased, with a CSF-to-serum glucose ratio of less than 0.4." },
            { q: "Typical CSF protein concentration finding in bacterial meningitis?", a: "Markedly elevated (often $\\1$ mg/dL) due to increased blood-brain barrier permeability." },
            { q: "Typical CSF findings in Viral (Aseptic) Meningitis?", a: "Normal glucose, normal to mildly elevated protein, and mildly elevated WBCs with lymphocytic predominance." },
            { q: "Most common viral etiology responsible for aseptic meningitis in pediatric patients?", a: "Enteroviruses (such as Coxsackievirus and Echovirus)." },
            { q: "Diagnostic utility of adding a CSF Gram stain during workup?", a: "Rapidly identifies the bacterial morphology and guides tailored antibiotic choice ahead of culture results." },
            { q: "Standard empiric antibiotic regimen for a neonate (under 28 days) with suspected bacterial meningitis?", a: "Ampicillin plus Cefotaxime (or Ampicillin plus an Aminoglycoside like Gentamicin)." },
            { q: "Why is Ceftriaxone strictly avoided in neonates requiring empiric treatment for meningitis?", a: "It displaces bilirubin from albumin, increasing the risk of kernicterus, and can precipitate with IV calcium." },
            { q: "Standard empiric antibiotic regimen for a child over 1 month of age with suspected bacterial meningitis?", a: "Vancomycin plus a third-generation cephalosporin (Ceftriaxone or Cefotaxime)." },
            { q: "Purpose of adding Vancomycin to the empiric meningitis regimen for children over 1 month?", a: "To provide coverage for highly penicillin-resistant strains of Streptococcus pneumoniae." },
            { q: "Purpose of adding Ampicillin specifically to the neonatal empiric meningitis regimen?", a: "To provide mandatory coverage for Listeria monocytogenes." },
            { q: "Specific adjunctive medication shown to reduce the risk of sensorineural hearing loss in children with H. influenzae type b meningitis?", a: "Dexamethasone." },
            { q: "Optimal timing for administering the first dose of adjunctive Dexamethasone in pediatric bacterial meningitis?", a: "Prior to or concurrently with the first dose of intravenous antibiotics." },
            { q: "Most common long-term sensorineural complication resulting from childhood bacterial meningitis?", a: "Sensorineural hearing loss (due to labyrinthitis ossificans)." },
            { q: "Electrolyte abnormality frequently caused by inappropriate antidiuretic hormone secretion (SIADH) during bacterial meningitis?", a: "Hyponatremia." },
            { q: "Immediate management step required for close household contacts of a patient diagnosed with Neisseria meningitidis?", a: "Chemoprophylaxis with Rifampin, Ciprofloxacin, or Ceftriaxone." },
            { q: "Indication for cranial imaging (CT or MRI) during the course of treating bacterial meningitis?", a: "Persistent fever after 72 hours of appropriate therapy, new focal neurologic deficits, or enlarging head circumference." },
            { q: "First step in the PALS pediatric assessment triangle?", a: "Appearance (evaluating muscle tone, interactiveness, and consolability)." },
            { q: "Second step in the PALS pediatric assessment triangle?", a: "Work of Breathing (evaluating retractions, stridor, wheezing, or nasal flaring)." },
            { q: "Third step in the PALS pediatric assessment triangle?", a: "Circulation to Skin (evaluating pallor, mottling, or cyanosis)." },
            { q: "Definition of a normal capillary refill time in a well-perfused pediatric patient?", a: "Two seconds or less." },
            { q: "Definition of bradycardia requiring chest compressions in an infant or child with compromised perfusion despite oxygenation?", a: "Heart rate less than 60 beats per minute." },
            { q: "Standard compression-to-ventilation ratio for two-rescuer pediatric CPR?", a: "15 compressions to 2 ventilations." },
            { q: "Standard compression-to-ventilation ratio for single-rescuer pediatric CPR?", a: "30 compressions to 2 ventilations." },
            { q: "Preferred location for checking a pulse in an unresponsive infant under one year of age?", a: "Brachial artery." },
            { q: "Preferred location for checking a pulse in an unresponsive child over one year of age?", a: "Carotid or femoral artery." },
            { q: "Recommended depth of chest compressions during CPR for an infant?", a: "At least one-third the anterior-posterior diameter of the chest, or approximately 1.5 inches (4 cm)." },
            { q: "Recommended depth of chest compressions during CPR for a child?", a: "At least one-third the anterior-posterior diameter of the chest, or approximately 2 inches (5 cm)." },
            { q: "Correct energy dose for the first shock during pediatric defibrillation for a shockable rhythm?", a: "2 Joules per kilogram ($2\\text{ J/kg}$)." },
            { q: "Correct energy dose for the second and subsequent shocks during pediatric defibrillation?", a: "4 Joules per kilogram ($4\\text{ J/kg}$)." },
            { q: "Maximum recommended single energy dose for pediatric defibrillation?", a: "10 Joules per kilogram ($10\\text{ J/kg}$) or the standard adult dose." },
            { q: "First-line medication and dose administered for pediatric cardiac arrest or symptomatic bradycardia?", a: "Epinephrine at a dose of 0.01 mg/kg ($0.1\\text{ mL/kg}$ of the 0.1 mg/mL concentration) intravenously or intraosseously." },
            { q: "Preferred fluid type and initial volume bolus size recommended for a pediatric patient in hypovolemic or septic shock?", a: "20 mL/kg of an isotonic crystalloid fluid (e.g., Normal Saline or Lactated Ringer's)." },
            { q: "Primary alternative vascular access method if intravenous access cannot be rapidly established in an unstable child?", a: "Intraosseous (IO) access." },
            { q: "Classic dermatologic description of the rash seen in meningococcemia according to the Zitelli Atlas?", a: "Non-blanching, petechial or purpuric lesions that can rapidly coalesce into purpura fulminans." },
            { q: "Distinction between a blanching rash and a non-blanching rash on physical exam?", a: "A non-blanching rash (petechiae/purpura) does not fade or turn white when pressure is applied, indicating extravasated blood." },
            { q: "Classic otoscopic appearance of Tympanosclerosis in the Zitelli Atlas?", a: "Chalky white plaques or patches embedded within the tympanic membrane, representing organized collagen and calcium deposits." },
            { q: "Significance of finding isolated tympanosclerosis patches on an asymptomatic child's ear exam?", a: "Benign finding usually indicating a history of recurrent otitis media or prior tympanostomy tube placement." },
            { q: "Physical sign on a child's face indicating chronic mouth breathing secondary to adenoid hypertrophy?", a: "\"Adenoid facies,\" characterized by an elongated face, open mouth, prominent upper incisors, and a pinched nose." },
            { q: "Visual appearance of the tympanic membrane in a patient with a Cholesteatoma?", a: "A pearly white, keratinous mass typically located in the posterosuperior quadrant of the tympanic membrane or pars flaccida." },
            { q: "Primary clinical danger associated with an untreated middle ear Cholesteatoma?", a: "Progressive bone destruction of the ossicles and mastoid, leading to permanent hearing loss or intracranial entry." },
            { q: "Classic chest X-ray sign seen in children with croup (laryngotracheobronchitis) as a differential for respiratory distress?", a: "The \"Steeple Sign,\" representing subglottic narrowing of the airway." },
            { q: "Defining physical exam feature that distinguishes a simple febrile seizure from a complex febrile seizure?", a: "Simple febrile seizures are generalized, last less than 15 minutes, and do not recur within 24 hours." },
            { q: "Defining physical exam feature of a complex febrile seizure?", a: "Focal onset, duration greater than 15 minutes, or multiple occurrences within a single 24-hour period." },
            { q: "Age range in which febrile seizures typically occur?", a: "6 months to 5 years of age." },
            { q: "Primary management strategy for a child presenting with a brief, self-limiting, simple febrile seizure?", a: "Standard antipyretics for comfort and thorough reassurance of the parents, without routine neuroimaging or antiepileptic drugs." },
            { q: "Pathogen responsible for Ramsay Hunt Syndrome affecting the ear and facial nerves?", a: "Varicella-Zoster Virus (VZV) reactivation." },
            { q: "Ear finding that distinguishes a traumatic tympanic membrane perforation from an infectious perforation?", a: "Traumatic perforations show ragged, linear edges with minimal inflammation, whereas infectious perforations show a hyperemic, inflamed membrane with purulent discharge." },
            { q: "Why is high-dose Amoxicillin ineffective against Mycoplasma pneumoniae lower respiratory infections?", a: "Mycoplasma species lack a peptidoglycan cell wall, making them inherently resistant to all $\\beta$-lactam antibiotics." },
            { q: "Preferred class of antibiotics for treating atypical pneumonia caused by Mycoplasma pneumoniae?", a: "Macrolides (e.g., Azithromycin)." },
            { q: "Diagnostic criteria for recurrent respiratory papillomatosis of the larynx, an uncommon differential for chronic stridor?", a: "Visualization of raspberry-like, exophytic growths on the vocal cords via laryngoscopy, caused by HPV types 6 or 11." },
            { q: "Most accurate clinical indicator of proper endotracheal tube placement in a pediatric resuscitation setting?", a: "Presence of persistent waveform capnography showing bilateral chest expansion and equal breath sounds." },
            { q: "Why is the respiratory rate faster in neonates and infants compared to older children?", a: "Infants have high metabolic demands and low pulmonary compliance, making them dependent on respiratory rate rather than tidal volume to alter minute ventilation." },
            { q: "Primary mechanism of hypoxemia in a child with severe RSV bronchiolitis?", a: "Ventilation-perfusion (V/Q) mismatch caused by widespread mucous plugging and atelectasis." },
            { q: "CSF parameter that remains most useful for diagnosing bacterial meningitis if antibiotics were given shortly before the lumbar puncture?", a: "Multiplex PCR testing or CSF cultures (though cultures are less sensitive post-antibiotics, PCR often remains positive)." },
            { q: "Characteristic feature of a \"traumatic tap\" during a lumbar puncture compared to true bacterial meningitis?", a: "Clearance of red blood cells from the first to the last tube collected, and a normal CSF glucose ratio." },
            { q: "Preferred treatment for a child with symptomatic, culture-confirmed H. influenzae type b meningitis?", a: "Intravenous Ceftriaxone or Cefotaxime for 7 to 10 days." },
            { q: "Recommended duration of antibiotic treatment for uncomplicated Streptococcus pneumoniae meningitis?", a: "10 to 14 days." },
            { q: "Recommended duration of antibiotic treatment for uncomplicated Neisseria meningitidis meningitis?", a: "5 to 7 days." },
            { q: "Standard duration of antibiotic treatment for Gram-negative bacillary meningitis in neonates?", a: "Minimum of 21 days, or 14 days beyond the first negative CSF culture." },
            { q: "Most likely diagnosis for an infant presenting with high fever for 3 days that drops abruptly, followed by the appearance of a maculopapular rash?", a: "Roseola Infantum (Exanthem Subitum), caused by Human Herpesvirus 6 (HHV-6)." },
            { q: "Serious complication of Neisseria meningitidis infection involving acute adrenal gland failure?", a: "Waterhouse-Friderichsen Syndrome (hemorrhagic adrenal infarction)." },
            { q: "Expected appearance of a normal tympanic membrane on pneumatic otoscopy?", a: "Translucent, pearly gray membrane that moves briskly inward with positive pressure and outward with negative pressure." },
            { q: "Recommended approach for managing a localized serous fluid level behind a non-inflamed tympanic membrane 2 weeks after an AOM episode?", a: "Watchful waiting, as post-AOM effusion takes up to 4 to 12 weeks to clear completely in many children." },
            { q: "Cardinal sign of Gradenigo Syndrome, a rare complication of otitis media?", a: "Triad of otorrhea, deep facial pain in the distribution of the trigeminal nerve, and abducens nerve (CN VI) palsy." },
            { q: "Initial empirical treatment for an infant with suspected bacterial meningitis who has an absolute contraindication to cephalosporins?", a: "Intravenous Meropenem plus Vancomycin." },
            { q: "Anatomical difference in the pediatric Eustachian tube that predisposes young children to recurrent AOM?", a: "The tube is shorter, wider, and oriented more horizontally than in adults, facilitating the reflux of nasopharyngeal pathogens into the middle ear." },
            { q: "Diagnostic criteria for Chronic Suppurative Otitis Media (CSOM)?", a: "Persistent purulent otorrhea through a perforated tympanic membrane lasting longer than 6 to 12 weeks." },
            { q: "Primary bacterial pathogens isolated in Chronic Suppurative Otitis Media?", a: "Pseudomonas aeruginosa and Staphylococcus aureus." },
            { q: "Recommended initial treatment for uncomplicated Chronic Suppurative Otitis Media?", a: "Topical fluoroquinolone drops combined with regular aural toilet (suctioning/cleaning)." },
            { q: "Distinctive clinical presentation of Otitis Media with ANCA-associated vasculitis or granulomatosis with polyangiitis?", a: "Intractable otitis media unresponsive to standard antibiotics, accompanied by progressive sensorineural hearing loss and facial nerve palsy." },
            { q: "Pathophysiology of Bezold abscess as a complication of acute mastoiditis?", a: "Perforation of the mastoid cortex allowing pus to track into the sheath of the sternocleidomastoid muscle." },
            { q: "Most common cranial nerve palsy associated with acute mastoiditis or severe AOM?", a: "Facial nerve (Cranial Nerve VII) palsy due to inflammation within the Fallopian canal." },
            { q: "Definitive management for an AOM patient presenting with acute facial nerve palsy?", a: "Urgent myringotomy with or without tympanostomy tube insertion, along with intravenous antibiotics." },
            { q: "Condition characterized by bluish discoloration behind an intact tympanic membrane without acute infection signs?", a: "Hemotympanum, typically secondary to temporal bone fracture or head trauma." },
            { q: "Visual presentation of a retraction pocket on otoscopy according to the Zitelli Atlas?", a: "The tympanic membrane is sucked inward, collapsing onto the ossicles, most frequently in the posterosuperior quadrant." },
            { q: "Primary environmental risk factors that significantly increase a child's susceptibility to recurrent AOM?", a: "Exposure to secondhand tobacco smoke, daycare attendance, lack of breastfeeding, and pacifier use after six months of age." },
            { q: "Most common cardiac condition predisposing an infant to high-risk, severe RSV bronchiolitis?", a: "Hemodynamically significant congenital heart disease, particularly acyanotic lesions with pulmonary hypertension." },
            { q: "Rare, severe complication of RSV in infants involving sudden, profound neurological changes?", a: "RSV-associated encephalopathy, presenting with seizures or altered mental status." },
            { q: "Primary reason routine chest physiotherapy (percussion and postural drainage) is avoided in RSV bronchiolitis?", a: "It has been shown to increase distress and chest wall pain without improving clinical outcomes or shortening hospital stays." },
            { q: "Expected laboratory finding on a complete blood count (CBC) during a typical RSV infection?", a: "Normal white blood cell count or mild leukocytosis with a lymphocytic predominance, matching standard viral patterns." },
            { q: "Most common bacterial pathogen isolated when secondary bacterial pneumonia complicates RSV bronchiolitis?", a: "Streptococcus pneumoniae or Staphylococcus aureus." },
            { q: "Pathogen causing \"Swelling of the epiglottis\" which must be differentiated from severe RSV or croup in an unimmunized child?", a: "Haemophilus influenzae type b (causing acute Epiglottitis)." },
            { q: "Classic lateral neck X-ray finding in a child with acute epiglottitis?", a: "The \"Thumbprint Sign,\" representing a swollen, enlarged epiglottis." },
            { q: "Initial step in the management of a child with suspected epiglottitis?", a: "Maintain the child in a position of comfort and urgently transfer to the operating room for controlled intubation." },
            { q: "Diagnostic differentiation between RSV bronchiolitis and Chlamydia trachomatis pneumonia in an 8-week-old infant?", a: "Chlamydia presents with a staccato cough, eosinophilia, and absence of fever, often with a history of neonatal conjunctivitis." },
            { q: "Rationale for avoiding routine use of humidified mist tents (cool mist therapy) in RSV bronchiolitis management?", a: "Clinical studies have shown no objective improvement in respiratory scores or oxygenation parameters." },
            { q: "Most common cause of recurrent bacterial meningitis in children with a history of head trauma?", a: "Anatomical CSF leak or dural defect, most frequently tracking Streptococcus pneumoniae." },
            { q: "Rare condition involving a congenital dermal sinus tract extending into the spinal cord that predisposes to recurrent meningitis?", a: "Spina Bifida Occulta or spinal dysraphism." },
            { q: "CSF profile characteristic of Tuberculous Meningitis?", a: "Markedly elevated protein, significantly low glucose, and moderate pleocytosis with a distinct lymphocytic predominance." },
            { q: "Anatomical predilection of Tuberculous Meningitis exudates inside the brain?", a: "Thick exudates concentrate around the base of the brain (basilar meningitis), frequently causing cranial nerve palsies." },
            { q: "Diagnosis for a child with fever, headache, altered mental status, and focal neurological signs with temporal lobe localized lesions on MRI?", a: "Herpes Simplex Virus (HSV) Encephalitis." },
            { q: "Preferred first-line empirical antiviral treatment for suspected neonatal HSV meningitis or encephalitis?", a: "High-dose intravenous Acyclovir ($20\\text{ mg/kg}$ every 8 hours)." },
            { q: "Most common vector-borne viral etiology of pediatric meningoencephalitis in the United States?", a: "West Nile Virus (or other Arboviruses like La Crosse Encephalitis)." },
            { q: "Pathophysiologic mechanism driving cerebral edema during acute bacterial meningitis?", a: "Combination of cytotoxic edema (cell swelling), vasogenic edema (leaky blood-brain barrier), and interstitial edema (obstructed CSF outflow)." },
            { q: "Long-term ophthalmic complication that can occur secondary to untreated elevated intracranial pressure in bacterial meningitis?", a: "Optic atrophy or cortical blindness." },
            { q: "Definition of \"Waterhouse-Friderichsen Syndrome\" associated with meningococcemia?", a: "Severe hemorrhagic necrosis of the adrenal glands leading to acute adrenal insufficiency and profound refractory shock." },
            { q: "Defining difference between \"compensated shock\" and \"hypotensive (decompensated) shock\" in a pediatric patient?", a: "Compensated shock maintains a normal systolic blood pressure via tachycardia and vasoconstriction, whereas hypotensive shock shows a blood pressure below the 5th percentile for age." },
            { q: "Formula used to calculate the lower limit of acceptable systolic blood pressure (5th percentile) for a child aged 1 to 10 years?", a: "$70\\text{ mmHg} + (2 \\times \\text{age in years})$." },
            { q: "Formula used to calculate the lower limit of acceptable systolic blood pressure for a term neonate (0 to 28 days)?", a: "Less than $60\\text{ mmHg}$." },
            { q: "Preferred initial intraosseous (IO) access insertion site in a pediatric resuscitation setting?", a: "Proximal tibia, approximately 1 to 2 cm distal to the tibial tuberosity on the flat medial surface." },
            { q: "Primary sign of successful fluid resuscitation in a child presenting with hypovolemic shock?", a: "Decrease in heart rate, improvement in mental status, normal capillary refill time, and an increase in urine output to greater than $1\\text{ mL/kg/hour}$." },
            { q: "First-line medication and intervention strategy for a pediatric patient with documented Torsades de Pointes?", a: "Intravenous Magnesium Sulfate ($25\\text{ to }50\\text{ mg/kg}$)." },
            { q: "Target dose of Amiodarone for refractory Pulseless Ventricular Fibrillation or Ventricular Tachycardia in PALS?", a: "$5\\text{ mg/kg}$ intravenous or intraosseous bolus (may repeat up to 3 times)." },
            { q: "Most common non-traumatic cause of cardiac arrest in the pediatric population?", a: "Progressive respiratory failure or asphyxia leading to bradycardia and asystole (hypoxic-ischemic arrest)." },
            { q: "Primary physiologic hazard associated with hyperventilating a pediatric patient during CPR?", a: "Increased intrathoracic pressure, which decreases venous return to the heart, dropping cardiac output and cerebral perfusion." },
            { q: "Action taken in PALS if a pediatric patient displays organized electrical activity on the monitor but lacks a palpable pulse?", a: "Diagnose Pulseless Electrical Activity (PEA) and immediately resume chest compressions while administering Epinephrine every 3 to 5 minutes." },
            { q: "Diagnosis for a 4-year-old child with an painful, swollen, erythematous earlobe following an insect bite, with an intact, normal tympanic membrane?", a: "Cellulitis of the external ear (perichondritis if sparing the lobule)." },
            { q: "Key physical exam feature distinguishing perichondritis from generalized pinna cellulitis?", a: "Perichondritis strictly spares the earlobe, as the lobe lacks underlying cartilage." },
            { q: "Rationale behind performing an urgent ophthalmologic exam (fundoscopy) in a stable child with chronic papilledema post-meningitis?", a: "To evaluate for chronic increased intracranial pressure and rule out early optic nerve atrophy." },
            { q: "Most likely diagnosis for a child who presents with sudden onset of unilateral wheezing and decreased breath sounds, without viral prodrome or fever?", a: "Foreign body aspiration." },
            { q: "Why are systemic aminoglycosides (e.g., Gentamicin monotherapy) inappropriate for treating localized bacterial meningitis?", a: "Aminoglycosides have poor penetration through the blood-brain barrier into the cerebrospinal fluid, even when meninges are inflamed." },
            { q: "Preferred diagnostic test to screen for localized hearing loss in an infant under 6 months of age post-meningitis?", a: "Auditory Brainstem Response (ABR) testing." },
            { q: "Recommended screening test for hearing loss in a child older than 6 months of age who is developmentally appropriate?", a: "Visual Reinforcement Audiometry (VRA) or conditioned play audiometry." },
            { q: "Diagnosis for an infant presenting with typical signs of meningitis who also exhibits a direct Coombs-positive hemolytic anemia and hepatosplenomegaly?", a: "Congenital Syphilis complicating neonatal presentation." },
            { q: "Primary reason why the influenza vaccine is highly recommended as a preventative strategy against AOM in young children?", a: "Preventing the primary viral upper respiratory tract infection significantly reduces secondary bacterial Eustachian tube dysfunction and subsequent AOM." },
            { q: "Expected CSF profile in a patient with Guillain-Barré Syndrome, a common neurological differential for weakness post-viral illness?", a: "Albuminocytologic dissociation (markedly elevated protein concentration with a completely normal white blood cell count)." },
            { q: "Pathogen responsible for Malignant Otitis Externa, a severe differential for ear pain in immunocompromised or diabetic pediatric patients?", a: "Pseudomonas aeruginosa." },
            { q: "Distinctive physical exam finding in Malignant Otitis Externa according to the Zitelli Atlas?", a: "Granulation tissue visible on the floor of the external auditory canal at the osteocartilaginous junction." },
            { q: "Preferred initial antibiotic treatment for a child diagnosed with Malignant Otitis Externa?", a: "Intravenous antipseudomonal antibiotics (e.g., Cefepime or Piperacillin-Tazobactam)." },
            { q: "Diagnostic criteria for Acute Otitis Media failure, prompting a switch to second-line antibiotics?", a: "Lack of clinical improvement (persistent fever, ear pain, or worsening bulging) after 48 to 72 hours of initial antibiotic therapy." },
            { q: "Standard second-line oral antibiotic choice for AOM after failure of initial high-dose Amoxicillin?", a: "High-dose Amoxicillin-Clavulanate (Augmentin formatted at a 14:1 ratio to minimize diarrhea)." },
            { q: "Definition of a \"dry perforation\" of the tympanic membrane?", a: "A persistent hole in the tympanic membrane without current signs of active middle ear infection or otorrhea." },
            { q: "Standard management strategy for an isolated, asymptomatic, small traumatic tympanic membrane perforation?", a: "Watchful waiting, as the majority of small traumatic perforations heal spontaneously within 4 to 6 weeks." },
            { q: "Primary surgical procedure performed concurrently with tympanostomy tube placement if a child has chronic adenoiditis or nasal obstruction?", a: "Adenoidectomy." },
            { q: "Specific cranial nerve examined to evaluate for suspected Gradenigo Syndrome?", a: "Abducens Nerve (Cranial Nerve VI), assessed by checking for lateral rectus palsy and diplopia on lateral gaze." },
            { q: "Most accurate method to clinically distinguish severe Otitis Externa (Swimmer's Ear) from Acute Otitis Media on physical exam?", a: "Extreme pain elicited by manipulating the tragus or pulling the pinna upward, which is absent in isolated AOM." },
            { q: "Primary physiological reason infants are obligate nasal breathers, making RSV-induced nasal congestion life-threatening?", a: "The infant tongue is large relative to the oral cavity, and the epiglottis sits higher in the pharynx, making oral breathing highly inefficient." },
            { q: "Consequence of severe intercostal and subcostal retractions on an infant's work of breathing over time?", a: "Progressive respiratory muscle fatigue leading to respiratory failure and cardiac arrest." },
            { q: "Underlying reason why an infant with severe RSV bronchiolitis might present with a normal $PaCO_2$ on an initial blood gas but still be in danger?", a: "A normal $PaCO_2$ in a severely tachypneic, tiring infant indicates impending respiratory failure, as they can no longer sustain the work required to hyperventilate." },
            { q: "Most common non-infectious condition that mimics the recurrent wheezing patterns seen after an initial RSV infection?", a: "Gastroesophageal Reflux Disease (GERD) causing microaspiration." },
            { q: "Specific laboratory test used to differentiate between a viral flare of bronchiolitis and a secondary bacterial infection in a toxic-appearing infant?", a: "Serum Procalcitonin or C-Reactive Protein (CRP) levels, which elevate significantly in bacterial infections compared to viral infections." },
            { q: "Recommended isolation protocol variant required if an RSV patient is also co-infected with Adenovirus?", a: "Addition of strict Droplet and Eye protection precautions, as Adenovirus is highly contagious via conjunctival secretions." },
            { q: "Why is the use of dynamic chest physiotherapy strictly discouraged in the PALS guidelines for acute bronchiolitis?", a: "It does not improve oxygenation or clear peripheral airway secretions, and it increases the risk of rib fractures and bronchial spasms." },
            { q: "Long-term pulmonary function abnormality characteristically found on spirometry years after a severe RSV infection?", a: "Obstructive lung pattern with reduced $FEV_1/FVC$ ratio and air trapping." },
            { q: "Indication for introducing Non-Invasive Positive Pressure Ventilation (NIPPV/CPAP) in an infant with worsening RSV bronchiolitis?", a: "Persistent hypoxemia despite high-flow supplemental oxygen, severe retractions, or a rising $PaCO_2$ with increased work of breathing." },
            { q: "Only specific patient population where aerosolized Ribavirin should actively be considered for RSV lower respiratory tract disease?", a: "Severe, life-threatening RSV infection in highly immunocompromised hosts, such as recent bone marrow transplant recipients." },
            { q: "Most common source of transmission for early-onset neonatal Group B Streptococcus meningitis?", a: "Vertical transmission from the maternal genital tract during labor and delivery." },
            { q: "Most common source of transmission for late-onset neonatal Group B Streptococcus meningitis (occurring 7 to 90 days postpartum)?", a: "Horizontal transmission from healthcare workers, community contacts, or maternal skin." },
            { q: "Specific Gram stain morphology characteristic of Streptococcus pneumoniae isolated from CSF?", a: "Gram-positive, lancet-shaped diplococci." },
            { q: "Specific Gram stain morphology characteristic of Neisseria meningitidis isolated from CSF?", a: "Gram-negative, kidney bean-shaped diplococci." },
            { q: "Specific Gram stain morphology characteristic of Haemophilus influenzae isolated from CSF?", a: "Gram-negative coccobacilli." },
            { q: "Specific Gram stain morphology characteristic of Listeria monocytogenes isolated from CSF?", a: "Gram-positive rods or coccobacilli exhibiting characteristic tumbling motility in fluid cultures." },
            { q: "Primary rationale for performing an urgent head ultrasound in a neonate with confirmed bacterial meningitis?", a: "To screen for early intraventricular hemorrhage, ventriculitis, or widening of the extra-axial spaces before fontanelle closure." },
            { q: "Classic neuroimaging finding on a contrast-enhanced brain MRI during active bacterial meningitis?", a: "Diffuse leptomeningeal enhancement tracking along the cerebral sulci and basilar cisterns." },
            { q: "Definitive management step for a child who develops a localized brain abscess as a complication of Citrobacter koseri neonatal meningitis?", a: "Prolonged intravenous antibiotic therapy (6 to 8 weeks) combined with neurosurgical aspiration or drainage." },
            { q: "Expected CSF profile changes in a patient with a partially treated bacterial meningitis (antibiotics given 2 hours before lumbar puncture)?", a: "Neutrophilic pleocytosis and low glucose persist, but CSF Gram stain and culture sensitivity decrease significantly." },
            { q: "Minimum acceptable systolic blood pressure (lower limit) for a child aged 1 month to 1 year?", a: "Less than $70\\text{ mmHg}$." },
            { q: "Target heart rate range for an infant under 1 year old experiencing symptomatic sinus tachycardia during a stress response?", a: "Typically less than $220\\text{ beats per minute}$ (SVT is suspected if greater than $220\\text{ bpm}$)." },
            { q: "Target heart rate range for a child over 1 year old experiencing symptomatic sinus tachycardia?", a: "Typically less than $180\\text{ beats per minute}$ (SVT is suspected if greater than $180\\text{ bpm}$)." },
            { q: "Definitive PALS intervention for a pediatric patient with Supraventricular Tachycardia (SVT) who is hemodynamically unstable?", a: "Immediate synchronized cardioversion at an initial dose of $0.5\\text{ to }1\\text{ J/kg}$." },
            { q: "First-line pharmacological treatment for a hemodynamically stable pediatric patient with confirmed SVT?", a: "Adenosine administered as a rapid intravenous push ($0.1\\text{ mg/kg}$, maximum first dose $6\\text{ mg}$)." },
            { q: "Primary hazard of utilizing a standard uncuffed endotracheal tube in a pediatric patient requiring high airway pressures?", a: "Large air leaks around the larynx, resulting in hypoventilation and inaccurate tidal volume monitoring." },
            { q: "Recommended method to calculate the appropriate internal diameter size for a cuffed endotracheal tube in a child aged 2 to 10 years?", a: "$(\\text{Age in years} / 4) + 3.5$." },
            { q: "Recommended method to calculate the appropriate internal diameter size for an uncuffed endotracheal tube in a child aged 2 to 10 years?", a: "$(\\text{Age in years} / 4) + 4$." },
            { q: "Preferred initial vasoactive medication infusion for a pediatric patient in warm (hyperdynamic) septic shock?", a: "Norepinephrine infusion (to correct profound systemic vasodilation)." },
            { q: "Preferred initial vasoactive medication infusion for a pediatric patient in cold (hypodynamic) septic shock with low cardiac output?", a: "Epinephrine infusion (to leverage potent inotropic and chronotropic effects)." },
            { q: "Visual presentation of Koplik spots according to the Zitelli Atlas, which must be differentiated from oral lesions of enteroviral meningitis?", a: "Small, bluish-white spots on an erythematous background located on the buccal mucosa opposite the lower molars (pathognomonic for Measles)." },
            { q: "Condition characterized by a high fever, severe inspiratory stridor, and a preference to sit leaning forward with the neck extended (tripod position)?", a: "Acute Epiglottitis." },
            { q: "Visual description of \"shagreen patches\" and \"ash-leaf spots\" on a child's skin according to the Zitelli Atlas, pointing to a disease that causes infantile spasms mimicking meningitis?", a: "Tuberous Sclerosis." },
            { q: "Most common cause of structural conductive hearing loss identified in children with a history of recurrent, severe AOM episodes?", a: "Ossicular chain discontinuity or fixation secondary to chronic inflammation." },
            { q: "Expected physical exam finding when performing the Rinne test on a child with significant conductive hearing loss from chronic OME?", a: "Bone conduction is heard longer than or equal to air conduction (Negative Rinne test)." },
            { q: "Expected physical exam finding when performing the Weber test on a child with unilateral conductive hearing loss in the right ear?", a: "The sound lateralizes specifically to the right ear." },
            { q: "Expected physical exam finding when performing the Weber test on a child with unilateral sensorineural hearing loss in the right ear?", a: "The sound lateralizes specifically to the left ear (the unaffected ear)." },
            { q: "Diagnostic criteria for a toxic-appearing child with fever, a barking cough, and thick, purulent tracheal secretions unresponsive to nebulized epinephrine?", a: "Bacterial Tracheitis (most commonly caused by Staphylococcus aureus)." },
            { q: "Primary treatment approach for a child diagnosed with confirmed Bacterial Tracheitis?", a: "Urgent airway stabilization under anesthesia combined with intravenous broad-spectrum antibiotics." },
            { q: "Condition characterized by a bulging, erythematous tympanic membrane with a distinct dark purple or black hue behind it in a newborn?", a: "Neonatal vascular anomaly or vascular tumor of the middle ear (e.g., glomus tympanicum), which must be differentiated from acute infectious otitis." }
          ]
        },
{
          section: 'Pediatrics (Introductory)',
          topic: "Pediatric vaccines & preventive care",
          icon: 'baby',
          cards: [
            { q: "Minimum age for the first dose of the Hepatitis B vaccine?", a: "Birth (ideally within 24 hours of delivery)." },
            { q: "Minimum age required to administer the Rotavirus vaccine?", a: "6 weeks." },
            { q: "Maximum age for the first dose of the Rotavirus vaccine?", a: "14 weeks and 6 days." },
            { q: "Maximum age for the final dose of the Rotavirus vaccine?", a: "8 months and 0 days." },
            { q: "Routine ages for the 5-dose DTaP vaccine series?", a: "2 months, 4 months, 6 months, 15–18 months, and 4–6 years." },
            { q: "Age at which the Tdap booster is routinely recommended?", a: "11–12 years." },
            { q: "Routine ages for the 4-dose Haemophilus influenzae type b (Hib) series?", a: "2 months, 4 months, 6 months, and 12–15 months." },
            { q: "Routine ages for the 4-dose Pneumococcal Conjugate (PCV15/PCV20) series?", a: "2 months, 4 months, 6 months, and 12–15 months." },
            { q: "Routine ages for the 4-dose Inactivated Poliovirus (IPV) series?", a: "2 months, 4 months, 6–18 months, and 4–6 years." },
            { q: "Minimum age to initiate the annual Influenza vaccine?", a: "6 months." },
            { q: "Requirement for children aged 6 months to 8 years receiving the Influenza vaccine for the first time?", a: "Two doses separated by at least 4 weeks." },
            { q: "Routine ages for the 2-dose Measles, Mumps, and Rubella (MMR) series?", a: "12–15 months and 4–6 years." },
            { q: "Minimum interval between the first and second doses of the MMR vaccine?", a: "4 weeks." },
            { q: "Routine ages for the 2-dose Varicella series?", a: "12–15 months and 4–6 years." },
            { q: "Routine ages for the 2-dose Hepatitis A series?", a: "12–23 months, with the two doses separated by at least 6 months." },
            { q: "Routine age to initiate the 2-dose Human Papillomavirus (HPV) series?", a: "11–12 years (can start as early as age 9)." },
            { q: "Dosing schedule for HPV vaccine if initiated at or after age 15?", a: "3 doses at 0, 1–2, and 6 months." },
            { q: "Routine ages for the 2-dose Meningococcal ACWY (MenACWY) series?", a: "11–12 years and a booster at age 16." },
            { q: "Route of administration for MMR, Varicella, and MMRV vaccines?", a: "Subcutaneous (SQ)." },
            { q: "Route of administration for DTaP, Hib, HepA, HepB, PCV, and MenACWY?", a: "Intramuscular (IM)." },
            { q: "Route of administration for Rotavirus vaccines?", a: "Oral (PO)." },
            { q: "Preferred IM injection site for infants and toddlers ($\\1$ years old)?", a: "Anterolateral aspect of the thigh (Vastus lateralis muscle)." },
            { q: "Preferred IM injection site for older children and adolescents (≥3 years old)?", a: "Deltoid muscle." },
            { q: "Only absolute contraindication to all vaccines?", a: "Severe allergic reaction (e.g., anaphylaxis) after a previous dose or to a vaccine component." },
            { q: "General rule for vaccinating a child with a mild acute illness (e.g., low-grade fever, mild otitis media, cold)?", a: "Vaccinate as scheduled; mild illness is not a contraindication." },
            { q: "General contraindication for all live-attenuated vaccines (MMR, Varicella, Rotavirus, LAIV)?", a: "Severe immunodeficiency (e.g., advanced HIV, chemotherapy, high-dose systemic steroids)." },
            { q: "Absolute contraindication specific to the Rotavirus vaccine?", a: "History of intussusception or severe combined immunodeficiency (SCID)." },
            { q: "Specific contraindication to the DTaP vaccine regarding the central nervous system?", a: "Encephalopathy within 7 days of a previous pertussis-containing vaccine dose." },
            { q: "Precaution for DTaP concerning neurological stability?", a: "Progressive or unstable neurological disorders (e.g., uncontrolled epilepsy) until the condition stabilizes." },
            { q: "Length of time to delay live vaccines after receiving intravenous immunoglobulin (IVIG) or packed red blood cells?", a: "3 to 11 months, depending on the specific blood product and dose." },
            { q: "Maximum daily dose and duration of systemic prednisone that allows for immediate administration of live vaccines?", a: "Less than 2 mg/kg/day (or $\\1$ mg/day total) for less than 14 days." },
            { q: "Precaution for the Live Attenuated Influenza Vaccine (LAIV) regarding underlying chronic conditions?", a: "Asthma or reactive airway disease in children aged 2–4 years." },
            { q: "Is a family history of seizures a contraindication to the MMRV vaccine?", a: "No, but it is a precaution due to a slightly higher risk of febrile seizures compared to separate MMR and Varicella injections." },
            { q: "Management of a newborn whose mother is HBsAg-positive?", a: "Administer HepB vaccine and Hepatitis B Immune Globulin (HBIG) within 12 hours of birth." },
            { q: "Post-vaccination serologic testing protocol for an infant born to an HBsAg-positive mother?", a: "Test for HBsAg and anti-HBs at age 9–12 months (or 1–2 months after the final HepB dose)." },
            { q: "Management of a newborn weighing $\\1$g whose mother is HBsAg-negative?", a: "Delay the first HepB vaccine dose until 1 month of age or at hospital discharge." },
            { q: "Management of a newborn weighing $\\1$g whose mother is HBsAg-positive?", a: "Give HepB vaccine and HBIG within 12 hours of birth, but do not count the birth dose toward the 3-dose series." },
            { q: "Target population for the Pneumococcal Polysaccharide vaccine (PPSV23)?", a: "Children aged 2–18 years with underlying chronic medical conditions (e.g., asplenia, sickle cell, HIV, chronic heart/lung disease) after completing the PCV series." },
            { q: "Indication for Meningococcal Serogroup B (MenB) vaccination?", a: "Adolescents aged 16–23 years (preferred 16–18) and high-risk patients aged ≥10 years (e.g., anatomic/functional asplenia, complement deficiency)." },
            { q: "Indication for early MMR vaccination at 6–11 months of age?", a: "International travel outside the United States." },
            { q: "Does an early MMR dose given at 6–11 months count toward the 2-dose routine pediatric series?", a: "No, the child still requires 2 routine doses at ≥12 months of age." },
            { q: "Routine recommendation for Tdap vaccination during pregnancy?", a: "1 dose during every pregnancy, ideally between 27 and 36 weeks gestation, regardless of prior vaccination history." },
            { q: "Frequency of well-child visits recommended by the AAP during the first year of life?", a: "At 3–5 days, and 1, 2, 4, 6, and 9 months of age." },
            { q: "Frequency of well-child visits recommended by the AAP during the second year of life?", a: "At 12, 15, 18, and 24 months of age." },
            { q: "Universal age recommendations for autism spectrum disorder (ASD) screening?", a: "18 months and 24 months." },
            { q: "Age at which universal developmental screening using a validated tool is recommended?", a: "9, 18, and 30 months." },
            { q: "Universal age for maternal depression screening during well-child visits?", a: "1, 2, 4, and 6 months." },
            { q: "Universal age for initial visual acuity screening using standard charts?", a: "4 years (can attempt at 3 years if cooperative)." },
            { q: "Age at which formal, objective audiometry hearing screening begins?", a: "4 years." },
            { q: "Universal screening age for dyslipidemia using a fasting or non-fasting lipid panel?", a: "Once between 9 and 11 years, and once between 17 and 21 years." },
            { q: "Indication for targeted lead screening in pediatric patients?", a: "Medicaid enrollment, living in high-prevalence zip codes, or housing built before 1978." },
            { q: "Routine ages for universal hemoglobin/hematocrit screening for anemia?", a: "12 months of age." },
            { q: "Age at which blood pressure measurement should begin routinely at every well-child visit?", a: "3 years." },
            { q: "Initial screening method for scoliosis in adolescents?", a: "Adams Forward Bend Test." },
            { q: "Recommended daily Vitamin D supplementation for exclusively breastfed infants?", a: "400 IU daily starting within the first few days of life." },
            { q: "When should Vitamin D supplementation stop for formula-fed infants?", a: "When they consume at least 1 liter (approx. 32 oz) per day of Vitamin D-fortified formula or whole milk." },
            { q: "Age at which iron supplementation should begin for exclusively breastfed, term infants?", a: "4 months of age (at 1 mg/kg/day of elemental iron) until iron-containing foods are introduced." },
            { q: "Iron supplementation rule for preterm infants?", a: "2 mg/kg/day of elemental iron starting at 2 weeks of age until 12 months of age." },
            { q: "Age at which solid foods should be introduced into an infant's diet?", a: "Around 6 months of age, when developmentally ready." },
            { q: "Recommended age to introduce allergenic foods (e.g., peanut products) to prevent allergies?", a: "Around 4–6 months of age, after other solids are tolerated, especially in infants with severe eczema or egg allergy." },
            { q: "Maximum recommended intake of whole cow's milk per day for toddlers aged 1–5 years?", a: "16 to 24 ounces (approx. 500–700 mL) per day to prevent iron-deficiency anemia." },
            { q: "Age at which low-fat (1% or skim) milk can be introduced instead of whole milk?", a: "2 years of age (can consider at 12 months if overweight or family history of obesity/cardiovascular disease)." },
            { q: "Age before which raw honey is completely contraindicated?", a: "12 months (due to the risk of infant botulism from Clostridium botulinum spores)." },
            { q: "Most sensitive indicator of a child's nutritional status or acute illness?", a: "Weight changes (monitored via standardized growth charts)." },
            { q: "Definition of failure to thrive (FTT) based on growth chart percentiles?", a: "Weight below the 3rd to 5th percentile, or a drop across two major percentile lines." },
            { q: "Recommended safe sleep position to prevent Sudden Infant Death Syndrome (SIDS)?", a: "Supine (flat on the back) for every sleep period." },
            { q: "Essential components of a safe infant sleep environment?", a: "Firm, flat sleep surface, in a crib/bassinette, with no loose blankets, pillows, bumper pads, or soft toys." },
            { q: "Recommended duration for infants to remain in a rear-facing car safety seat?", a: "Until they reach the highest weight or height limit allowed by their car seat manufacturer." },
            { q: "Criteria for switching a child from a belt-positioning booster seat to a standard vehicle lap-and-shoulder belt?", a: "Height of 4 feet 9 inches (143 cm) and typically between 8 and 12 years of age." },
            { q: "Age before which children should always sit in the back seat of a vehicle equipped with passenger airbags?", a: "13 years." },
            { q: "Primary mechanism of cardiac arrest in pediatric patients according to PALS?", a: "Asphyxial/respiratory failure or progressive shock (rarely primary cardiac events)." },
            { q: "Definition of pediatric tachycardia requiring immediate evaluation based on age groups?", a: "Infant heart rate $\\1$/min or child heart rate $\\1$/min with narrow QRS complexes." },
            { q: "First-line intervention for a pediatric patient with symptomatic bradycardia and compromised cardiopulmonary status despite oxygenation/ventilation?", a: "Cardiopulmonary resuscitation (CPR) if the heart rate remains $\\1$/min." },
            { q: "Classic skin finding in Zitelli's Atlas for a child with congenital dermal melanocytosis (Mongolian spots)?", a: "Flat, blue-grey patches with indefinite borders, most commonly located over the sacrum or buttocks." },
            { q: "Physical exam finding that distinguishes erythema toxicum neonatorum from neonatal herpes?", a: "Erythema toxicum presents with eosinophils on a Wright-stained smear; herpes presents with multinucleated giant cells on a Tzanck smear." },
            { q: "Anticipatory guidance topic regarding water safety for toddlers?", a: "Continuous, touch-supervision by an adult whenever the child is in or near water (including bathtubs and swimming pools)." },
            { q: "Water temperature threshold recommended for home water heaters to prevent scald burns?", a: "Below 120°F (49°C)." },
            { q: "Universal age recommendation for the first dental visit?", a: "By 12 months of age, or within 6 months of the eruption of the first tooth." },
            { q: "Minimum interval between doses 1 and 2 of the HepB series in a catch-up schedule?", a: "4 weeks." },
            { q: "Minimum age to receive the Tdap vaccine if a child missed the childhood DTaP series?", a: "7 years." },
            { q: "Number of doses required for the HPV vaccine series if the first dose is given at age 16?", a: "3 doses." },
            { q: "Complication of Haemophilus influenzae type b that Hib vaccination effectively prevents?", a: "Epiglottitis, meningitis, and septic arthritis." },
            { q: "Primary reason for administering the Rubella vaccine component to children?", a: "To prevent Congenital Rubella Syndrome (CRS) in the offspring of pregnant women exposed to infected children." },
            { q: "Major neurological complication associated with Measles infection that the MMR vaccine prevents?", a: "Subacute Sclerosing Panencephalitis (SSPE)." },
            { q: "Serious complication of Mumps infection prevented by vaccination in post-pubertal males?", a: "Orchitis (which can cause testicular atrophy and, rarely, infertility)." },
            { q: "Pneumococcal serotype coverage type utilized in PCV15/PCV20?", a: "Capsular polysaccharide conjugated to a nontoxic diphtheria toxin protein carrier (T-cell dependent response)." },
            { q: "Pneumococcal vaccine type that induces a T-cell independent response?", a: "PPSV23 (unconjugated polysaccharide vaccine)." },
            { q: "Why is PPSV23 ineffective in children under 2 years of age?", a: "Immature splenic function and inability to mount an immune response to T-cell independent polysaccharide antigens." },
            { q: "Diagnostic significance of a white pupillary reflex (leukocoria) on a red reflex exam?", a: "Urgent referral to an ophthalmologist for suspected retinoblastoma or congenital cataracts." },
            { q: "Physical signs of developmental dysplasia of the hip (DDH) during newborn screening?", a: "Positive Barlow (dislocation) or Ortolani (reduction) maneuvers, or asymmetric thigh skin folds." },
            { q: "Standard imaging modality used to screen for DDH in infants under 4 months of age?", a: "Hip ultrasonography." },
            { q: "Standard imaging modality used to screen for DDH in infants 4 months and older?", a: "AP and frog-leg lateral radiographs of the pelvis." },
            { q: "Screening recommendation for cryptorchidism (undescended testes)?", a: "Palpate at every well-child visit; refer to a specialist if undescended by 6 months of age." },
            { q: "Anticipatory guidance regarding screen time limits for children under 18 months of age?", a: "Avoid screen time entirely, except for video chatting." },
            { q: "Recommended limit for recreational screen time for children aged 2 to 5 years?", a: "No more than 1 hour per day of high-quality programming." },
            { q: "Best preventive counseling regarding secondhand smoke exposure in infants?", a: "Strict elimination of smoking in the home and car to prevent lower respiratory tract infections and SIDS." },
            { q: "Initial management strategy for a toddler presenting with physiological bowed legs (genu varum) under 2 years of age?", a: "Reassurance and observation, as it typically resolves spontaneously by age 2." },
            { q: "Diagnostic criteria on a growth chart that suggests constitutional delay of growth?", a: "Growth velocity is normal, but height and weight trail parallel to and below the 3rd percentile, with a delayed bone age." },
            { q: "Expected age by which an infant should double their birth weight?", a: "4 to 5 months of age." },
            { q: "Expected age by which an infant should triple their birth weight?", a: "12 months of age." },
            { q: "Expected age by which an infant should quadruple their birth weight?", a: "24 months of age." },
            { q: "Average increase in head circumference during the first year of life?", a: "Approximately 12 centimeters." },
            { q: "Manifestation of congenital hypothyroidism on a newborn preventative screening panel if left untreated?", a: "Intellectual disability, macroglossia, umbilical hernia, hypotonia, and prolonged jaundice." },
            { q: "Manifestation of phenylketonuria (PKU) on a newborn preventative screening panel if left untreated?", a: "Intellectual disability, musty/mousy body odor, microcephaly, and hypopigmentation." },
            { q: "Immediate screening step required for an infant with a suspected critical congenital heart defect (CCHD)?", a: "Pulse oximetry screening in the right hand and either foot after 24 hours of life." },
            { q: "Positive screening result for Critical Congenital Heart Disease (CCHD) via pulse oximetry?", a: "Any $\\text{SpO}_2 < 90\\\\%$, $\\text{SpO}_2 < 95\\\\%$ in both extremities on 3 measures separated by 1 hour, or a $>3\\\\%$ difference between hand and foot." },
            { q: "Clinical significance of a dynamic, musical, vibratory systolic murmur at the lower left sternal border in an asymptomatic 4-year-old child?", a: "Still's murmur, which is benign/innocent and requires reassurance." },
            { q: "First physical indicator of female puberty (thelarche) on a preventative exam?", a: "Breast budding under the areola, typically occurring between 8 and 13 years of age." },
            { q: "First physical indicator of male puberty (gonadarche) on a preventative exam?", a: "Testicular enlargement ($\\ge 4 \\text{ mL}$ volume or $\\ge 2.5 \\text{ cm}$ length), typically occurring between 9 and 14 years of age." },
            { q: "Primary preventative screening done for adolescents regarding mental health?", a: "Annual screening for depression using the PHQ-2 or PHQ-A questionnaires starting at age 12." },
            { q: "Age at which universal screening for human immunodeficiency virus (HIV) is recommended at least once?", a: "Between 15 and 18 years of age." },
            { q: "Preventative strategy for dental caries in communities without fluoridated tap water?", a: "Oral fluoride supplementation starting at 6 months of age." },
            { q: "What finding on a pediatric skin exam should trigger an evaluation for Neurofibromatosis Type 1 (NF1)?", a: "Six or more café-au-lait macules greater than 5 mm in diameter in prepubertal children." },
            { q: "True or false: The MMR vaccine causes autism due to the thimerosal preservative.", a: "False; multiple large-scale studies have disproven any link, and MMR has never contained thimerosal." },
            { q: "Expected, benign local physical exam findings within 48 hours of a DTaP injection?", a: "Erythema, mild swelling, and localized tenderness at the injection site." },
            { q: "Definition of a hypotonic-hyporesponsive episode (HHE) following vaccination?", a: "Sudden onset of pallor, hypotonia, and unresponsiveness within 48 hours of vaccination (most commonly DTaP)." },
            { q: "Is a history of a hypotonic-hyporesponsive episode (HHE) an absolute contraindication to future DTaP doses?", a: "No, it is a precaution; the benefits of pertussis coverage usually outweigh the risks." },
            { q: "What rare, self-limiting neurological condition is historically monitored after the Influenza vaccine?", a: "Guillain-Barré Syndrome (GBS) within 6 weeks of administration." },
            { q: "Can a child with a known, non-anaphylactic egg allergy receive the routine Influenza vaccine?", a: "Yes, any age-appropriate Influenza vaccine (inactivated or live) can be given safely without special precautions." },
            { q: "Can a child living with a pregnant mother safely receive live vaccines like MMR and Varicella?", a: "Yes, transmission of the vaccine viruses to contacts is extremely rare." },
            { q: "Under what specific circumstance should a child avoid a vaccine due to a household contact?", a: "Avoid Live Attenuated Influenza Vaccine (LAIV) if a household contact is severely immunocompromised and in a protected environment (e.g., bone marrow transplant unit)." },
            { q: "Most common benign side effect noted 7 to 12 days after receiving the MMR vaccine?", a: "Transient low-grade fever and a mild, non-contagious maculopapular rash." },
            { q: "Management of a child who develops a small, non-painful subcutaneous nodule at a DTaP injection site?", a: "Reassurance; it is a common granulomatous reaction to the aluminum adjuvant and resolves spontaneously." },
            { q: "Post-exposure prophylaxis for an unvaccinated 10-month-old infant exposed to Measles within 72 hours?", a: "Administer the MMR vaccine." },
            { q: "Post-exposure prophylaxis for an immunocompromised child exposed to Measles within 6 days?", a: "Administer Intravenous Immunoglobulin (IVIG)." },
            { q: "Post-exposure prophylaxis for an unimmunized 8-month-old infant exposed to Varicella within 96 hours?", a: "Administer Varicella Zoster Immune Globulin (VarZIG)." },
            { q: "Post-exposure prophylaxis for an unimmunized 15-month-old child exposed to Varicella within 3 to 5 days?", a: "Administer the Varicella vaccine." },
            { q: "Management of a clean, minor wound in a child with an unknown or $\\1$ dose DTaP history?", a: "Give the DTaP/Tdap vaccine only; no Tetanus Immune Globulin (TIG) is required." },
            { q: "Management of a deep, contaminated wound in a child with an unknown or $\\1$ dose DTaP history?", a: "Give both the DTaP/Tdap vaccine and Tetanus Immune Globulin (TIG)." },
            { q: "Management of a clean, minor wound in a child with $\\ge 3$ documented DTaP doses, with the last dose 7 years ago?", a: "Reassurance and wound care; no vaccine or TIG is needed because the last dose was $<10$ years ago." },
            { q: "Management of a contaminated wound in a child with $\\ge 3$ documented DTaP doses, with the last dose 7 years ago?", a: "Give a DTaP/Tdap booster because the last dose was $>5$ years ago for a high-risk wound." },
            { q: "What additional vaccine is recommended for pediatric travelers visiting areas of sub-Saharan Africa known as the \"Meningitis Belt\"?", a: "Meningococcal ACWY (MenACWY) vaccine booster or early dose." },
            { q: "Minimum age to receive the Yellow Fever vaccine for pediatric international travelers?", a: "9 months (due to the risk of vaccine-associated encephalitis in younger infants)." },
            { q: "Physical exam finding on the Hirschberg (corneal light reflex) test that indicates strabismus?", a: "Asymmetrical placement of the light reflex point on the pupil or iris." },
            { q: "Gold-standard management for a child diagnosed with amblyopia due to strabismus?", a: "Patching the unaffected (stronger) eye or using atropine drops to blur the stronger eye, forcing use of the weaker eye." },
            { q: "Objective screening method used for newborn hearing screening in the nursery?", a: "Otoacoustic Emissions (OAE) or Automated Auditory Brainstem Response (AABR)." },
            { q: "Interpretation of an infant who \"fails\" the initial newborn hearing screening?", a: "Repeat screening before 1 month of age; if still failed, comprehensive audiologic evaluation by 3 months." },
            { q: "Primary dental advice given to parents to prevent Early Childhood Caries (baby bottle tooth decay)?", a: "Never put an infant to sleep with a bottle containing milk, juice, or sweetened liquids." },
            { q: "When should toothpaste containing fluoride be introduced into a child’s oral care routine?", a: "At the eruption of the first tooth, using a tiny \"smear\" (size of a grain of rice)." },
            { q: "Amount of fluoride toothpaste recommended for children aged 3 to 6 years?", a: "A pea-sized amount." },
            { q: "Confirmation step required if a capillary finger-stick lead screening level returns elevated ($\\ge 3.5\\ \\mu\\text{g/dL}$)?", a: "Obtain a confirmatory venous blood lead level." },
            { q: "First-line intervention for a venous blood lead level between $3.5\\ \\mu\\text{g/dL}$ and $44\\ \\mu\\text{g/dL}$?", a: "Environmental investigation to identify and remove the lead source, and nutritional optimization (iron, calcium)." },
            { q: "Threshold venous lead level at which oral chelation therapy (e.g., Succimer) is indicated?", a: "$\\ge 45\\ \\mu\\text{g/dL}$." },
            { q: "Emergency management for a child presenting with a venous lead level $\\ge 70\\ \\mu\\text{g/dL}$ or acute lead encephalopathy?", a: "Hospitalization and dual inpatient chelation therapy with Dimercaprol (BAL) and Calcium Disodium EDTA." },
            { q: "Most common cause of a false-positive result on a routine newborn screening card?", a: "Sample collection occurred before 24 hours of life (especially true for PKU and congenital hypothyroidism metabolic markers)." },
            { q: "Diagnostic follow-up required for a newborn whose screening panel indicates elevated Immunoreactive Trypsinogen (IRT)?", a: "Sweat chloride testing to evaluate for Cystic Fibrosis." },
            { q: "Red flag developmental timeline: Child not walking independently by what age?", a: "18 months." },
            { q: "Red flag developmental timeline: Child not babbling or using gestures by what age?", a: "12 months." },
            { q: "Red flag developmental timeline: Child without single words by what age?", a: "16 months." },
            { q: "Red flag developmental timeline: Child without 2-word meaningful phrases by what age?", a: "24 months." },
            { q: "The ultimate developmental rule regarding any loss of language or social skills at any age?", a: "Immediate referral for formal developmental, audiologic, and neurological evaluation." },
            { q: "Expected physical growth pattern of a child with Familial Short Stature?", a: "Growth curve runs parallel to but below the 3rd percentile, with a normal growth velocity and a normal bone age equal to chronological age." },
            { q: "Correct compression-to-ventilation ratio for two-rescuer pediatric CPR?", a: "15:2." },
            { q: "Correct compression-to-ventilation ratio for single-rescuer pediatric CPR?", a: "30:2." },
            { q: "Target depth for chest compressions during infant CPR?", a: "Approximately 1.5 inches (4 cm), or one-third the anterior-posterior diameter of the chest." },
            { q: "Target depth for chest compressions during child CPR?", a: "Approximately 2 inches (5 cm), or one-third the anterior-posterior diameter of the chest." },
            { q: "Preferred method for opening the airway in a pediatric trauma patient with a suspected neck injury?", a: "Jaw-thrust maneuver without head extension." },
            { q: "Definition of hypotension in a child aged 1 to 10 years based on systolic blood pressure?", a: "$\\text{Systolic BP} < 70\\ \\text{mmHg} + (2 \\times \\text{age in years})$." },
            { q: "First line fluid resuscitation volume bolus size for a pediatric patient in hypovolemic shock?", a: "$20\\ \\text{mL/kg}$ of an isotonic crystalloid (e.g., Normal Saline or Lactated Ringer's)." },
            { q: "Pathognomonic oral cavity finding during the prodromal phase of Measles (Rubeola)?", a: "Koplik spots (small blue-white spots on an erythematous background on the buccal mucosa opposite the molars)." },
            { q: "Description of the classic rash of Varicella (Chickenpox)?", a: "Pruritic, maculopapular rash that rapidly evolves into vesicles on an erythematous base (\"dewdrops on a rose petal\"), appearing in various stages of healing." },
            { q: "Skin manifestation of Erythema Infectiosum (Fifth Disease) caused by Parvovirus B19?", a: "Bright red rash on the cheeks (\"slapped cheek\" appearance) followed by a lacy, reticular rash on the trunk and extremities." },
            { q: "Clinical presentation of Roseola Infantum (Exanthem Subitum) caused by HHV-6?", a: "High fever ($>40^\\circ\\text{C}$ or $104^\\circ\\text{F}$) for 3–5 days that abruptly drops, followed immediately by the appearance of a maculopapular, non-pruritic rash." },
            { q: "Physical exam sign of Hand-Foot-and-Mouth Disease caused by Coxsackievirus A16?", a: "Painful oral ulcers (herpangina) accompanied by maculopapular or vesicular lesions on the palms of the hands and soles of the feet." }
          ]
        },
{
          section: 'Pediatrics (Introductory)',
          topic: "Congenital anomalies overview",
          icon: 'baby',
          cards: [
            { q: "Definition of a malformation?", a: "An intrinsic morphogenetic defect in tissue development from the onset of conception." },
            { q: "Definition of a deformation?", a: "An extrinsic mechanical force that alters the shape of normally formed tissue." },
            { q: "Definition of a disruption?", a: "A destructive breakdown of an organ or tissue that was previously developing normally." },
            { q: "Definition of a dysplasia?", a: "Abnormal cellular organization or architectural arrangement within a specific tissue type." },
            { q: "Example of a classic mechanical deformation?", a: "Clubfoot (talipes equinovarus) caused by severe oligohydramnios or uterine crowding." },
            { q: "Example of a classic tissue disruption?", a: "Amniotic band syndrome causing digital or limb amputations." },
            { q: "Definition of a congenital \"sequence\"?", a: "A single primary structural defect that leads to a cascade of secondary downstream anomalies." },
            { q: "Primary defect in Pierre Robin sequence?", a: "Micrognathia (mandibular hypoplasia)." },
            { q: "Downstream triad seen in Pierre Robin sequence?", a: "Micrognathia, glossoptosis, and a U-shaped cleft palate." },
            { q: "Primary defect in Potter sequence?", a: "Renal agenesis or severe obstructive uropathy causing profound oligohydramnios." },
            { q: "Classic physical features of Potter sequence?", a: "Flattened facies, low-set ears, compressed lungs (pulmonary hypoplasia), and limb deformities." },
            { q: "Definition of a congenital \"syndrome\"?", a: "A recognized, recurring pattern of multiple anomalies with a single, specific underlying etiology." },
            { q: "Definition of an \"association\" in genetics?", a: "A non-random statistical clustering of anomalies that occur together more often than by chance alone, without a known single cause." },
            { q: "What does the acronym VACTERL stand for?", a: "Vertebral, Anal atresia, Cardiac, Tracheoesophageal fistula, Renal, and Limb anomalies." },
            { q: "Most common type of single minor anomaly found in normal newborns?", a: "Preauricular tags or pits." },
            { q: "Clinical significance of finding three or more minor congenital anomalies in a newborn?", a: "High statistical probability of an underlying, undiagnosed major structural anomaly." },
            { q: "Major cause of death in the first year of life in developed countries?", a: "Congenital malformations." },
            { q: "Percentage of congenital anomalies with a completely unknown etiology?", a: "Approximately 50% to 60%." },
            { q: "Gestational period of highest susceptibility to major structural teratogens?", a: "Weeks 3 through 8 of embryonic development (organogenesis)." },
            { q: "Effect of a severe teratogenic insult during the first 2 weeks of gestation?", a: "An \"all-or-none\" effect, resulting in either embryonic death or completely normal recovery." },
            { q: "Definition of a phenocopy?", a: "An environmentally induced phenotype that matches an identical phenotype caused by a genetic mutation." },
            { q: "Developmental origin of the palatine tonsillar crypts?", a: "Second pharyngeal pouch." },
            { q: "Developmental origin of the inferior parathyroid glands and thymus?", a: "Third pharyngeal pouch." },
            { q: "Developmental origin of the superior parathyroid glands?", a: "Fourth pharyngeal pouch." },
            { q: "Mechanism behind a persistent thyroglossal duct cyst?", a: "Failure of the thyroglossal duct to atrophy during thyroid migration from the foramen caecum." },
            { q: "Most common chromosomal cause of moderate intellectual disability?", a: "Trisomy 21 (Down syndrome)." },
            { q: "Most common genetic cause of universal/global developmental delay in males?", a: "Fragile X syndrome." },
            { q: "Recurrence risk of Down syndrome if caused by a Robertsonian translocation in a maternal carrier?", a: "Approximately 10% to 15%." },
            { q: "Recurrence risk of Down syndrome if caused by a Robertsonian translocation in a paternal carrier?", a: "Approximately 1% to 2%." },
            { q: "Most common cardiac defect associated with Trisomy 21?", a: "Endocardial cushion defect (Atrioventricular septal defect)." },
            { q: "Gastrointestinal anomalies classically associated with Down syndrome?", a: "Duodenal atresia and Hirschsprung disease." },
            { q: "Leukemia type with increased risk in Down syndrome patients under 3 years old?", a: "Acute Megakaryoblastic Leukemia (AMKL)." },
            { q: "Triad of clinical features pathognomonic for Trisomy 18 (Edwards syndrome)?", a: "Micrognathia, clenched fists with overlapping fingers, and rocker-bottom feet." },
            { q: "Most common structural cardiac defect in Trisomy 18?", a: "Ventricular septal defect (VSD)." },
            { q: "Classic midline defects associated with Trisomy 13 (Patau syndrome)?", a: "Holoprosencephaly, cleft lip/palate, and omphalocele." },
            { q: "Pathognomonic limb/skin findings in Trisomy 13?", a: "Postaxial polydactyly and cutis aplasia of the scalp." },
            { q: "Karyotype of Turner syndrome?", a: "45,X." },
            { q: "Cardinal cardiovascular anomaly in Turner syndrome?", a: "Coarctation of the aorta (bicuspid aortic valve is also common)." },
            { q: "Lymphatic anomaly responsible for webbed neck and puffy feet in Turner syndrome?", a: "Congenital lymphedema due to lymphatic dysgenesis (cystic hygroma)." },
            { q: "Karyotype of Klinefelter syndrome?", a: "47,XXY." },
            { q: "Clinical presentation of Klinefelter syndrome in adolescence?", a: "Tall stature, gynecomastia, small firm testes, and hypergonadotropic hypogonadism." },
            { q: "Genetic mechanism behind Prader-Willi syndrome?", a: "Paternal deletion or maternal uniparental disomy of chromosome 15q11-q13." },
            { q: "Phenotypic presentation of Prader-Willi syndrome in infancy?", a: "Severe hypotonia, poor feeding, and failure to thrive." },
            { q: "Phenotypic switch in Prader-Willi syndrome during early childhood?", a: "Hyperphagia leading to early-onset morbid obesity and type 2 diabetes." },
            { q: "Genetic mechanism behind Angelman syndrome?", a: "Maternal deletion or paternal uniparental disomy of chromosome 15q11-q13 (loss of UBE3A expression)." },
            { q: "Classic clinical triad of Angelman syndrome?", a: "Inappropriate laughter (\"happy puppet\"), severe ataxia, and absent speech." },
            { q: "Chromosomal microdeletion in DiGeorge syndrome?", a: "22q11.2 microdeletion." },
            { q: "Developmental mechanism altered in DiGeorge syndrome?", a: "Aberrant development of the 3rd and 4th pharyngeal pouches." },
            { q: "Clinical presentation of CATCH-22 in DiGeorge syndrome?", a: "Cardiac defects, Abnormal facies, Thymic hypoplasia, Cleft palate, and Hypocalcemia." },
            { q: "Immediate life-threatening metabolic complication in DiGeorge syndrome newborns?", a: "Hypocalcemic tetany or seizures due to parathyroid aplasia." },
            { q: "Classic facial triad of Fetal Alcohol Syndrome (FAS)?", a: "Short palpebral fissures, smooth philtrum, and a thin upper lip vermilion." },
            { q: "Central nervous system manifestation of Fetal Alcohol Syndrome?", a: "Microcephaly with structural brain anomalies and neurobehavioral impairment." },
            { q: "Cardiac anomaly specifically associated with maternal lithium use?", a: "Ebstein anomaly (atrialization of the right ventricle)." },
            { q: "Pathognomonic skeletal anomaly of Fetal Warfarin Syndrome?", a: "Chondrodysplasia punctata (stippled epiphyses) and nasal hypoplasia." },
            { q: "Classic structural defects caused by Fetal Hydantoin (Phenytoin) Syndrome?", a: "Craniofacial clefts, hypoplastic nails, and hypoplastic distal phalanges." },
            { q: "Phenotypic presentation of Fetal Retinoic Acid (Isotretinoin) Embryopathy?", a: "Severe microtia/otia, hydrocephalus, and conotruncal cardiac malformations." },
            { q: "Primary congenital defect associated with maternal Valproic Acid use?", a: "Neural tube defects (specifically lumbosacral spina bifida)." },
            { q: "Mechanism by which Valproic Acid induces neural tube defects?", a: "Interference with folate metabolism and antagonism of folate transport." },
            { q: "Structural anomalies associated with uncontrolled pregestational maternal diabetes?", a: "Caudal regression syndrome (sacral agenesis) and transposition of the great arteries." },
            { q: "Pathognomonic transient cardiac pathology in infants of diabetic mothers?", a: "Asymmetric septal hypertrophy causing subaortic left ventricular outflow tract obstruction." },
            { q: "Classic congenital anomalies associated with Thalidomide exposure?", a: "Phocomelia and amelia (severe limb reduction defects)." },
            { q: "Classic triad of Congenital Rubella Syndrome?", a: "Sensorineural cataracts, sensorineural deafness, and patent ductus arteriosus (PDA)." },
            { q: "Classic skin finding in neonatal Congenital Rubella Syndrome?", a: "\"Blueberry muffin\" spots representing extramedullary hematopoiesis." },
            { q: "Intracranial finding pathognomonic for Congenital Cytomegalovirus (CMV)?", a: "Periventricular intracranial calcifications." },
            { q: "Intracranial finding pathognomonic for Congenital Toxoplasmosis?", a: "Diffuse, scattered parenchymal intracranial calcifications." },
            { q: "Classic triad of Congenital Toxoplasmosis?", a: "Chorioretinitis, hydrocephalus, and diffuse intracranial calcifications." },
            { q: "Pathognomonic early skeletal sign of Congenital Syphilis?", a: "Wimberger sign (destructive osteopathy of the proximal medial tibia)." },
            { q: "Late-stage stigmata triad of Congenital Syphilis?", a: "Hutchinson triad: interstitial keratitis, sensorineural deafness, and notched Hutchinson teeth." },
            { q: "Primary adverse structural outcome of prenatal Maternal Hyperthermia?", a: "Neural tube defects due to disruption of anterior neuropore closure." },
            { q: "Neonatal withdrawal syndrome caused by maternal SSRI use in late pregnancy?", a: "Poor neonatal adaptation syndrome (hyperirritability, tachypnea, weak cry)." },
            { q: "Major neonatal vascular risk associated with maternal Cocaine use?", a: "Jejunoileal atresia or limb reduction defects due to fetal vascular disruption." },
            { q: "Congenital defect linked to maternal smoking during pregnancy?", a: "Isolated cleft lip and palate." },
            { q: "Drug of choice to prevent neural tube defects in standard pregnancies?", a: "Folic acid 0.4 mg daily starting pre-conception." },
            { q: "Folic acid dosage recommended for mothers with a history of a prior child with a neural tube defect?", a: "4.0 mg daily starting pre-conception." },
            { q: "Definitive diagnostic test for fetal chromosomal anomalies after an abnormal maternal serum screen?", a: "Amniocentesis or Chorionic Villus Sampling (CVS) with karyotype/microarray." },
            { q: "Most common congenital cardiac defect overall?", a: "Ventricular Septal Defect (VSD)." },
            { q: "Pathophysiology of an Omphalocele?", a: "Failure of the midgut loops to return to the abdominal cavity through the umbilical ring at week 10." },
            { q: "Anatomical presentation of Gastroschisis?", a: "Herniation of bowel lateral to the umbilicus (usually right side) without a covering peritoneal membrane." },
            { q: "Maternal serum marker elevated in both Gastroschisis and Omphalocele?", a: "$\\alpha$-Fetoprotein (AFP)." },
            { q: "Syndrome strongly associated with Omphalocele, macroglossia, and hemihyperplasia?", a: "Beckwith-Wiedemann syndrome." },
            { q: "Malignancy risk associated with Beckwith-Wiedemann syndrome?", a: "Wilms tumor and hepatoblastoma." },
            { q: "Diagnostic imaging step for a newborn with excessive salivation and choking during initial feeding?", a: "Insertion of a radiopaque nasogastric tube followed by a chest/abdominal X-ray." },
            { q: "Most common type of Tracheoesophageal Fistula (TEF)?", a: "Type C: Esophageal atresia with a distal tracheoesophageal fistula." },
            { q: "Classic X-ray finding in Type C Tracheoesophageal Fistula?", a: "Coiled NG tube in the upper esophageal pouch with air present in the stomach." },
            { q: "Diagnostic finding on an abdominal X-ray for Duodenal Atresia?", a: "The \"double bubble\" sign (air-filled stomach and proximal duodenum)." },
            { q: "Congenital anomaly presenting with a painless, midline neck mass that moves upward with tongue protrusion?", a: "Thyroglossal duct cyst." },
            { q: "Congenital anomaly presenting with a lateral neck mass anterior to the sternocleidomastoid muscle that does not move with swallowing?", a: "Branchial cleft cyst." },
            { q: "Embryological failure causing Hirschsprung disease?", a: "Failure of craniocaudal migration of neural crest cells to the distal colon." },
            { q: "Definitive gold-standard diagnostic test for Hirschsprung disease?", a: "Suction rectal biopsy demonstrating an absence of ganglion cells in Meissner and Auerbach plexuses." },
            { q: "Embryological failure causing Meckel diverticulum?", a: "Incomplete obliteration of the omphalomesenteric (vitelline) duct." },
            { q: "Two tissue types most commonly found ectopically in Meckel diverticulum?", a: "Gastric mucosa and pancreatic tissue." },
            { q: "Rule of 2s for Meckel diverticulum?", a: "2% of population, 2 feet from ileocecal valve, 2 inches long, 2 types of ectopic tissue, presents by age 2." },
            { q: "Most common congenital anomaly of the urinary tract?", a: "Ureteropelvic junction (UPJ) obstruction." },
            { q: "Most common cause of severe bilateral hydronephrosis and bladder distension in newborn males?", a: "Posterior urethral valves (PUV)." },
            { q: "Diagnostic modality of choice to confirm Posterior Urethral Valves?", a: "Voiding cystourethrogram (VCUG)." },
            { q: "Embryological defect in an Exstrophy of the Bladder?", a: "Failure of the infraumbilical mesenchymal migration leading to a breakdown of the cloacal membrane." },
            { q: "Embryological failure causing Anencephaly?", a: "Failure of the anterior (rostral) neuropore to close during week 4 of gestation." },
            { q: "Embryological failure causing Spina Bifida Occluta?", a: "Failure of the embryonic vertebral arches to fuse completely midline without herniation of meninges or cord." },
            { q: "Structural presentation of a Meningocele?", a: "Herniation of the meninges through a vertebral defect without spinal cord involvement." },
            { q: "Structural presentation of a Myelomeningocele?", a: "Herniation of both the meninges and the spinal cord/neural elements through a vertebral defect." },
            { q: "Central nervous system malformation universally associated with Myelomeningocele?", a: "Chiari II malformation (downward displacement of the cerebellar vermis and medulla)." },
            { q: "Classic cranial signs of hydrocephalus on physical examination of a newborn?", a: "Bulging anterior fontanelle, widened sutures, and the \"setting-sun\" eye sign." },
            { q: "Definition of Craniosynostosis?", a: "Premature fusion of one or more cranial sutures." },
            { q: "Most common type of single suture craniosynostosis?", a: "Sagittal suture synostosis (causing scaphocephaly/dolichocephaly)." },
            { q: "Diagnostic sign of Developmental Dysplasia of the Hip (DDH) that reduces a dislocated hip?", a: "Ortolani maneuver (abduction of the flexed hip with anterior pressure)." },
            { q: "First-line imaging modality to screen for structural anomalies in a fetus during routine prenatal care?", a: "Screening fetal anatomy ultrasound performed between 18 and 22 weeks of gestation." },
            { q: "Serum markers included in the maternal quadruple screen for aneuploidy?", a: "$\\alpha$-fetoprotein (AFP), human chorionic gonadotropin (hCG), estriol (uE3), and inhibin A." },
            { q: "Quadruple screen pattern classic for Trisomy 21?", a: "Decreased AFP, increased hCG, decreased uE3, and increased inhibin A." },
            { q: "Quadruple screen pattern classic for Trisomy 18?", a: "Decreased AFP, decreased hCG, decreased uE3, and normal to decreased inhibin A." },
            { q: "Next diagnostic step when a routine newborn pulse oximetry screen is positive for suspected congenital heart disease?", a: "Urgent transthoracic echocardiogram." },
            { q: "Criteria for a positive newborn pulse oximetry screen for critical congenital heart disease?", a: "Oxygen saturation less than 90%, or less than 95% in both hand and foot on three measures, or a greater than 3% difference between hand and foot." },
            { q: "Immediate medical management to maintain ductal patency in a newborn with a transposition of the great arteries?", a: "Intravenous Prostaglandin E1 (alprostadil) infusion." },
            { q: "Absolute contraindication to the administration of Prostaglandin E1 in a cyanotic newborn?", a: "Total anomalous pulmonary venous return (TAPVR) with severe pulmonary venous obstruction." },
            { q: "Primary life-threatening side effect of Prostaglandin E1 infusion requiring close monitoring?", a: "Apnea, often necessitating prophylactic endotracheal intubation." },
            { q: "Definitive management strategy for a symptomatic congenital diaphragmatic hernia in the first 24 hours of life?", a: "Immediate endotracheal intubation and mechanical ventilation, avoiding bag-mask ventilation entirely." },
            { q: "Why is bag-mask ventilation strictly contraindicated in congenital diaphragmatic hernia?", a: "It introduces air into the herniated gastrointestinal tract, causing further compression of the hypoplastic lungs." },
            { q: "Preferred initial surgical timing for an uncomplicated isolated cleft lip repair?", a: "Around 10 to 12 weeks of life (adhering to the \"rule of 10s\": 10 weeks, 10 pounds, 10g hemoglobin)." },
            { q: "Preferred initial surgical timing for an uncomplicated isolated cleft palate repair?", a: "Between 9 and 18 months of age to optimize speech development while minimizing maxillary growth restriction." },
            { q: "Immediate management step for an infant born with an exposed, ruptured omphalocele or gastroschisis?", a: "Cover the exposed bowel with sterile, warm, saline-soaked gauze and wrap it in a plastic bowel bag to prevent heat and fluid loss." },
            { q: "First-line imaging study to evaluate a suspected developmental dysplasia of the hip (DDH) in an infant under 4 months of age?", a: "Hip ultrasonography, because the femoral head ossification center has not yet formed." },
            { q: "First-line imaging study to evaluate suspected developmental dysplasia of the hip (DDH) in an infant over 4 to 6 months of age?", a: "Plain pelvic radiography (X-ray)." },
            { q: "Standard non-surgical treatment for a reducible developmental dysplasia of the hip diagnosed within the first 6 months of life?", a: "Dynamic splinting using a Pavlik harness." },
            { q: "First-line diagnostic imaging test for a newborn who fails to pass meconium within the first 48 hours of life?", a: "Contrast enema to differentiate between Hirschsprung disease and meconium ileus." },
            { q: "Classic contrast enema finding pathognomonic for Hirschsprung disease?", a: "A narrow distal rectosigmoid transition zone with a dilated proximal colon." },
            { q: "Classic contrast enema finding pathognomonic for meconium ileus in cystic fibrosis?", a: "A microcolon containing multiple filling defects representing inspissated meconium plugs." },
            { q: "Initial therapeutic intervention for a stable infant presenting with suspected malrotation and midgut volvulus?", a: "Emergent surgical laparotomy and a Ladd procedure." },
            { q: "First-line imaging modality for suspected biliary atresia in a persistently jaundiced 3-week-old infant?", a: "Abdominal ultrasonography to assess for the presence of a gallbladder and the \"triangular cord\" sign." },
            { q: "Definitive diagnostic test for confirming biliary atresia when ultrasound and hepatobiliary scintigraphy (HIDA) are inconclusive?", a: "Intraoperative cholangiogram." },
            { q: "Surgical procedure that must be performed early to optimize survival in patients with biliary atresia?", a: "Kasai portoenterostomy, ideally performed before 60 days of age." },
            { q: "Primary monitoring protocol required for an infant born with Beckwith-Wiedemann syndrome due to tumor risks?", a: "Abdominal ultrasound every 3 months until age 8 and serum $\\alpha$-fetoprotein (AFP) every 3 months until age 4." },
            { q: "Management step for an asymptomatic newborn found to have a single umbilical artery on umbilical cord inspection?", a: "Routine clinical monitoring, as isolated cases without other anomalies do not require further renal or cardiac imaging." },
            { q: "Initial empirical management for an infant born with ambiguous genitalia while awaiting definitive genetic results?", a: "Strict avoidance of sex assignment, immediate checking of serum electrolytes to rule out congenital adrenal hyperplasia, and a karyotype." },
            { q: "Life-threatening electrolyte imbalance to anticipate in a newborn with 21-hydroxylase deficiency congenital adrenal hyperplasia?", a: "Hyperkalemia and hyponatremia due to a severe salt-wasting crisis." },
            { q: "First-line diagnostic imaging modality to confirm a suspected choanal atresia in a newborn with cyclical cyanosis relieved by crying?", a: "Computed tomography (CT) scan of the nasal cavities and skull base." },
            { q: "Immediate stabilization method for a newborn with bilateral choanal atresia before definitive surgical repair?", a: "Placement of an oral airway or a McGovern nipple to bypass nasal airway obstruction." },
            { q: "Screening recommendation for infants diagnosed with a cleft palate regarding hearing health?", a: "Early and frequent audiologic evaluation and tympanometry due to high risk of chronic otitis media with effusion." },
            { q: "Standard long-term management requirement for a child post-repair of a myelomeningocele?", a: "Clean intermittent catheterization due to a neurogenic bladder." },
            { q: "Primary orthopedic monitoring required throughout childhood for patients born with a repaired myelomeningocele?", a: "Serial spine radiographs to monitor for the development of neuromuscular scoliosis." },
            { q: "Most common cause of late mortality in individuals with treated hydrocephalus and an ventriculoperitoneal (VP) shunt?", a: "Ventriculoperitoneal shunt malfunction or bacterial infection (most commonly Staphylococcus epidermidis)." },
            { q: "Classic clinical presentation of an acute ventriculoperitoneal shunt malfunction in an older child?", a: "Morning headaches, projectile vomiting, lethargy, and papilledema." },
            { q: "Most sensitive non-invasive screening test for fetal aneuploidy available after 10 weeks of gestation?", a: "Cell-free fetal DNA (cfDNA) screening from maternal blood." },
            { q: "Confirmatory diagnostic test of choice for a positive cell-free fetal DNA screen before 15 weeks of gestation?", a: "Chorionic villus sampling (CVS)." },
            { q: "Confirmatory diagnostic test of choice for a positive cell-free fetal DNA screen after 15 weeks of gestation?", a: "Amniocentesis." },
            { q: "Primary structural anomaly associated with elevated maternal serum $\\alpha$-fetoprotein (MSAFP) and an intact abdominal wall?", a: "Neural tube defects such as anencephaly or open spina bifida." },
            { q: "Classic ultrasound finding at 11 to 14 weeks of gestation that indicates an increased risk for Trisomy 21 or congenital heart disease?", a: "Increased nuchal translucency." },
            { q: "Definitive genetic test used to identify submicroscopic deletions or duplications when a standard karyotype is normal?", a: "Chromosomal microarray analysis (CMA)." },
            { q: "Diagnostic triad pathognomonic for Tuberous Sclerosis Complex in an infant?", a: "Infantile spasms, hypopigmented macules (ash-leaf spots), and cardiac rhabdomyomas." },
            { q: "Most common primary cardiac tumor in neonates, heavily associated with spontaneous regression?", a: "Cardiac rhabdomyoma." },
            { q: "Standard surveillance protocol for individuals with Neurofibromatosis Type 1 (NF1) during early childhood?", a: "Annual ophthalmologic examinations to screen for optic pathway gliomas and Lisch nodules." },
            { q: "Classic neurocutaneous syndrome presenting with a unilateral facial port-wine stain (nevus flammeus) along the ophthalmic trigeminal distribution?", a: "Sturge-Weber syndrome (encephalotrigeminal angiomatosis)." },
            { q: "Primary central nervous system vascular anomaly to monitor for in Sturge-Weber syndrome?", a: "Leptomeningeal angiomas, which can cause contralateral seizures, hemiparesis, and glaucoma." },
            { q: "Core phenotypic features of Cornelia de Lange syndrome?", a: "Synophrys (unebrow), microcephaly, severe intellectual disability, and limb reduction defects." },
            { q: "Classic features of Waardenburg syndrome?", a: "Lateral displacement of inner canthi, heterochromia iridis (different colored eyes), a white forelock of hair, and sensorineural deafness." },
            { q: "Primary skeletal manifestation requiring surveillance in patients with Marfan syndrome during childhood?", a: "Progressive scoliosis and pectus excavatum or carinatum." },
            { q: "Cardinal cardiovascular complication requiring serial echocardiography in Marfan syndrome?", a: "Aortic root dilation leading to aortic aneurysm or dissection." },
            { q: "Standard initial surveillance protocol for an infant born with an isolated preauricular pit or tag?", a: "Routine newborn hearing screen, with no further imaging required unless accompanied by other dysmorphic features." },
            { q: "Primary diagnostic consideration for a newborn with microcephaly, chorioretinitis, and periventricular calcifications?", a: "Congenital Cytomegalovirus (CMV) infection." },
            { q: "Long-term neurosensory sequela that requires continuous monitoring in children with asymptomatic or symptomatic congenital CMV?", a: "Progressive, late-onset sensorineural hearing loss." },
            { q: "Management paradigm for a newborn presenting with a large, asymptomatic congenital melanocytic nevus?", a: "Regular clinical monitoring and photographic documentation due to a small but lifelong risk of malignant melanoma conversion." },
            { q: "Structural defect of the skull baseline that presents with a soft, compressible mass along the nasal bridge or occiput?", a: "Encephalocele (herniation of cranial contents through a bony defect)." },
            { q: "Next step in management for a newborn found to have an isolated sacral dimple within 0.5 cm of the anal verge and a visible base?", a: "Routine infant care, as this is a benign exam variant requiring no imaging." },
            { q: "Diagnostic step required for a sacral dimple that is deep, greater than 0.5 cm in diameter, accompanied by a hair tuft, or located higher on the spine?", a: "Spinal ultrasonography to rule out spinal dysraphism or a tethered cord." },
            { q: "Clinical feature that differentiates a simple hemangioma from a vascular malformation in infancy?", a: "Infantile hemangiomas proliferate rapidly after birth and eventually involute, whereas vascular malformations grow proportionally with the child and do not regress." },
            { q: "First-line medical therapy for a rapidly growing infantile hemangioma causing functional impairment or visual obstruction?", a: "Oral propranolol ($\\beta$-blocker therapy)." },
            { q: "Recommended timeline for the initial comprehensive multidisciplinary team evaluation of a child born with an orofacial cleft?", a: "Within the first few days to weeks of life to address immediate nutritional and feeding mechanics." }
          ]
        },
{
          section: 'Pediatrics (Introductory)',
          topic: "Failure to thrive & nutritional disorders",
          icon: 'baby',
          cards: [
            { q: "Definition of Failure to Thrive (FTT) regarding weight percentile?", a: "Weight consistently below the 3rd to 5th percentile for age and sex." },
            { q: "Definition of FTT regarding weight percentile drops over time?", a: "Downward crossing of at least two major percentile lines on standard growth charts." },
            { q: "Primary metric affected first in nutritional/organic FTT?", a: "Weight is affected first, followed later by height, and lastly head circumference." },
            { q: "Meaning when head circumference is preferentially or equally reduced compared to weight?", a: "Suggests a congenital infection, genetic syndrome, or severe long-standing craniosynostosis." },
            { q: "Definition of Non-Organic (Psychosocial) FTT?", a: "Growth failure due to environmental deprivation, poor bonding, or lack of food availability." },
            { q: "Definition of Organic FTT?", a: "Growth failure secondary to an underlying medical condition or major organ system dysfunction." },
            { q: "Most common general category of FTT etiology in clinical practice?", a: "Non-organic or psychosocial FTT." },
            { q: "Core pathophysiologic mechanism behind almost all cases of non-organic FTT?", a: "Inadequate caloric intake." },
            { q: "Initial diagnostic approach for a child presenting with FTT?", a: "Comprehensive history and physical exam, accompanied by a detailed 3-day dietary log." },
            { q: "Role of extensive routine laboratory screening panels in asymptomatic FTT?", a: "Low utility, as history and physical exam guide targeted testing in over 90% of cases." },
            { q: "Initial basic laboratory tests indicated if FTT etiology remains unclear after history?", a: "CBC, BMP, Urinalysis with culture, and Stool for fat/reducing substances." },
            { q: "Indication for checking a sweat test in a child with FTT?", a: "Suspected Cystic Fibrosis presenting with respiratory symptoms or foul, fatty stools." },
            { q: "Purpose of calculating the Mid-Parental Height in FTT evaluation?", a: "To differentiate pathological short stature/FTT from constitutional or genetic short stature." },
            { q: "Ideal setting for initial management of severe, life-threatening FTT or suspected severe neglect?", a: "Inpatient hospital admission for multidisciplinary evaluation and supervised refeeding." },
            { q: "Expected initial response in non-organic FTT when a child is hospitalized?", a: "Rapid weight gain when provided structured, adequate caloric intake." },
            { q: "Primary dietary deficiency responsible for Marasmus?", a: "Severe deficiency of overall calories and all macronutrients." },
            { q: "Primary dietary deficiency responsible for Kwashiorkor?", a: "Severe protein deficiency in the presence of adequate or near-adequate caloric intake." },
            { q: "Classic clinical presentation of a child with Marasmus?", a: "Emaciated \"skin and bones\" appearance, prominent ribs, and loss of subcutaneous fat." },
            { q: "Classic clinical presentation of a child with Kwashiorkor?", a: "Pitting edema, distended abdomen, hepatomegaly, and round \"moon face.\"" },
            { q: "Cause of the distended abdomen and hepatomegaly in Kwashiorkor?", a: "Decreased apolipoprotein synthesis leading to fatty liver infiltration, plus fluid retention from hypoalbuminemia." },
            { q: "Skin changes characteristic of severe Kwashiorkor?", a: "\"Flaky paint\" or \"crazy paving\" dermatosis with hyperpigmentation and desquamation." },
            { q: "Hair changes characteristic of Kwashiorkor?", a: "\"Flag sign\" characterized by alternating bands of light and dark hair color." },
            { q: "Serum albumin levels in Marasmus versus Kwashiorkor?", a: "Normal or slightly low in Marasmus; severely decreased in Kwashiorkor." },
            { q: "Immune system consequence of severe protein-energy malnutrition?", a: "Atrophy of the thymus and T-cell dysfunction, leading to severe cellular immunodeficiency." },
            { q: "Most common cause of death in children suffering from severe acute malnutrition?", a: "Intercurrent infections, secondary to profound immunosuppression." },
            { q: "Primary intracellular electrolyte shifts seen during Refeeding Syndrome?", a: "Rapid movement of phosphorus, potassium, and magnesium into cells." },
            { q: "Major hormone driver behind the metabolic shifts in Refeeding Syndrome?", a: "Insulin surge triggered by the reintroduction of carbohydrates." },
            { q: "Most common and dangerous electrolyte abnormality in Refeeding Syndrome?", a: "Severe hypophosphatemia." },
            { q: "Major clinical complications of severe hypophosphatemia during refeeding?", a: "Cardiac arrhythmias, muscle weakness, rhabdomyolysis, and respiratory failure." },
            { q: "Cardiac complication of rapid fluid and sodium reintroduction in malnourished states?", a: "Congestive heart failure due to fluid overload on a compromised, atrophied myocardium." },
            { q: "Strategy to prevent Refeeding Syndrome in severe malnutrition?", a: "Start caloric reintroduction slowly at 50% to 70% of requirement, then advance gradually." },
            { q: "Micronutrient that must be supplemented immediately during refeeding to prevent Wernicke encephalopathy?", a: "Thiamine (Vitamin B1)." },
            { q: "Earliest clinical symptom of Vitamin A deficiency?", a: "Night blindness (nyctalopia)." },
            { q: "Conjunctival sign pathognomonic for Vitamin A deficiency?", a: "Bitot spots, which are dry, foamy plaques of keratinized epithelium." },
            { q: "Severe corneal consequence of progressive, untreated Vitamin A deficiency?", a: "Keratomalacia, leading to corneal ulceration, perforation, and blindness." },
            { q: "Systemic infection whose severity and mortality are significantly reduced by Vitamin A supplementation?", a: "Measles infection." },
            { q: "Classic skeletal manifestation of Vitamin D deficiency in growing children?", a: "Rickets." },
            { q: "Cranial bone finding in infants with early rickets?", a: "Craniotabes, characterized by thinning and softening of the cranial bones." },
            { q: "Costochondral junction finding characteristic of Vitamin D deficiency?", a: "\"Rachitic rosary,\" which is visible and palpable enlargement of the costochondral junctions." },
            { q: "Long-bone deformities seen in weight-bearing children with Rickets?", a: "Genu varum (bowed legs) or genu valgum (knock-knees)." },
            { q: "Radiographic features of the long bones in active Rickets?", a: "Cupping, fraying, and widening of the metaphyses." },
            { q: "Primary biochemical abnormalities in early nutritional Vitamin D deficiency rickets?", a: "Low or normal serum calcium, low serum phosphorus, and elevated Alkaline Phosphatase." },
            { q: "Neurological presentation of severe Vitamin E deficiency?", a: "Hemolytic anemia in premature infants, ataxia, loss of proprioception, and deep tendon reflexes." },
            { q: "Hematologic presentation of Vitamin K deficiency in newborns?", a: "Vitamin K Deficiency Bleeding (VKDB), presenting with umbilical, gastrointestinal, or intracranial hemorrhage." },
            { q: "Reason why newborns are universally prone to Vitamin K deficiency?", a: "Poor placental transfer, sterile gut flora, and low Vitamin K content in breast milk." },
            { q: "Coagulation profile alteration typical of Vitamin K deficiency?", a: "Prolonged Prothrombin Time (PT) and International Normalized Ratio (INR), with normal platelets." },
            { q: "Standard preventive measure for Vitamin K Deficiency Bleeding administered at birth?", a: "Intramuscular injection of 1 mg of Vitamin K1 within hours of delivery." },
            { q: "Clinical name for Vitamin B1 deficiency?", a: "Beriberi." },
            { q: "Characteristics of \"Dry\" Beriberi?", a: "Symmetrical peripheral neuropathy with paresthesias, foot drop, and loss of reflexes." },
            { q: "Characteristics of \"Wet\" Beriberi?", a: "High-output congestive heart failure, cardiomegaly, and peripheral edema." },
            { q: "Classic clinical triad of Wernicke encephalopathy?", a: "Ophthalmoplegia/nystagmus, ataxia, and confusion." },
            { q: "Clinical name for Vitamin B2 (Riboflavin) deficiency?", a: "Angular cheilitis, glossitis, stomatitis, and seborrheic dermatitis." },
            { q: "Disease name associated with Vitamin B3 (Niacin) deficiency?", a: "Pellagra." },
            { q: "The \"Four Ds\" of Pellagra presentation?", a: "Dermatitis, Diarrhea, Dementia, and Death." },
            { q: "Classic dermatological neck finding in Pellagra?", a: "Casal necklace, a hyperpigmented, scaly rash around the lower neck." },
            { q: "Amino acid that serves as a precursor for endogenous Niacin synthesis?", a: "Tryptophan." },
            { q: "Medications known to interfere with Vitamin B6 (Pyridoxine) metabolism?", a: "Isoniazid (INH) and penicillamine." },
            { q: "Neurological side effect of Isoniazid therapy prevented by Pyridoxine co-administration?", a: "Peripheral neuropathy." },
            { q: "Hematologic manifestation of severe Vitamin B9 (Folate) or B12 deficiency?", a: "Megaloblastic anemia with hypersegmented neutrophils." },
            { q: "Key clinical differentiator between Vitamin B12 deficiency and Folate deficiency?", a: "Vitamin B12 deficiency presents with subacute combined degeneration of the spinal cord (neurological symptoms)." },
            { q: "Disease name associated with Vitamin C (Ascorbic Acid) deficiency?", a: "Scurvy." },
            { q: "Vascular and gingival findings pathognomonic for Scurvy?", a: "Perifollicular hemorrhages, \"corkscrew\" hairs, and swollen, bleeding, friable gums." },
            { q: "Bone lesion presentation of Scurvy in infants?", a: "Subperiosteal hemorrhage causing extreme bone pain and pseudoparalysis of the limbs." },
            { q: "Cutaneous and systemic symptoms of severe Zinc deficiency?", a: "Acrodermatitis enteropathica, characterized by periorificial and acral dermatitis, alopecia, and chronic diarrhea." },
            { q: "Primary hematologic manifestation of iron deficiency in children?", a: "Microcytic, hypochromic anemia with an elevated Red Cell Distribution Width (RDW)." },
            { q: "Dietary habit in toddlers most strongly associated with severe Iron Deficiency Anemia?", a: "Excessive consumption of cow's milk exceeding 24 ounces per day." },
            { q: "Classic clinical manifestations of Copper deficiency?", a: "Microcytic anemia unresponsive to iron, neutropenia, and skeletal abnormalities resembling rickets." },
            { q: "Genetic disorder characterized by impaired copper transport and brittle, \"kinky\" hair?", a: "Menkes disease." },
            { q: "Neonatal/fetal consequence of severe maternal Iodine deficiency?", a: "Congenital hypothyroidism resulting in Cretinism, characterized by intellectual disability, short stature, and coarse facies." },
            { q: "Ideal and recommended exclusive source of nutrition for the first 6 months of life?", a: "Exclusive human breast milk." },
            { q: "Micronutrient that must be supplemented to all exclusively breastfed infants starting at birth?", a: "Vitamin D (400 IU daily)." },
            { q: "Age at which iron supplementation or iron-rich complementary foods should be introduced to term breastfed infants?", a: "4 to 6 months of age, when prenatal iron stores begin to deplete." },
            { q: "Major immunological factor present in high concentrations in breast milk colostrum?", a: "Secretory IgA (sIgA)." },
            { q: "Main carbohydrate component found in human breast milk and standard infant formulas?", a: "Lactose." },
            { q: "Primary protein ratio difference between human breast milk and unmodified cow's milk?", a: "Breast milk is whey-predominant (easy to digest); cow's milk is casein-predominant." },
            { q: "Absolute maternal contraindications to breastfeeding in developed countries?", a: "Maternal HIV infection, active untreated tuberculosis, illicit drug use, or infant classic galactosemia." },
            { q: "Minimum age at which unmodified whole cow's milk can be safely introduced into a child's diet?", a: "12 months of age." },
            { q: "Reason why unmodified cow's milk is prohibited before 12 months of age?", a: "Risk of occult gastrointestinal blood loss, iron deficiency anemia, and excessive renal solute load." },
            { q: "Typical caloric density of standard infant formula and mature breast milk?", a: "20 kilocalories per fluid ounce (kcal/oz)." },
            { q: "Definition of \"catch-up growth\" in a recovering FTT child?", a: "A growth rate exceeding the normal statistical velocity for age, allowing the child to return to their original channel." },
            { q: "Formula modification strategy used to meet the high caloric needs of recovering FTT infants?", a: "Concentrating formula recipes to 22, 24, or 27 kcal/oz under medical supervision." },
            { q: "Definition of pediatric overweight based on BMI percentile?", a: "BMI between the 85th and 94th percentiles for age and sex." },
            { q: "Definition of pediatric obesity based on BMI percentile?", a: "BMI equal to or greater than the 95th percentile for age and sex." },
            { q: "Cutaneous marker of insulin resistance often seen in obese children?", a: "Acanthosis nigricans, characterized by hyperpigmented, velvety plaques in intertriginous areas." },
            { q: "Orthopedic complication of adolescent obesity presenting with hip/knee pain and a limp?", a: "Slipped Capital Femoral Epiphysis (SCFE)." },
            { q: "Hepatic complication of pediatric obesity diagnosed via elevated ALT and ultrasound?", a: "Metabolic Dysfunction-Associated Steatotic Liver Disease (MASLD / formerly NAFLD)." },
            { q: "Neurological presentation of obesity presenting with headache, papilledema, and normal neuroimaging?", a: "Idiopathic Intracranial Hypertension (Pseudotumor Cerebri)." },
            { q: "Most common gastrointestinal genetic cause of FTT presenting with malabsorption and steatorrhea?", a: "Celiac Disease." },
            { q: "Initial serological screening test of choice for suspected Celiac Disease in children over 2 years?", a: "Tissue transglutaminase IgA (tTG-IgA) along with total serum IgA level." },
            { q: "Why must total IgA be measured when screening for Celiac Disease?", a: "To rule out selective IgA deficiency, which can cause false-negative tTG-IgA results." },
            { q: "Gastrointestinal condition presenting with projectile vomiting, metabolic alkalosis, and FTT?", a: "Hypertrophic Pyloric Stenosis." },
            { q: "Metabolic derangement classic for Hypertrophic Pyloric Stenosis?", a: "Hypokalemic, hypochloremic metabolic alkalosis." },
            { q: "Cardiac lesion category that causes organic FTT due to hypermetabolism and tachypnea?", a: "Large left-to-right shunts, such as Ventricular Septal Defects (VSD)." },
            { q: "Endocrine disorder presenting with weight loss or FTT despite a voracious appetite?", a: "Type 1 Diabetes Mellitus or Hyperthyroidism." },
            { q: "Renal pathology presenting with unexplained FTT, normal anion gap metabolic acidosis, and alkaline urine?", a: "Renal Tubular Acidosis (RTA)." },
            { q: "Screening test for a child with FTT, developmental delay, and unusual musty odor?", a: "Phenylketonuria (PKU) screening via serum phenylalanine levels." },
            { q: "Classic radiological finding on a hand/wrist X-ray of a child with prolonged FTT?", a: "Delayed bone age compared to chronological age." },
            { q: "Meaning of a child presenting with blue sclerae, osteopenia, and FTT?", a: "Suggests Osteogenesis Imperfecta or severe long-standing copper deficiency." },
            { q: "Physical sign of severe marasmus visible on the face?", a: "\"Monkey facies\" or \"aged look\" due to the loss of buccal fat pads." },
            { q: "Physical exam finding indicating severe dehydration in an infant with nutritional neglect?", a: "Sunken anterior fontanelle, dry mucous membranes, and delayed capillary refill." },
            { q: "Meaning of \"alligator skin\" or severe xerosis in a malnourished toddler?", a: "Suggests chronic essential fatty acid deficiency or Vitamin A deficiency." },
            { q: "Meaning of a child with FTT who exhibits \"doll-like\" facies, hepatomegaly, and fasting hypoglycemia?", a: "Suggests Von Gierke disease (Glycogen Storage Disease Type I)." },
            { q: "Clinical presentation of a child with FTT and a prominent \"frontal bossing\" skull configuration?", a: "Classic sign of advanced rachitic bone remodeling (Vitamin D deficiency)." },
            { q: "First line management step for a 9-month-old with mild non-organic FTT?", a: "Intensive nutritional counseling, establishing a regular feeding schedule, and close outpatient follow-up." },
            { q: "Indication that a child with FTT is receiving adequate catch-up caloric intake?", a: "Weight gain velocity up to 2 to 3 times the normal rate for chronological age." },
            { q: "Most common behavioral cause of inadequate caloric delivery in non-organic FTT?", a: "Improper dilution of infant formula by caregivers to save money." },
            { q: "Presentation of \"Water Intoxication\" in infants fed overly diluted formula?", a: "Hyponatremia presenting with lethargy, hypotonia, and generalized seizures." },
            { q: "Immediate management of an infant with hyponatremic seizures from diluted formula?", a: "Controlled administration of hypertonic (3%) saline to elevate serum sodium safely." },
            { q: "Primary environmental intervention required for successful treatment of psychosocial FTT?", a: "Implementation of structured meal times without distractions like television or tablets." },
            { q: "Major complication of untreated severe acute malnutrition on the gastrointestinal mucosa?", a: "Mucosal atrophy and loss of brush-border enzymes, causing transient secondary lactose intolerance." },
            { q: "Dietary management of transient lactose intolerance during recovery from malnutrition?", a: "Short-term use of lactose-free formula or slow, graded reintroduction of standard feeds." },
            { q: "Indication for introducing solid foods (complementary feeding) in standard infant development?", a: "Around 6 months of age, when developmental milestones like head control and tongue-thrust disappearance occur." },
            { q: "Nutritional syndrome to suspect in an infant fed exclusively unpasteurized goat's milk?", a: "Pure Folate deficiency anemia, as goat's milk is notoriously low in folic acid." },
            { q: "Growth chart pattern characteristic of GH deficiency or Hypothyroidism?", a: "Height percentile drops significantly before or simultaneously with the weight percentile drop." },
            { q: "Growth chart pattern characteristic of nutritional or gastrointestinal FTT?", a: "Weight percentile drops significantly while height percentile is initially preserved." },
            { q: "Serum parameter used as a sensitive, short-term indicator of nutritional status improvement?", a: "Prealbumin (transthyretin), due to its short half-life of roughly 2 days." },
            { q: "Serum parameter used as a long-term indicator of protein status over weeks?", a: "Albumin, due to its longer half-life of approximately 20 days." },
            { q: "Expected urinary finding in a child with prolonged starvation or Marasmus?", a: "Ketonuria, reflecting shifting metabolic pathways toward fatty acid oxidation." },
            { q: "Mechanism of edema resolution during the early treatment phase of Kwashiorkor?", a: "Diuresis of excess interstitial fluid as intravascular oncotic pressure normalizes." },
            { q: "Nutritional deficiency to suspect in a child with FTT, chronic diarrhea, and perianal fistulas?", a: "Crohn's disease (Inflammatory Bowel Disease)." },
            { q: "Immunization recommendation for children recovering from severe acute malnutrition?", a: "Administer all routine vaccines according to chronological age as soon as clinical stability is achieved." },
            { q: "First sign of puberty in males that may be delayed by severe chronic malnutrition?", a: "Testicular enlargement to a volume of 4 mL or greater." },
            { q: "First sign of puberty in females that may be delayed by severe chronic malnutrition?", a: "Thelarche (breast bud development)." },
            { q: "Expected finding on a peripheral blood smear in a child with severe Scurvy?", a: "Normocytic or macrocytic anemia, often complicated by co-existing iron deficiency." },
            { q: "Primary reason for checking a thyroid panel (TSH, Free T4) in a child with FTT?", a: "To rule out occult hypothyroidism (causes poor linear growth) or hyperthyroidism (causes weight loss)." },
            { q: "Metabolic complication to monitor when treating a child with severe rickets with high-dose Vitamin D?", a: "Hypercalcemia and hypercalciuria, which can lead to nephrocalcinosis." },
            { q: "Diagnostic finding on an EKG in a child with severe Hypokalemia from refeeding or malnutrition?", a: "Flattened T waves, ST depression, and prominent U waves." },
            { q: "Cardinal sign of hypervitaminosis A due to toxic over-supplementation?", a: "Pseudotumor cerebri, signs of increased intracranial pressure, and dry, peeling skin." },
            { q: "Next best step for an infant with FTT whose growth chart shows a sudden drop in weight but normal height, and history reveals a recent switch to home-prepared goat's milk?", a: "Switch to a standard iron-fortified infant formula and check a serum folate level." },
            { q: "Next best step for a 4-month-old infant with FTT, persistent non-bilious emesis, and a palpable olive-shaped mass in the right upper quadrant?", a: "Obtain a right upper quadrant abdominal ultrasound to confirm hypertrophic pyloric stenosis." },
            { q: "Next best step for a 6-week-old infant with FTT, prolonged jaundice, acholic stools, and dark urine?", a: "Obtain a serum fractionated bilirubin level and abdominal ultrasound to evaluate for biliary atresia." },
            { q: "Next best step for a 2-year-old with FTT, chronic foul-smelling diarrhea, and a history of recurrent pneumonia?", a: "Order a sweat chloride test to evaluate for Cystic Fibrosis." },
            { q: "Next best step for an asymptomatic 18-month-old with FTT whose screen shows positive tissue transglutaminase (tTG) IgA but normal total serum IgA?", a: "Refer to pediatric gastroenterology for an esophagogastroduodenoscopy (EGD) with duodenal biopsies." },
            { q: "Next best step for an exclusively breastfed 5-month-old whose weight has dropped from the 50th to the 5th percentile, with an otherwise entirely negative review of systems?", a: "Observe a live breastfeeding session to assess latch, milk transfer, and maternal technique." },
            { q: "Next best step for a 3-year-old immigrant child with bowed legs, costochondral swelling, and low serum calcium?", a: "Measure serum 25-hydroxyvitamin D level and obtain bilateral lower extremity radiographs." },
            { q: "Inborn error of metabolism presenting with FTT, cataracts, jaundice, and hepatomegaly soon after introducing milk?", a: "Classic Galactosemia (Galactose-1-phosphate uridyltransferase deficiency)." },
            { q: "Inborn error of metabolism presenting with FTT, severe vomiting, and hypoglycemia only after introducing fruits or juices?", a: "Hereditary Fructose Intolerance (Fructose-1-phosphate aldolase deficiency)." },
            { q: "Genetic syndrome presenting with FTT in infancy due to severe hypotonia and feeding difficulties, followed later by hyperphagia and obesity?", a: "Prader-Willi Syndrome." },
            { q: "Chromosomal abnormality in a female presenting with unexplained short stature, mild FTT, and a wide-spaced nipple appearance?", a: "Turner Syndrome (45,X)." },
            { q: "Storage disease presenting with FTT, massive hepatosplenomegaly, lymphadenopathy, and a cherry-red spot on the macula?", a: "Niemann-Pick Disease (Sphingomyelinase deficiency)." },
            { q: "Condition presenting with FTT, severe developmental delay, self-mutilation, and elevated uric acid?", a: "Lesch-Nyhan Syndrome (HGPRT deficiency)." },
            { q: "Differentiating growth chart pattern of Constitutional Delay of Growth vs. True Nutritional FTT?", a: "Constitutional delay shows a temporary drop followed by growth parallel to the lower curves with normal velocity; FTT shows progressive deviation away from the curves." },
            { q: "Differentiating lab feature between Vitamin D Deficiency Rickets and Vitamin D-Dependent Rickets Type I?", a: "Nutritional deficiency has low 25(OH)D; Type I has normal 25(OH)D but low 1,25(OH)2D due to 1-$\\alpha$-hydroxylase deficiency." },
            { q: "Differentiating presentation between Kwashiorkor and Nephrotic Syndrome in a toddler with generalized edema?", a: "Kwashiorkor presents with a normal urinalysis and distinct skin/hair changes; Nephrotic Syndrome presents with 4+ proteinuria and hyperlipidemia." },
            { q: "Differentiating factor between Cow's Milk Protein Allergy (CMPA) and Lactose Intolerance in an infant?", a: "CMPA presents with blood or mucus in the stool and systemic allergic signs; lactose intolerance causes watery, acidic stools without blood." },
            { q: "Differentiating baseline lab value between Type 1 and Type 2 Renal Tubular Acidosis (RTA) in FTT?", a: "Type 1 (Distal) features an inability to acidify urine (pH $\\1$); Type 2 (Proximal) features a normal ability to acidify urine during systemic acid load (pH $\\1$)." },
            { q: "Most critical risk factor in a maternal history predictive of non-organic Failure to Thrive?", a: "Maternal postpartum depression, severe social isolation, or substance abuse." },
            { q: "Definition of \"Munchausen Syndrome by Proxy\" (Medical Child Abuse) in the context of FTT?", a: "A caregiver intentionally falsifies, exaggerates, or induces medical symptoms/starvation in a child to gain medical attention." },
            { q: "Observation that strongly favors psychosocial FTT over an undiagnosed metabolic disorder during an inpatient admission?", a: "The child exhibits significant weight gain when fed exclusively by the nursing staff rather than the parent." },
            { q: "Legal obligation of a physician when a child with FTT shows clear signs of intentional caloric deprivation or physical neglect?", a: "Immediate mandatory report to Child Protective Services (CPS) and hospitalization for child safety." },
            { q: "Mineral deficiency presenting with impaired wound healing, altered taste (dysgeusia), and immune dysfunction, without skin lesions?", a: "Mild to moderate Zinc deficiency." },
            { q: "Classic radiological skeletal sign seen in a child with chronic Lead Poisoning (Plumbism)?", a: "\"Lead lines,\" which are hyperdense bands at the metaphyses of increased bone density." },
            { q: "Chronic toxic manifestation of excessive Vitamin D consumption in a toddler?", a: "Hypercalcemia leading to polyuria, polydipsia, constipation, and nephrocalcinosis." },
            { q: "Chronic toxic manifestation of excessive Vitamin A consumption in an adolescent treated for acne?", a: "Pseudotumor cerebri, bone pain, alopecia, and hepatosplenomegaly." },
            { q: "Primary site of iron absorption in the human pediatric gastrointestinal tract?", a: "The duodenum and proximal jejunum." },
            { q: "Primary site of Vitamin B12 and bile acid absorption in the gastrointestinal tract?", a: "The terminal ileum." },
            { q: "Reason why infants with short bowel syndrome after necrotizing enterocolitis (NEC) suffer from profound FTT?", a: "Massive reduction in mucosal surface area leading to generalized malabsorption of nutrients and fluids." },
            { q: "Specific amino acid that becomes conditionally essential in premature infants recovering from nutritional stress?", a: "Arginine or Cysteine." },
            { q: "Primary mechanism by which chronic inflammation (e.g., Crohn's disease) causes FTT besides malabsorption?", a: "Pro-inflammatory cytokines (like TNF-$\\alpha$) directly suppress appetite and alter the growth hormone-IGF-1 axis." },
            { q: "Immediate management of severe, symptomatic hypocalcemia (tetany/seizures) found during nutritional workup?", a: "Intravenous administration of 10% Calcium Gluconate under continuous cardiac monitoring." },
            { q: "Immediate fluid resuscitation choice for a severely malnourished, dehydrated child in hypovolemic shock?", a: "10 to 20 mL/kg bolus of isotonic crystalloid (Normal Saline or Ringer's Lactate) infused slowly over a longer period than standard shock protocols to avoid heart failure." },
            { q: "Serum glucose threshold defining neonatal hypoglycemia requiring immediate intervention?", a: "Less than 40 to 45 mg/dL." },
            { q: "First line treatment for an infant with symptomatic hypoglycemia?", a: "Intravenous bolus of 2 to 5 mL/kg of 10% Dextrose (D10W)." },
            { q: "An 11-month-old infant is at the 2nd percentile for weight, 50th for height, and 50th for head circumference. What does this isolated lag in weight point toward?", a: "Acute nutritional deprivation or acute-onset non-organic failure to thrive." },
            { q: "A 3-year-old child presents with a history of FTT, chronic diarrhea, and recurrent respiratory infections. A sweat test is borderline. What is the next diagnostic test?", a: "Genetic testing for CFTR gene mutations." },
            { q: "A child recovering from Kwashiorkor develops carpopedal spasms 48 hours after starting aggressive nutritional therapy. What is the cause?", a: "Refeeding syndrome resulting in profound hypokalemia or hypomagnesemia leading to functional hypocalcemia." },
            { q: "A 9-month-old infant presents with macrocytic anemia, irritability, and global developmental delay. The mother follows a strict vegan diet and exclusively breastfeeds. Deficiency of what nutrient explains this?", a: "Vitamin B12 (Cobalamin) deficiency." },
            { q: "A 14-month-old child presents with skeletal deformities, a broad forehead, and soft skull bones. Lab results show normal calcium, low phosphorus, and very high alkaline phosphatase. What is the diagnosis?", a: "Active nutritional Vitamin D deficiency rickets." },
            { q: "Standard caloric requirement (kcal/kg/day) for a healthy, growing infant under 6 months of age?", a: "Approximately 100 to 110 kcal/kg/day." },
            { q: "Estimated caloric requirement (kcal/kg/day) required to achieve effective catch-up growth in an infant with severe FTT?", a: "Roughly 1.5 to 2 times the expected requirement for age, often calculated as $150 \\text{ to } 200 \\text{ kcal/kg/day}$." },
            { q: "Simple formula used to calculate the exact caloric requirement for catch-up growth in a child with FTT?", a: "" },
            { q: "Fluid requirement formula (Holliday-Segar method) for a child weighing between 10 and 20 kg?", a: "$1000 \\text{ mL} + 50 \\text{ mL/kg}$ for every kilogram over 10 kg." },
            { q: "Expected average daily weight gain (grams/day) for a term infant during the first 3 months of life?", a: "Approximately 20 to 30 grams per day." },
            { q: "Congenital disorder presenting with severe FTT, dynamic non-infectious watery diarrhea from birth, and an acidic stool pH?", a: "Congenital Glucose-Galactose Malabsorption (SGLT1 mutation)." },
            { q: "Autosomal recessive disorder presenting with severe FTT, steatorrhea, acanthocytosis on peripheral smear, and zero serum apolipoprotein B?", a: "Abetalipoproteinemia." },
            { q: "Exocrine pancreatic insufficiency disorder presenting with FTT, chronic diarrhea, and cyclic neutropenia?", a: "Shwachman-Diamond Syndrome." },
            { q: "Differentiating factor between Shwachman-Diamond Syndrome and Cystic Fibrosis in a child with pancreatic exocrine insufficiency?", a: "Shwachman-Diamond features neutropenia/skeletal anomalies and a normal sweat chloride test." },
            { q: "Rare condition presenting with FTT, chronic watery diarrhea, and a striking failure to absorb dietary zinc despite normal intake?", a: "Acrodermatitis enteropathica (SLC39A4 mutation)." },
            { q: "Medication class used in pediatric epilepsy that drastically increases the hepatic clearance of Vitamin D, potentially causing rickets?", a: "Anticonvulsants (specifically Phenytoin, Phenobarbital, and Carbamazepine)." },
            { q: "Nutrient deficiency caused by chronic, therapeutic use of Sulfasalazine or Methotrexate in juvenile idiopathic arthritis?", a: "Folate (Vitamin B9) deficiency." },
            { q: "Chronic use of which over-the-counter medication class in infants can lead to systemic metabolic alkalosis and masked FTT?", a: "Exogenous bicarbonate or antacid overuse for severe infant reflux." },
            { q: "Diagnostic test of choice for a child with severe FTT, microcytic anemia, and dense metaphyseal bands on wrist X-rays?", a: "Serum blood lead level (BLL)." },
            { q: "Active forms of Vitamin D that must be administered to a child with FTT caused by end-stage chronic kidney disease?", a: "Calcitriol ($1,25\\text{-(OH)}_2\\text{D}_3$), bypassing the defective renal 1-$\\alpha$-hydroxylase enzyme." },
            { q: "Form of Vitamin D synthesized in human skin via exposure to ultraviolet B (UVB) radiation?", a: "Cholecalciferol (Vitamin $D_3$)." },
            { q: "Form of Vitamin D typically found in plant sources and used in select commercial dietary fortifications?", a: "Ergocalciferol (Vitamin $D_2$)." },
            { q: "Biochemical transformation impaired in a child with severe Scurvy?", a: "Hydroxylation of proline and lysine residues during collagen synthesis." },
            { q: "Enzyme cofactor role fulfilled by Thiamine ($B_1$) that is completely paralyzed during severe Beriberi?", a: "Cofactor for Pyruvate Dehydrogenase and $\\alpha$-Ketoglutarate Dehydrogenase." },
            { q: "Age by which a healthy term infant is expected to double their birth weight?", a: "4 to 5 months of age." },
            { q: "Age by which a healthy term infant is expected to triple their birth weight?", a: "12 months (1 year) of age." },
            { q: "Age by which a healthy term infant is expected to quadruple their birth weight?", a: "24 months (2 years) of age." },
            { q: "Expected average increase in head circumference during the first year of life?", a: "Approximately 12 centimeters total." },
            { q: "Average linear height increase expected for a healthy child during their first year of life?", a: "Approximately 25 centimeters (or a 50% increase from birth length)." }
          ]
        },
{
          section: 'Clinical Skills & Diagnostics',
          topic: "History taking & physical examination",
          icon: 'stethoscope',
          cards: [
            { q: "What are the seven core components of a comprehensive medical history?", a: "<b>1.</b> Chief Complaint (CC) <b>2.</b> History of Present Illness (HPI) <b>3.</b> Past Medical History (PMH) <b>4.</b> Medications & Allergies <b>5.</b> Family History (FH) <b>6.</b> Social History (SH) <b>7.</b> Review of Systems (ROS)" },
            { q: "What does the mnemonic OLDCARTS stand for in HPI characterization?", a: "<b>O</b>nset, <b>L</b>ocation, <b>D</b>uration, <b>C</b>haracter, <b>A</b>ggravating factors, <b>R</b>elieving factors, <b>T</b>iming/pattern, <b>S</b>everity (often on a 0–10 scale)" },
            { q: "What does the mnemonic OPQRST stand for and how does it differ from OLDCARTS?", a: "<b>O</b>nset, <b>P</b>rovocation/Palliation, <b>Q</b>uality, <b>R</b>egion/Radiation, <b>S</b>everity, <b>T</b>iming. It emphasizes provocation/palliation and radiation more explicitly than OLDCARTS." },
            { q: "Name the key elements that should be included in a Past Medical History (PMH).", a: "Prior illnesses & chronic conditions, surgeries, hospitalizations, obstetric history, psychiatric history, immunization status, screening tests, and current health maintenance activities." },
            { q: "What elements compose a thorough Social History?", a: "Occupation, education, living situation, marital/partner status, tobacco/alcohol/drug use (quantified), diet, exercise, sexual history (partners, practices, protection), travel, and safety (seatbelts, firearms, domestic violence screening)." },
            { q: "How should alcohol use be quantified in the social history?", a: "Record type, amount, and frequency. Use <b>CAGE</b> or <b>AUDIT</b> questionnaires for screening. One standard drink = 12 oz beer = 5 oz wine = 1.5 oz spirits. Document pack-years equivalent for chronic use." },
            { q: "What does the CAGE questionnaire screen for?", a: "Problem drinking. <b>C</b> – felt need to Cut down; <b>A</b> – Annoyed by criticism of drinking; <b>G</b> – felt Guilty about drinking; <b>E</b> – needed an Eye-opener. ≥2 'yes' answers is a positive screen." },
            { q: "List the organ systems reviewed in a complete Review of Systems (ROS).", a: "Constitutional, HEENT, cardiovascular, respiratory, GI, genitourinary, musculoskeletal, skin, neurological, psychiatric, endocrine, hematologic/lymphatic, and allergic/immunologic." },
            { q: "What constitutional symptoms are asked about in the ROS?", a: "Fever, chills, night sweats, fatigue, malaise, unintentional weight loss or gain, and changes in appetite." },
            { q: "What is the difference between a symptom and a sign?", a: "A <b>symptom</b> is a subjective experience reported by the patient (e.g., pain, nausea). A <b>sign</b> is an objective finding observed or measured by the clinician (e.g., jaundice, hepatomegaly)." },
            { q: "What are the four vital signs traditionally measured, and what is the commonly added 'fifth vital sign'?", a: "<b>Traditional four:</b> Temperature, Heart Rate (pulse), Respiratory Rate, Blood Pressure. The <b>fifth vital sign</b> is pain (or, increasingly, oxygen saturation via pulse oximetry)." },
            { q: "What is the normal adult resting heart rate range?", a: "60–100 beats per minute. <b>Bradycardia</b> < 60 bpm; <b>Tachycardia</b> > 100 bpm." },
            { q: "What is the normal adult respiratory rate?", a: "12–20 breaths per minute at rest. Tachypnea > 20; bradypnea < 12." },
            { q: "How is orthostatic hypotension defined?", a: "A drop in systolic BP ≥ 20 mmHg or diastolic BP ≥ 10 mmHg, or an increase in heart rate ≥ 20 bpm, within 3 minutes of standing from a supine position." },
            { q: "How is BMI calculated and what are its classification ranges?", a: "$\\\\text{BMI} = \\\\frac{\\\\text{weight (kg)}}{\\\\text{height (m)}^2}$. <b>Underweight</b> < 18.5; <b>Normal</b> 18.5–24.9; <b>Overweight</b> 25–29.9; <b>Obese</b> ≥ 30." },
            { q: "What does the General Survey assess at the beginning of a physical exam?", a: "Overall appearance, level of distress, nutritional status, body habitus, hygiene/grooming, posture, gait, mental status/alertness, and any obvious deformities or abnormalities." },
            { q: "What are the components of a basic Mental Status Examination (MSE)?", a: "Appearance, behavior, speech, mood (patient-reported), affect (observed), thought process, thought content, perceptions, cognition (orientation, attention, memory), insight, and judgment." },
            { q: "What is the Mini-Mental State Examination (MMSE) and what score suggests cognitive impairment?", a: "A 30-point screening tool assessing orientation, registration, attention/calculation, recall, and language. A score <b>≤ 24/30</b> suggests cognitive impairment." },
            { q: "What nutritional assessment findings suggest protein-calorie malnutrition?", a: "Temporal wasting, loss of subcutaneous fat, muscle wasting (especially thenar/interosseous muscles), peripheral edema (hypoalbuminemia), poor wound healing, and brittle hair/nails." },
            { q: "What are the key steps in examining the head?", a: "Inspect size, shape, symmetry; palpate skull for tenderness, masses, or depressions; examine hair distribution and scalp for lesions; assess facial symmetry and expressions." },
            { q: "Describe the proper technique for fundoscopic (ophthalmoscopic) examination.", a: "Darken the room; use your right eye/right hand for the patient's right eye. Set diopter to 0, approach at ~15° temporally, identify the red reflex, then focus on the optic disc, vessels, macula. Assess for disc margins, cup-to-disc ratio, AV nicking, hemorrhages, and exudates." },
            { q: "What is the normal cup-to-disc ratio, and what does an increased ratio suggest?", a: "Normal is <b>< 0.5</b>. An increased cup-to-disc ratio (≥ 0.5) raises concern for <b>glaucoma</b>." },
            { q: "How do you test visual acuity and what is normal?", a: "Use a <b>Snellen chart</b> at 20 feet. Normal acuity is <b>20/20</b>. The numerator is the test distance; the denominator is the distance at which a normal eye reads that line." },
            { q: "What are the six cardinal positions of gaze and what do they test?", a: "They test the six extraocular muscles and cranial nerves III, IV, and VI. Positions: right/up, right, right/down, left/up, left, left/down. The examiner traces an 'H' pattern." },
            { q: "How is the Weber test performed and interpreted?", a: "A vibrating 512 Hz tuning fork is placed on the midline vertex. <b>Normal:</b> sound heard equally. <b>Conductive loss:</b> lateralizes to the affected ear. <b>Sensorineural loss:</b> lateralizes to the unaffected ear." },
            { q: "How is the Rinne test performed and interpreted?", a: "Place a vibrating 512 Hz fork on the mastoid (bone conduction), then next to the ear canal (air conduction). <b>Normal:</b> AC > BC. <b>Conductive loss:</b> BC > AC (abnormal Rinne). <b>Sensorineural loss:</b> AC > BC but both diminished." },
            { q: "What lymph node groups are palpated during a head and neck exam?", a: "Pre-auricular, posterior auricular, occipital, tonsillar, submandibular, submental, superficial cervical, posterior cervical, deep cervical chain, and supraclavicular nodes." },
            { q: "What is the significance of a palpable left supraclavicular lymph node (Virchow's node)?", a: "It is associated with <b>abdominal malignancy</b>, classically gastric cancer. The finding is called <b>Troisier's sign</b> and represents metastatic spread via the thoracic duct." },
            { q: "Describe the proper technique for thyroid palpation.", a: "Stand behind the patient (or face them). Have the patient swallow water while you palpate the thyroid isthmus and lobes. Displace the trachea gently to each side to better palpate each lobe. Note size, consistency, nodules, and tenderness." },
            { q: "How is jugular venous pressure (JVP) measured?", a: "Position the patient at <b>45°</b>. Identify the highest point of the internal jugular venous pulsation. Measure the vertical distance from the <b>sternal angle</b> to that point. Normal JVP is <b>≤ 4 cm</b> above the sternal angle (add 5 cm for estimated RA pressure, normal < 9 cm H₂O)." },
            { q: "How do you differentiate the internal jugular vein pulsation from the carotid artery pulse?", a: "IJV: <b>biphasic</b>, non-palpable, varies with respiration and position, obliterated by gentle pressure, descends with inspiration. Carotid: <b>monophasic</b>, palpable, does not vary with position/respiration, not obliterated by pressure." },
            { q: "What is hepatojugular reflux (abdominojugular test) and what does a positive test indicate?", a: "Firm sustained pressure over the RUQ for 10–15 seconds while observing the JVP. A sustained rise in JVP ≥ 4 cm indicates <b>right heart failure</b> or volume overload." },
            { q: "What are the components of the cardiovascular exam in order?", a: "<b>Inspection</b> (JVD, precordial heave, scars), <b>Palpation</b> (PMI, thrills, heaves), <b>Auscultation</b> (heart sounds at 4 valve areas with bell and diaphragm). Also assess peripheral pulses and edema." },
            { q: "Where is the point of maximal impulse (PMI) normally located?", a: "Left <b>5th intercostal space</b>, midclavicular line. Displacement laterally or inferiorly suggests <b>LV enlargement</b>." },
            { q: "What are the four classic auscultation areas and what valves do they represent?", a: "<b>Aortic:</b> right 2nd ICS. <b>Pulmonic:</b> left 2nd ICS. <b>Tricuspid:</b> left lower sternal border. <b>Mitral:</b> apex (5th ICS, MCL). Erb's point (left 3rd ICS) is also routinely auscultated." },
            { q: "What produces the first heart sound (S1)?", a: "Closure of the <b>mitral and tricuspid valves</b> (AV valves) at the onset of systole. Best heard at the apex." },
            { q: "What produces the second heart sound (S2)?", a: "Closure of the <b>aortic and pulmonic valves</b> (semilunar valves) at the onset of diastole. Best heard at the base (2nd ICS)." },
            { q: "What is physiologic splitting of S2?", a: "During <b>inspiration</b>, increased venous return delays pulmonic valve closure, causing audible A2-P2 splitting. It <b>disappears on expiration</b>. Best heard at the left 2nd ICS." },
            { q: "What is paradoxical (reversed) splitting of S2 and what causes it?", a: "S2 splits on <b>expiration</b> and becomes single on inspiration (P2 before A2). Caused by delayed aortic closure: <b>LBBB</b>, aortic stenosis, severe HTN, or RV pacing." },
            { q: "What does a fixed split S2 indicate?", a: "<b>Atrial septal defect (ASD)</b>. The fixed increase in RV volume prevents normal respiratory variation in splitting." },
            { q: "When is S3 heard and what does it signify?", a: "A low-pitched sound in <b>early diastole</b> (after S2), best heard at the apex with the bell. In young adults it may be physiologic. In older adults it suggests <b>volume overload / heart failure</b> (↑ ventricular filling pressure)." },
            { q: "When is S4 heard and what does it signify?", a: "A low-pitched sound in <b>late diastole</b> (just before S1), caused by atrial contraction against a stiff/non-compliant ventricle. Always pathologic in adults — suggests <b>diastolic dysfunction, LVH, or ischemia</b>." },
            { q: "How are murmurs graded on the Levine scale?", a: "<b>I:</b> barely audible. <b>II:</b> soft but heard. <b>III:</b> moderately loud, no thrill. <b>IV:</b> loud with palpable thrill. <b>V:</b> very loud, heard with stethoscope barely on chest. <b>VI:</b> heard with stethoscope off the chest." },
            { q: "How does the Valsalva maneuver affect murmurs?", a: "Valsalva ↓ preload. Most murmurs <b>decrease</b> in intensity. Exceptions: <b>HCM</b> murmur gets louder and <b>mitral valve prolapse</b> click occurs earlier." },
            { q: "How does squatting affect murmurs?", a: "Squatting ↑ preload and afterload. Most murmurs get <b>louder</b>. Exceptions: <b>HCM</b> murmur gets softer and <b>MVP</b> click is delayed." },
            { q: "How does standing from squatting affect the murmur of HCM?", a: "Standing ↓ preload → smaller LV cavity → greater outflow obstruction → <b>HCM murmur gets louder</b>." },
            { q: "What effect does isometric handgrip have on murmurs?", a: "Handgrip ↑ afterload → <b>increases</b> regurgitant murmurs (MR, AR, VSD) and <b>decreases</b> AS and HCM murmurs." },
            { q: "Describe the murmur of mitral stenosis.", a: "Low-pitched <b>diastolic rumble</b> with opening snap, best heard at the apex with the <b>bell</b> in the left lateral decubitus position. May have presystolic accentuation if in sinus rhythm." },
            { q: "Describe the murmur of aortic stenosis.", a: "<b>Crescendo-decrescendo systolic</b> murmur at the right 2nd ICS, radiating to the carotids. Associated with pulsus parvus et tardus (weak, delayed pulse). Decreases with Valsalva." },
            { q: "What is the proper sequence of the respiratory examination?", a: "<b>Inspection → Palpation → Percussion → Auscultation</b> (front and back). This is the standard sequence for chest exam." },
            { q: "What do you inspect for during the respiratory examination?", a: "Respiratory rate, rhythm, depth, chest wall symmetry, use of accessory muscles, intercostal retractions, tracheal deviation, barrel chest, kyphosis/scoliosis, and any scars or skin changes." },
            { q: "What is tactile (vocal) fremitus and how is it assessed?", a: "Palpable vibration transmitted through the chest wall when the patient says '99.' Use the ulnar surface of the hand bilaterally. <b>Increased</b> in consolidation; <b>decreased</b> in pleural effusion, pneumothorax, or emphysema." },
            { q: "What are the normal percussion notes over the lung and how do they change with pathology?", a: "<b>Resonant</b> = normal lung. <b>Hyperresonant</b> = pneumothorax, emphysema. <b>Dull</b> = consolidation, pleural effusion, atelectasis. <b>Flat</b> = large effusion, muscle mass." },
            { q: "Describe the technique for diaphragmatic excursion assessment.", a: "Percuss down the posterior chest during full inspiration and mark where resonance changes to dullness, then repeat on expiration. Normal diaphragmatic excursion is <b>3–5 cm</b> bilaterally." },
            { q: "What are the three types of normal breath sounds?", a: "<b>Vesicular:</b> soft, low-pitched, inspiration > expiration (most lung fields). <b>Bronchovesicular:</b> equal I:E ratio (1st–2nd ICS, interscapular). <b>Bronchial:</b> loud, high-pitched, expiration > inspiration (over trachea)." },
            { q: "What adventitious lung sounds may be heard and what do they suggest?", a: "<b>Crackles (rales):</b> fine = fibrosis, CHF; coarse = pneumonia, bronchiectasis. <b>Wheezes:</b> high-pitched = airway narrowing (asthma, COPD). <b>Rhonchi:</b> low-pitched = secretions in large airways. <b>Stridor:</b> inspiratory = upper airway obstruction. <b>Pleural rub:</b> pleurisy." },
            { q: "What is egophony and what does it indicate?", a: "The patient says 'EE' and the examiner hears '<b>AY</b>' through the stethoscope. It indicates <b>consolidation</b> (e.g., pneumonia) above a pleural effusion where lung is compressed." },
            { q: "What is whispered pectoriloquy?", a: "Whispered words are heard <b>clearly and distinctly</b> through the stethoscope over an area of <b>consolidation</b>. Normally whispered sounds are faint and indistinct." },
            { q: "What is bronchophony?", a: "Spoken words (e.g., '99') are heard <b>louder and more clearly</b> than normal over areas of <b>consolidation</b>." },
            { q: "Compare the physical findings in pneumothorax vs. pleural effusion vs. consolidation.", a: "<b>Pneumothorax:</b> ↓ fremitus, hyperresonant, ↓ breath sounds. <b>Effusion:</b> ↓ fremitus, dull, ↓ breath sounds. <b>Consolidation:</b> ↑ fremitus, dull, bronchial breath sounds, + egophony." },
            { q: "Why is the abdominal exam sequence different from other exams?", a: "The order is <b>Inspection → Auscultation → Percussion → Palpation</b>. Auscultation is performed <b>before</b> percussion/palpation to avoid altering bowel sounds." },
            { q: "What should be noted during inspection of the abdomen?", a: "Contour (flat, scaphoid, distended, protuberant), symmetry, visible peristalsis, pulsations, scars, striae, hernias, caput medusae, skin changes, and the umbilicus." },
            { q: "What are normal bowel sounds and what do abnormal patterns suggest?", a: "Normal: 5–34 clicks/gurgles per minute. <b>Hyperactive/high-pitched:</b> early obstruction, gastroenteritis, diarrhea. <b>Absent</b> (listen ≥ 2 min): ileus, peritonitis, late obstruction." },
            { q: "What does a bruit heard over the abdomen suggest, and at what locations do you auscultate?", a: "A bruit suggests <b>vascular stenosis or turbulent flow</b>. Auscultate over the aorta (epigastric), renal arteries (flanks), iliac arteries (lower quadrants), and femoral arteries (inguinal). Renal artery bruit → renovascular hypertension." },
            { q: "How do you assess liver span by percussion?", a: "Percuss in the <b>right MCL</b> from resonance (lung) to dullness (liver upper border), then from tympany (abdomen) to dullness (lower border). Normal liver span is <b>6–12 cm</b> in the MCL." },
            { q: "How is splenic enlargement assessed by percussion?", a: "Percuss <b>Traube's space</b> (left 6th rib to left costal margin, anterior axillary line). Normally tympanitic. <b>Dullness</b> suggests splenomegaly. Also percuss the lowest intercostal space in the left anterior axillary line during inspiration." },
            { q: "What is Murphy's sign and what does a positive test indicate?", a: "Hook fingers under the right costal margin at the MCL and ask the patient to inhale deeply. A positive sign is <b>inspiratory arrest</b> due to pain when the inflamed gallbladder descends onto the fingers. Suggests <b>acute cholecystitis</b>." },
            { q: "What is McBurney's point and its clinical significance?", a: "A point <b>one-third</b> the distance from the ASIS to the umbilicus. Tenderness here is classically associated with <b>acute appendicitis</b>." },
            { q: "What is Rovsing's sign?", a: "Palpation of the <b>left lower quadrant</b> causes pain in the <b>right lower quadrant</b>. It suggests <b>peritoneal irritation</b> from appendicitis (referred rebound tenderness)." },
            { q: "What is the psoas sign and what does it indicate?", a: "Pain on <b>passive extension</b> of the right hip (or active flexion against resistance) indicating irritation of the <b>psoas muscle</b> by a retrocecal appendix or psoas abscess." },
            { q: "What is the obturator sign?", a: "Pain on <b>internal rotation</b> of the flexed right hip, suggesting irritation of the obturator internus by a <b>pelvic appendix</b> or pelvic abscess." },
            { q: "How do you test for rebound tenderness and what does it indicate?", a: "Press slowly and deeply into the abdomen, then <b>quickly release</b>. Pain on release indicates <b>peritoneal inflammation</b>. To reduce patient guarding, use gentle percussion instead (tap tenderness)." },
            { q: "How do you assess for shifting dullness in ascites?", a: "Percuss from midline laterally; mark where resonance becomes dull. Roll patient onto opposite side and wait 30 seconds; percuss again. If the dullness shifts to the dependent side, <b>ascites</b> is present (requires ~500 mL of fluid)." },
            { q: "What is the fluid wave test?", a: "With an assistant's hand pressing the midline (to block subcutaneous fat wave), tap one flank and feel for a transmitted <b>impulse</b> on the other. Positive test suggests <b>significant ascites</b>." },
            { q: "List cranial nerves I–XII with their primary functions.", a: "<b>I</b> Olfactory (smell) <b>II</b> Optic (vision) <b>III</b> Oculomotor (eye movement, pupil) <b>IV</b> Trochlear (superior oblique) <b>V</b> Trigeminal (facial sensation, mastication) <b>VI</b> Abducens (lateral rectus) <b>VII</b> Facial (facial expression, taste ant. 2/3) <b>VIII</b> Vestibulocochlear (hearing, balance) <b>IX</b> Glossopharyngeal (taste post. 1/3, pharynx) <b>X</b> Vagus (pharynx, larynx, viscera) <b>XI</b> Accessory (SCM, trapezius) <b>XII</b> Hypoglossal (tongue movement)" },
            { q: "How is CN I (olfactory) tested?", a: "With eyes closed, present a <b>familiar non-irritating scent</b> (coffee, vanilla) to each nostril separately. Avoid ammonia or alcohol (they stimulate CN V, not CN I)." },
            { q: "How are CN III, IV, and VI tested together?", a: "Test <b>extraocular movements</b> through the six cardinal positions of gaze ('H' pattern). Also check pupil size, direct and consensual light reflexes, and accommodation (CN III)." },
            { q: "How do you test the motor and sensory divisions of CN V (trigeminal)?", a: "<b>Sensory:</b> light touch and pin-prick in 3 divisions (ophthalmic V1, maxillary V2, mandibular V3). <b>Motor:</b> palpate masseter and temporalis while patient clenches jaw. <b>Corneal reflex:</b> afferent V1, efferent VII." },
            { q: "How is CN VII (facial nerve) tested?", a: "Ask patient to raise eyebrows, close eyes tightly, smile/show teeth, puff cheeks. <b>UMN lesion:</b> contralateral lower face weakness only (forehead spared). <b>LMN lesion (Bell's palsy):</b> ipsilateral entire hemiface weakness." },
            { q: "Why is the forehead spared in upper motor neuron CN VII lesions?", a: "The upper face receives <b>bilateral</b> upper motor neuron innervation, so a unilateral UMN lesion is compensated by the intact side. The lower face receives only <b>contralateral</b> UMN input." },
            { q: "How are CN IX and X tested?", a: "Say 'Ahh' — observe symmetric palatal elevation (uvula midline). <b>CN X lesion:</b> uvula deviates away from the lesion. Test gag reflex (afferent IX, efferent X). Assess voice quality (hoarseness → recurrent laryngeal nerve/CN X)." },
            { q: "How is CN XI (spinal accessory) tested?", a: "Ask the patient to <b>shrug shoulders</b> (trapezius) and <b>turn head</b> against resistance (SCM). The SCM turns the head to the <b>opposite</b> side, so a left CN XI lesion weakens right head turn." },
            { q: "How is CN XII (hypoglossal) tested?", a: "Ask the patient to <b>protrude the tongue</b>. An LMN lesion causes the tongue to deviate <b>toward the side of the lesion</b> (due to unopposed contralateral muscle). Also inspect for fasciculations and atrophy." },
            { q: "How is muscle strength graded on the MRC scale?", a: "<b>0:</b> no contraction. <b>1:</b> flicker/trace. <b>2:</b> movement with gravity eliminated. <b>3:</b> movement against gravity only. <b>4:</b> movement against some resistance. <b>5:</b> full strength (normal)." },
            { q: "What is the difference between upper and lower motor neuron weakness patterns?", a: "<b>UMN:</b> spastic tone (↑), hyperreflexia, + Babinski, no fasciculations, no significant atrophy (disuse only). <b>LMN:</b> flaccid tone (↓), hyporeflexia/areflexia, − Babinski, fasciculations, early significant atrophy." },
            { q: "How are deep tendon reflexes graded?", a: "<b>0:</b> absent. <b>1+:</b> diminished (may be normal). <b>2+:</b> normal. <b>3+:</b> brisk (may be normal). <b>4+:</b> clonus (always abnormal)." },
            { q: "What spinal levels correspond to the common deep tendon reflexes?", a: "<b>Biceps:</b> C5–C6. <b>Brachioradialis:</b> C5–C6. <b>Triceps:</b> C6–C7. <b>Patellar (knee):</b> L3–L4. <b>Achilles (ankle):</b> S1–S2." },
            { q: "What is the Babinski sign and what does a positive response indicate?", a: "Stroke the lateral plantar surface from heel to toe. <b>Positive (abnormal):</b> dorsiflexion of great toe with fanning of other toes → indicates <b>upper motor neuron lesion</b>. Normal in infants < 1 year." },
            { q: "What sensory modalities are tested in a neurological exam and what tracts do they assess?", a: "<b>Light touch & proprioception/vibration:</b> dorsal columns (ipsilateral). <b>Pain & temperature (pinprick):</b> spinothalamic tract (contralateral). <b>Cortical sensation</b> (stereognosis, graphesthesia, two-point discrimination): parietal cortex." },
            { q: "How is the Romberg test performed and interpreted?", a: "Patient stands with <b>feet together and eyes closed</b>. <b>Positive:</b> patient sways/falls → indicates <b>dorsal column (proprioceptive) dysfunction</b>. A cerebellar lesion causes imbalance even with eyes open." },
            { q: "What cerebellar tests should be performed?", a: "<b>Finger-to-nose</b> (dysmetria), <b>heel-to-shin</b>, <b>rapid alternating movements</b> (dysdiadochokinesia), <b>gait</b> (wide-based, ataxic), and <b>Romberg test</b>. Also assess for intention tremor and nystagmus." },
            { q: "Name the common gait abnormalities and their localizations.", a: "<b>Spastic/scissoring:</b> bilateral UMN. <b>Steppage:</b> foot drop (peroneal nerve/L5). <b>Waddling:</b> proximal myopathy. <b>Ataxic (wide-based):</b> cerebellar. <b>Parkinsonian:</b> shuffling, festinating. <b>Hemiplegic:</b> circumduction (stroke)." },
            { q: "What is the Lachman test and what does it assess?", a: "With the knee flexed <b>20–30°</b>, stabilize the femur and pull the tibia anteriorly. Increased anterior translation with a soft endpoint indicates an <b>anterior cruciate ligament (ACL) tear</b>. More sensitive than the anterior drawer test." },
            { q: "How is the McMurray test performed and what does it assess?", a: "With the patient supine, flex the knee fully, then externally rotate the tibia and extend the knee slowly. A <b>palpable click or pain</b> along the joint line suggests a <b>medial meniscus tear</b>. Internal rotation tests the lateral meniscus." },
            { q: "Describe the anterior and posterior drawer tests.", a: "Patient supine, knee flexed 90°, foot flat. <b>Anterior drawer:</b> pull tibia forward → excessive movement = <b>ACL</b> injury. <b>Posterior drawer:</b> push tibia backward → excessive movement = <b>PCL</b> injury." },
            { q: "What is Phalen's test and what does it diagnose?", a: "Maximally flex both wrists and hold for 60 seconds. <b>Positive:</b> paresthesias or numbness in the <b>median nerve</b> distribution (thumb, index, middle, lateral ring finger) → <b>carpal tunnel syndrome</b>." },
            { q: "What is Tinel's sign at the wrist?", a: "Tapping over the <b>carpal tunnel</b> (volar wrist) produces <b>tingling/paresthesias</b> in the median nerve distribution → positive for <b>carpal tunnel syndrome</b>." },
            { q: "What are the components of a joint examination?", a: "Remember <b>'Look, Feel, Move'</b>: <b>Inspection</b> (swelling, erythema, deformity, muscle wasting), <b>Palpation</b> (warmth, tenderness, effusion, crepitus), and <b>Range of Motion</b> (active then passive)." },
            { q: "What are primary skin lesions?", a: "<b>Macule:</b> flat, < 1 cm. <b>Patch:</b> flat, > 1 cm. <b>Papule:</b> raised, < 1 cm. <b>Plaque:</b> raised, > 1 cm. <b>Nodule:</b> palpable, > 1 cm deep. <b>Vesicle:</b> fluid-filled, < 1 cm. <b>Bulla:</b> fluid-filled, > 1 cm. <b>Pustule:</b> pus-filled. <b>Wheal:</b> edematous, evanescent." },
            { q: "What are secondary skin lesions?", a: "<b>Scale:</b> flaking keratin. <b>Crust:</b> dried serum/blood. <b>Erosion:</b> loss of epidermis. <b>Ulcer:</b> loss through dermis. <b>Fissure:</b> linear crack. <b>Atrophy:</b> thinning. <b>Lichenification:</b> thickened skin with accentuated markings. <b>Excoriation:</b> scratch marks." },
            { q: "How should you describe the distribution of a skin lesion?", a: "Note: <b>localized vs. generalized</b>, <b>dermatomal</b> (herpes zoster), <b>sun-exposed areas</b> (photosensitivity), <b>extensor vs. flexor</b> surfaces, <b>bilateral/symmetric</b> (psoriasis), and <b>intertriginous</b> (candida). Distribution provides key diagnostic clues." },
            { q: "How is capillary refill time assessed and what is normal?", a: "Compress the nail bed for 5 seconds, then release and time the return of color. <b>Normal < 2 seconds</b>. Prolonged refill suggests <b>peripheral vasoconstriction, dehydration, or shock</b>." },
            { q: "Where are peripheral pulses assessed and how are they graded?", a: "Radial, brachial, carotid, femoral, popliteal, dorsalis pedis, posterior tibial. <b>Grading:</b> 0 = absent, 1+ = diminished, 2+ = normal, 3+ = bounding." },
            { q: "What is the ankle-brachial index (ABI) and how is it interpreted?", a: "$\\\\text{ABI} = \\\\frac{\\\\text{Ankle systolic BP}}{\\\\text{Brachial systolic BP}}$. <b>Normal:</b> 1.0–1.3. <b>Mild PAD:</b> 0.7–0.9. <b>Moderate PAD:</b> 0.4–0.69. <b>Severe PAD/critical ischemia:</b> < 0.4. <b>> 1.3:</b> non-compressible (calcified) vessels." },
            { q: "How do you differentiate arterial from venous insufficiency on exam?", a: "<b>Arterial:</b> cool, pale, hairless limbs; absent pulses; dependent rubor; elevation pallor; painful ulcers at distal tips/between toes. <b>Venous:</b> warm, edematous; brown hemosiderin staining; varicosities; painless/mildly painful ulcers at medial malleolus." },
            { q: "What should the pediatric-specific history include beyond the standard adult history?", a: "<b>Birth history</b> (gestational age, delivery type, complications, APGAR), <b>neonatal history</b>, <b>feeding/nutrition</b> (breast vs. bottle), <b>developmental milestones</b> (gross/fine motor, language, social), <b>immunization record</b>, growth parameters, behavioral/school history." },
            { q: "What are the APGAR score components and how is it scored?", a: "<b>A</b>ppearance (color), <b>P</b>ulse (heart rate), <b>G</b>rimace (reflex irritability), <b>A</b>ctivity (muscle tone), <b>R</b>espiration. Each scored 0–2, total 0–10, assessed at 1 and 5 minutes. Score 7–10 = normal." },
            { q: "What vital sign differences are expected in pediatric patients?", a: "Children have <b>higher heart rates</b> and <b>respiratory rates</b> than adults, with values decreasing with age. <b>Blood pressure</b> is lower and increases with age. Use age-appropriate percentile charts. Neonatal HR: 120–160; RR: 30–60." },
            { q: "What unique physical exam considerations apply to geriatric patients?", a: "Expect ↑ systolic BP (arterial stiffness), S4 gallop, kyphosis, ↓ skin turgor (unreliable for dehydration), arcus senilis, presbycusis, ↓ DTRs, slower gait. Use functional assessments (ADLs, IADLs). Screen for cognition (MMSE/MoCA), depression (GDS), falls, polypharmacy." },
            { q: "What modifications to the physical exam are needed during pregnancy?", a: "Expect ↑ HR, ↓ BP in 2nd trimester (rises in 3rd), physiologic systolic flow murmur, displaced PMI, ↑ RR, spider angiomata, palmar erythema, linea nigra, lordosis. <b>Avoid supine position</b> late in pregnancy (aortocaval compression); examine in left lateral tilt." },
            { q: "What is Leopold's maneuvers and when are they used?", a: "Four abdominal palpation maneuvers performed in <b>late pregnancy</b> to determine fetal lie, presentation, position, and engagement. <b>1st:</b> fundal grip (breech vs. cephalic). <b>2nd:</b> lateral palpation (fetal back). <b>3rd:</b> Pawlik's grip (presenting part). <b>4th:</b> pelvic grip (engagement)." },
            { q: "What does the SOAP note format stand for?", a: "<b>S</b>ubjective (patient's history, symptoms, complaints), <b>O</b>bjective (exam findings, vitals, labs, imaging), <b>A</b>ssessment (diagnosis/differential), <b>P</b>lan (further workup, treatment, follow-up)." },
            { q: "What is a problem list and how should it be maintained?", a: "A <b>dynamic, numbered list</b> of all active and resolved medical problems organized by priority. Each problem should be as specific as possible (diagnosis > symptom). It is updated at each visit and serves as a quick reference for ongoing care." },
            { q: "What is the difference between open-ended and closed-ended questions in history taking?", a: "<b>Open-ended:</b> 'Tell me about your chest pain' — encourages narrative, captures patient's perspective, used early in interview. <b>Closed-ended:</b> 'Is the pain sharp or dull?' — specific, efficient, used to clarify details later in the interview." },
            { q: "What communication techniques improve patient rapport during history taking?", a: "<b>Active listening</b>, empathic statements ('That sounds difficult'), <b>facilitation</b> ('Go on…'), <b>reflection</b> (echoing back), <b>summarization</b>, appropriate silence, avoiding medical jargon, and maintaining eye contact." },
            { q: "What is the proper technique for blood pressure measurement?", a: "Patient seated ≥ 5 min, arm at heart level, appropriate cuff size (bladder encircles ≥ 80% of arm). Inflate 20–30 mmHg above palpated systolic. Deflate 2–3 mmHg/sec. <b>Korotkoff sounds:</b> phase I = systolic, phase V (disappearance) = diastolic." },
            { q: "What error results from using a BP cuff that is too small?", a: "A cuff that is <b>too small</b> gives a <b>falsely elevated</b> reading. A cuff that is too large gives a falsely low reading." },
            { q: "How is pulsus paradoxus measured and what does it indicate?", a: "Inflate cuff above systolic, deflate slowly. Note pressure when Korotkoff sounds first heard (inspiration only) and when heard throughout cycle. Difference > <b>10 mmHg</b> = pulsus paradoxus. Causes: <b>cardiac tamponade</b>, severe asthma, constrictive pericarditis." },
            { q: "What is a heave vs. a thrill on cardiac palpation?", a: "A <b>heave (lift)</b> is a sustained, lifting impulse felt with the palm — parasternal heave indicates <b>RV hypertrophy</b>. A <b>thrill</b> is a palpable vibration (like a purring cat) corresponding to a grade ≥ IV murmur." },
            { q: "How do you distinguish an S3 gallop from a split S2?", a: "S3 is a <b>low-pitched</b> sound best heard with the <b>bell at the apex</b> in left lateral decubitus; it occurs later after S2. Split S2 is heard at the <b>base (pulmonic area)</b> with the diaphragm and varies with respiration." },
            { q: "What is the significance of a barrel chest on inspection?", a: "Increased AP diameter (AP:lateral ratio approaching 1:1) suggests <b>COPD/emphysema</b> with chronic hyperinflation. Normal AP:lateral ratio is approximately 1:2." },
            { q: "What is dullness to percussion at the lung base most likely caused by?", a: "<b>Pleural effusion</b> (most common), but also consolidation, hemothorax, or elevated hemidiaphragm (atelectasis). In effusion, the dullness has a concave meniscus (higher laterally) — Damoiseau's line." },
            { q: "What is the difference between light and deep abdominal palpation?", a: "<b>Light palpation</b> (~1 cm depth): assesses superficial tenderness, guarding, and masses. <b>Deep palpation</b> (~4–5 cm): evaluates organs (liver, spleen, kidneys), deeper masses, and aortic pulsation. Always start with light palpation and begin away from the area of pain." },
            { q: "How do you palpate for an enlarged spleen?", a: "Begin palpating in the <b>right lower quadrant</b> and move toward the left costal margin as the patient inhales deeply. The spleen tip may be felt descending on inspiration. The patient may also be examined in the <b>right lateral decubitus</b> position. A spleen must be ~3× normal size to be palpable." },
            { q: "What is clonus and how is it tested?", a: "Rapidly dorsiflex the patient's foot and hold. <b>Sustained rhythmic oscillations</b> (≥ 3 beats) = clonus, indicating an <b>upper motor neuron lesion</b> with hyperreflexia. Unsustained (1–2 beats) may be normal." },
            { q: "What is pronator drift and what does it indicate?", a: "Patient holds both arms outstretched, palms up, eyes closed for 20–30 seconds. <b>Positive:</b> one arm pronates and drifts downward → indicates <b>contralateral upper motor neuron (corticospinal) lesion</b>, such as from a stroke." },
            { q: "How do you assess for asterixis and what does it indicate?", a: "Patient extends wrists with arms outstretched ('stop traffic' position). <b>Asterixis</b> = involuntary, intermittent flapping/loss of posture → classic for <b>hepatic encephalopathy</b>, also seen in uremia and CO₂ narcosis." },
            { q: "What is the significance of clubbing of the fingers?", a: "Loss of the normal < 160° angle between nail and nail bed (Lovibond angle > 180°). Associated with <b>lung cancer, chronic hypoxic lung disease</b> (CF, bronchiectasis, IPF), <b>cyanotic heart disease, endocarditis, IBD, cirrhosis</b>, and hepatopulmonary syndrome." },
            { q: "How is a dermatome map clinically useful in the neurological exam?", a: "Dermatomal patterns of sensory loss help <b>localize nerve root lesions</b>. Key landmarks: <b>C6</b> = thumb, <b>C7</b> = middle finger, <b>C8</b> = little finger, <b>T4</b> = nipple, <b>T10</b> = umbilicus, <b>L4</b> = medial leg, <b>L5</b> = dorsum of foot, <b>S1</b> = lateral foot." },
            { q: "What is the straight leg raise (Lasègue's) test?", a: "With the patient supine, passively raise the extended leg. <b>Positive:</b> radiating pain below the knee at 30–70° of elevation → suggests <b>L4–S1 nerve root compression</b> (lumbar disc herniation). Crossed SLR (contralateral pain) is more specific." },
            { q: "How do you test for meningeal signs (meningismus)?", a: "<b>Nuchal rigidity:</b> resistance to passive neck flexion. <b>Kernig's sign:</b> with hip flexed 90°, pain/resistance on extending the knee. <b>Brudzinski's sign:</b> passive neck flexion causes involuntary hip/knee flexion. Positive signs suggest <b>meningitis or subarachnoid hemorrhage</b>." },
            { q: "What is the difference between a bruit and a venous hum?", a: "A <b>bruit</b> is a systolic (or continuous) blowing sound over an artery indicating turbulent flow/stenosis. A <b>venous hum</b> is a continuous low-pitched sound over the jugular veins in the neck, abolished by light compression or turning the head; it is benign." },
            { q: "What physical findings suggest aortic regurgitation?", a: "<b>High-pitched, blowing, decrescendo diastolic</b> murmur at left sternal border (lean forward, end-expiration). Wide pulse pressure, bounding ('water-hammer') pulses, head bobbing (de Musset's), nail bed pulsations (Quincke's), pistol-shot femorals (Traube's)." },
            { q: "What elements are included in the ROS for the cardiovascular system?", a: "Chest pain, palpitations, dyspnea (exertional, orthopnea, PND), edema (peripheral), syncope/presyncope, claudication, cyanosis, and history of known murmurs or rheumatic fever." },
            { q: "How is the Glasgow Coma Scale (GCS) scored?", a: "<b>Eye Opening (E):</b> 1 = none, 2 = to pain, 3 = to voice, 4 = spontaneous. <b>Verbal (V):</b> 1 = none, 2 = incomprehensible, 3 = inappropriate, 4 = confused, 5 = oriented. <b>Motor (M):</b> 1 = none, 2 = extension, 3 = flexion, 4 = withdrawal, 5 = localize, 6 = obeys. Total 3–15; ≤ 8 = coma." }
          ]
        },
        {
          section: 'Clinical Skills & Diagnostics',
          topic: "ECG interpretation",
          icon: 'stethoscope',
          cards: [
            { q: "What is the standard paper speed for an ECG recording?", a: "<b>25 mm/s</b>. Each small box (1 mm) = 0.04 s; each large box (5 mm) = 0.2 s." },
            { q: "What is the standard calibration voltage on an ECG?", a: "<b>10 mm/mV</b> (1 mV signal produces a 10 mm deflection). A calibration box should appear at the start of the tracing." },
            { q: "How many leads does a standard 12-lead ECG have and what are the two groups?", a: "<b>12 leads</b>: 6 <b>limb leads</b> (I, II, III, aVR, aVL, aVF) and 6 <b>precordial (chest) leads</b> (V1–V6)." },
            { q: "Where is lead V1 placed?", a: "<b>4th intercostal space, right sternal border</b>." },
            { q: "Where is lead V4 placed?", a: "<b>5th intercostal space, mid-clavicular line (left)</b>." },
            { q: "What is Einthoven's triangle?", a: "An equilateral triangle formed by limb leads I, II, and III around the heart. It states: <b>Lead II = Lead I + Lead III</b> (Einthoven's law)." },
            { q: "What do the augmented limb leads (aVR, aVL, aVF) measure?", a: "Unipolar voltage from the right arm (aVR), left arm (aVL), and left foot (aVF) referenced against a combined central terminal." },
            { q: "Which leads view the inferior wall of the heart?", a: "<b>Leads II, III, and aVF</b>." },
            { q: "Which leads view the lateral wall of the heart?", a: "<b>Leads I, aVL, V5, and V6</b>." },
            { q: "Which leads view the anterior wall of the heart?", a: "<b>V1–V4</b> (V3–V4 are specifically anterior; V1–V2 are septal)." },
            { q: "What does the P wave represent?", a: "<b>Atrial depolarization</b>. Normal P wave is upright in lead II, <0.12 s wide, and <2.5 mm tall." },
            { q: "What does the PR interval represent and what is its normal duration?", a: "Time from onset of atrial depolarization to onset of ventricular depolarization. Normal: <b>0.12–0.20 s</b> (3–5 small boxes)." },
            { q: "What does the QRS complex represent and what is its normal duration?", a: "<b>Ventricular depolarization</b>. Normal duration: <b>0.06–0.10 s</b> (< 3 small boxes). A QRS ≥ 0.12 s is considered wide." },
            { q: "What does the ST segment represent?", a: "The period between ventricular depolarization and repolarization — the <b>isoelectric phase when ventricles are fully depolarized</b>. Should be at baseline." },
            { q: "What does the T wave represent?", a: "<b>Ventricular repolarization</b>. Normally upright in most leads (except aVR, and may be inverted in V1 and III)." },
            { q: "What is the normal QT interval and how is it corrected for heart rate?", a: "Normal QT varies with rate. <b>Corrected QT (QTc)</b> uses Bazett's formula: $\\\\text{QTc} = \\\\frac{QT}{\\\\sqrt{RR}}$. Normal QTc: <b>≤ 0.44 s (men), ≤ 0.46 s (women)</b>." },
            { q: "What is the U wave and when is it seen?", a: "A small deflection after the T wave, possibly from <b>Purkinje fiber repolarization or papillary muscle repolarization</b>. Prominent in <b>hypokalemia</b> and bradycardia." },
            { q: "How do you calculate heart rate using the large box method?", a: "<b>HR = 300 ÷ (number of large boxes between two R waves)</b>. E.g., 4 large boxes → 300/4 = 75 bpm." },
            { q: "How do you calculate heart rate using the small box method?", a: "<b>HR = 1500 ÷ (number of small boxes between two R waves)</b>." },
            { q: "How do you calculate heart rate for an irregular rhythm?", a: "Count the number of R-R intervals in a <b>6-second strip (30 large boxes)</b> and <b>multiply by 10</b>." },
            { q: "What is the normal cardiac axis range?", a: "<b>−30° to +90°</b>." },
            { q: "How do you quickly determine left axis deviation (LAD)?", a: "QRS is positive in lead I and negative in lead aVF. Axis is between <b>−30° and −90°</b>. Mnemonic: '<b>Leaving</b>' — Lead I positive, aVF negative." },
            { q: "How do you quickly determine right axis deviation (RAD)?", a: "QRS is negative in lead I and positive in lead aVF. Axis is between <b>+90° and +180°</b>." },
            { q: "What is extreme (or 'northwest') axis deviation?", a: "QRS is negative in BOTH lead I and aVF. Axis is between <b>−90° and ±180°</b>. Seen in ventricular rhythms or severe conduction disease." },
            { q: "Name common causes of left axis deviation.", a: "<b>Left anterior fascicular block (LAFB)</b>, inferior MI, LVH, WPW, ostium primum ASD, mechanical shift (obesity, pregnancy, ascites)." },
            { q: "Name common causes of right axis deviation.", a: "<b>Right ventricular hypertrophy</b>, PE, COPD/cor pulmonale, lateral MI, left posterior fascicular block (LPFB), ASD (secundum), normal in children." },
            { q: "Define normal sinus rhythm.", a: "Upright P wave in II preceding every QRS, constant PR interval (0.12–0.20 s), rate <b>60–100 bpm</b>, regular rhythm." },
            { q: "Define sinus bradycardia.", a: "Normal sinus rhythm with a rate <b>< 60 bpm</b>. Causes: athletic conditioning, increased vagal tone, hypothyroidism, medications (beta-blockers)." },
            { q: "Define sinus tachycardia.", a: "Normal sinus rhythm with a rate <b>> 100 bpm</b>. Causes: exercise, pain, fever, anxiety, hypovolemia, hyperthyroidism, anemia." },
            { q: "What is sinus arrhythmia?", a: "Normal variant where <b>heart rate varies with respiration</b> — increases during inspiration, decreases during expiration. Common in young, healthy individuals." },
            { q: "What is a premature atrial contraction (PAC)?", a: "An early beat originating from <b>an ectopic atrial focus</b>. The P wave morphology differs from sinus P waves, followed by a normal (narrow) QRS. Usually benign." },
            { q: "What is the ECG appearance of atrial flutter?", a: "<b>Sawtooth flutter waves</b> (F waves), best seen in leads II, III, aVF, and V1. Atrial rate is typically <b>~300 bpm</b> with a ventricular response in ratios (2:1, 3:1, 4:1)." },
            { q: "What is the typical ventricular rate in untreated atrial flutter with 2:1 block?", a: "Atrial rate ~300 bpm ÷ 2 = <b>~150 bpm</b>. Always consider atrial flutter when the ventricular rate is ~150 bpm." },
            { q: "What are the hallmark ECG features of atrial fibrillation?", a: "<b>Irregularly irregular rhythm</b>, absence of organized P waves (replaced by fibrillatory baseline), and variable R-R intervals." },
            { q: "What is multifocal atrial tachycardia (MAT)?", a: "An irregular rhythm with rate >100 bpm and <b>≥ 3 different P wave morphologies</b> with varying PR and R-R intervals. Associated with <b>severe COPD and lung disease</b>." },
            { q: "What is the definition of supraventricular tachycardia (SVT)?", a: "Any tachycardia originating <b>above the ventricles</b>. In common usage, refers to paroxysmal SVT (AVNRT or AVRT) with rate typically <b>150–250 bpm</b> and narrow QRS." },
            { q: "What is the most common type of SVT?", a: "<b>AV nodal re-entrant tachycardia (AVNRT)</b>, accounting for ~60% of paroxysmal SVTs. Caused by a re-entry circuit within the AV node with dual pathways." },
            { q: "How does AVRT differ from AVNRT?", a: "AVRT uses an <b>accessory pathway</b> (bypass tract) outside the AV node as one limb of the re-entry circuit (e.g., bundle of Kent in WPW), whereas AVNRT uses dual pathways <b>within</b> the AV node." },
            { q: "What is Wolff-Parkinson-White (WPW) syndrome?", a: "A pre-excitation syndrome due to an <b>accessory pathway (bundle of Kent)</b>. ECG triad: <b>short PR interval (< 0.12 s), delta wave (slurred QRS upstroke), wide QRS</b>." },
            { q: "Why is giving AV nodal blockers (e.g., adenosine, verapamil) dangerous in WPW with atrial fibrillation?", a: "Blocking the AV node forces all conduction through the <b>accessory pathway</b>, which can conduct very rapidly and may precipitate <b>ventricular fibrillation</b>." },
            { q: "What is a junctional escape rhythm?", a: "A rhythm arising from the <b>AV junction</b> when the SA node fails. Rate: <b>40–60 bpm</b>. Narrow QRS; P waves may be absent, retrograde (inverted in II), or buried in QRS." },
            { q: "What is an accelerated junctional rhythm?", a: "Junctional rhythm with rate <b>60–100 bpm</b>, faster than the intrinsic junctional rate. Often seen with <b>digoxin toxicity</b>, post-cardiac surgery, or inferior MI." },
            { q: "What are premature ventricular contractions (PVCs)?", a: "Early beats from a <b>ventricular ectopic focus</b>. Wide, bizarre QRS (≥ 0.12 s) without a preceding P wave, followed by a <b>compensatory pause</b>." },
            { q: "What is the difference between unifocal and multifocal PVCs?", a: "<b>Unifocal</b>: all PVCs have the same morphology (single ectopic focus). <b>Multifocal</b>: PVCs have varying morphologies (multiple foci), indicating more serious underlying disease." },
            { q: "What is ventricular tachycardia (VT)?", a: "≥ 3 consecutive ventricular beats at a rate <b>> 100 bpm</b>. Wide QRS (≥ 0.12 s), regular rhythm. <b>Sustained VT</b> lasts > 30 seconds or causes hemodynamic instability." },
            { q: "How do you differentiate monomorphic VT from polymorphic VT?", a: "<b>Monomorphic</b>: uniform QRS morphology — often from a stable re-entry circuit (scar). <b>Polymorphic</b>: changing QRS morphology — more unstable, may indicate ischemia or long QT." },
            { q: "What is Torsades de Pointes?", a: "A form of <b>polymorphic VT</b> occurring in the setting of a <b>prolonged QT interval</b>. QRS complexes twist around the isoelectric line. Treatment: <b>IV magnesium</b> and correct QT prolongation." },
            { q: "What is ventricular fibrillation (VF)?", a: "<b>Chaotic, disorganized ventricular electrical activity</b> with no identifiable QRS complexes. Produces no cardiac output — requires immediate <b>defibrillation</b>." },
            { q: "What is the Brugada ECG pattern?", a: "<b>ST elevation with a coved or saddle-back morphology in V1–V3</b> with an RBBB-like pattern. Associated with <b>sudden cardiac death</b> due to VF, especially in young Asian males." },
            { q: "What defines first-degree AV block?", a: "<b>PR interval > 0.20 s</b> (> 5 small boxes), constant for every beat. All P waves are followed by QRS complexes. Usually benign." },
            { q: "What defines second-degree AV block, Mobitz Type I (Wenckebach)?", a: "<b>Progressive PR prolongation</b> until a P wave is not conducted (dropped QRS), then the cycle resets. Block is at the AV node; usually benign." },
            { q: "What defines second-degree AV block, Mobitz Type II?", a: "<b>Constant PR interval</b> with intermittent non-conducted P waves (sudden dropped QRS without prior PR prolongation). Block is <b>infra-nodal (His-Purkinje)</b>; high risk of progression to complete heart block." },
            { q: "What is third-degree (complete) AV block?", a: "<b>Complete dissociation</b> between atrial and ventricular activity. P waves and QRS complexes are independent. Ventricular rate depends on escape pacemaker: junctional (40–60) or ventricular (20–40)." },
            { q: "What are the ECG criteria for right bundle branch block (RBBB)?", a: "QRS ≥ 0.12 s, <b>RSR' ('M-shaped') in V1–V2</b>, and <b>wide, slurred S wave in I and V6</b>. Mnemonic: '<b>MaRRoW</b>' — M in V1 (R), W in V6." },
            { q: "What are the ECG criteria for left bundle branch block (LBBB)?", a: "QRS ≥ 0.12 s, <b>broad, notched R wave in I, aVL, V5–V6</b>, and <b>deep S wave (or QS) in V1–V2</b>. Mnemonic: '<b>WiLLiaM</b>' — W in V1, M in V6." },
            { q: "Why does LBBB make ST/T wave interpretation unreliable?", a: "LBBB causes <b>secondary repolarization abnormalities</b> — ST segments and T waves deviate opposite to the major QRS deflection ('appropriate discordance'), masking ischemic changes." },
            { q: "What are the Sgarbossa criteria?", a: "Criteria to diagnose <b>acute MI in the presence of LBBB</b>: (1) ST elevation ≥ 1 mm concordant with QRS, (2) ST depression ≥ 1 mm in V1–V3, (3) ST elevation ≥ 5 mm discordant with QRS (least specific)." },
            { q: "What is left anterior fascicular block (LAFB)?", a: "<b>Left axis deviation (−45° to −90°)</b>, small Q in I/aVL, small R in II/III/aVF, QRS < 0.12 s. The most common fascicular block." },
            { q: "What is left posterior fascicular block (LPFB)?", a: "<b>Right axis deviation (> +90°)</b>, small R in I/aVL, small Q in II/III/aVF, QRS < 0.12 s. Must <b>exclude other causes of RAD</b> (RVH, PE, etc.)." },
            { q: "What is a bifascicular block?", a: "<b>RBBB + LAFB</b> (most common) or RBBB + LPFB. Indicates disease in two of three fascicles. Risk of progression to complete heart block." },
            { q: "What is a trifascicular block?", a: "Bifascicular block + <b>first-degree AV block</b> (prolonged PR), suggesting disease in all three fascicles. However, true trifascicular block = <b>complete heart block</b>." },
            { q: "What are the ECG voltage criteria for left ventricular hypertrophy (LVH)?", a: "<b>Sokolow-Lyon</b>: S in V1 + R in V5 or V6 ≥ 35 mm. <b>Cornell</b>: R in aVL + S in V3 > 28 mm (men) or > 20 mm (women)." },
            { q: "What is the LVH 'strain' pattern?", a: "<b>ST depression and T wave inversion</b> in lateral leads (I, aVL, V5–V6) — asymmetric T inversion with a gradual downslope and rapid return. Indicates pressure overload." },
            { q: "What are the ECG criteria for right ventricular hypertrophy (RVH)?", a: "<b>Right axis deviation, tall R wave in V1 (R > S)</b>, deep S in V5–V6, right atrial enlargement, and possible RV strain pattern (ST depression/T inversion in V1–V3)." },
            { q: "What ECG findings suggest right atrial enlargement (P pulmonale)?", a: "<b>Tall, peaked P waves (> 2.5 mm) in lead II</b>. Associated with COPD, pulmonary hypertension, and right-sided heart disease." },
            { q: "What ECG findings suggest left atrial enlargement (P mitrale)?", a: "<b>Wide, notched (bifid) P wave in lead II (> 0.12 s)</b> and/or <b>deep negative terminal deflection of P wave in V1</b> (> 1 mm deep, > 1 small box wide)." },
            { q: "What ECG change indicates subendocardial ischemia?", a: "<b>ST segment depression</b> (horizontal or downsloping ≥ 1 mm) in the affected leads. Also seen in demand ischemia, digoxin effect, and LVH strain." },
            { q: "What ECG change indicates transmural (full-thickness) ischemia or injury?", a: "<b>ST segment elevation</b> ≥ 1 mm in limb leads or ≥ 2 mm in precordial leads in ≥ 2 contiguous leads." },
            { q: "What do pathological Q waves indicate?", a: "<b>Myocardial necrosis/prior infarction</b>. Defined as Q waves > 0.04 s wide and/or > 1/3 the height of the R wave in that lead." },
            { q: "What is the typical ECG evolution of an acute STEMI?", a: "<b>Hyperacute T waves → ST elevation → Q wave development → T wave inversion → ST normalization</b>. Q waves usually persist; T waves may normalize over weeks–months." },
            { q: "What are hyperacute T waves?", a: "<b>Tall, broad, peaked, symmetric T waves</b> — the earliest sign of acute MI, appearing within minutes of coronary occlusion, before ST elevation." },
            { q: "What are reciprocal changes in the context of STEMI?", a: "<b>ST depression in leads opposite the infarcting territory</b>. E.g., inferior STEMI (II, III, aVF) shows reciprocal ST depression in I and aVL. Supports the diagnosis of acute MI." },
            { q: "Which coronary artery supplies the anterior wall and what leads show anterior STEMI?", a: "<b>Left anterior descending (LAD) artery</b>. ST elevation in <b>V1–V4</b> (may extend to V5–V6 in extensive anterior MI)." },
            { q: "Which coronary artery supplies the inferior wall and what leads show inferior STEMI?", a: "Usually the <b>right coronary artery (RCA)</b> (~85%) or left circumflex (LCx). ST elevation in <b>II, III, aVF</b>." },
            { q: "Which coronary artery supplies the lateral wall?", a: "<b>Left circumflex artery (LCx)</b> or diagonal branches of LAD. Changes in <b>I, aVL, V5–V6</b>." },
            { q: "How is a posterior MI diagnosed on a standard 12-lead ECG?", a: "<b>ST depression and tall R waves in V1–V3</b> (mirror image of posterior ST elevation). Confirmed by ST elevation in posterior leads <b>V7–V9</b>." },
            { q: "How is right ventricular MI diagnosed?", a: "Suspect in <b>inferior STEMI</b>. Obtain <b>right-sided leads</b> — ST elevation ≥ 1 mm in <b>V4R</b> is the most sensitive indicator of RV infarction." },
            { q: "What is the difference between STEMI and NSTEMI?", a: "<b>STEMI</b>: complete coronary occlusion → ST elevation → emergent reperfusion. <b>NSTEMI</b>: partial occlusion → ST depression/T wave inversion + elevated troponins → medical management ± intervention." },
            { q: "What is Wellens' syndrome?", a: "A pattern of <b>deep, symmetric T wave inversions</b> (Type A, biphasic in V2–V3) or <b>deeply inverted T waves</b> (Type B) in V2–V3, indicating a <b>critical LAD stenosis</b>. High risk for anterior MI." },
            { q: "What is de Winter's ECG pattern?", a: "<b>Upsloping ST depression at the J-point in V1–V6</b> with tall, symmetric T waves — an <b>LAD occlusion equivalent</b> that does not show classic ST elevation. Treat as a STEMI equivalent." },
            { q: "What ECG changes are seen in hyperkalemia (progressive)?", a: "<b>Mild (5.5–6.5)</b>: peaked, narrow T waves. <b>Moderate (6.5–8.0)</b>: prolonged PR, flattened P waves, widened QRS. <b>Severe (> 8.0)</b>: sine wave pattern → VF/asystole." },
            { q: "What ECG changes are seen in hypokalemia?", a: "<b>Flattened T waves, ST depression, prominent U waves</b>, prolonged QU interval. Severe hypokalemia can cause atrial/ventricular arrhythmias and T-U wave fusion." },
            { q: "What ECG changes are seen in hypercalcemia?", a: "<b>Shortened QT interval</b> (due to shortened ST segment). Severe hypercalcemia may cause Osborn waves and arrhythmias." },
            { q: "What ECG changes are seen in hypocalcemia?", a: "<b>Prolonged QT interval</b> (due to prolonged ST segment). Risk of torsades de pointes." },
            { q: "What ECG changes suggest hypomagnesemia?", a: "Similar to hypokalemia: <b>prolonged QT, flattened T waves, prominent U waves</b>. Predisposes to torsades de pointes and refractory hypokalemia." },
            { q: "What is the classic ECG appearance of digoxin effect (therapeutic)?", a: "'<b>Salvador Dalí mustache</b>' — downsloping ST depression ('reverse tick' or 'scooped' ST), T wave flattening/inversion, shortened QT, and possible prominent U waves." },
            { q: "What arrhythmias suggest digoxin toxicity?", a: "<b>Atrial tachycardia with AV block (PAT with block)</b> is classic. Also: accelerated junctional rhythm, bidirectional VT, frequent PVCs, any bradyarrhythmia." },
            { q: "How do beta-blockers affect the ECG?", a: "<b>Sinus bradycardia</b>, prolonged PR interval, and possible AV conduction delay. They slow SA and AV nodal conduction." },
            { q: "How do calcium channel blockers (non-dihydropyridine) affect the ECG?", a: "<b>Verapamil and diltiazem</b> slow AV conduction → bradycardia, prolonged PR interval. May unmask or worsen AV block." },
            { q: "What ECG effects do Class IA antiarrhythmics (e.g., quinidine, procainamide) have?", a: "<b>Prolonged QRS and QT intervals</b>. QRS widening from Na-channel blockade; QT prolongation from K-channel blockade. Risk of torsades de pointes." },
            { q: "What ECG effects do Class IC antiarrhythmics (e.g., flecainide, propafenone) have?", a: "<b>Marked QRS widening</b> with minimal effect on QT. Potent Na-channel blockers. Contraindicated in structural heart disease (increased mortality — CAST trial)." },
            { q: "What ECG effects does amiodarone (Class III) have?", a: "<b>Prolonged QT interval</b>, sinus bradycardia, and diffuse T wave changes. Despite QT prolongation, torsades risk is relatively low compared to other Class III agents." },
            { q: "What are the ECG findings in acute pericarditis?", a: "<b>Stage 1</b>: Diffuse concave-up ST elevation + PR depression (except aVR: ST depression + PR elevation). <b>Stage 2</b>: ST normalization. <b>Stage 3</b>: Diffuse T inversion. <b>Stage 4</b>: Normalization." },
            { q: "How do you differentiate pericarditis ST elevation from STEMI?", a: "Pericarditis: <b>diffuse</b> ST elevation, concave-up, PR depression, no reciprocal changes, no Q waves. STEMI: <b>regional</b> ST elevation, convex-up, reciprocal changes present." },
            { q: "What is the classic ECG finding in pulmonary embolism?", a: "<b>S1Q3T3</b> (deep S in I, Q wave in III, inverted T in III). Also: sinus tachycardia (most common), right axis deviation, RBBB pattern, T wave inversions in V1–V4." },
            { q: "What is the most common ECG finding in PE?", a: "<b>Sinus tachycardia</b>. The S1Q3T3 pattern is classic but present in only ~20% of PE cases." },
            { q: "What is early repolarization (benign) on ECG?", a: "<b>J-point elevation with concave-up ST elevation</b>, often with a notch or slur at the J-point, most prominent in V2–V5. Typically in young, healthy individuals." },
            { q: "What ECG findings define Long QT syndrome?", a: "<b>QTc > 0.47 s (men) or > 0.48 s (women)</b> with risk of torsades de pointes. Causes: congenital (channelopathies) or acquired (drugs, electrolytes)." },
            { q: "Name 5 common drugs that prolong the QT interval.", a: "<b>Sotalol, amiodarone, quinidine, haloperidol, erythromycin/azithromycin</b>. Also: methadone, ondansetron, certain fluoroquinolones, TCAs." },
            { q: "What is a pacemaker spike on ECG?", a: "A <b>sharp vertical deflection (spike)</b> immediately before the paced chamber's complex. Atrial pacing → spike before P wave. Ventricular pacing → spike before wide QRS." },
            { q: "What does a VVI pacemaker do?", a: "Paces the <b>Ventricle</b>, senses the <b>Ventricle</b>, and is <b>Inhibited</b> by sensed ventricular activity. Single-chamber ventricular demand pacing." },
            { q: "What does a DDD pacemaker do?", a: "Paces <b>both atria and ventricles (Dual)</b>, senses both chambers (Dual), and can be triggered or inhibited (Dual response). Maintains AV synchrony." },
            { q: "How does a paced ventricular beat appear on ECG?", a: "<b>Pacemaker spike followed by a wide QRS complex (≥ 0.12 s)</b> with morphology similar to LBBB (if RV apex pacing) because the RV is activated first." },
            { q: "What is failure to capture in a pacemaker?", a: "<b>Pacemaker spikes present but NOT followed by a P wave or QRS complex</b>. The electrical stimulus is not depolarizing myocardium — may indicate lead dislodgement or elevated threshold." },
            { q: "What is failure to sense (undersensing)?", a: "<b>Pacemaker fires despite intrinsic cardiac activity</b> — pacing spikes appear at inappropriate times. The device fails to detect native beats." },
            { q: "What is electrical alternans and what does it suggest?", a: "<b>Alternating amplitude of QRS complexes beat to beat</b>. Classic for <b>large pericardial effusion/cardiac tamponade</b> (heart swinging in fluid)." },
            { q: "What is the normal QRS axis in neonates?", a: "<b>+90° to +180° (right axis deviation)</b>, reflecting RV dominance in utero. The axis shifts leftward over the first months of life." },
            { q: "Name 3 key differences in a pediatric ECG compared to an adult.", a: "(1) <b>Right axis deviation and RV dominance</b> (normal in neonates), (2) <b>T wave inversions in V1–V3</b> (normal juvenile pattern up to age ~16), (3) <b>Higher heart rates</b> (newborn: 110–160 bpm)." },
            { q: "At what age does the ECG typically transition from RV dominant to LV dominant pattern?", a: "By approximately <b>6 months of age</b>, the R/S ratio in V1 begins to decrease and the adult LV-dominant pattern establishes by <b>3–8 years</b>." },
            { q: "What is the J-point on the ECG?", a: "The junction between the <b>end of the QRS complex and the beginning of the ST segment</b>. Its position relative to the baseline is used to assess ST elevation or depression." },
            { q: "What are Osborn waves (J waves)?", a: "<b>Positive deflections at the J-point</b>, creating a 'camel hump' appearance. Classically associated with <b>hypothermia</b>. Also seen in hypercalcemia and some normal variants." },
            { q: "What is R wave progression and what does poor R wave progression indicate?", a: "Normally, R waves increase in amplitude from V1 to V5 (the <b>transition zone</b> is at V3–V4). <b>Poor R wave progression</b>: R wave remains small through V3–V4; causes include prior anterior MI, LVH, LBBB, and COPD." },
            { q: "What is the significance of T wave inversions in V1–V4 in an adult?", a: "In adults, T wave inversions in V1–V4 are abnormal and may indicate <b>RV strain (PE), anterior ischemia, Wellens' syndrome, HCM, or arrhythmogenic RV cardiomyopathy (ARVC)</b>." },
            { q: "How is QRS duration measured and what does a widened QRS signify?", a: "Measured from <b>onset of Q (or R) to end of S wave</b>. QRS ≥ 0.12 s = wide, suggesting <b>bundle branch block, ventricular pacing, ventricular ectopy, or pre-excitation (WPW)</b>." },
            { q: "What is the differential diagnosis for a regular, narrow-complex tachycardia?", a: "<b>Sinus tachycardia, AVNRT, AVRT (orthodromic), atrial flutter (with fixed block), atrial tachycardia</b>. Rate and P wave morphology/location help distinguish." },
            { q: "What is the differential diagnosis for a regular, wide-complex tachycardia?", a: "<b>Ventricular tachycardia (most common), SVT with aberrant conduction (BBB), SVT with pre-excitation (antidromic AVRT), paced rhythm</b>. If uncertain, treat as VT." },
            { q: "What is the Brugada criteria for differentiating VT from SVT with aberrancy?", a: "If any step is 'yes' → VT: (1) No RS complex in any precordial lead? (2) RS interval > 100 ms? (3) AV dissociation? (4) Morphology criteria for VT in V1–V2 and V6?" },
            { q: "What ECG finding confirms AV dissociation?", a: "<b>P waves marching through at a different rate than QRS complexes</b>, with capture beats and/or fusion beats. Strongly supports a diagnosis of VT." },
            { q: "What is a capture beat?", a: "During VT, a <b>normal narrow QRS that occurs when a sinus impulse 'captures' the ventricles</b> through the normal conduction system. Proves AV dissociation → confirms VT." },
            { q: "What is a fusion beat?", a: "A QRS complex of <b>intermediate morphology</b> between a sinus beat and a ventricular beat, occurring when supraventricular and ventricular impulses activate the ventricles simultaneously. Supports VT." },
            { q: "What initial intervention is used to diagnose and potentially terminate SVT?", a: "<b>Vagal maneuvers</b> (carotid sinus massage, Valsalva, cold water face immersion) followed by <b>adenosine</b> (6 mg IV push, then 12 mg). These transiently block AV conduction." },
            { q: "How does adenosine help differentiate tachyarrhythmias?", a: "Adenosine <b>blocks AV conduction transiently</b>: it terminates AVNRT/AVRT, slows the ventricular rate to unmask atrial flutter/tachycardia, and has no effect on VT." },
            { q: "What is Ashman phenomenon?", a: "An <b>aberrantly conducted beat (wide QRS, usually RBBB morphology)</b> that follows a long-short R-R cycle in atrial fibrillation. The long cycle prolongs the refractory period, causing aberrant conduction of the subsequent short cycle." },
            { q: "What ECG pattern is seen in Takotsubo (stress) cardiomyopathy?", a: "<b>ST elevation (often anterior leads), T wave inversions, and QT prolongation</b>, mimicking acute anterior MI. Coronaries are normal. Triggered by emotional/physical stress." },
            { q: "What is the ECG pattern in hyperkalemia-induced sinoventricular rhythm?", a: "Severe hyperkalemia eliminates P waves while QRS remains (widened). The rhythm appears as <b>regularized wide-complex rhythm without P waves</b> — the SA node still fires but the signal bypasses the atria." },
            { q: "What is the significance of ST elevation in aVR?", a: "<b>ST elevation in aVR with diffuse ST depression</b> suggests <b>left main or severe multi-vessel coronary disease</b>, or diffuse subendocardial ischemia. Also seen in some poisonings (e.g., TCA overdose)." },
            { q: "How does tricyclic antidepressant (TCA) overdose appear on ECG?", a: "<b>Sinus tachycardia, prolonged QRS (> 100 ms), prolonged QT, right axis deviation of the terminal 40 ms of QRS, R wave > 3 mm in aVR</b>. A QRS > 100 ms predicts seizures; > 160 ms predicts arrhythmias." },
            { q: "What is epsilon wave and what condition is it associated with?", a: "A small positive deflection <b>between the end of QRS and onset of T wave in V1–V2</b>. Pathognomonic for <b>arrhythmogenic right ventricular cardiomyopathy (ARVC)</b>." },
            { q: "What is the normal R/S ratio progression across precordial leads?", a: "R wave amplitude increases and S wave decreases from V1 to V6. The <b>transition zone</b> (R = S) is normally at <b>V3–V4</b>." },
            { q: "What is the clinical significance of a new LBBB in a patient with chest pain?", a: "A <b>new LBBB in the setting of ischemic symptoms is treated as a STEMI equivalent</b> and warrants emergent reperfusion therapy per ACC/AHA guidelines." },
            { q: "What is low voltage on ECG and what are its causes?", a: "QRS amplitude <b>< 5 mm in all limb leads or < 10 mm in all precordial leads</b>. Causes: <b>pericardial effusion, obesity, COPD/emphysema, hypothyroidism, infiltrative cardiomyopathy (amyloid)</b>." },
            { q: "How do you identify an electrode/lead misplacement on ECG?", a: "Suspect if: <b>inverted P and QRS in lead I</b> (right-left arm reversal), globally inverted complexes, or unexpected R wave regression. Right arm–left arm swap produces an inverted lead I." }
          ]
        },
        {
          section: 'Clinical Skills & Diagnostics',
          topic: "Chest X-ray & basic radiology reading",
          icon: 'stethoscope',
          cards: [
            { q: "In a PA (posteroanterior) chest X-ray, where does the X-ray beam enter and exit the patient?", a: "The beam enters through the <b>posterior</b> chest wall and exits through the <b>anterior</b> chest wall onto the film/detector. This minimises cardiac magnification because the heart sits anteriorly, closer to the detector." },
            { q: "In an AP (anteroposterior) chest X-ray, why does the heart appear magnified?", a: "The beam enters anteriorly and the heart — an anterior structure — is <b>farther from the detector</b> (behind the patient). Objects farther from the detector are magnified more, making the cardiac silhouette appear falsely enlarged." },
            { q: "What is the standard distance between the X-ray tube and the film in a PA chest X-ray?", a: "<b>6 feet (1.8 m / 180 cm)</b>. This long source-to-image distance reduces magnification and geometric distortion." },
            { q: "How do you assess whether a CXR is adequately exposed (penetration)?", a: "On a well-penetrated film you should <b>just be able to see the thoracic vertebral bodies through the cardiac shadow</b>. Over-penetrated films appear too dark; under-penetrated films appear too white." },
            { q: "How do you assess rotation on a PA chest X-ray?", a: "The <b>medial ends of both clavicles should be equidistant from the spinous process</b> of the vertebra at that level. Unequal distances indicate rotation." },
            { q: "What does the mnemonic ABCDEFGHI stand for in a systematic CXR review?", a: "<b>A</b> – Airway/AP or PA<br><b>B</b> – Bones & soft tissues<br><b>C</b> – Cardiac silhouette<br><b>D</b> – Diaphragm<br><b>E</b> – Effusions / Edges (costophrenic angles)<br><b>F</b> – Fields (lung fields)<br><b>G</b> – Gastric bubble<br><b>H</b> – Hilum<br><b>I</b> – Instruments/devices" },
            { q: "What is the 'RIPE' mnemonic used for in CXR interpretation?", a: "<b>R</b> – Rotation<br><b>I</b> – Inspiration<br><b>P</b> – Penetration (exposure)<br><b>E</b> – Exposure (or Equipment position)<br>It is used to assess <b>technical adequacy</b> before interpreting findings." },
            { q: "How do you assess adequate inspiration on a PA chest X-ray?", a: "Count the <b>posterior ribs visible above the diaphragm</b>. Adequate inspiration shows <b>5–7 anterior ribs or 9–10 posterior ribs</b> above the right hemidiaphragm." },
            { q: "What is the main advantage of a lateral CXR?", a: "It helps localise lesions to a specific <b>lobe</b>, visualise structures hidden by the heart and diaphragm on the PA view, and assess the <b>retrosternal and retrocardiac spaces</b>." },
            { q: "On a lateral CXR, which hemidiaphragm is typically higher and how do you tell them apart?", a: "The <b>right hemidiaphragm is usually higher</b>. The left hemidiaphragm is identified by the <b>gastric air bubble beneath it</b> and loses its silhouette where it contacts the heart." },
            { q: "Where is the carina located on a normal PA CXR and what is its significance?", a: "The carina (bifurcation of the trachea) is at approximately <b>T4–T5 level</b> (or the level of the aortic arch). A widened carinal angle (>100°) may suggest <b>left atrial enlargement</b> or subcarinal lymphadenopathy." },
            { q: "What structures form the right heart border on a PA CXR?", a: "From top to bottom: <b>SVC</b> (upper portion) and <b>right atrium</b> (lower convex portion)." },
            { q: "What structures form the left heart border on a PA CXR?", a: "From top to bottom: <b>aortic knob (knuckle)</b>, <b>pulmonary trunk (main pulmonary artery)</b>, <b>left atrial appendage</b>, and <b>left ventricle</b>." },
            { q: "What is the hilum of the lung and what does it contain?", a: "The hilum is the root of the lung containing the <b>pulmonary arteries, pulmonary veins, main bronchi, lymph nodes, and bronchial vessels</b>. The left hilum is normally <b>slightly higher</b> than the right." },
            { q: "What are the normal costophrenic angles and what does blunting indicate?", a: "Normal costophrenic angles are <b>sharp and acute</b>. Blunting suggests a <b>pleural effusion</b> (≥200–300 mL of fluid on an upright PA film)." },
            { q: "Where are the lung fissures located and which lobes do they separate?", a: "<b>Right lung:</b> Oblique (major) fissure separates upper/middle from lower lobe; Horizontal (minor) fissure separates upper from middle lobe.<br><b>Left lung:</b> Only an oblique fissure separating upper from lower lobe." },
            { q: "What is the normal tracheal position on a PA CXR?", a: "The trachea should be <b>midline or slightly deviated to the right</b> at the level of the aortic arch. Significant deviation suggests a mass, collapse, or tension pneumothorax." },
            { q: "What is the aortic knob (knuckle) on a PA CXR?", a: "It is the <b>prominence of the aortic arch</b> seen on the left mediastinal border. It becomes prominent and unfolded in <b>elderly patients and hypertension</b>." },
            { q: "Which structures form the anterior, middle, and posterior mediastinum?", a: "<b>Anterior:</b> thymus, fat, lymph nodes, internal mammary vessels.<br><b>Middle:</b> heart, great vessels, trachea, main bronchi, lymph nodes.<br><b>Posterior:</b> descending aorta, oesophagus, thoracic vertebrae, sympathetic chain." },
            { q: "Where is the right hemidiaphragm normally located relative to the left?", a: "The right hemidiaphragm is normally <b>1–3 cm higher</b> than the left, due to the underlying liver." },
            { q: "What is the cardiothoracic ratio (CTR) and what is considered normal?", a: "CTR = <b>maximum transverse cardiac diameter ÷ maximum internal thoracic diameter</b>. Normal is <b>≤0.5 (50%)</b> on a PA film. A CTR >0.5 suggests cardiomegaly." },
            { q: "Why is the CTR unreliable on an AP chest X-ray?", a: "The AP projection <b>magnifies the heart</b> because it is farther from the detector. This can falsely increase the CTR, making the heart appear enlarged when it may be normal." },
            { q: "How does left atrial (LA) enlargement appear on a PA CXR?", a: "Signs include: <b>double density sign</b> (right heart border), <b>splaying of the carina</b> (subcarinal angle >100°), <b>straightening/convexity of the left heart border</b> (prominent LA appendage), and <b>elevation of the left main bronchus</b>." },
            { q: "How does left ventricular (LV) enlargement appear on a CXR?", a: "The cardiac apex is displaced <b>downward and to the left</b>, extending below the diaphragm. The heart appears <b>boot-shaped</b> in some contexts, and the CTR is increased." },
            { q: "How does right ventricular (RV) enlargement appear on CXR?", a: "The heart enlarges <b>anteriorly</b> (best seen on lateral CXR as filling of the retrosternal space). On PA, the <b>left heart border may be elevated</b> (upturned apex) and the heart appears globular." },
            { q: "How does right atrial (RA) enlargement appear on a PA CXR?", a: "The <b>right heart border extends further to the right</b> than normal (>1/3 of the right hemithorax from midline)." },
            { q: "What is the classic CXR appearance of a pericardial effusion?", a: "A <b>globular (flask-shaped / water-bottle) heart silhouette</b> with sharp cardiac margins and clear lung fields. Rapid accumulation may show little change in overall size but still cause tamponade." },
            { q: "What congenital heart defect produces a 'boot-shaped' heart (coeur en sabot) on CXR?", a: "<b>Tetralogy of Fallot</b>. The upturned apex is due to right ventricular hypertrophy, and the concave pulmonary artery segment causes the boot shape. Lung fields are oligaemic (decreased pulmonary vascularity)." },
            { q: "What congenital heart defect produces an 'egg-on-a-string' appearance on CXR?", a: "<b>Transposition of the Great Arteries (TGA)</b>. The narrow superior mediastinum (the 'string') results from the anteroposterior relationship of the great arteries, and the egg is the enlarged globular heart." },
            { q: "What CXR findings suggest congestive heart failure (CHF)?", a: "Mnemonic <b>ABCDE</b>: <b>A</b>lveolar oedema (bat-wing/butterfly pattern), <b>B</b> lines (Kerley B lines), <b>C</b>ardiomegaly, <b>D</b>iversion of upper lobe pulmonary vessels (cephalization), <b>E</b>ffusions (pleural). Also peribronchial cuffing." },
            { q: "What is consolidation on a CXR and what causes it?", a: "Consolidation is <b>opacification of the airspaces</b> with preservation of lung volume. The alveoli are filled with fluid, pus, blood, or cells instead of air. Common causes include <b>pneumonia, haemorrhage, and pulmonary oedema</b>." },
            { q: "What is an air bronchogram and what does it indicate?", a: "An air bronchogram is <b>air-filled bronchi visible within surrounding opacified (consolidated) lung parenchyma</b>. It indicates the opacification is in the <b>lung parenchyma</b> (not pleural) and that the airway is patent." },
            { q: "What is ground-glass opacity (GGO) on CXR/CT?", a: "GGO is a <b>hazy increase in lung density through which bronchial and vascular markings are still visible</b>. It suggests partial filling of airspaces. Causes include <b>viral pneumonia, early ARDS, pulmonary haemorrhage, and hypersensitivity pneumonitis</b>." },
            { q: "What are the types of atelectasis?", a: "<b>Resorptive (obstructive):</b> airway obstruction (mucus plug, tumour).<br><b>Compressive:</b> space-occupying lesion compresses lung (effusion, pneumothorax).<br><b>Cicatrisation (contraction):</b> fibrosis/scarring.<br><b>Adhesive:</b> surfactant deficiency (e.g., ARDS, RDS).<br><b>Relaxation/passive:</b> loss of contact between visceral and parietal pleura." },
            { q: "What CXR signs suggest atelectasis (lung collapse)?", a: "Direct signs: <b>displacement of fissures, increased opacity</b>. Indirect signs: <b>tracheal/mediastinal shift toward the collapse</b>, ipsilateral hemidiaphragm elevation, compensatory hyperinflation of adjacent lobes, hilar displacement." },
            { q: "What are Kerley B lines and what do they signify?", a: "Kerley B lines are <b>short (1–2 cm), thin horizontal lines perpendicular to the pleural surface</b> at the lung bases. They represent thickened interlobular septa, most commonly seen in <b>pulmonary oedema/CHF</b>, lymphangitic carcinomatosis." },
            { q: "What is honeycombing on CXR/CT and what does it indicate?", a: "Honeycombing is a pattern of <b>clustered thick-walled cystic airspaces (3–10 mm)</b> typically at the lung periphery and bases. It represents <b>end-stage pulmonary fibrosis</b> (e.g., usual interstitial pneumonia / IPF) and is irreversible." },
            { q: "What is the 'tree-in-bud' pattern on CT?", a: "Tree-in-bud describes <b>centrilobular branching nodular opacities</b> resembling a budding tree. It indicates <b>impaction of bronchioles with mucus, pus, or fluid</b> — seen in <b>infectious bronchiolitis, endobronchial TB, and aspiration</b>." },
            { q: "What is a cavitary lung lesion and what are its common causes?", a: "A cavity is a <b>gas-filled space within a pulmonary opacity, mass, or nodule</b>. Common causes (mnemonic CAVITY): <b>Cancer (squamous cell), Autoimmune (Wegener's/GPA), Vascular (pulmonary infarct), Infection (TB, abscess, fungal), Trauma, Youth (congenital)</b>." },
            { q: "What is the silhouette sign and how is it used?", a: "When two structures of <b>similar density</b> are in contact, their interface (border) is lost. For example, <b>right middle lobe consolidation silhouettes the right heart border</b>; lingular disease silhouettes the left heart border. This helps <b>localise disease</b>." },
            { q: "What is the difference between a reticular and a nodular lung pattern on CXR?", a: "<b>Reticular:</b> network of lines/interstitial thickening (fibrosis, lymphangitic spread).<br><b>Nodular:</b> discrete round opacities (metastases, miliary TB, sarcoidosis).<br><b>Reticulonodular:</b> combination of both." },
            { q: "What does 'air-space opacification' versus 'interstitial pattern' mean on CXR?", a: "<b>Air-space (alveolar):</b> fluffy, confluent opacities with air bronchograms — represents alveolar filling (pneumonia, oedema, haemorrhage).<br><b>Interstitial:</b> reticular, nodular, or reticulonodular patterns — represents disease of the lung scaffolding (fibrosis, lymphangitic carcinomatosis)." },
            { q: "How does a pleural effusion appear on an upright PA CXR?", a: "A <b>homogeneous opacity at the lung base</b> with a <b>concave upward meniscus</b> that is higher laterally than medially. Small effusions first blunt the <b>costophrenic angle</b>." },
            { q: "How much fluid is needed to produce costophrenic angle blunting on an upright PA CXR?", a: "Approximately <b>200–300 mL</b>. A lateral decubitus film can detect as little as <b>50–100 mL</b>." },
            { q: "What is a subpulmonic effusion and how is it identified?", a: "Fluid collects <b>between the lung base and the diaphragm</b> without spilling into the costophrenic angle. It mimics an <b>elevated hemidiaphragm</b>. Clue: the apparent dome of the diaphragm is laterally peaked. A <b>lateral decubitus film</b> confirms it." },
            { q: "What is the difference between a simple and a tension pneumothorax on CXR?", a: "<b>Simple:</b> visible visceral pleural line with absent lung markings peripherally; no mediastinal shift.<br><b>Tension:</b> same plus <b>mediastinal shift away</b> from the affected side, ipsilateral diaphragm depression, and contralateral lung compression. Tension pneumothorax is a <b>clinical diagnosis treated before CXR</b>." },
            { q: "What CXR finding is pathognomonic for pneumothorax?", a: "A <b>visible visceral pleural edge</b> (thin white line) with <b>no lung markings peripheral to it</b>. On a supine film, the 'deep sulcus sign' (abnormally deep, lucent costophrenic angle) may be the only clue." },
            { q: "What is the deep sulcus sign?", a: "An abnormally <b>deep and lucent costophrenic angle</b> seen on a <b>supine CXR</b>. It indicates a <b>pneumothorax</b> — free air rises to the most anterior and inferior part of the thorax in the supine position." },
            { q: "What is pleural thickening and what are its causes?", a: "Diffuse or focal thickening of the pleura seen as <b>blunting or soft tissue density along the chest wall</b>. Causes include <b>prior infection (TB, empyema), asbestos exposure (pleural plaques), haemothorax, and mesothelioma</b>." },
            { q: "How do you differentiate a pleural effusion from consolidation on CXR?", a: "<b>Effusion:</b> meniscus sign, no air bronchograms, shifts with position change (decubitus film).<br><b>Consolidation:</b> air bronchograms present, no meniscus, does not shift with position, may have silhouette sign with adjacent structures." },
            { q: "What is a widened mediastinum and what are its causes?", a: "Mediastinal width <b>>8 cm on PA CXR</b> (measured at the level of the aortic knob). Causes: <b>aortic dissection/rupture, lymphadenopathy, mediastinal mass, tortuous aorta, and mediastinal haematoma</b> (trauma)." },
            { q: "What is the '4 T's' mnemonic for anterior mediastinal masses?", a: "<b>T</b>hymoma (and thymic cysts/carcinoma)<br><b>T</b>eratoma (and other germ cell tumours)<br><b>T</b>errible lymphoma (Hodgkin's & non-Hodgkin's)<br><b>T</b>hyroid (retrosternal goitre)" },
            { q: "What are common causes of a middle mediastinal mass?", a: "<b>Lymphadenopathy</b> (sarcoidosis, lymphoma, metastases), <b>bronchogenic cyst</b>, <b>vascular abnormalities</b> (aortic aneurysm, anomalous vessels), and <b>oesophageal lesions</b>." },
            { q: "What are common causes of a posterior mediastinal mass?", a: "<b>Neurogenic tumours</b> (schwannoma, neurofibroma, neuroblastoma), <b>descending aortic aneurysm</b>, <b>vertebral body lesions</b>, <b>paravertebral abscess</b>, <b>lateral thoracic meningocele</b>, and <b>extramedullary haematopoiesis</b>." },
            { q: "What is pneumomediastinum and how does it appear on CXR?", a: "Free air within the mediastinum. CXR shows <b>lucent streaks outlining mediastinal structures</b>, especially along the left heart border or around the aorta. It may dissect into the neck (subcutaneous emphysema). Causes include <b>oesophageal rupture (Boerhaave), alveolar rupture, and airway trauma</b>." },
            { q: "What CXR finding is classically associated with sarcoidosis?", a: "<b>Bilateral hilar lymphadenopathy (BHL)</b>, often symmetric ('lambda sign' or 'Garland triad'). Stage classification: I = BHL alone; II = BHL + pulmonary infiltrates; III = infiltrates without BHL; IV = pulmonary fibrosis." },
            { q: "What is the 1-2-3 sign (Garland triad) on CXR?", a: "Seen in <b>sarcoidosis</b>: enlargement of <b>(1) right paratracheal, (2) right hilar, and (3) left hilar</b> lymph nodes, producing a characteristic triad of opacities." },
            { q: "How does bilateral hilar lymphadenopathy (BHL) differ from prominent pulmonary arteries on CXR?", a: "<b>BHL:</b> lobulated, dense hilar shadows that are NOT pulsatile on fluoroscopy and do not taper smoothly.<br><b>Prominent pulmonary arteries:</b> smooth, vascular-density shadows that taper normally, pulsatile on fluoroscopy, seen in pulmonary hypertension." },
            { q: "What conditions cause tracheal deviation toward the affected side?", a: "Conditions that cause <b>volume loss</b> on that side: <b>lobar collapse/atelectasis, pneumonectomy, fibrosis</b>. The trachea is 'pulled' toward the pathology." },
            { q: "What conditions cause tracheal deviation away from the affected side?", a: "Conditions that cause <b>increased volume or pressure</b>: <b>tension pneumothorax, large pleural effusion, large mass</b>. The trachea is 'pushed' away." },
            { q: "What is the most common site for an aspirated foreign body to lodge and why?", a: "The <b>right main bronchus</b>, because it is <b>wider, shorter, and more vertical</b> than the left main bronchus. In children, it may lodge in either side due to equal bronchial angles." },
            { q: "What CXR findings suggest a radiolucent (non-opaque) foreign body aspiration?", a: "Direct visualisation is impossible. Indirect signs include: <b>unilateral hyperinflation (air trapping)</b>, <b>mediastinal shift away from the affected side on expiration</b>, and <b>recurrent pneumonia in the same location</b>." },
            { q: "What is the ideal position of an endotracheal tube (ETT) tip on CXR?", a: "The ETT tip should be <b>3–5 cm above the carina</b> (approximately at the T2–T4 level) with the head in neutral position. If too low, it commonly enters the <b>right main bronchus</b>." },
            { q: "How do you systematically assess bones on a CXR?", a: "Examine <b>ribs</b> (count, symmetry, fractures), <b>clavicles</b>, <b>scapulae</b>, <b>thoracic spine</b> (vertebral body height, alignment), and <b>humeral heads</b>. Look for lytic/blastic lesions, fractures, and dislocations." },
            { q: "How do lytic bone lesions appear on X-ray and what are common causes?", a: "Lytic lesions appear as <b>areas of decreased bone density (dark holes)</b>. Common causes: <b>metastases (renal, thyroid, lung, breast), multiple myeloma, infection (osteomyelitis)</b>." },
            { q: "How do blastic (sclerotic) bone lesions appear on X-ray and what are common causes?", a: "Blastic lesions appear as <b>areas of increased bone density (white/bright)</b>. Common causes: <b>prostate metastases, breast metastases (can be lytic or blastic), Paget's disease, lymphoma</b>. Mnemonic for blastic mets: <b>Pb LEMON</b> — Prostate, breast, Lymphoma, mEdulloblastoma, Meningioma, Osteosarcoma, Neuroblastoma." },
            { q: "What rib findings on CXR suggest non-accidental injury (child abuse)?", a: "<b>Posterior rib fractures of different ages</b> (varying stages of healing), fractures at the <b>costochondral junctions</b> ('bucket-handle' or 'corner' fractures), and <b>multiple bilateral fractures</b>." },
            { q: "What is a vertebral compression fracture and how does it appear on CXR?", a: "Loss of vertebral body height, appearing as a <b>wedge-shaped or flattened vertebral body</b>. Most common in <b>osteoporosis</b> (especially postmenopausal women) and <b>metastatic disease</b>. Look for >20% height loss compared to adjacent vertebra." },
            { q: "Where should the tip of a central venous catheter (CVC) ideally lie on CXR?", a: "The tip should lie at the <b>junction of the SVC and right atrium</b> (approximately at the level of the carina or just below). Tip in the right atrium risks arrhythmias; too high risks inaccurate CVP readings." },
            { q: "Where should the tip of a nasogastric (NG) tube lie on CXR?", a: "The NG tube should follow the <b>oesophagus midline</b>, cross the diaphragm, and the tip should be visible <b>below the left hemidiaphragm in the stomach</b> (at least 10 cm beyond the gastro-oesophageal junction). Ensure it does not coil in the oesophagus or enter a bronchus." },
            { q: "What is the danger of a malpositioned NG tube and how is it detected on CXR?", a: "If the tube enters the <b>tracheobronchial tree</b>, feeding or medication administration can cause <b>aspiration pneumonia, pneumothorax, or death</b>. CXR shows the tube deviating toward a <b>bronchus</b> rather than following the oesophagus midline." },
            { q: "What are the expected positions of pacemaker leads on CXR?", a: "<b>Single-chamber (ventricular):</b> one lead in the RV apex.<br><b>Dual-chamber:</b> one lead in the RA appendage (curved anteriorly) and one in the RV apex.<br><b>Biventricular (CRT):</b> additional lead in the <b>coronary sinus</b> (posterolateral LV wall via the CS)." },
            { q: "Where should the tip of a chest drain (intercostal drain) be positioned on CXR?", a: "For <b>pneumothorax:</b> apex of the thorax (anterosuperior).<br>For <b>pleural effusion/haemothorax:</b> posterior basal region.<br>The drain should be within the pleural space and the <b>side-holes (radiopaque line interruption) should all be inside the thorax</b>." },
            { q: "What are CXR signs of a malpositioned ETT?", a: "<b>Too low (right main bronchus intubation):</b> tip beyond the carina → left lung collapse/atelectasis, right-sided hyperinflation.<br><b>Too high:</b> tip in the pharynx → inadequate ventilation.<br><b>Oesophageal:</b> gastric distension, bilateral poor aeration." },
            { q: "Where should the tip of a PICC (peripherally inserted central catheter) lie on CXR?", a: "Same as a CVC: at the <b>cavoatrial junction (SVC-RA junction)</b>, near the level of the carina. It is inserted via an antecubital vein and courses through the axillary and subclavian veins into the SVC." },
            { q: "What is the CXR appearance of lobar pneumonia?", a: "<b>Homogeneous consolidation confined to a single lobe</b> with air bronchograms, no volume loss (or slight expansion). Silhouette sign helps identify the involved lobe. Most commonly caused by <b>Streptococcus pneumoniae</b>." },
            { q: "What is the CXR appearance of bronchopneumonia?", a: "<b>Patchy, multifocal opacities</b> often bilateral and in the lower lobes. The pattern is <b>non-segmental</b>, centered on airways. Common organisms: <b>Staphylococcus aureus, Gram-negatives, H. influenzae</b>." },
            { q: "How does primary TB appear on CXR?", a: "Typically in <b>children or immunocompromised</b>: <b>middle/lower zone consolidation (Ghon focus)</b> + <b>ipsilateral hilar lymphadenopathy</b> = <b>Ghon complex</b>. May see pleural effusion. Cavitation is uncommon in primary TB." },
            { q: "How does reactivation (post-primary) TB appear on CXR?", a: "Predilection for <b>upper lobes (apical and posterior segments)</b>. CXR shows <b>patchy consolidation, cavitation, fibrosis, and volume loss</b>. Tree-in-bud pattern on CT. May see calcified granulomas from prior infection." },
            { q: "What is miliary TB and how does it appear on CXR?", a: "Haematogenous dissemination of TB producing <b>innumerable tiny (1–3 mm) nodules uniformly distributed throughout both lungs</b> — a 'snowstorm' pattern. Seen in immunocompromised patients." },
            { q: "What is a lung abscess and how does it appear on CXR?", a: "A <b>thick-walled cavity with an air-fluid level</b> inside, usually in a dependent segment. The wall is irregular. Most common in the <b>right lung (posterior segment of upper lobe or superior segment of lower lobe)</b> due to aspiration." },
            { q: "What are the CXR findings in ARDS (Acute Respiratory Distress Syndrome)?", a: "<b>Bilateral, diffuse, non-cardiogenic pulmonary oedema</b> — widespread opacification ('white-out') in both lungs. Unlike cardiogenic oedema: <b>no cardiomegaly, no cephalization, no Kerley B lines, no pleural effusions</b> (initially). Onset within 24–48 hours of inciting event." },
            { q: "What are the CXR findings in COPD (emphysema predominant)?", a: "<b>Hyperinflated lungs</b> (flattened diaphragms, >10 posterior ribs visible, increased AP diameter on lateral view), <b>increased retrosternal airspace</b>, <b>reduced vascular markings</b> (oligaemia), <b>bullae</b>, and a <b>narrow/vertical cardiac silhouette</b> (tubular heart)." },
            { q: "What are the CXR features of pulmonary oedema?", a: "<b>Cephalization</b> (upper lobe pulmonary venous distension) → <b>interstitial oedema</b> (Kerley B lines, peribronchial cuffing, septal thickening) → <b>alveolar oedema</b> (bilateral perihilar 'bat-wing' opacities, air bronchograms) → <b>pleural effusions</b> (bilateral, right > left)." },
            { q: "What is the CXR appearance of a pneumoconiosis such as asbestosis?", a: "<b>Asbestosis:</b> bilateral lower zone reticular/reticulonodular opacities, <b>pleural plaques</b> (often calcified, bilateral), pleural thickening, and in advanced cases honeycombing at bases. Distinct from silicosis which affects <b>upper zones</b>." },
            { q: "How does silicosis appear on CXR?", a: "<b>Bilateral upper-zone nodules (1–10 mm)</b>, often with <b>eggshell calcification of hilar lymph nodes</b>. Progressive massive fibrosis (PMF) appears as large upper-lobe opacities. Background of small rounded opacities." },
            { q: "What is the CXR appearance of mesothelioma?", a: "<b>Unilateral pleural thickening</b> (often lobulated or nodular), encasing the lung. <b>Volume loss on the affected side</b> with ipsilateral mediastinal shift (unlike effusion which pushes away). May have <b>pleural effusion</b> and <b>rib destruction</b>. History of <b>asbestos exposure</b>." },
            { q: "How do you differentiate a solitary pulmonary nodule from a mass?", a: "A <b>nodule</b> is ≤3 cm; a <b>mass</b> is >3 cm. Masses are more likely malignant. Evaluation of a nodule includes: <b>size, margins (spiculated = suspicious), calcification pattern, growth rate</b>, and PET/CT." },
            { q: "What calcification patterns in a pulmonary nodule suggest benignity?", a: "<b>Central (target), diffuse/solid, laminated (concentric rings), and 'popcorn' calcification</b> (hamartoma) are typically benign. <b>Eccentric or stippled calcification</b> is suspicious for malignancy." },
            { q: "What is the 'Hampton hump' and what does it indicate?", a: "A <b>wedge-shaped, pleura-based opacity</b> in the lower zones representing <b>pulmonary infarction</b> secondary to <b>pulmonary embolism</b>. The apex points toward the hilum." },
            { q: "What is the 'Westermark sign'?", a: "An area of <b>focal oligaemia (decreased vascularity/lucency)</b> in a lung zone distal to a pulmonary embolism due to reduced blood flow. It is a specific but insensitive CXR sign of <b>PE</b>." },
            { q: "What is the 'sail sign' on a pediatric CXR?", a: "A <b>triangular opacity projecting from the mediastinum</b> resembling a spinnaker sail, representing a normal <b>thymus</b> in infants and young children. The thymus is prominent until age 2 and should not be mistaken for pathology." },
            { q: "How does the thymus appear on a normal pediatric CXR and when does it involute?", a: "The thymus appears as a <b>soft tissue density in the anterior superior mediastinum</b> that can obscure the cardiac silhouette and mediastinum. It may show the <b>wave sign</b> (undulation along the rib margins). It involutes gradually, usually by <b>puberty</b>." },
            { q: "What is the CXR appearance of neonatal respiratory distress syndrome (RDS)?", a: "Diffuse, bilateral <b>ground-glass granular opacification ('reticulogranular' pattern)</b> with <b>air bronchograms</b> and <b>low lung volumes</b>. Caused by <b>surfactant deficiency</b> in premature infants." },
            { q: "What is a congenital diaphragmatic hernia (CDH) and how does it appear on CXR?", a: "Herniation of abdominal contents through the diaphragm (most commonly <b>left posterolateral — Bochdalek hernia</b>). CXR shows <b>bowel loops in the thorax</b>, contralateral mediastinal shift, absent/low ipsilateral hemidiaphragm, and <b>scaphoid abdomen</b>." },
            { q: "What is the CXR appearance of transient tachypnoea of the newborn (TTN)?", a: "<b>Prominent interstitial markings, fluid in the fissures, mild pleural effusions, and perihilar streakiness</b> in a term or near-term infant. Lungs are usually well-inflated. Resolves within <b>24–72 hours</b>. Caused by delayed resorption of fetal lung fluid." },
            { q: "What is the '3-6-9 rule' for assessing bowel dilatation on abdominal X-ray?", a: "Maximal normal diameters: <b>Small bowel ≤3 cm, Large bowel ≤6 cm, Caecum ≤9 cm</b>. Measurements exceeding these suggest obstruction or ileus." },
            { q: "How do you differentiate small bowel from large bowel on abdominal X-ray?", a: "<b>Small bowel:</b> central location, valvulae conniventes (thin folds crossing the full width — 'stacked coins'), narrower diameter.<br><b>Large bowel:</b> peripheral/frame-like distribution, haustra (thick folds that do NOT cross the full width), wider diameter, may contain faecal matter." },
            { q: "What is the CXR/AXR finding of free intraperitoneal air (pneumoperitoneum)?", a: "On <b>erect CXR:</b> <b>free air under the diaphragm</b> (best seen under the right hemidiaphragm). On <b>supine AXR:</b> <b>Rigler's sign (double-wall sign)</b> — both sides of the bowel wall are visible. Also football sign, falciform ligament sign." },
            { q: "What is Rigler's sign (double-wall sign)?", a: "On a <b>supine abdominal X-ray</b>, both the <b>inner and outer walls of the bowel</b> are visible because free intraperitoneal air outlines the serosal surface. It indicates <b>pneumoperitoneum</b> (often from bowel perforation)." },
            { q: "What are common causes of calcification seen on abdominal X-ray?", a: "<b>Renal/ureteric calculi, gallstones (10% are radio-opaque), pancreatic calcification (chronic pancreatitis), aortic calcification (atherosclerosis), phleboliths (pelvic veins), appendicolith, calcified lymph nodes (TB), and calcified fibroids</b>." },
            { q: "What are the features of small bowel obstruction (SBO) on abdominal X-ray?", a: "<b>Dilated small bowel loops (>3 cm)</b> with <b>valvulae conniventes</b>, multiple air-fluid levels on erect film (≥3 levels), <b>paucity of gas in the colon/rectum</b>. Cause often <b>adhesions, hernias, or tumour</b>." },
            { q: "What are the features of large bowel obstruction (LBO) on abdominal X-ray?", a: "<b>Dilated large bowel (>6 cm) proximal to the obstruction</b> with <b>haustra</b>. If the ileocaecal valve is competent, small bowel is not dilated. If incompetent, both small and large bowel dilate. <b>Caecum >9 cm = risk of perforation</b>. Common causes: <b>colorectal carcinoma, volvulus, diverticular stricture</b>." },
            { q: "What are the main CT window settings used for chest imaging?", a: "<b>Lung window:</b> W 1500, L -500 (optimises air-tissue contrast, best for parenchyma).<br><b>Mediastinal (soft tissue) window:</b> W 350, L 40 (best for mediastinal structures, lymph nodes, vessels).<br><b>Bone window:</b> W 1500–2000, L 300–500 (best for skeletal structures)." },
            { q: "How is pulmonary embolism (PE) diagnosed on CT pulmonary angiography (CTPA)?", a: "A <b>filling defect (dark area) within a contrast-enhanced pulmonary artery</b>. The clot appears as a low-attenuation area within the bright (white) contrast-opacified vessel. Can be <b>central (saddle embolus at bifurcation)</b> or peripheral." },
            { q: "What is a saddle pulmonary embolus?", a: "A large thrombus that straddles the <b>bifurcation of the main pulmonary artery</b> (extending into both the right and left pulmonary arteries). It is a <b>life-threatening emergency</b> causing acute right heart failure." },
            { q: "How is aortic dissection classified (Stanford) and how does it appear on CT?", a: "<b>Stanford A:</b> involves the <b>ascending aorta</b> (surgical emergency).<br><b>Stanford B:</b> involves only the <b>descending aorta</b> (medical management).<br>CT shows an <b>intimal flap</b> separating the true and false lumens, with differential contrast enhancement." },
            { q: "What is the role of high-resolution CT (HRCT) of the chest?", a: "HRCT uses <b>thin slices (1–2 mm)</b> without IV contrast to evaluate <b>interstitial lung disease</b> in detail. It identifies patterns like <b>ground-glass opacity, honeycombing, reticular thickening, traction bronchiectasis</b>, and helps with distribution mapping (upper vs lower, central vs peripheral)." },
            { q: "What is the 'spine sign' on a lateral CXR?", a: "Normally, vertebral bodies appear <b>progressively darker (more lucent)</b> from upper to lower thoracic spine on the lateral view. If a lower vertebral body appears <b>whiter/denser</b> than one above it, it suggests <b>lower lobe pathology</b> (consolidation or effusion) — this is a positive spine sign." },
            { q: "What is the 'Golden S sign' and what does it indicate?", a: "A <b>reverse-S-shaped opacity</b> at the right hilum caused by <b>right upper lobe collapse secondary to a central obstructing mass</b> (usually lung carcinoma). The superior convexity is the mass; the inferior concavity is the collapsed lobe." },
            { q: "What CXR pattern is associated with Pancoast tumour?", a: "An <b>apical lung mass (superior sulcus tumour)</b> that may show <b>rib destruction (1st and 2nd ribs)</b> and <b>soft tissue opacity at the lung apex</b>. Clinically associated with <b>Horner syndrome, brachial plexus involvement, and shoulder pain</b>." },
            { q: "What is the 'Fleischner Society' guideline used for?", a: "Guidelines for the <b>management of incidentally detected pulmonary nodules</b> on CT. Recommendations depend on <b>nodule size, morphology (solid vs sub-solid), number, and patient risk factors</b>. They guide <b>follow-up CT intervals</b> or the need for PET/biopsy." },
            { q: "What is the 'luftsichel sign' on CXR?", a: "A <b>crescent of hyperlucency</b> along the <b>left mediastinal border/aortic arch</b> caused by hyperinflation of the superior segment of the left lower lobe, seen in <b>left upper lobe collapse</b>. The collapsed LUL drapes anteriorly against the chest wall." },
            { q: "What is 'cephalization' of pulmonary vessels on CXR?", a: "<b>Redistribution of blood flow to the upper lobe pulmonary veins</b>, which appear enlarged and more prominent than the lower lobe vessels (normally the reverse). It is an <b>early sign of raised pulmonary venous pressure</b>, as seen in <b>CHF</b>." },
            { q: "What is peribronchial cuffing on CXR?", a: "<b>Thickening of bronchial walls</b> seen as ring-like opacities when viewed end-on (donut sign) or as tram-tracking when seen longitudinally. Indicates <b>peribronchial oedema or inflammation</b>, commonly seen in <b>CHF, asthma, and bronchitis</b>." },
            { q: "What is the difference between transudate and exudate on CXR appearance?", a: "CXR cannot reliably distinguish them. Both appear as pleural effusions. Diagnosis requires <b>thoracentesis and Light's criteria</b>. However, bilateral effusions are more commonly <b>transudative (CHF)</b>, while unilateral effusions raise concern for <b>exudative causes (infection, malignancy)</b>." },
            { q: "What are CXR features that suggest malignancy in a lung mass?", a: "<b>Spiculated or irregular margins, size >3 cm, eccentric/stippled calcification, cavitation with thick irregular walls, associated lymphadenopathy, rib destruction, pleural effusion</b>, and <b>growth on serial imaging</b>." },
            { q: "What is the 'incomplete border sign' (extrapleural sign)?", a: "A mass arising <b>from the chest wall or pleura</b> makes <b>obtuse angles</b> with the lung surface and has an <b>incomplete visible border</b> (part is hidden by the chest wall). This distinguishes <b>extrapleural/chest wall masses from intrapulmonary masses</b> which make acute angles." },
            { q: "What is the 'continuous diaphragm sign'?", a: "Normally, the central portion of the diaphragm is obscured by the heart. If <b>air in the mediastinum (pneumomediastinum)</b> outlines the superior diaphragmatic surface, the <b>diaphragm becomes visible across its entire width</b> — the continuous diaphragm sign." },
            { q: "What CXR finding is associated with Pneumocystis jirovecii pneumonia (PJP)?", a: "<b>Bilateral, diffuse, perihilar ground-glass opacities</b> with relative sparing of the apices and periphery (in early disease). May progress to consolidation. Pneumatoceles and pneumothorax can occur. Seen in <b>severely immunocompromised patients (CD4 <200)</b>." },
            { q: "What is the 'figure-of-8' or 'snowman sign' on CXR?", a: "Seen in <b>total anomalous pulmonary venous return (TAPVR) — supracardiac type</b>. The dilated vertical vein, innominate vein, and SVC form the upper circle ('snowman's head'), and the enlarged heart forms the lower circle." }
          ]
        },
        {
          section: 'Clinical Skills & Diagnostics',
          topic: "ABG interpretation",
          icon: 'stethoscope',
          cards: [
            { q: "What is the preferred artery for ABG sampling and why?", a: "The <b>radial artery</b> at the wrist is preferred because it is superficial, easily palpable, and has <b>dual collateral circulation</b> (ulnar artery) via the palmar arches, minimizing ischemic risk." },
            { q: "What is the Allen's test and when is it performed?", a: "Allen's test assesses <b>ulnar collateral circulation</b> before radial artery puncture. Compress both radial and ulnar arteries → patient clenches/opens fist → release ulnar artery → palm should <b>re-pink within 5-10 seconds</b>. A negative (abnormal) test means poor collateral flow." },
            { q: "What angle should the needle be held at for radial artery puncture?", a: "<b>30-45 degrees</b> to the skin, bevel up, directed against the flow of blood (toward the heart). The wrist should be dorsiflexed ~30° over a rolled towel." },
            { q: "Name the six core components reported on an ABG.", a: "<b>pH</b> (acid-base status), <b>PaCO₂</b> (respiratory component), <b>PaO₂</b> (oxygenation), <b>HCO₃⁻</b> (metabolic component), <b>SaO₂</b> (oxygen saturation), and <b>Base Excess (BE)</b>." },
            { q: "Which ABG values are directly measured and which are calculated?", a: "<b>Directly measured:</b> pH, PaCO₂, PaO₂. <b>Calculated:</b> HCO₃⁻ (from Henderson-Hasselbalch), Base Excess, SaO₂ (often co-oximetry measured)." },
            { q: "What is the normal range for arterial blood pH?", a: "<b>7.35 – 7.45</b>. Below 7.35 = acidemia; above 7.45 = alkalemia." },
            { q: "What is the normal range for PaCO₂?", a: "<b>35 – 45 mmHg</b>. PaCO₂ reflects the <b>respiratory component</b> of acid-base balance; it is regulated by alveolar ventilation." },
            { q: "What is the normal range for PaO₂?", a: "<b>80 – 100 mmHg</b> (on room air at sea level). Values < 60 mmHg indicate <b>hypoxemia</b> and correspond to SaO₂ ~90% on the oxyhemoglobin dissociation curve." },
            { q: "What is the normal range for HCO₃⁻?", a: "<b>22 – 26 mEq/L</b>. HCO₃⁻ represents the <b>metabolic (renal) component</b> of acid-base balance." },
            { q: "What is the normal range for Base Excess (BE)?", a: "<b>−2 to +2 mEq/L</b>. A negative BE indicates a base deficit (metabolic acidosis); a positive BE indicates base excess (metabolic alkalosis)." },
            { q: "What is SaO₂ and its normal value?", a: "<b>SaO₂</b> = arterial oxygen saturation, the percentage of hemoglobin binding sites occupied by O₂. Normal: <b>95 – 100%</b>." },
            { q: "Write the alveolar gas equation for PAO₂.", a: "$PAO_2 = FiO_2 \\\\times (P_{atm} - P_{H_2O}) - \\\\frac{PaCO_2}{R}$<br>On room air at sea level: $PAO_2 = 0.21 \\\\times (760 - 47) - \\\\frac{PaCO_2}{0.8}$<br>≈ 150 − 1.25 × PaCO₂" },
            { q: "What is the A-a gradient and how is it calculated?", a: "<b>A-a gradient = PAO₂ − PaO₂</b>. It measures the difference between alveolar and arterial oxygen. Normal ≈ <b>5–15 mmHg</b> in young adults. Age-adjusted: (Age/4) + 4." },
            { q: "What does an elevated A-a gradient indicate?", a: "An elevated A-a gradient indicates impaired gas exchange due to: <b>V/Q mismatch</b> (most common), <b>shunt</b> (intracardiac or intrapulmonary), or <b>diffusion impairment</b> (e.g., pulmonary fibrosis)." },
            { q: "In which causes of hypoxemia is the A-a gradient NORMAL?", a: "<b>Hypoventilation</b> (e.g., opiate overdose, obesity hypoventilation) and <b>low FiO₂</b> (high altitude). Both reduce PAO₂ but gas exchange itself is intact." },
            { q: "What is the P/F ratio and how is it used?", a: "<b>P/F ratio = PaO₂ / FiO₂</b>. Normal > 400. <b>< 300</b> = ALI/mild ARDS; <b>< 200</b> = moderate-to-severe ARDS; <b>< 100</b> = severe ARDS (Berlin criteria)." },
            { q: "Write the oxygen content equation (CaO₂).", a: "$CaO_2 = (1.34 \\\\times Hb \\\\times SaO_2) + (0.003 \\\\times PaO_2)$<br>The first term is O₂ bound to hemoglobin (major contributor); the second is dissolved O₂ (minor)." },
            { q: "What is the normal CaO₂ value?", a: "Approximately <b>16 – 22 mL O₂/dL</b> (assuming Hb 15 g/dL, SaO₂ 100%). CaO₂ = (1.34 × 15 × 1.0) + (0.003 × 100) ≈ 20.4 mL/dL." },
            { q: "Describe the oxyhemoglobin dissociation curve.", a: "A <b>sigmoid-shaped</b> curve plotting SaO₂ (y-axis) vs. PaO₂ (x-axis). The steep portion (PaO₂ 20–60) allows efficient O₂ loading/unloading; the flat upper portion (PaO₂ > 70) ensures high saturation despite PaO₂ changes." },
            { q: "What factors cause a RIGHT shift of the oxyhemoglobin dissociation curve?", a: "Right shift = ↓ Hb-O₂ affinity → easier O₂ <b>unloading</b> to tissues. Causes: ↑ Temperature, ↑ PaCO₂, ↑ 2,3-DPG, ↓ pH (acidosis). Mnemonic: <b>'CADET, face Right'</b> — CO₂, Acid, DPG, Exercise, Temperature." },
            { q: "What factors cause a LEFT shift of the oxyhemoglobin dissociation curve?", a: "Left shift = ↑ Hb-O₂ affinity → O₂ binds tightly, less unloading. Causes: ↓ Temperature, ↓ PaCO₂, ↓ 2,3-DPG, ↑ pH (alkalosis), <b>CO poisoning</b>, fetal hemoglobin (HbF), methemoglobin." },
            { q: "What is the P50 and its normal value?", a: "<b>P50</b> = PaO₂ at which Hb is 50% saturated. Normal ≈ <b>26.6 mmHg</b>. ↑ P50 = right shift; ↓ P50 = left shift." },
            { q: "Write the Henderson-Hasselbalch equation.", a: "$pH = 6.1 + \\\\log \\\\frac{[HCO_3^-]}{0.03 \\\\times PaCO_2}$<br>This relates pH to the ratio of metabolic (HCO₃⁻) and respiratory (PaCO₂) components. Normal ratio ≈ 20:1." },
            { q: "Name the four major buffer systems in the body.", a: "1. <b>Bicarbonate-carbonic acid</b> (major ECF buffer)<br>2. <b>Phosphate</b> buffer (important in renal tubules and ICF)<br>3. <b>Protein</b> buffers (hemoglobin, albumin)<br>4. <b>Bone</b> (calcium carbonate, chronic buffering)" },
            { q: "How does the respiratory system compensate for metabolic acid-base disorders?", a: "<b>Metabolic acidosis</b> → ↓ pH stimulates central/peripheral chemoreceptors → <b>hyperventilation</b> → ↓ PaCO₂ (blows off CO₂).<br><b>Metabolic alkalosis</b> → ↑ pH → <b>hypoventilation</b> → ↑ PaCO₂ (retains CO₂). Respiratory compensation begins within <b>minutes</b>." },
            { q: "How do the kidneys compensate for respiratory acid-base disorders?", a: "<b>Respiratory acidosis</b> → kidneys ↑ HCO₃⁻ reabsorption & ↑ H⁺ secretion → ↑ serum HCO₃⁻.<br><b>Respiratory alkalosis</b> → kidneys ↓ HCO₃⁻ reabsorption → ↓ serum HCO₃⁻. Renal compensation takes <b>3-5 days</b> to be fully effective." },
            { q: "What defines a primary metabolic acidosis on ABG?", a: "<b>↓ pH (< 7.35)</b> with <b>↓ HCO₃⁻ (< 22 mEq/L)</b> as the primary disturbance. PaCO₂ will be low (compensatory hyperventilation)." },
            { q: "What defines a primary metabolic alkalosis on ABG?", a: "<b>↑ pH (> 7.45)</b> with <b>↑ HCO₃⁻ (> 26 mEq/L)</b> as the primary disturbance. PaCO₂ will be elevated (compensatory hypoventilation)." },
            { q: "What defines a primary respiratory acidosis on ABG?", a: "<b>↓ pH (< 7.35)</b> with <b>↑ PaCO₂ (> 45 mmHg)</b> as the primary disturbance. HCO₃⁻ will be elevated (renal compensation)." },
            { q: "What defines a primary respiratory alkalosis on ABG?", a: "<b>↑ pH (> 7.45)</b> with <b>↓ PaCO₂ (< 35 mmHg)</b> as the primary disturbance. HCO₃⁻ will be low (renal compensation)." },
            { q: "State Winter's formula and its use.", a: "$Expected\\;PaCO_2 = 1.5 \\\\times [HCO_3^-] + 8 \\\\pm 2$<br>Used in <b>metabolic acidosis</b> to assess if respiratory compensation is appropriate. If actual PaCO₂ differs, a <b>mixed disorder</b> exists." },
            { q: "If actual PaCO₂ is HIGHER than predicted by Winter's formula, what does this indicate?", a: "A concurrent <b>respiratory acidosis</b> (inadequate hyperventilation). The patient has a <b>mixed metabolic acidosis + respiratory acidosis</b>." },
            { q: "If actual PaCO₂ is LOWER than predicted by Winter's formula, what does this indicate?", a: "A concurrent <b>respiratory alkalosis</b> (excessive hyperventilation). The patient has a <b>mixed metabolic acidosis + respiratory alkalosis</b>." },
            { q: "What is the expected PaCO₂ in metabolic alkalosis?", a: "$Expected\\;PaCO_2 = 0.7 \\\\times [HCO_3^-] + 21 \\\\pm 2$<br>Alternatively: PaCO₂ ≈ 40 + 0.7 × (HCO₃⁻ − 24). Respiratory compensation rarely raises PaCO₂ above <b>55 mmHg</b>." },
            { q: "What is the expected HCO₃⁻ change in ACUTE respiratory acidosis?", a: "HCO₃⁻ rises <b>1 mEq/L for every 10 mmHg rise in PaCO₂</b>. This is from tissue buffering (not renal compensation)." },
            { q: "What is the expected HCO₃⁻ change in CHRONIC respiratory acidosis?", a: "HCO₃⁻ rises <b>3.5 mEq/L for every 10 mmHg rise in PaCO₂</b>. Renal compensation takes 3-5 days to become maximal." },
            { q: "What is the expected HCO₃⁻ change in ACUTE respiratory alkalosis?", a: "HCO₃⁻ falls <b>2 mEq/L for every 10 mmHg fall in PaCO₂</b>." },
            { q: "What is the expected HCO₃⁻ change in CHRONIC respiratory alkalosis?", a: "HCO₃⁻ falls <b>5 mEq/L for every 10 mmHg fall in PaCO₂</b>." },
            { q: "Can compensation ever fully normalize the pH?", a: "<b>No</b> — physiologic compensation is never complete (pH moves toward normal but does not reach 7.40). Exception: <b>chronic respiratory alkalosis</b>, where pH may normalize." },
            { q: "How do you calculate the serum anion gap (AG)?", a: "$AG = Na^+ - (Cl^- + HCO_3^-)$<br>Normal AG = <b>12 ± 4 mEq/L</b> (or 8-12 without K⁺). The AG represents unmeasured anions (albumin, phosphate, sulfate, organic anions)." },
            { q: "Why must the AG be corrected for albumin?", a: "Albumin is the major unmeasured anion. For every 1 g/dL ↓ albumin below 4, the AG drops ~2.5 mEq/L. <b>Corrected AG = AG + 2.5 × (4.0 − measured albumin)</b>. Hypoalbuminemia can mask a high AG acidosis." },
            { q: "List the causes of high anion gap metabolic acidosis using the GOLDMARK mnemonic.", a: "<b>G</b> – Glycols (ethylene glycol, propylene glycol)<br><b>O</b> – Oxoproline (acetaminophen metabolite, 5-oxoproline)<br><b>L</b> – L-Lactic acidosis<br><b>D</b> – D-Lactic acidosis<br><b>M</b> – Methanol<br><b>A</b> – Aspirin (salicylates)<br><b>R</b> – Renal failure (uremia)<br><b>K</b> – Ketoacidosis (DKA, alcoholic, starvation)" },
            { q: "List causes of high AG metabolic acidosis using the MUDPILES mnemonic.", a: "<b>M</b> – Methanol<br><b>U</b> – Uremia<br><b>D</b> – DKA<br><b>P</b> – Propylene glycol / Paraldehyde<br><b>I</b> – Isoniazid / Iron<br><b>L</b> – Lactic acidosis<br><b>E</b> – Ethylene glycol<br><b>S</b> – Salicylates" },
            { q: "What are the causes of normal AG (hyperchloremic) metabolic acidosis?", a: "<b>GI HCO₃⁻ loss:</b> diarrhea, ileostomy, fistulas<br><b>Renal:</b> RTA types 1, 2, 4; early renal failure; carbonic anhydrase inhibitors (acetazolamide)<br><b>Other:</b> normal saline infusion (dilutional), ureteral diversion, TPN" },
            { q: "How do you use urine anion gap to distinguish causes of normal AG metabolic acidosis?", a: "<b>Urine AG = Urine Na⁺ + K⁺ − Cl⁻</b>.<br><b>Negative UAG</b> (↑ NH₄⁺ excretion) → GI loss (diarrhea) — kidneys are appropriately compensating.<br><b>Positive UAG</b> → Renal cause (RTA) — kidneys are failing to excrete NH₄⁺." },
            { q: "What is the delta-delta (Δ-Δ) ratio and how is it interpreted?", a: "$\\\\Delta\\\\text{-}\\\\Delta = \\\\frac{\\\\Delta AG}{\\\\Delta HCO_3^-} = \\\\frac{AG - 12}{24 - HCO_3^-}$<br><b>< 1:</b> concurrent non-AG metabolic acidosis<br><b>1-2:</b> pure AG metabolic acidosis<br><b>> 2:</b> concurrent metabolic alkalosis (HCO₃⁻ is higher than expected)" },
            { q: "A delta-delta ratio < 1 suggests what additional disorder?", a: "A <b>concurrent normal anion gap (hyperchloremic) metabolic acidosis</b>. The HCO₃⁻ has fallen more than expected from the AG elevation alone." },
            { q: "A delta-delta ratio > 2 suggests what additional disorder?", a: "A <b>concurrent metabolic alkalosis</b>. The HCO₃⁻ has not fallen as much as expected (another process is raising it, e.g., vomiting or volume contraction)." },
            { q: "What are the two categories of metabolic alkalosis based on treatment?", a: "<b>Saline-responsive</b> (urine Cl⁻ < 20 mEq/L): due to volume contraction — responds to NS infusion.<br><b>Saline-resistant</b> (urine Cl⁻ > 20 mEq/L): due to mineralocorticoid excess — does not respond to NS." },
            { q: "List causes of saline-responsive metabolic alkalosis.", a: "<b>Vomiting / NG suction</b> (loss of HCl), <b>diuretics</b> (loop, thiazide — after the effect), <b>post-hypercapnia</b>, <b>villous adenoma</b>, <b>congenital chloride diarrhea</b>." },
            { q: "List causes of saline-resistant metabolic alkalosis.", a: "<b>Primary hyperaldosteronism</b> (Conn syndrome), <b>Cushing syndrome</b>, <b>renovascular disease</b>, <b>Liddle syndrome</b>, <b>Bartter/Gitelman syndrome</b>, <b>exogenous mineralocorticoids</b>, severe K⁺ depletion." },
            { q: "Why is urine chloride used rather than urine sodium to classify metabolic alkalosis?", a: "In vomiting-induced alkalosis, filtered HCO₃⁻ exceeds reabsorptive capacity → HCO₃⁻ is excreted with Na⁺ as an obligate cation (bicarbonaturia). This makes urine Na⁺ misleadingly high. <b>Urine Cl⁻</b> remains low, accurately reflecting volume depletion." },
            { q: "What are the causes of acute respiratory acidosis?", a: "<b>Airway obstruction</b> (foreign body, asthma, laryngospasm), <b>CNS depression</b> (opioids, sedatives, stroke), <b>neuromuscular</b> (Guillain-Barré, myasthenia crisis), <b>chest wall</b> (flail chest, pneumothorax), <b>acute pulmonary edema</b>." },
            { q: "What are the causes of chronic respiratory acidosis?", a: "<b>COPD</b> (most common), <b>obesity hypoventilation syndrome (OHS/Pickwickian)</b>, <b>kyphoscoliosis</b>, chronic neuromuscular disease (ALS, muscular dystrophy), <b>interstitial lung disease</b> (late)." },
            { q: "How do you differentiate acute from chronic respiratory acidosis on ABG?", a: "Look at the degree of HCO₃⁻ compensation:<br><b>Acute:</b> HCO₃⁻ ↑ 1 per 10 PaCO₂ ↑ (minimal change, pH significantly low).<br><b>Chronic:</b> HCO₃⁻ ↑ 3.5 per 10 PaCO₂ ↑ (significant compensation, near-normal pH)." },
            { q: "List common causes of respiratory alkalosis.", a: "<b>Anxiety/pain/hyperventilation syndrome</b>, <b>hypoxemia</b> (any cause), <b>PE</b>, <b>pneumonia</b>, <b>early salicylate toxicity</b>, <b>pregnancy</b> (progesterone), <b>high altitude</b>, <b>sepsis (early)</b>, <b>hepatic failure</b>, <b>CNS disease</b> (stroke, meningitis)." },
            { q: "Why does pregnancy cause respiratory alkalosis?", a: "<b>Progesterone</b> directly stimulates the medullary respiratory center → chronic hyperventilation → ↓ PaCO₂ (typically 28-32 mmHg). This is a normal physiologic change; HCO₃⁻ drops to ~18-21 by renal compensation." },
            { q: "Why does salicylate toxicity cause both respiratory alkalosis AND metabolic acidosis?", a: "Salicylates directly stimulate the <b>medullary respiratory center</b> → respiratory alkalosis (early). They also <b>uncouple oxidative phosphorylation</b> and inhibit Krebs cycle → lactic acidosis + ketoacidosis → high AG metabolic acidosis (late)." },
            { q: "What are the steps to systematically interpret an ABG?", a: "1. Assess <b>oxygenation</b> (PaO₂, A-a gradient)<br>2. Determine <b>acidemia or alkalemia</b> (pH)<br>3. Identify the <b>primary disorder</b> (PaCO₂ vs HCO₃⁻)<br>4. Assess <b>compensation</b> (apply appropriate formula)<br>5. Calculate <b>anion gap</b> (if metabolic acidosis)<br>6. Calculate <b>delta-delta</b> (if elevated AG)<br>7. Integrate with <b>clinical context</b>" },
            { q: "How do you identify a mixed acid-base disorder?", a: "Clues: <b>pH is normal with abnormal PaCO₂/HCO₃⁻</b>, compensation does not match expected values, AG is elevated but HCO₃⁻ is normal, or delta-delta ratio is abnormal (< 1 or > 2)." },
            { q: "Give an example of a triple acid-base disorder.", a: "<b>Alcoholic patient with vomiting and sepsis:</b><br>1. High AG metabolic acidosis (lactic acidosis + ketoacidosis)<br>2. Metabolic alkalosis (vomiting → HCl loss)<br>3. Respiratory alkalosis (sepsis → hyperventilation)<br>Detected via AG elevation + delta-delta > 2 + PaCO₂ lower than Winter's prediction." },
            { q: "What is the osmolar gap and how is it calculated?", a: "$Osmolar\\;gap = Measured\\;osmolality - Calculated\\;osmolality$<br>$Calc\\;osm = 2[Na^+] + \\\\frac{glucose}{18} + \\\\frac{BUN}{2.8}$<br>Normal osmolar gap: <b>< 10 mOsm/kg</b>." },
            { q: "What does an elevated osmolar gap with a high AG metabolic acidosis suggest?", a: "Ingestion of <b>toxic alcohols</b>: <b>methanol</b> (formic acid), <b>ethylene glycol</b> (oxalic acid / glycolic acid), or <b>isopropyl alcohol</b> (though isopropyl causes elevated OG without AG acidosis — metabolized to acetone, not acid)." },
            { q: "How does methanol poisoning present on labs?", a: "<b>High AG metabolic acidosis</b> + <b>elevated osmolar gap</b> (early, before metabolism) + <b>visual disturbances</b> (optic nerve damage from formate). Treatment: <b>fomepizole</b> (or ethanol) + hemodialysis." },
            { q: "How does ethylene glycol poisoning present on labs?", a: "<b>High AG metabolic acidosis</b> + <b>elevated osmolar gap</b> + <b>calcium oxalate crystals in urine</b> + <b>acute kidney injury</b>. Treatment: <b>fomepizole</b> + hemodialysis." },
            { q: "Why does the osmolar gap decrease as the anion gap increases in toxic alcohol ingestion?", a: "The parent alcohol (osmotically active but non-ionized) is <b>metabolized</b> into organic acid anions. As the alcohol is consumed, osmolar gap falls; as acid anions accumulate, AG rises. Early: ↑ OG, normal AG. Late: normal OG, ↑ AG." },
            { q: "What are the differences between VBG and ABG values?", a: "<b>Venous pH</b> ≈ 0.03-0.05 lower than arterial.<br><b>Venous PaCO₂</b> ≈ 3-8 mmHg higher.<br><b>Venous HCO₃⁻</b> ≈ 1-2 mEq/L higher.<br><b>PvO₂</b> is NOT useful for assessing oxygenation (typically 35-45 mmHg)." },
            { q: "When is a VBG an acceptable substitute for an ABG?", a: "VBG can reliably assess <b>acid-base status</b> (pH, HCO₃⁻, lactate) and trend PaCO₂. It is <b>NOT adequate for oxygenation assessment</b> (PaO₂). Use ABG when precise PaO₂/A-a gradient is needed or in severe shock." },
            { q: "Describe the ABG findings in diabetic ketoacidosis (DKA).", a: "<b>High AG metabolic acidosis</b> (ketoacids: β-hydroxybutyrate, acetoacetate). pH low, HCO₃⁻ low, AG elevated. <b>Respiratory compensation</b>: Kussmaul breathing → ↓ PaCO₂. Check delta-delta for concurrent metabolic alkalosis (e.g., from vomiting)." },
            { q: "What is Kussmaul breathing?", a: "Deep, labored, rapid breathing seen in severe <b>metabolic acidosis</b> (classically DKA). It represents maximal respiratory compensation attempting to lower PaCO₂ and raise pH." },
            { q: "What ABG pattern is seen in acute COPD exacerbation?", a: "<b>Acute-on-chronic respiratory acidosis:</b> ↑ PaCO₂ (above chronic baseline), ↓ pH, ↑ HCO₃⁻ (already elevated from chronic compensation). PaO₂ is low. The pH drop is more than expected for pure chronic respiratory acidosis." },
            { q: "Why is excessive O₂ supplementation dangerous in COPD?", a: "COPD patients with chronic CO₂ retention rely partly on <b>hypoxic drive</b> for ventilation. Excessive O₂ can also worsen V/Q mismatch (Haldane effect, loss of hypoxic vasoconstriction) → further ↑ PaCO₂ → <b>CO₂ narcosis</b> and respiratory failure." },
            { q: "What ABG pattern is seen in early sepsis?", a: "<b>Respiratory alkalosis</b> (↓ PaCO₂, ↑ pH) — due to hyperventilation from fever, cytokine-mediated stimulation of respiratory center, and early lactic acidosis-driven tachypnea." },
            { q: "What ABG pattern is seen in late/severe sepsis?", a: "<b>High AG metabolic acidosis</b> (lactic acidosis from tissue hypoperfusion) ± <b>respiratory acidosis</b> (respiratory muscle fatigue). pH is markedly low; this is an ominous sign." },
            { q: "What are the types of Renal Tubular Acidosis (RTA)?", a: "<b>Type 1 (Distal):</b> Cannot secrete H⁺ → urine pH > 5.5, hypokalemia<br><b>Type 2 (Proximal):</b> Cannot reabsorb HCO₃⁻ → urine pH variable, hypokalemia<br><b>Type 4 (Hypoaldosteronism):</b> ↓ Aldosterone → hyperkalemia, urine pH < 5.5<br>All cause <b>normal AG metabolic acidosis</b>." },
            { q: "How do you differentiate Type 1 from Type 2 RTA?", a: "<b>Type 1:</b> Urine pH always > 5.5, severe acidosis (HCO₃⁻ can be very low), nephrocalcinosis/stones common.<br><b>Type 2:</b> Urine pH > 5.5 only when HCO₃⁻ above threshold (then < 5.5 once HCO₃⁻ stabilizes below threshold), milder acidosis, associated with Fanconi syndrome." },
            { q: "What is the serum K⁺ pattern in each type of RTA?", a: "<b>Type 1 (Distal):</b> Hypokalemia (↑ K⁺ secretion distally)<br><b>Type 2 (Proximal):</b> Hypokalemia (HCO₃⁻ wasting causes Na⁺ delivery distally → K⁺ loss)<br><b>Type 4:</b> <b>Hyperkalemia</b> (↓ aldosterone → ↓ K⁺ and H⁺ secretion)" },
            { q: "What are the two types of lactic acidosis?", a: "<b>Type A:</b> Tissue hypoxia/hypoperfusion (shock, cardiac arrest, severe hypoxemia, mesenteric ischemia, CO poisoning).<br><b>Type B:</b> No tissue hypoxia — caused by metabolic derangements (metformin, liver failure, malignancy, thiamine deficiency, mitochondrial disease)." },
            { q: "What is D-lactic acidosis?", a: "Caused by bacterial fermentation of carbohydrates in the colon, typically in patients with <b>short bowel syndrome</b> or after <b>jejunoileal bypass</b>. Presents with high AG metabolic acidosis, encephalopathy. <b>Standard lactate assays do not detect D-lactate</b> (they measure L-lactate)." },
            { q: "Describe the ABG in salicylate poisoning.", a: "<b>Mixed disorder:</b><br>1. <b>Respiratory alkalosis</b> (direct CNS stimulation → hyperventilation)<br>2. <b>High AG metabolic acidosis</b> (uncoupled oxidative phosphorylation, ketoacids, lactic acid)<br>Often the pH is alkalemic early and becomes acidemic late — a sign of clinical deterioration." },
            { q: "What is the expected PaO₂ for a given age?", a: "Approximate formula: $Expected\\;PaO_2 ≈ 104 - (0.4 \\\\times age)$ mmHg. Example: 60-year-old → expected PaO₂ ≈ 104 − 24 = 80 mmHg." },
            { q: "Define hypoxemia vs. hypoxia.", a: "<b>Hypoxemia</b> = low PaO₂ in arterial blood (< 80 mmHg).<br><b>Hypoxia</b> = inadequate O₂ delivery to tissues. Hypoxia can occur with normal PaO₂ (e.g., anemia, CO poisoning, cyanide)." },
            { q: "List the five mechanisms of hypoxemia.", a: "1. <b>Low FiO₂</b> (high altitude)<br>2. <b>Hypoventilation</b> (↑ PaCO₂)<br>3. <b>V/Q mismatch</b> (most common; COPD, asthma, PE)<br>4. <b>Right-to-left shunt</b> (does NOT correct with 100% O₂)<br>5. <b>Diffusion impairment</b> (fibrosis, emphysema)" },
            { q: "How do you distinguish shunt from V/Q mismatch?", a: "<b>Administer 100% O₂:</b> V/Q mismatch → PaO₂ improves significantly. Shunt → PaO₂ does <b>NOT</b> improve (blood bypasses ventilated alveoli completely). Both have elevated A-a gradient." },
            { q: "What is the respiratory quotient (R) and its normal value?", a: "<b>R = CO₂ production / O₂ consumption (VCO₂/VO₂)</b>. Normal ≈ <b>0.8</b> on a mixed diet. Carbohydrate metabolism: R = 1.0; fat metabolism: R ≈ 0.7; protein: R ≈ 0.8. Used in the alveolar gas equation." },
            { q: "What does Base Excess (BE) represent?", a: "BE = the amount of acid (in mEq/L) needed to return blood pH to 7.40 at PaCO₂ 40 and 37°C. <b>Positive BE</b> = excess base (metabolic alkalosis). <b>Negative BE (base deficit)</b> = acid excess (metabolic acidosis)." },
            { q: "How is base excess clinically useful?", a: "BE isolates the <b>metabolic component</b>, unaffected by respiratory changes. A base deficit > 6 in trauma correlates with significant blood loss and mortality. Serial BE measurements help guide <b>resuscitation adequacy</b>." },
            { q: "What is Standard Base Excess (SBE)?", a: "<b>SBE</b> is calculated for the extracellular fluid compartment (standardized to Hb 5 g/dL to approximate whole-body buffering). It is more accurate than BE for in-vivo metabolic acid-base assessment and is the preferred metric in the Copenhagen approach." },
            { q: "Describe the Stewart (physicochemical) approach to acid-base.", a: "Stewart's approach states pH is determined by three independent variables:<br>1. <b>SID</b> (Strong Ion Difference)<br>2. <b>Total weak acids (A_TOT)</b> — mainly albumin and phosphate<br>3. <b>PaCO₂</b><br>pH is a <b>dependent</b> variable determined by these three." },
            { q: "What is the Strong Ion Difference (SID)?", a: "$SID = (Na^+ + K^+ + Ca^{2+} + Mg^{2+}) - (Cl^- + lactate^-)$<br>Normal apparent SID ≈ <b>40-42 mEq/L</b>. ↓ SID → acidosis; ↑ SID → alkalosis." },
            { q: "How does hyperchloremia cause acidosis in the Stewart model?", a: "↑ Cl⁻ → <b>↓ SID</b> (more strong anions relative to strong cations) → the electrochemical constraint forces water to dissociate more → ↑ H⁺ → acidosis. This explains normal saline-induced (dilutional) hyperchloremic acidosis." },
            { q: "How does hypoalbuminemia affect acid-base in the Stewart model?", a: "↓ Albumin → ↓ A_TOT (total weak acids) → <b>metabolic alkalosis</b>. This also explains why correcting AG for albumin is essential — hypoalbuminemia masks a true high AG acidosis." },
            { q: "What is the Strong Ion Gap (SIG)?", a: "$SIG = SID_{apparent} - SID_{effective}$<br>SIG quantifies unmeasured anions. Elevated SIG is analogous to an elevated AG and indicates presence of unmeasured strong anions (e.g., ketoacids, lactate, toxins)." },
            { q: "A patient has pH 7.28, PaCO₂ 24, HCO₃⁻ 11. What is the primary disorder?", a: "<b>Metabolic acidosis</b> (↓ pH, ↓ HCO₃⁻). PaCO₂ is low (respiratory compensation). Winter's: expected PaCO₂ = 1.5(11) + 8 ± 2 = 22.5-26.5 → actual 24 is appropriate. This is a <b>simple metabolic acidosis with appropriate compensation</b>." },
            { q: "A patient has pH 7.52, PaCO₂ 48, HCO₃⁻ 38. What is the primary disorder?", a: "<b>Metabolic alkalosis</b> (↑ pH, ↑ HCO₃⁻). PaCO₂ is elevated (respiratory compensation). Expected PaCO₂ = 0.7(38) + 21 ± 2 = 46-50 → actual 48 fits. <b>Simple metabolic alkalosis with appropriate compensation.</b>" },
            { q: "A patient has pH 7.22, PaCO₂ 60, HCO₃⁻ 24. What is the primary disorder?", a: "<b>Acute respiratory acidosis</b> (↓ pH, ↑ PaCO₂). HCO₃⁻ expected: 24 + 1 × (60−40)/10 = 26. Actual 24 is close → <b>acute respiratory acidosis</b>. If HCO₃⁻ were 31, it would suggest chronic." },
            { q: "A patient has pH 7.48, PaCO₂ 20, HCO₃⁻ 15. Acute or chronic respiratory alkalosis?", a: "Primary respiratory alkalosis (↑ pH, ↓ PaCO₂). <b>Acute:</b> expected HCO₃⁻ = 24 − 2 × (40−20)/10 = 20. <b>Chronic:</b> expected HCO₃⁻ = 24 − 5 × 2 = 14. Actual 15 → closer to <b>chronic respiratory alkalosis</b>." },
            { q: "A patient has pH 7.40, PaCO₂ 24, HCO₃⁻ 14, AG 24. What is the interpretation?", a: "<b>Mixed disorder:</b> Normal pH with abnormal PaCO₂ and HCO₃⁻ suggests opposing processes. High AG (24) → AG metabolic acidosis. Low PaCO₂ out of proportion → concurrent <b>respiratory alkalosis</b>. The two disorders cancel to normalize pH." },
            { q: "What clinical scenario causes a combined high AG metabolic acidosis and metabolic alkalosis?", a: "<b>DKA with vomiting</b>: Ketoacidosis raises AG, while vomiting causes HCl loss → metabolic alkalosis. Delta-delta > 2 (HCO₃⁻ higher than expected for the AG rise)." },
            { q: "How does pulmonary embolism affect ABG?", a: "<b>Respiratory alkalosis</b> (↓ PaCO₂ from hyperventilation due to hypoxemia, pain, reflex). ↑ A-a gradient (V/Q mismatch + dead space). ↓ PaO₂. Note: ABG can be normal in small PE — does not rule out PE." },
            { q: "What is the significance of a PaO₂/FiO₂ ratio < 200?", a: "Meets the oxygenation criterion for <b>moderate-to-severe ARDS</b> (Berlin definition). Indicates severe impairment in gas exchange. Also requires: bilateral opacities, respiratory failure not fully explained by cardiac failure/volume overload, and onset within 1 week." },
            { q: "What happens to ABG at high altitude?", a: "<b>Respiratory alkalosis:</b> Low barometric pressure → ↓ PAO₂ → hypoxemia → ↑ ventilation → ↓ PaCO₂ → ↑ pH. Over days, renal compensation ↓ HCO₃⁻ → pH normalizes (chronic respiratory alkalosis)." },
            { q: "How do you calculate FiO₂ from nasal cannula flow rate?", a: "Each liter/min of O₂ via nasal cannula adds ~<b>3-4% FiO₂</b> above room air (21%).<br>1L ≈ 24%, 2L ≈ 28%, 3L ≈ 32%, 4L ≈ 36%, 5L ≈ 40%, 6L ≈ 44%. (These are rough estimates; actual FiO₂ varies with respiratory pattern.)" },
            { q: "What common errors can affect ABG sample accuracy?", a: "<b>Air bubbles</b> → falsely ↑ PaO₂, ↓ PaCO₂<br><b>Excess heparin</b> → dilutional ↓ PaCO₂, ↓ HCO₃⁻<br><b>Delayed analysis</b> → ↓ PaO₂, ↑ PaCO₂ (continued cellular metabolism)<br><b>Venous contamination</b> → ↓ PaO₂, ↑ PaCO₂" },
            { q: "What ABG changes occur with carbon monoxide (CO) poisoning?", a: "PaO₂ is <b>normal</b> (dissolved O₂ unaffected). SaO₂ by pulse oximetry is <b>falsely normal</b> (reads COHb as OxHb). <b>Co-oximetry</b> reveals elevated <b>COHb</b>. CaO₂ is significantly reduced. May have <b>lactic acidosis</b>." },
            { q: "Why is pulse oximetry unreliable in CO poisoning?", a: "Pulse oximeters use two wavelengths to distinguish OxyHb and DeoxyHb. <b>COHb absorbs light similarly to OxyHb</b> at the wavelengths used → SpO₂ reads falsely high. Co-oximetry (multiple wavelengths) is needed to differentiate." },
            { q: "What is methemoglobinemia and how does it affect ABG?", a: "<b>MetHb</b> = hemoglobin with Fe³⁺ (cannot bind O₂). PaO₂ is <b>normal</b> (dissolved O₂ intact). SpO₂ trends toward <b>85%</b> regardless of true saturation. SaO₂ by co-oximetry is low. Causes: dapsone, nitrites, benzocaine. Treatment: <b>methylene blue</b>." },
            { q: "How does temperature affect ABG values?", a: "<b>Hypothermia:</b> ↑ O₂ and CO₂ solubility → actual in-vivo PaO₂ and PaCO₂ are lower than measured (machine warms sample to 37°C). <b>pH-stat</b> vs <b>alpha-stat</b> management strategies are used in hypothermic patients (e.g., cardiac surgery)." },
            { q: "What is the difference between alpha-stat and pH-stat strategies?", a: "<b>Alpha-stat:</b> ABG interpreted at 37°C without temperature correction; maintains constant charge on imidazole groups. Preferred for most cardiac surgery.<br><b>pH-stat:</b> ABG corrected to patient's actual temperature; CO₂ is added to maintain pH 7.40 at patient temp. May improve cerebral perfusion in deep hypothermia." },
            { q: "What ABG findings are seen in acute asthma exacerbation?", a: "<b>Mild/moderate:</b> Respiratory alkalosis (hyperventilation → ↓ PaCO₂), ↓ PaO₂.<br><b>Severe:</b> Normalizing PaCO₂ is an <b>ominous sign</b> — suggests respiratory muscle fatigue.<br><b>Near-fatal:</b> Respiratory acidosis (↑ PaCO₂, ↓ pH) — impending respiratory arrest." },
            { q: "Why is a 'normal' PaCO₂ in acute asthma concerning?", a: "Asthma normally triggers hyperventilation (↓ PaCO₂). A <b>normal PaCO₂ (40 mmHg)</b> during an acute attack suggests the patient is <b>tiring</b> and can no longer maintain compensatory hyperventilation — <b>impending respiratory failure</b>." },
            { q: "What is the anion gap in DKA, and what concurrent disorder may be present?", a: "AG is <b>elevated</b> due to accumulation of β-hydroxybutyrate and acetoacetate. Concurrent <b>normal AG metabolic acidosis</b> may develop during treatment (saline infusion → hyperchloremic acidosis as ketoanions are excreted). Delta-delta should be monitored." },
            { q: "What is the effect of massive blood transfusion on acid-base?", a: "Stored blood contains <b>citrate</b> → metabolized to HCO₃⁻ in the liver → <b>metabolic alkalosis</b>. Initially, citrate may bind Ca²⁺ → hypocalcemia. Hypothermia from cold blood and lactic acid from stored cells can cause transient acidosis." },
            { q: "What is the Bohr effect?", a: "↑ CO₂ and ↓ pH in tissue capillaries → ↓ Hb-O₂ affinity → facilitates O₂ <b>unloading</b> to tissues (right shift). In the lungs, ↓ CO₂ and ↑ pH → ↑ Hb-O₂ affinity → facilitates O₂ <b>loading</b> (left shift)." },
            { q: "What is the Haldane effect?", a: "Deoxygenated Hb binds CO₂ more readily than oxygenated Hb. In tissues: O₂ released → Hb picks up CO₂. In lungs: O₂ binds → CO₂ released. This is why excessive O₂ in COPD can ↑ PaCO₂ (Hb releases CO₂ less readily when oxygenated)." },
            { q: "How does chronic kidney disease cause metabolic acidosis?", a: "Early CKD: ↓ ammoniagenesis → <b>normal AG metabolic acidosis</b> (inability to excrete daily acid load).<br>Advanced CKD (GFR < 15-20): accumulation of sulfate, phosphate, urate → <b>high AG metabolic acidosis</b>." },
            { q: "What is the effect of acetazolamide on ABG?", a: "Acetazolamide inhibits carbonic anhydrase → ↓ proximal HCO₃⁻ reabsorption → <b>normal AG (hyperchloremic) metabolic acidosis</b> with alkaline urine. Used therapeutically for metabolic alkalosis and altitude sickness." },
            { q: "How do loop and thiazide diuretics cause metabolic alkalosis?", a: "<b>Volume contraction</b> → ↑ proximal Na⁺/HCO₃⁻ reabsorption (contraction alkalosis).<br><b>↑ Na⁺ delivery to CD</b> → ↑ Na⁺/K⁺ exchange and Na⁺/H⁺ exchange → ↑ H⁺ secretion.<br><b>Hypokalemia</b> → H⁺ shifts into cells, ↑ renal H⁺ secretion." },
            { q: "What is contraction alkalosis?", a: "Volume loss (e.g., diuretics, vomiting) contracts the ECF around a <b>relatively fixed amount of HCO₃⁻</b> → ↑ HCO₃⁻ concentration. Also, volume depletion stimulates proximal Na⁺ (and HCO₃⁻) reabsorption and activates RAAS → further H⁺ secretion." },
            { q: "What ABG is expected in a patient on chronic mechanical ventilation?", a: "If ventilator settings are stable: <b>chronic respiratory alkalosis or acidosis</b> depending on settings. Over-ventilation → chronic resp alkalosis (low HCO₃⁻). Under-ventilation → chronic resp acidosis (high HCO₃⁻). pH may be near-normal from renal compensation." },
            { q: "What is permissive hypercapnia?", a: "A ventilator strategy allowing <b>PaCO₂ to rise above normal</b> (50-80 mmHg) to avoid barotrauma/volutrauma by using low tidal volumes (lung-protective ventilation in ARDS). Mild acidemia (pH > 7.20) is tolerated. Contraindicated in raised ICP." },
            { q: "What is the significance of lactate on an ABG?", a: "Lactate > <b>2 mmol/L</b> = hyperlactatemia. > <b>4 mmol/L</b> = associated with significant mortality in sepsis. Elevated lactate reflects <b>tissue hypoperfusion</b> (Type A) or <b>metabolic dysfunction</b> (Type B). Serial measurements guide resuscitation." },
            { q: "How does propylene glycol cause a high AG metabolic acidosis?", a: "Propylene glycol (solvent in IV lorazepam, phenobarbital) is metabolized to <b>lactic acid and pyruvic acid</b>. Can also cause elevated <b>osmolar gap</b>. Suspect in ICU patients on prolonged lorazepam infusions with unexplained AG acidosis." },
            { q: "What is the expected ABG in a patient with pyloric stenosis?", a: "<b>Metabolic alkalosis</b> (loss of HCl from prolonged vomiting) + <b>hypokalemia</b> + <b>hypochloremia</b>. Urine Cl⁻ < 20 (saline-responsive). Paradoxical aciduria may occur when K⁺ is severely depleted (H⁺ is secreted instead of K⁺ in the distal nephron)." },
            { q: "What is paradoxical aciduria?", a: "Alkaline urine is expected in metabolic alkalosis. However, in <b>severe K⁺ depletion</b> (e.g., prolonged vomiting), the kidneys preferentially secrete <b>H⁺ instead of K⁺</b> to conserve potassium → acidic urine despite systemic alkalosis." },
            { q: "What is the Henderson equation (not Henderson-Hasselbalch)?", a: "$[H^+] = 24 \\\\times \\\\frac{PaCO_2}{[HCO_3^-]}$<br>Gives [H⁺] in nEq/L directly. Useful quick check: pH 7.40 → [H⁺] = 40; pH 7.30 → [H⁺] = 50; pH 7.20 → [H⁺] = 63; pH 7.50 → [H⁺] = 32." },
            { q: "How do you convert between pH and [H⁺]?", a: "Between pH 7.20-7.50, for each 0.01 change in pH, [H⁺] changes ~1 nEq/L in the <b>opposite direction</b>. pH 7.40 = 40 nEq/L. pH 7.30 = 50 nEq/L. pH 7.50 = 32 nEq/L. (<b>The 80 rule:</b> [H⁺] ≈ 80 − last two digits of pH.)" },
            { q: "What is the anion gap in renal failure?", a: "In advanced renal failure, retention of <b>sulfate, phosphate, urate, and hippurate</b> → elevated AG. Typically AG is 20-25 mEq/L. Very high AG (> 25) should prompt consideration of an additional cause (lactic acidosis, ketoacidosis, toxins)." },
            { q: "What is the effect of severe diarrhea on ABG?", a: "<b>Normal AG (hyperchloremic) metabolic acidosis</b> from GI loss of HCO₃⁻-rich fluid. Urine AG is <b>negative</b> (appropriate renal NH₄⁺ excretion). Often associated with hypokalemia." },
            { q: "What is 5-oxoproline (pyroglutamic acid) acidosis?", a: "High AG metabolic acidosis from accumulation of <b>5-oxoproline</b>, a glutathione cycle intermediate. Seen with <b>chronic acetaminophen use</b> (even therapeutic doses) in malnourished patients or those with glutathione depletion. Often overlooked." },
            { q: "How does toluene (glue-sniffing) cause metabolic acidosis?", a: "Toluene is metabolized to <b>hippuric acid</b> → initially causes high AG metabolic acidosis. Hippurate is rapidly renally excreted (with Na⁺/K⁺) → AG normalizes → <b>normal AG metabolic acidosis</b> with hypokalemia. Type depends on timing." },
            { q: "What is the 'rule of 8s' for quick ABG assessment?", a: "Quick compensation check: In metabolic acidosis, <b>expected PaCO₂ ≈ last two digits of pH</b> (e.g., pH 7.25 → PaCO₂ ~25). Not precise but useful as a rapid bedside cross-check before applying Winter's formula." },
            { q: "Describe the ABG in acute PE with a large clot burden.", a: "<b>Respiratory alkalosis</b> (hyperventilation) + <b>hypoxemia</b> with elevated A-a gradient. In massive PE → can progress to <b>metabolic acidosis</b> (lactic acid from low cardiac output and tissue hypoperfusion) + respiratory acidosis (right heart failure)." },
            { q: "What is the ABG pattern in anxiety-driven hyperventilation?", a: "<b>Acute respiratory alkalosis:</b> ↑ pH, ↓ PaCO₂, ↓ HCO₃⁻ (minimal, acute buffering only). PaO₂ normal or mildly elevated. <b>A-a gradient is normal</b> (key distinction from PE or other pathologic causes)." },
            { q: "How does isopropyl alcohol ingestion differ from methanol/ethylene glycol on ABG?", a: "Isopropyl alcohol → metabolized to <b>acetone</b> (a ketone, not an acid). Causes <b>elevated osmolar gap</b> but <b>NO anion gap acidosis</b>. Ketonemia/ketonuria without acidosis. This distinguishes it from methanol/ethylene glycol." },
            { q: "What is the effect of citrate (from blood products) on acid-base?", a: "Citrate is metabolized hepatically to <b>HCO₃⁻</b> → can cause <b>metabolic alkalosis</b> after massive transfusion. In liver failure, citrate accumulates and binds calcium → <b>hypocalcemia</b> and citrate toxicity." },
            { q: "What ABG pattern is characteristic of RTA Type 4?", a: "<b>Normal AG metabolic acidosis</b> + <b>hyperkalemia</b>. Urine pH < 5.5 (acidification ability intact, but ↓ NH₄⁺ production due to ↓ aldosterone and hyperkalemia). Most commonly from <b>hypoaldosteronism</b> (diabetes, NSAIDs, ACEi, heparin)." },
            { q: "How does albumin serve as a buffer?", a: "Albumin contains <b>histidine residues</b> with imidazole groups (pKa ~7.4), making it an effective buffer at physiologic pH. It is the principal <b>non-bicarbonate buffer</b> in plasma and a major determinant of A_TOT in the Stewart approach." },
            { q: "What does a negative base excess (base deficit) of −10 indicate clinically?", a: "A significant <b>metabolic acidosis</b>. In trauma, base deficit > 6 predicts <b>major hemorrhage</b> requiring transfusion. Base deficit > 10 is associated with high mortality and suggests need for aggressive resuscitation." },
            { q: "What is the relationship between chloride and bicarbonate?", a: "Cl⁻ and HCO₃⁻ are the two major extracellular anions. They have a <b>reciprocal relationship</b>: when Cl⁻ rises (e.g., NS infusion), HCO₃⁻ falls to maintain electroneutrality → <b>hyperchloremic acidosis</b>. When Cl⁻ falls (vomiting), HCO₃⁻ rises → alkalosis." },
            { q: "What is post-hypercapnic metabolic alkalosis?", a: "Chronic respiratory acidosis → kidneys ↑ HCO₃⁻ (compensation). If PaCO₂ is rapidly corrected (e.g., intubation), the <b>elevated HCO₃⁻ persists</b> (kidneys are slow to excrete) → metabolic alkalosis. Treat with acetazolamide or saline." },
            { q: "In the Stewart approach, how does normal saline cause acidosis?", a: "NS has [Na⁺] = [Cl⁻] = 154 mEq/L. Plasma Cl⁻ (~102) is proportionally increased more than Na⁺ (~140) → <b>↓ SID</b> → water dissociation shifts to produce more H⁺ → acidosis. Balanced crystalloids (LR, Plasmalyte) have SID closer to plasma." },
            { q: "What is the utility of the AG in assessing mixed metabolic disorders?", a: "If AG is elevated: calculate <b>delta-delta ratio</b>. If Δ AG > Δ HCO₃⁻ (ratio > 2) → hidden metabolic alkalosis. If Δ AG < Δ HCO₃⁻ (ratio < 1) → additional non-AG acidosis. This detects <b>mixed metabolic disorders</b> that pH alone may miss." },
            { q: "What are the Berlin criteria for ARDS severity using P/F ratio?", a: "<b>Mild:</b> P/F 200-300 (with PEEP/CPAP ≥ 5)<br><b>Moderate:</b> P/F 100-200 (with PEEP ≥ 5)<br><b>Severe:</b> P/F ≤ 100 (with PEEP ≥ 5)<br>All require: acute onset (≤ 7 days), bilateral opacities on imaging, not fully explained by heart failure." },
            { q: "How is the A-a gradient affected by supplemental oxygen?", a: "The A-a gradient <b>increases with higher FiO₂</b>. Normal A-a gradient on 100% O₂ is ~100 mmHg (vs. 5-15 on room air). Therefore, A-a gradient is most reliable when calculated on <b>room air</b>." },
            { q: "What is the expected PaCO₂ change in metabolic acidosis using the 'last 2 digits' rule?", a: "Expected PaCO₂ approximately equals the <b>last two digits of pH</b>. pH 7.22 → PaCO₂ ~22, pH 7.30 → PaCO₂ ~30. Quick bedside estimate, but Winter's formula is more accurate." },
            { q: "Why does hypokalemia perpetuate metabolic alkalosis?", a: "K⁺ depletion → <b>K⁺ shifts out of cells, H⁺ shifts in</b> → intracellular acidosis stimulates renal H⁺ secretion and HCO₃⁻ generation. Also, hypokalemia stimulates <b>H⁺-K⁺-ATPase</b> in the collecting duct → more H⁺ secretion. Must correct K⁺ to correct alkalosis." },
            { q: "What conditions falsely elevate lactate on ABG analysis?", a: "<b>Tourniquet use</b> (local ischemia), <b>clenching fist</b>, <b>delayed sample processing</b> (ongoing glycolysis), <b>leukocytosis</b> (pseudohyperlactatemia from WBC glycolysis in vitro), <b>epinephrine infusion</b> (↑ glycolysis)." }
          ]
        },
        {
          section: 'Clinical Skills & Diagnostics',
          topic: "Common lab interpretation (CBC, CMP, LFTs)",
          icon: 'stethoscope',
          cards: [
            { q: "What are the normal adult WBC count ranges?", a: "<b>4,500–11,000 cells/µL</b>. Leukocytosis = >11,000; leukopenia = <4,500." },
            { q: "What is the normal WBC differential (percentages)?", a: "<b>Neutrophils 40–70%</b>, Lymphocytes 20–40%, Monocytes 2–8%, Eosinophils 1–4%, Basophils 0.5–1%." },
            { q: "What is the normal range for hemoglobin in adult males vs females?", a: "Males: <b>13.5–17.5 g/dL</b>; Females: <b>12.0–16.0 g/dL</b>. Anemia is defined as hemoglobin below these thresholds." },
            { q: "What is hematocrit and its normal range?", a: "Hematocrit (Hct) = percentage of blood volume occupied by RBCs. Normal: Males <b>38–50%</b>, Females <b>36–44%</b>. Approximately 3× the hemoglobin value." },
            { q: "What does MCV measure and what are its normal values?", a: "MCV (Mean Corpuscular Volume) = average RBC size in femtoliters (fL). Normal: <b>80–100 fL</b>. <80 = microcytic; >100 = macrocytic." },
            { q: "What do MCH and MCHC represent?", a: "<b>MCH</b> = mean corpuscular hemoglobin (avg Hb per RBC, normal 27–33 pg). <b>MCHC</b> = mean corpuscular Hb concentration (avg Hb concentration per RBC, normal 32–36 g/dL). Low MCHC → hypochromic cells." },
            { q: "What does RDW measure and when is it elevated?", a: "<b>RDW (Red cell Distribution Width)</b> measures variation in RBC size (anisocytosis). Normal: 11.5–14.5%. Elevated in <b>iron deficiency anemia</b> (helps distinguish from thalassemia trait, which has normal RDW)." },
            { q: "What is the normal platelet count and what is MPV?", a: "Normal platelets: <b>150,000–400,000/µL</b>. <b>MPV</b> (Mean Platelet Volume, normal 7–11 fL) reflects platelet size; elevated MPV suggests peripheral destruction with young/large platelets (e.g., ITP)." },
            { q: "What is the reticulocyte count and how is it corrected?", a: "Normal reticulocyte count: <b>0.5–1.5%</b>. Corrected reticulocyte count = Retic% × (Patient Hct / Normal Hct). Reticulocyte Production Index (RPI) further divides by maturation factor. RPI >2 = adequate marrow response." },
            { q: "How is anemia classified by MCV?", a: "<b>Microcytic</b> (MCV <80): iron deficiency, thalassemia, sideroblastic, lead poisoning, ACD. <b>Normocytic</b> (MCV 80–100): acute blood loss, hemolysis, ACD, aplastic, CKD. <b>Macrocytic</b> (MCV >100): B12/folate deficiency, liver disease, MDS, reticulocytosis, drugs." },
            { q: "What is the most common cause of microcytic anemia worldwide?", a: "<b>Iron deficiency anemia (IDA)</b>. Causes: chronic blood loss (GI, menstrual), poor intake, malabsorption. Lab pattern: ↓Fe, ↑TIBC, ↓ferritin, ↓transferrin sat." },
            { q: "How does thalassemia trait differ from iron deficiency on labs?", a: "Both are microcytic, but thalassemia trait has <b>normal/↑ iron studies, normal RDW, ↑ RBC count</b>, and target cells on smear. IDA has ↑RDW, ↓iron, ↑TIBC. Mentzer index (MCV/RBC): <13 suggests thalassemia." },
            { q: "What characterizes sideroblastic anemia?", a: "Defective heme synthesis → iron accumulation in mitochondria forming <b>ringed sideroblasts</b> on Prussian blue stain of bone marrow. Can be acquired (MDS, alcohol, isoniazid, lead) or hereditary (X-linked, ALA synthase defect). Iron studies show ↑Fe, ↑ferritin." },
            { q: "How does anemia of chronic disease (ACD) present on iron studies?", a: "↓ serum iron, ↓ TIBC (key distinguishing feature from IDA), ↑ ferritin (acute phase reactant). Mechanism: hepcidin ↑ → blocks ferroportin → iron trapped in macrophages. Usually normocytic but can be microcytic." },
            { q: "What are the causes of macrocytic anemia with megaloblastic changes?", a: "<b>B12 deficiency</b> (pernicious anemia, gastrectomy, Crohn's, Diphyllobothrium latum) and <b>folate deficiency</b> (poor diet, alcoholism, pregnancy, methotrexate, phenytoin). Both show hypersegmented neutrophils on smear." },
            { q: "How do you differentiate B12 deficiency from folate deficiency?", a: "Both cause megaloblastic anemia with ↑homocysteine. <b>B12 deficiency</b> also has ↑methylmalonic acid (MMA) and neurologic symptoms (subacute combined degeneration). <b>Folate deficiency</b> has normal MMA and no neuro findings." },
            { q: "What are non-megaloblastic causes of macrocytic anemia?", a: "<b>Liver disease</b> (target cells), <b>hypothyroidism</b>, <b>MDS</b> (dysplastic changes), <b>reticulocytosis</b> (reticulocytes are larger than mature RBCs), <b>alcohol</b> (direct toxicity), and drugs (hydroxyurea, zidovudine)." },
            { q: "What lab findings suggest aplastic anemia?", a: "<b>Pancytopenia</b> (↓ WBC, ↓ RBC, ↓ platelets) with a <b>hypocellular bone marrow</b> replaced by fat. Reticulocyte count is low (RPI <2). No splenomegaly. Causes: idiopathic, drugs (chloramphenicol, benzene), radiation, viruses (parvovirus B19, hepatitis)." },
            { q: "What are the normal values for serum iron, TIBC, and ferritin?", a: "Serum iron: <b>60–170 µg/dL</b>. TIBC: <b>250–370 µg/dL</b>. Ferritin: Males <b>20–250 ng/mL</b>, Females <b>10–120 ng/mL</b>. Transferrin saturation: <b>20–50%</b>." },
            { q: "How is transferrin saturation calculated?", a: "$\\\\text{Transferrin Saturation} = \\\\frac{\\\\text{Serum Iron}}{\\\\text{TIBC}} \\\\times 100$. Normal: 20–50%. <20% suggests iron deficiency; >45% suggests iron overload (hemochromatosis)." },
            { q: "What iron study pattern distinguishes IDA from ACD?", a: "<b>IDA</b>: ↓Fe, ↑TIBC, ↓↓ferritin, ↓Tsat. <b>ACD</b>: ↓Fe, ↓TIBC, ↑ferritin (acute phase reactant), ↓Tsat. Key difference: TIBC is HIGH in IDA (body tries to absorb more iron) and LOW in ACD." },
            { q: "What iron study pattern is seen in sideroblastic anemia?", a: "↑ serum iron, normal/↓ TIBC, ↑ ferritin, ↑ transferrin saturation. Iron is available but cannot be incorporated into heme properly → accumulates in mitochondria → ringed sideroblasts." },
            { q: "What is the role of ferritin as a lab marker?", a: "Ferritin reflects total body iron stores. It is the <b>most sensitive and specific single test for IDA</b> (ferritin <15 is virtually diagnostic). However, ferritin is also an <b>acute phase reactant</b> — it rises in infection, inflammation, malignancy, and liver disease, masking underlying IDA." },
            { q: "What are the hallmark laboratory findings of hemolytic anemia?", a: "↑ LDH, ↑ indirect (unconjugated) bilirubin, ↓ haptoglobin, ↑ reticulocyte count, and possible ↑ urinary urobilinogen. Haptoglobin binds free Hb and is consumed in hemolysis." },
            { q: "Why is haptoglobin decreased in hemolysis?", a: "Haptoglobin binds free hemoglobin released from lysed RBCs. The Hb-haptoglobin complex is cleared by the liver. In hemolysis, consumption exceeds production → <b>↓ haptoglobin</b>. It's the most sensitive marker for intravascular hemolysis." },
            { q: "What peripheral smear findings are seen in hemolytic anemias?", a: "<b>Spherocytes</b>: hereditary spherocytosis, autoimmune hemolytic anemia. <b>Schistocytes</b> (helmet cells): TTP/HUS, DIC, mechanical valves. <b>Sickle cells</b>: sickle cell disease. <b>Bite cells</b>: G6PD deficiency. <b>Target cells</b>: thalassemia, liver disease, HbC." },
            { q: "What is the direct Coombs (DAT) test?", a: "Detects <b>antibodies or complement bound to patient's RBCs</b>. Positive in autoimmune hemolytic anemia (AIHA), hemolytic transfusion reactions, and hemolytic disease of the newborn. Anti-human globulin reagent is added to patient RBCs; agglutination = positive." },
            { q: "How do you distinguish intravascular from extravascular hemolysis?", a: "<b>Intravascular</b>: ↑ free plasma Hb, hemoglobinuria, hemosiderinuria, ↓↓ haptoglobin (TTP, DIC, PNH, mechanical valves). <b>Extravascular</b>: RBCs destroyed in spleen/liver, splenomegaly, spherocytes, less pronounced ↓ haptoglobin (hereditary spherocytosis, AIHA)." },
            { q: "What lab findings suggest G6PD deficiency during an acute hemolytic crisis?", a: "↑ LDH, ↓ haptoglobin, ↑ indirect bilirubin, ↑ reticulocytes. Smear: <b>bite cells, Heinz bodies</b> (denatured Hb seen with supravital staining). G6PD enzyme level may be falsely normal during crisis (reticulocytes have higher G6PD) — retest 2–3 months later." },
            { q: "What are the common causes of leukocytosis (↑ WBC)?", a: "Infection (bacterial → neutrophilia), inflammation, stress (cortisol → demargination), drugs (corticosteroids, lithium, epinephrine), leukemia/lymphoma, smoking, splenectomy, and pregnancy." },
            { q: "What is a 'left shift' in the WBC differential?", a: "Increased proportion of <b>immature neutrophils (bands, metamyelocytes, myelocytes)</b> in peripheral blood. Indicates bone marrow is releasing cells early due to high demand, typically seen in <b>acute bacterial infection or sepsis</b>. Bands >6% is significant." },
            { q: "What are the causes of eosinophilia?", a: "Mnemonic: <b>NAACP</b> — Neoplasm (Hodgkin lymphoma, hypereosinophilic syndrome), Allergy/Asthma/Atopy, Addison's disease (adrenal insufficiency), Connective tissue disease (Churg-Strauss), Parasites (most common worldwide)." },
            { q: "What defines neutropenia and what are its causes?", a: "ANC <1,500/µL (severe <500/µL). Causes: drugs (chemotherapy, clozapine, methimazole, TMP-SMX), infections (HIV, hepatitis, EBV), autoimmune, aplastic anemia, Felty syndrome (RA + splenomegaly + neutropenia), cyclic neutropenia." },
            { q: "What are causes of lymphocytosis?", a: "<b>Viral infections</b> (EBV, CMV, hepatitis, HIV), pertussis (bacterial exception — markedly ↑ lymphocytes), CLL (clonal B-cell lymphocytosis in elderly), and lymphoma with circulating cells. Atypical lymphocytes on smear suggest EBV/CMV." },
            { q: "What conditions cause basophilia?", a: "<b>Chronic myelogenous leukemia (CML)</b> — basophilia is characteristic; also seen in other myeloproliferative neoplasms, allergic reactions, hypothyroidism, and chronic inflammation. Basophils release histamine and heparin." },
            { q: "What is leukemoid reaction and how is it distinguished from CML?", a: "Leukemoid reaction: WBC >50,000 due to severe infection/stress. Distinguished from CML by: <b>↑ LAP score</b> (leukocyte alkaline phosphatase) in leukemoid reaction vs ↓ LAP in CML; CML is <b>BCR-ABL (Philadelphia chromosome)</b> positive." },
            { q: "What does PT (Prothrombin Time) measure?", a: "PT measures the <b>extrinsic and common pathways</b> (Factors VII, X, V, II, fibrinogen). Normal: <b>11–13.5 seconds</b>. Prolonged by warfarin, liver disease, vitamin K deficiency, DIC. PT is used to calculate INR." },
            { q: "What does aPTT measure?", a: "aPTT measures the <b>intrinsic and common pathways</b> (Factors XII, XI, IX, VIII, X, V, II, fibrinogen). Normal: <b>25–35 seconds</b>. Prolonged by heparin (UFH), hemophilia A (VIII) and B (IX), vWD, lupus anticoagulant, DIC." },
            { q: "What is the INR and when is it used?", a: "INR (International Normalized Ratio) standardizes PT across laboratories. $\\\\text{INR} = \\\\left(\\\\frac{\\\\text{Patient PT}}{\\\\text{Mean Normal PT}}\\\\right)^{\\\\text{ISI}}$. Normal INR: ~1.0. Therapeutic for warfarin: <b>2.0–3.0</b> (or 2.5–3.5 for mechanical mitral valve)." },
            { q: "How do mixing studies help diagnose coagulation abnormalities?", a: "Patient plasma is mixed 1:1 with normal plasma. If the prolonged PT/aPTT <b>corrects</b> → factor deficiency. If it <b>does NOT correct</b> → inhibitor is present (e.g., lupus anticoagulant, factor VIII inhibitor). Lupus anticoagulant paradoxically causes thrombosis, not bleeding." },
            { q: "What are the lab findings in DIC?", a: "<b>↑ PT, ↑ aPTT, ↓ fibrinogen, ↑ D-dimer/FDPs, ↓ platelets, schistocytes on smear</b>. DIC = consumptive coagulopathy with simultaneous clotting and bleeding. Causes: sepsis, trauma, obstetric complications, malignancy (especially acute promyelocytic leukemia)." },
            { q: "What does an elevated D-dimer indicate?", a: "D-dimer is a <b>fibrin degradation product</b> — elevated when cross-linked fibrin is being broken down. High sensitivity but low specificity. Useful for <b>ruling out VTE/PE</b> (high negative predictive value). Also elevated in DIC, surgery, trauma, pregnancy, malignancy, infection." },
            { q: "What is the significance of fibrinogen levels?", a: "Normal: <b>200–400 mg/dL</b>. ↓ in DIC (consumed), severe liver disease, afibrinogenemia. ↑ as an acute phase reactant in inflammation and pregnancy. Fibrinogen is converted to fibrin by thrombin in the final common pathway." },
            { q: "What coagulation abnormality does von Willebrand disease cause?", a: "↑ aPTT (vWF stabilizes factor VIII), ↑ bleeding time/↓ PFA-100, normal PT. <b>Type 1</b> (most common, 80%): ↓ vWF quantity. <b>Type 2</b>: qualitative defect. <b>Type 3</b>: severe, near-absent vWF. Ristocetin cofactor activity is decreased." },
            { q: "What electrolytes and metabolites are included in a CMP?", a: "CMP = BMP + liver/protein. Includes: <b>Na, K, Cl, HCO₃ (CO₂), BUN, Creatinine, Glucose, Calcium</b> (BMP) plus <b>Albumin, Total Protein, AST, ALT, ALP, Total Bilirubin</b>." },
            { q: "What is the normal range for serum sodium?", a: "<b>136–145 mEq/L</b>. Hyponatremia <136; hypernatremia >145. Sodium is the primary determinant of serum osmolality and is regulated by ADH and the thirst mechanism." },
            { q: "What is the normal range for serum potassium?", a: "<b>3.5–5.0 mEq/L</b>. Hypokalemia <3.5; hyperkalemia >5.0. Critical values: <2.5 or >6.5 mEq/L (risk of arrhythmia). Pseudohyperkalemia can occur with hemolyzed samples, thrombocytosis, or leukocytosis." },
            { q: "What is the normal range for serum chloride and bicarbonate?", a: "Chloride: <b>98–106 mEq/L</b>. Bicarbonate (CO₂): <b>22–28 mEq/L</b>. They tend to move inversely (hyperchloremic = non-anion gap metabolic acidosis). Low HCO₃ = metabolic acidosis; high HCO₃ = metabolic alkalosis." },
            { q: "What is the anion gap and how is it calculated?", a: "$\\\\text{Anion Gap} = \\\\text{Na}^+ - (\\\\text{Cl}^- + \\\\text{HCO}_3^-)$. Normal: <b>8–12 mEq/L</b> (or 10–14 with K+). Elevated AG → MUDPILES: Methanol, Uremia, DKA, Propylene glycol, Isoniazid/Iron, Lactic acidosis, Ethylene glycol, Salicylates." },
            { q: "What is the normal fasting blood glucose?", a: "Normal fasting: <b>70–100 mg/dL</b>. Prediabetes: 100–125 mg/dL. Diabetes: ≥126 mg/dL (fasting) or ≥200 mg/dL (random with symptoms) or HbA1c ≥6.5%. Hypoglycemia: <70 mg/dL." },
            { q: "How is hyponatremia classified by volume status?", a: "<b>Hypovolemic</b>: vomiting, diarrhea, diuretics (↓ total body Na, ↓↓ total body water). <b>Euvolemic</b>: SIADH, hypothyroidism, adrenal insufficiency. <b>Hypervolemic</b>: CHF, cirrhosis, nephrotic syndrome (↑↑ total body water > ↑ total body Na)." },
            { q: "What are the diagnostic criteria for SIADH?", a: "<b>Hyponatremia</b> (<135), <b>↓ serum osmolality</b> (<280), <b>↑ urine osmolality</b> (>100, inappropriately concentrated), <b>↑ urine Na</b> (>40), euvolemic, normal thyroid/adrenal function. Causes: CNS disease, lung disease, pain, drugs (SSRIs, carbamazepine, cyclophosphamide)." },
            { q: "How is corrected sodium calculated for hyperglycemia?", a: "$\\\\text{Corrected Na} = \\\\text{Measured Na} + 1.6 \\\\times \\\\frac{\\\\text{Glucose} - 100}{100}$ (some use 2.4 for glucose >400 mg/dL). Glucose draws water into the extracellular space → dilutional hyponatremia." },
            { q: "What is the danger of correcting hyponatremia too quickly?", a: "<b>Osmotic demyelination syndrome (ODS)</b>, formerly central pontine myelinolysis. Risk factors: chronic hyponatremia, alcoholism, malnutrition. Safe correction rate: <b>≤8–10 mEq/L per 24 hours</b> (some guidelines say ≤6–8 mEq/L). Symptoms: dysarthria, dysphagia, quadriparesis." },
            { q: "What causes hypernatremia and how is it classified?", a: "Always reflects a <b>water deficit</b>. <b>Hypovolemic</b>: GI losses, sweating without water replacement. <b>Euvolemic</b>: diabetes insipidus (central or nephrogenic), insensible losses. <b>Hypervolemic</b>: iatrogenic (hypertonic saline, NaHCO₃). Urine osmolality and response to desmopressin help distinguish." },
            { q: "How is central diabetes insipidus distinguished from nephrogenic DI?", a: "Both: polyuria, polydipsia, ↑ serum Na, ↓ urine osmolality. <b>Water deprivation test</b>: neither concentrates urine. After <b>desmopressin (DDAVP)</b>: <b>Central DI</b> → urine osmolality increases >50% (responds). <b>Nephrogenic DI</b> → no response (kidney resistant to ADH)." },
            { q: "What is serum osmolality and how is it calculated?", a: "$\\\\text{Serum Osm} = 2(\\\\text{Na}) + \\\\frac{\\\\text{Glucose}}{18} + \\\\frac{\\\\text{BUN}}{2.8}$. Normal: <b>275–295 mOsm/kg</b>. Osmolar gap = Measured Osm − Calculated Osm. Gap >10 suggests toxic alcohols (methanol, ethylene glycol)." },
            { q: "What are common causes of hypokalemia?", a: "GI losses (vomiting → metabolic alkalosis, diarrhea), diuretics (loops, thiazides), renal tubular acidosis (types 1 & 2), hyperaldosteronism, insulin/beta-agonist use (intracellular shift), hypomagnesemia (impairs K reabsorption)." },
            { q: "What ECG changes are seen with hypokalemia?", a: "Progressive changes: <b>T-wave flattening → ST depression → prominent U waves → QT prolongation → atrial/ventricular arrhythmias</b>. U waves (extra wave after T wave) are classic. Severe hypokalemia can cause torsades de pointes." },
            { q: "What are common causes of hyperkalemia?", a: "<b>Renal failure</b> (most common), K-sparing diuretics (spironolactone, amiloride), ACE inhibitors/ARBs, tissue breakdown (rhabdomyolysis, tumor lysis, hemolysis), metabolic acidosis (H⁺/K⁺ exchange), hypoaldosteronism (type 4 RTA), excess intake." },
            { q: "What ECG changes are seen with hyperkalemia?", a: "Progressive: <b>peaked T waves (earliest) → PR prolongation → QRS widening → loss of P waves → sine wave pattern → cardiac arrest (V-fib/asystole)</b>. Emergency treatment: IV calcium gluconate (membrane stabilizer), then insulin + glucose, albuterol, bicarbonate." },
            { q: "What causes transcellular potassium shifts?", a: "<b>Shift K⁺ INTO cells (↓ serum K)</b>: insulin, beta-2 agonists, alkalosis, refeeding. <b>Shift K⁺ OUT OF cells (↑ serum K)</b>: acidosis (mineral > organic), beta-blockers, hypertonicity, cell lysis, digitalis toxicity, succinylcholine." },
            { q: "Why must hypomagnesemia be corrected to treat refractory hypokalemia?", a: "Magnesium is required for the Na⁺/K⁺-ATPase pump and for closing ROMK channels in the collecting duct. <b>Low Mg → K⁺ wasting in the kidney</b> that is refractory to K⁺ supplementation alone. Always check Mg in persistent hypokalemia." },
            { q: "What is the normal serum calcium and how is corrected calcium calculated?", a: "Total Ca: <b>8.5–10.5 mg/dL</b>. Corrected Ca = Measured Ca + 0.8 × (4.0 − Albumin). Necessary because ~40% of calcium is albumin-bound; hypoalbuminemia causes falsely low total Ca." },
            { q: "What is ionized calcium and when is it preferred?", a: "<b>Ionized (free) Ca: 4.5–5.5 mg/dL</b> (~1.1–1.4 mmol/L). It is the physiologically active form. Preferred in critically ill, hypoalbuminemia, acid-base disorders (alkalosis → ↑ protein binding → ↓ ionized Ca), and when accuracy is essential." },
            { q: "What are the causes of hypercalcemia?", a: "Top 2 (>90%): <b>Primary hyperparathyroidism</b> (outpatient) and <b>malignancy</b> (inpatient — PTHrP, osteolytic mets, 1,25-vitamin D production by lymphoma). Others: granulomatous disease (sarcoid), vitamin D toxicity, thiazides, milk-alkali, immobilization, Paget's disease." },
            { q: "How do you distinguish hyperparathyroidism from malignancy-related hypercalcemia?", a: "<b>Primary hyperPTH</b>: ↑ Ca, ↑ PTH (inappropriately normal/high), ↓ phosphorus, ↑ urine Ca. <b>Malignancy (PTHrP)</b>: ↑ Ca, ↓ PTH (suppressed), ↑ PTHrP, ↓ phosphorus. <b>Malignancy (osteolytic)</b>: ↓ PTH, normal PTHrP." },
            { q: "What are the clinical signs of hypocalcemia?", a: "<b>Chvostek sign</b>: tapping facial nerve → ipsilateral facial muscle twitching. <b>Trousseau sign</b> (more specific): BP cuff inflated >SBP for 3 min → carpal spasm. Also: perioral numbness, paresthesias, tetany, seizures, QT prolongation, laryngospasm." },
            { q: "What are causes of hypocalcemia?", a: "<b>Hypoparathyroidism</b> (post-surgical most common), vitamin D deficiency, CKD (↓ 1,25-D, ↑ PO₄), pseudohypoparathyroidism (PTH resistance), acute pancreatitis (saponification), massive transfusion (citrate binds Ca), hyperphosphatemia, hypomagnesemia." },
            { q: "What are normal values for BUN and creatinine?", a: "BUN: <b>7–20 mg/dL</b>. Creatinine: <b>0.7–1.3 mg/dL</b> (varies by muscle mass). BUN/Cr ratio is normally ~10–20:1." },
            { q: "What does a BUN/Cr ratio >20:1 suggest?", a: "<b>Prerenal azotemia</b>: dehydration, CHF, shock — kidney is underperfused and reabsorbs more urea. Also elevated by upper GI bleeding (blood is digested → ↑ urea), high-protein diet, catabolic states, and corticosteroids." },
            { q: "How is FENa calculated and interpreted?", a: "$\\\\text{FENa} = \\\\frac{\\\\text{U}_{\\\\text{Na}} \\\\times \\\\text{P}_{\\\\text{Cr}}}{\\\\text{P}_{\\\\text{Na}} \\\\times \\\\text{U}_{\\\\text{Cr}}} \\\\times 100$. <b><1%</b>: prerenal (avid Na reabsorption). <b>>2%</b>: intrinsic renal (ATN). Note: unreliable if on diuretics — use <b>FEUrea</b> instead (<35% prerenal, >50% intrinsic)." },
            { q: "What is GFR and how is it estimated?", a: "GFR = glomerular filtration rate, best measure of kidney function. Normal: <b>≥90 mL/min/1.73m²</b>. Estimated using CKD-EPI equation (creatinine-based). CKD stages: G1 ≥90, G2 60–89, G3a 45–59, G3b 30–44, G4 15–29, G5 <15 (dialysis)." },
            { q: "What urinalysis findings are seen in prerenal vs intrinsic renal failure?", a: "<b>Prerenal</b>: bland sediment, hyaline casts, concentrated urine (SG >1.020, urine osm >500), FENa <1%. <b>ATN (intrinsic)</b>: muddy brown granular casts, renal tubular epithelial cells, dilute urine (SG ~1.010), FENa >2%." },
            { q: "What do different urine casts indicate?", a: "<b>Hyaline</b>: normal/dehydration. <b>RBC casts</b>: glomerulonephritis. <b>WBC casts</b>: pyelonephritis or interstitial nephritis. <b>Muddy brown granular</b>: ATN. <b>Waxy/broad casts</b>: chronic kidney disease. <b>Fatty casts/oval fat bodies</b>: nephrotic syndrome." },
            { q: "What is the significance of proteinuria on urinalysis?", a: "Dipstick detects albumin (misses light chains/Bence Jones). <b>Microalbuminuria</b> (30–300 mg/day): earliest sign of diabetic nephropathy. <b>Nephrotic range</b>: >3.5 g/day. Spot urine protein/creatinine ratio (UPCR) approximates 24-hour protein (g/g ≈ g/day)." },
            { q: "What are AST and ALT and their normal ranges?", a: "<b>AST (aspartate aminotransferase)</b>: normal 10–40 U/L. Found in liver, heart, skeletal muscle, kidney, brain. <b>ALT (alanine aminotransferase)</b>: normal 7–56 U/L. More <b>specific to the liver</b> than AST." },
            { q: "What are ALP and GGT and what do they indicate?", a: "<b>ALP (alkaline phosphatase)</b>: normal 44–147 U/L. Elevated in cholestasis, bone disease, pregnancy. <b>GGT (gamma-glutamyl transferase)</b>: elevated in cholestasis and alcohol use. GGT helps confirm hepatic origin of ↑ALP (bone disease → ↑ALP but normal GGT)." },
            { q: "What are the types of bilirubin and their significance?", a: "<b>Indirect (unconjugated)</b>: ↑ in hemolysis, Gilbert syndrome, neonatal jaundice, Crigler-Najjar. <b>Direct (conjugated)</b>: ↑ in biliary obstruction, hepatitis, Dubin-Johnson, Rotor syndrome. Total bilirubin normal: <b>0.1–1.2 mg/dL</b>; direct <0.3 mg/dL." },
            { q: "What does serum albumin indicate in liver disease?", a: "Normal: <b>3.5–5.5 g/dL</b>. Albumin is synthesized exclusively by the liver (half-life ~20 days). Low albumin reflects <b>chronic liver disease</b> or synthetic dysfunction (not acute hepatitis). Also low in nephrotic syndrome, malnutrition, and inflammation." },
            { q: "What is the significance of total protein and globulin gap?", a: "Total protein: <b>6.0–8.3 g/dL</b>. Globulin = Total protein − Albumin (normal 2.0–3.5). ↑ Globulin gap (>4 g/dL) suggests <b>multiple myeloma</b>, chronic infections, autoimmune disease, or cirrhosis (polyclonal gammopathy)." },
            { q: "How do hepatocellular and cholestatic liver injury patterns differ?", a: "<b>Hepatocellular</b>: AST/ALT ↑↑↑ (often >10× ULN), ALP mildly ↑. Causes: viral hepatitis, drug-induced (acetaminophen), ischemic hepatitis, autoimmune. <b>Cholestatic</b>: ALP ↑↑ (>3× ULN), GGT ↑, bilirubin ↑, AST/ALT mildly ↑. Causes: bile duct obstruction, PBC, drugs." },
            { q: "What is the R-factor (R-ratio) and how is it used?", a: "$\\\\text{R-factor} = \\\\frac{\\\\text{ALT} / \\\\text{ALT ULN}}{\\\\text{ALP} / \\\\text{ALP ULN}}$. <b>>5</b>: hepatocellular injury. <b><2</b>: cholestatic injury. <b>2–5</b>: mixed pattern. Useful for classifying drug-induced liver injury (DILI)." },
            { q: "What does an AST/ALT ratio >2:1 suggest?", a: "<b>Alcoholic hepatitis</b>. AST is typically 2–6× ULN (rarely >300). The ratio is due to alcohol depleting hepatic pyridoxal-5'-phosphate (vitamin B6), which is needed for ALT synthesis. Also, mitochondrial AST leaks from alcohol-damaged hepatocytes." },
            { q: "What does an AST/ALT ratio <1 suggest?", a: "Seen in most causes of <b>non-alcoholic liver disease</b>: viral hepatitis, NAFLD/NASH (early stages), drug-induced hepatitis. However, as NAFLD progresses to cirrhosis, the ratio may flip to >1." },
            { q: "What LFT pattern is seen in biliary obstruction?", a: "↑↑ ALP (>3× ULN), ↑ GGT, ↑ direct (conjugated) bilirubin, mild ↑ AST/ALT. If ALP is elevated without GGT elevation, consider <b>bone source</b>. Ultrasound first to look for dilated bile ducts (extrahepatic obstruction)." },
            { q: "How is the hepatitis panel interpreted?", a: "<b>HBsAg+, anti-HBc IgM+</b>: acute HBV. <b>HBsAg+, anti-HBc IgG+, IgM−</b>: chronic HBV. <b>HBsAg−, anti-HBs+, anti-HBc+</b>: prior infection (immune). <b>HBsAg−, anti-HBs+, anti-HBc−</b>: vaccination. <b>Anti-HCV+, HCV RNA+</b>: active HCV." },
            { q: "What lab findings suggest Wilson disease?", a: "↓ <b>Ceruloplasmin</b> (<20 mg/dL), ↑ 24-hour urine copper, ↑ hepatic copper on biopsy. Serum copper may be low (bound to ceruloplasmin) or ↑ free copper. Also: Kayser-Fleischer rings on slit-lamp exam, Coombs-negative hemolytic anemia." },
            { q: "What lab findings suggest hereditary hemochromatosis?", a: "↑ <b>Transferrin saturation >45%</b> (screening test), ↑↑ ferritin (often >1000). HFE gene testing (C282Y homozygosity). Liver biopsy with Prussian blue stain shows iron deposition. Can cause cirrhosis, diabetes ('bronze diabetes'), cardiomyopathy, arthropathy." },
            { q: "What autoantibodies are associated with autoimmune hepatitis?", a: "<b>Type 1 (most common)</b>: ANA, anti-smooth muscle antibody (ASMA), ↑ IgG. <b>Type 2</b>: anti-liver-kidney microsomal antibody (anti-LKM-1). Presents with markedly elevated AST/ALT, hypergammaglobulinemia, and responds to corticosteroids." },
            { q: "What is anti-mitochondrial antibody (AMA) associated with?", a: "<b>Primary biliary cholangitis (PBC)</b> — AMA positive in >95% of cases. PBC affects middle-aged women with cholestatic LFTs (↑ ALP, ↑ GGT), pruritus, fatigue, and xanthomas. ↑ IgM. Liver biopsy: granulomatous destruction of interlobular bile ducts." },
            { q: "What are normal values for amylase and lipase?", a: "Amylase: <b>30–110 U/L</b>. Lipase: <b>0–160 U/L</b>. Lipase is <b>more specific</b> for pancreatitis (amylase also rises in salivary gland disease, macroamylasemia, bowel obstruction, renal failure)." },
            { q: "How are amylase and lipase used to diagnose acute pancreatitis?", a: "Diagnosis requires 2 of 3: (1) characteristic abdominal pain, (2) <b>lipase or amylase ≥3× ULN</b>, (3) imaging findings. Lipase rises within 4–8 hours, peaks at 24 hours, and remains elevated for 8–14 days (longer than amylase, which normalizes in 3–5 days)." },
            { q: "Why may amylase/lipase be normal or low in chronic pancreatitis?", a: "In chronic pancreatitis, the gland is <b>fibrosed and atrophied (burned out)</b> — insufficient functional tissue to produce enzymes. Diagnosis relies on imaging (calcifications, dilated pancreatic duct) and functional tests (fecal elastase <200 µg/g for exocrine insufficiency)." },
            { q: "What is the significance of cardiac troponin?", a: "Troponin I and T are <b>highly sensitive and specific for myocardial injury</b>. Rise within 3–6 hours, peak 12–24 hours, remain elevated 7–14 days (troponin I) or up to 21 days (troponin T). Serial measurements (0, 3, 6 hours) are used to diagnose acute MI." },
            { q: "What conditions other than MI can cause elevated troponin?", a: "PE, myocarditis, heart failure, sepsis/critical illness, renal failure (especially TnT), takotsubo cardiomyopathy, cardiac contusion, cardioversion, pericarditis, aortic dissection, hypertensive crisis, tachyarrhythmias. Key: troponin indicates <b>myocardial injury</b>, not necessarily ACS." },
            { q: "What is CK-MB and how is it used?", a: "CK-MB is the cardiac isoenzyme of creatine kinase. Rises 4–6 hours, peaks 12–24 hours, normalizes <b>48–72 hours</b>. Less specific than troponin (also in skeletal muscle). Main use: detecting <b>reinfarction</b> (troponin stays elevated too long to detect a new event)." },
            { q: "What are BNP and NT-proBNP used for?", a: "Both are released from <b>ventricular myocytes in response to volume overload/wall stress</b>. Used to diagnose and monitor <b>heart failure</b>. BNP >100 pg/mL or NT-proBNP >300 pg/mL suggests HF. Lower cutoffs in obesity; higher cutoffs with age and renal failure (especially NT-proBNP)." },
            { q: "What is the normal range for TSH and free T4?", a: "TSH: <b>0.4–4.0 mIU/L</b>. Free T4: <b>0.8–1.8 ng/dL</b>. TSH is the <b>most sensitive screening test</b> for thyroid dysfunction due to the log-linear relationship with T4 (small T4 changes → large TSH changes)." },
            { q: "How do you interpret TSH and free T4 in primary hypothyroidism vs secondary?", a: "<b>Primary hypothyroidism</b> (thyroid failure): ↑ TSH, ↓ free T4. <b>Secondary/central hypothyroidism</b> (pituitary failure): ↓/normal TSH, ↓ free T4. In secondary disease, TSH is unreliable — must follow free T4 for monitoring." },
            { q: "How do you interpret TSH and free T4 in primary vs secondary hyperthyroidism?", a: "<b>Primary hyperthyroidism</b> (Graves', toxic nodule): ↓ TSH, ↑ free T4/T3. <b>Secondary (TSH-secreting pituitary adenoma)</b>: ↑/normal TSH, ↑ free T4 (rare). <b>Subclinical hyperthyroidism</b>: ↓ TSH, normal free T4/T3." },
            { q: "When is T3 measurement clinically important?", a: "Normal total T3: <b>80–200 ng/dL</b>. Important in <b>T3 thyrotoxicosis</b>: ↓ TSH with normal free T4 but ↑ T3 (seen early in Graves' disease and toxic nodules). T3 is the more metabolically active hormone (80% comes from peripheral T4→T3 conversion by deiodinases)." },
            { q: "What is ESR and when is it elevated?", a: "ESR (Erythrocyte Sedimentation Rate): normal male <b>age/2</b>; female <b>(age+10)/2</b>. Measures rate RBCs settle (affected by fibrinogen, immunoglobulins). ↑ in infection, autoimmune disease (temporal arteritis, PMR, SLE), malignancy. Very high (>100): myeloma, infection, vasculitis." },
            { q: "How does CRP differ from ESR as an inflammatory marker?", a: "<b>CRP</b> rises and falls faster than ESR (rises within 6–8 hours, peaks 48 hours). More sensitive for acute changes. Not affected by anemia, polycythemia, or RBC shape (which affect ESR). <b>hs-CRP</b> is used for cardiovascular risk stratification (<1 low, 1–3 average, >3 high risk)." },
            { q: "What is procalcitonin and when is it useful?", a: "Procalcitonin is a biomarker that rises specifically in <b>bacterial infections</b> (not typically viral). Rises within 2–4 hours, peaks 6–24 hours. Used to guide <b>antibiotic initiation and de-escalation</b> (especially in respiratory infections and sepsis). <0.25 ng/mL suggests against bacterial infection." },
            { q: "What is PSA and its clinical significance?", a: "<b>PSA (Prostate-Specific Antigen)</b>: normal <4 ng/mL. Elevated in prostate cancer, BPH, prostatitis, after DRE/instrumentation. Not cancer-specific — used for screening (controversial) and monitoring treatment response. PSA velocity >0.75 ng/mL/year is concerning." },
            { q: "What cancers are associated with CEA and AFP?", a: "<b>CEA (Carcinoembryonic Antigen)</b>: colorectal cancer (monitoring, not screening). Also ↑ in pancreatic, gastric, breast, lung cancers and smoking. <b>AFP (Alpha-Fetoprotein)</b>: hepatocellular carcinoma, yolk sac (endodermal sinus) tumors, and used in prenatal screening (↑ in neural tube defects)." },
            { q: "What are CA-125 and CA 19-9 associated with?", a: "<b>CA-125</b>: ovarian cancer (especially epithelial serous). Also ↑ in endometriosis, PID, pregnancy, peritoneal disease. Used for monitoring, not screening. <b>CA 19-9</b>: pancreatic cancer (most useful for monitoring treatment response). Also ↑ in cholangiocarcinoma and biliary obstruction." },
            { q: "What is beta-hCG used for beyond pregnancy?", a: "Beta-hCG is a marker for <b>gestational trophoblastic disease</b> (hydatidiform mole, choriocarcinoma) and <b>germ cell tumors</b> (testicular seminoma/nonseminoma). Also part of the quad screen (prenatal screening). Very high levels in choriocarcinoma can cause hyperthyroidism (TSH homology)." },
            { q: "What are the normal components of a urinalysis?", a: "Color: yellow. Clarity: clear. pH: <b>4.5–8.0</b>. Specific gravity: <b>1.005–1.030</b>. Protein: negative. Glucose: negative. Ketones: negative. Blood: negative. WBC/bacteria: negative. Nitrites: negative. Leukocyte esterase: negative." },
            { q: "What do urine electrolytes (UNa, UCl) indicate clinically?", a: "<b>UNa <20 mEq/L</b>: prerenal states (hypovolemia, CHF, cirrhosis — kidney retains Na). <b>UNa >40 mEq/L</b>: SIADH, ATN, intrinsic renal disease, diuretic use. UNa helps classify hyponatremia and distinguish prerenal from intrinsic AKI." },
            { q: "How is urine osmolality used clinically?", a: "Normal: <b>300–900 mOsm/kg</b> (varies with hydration). In hyponatremia: <b>UOsm <100</b> = primary polydipsia (appropriate dilution). <b>UOsm >100</b> = impaired water excretion (SIADH, hypovolemia). In hypernatremia: <b>UOsm <300</b> suggests diabetes insipidus." },
            { q: "What is the urine protein/creatinine ratio (UPCR)?", a: "Spot UPCR estimates 24-hour proteinuria (g/g ≈ g/day). Normal: <b><0.2 g/g</b>. <b>0.2–3.5 g/g</b>: subnephrotic. <b>>3.5 g/g</b>: nephrotic range. Urine albumin/creatinine ratio (UACR) >30 mg/g = microalbuminuria (screen for diabetic nephropathy annually)." },
            { q: "What is the significance of hematuria on urinalysis?", a: "<b>Microscopic hematuria</b>: >3 RBCs/HPF. <b>Dysmorphic RBCs / RBC casts</b> → glomerular origin (glomerulonephritis). <b>Isomorphic RBCs</b> → lower urinary tract (stones, infection, malignancy). All patients >35 with unexplained microscopic hematuria need cystoscopy to rule out bladder cancer." },
            { q: "What is the Mentzer index and how is it used?", a: "$\\\\text{Mentzer Index} = \\\\frac{\\\\text{MCV}}{\\\\text{RBC count}}$. <b><13</b>: suggests thalassemia trait (many small RBCs). <b>>13</b>: suggests iron deficiency anemia (fewer cells overall). Useful bedside tool but not definitive — confirm with iron studies and Hb electrophoresis." },
            { q: "What lab values are included in the Model for End-Stage Liver Disease (MELD) score?", a: "MELD uses <b>INR, total bilirubin, and creatinine</b> (MELD-Na also adds sodium). Used to prioritize liver transplant allocation. Higher score = greater disease severity. Formula includes natural logarithms of these values." },
            { q: "What is the Child-Pugh score and what labs does it use?", a: "Assesses <b>cirrhosis severity</b> using 5 variables: <b>Albumin, Bilirubin, INR (PT)</b> (lab values), plus <b>ascites and encephalopathy</b> (clinical). Class A (5–6): well-compensated. Class B (7–9): significant dysfunction. Class C (10–15): decompensated." },
            { q: "What lab pattern suggests tumor lysis syndrome (TLS)?", a: "<b>↑ Potassium, ↑ Phosphorus, ↑ Uric acid, ↓ Calcium</b> (calcium-phosphate precipitation), ↑ LDH, ↑ Creatinine (urate nephropathy). Occurs after chemotherapy for bulky, rapidly dividing tumors (Burkitt lymphoma, ALL). Prevent with allopurinol/rasburicase and aggressive hydration." },
            { q: "How do you interpret a peripheral blood smear with rouleaux formation?", a: "<b>Rouleaux</b> = RBCs stacked like coins. Caused by ↑ serum proteins (especially immunoglobulins or fibrinogen). Classic for <b>multiple myeloma</b> (↑ monoclonal immunoglobulin). Also seen in chronic inflammation and Waldenström macroglobulinemia." },
            { q: "What does an elevated LDH indicate and why is it nonspecific?", a: "LDH (Lactate Dehydrogenase) is present in virtually all tissues. Elevated in: hemolysis, MI, liver disease, PE, lymphoma, muscle injury, megaloblastic anemia, tumor lysis. <b>LDH isoenzymes</b>: LDH-1 (heart/RBC), LDH-2 (heart/RBC), LDH-3 (lung), LDH-4/5 (liver/muscle). Flipped ratio (LDH-1 > LDH-2) seen in MI and hemolysis." },
            { q: "What lab abnormalities suggest hemolytic uremic syndrome (HUS)?", a: "<b>Microangiopathic hemolytic anemia</b> (schistocytes, ↓ haptoglobin, ↑ LDH, ↑ indirect bilirubin), <b>thrombocytopenia</b>, and <b>acute renal failure</b> (↑ BUN/Cr). Typical HUS in children follows E. coli O157:H7 (Shiga toxin) diarrheal illness. Normal PT/aPTT (unlike DIC)." },
            { q: "What is the delta-delta (Δ-Δ) gap and when is it useful?", a: "$\\\\Delta\\\\text{-}\\\\Delta = \\\\frac{\\\\Delta\\\\text{AG}}{\\\\Delta\\\\text{HCO}_3} = \\\\frac{\\\\text{AG} - 12}{24 - \\\\text{HCO}_3}$. <b><1</b>: concurrent non-AG metabolic acidosis. <b>1–2</b>: pure AG metabolic acidosis. <b>>2</b>: concurrent metabolic alkalosis. Helps detect mixed acid-base disorders." },
            { q: "What is the significance of an isolated elevated ALP with normal LFTs?", a: "Consider <b>bone origin</b>: Paget disease, bone mets, osteomalacia, hyperparathyroidism, fracture healing. Confirm with <b>GGT or 5'-nucleotidase</b> (normal = bone source; elevated = hepatobiliary). ALP is also physiologically elevated in <b>pregnancy</b> (placental isoenzyme) and growing children." },
            { q: "What labs differentiate nephrotic from nephritic syndrome?", a: "<b>Nephrotic</b>: proteinuria >3.5 g/day, hypoalbuminemia, hyperlipidemia, lipiduria (oval fat bodies, fatty casts), edema. <b>Nephritic</b>: hematuria (RBC casts, dysmorphic RBCs), mild-moderate proteinuria (<3.5 g), hypertension, oliguria, ↑ BUN/Cr." },
            { q: "What does an elevated indirect bilirubin with otherwise normal LFTs suggest?", a: "<b>Gilbert syndrome</b> (most common — benign, affects ~5% of population, ↑ with fasting/stress) or <b>hemolysis</b> (check haptoglobin, LDH, reticulocyte count). Gilbert's is due to reduced UDP-glucuronosyltransferase activity. No treatment needed." }
          ]
        },
        {
          section: 'Clinical Skills & Diagnostics',
          topic: "Clinical reasoning & differential diagnosis",
          icon: 'stethoscope',
          cards: [
            { q: "What is the hypothetico-deductive model of clinical reasoning?", a: "The clinician generates a set of <b>diagnostic hypotheses</b> early in the encounter, then iteratively gathers data (history, exam, tests) to <b>confirm or refute</b> each hypothesis until the most likely diagnosis remains." },
            { q: "What is pattern recognition (non-analytic reasoning) in diagnosis?", a: "An <b>instantaneous, automatic</b> process where a clinician matches a patient's presentation to a previously encountered pattern (gestalt). Fast but prone to error in atypical cases." },
            { q: "Define an illness script.", a: "A mental template containing three components: <b>enabling conditions</b> (epidemiology/risk factors), <b>fault</b> (pathophysiology), and <b>consequences</b> (signs, symptoms, labs, imaging). Experts store thousands of refined scripts." },
            { q: "What is dual-process theory in clinical reasoning?", a: "Reasoning uses two systems: <b>System 1</b> (fast, intuitive, pattern-based) and <b>System 2</b> (slow, analytical, deliberate). Diagnostic errors often arise when System 1 is used alone without System 2 verification." },
            { q: "Define sensitivity of a diagnostic test.", a: "The probability a test is <b>positive given the disease is present</b>. $\\\\text{Sensitivity} = \\\\frac{TP}{TP + FN}$. A highly sensitive test rules OUT disease when negative (<b>SnNOut</b>)." },
            { q: "Define specificity of a diagnostic test.", a: "The probability a test is <b>negative given the disease is absent</b>. $\\\\text{Specificity} = \\\\frac{TN}{TN + FP}$. A highly specific test rules IN disease when positive (<b>SpPIn</b>)." },
            { q: "What is positive predictive value (PPV)?", a: "The probability that a person with a <b>positive test truly has the disease</b>. $\\\\text{PPV} = \\\\frac{TP}{TP + FP}$. PPV increases with higher disease prevalence." },
            { q: "What is negative predictive value (NPV)?", a: "The probability that a person with a <b>negative test truly does not have the disease</b>. $\\\\text{NPV} = \\\\frac{TN}{TN + FN}$. NPV increases when prevalence is low." },
            { q: "How does disease prevalence affect PPV and NPV?", a: "↑ Prevalence → ↑ PPV, ↓ NPV. ↓ Prevalence → ↓ PPV, ↑ NPV. Sensitivity and specificity are intrinsic to the test and do <b>not</b> change with prevalence." },
            { q: "Define positive likelihood ratio (LR+).", a: "$\\\\text{LR+} = \\\\frac{\\\\text{Sensitivity}}{1 - \\\\text{Specificity}}$. Indicates how much more likely a <b>positive</b> test is in someone with disease vs. without. LR+ > 10 is strong evidence to rule IN." },
            { q: "Define negative likelihood ratio (LR−).", a: "$\\\\text{LR−} = \\\\frac{1 - \\\\text{Sensitivity}}{\\\\text{Specificity}}$. Indicates how much less likely a <b>negative</b> test is in someone with disease vs. without. LR− < 0.1 is strong evidence to rule OUT." },
            { q: "State Bayes' theorem as applied to diagnostic testing.", a: "$\\\\text{Post-test odds} = \\\\text{Pre-test odds} \\\\times \\\\text{Likelihood ratio}$. Convert probability to odds: $\\\\text{Odds} = \\\\frac{p}{1-p}$. Convert back: $\\\\text{Probability} = \\\\frac{\\\\text{Odds}}{1 + \\\\text{Odds}}$." },
            { q: "What is pre-test probability and how is it estimated?", a: "The estimated probability of disease <b>before</b> a test is performed, based on prevalence, clinical features, and risk factors. It is the starting point for Bayesian updating." },
            { q: "What is post-test probability?", a: "The revised probability of disease <b>after</b> incorporating a test result. Calculated via Bayes' theorem using pre-test probability and the test's likelihood ratio." },
            { q: "Define absolute risk reduction (ARR).", a: "$\\\\text{ARR} = \\\\text{Control event rate} - \\\\text{Experimental event rate}$. The absolute difference in risk between the two groups. More clinically meaningful than RRR." },
            { q: "Define relative risk reduction (RRR).", a: "$\\\\text{RRR} = \\\\frac{\\\\text{ARR}}{\\\\text{Control event rate}} \\\\times 100\\\\%$. Expresses risk reduction as a proportion of the baseline risk. Can be misleadingly large when baseline risk is low." },
            { q: "Define number needed to treat (NNT).", a: "$\\\\text{NNT} = \\\\frac{1}{\\\\text{ARR}}$. The number of patients who must be treated to <b>prevent one additional adverse outcome</b>. Lower NNT = more effective treatment." },
            { q: "Define number needed to harm (NNH).", a: "$\\\\text{NNH} = \\\\frac{1}{\\\\text{Absolute risk increase}}$. The number of patients treated before one additional patient is harmed. Higher NNH = safer treatment." },
            { q: "Define odds ratio (OR) and when it is used.", a: "OR = $\\\\frac{a \\\\times d}{b \\\\times c}$ from a 2×2 table. Used primarily in <b>case-control</b> studies where incidence cannot be directly calculated. OR ≈ RR when disease prevalence is low (<b>rare disease assumption</b>)." },
            { q: "What is a randomized controlled trial (RCT)?", a: "A prospective experimental study where subjects are <b>randomly allocated</b> to intervention or control. The gold standard for testing efficacy. Minimizes confounding through randomization." },
            { q: "Describe a cohort study.", a: "An observational study that follows a group of subjects with and without an <b>exposure</b> over time to compare incidence of outcomes. Can be prospective or retrospective. Measures <b>relative risk (RR)</b>." },
            { q: "Describe a case-control study.", a: "An observational study that starts with subjects who have the <b>outcome (cases)</b> and matched controls without it, then looks back for exposure. Efficient for rare diseases. Measures <b>odds ratio (OR)</b>." },
            { q: "What is a cross-sectional study?", a: "A study that assesses <b>exposure and outcome simultaneously</b> at a single point in time. Measures <b>prevalence</b>, not incidence. Cannot establish temporality or causation." },
            { q: "Define meta-analysis.", a: "A statistical technique that <b>quantitatively combines</b> results from multiple independent studies to produce a pooled effect estimate. Displayed using a forest plot." },
            { q: "Define systematic review.", a: "A structured review that uses <b>predefined, reproducible methods</b> to identify, appraise, and synthesize all relevant studies on a question. May or may not include a meta-analysis." },
            { q: "List the hierarchy of evidence from strongest to weakest.", a: "1. Systematic review/meta-analysis of RCTs<br>2. Individual RCT<br>3. Cohort study<br>4. Case-control study<br>5. Cross-sectional study<br>6. Case series/case report<br>7. Expert opinion" },
            { q: "What is selection bias?", a: "Systematic error arising from how participants are <b>chosen or allocated</b>. Examples: Berkson's bias (hospital-based selection), healthy worker effect, volunteer bias, non-response bias." },
            { q: "What is recall bias?", a: "Occurs when participants with the disease <b>remember exposures differently</b> (usually more completely) than controls. Common in case-control studies." },
            { q: "What is lead-time bias?", a: "Earlier detection by screening <b>appears</b> to prolong survival without truly changing outcome. The disease is diagnosed sooner, so survival time from diagnosis seems longer." },
            { q: "What is length-time bias?", a: "Screening preferentially detects <b>slow-growing, less aggressive</b> diseases (long pre-clinical phase), making screened populations appear to have better prognosis." },
            { q: "What is measurement (information) bias?", a: "Systematic error from <b>inaccurate measurement</b> of exposure or outcome. Includes misclassification (differential and non-differential), observer bias, and instrument error." },
            { q: "What is confounding?", a: "A third variable that is associated with both the <b>exposure and the outcome</b>, distorting the true association. Controlled by randomization, matching, stratification, or multivariable analysis." },
            { q: "What is anchoring bias?", a: "Over-reliance on the <b>first piece of information</b> encountered (the 'anchor'), failing to adjust sufficiently as new data emerges. E.g., fixating on an initial working diagnosis." },
            { q: "What is availability bias?", a: "Overestimating the probability of a diagnosis because it comes to mind <b>easily</b>, often due to a recent or memorable case, rather than actual prevalence." },
            { q: "What is premature closure?", a: "Accepting a diagnosis <b>before it has been fully verified</b>, stopping the search for alternatives once an initial diagnosis seems to fit. The most common cognitive error in medicine." },
            { q: "What is framing bias?", a: "The way information is <b>presented (framed)</b> influences clinical decisions. E.g., '95% survival' sounds better than '5% mortality' despite being identical." },
            { q: "What is confirmation bias?", a: "Selectively seeking or interpreting evidence that <b>supports a pre-existing hypothesis</b> while ignoring contradictory data." },
            { q: "What is representativeness bias?", a: "Judging probability based on how closely a case <b>resembles a prototype</b>, ignoring base rates. E.g., assuming a classic presentation means a rare disease must be present." },
            { q: "What is search satisfying bias?", a: "Stopping the diagnostic search after finding <b>one abnormality</b>, missing additional diagnoses. Common in radiology (finding one fracture and missing a second)." },
            { q: "What is diagnostic momentum?", a: "Once a diagnostic label is attached to a patient, it <b>gathers momentum</b> and is passed from provider to provider without critical reassessment." },
            { q: "What is the Dunning-Kruger effect in clinical medicine?", a: "Clinicians with <b>limited expertise</b> overestimate their diagnostic ability, while experts may underestimate theirs. Leads to overconfidence in early training." },
            { q: "What is sunk cost bias in clinical decisions?", a: "Continuing a diagnostic or therapeutic course because of <b>resources already invested</b> (time, cost, procedures), even when evidence suggests changing direction." },
            { q: "What are the Wells criteria for DVT?", a: "Points: active cancer (+1), paralysis/immobilization (+1), bedridden >3 days/surgery <12 wk (+1), tenderness along deep veins (+1), entire leg swollen (+1), calf >3 cm vs. other side (+1), pitting edema (+1), collateral veins (+1), previous DVT (+1), alternative diagnosis equally likely (−2). ≥2 = DVT likely." },
            { q: "What are the Wells criteria for PE?", a: "Clinical signs of DVT (+3), PE most likely diagnosis (+3), HR >100 (+1.5), immobilization/surgery <4 wk (+1.5), previous DVT/PE (+1.5), hemoptysis (+1), malignancy (+1). >4 = PE likely → CT-PA; ≤4 = PE unlikely → D-dimer." },
            { q: "What is the PERC rule and when is it used?", a: "Pulmonary Embolism Rule-out Criteria. Used when pre-test probability is <b>low</b>. If ALL 8 criteria are negative (age <50, HR <100, SpO₂ >94%, no hemoptysis, no estrogen, no prior DVT/PE, no unilateral leg swelling, no surgery/trauma <4 wk), PE is excluded <b>without D-dimer</b>." },
            { q: "What is the HEART score and what does it predict?", a: "Risk stratifies <b>chest pain</b> for MACE (Major Adverse Cardiac Events) at 6 weeks. Components: <b>H</b>istory, <b>E</b>CG, <b>A</b>ge, <b>R</b>isk factors, <b>T</b>roponin (0–2 each, max 10). 0–3 = low risk (discharge); 4–6 = moderate; 7–10 = high risk." },
            { q: "What is the TIMI risk score for UA/NSTEMI?", a: "7 variables (1 point each): age ≥65, ≥3 CAD risk factors, known CAD (≥50% stenosis), ASA use in past 7 days, ≥2 anginal episodes in 24 h, ST deviation ≥0.5 mm, elevated cardiac marker. Higher score = higher 14-day risk of MACE." },
            { q: "What does the GRACE score predict?", a: "Predicts <b>in-hospital and 6-month mortality</b> in ACS. Variables: age, HR, SBP, creatinine, cardiac arrest at admission, ST deviation, elevated biomarkers, Killip class. More accurate than TIMI but more complex." },
            { q: "What is the CHA₂DS₂-VASc score?", a: "Stroke risk in <b>non-valvular atrial fibrillation</b>. C = CHF (1), H = HTN (1), A₂ = Age ≥75 (2), D = DM (1), S₂ = prior Stroke/TIA (2), V = Vascular disease (1), A = Age 65–74 (1), Sc = Sex category female (1). Max 9. ≥2 in men / ≥3 in women → anticoagulate." },
            { q: "What is the HAS-BLED score?", a: "Estimates <b>bleeding risk</b> on anticoagulation in AF. H = HTN, A = Abnormal renal/liver function, S = Stroke, B = Bleeding hx, L = Labile INR, E = Elderly >65, D = Drugs/alcohol. 1 pt each (max 9). ≥3 = high bleeding risk — does NOT contraindicate anticoagulation but warrants closer monitoring." },
            { q: "What is the Framingham Risk Score?", a: "Estimates <b>10-year risk of cardiovascular events</b> (MI, coronary death). Uses age, sex, total cholesterol, HDL, SBP, smoking, diabetes. Largely replaced by the Pooled Cohort Equations (ACC/AHA)." },
            { q: "What is CURB-65 and what does it predict?", a: "Severity score for <b>community-acquired pneumonia</b>. C = Confusion, U = Urea >7 mmol/L (BUN >19), R = RR ≥30, B = BP (systolic <90 or diastolic ≤60), 65 = Age ≥65. 0–1 outpatient; 2 short stay; 3–5 inpatient/ICU." },
            { q: "What is the PSI/PORT score?", a: "Pneumonia Severity Index: stratifies CAP into <b>5 risk classes</b> using age, comorbidities, exam findings, and lab/imaging. Class I–II → outpatient; III → observation; IV–V → inpatient." },
            { q: "What is the BODE index?", a: "Predicts mortality in <b>COPD</b>. B = BMI, O = Obstruction (FEV₁%), D = Dyspnea (mMRC), E = Exercise capacity (6-min walk distance). Score 0–10; higher = worse prognosis." },
            { q: "What is the MELD score and its formula?", a: "Model for End-stage Liver Disease. Predicts <b>3-month mortality</b> in cirrhosis and is used for liver transplant allocation. $\\\\text{MELD} = 3.78 \\\\times \\\\ln(\\\\text{bilirubin}) + 11.2 \\\\times \\\\ln(\\\\text{INR}) + 9.57 \\\\times \\\\ln(\\\\text{creatinine}) + 6.43$." },
            { q: "What is the Child-Pugh score?", a: "Classifies severity of <b>cirrhosis</b>. Five variables: bilirubin, albumin, INR/PT, ascites, encephalopathy (1–3 pts each). Class A (5–6) = well-compensated; B (7–9) = significant dysfunction; C (10–15) = decompensated." },
            { q: "What are Ranson's criteria for acute pancreatitis?", a: "Predicts severity at <b>admission</b> (GA LAW): Glucose >200, Age >55, LDH >350, AST >250, WBC >16k. At <b>48 hours</b> (C HOBBS): Ca²⁺ <8, Hct drop >10%, O₂ (PaO₂ <60), BUN rise >5, Base deficit >4, Sequestration >6 L fluid. ≥3 = severe." },
            { q: "What is the Glasgow-Imrie score?", a: "Alternative to Ranson's for <b>acute pancreatitis</b> severity. 8 factors measured at 48 h: PaO₂ <60, age >55, WBC >15k, Ca²⁺ <8, BUN >45, LDH >600, albumin <3.2, glucose >180. ≥3 = severe." },
            { q: "What is the Rockall score?", a: "Predicts <b>rebleeding and mortality</b> in upper GI bleeding. Pre-endoscopy: age, shock, comorbidity. Post-endoscopy adds: diagnosis and stigmata of recent hemorrhage. Score 0–11; ≥5 = high risk." },
            { q: "What is the Glasgow-Blatchford score?", a: "Predicts need for <b>intervention</b> (transfusion, endoscopy, surgery) in upper GI bleeding. Uses BUN, Hb, SBP, HR, melena, syncope, hepatic disease, cardiac failure. Score 0 = very low risk, may not need admission." },
            { q: "What is the Glasgow Coma Scale (GCS)?", a: "<b>Eye</b>: Spontaneous 4, Voice 3, Pain 2, None 1. <b>Verbal</b>: Oriented 5, Confused 4, Inappropriate words 3, Incomprehensible 2, None 1. <b>Motor</b>: Obeys 6, Localizes 5, Withdrawal 4, Flexion 3, Extension 2, None 1. Total 3–15; ≤8 = severe (intubate)." },
            { q: "What is the NIHSS?", a: "National Institutes of Health Stroke Scale. Quantifies <b>stroke severity</b> across 11 domains (consciousness, gaze, visual fields, facial palsy, motor, ataxia, sensation, language, dysarthria, extinction). Score 0–42; used to guide thrombolysis decisions." },
            { q: "What is the Hunt-Hess grading scale?", a: "Classifies <b>subarachnoid hemorrhage</b> severity. Grade I: mild headache; II: severe headache, nuchal rigidity, no deficit (except CN palsy); III: drowsy, mild deficit; IV: stupor, hemiparesis; V: coma, posturing. Higher grade = worse prognosis." },
            { q: "What is the Fisher grading scale?", a: "Grades <b>subarachnoid hemorrhage</b> based on CT appearance to predict <b>vasospasm</b> risk. 1: no blood; 2: diffuse thin layer <1 mm; 3: localized clot or thick layer >1 mm (highest risk); 4: intraventricular/intracerebral blood." },
            { q: "What is the ABCD² score?", a: "Predicts <b>stroke risk after TIA</b>. A = Age ≥60 (1), B = BP ≥140/90 (1), C = Clinical features — unilateral weakness (2) or speech disturbance without weakness (1), D = Duration ≥60 min (2) or 10–59 min (1), D = Diabetes (1). Max 7. ≥4 = high risk." },
            { q: "What are the Centor criteria (modified McIsaac)?", a: "Predicts <b>Group A Strep pharyngitis</b>. Tonsillar exudates (+1), tender anterior cervical lymphadenopathy (+1), fever >38°C (+1), absence of cough (+1). McIsaac adds: age 3–14 (+1), age ≥45 (−1). ≥3 → rapid strep test or empiric antibiotics." },
            { q: "What is the qSOFA score?", a: "Quick bedside screen for <b>sepsis</b> outside the ICU. RR ≥22 (+1), altered mentation (GCS <15) (+1), SBP ≤100 mmHg (+1). ≥2 = high risk of poor outcome; prompts further assessment with full SOFA." },
            { q: "What is the SOFA score?", a: "Sequential Organ Failure Assessment. Scores <b>6 organ systems</b> (respiratory: PaO₂/FiO₂, coagulation: platelets, liver: bilirubin, cardiovascular: MAP/vasopressors, CNS: GCS, renal: creatinine/UO) from 0–4 each. Sepsis-3 defines sepsis as suspected infection + SOFA ≥2." },
            { q: "State the Ottawa Ankle Rules.", a: "Ankle X-ray is indicated if there is pain in the <b>malleolar zone</b> AND any of: bone tenderness at posterior edge or tip of lateral/medial malleolus, OR inability to bear weight (4 steps) immediately and in ED. Sensitivity ~100% for fracture." },
            { q: "State the Ottawa Knee Rules.", a: "Knee X-ray is indicated if any of: age ≥55, isolated patellar tenderness, tenderness at fibular head, inability to flex to 90°, inability to bear weight (4 steps). Highly sensitive for clinically significant fracture." },
            { q: "What are the NEXUS criteria for C-spine clearance?", a: "C-spine imaging is NOT needed if ALL 5 criteria are met: <b>N</b>o posterior midline cervical tenderness, <b>N</b>o focal neurological deficit, <b>N</b>ormal alertness, <b>N</b>o intoxication, <b>N</b>o painful distracting injury." },
            { q: "What are the Canadian C-Spine Rules?", a: "Step 1: Any high-risk factor mandating imaging? (age ≥65, dangerous mechanism, paresthesias). Step 2: Any low-risk factor allowing safe ROM assessment? (simple rear-end MVC, ambulatory, delayed neck pain, sitting in ED). Step 3: Can patient actively rotate neck 45° left and right? If yes → no imaging needed." },
            { q: "State Light's criteria for pleural effusions.", a: "An effusion is <b>exudative</b> if any ONE is met: pleural protein/serum protein >0.5, pleural LDH/serum LDH >0.6, pleural LDH >⅔ upper limit of normal serum LDH. Otherwise it is <b>transudative</b>." },
            { q: "Name common causes of transudative pleural effusions.", a: "CHF (most common), cirrhosis (hepatic hydrothorax), nephrotic syndrome, PE (can be either), hypoalbuminemia, myxedema, peritoneal dialysis." },
            { q: "Name common causes of exudative pleural effusions.", a: "Pneumonia (parapneumonic), malignancy, TB, PE, pancreatitis, rheumatoid arthritis/lupus, esophageal rupture (high amylase, low pH), chylothorax (high triglycerides)." },
            { q: "State the Modified Duke Criteria for infective endocarditis.", a: "<b>Definite IE</b>: 2 major, or 1 major + 3 minor, or 5 minor criteria. <b>Major</b>: positive blood cultures (typical organisms in ≥2 cultures), endocardial involvement (vegetation, abscess, new regurgitation on echo). <b>Minor</b>: predisposition, fever ≥38°C, vascular phenomena (Janeway, emboli), immunologic (Osler nodes, Roth spots, RF), supportive micro." },
            { q: "State the Jones Criteria for acute rheumatic fever.", a: "Requires evidence of recent <b>GAS infection</b> + 2 major OR 1 major + 2 minor criteria. <b>Major (♥JONES)</b>: Joint (migratory polyarthritis), ♥ (carditis), Nodules (subcutaneous), Erythema marginatum, Sydenham chorea. <b>Minor</b>: fever, arthralgia, elevated ESR/CRP, prolonged PR interval." },
            { q: "Define SIRS (Systemic Inflammatory Response Syndrome).", a: "≥2 of: Temp >38°C or <36°C, HR >90, RR >20 or PaCO₂ <32, WBC >12k or <4k or >10% bands. SIRS + suspected infection = sepsis (by older definition). Now largely replaced by Sepsis-3." },
            { q: "Define sepsis and septic shock per Sepsis-3.", a: "<b>Sepsis</b>: life-threatening organ dysfunction caused by dysregulated host response to infection, defined as suspected infection + <b>SOFA score increase ≥2</b>. <b>Septic shock</b>: sepsis + vasopressors needed to maintain MAP ≥65 AND lactate >2 mmol/L despite adequate fluid resuscitation." },
            { q: "What is the differential diagnosis of acute chest pain?", a: "<b>Cardiac</b>: ACS, aortic dissection, pericarditis, myocarditis. <b>Pulmonary</b>: PE, pneumothorax, pneumonia, pleuritis. <b>GI</b>: GERD, esophageal spasm/rupture (Boerhaave), peptic ulcer. <b>MSK</b>: costochondritis (Tietze). <b>Other</b>: herpes zoster, anxiety/panic." },
            { q: "What features suggest ACS in chest pain evaluation?", a: "Substernal pressure/squeezing, radiation to jaw/left arm, diaphoresis, dyspnea, nausea. Worse with exertion, improved with rest/nitro. Risk factors: age, DM, HTN, smoking, family hx, hyperlipidemia. ECG changes and troponin elevation confirm." },
            { q: "Name red flags in chest pain that suggest emergent diagnoses.", a: "Tearing pain radiating to back (aortic dissection), unequal BPs/pulses, sudden pleuritic pain + hypoxia (PE), subcutaneous emphysema (Boerhaave/pneumothorax), hypotension + JVD + muffled heart sounds (tamponade — Beck's triad)." },
            { q: "What is the differential diagnosis of dyspnea?", a: "<b>Pulmonary</b>: asthma, COPD, PE, pneumonia, pneumothorax, ILD, pleural effusion. <b>Cardiac</b>: CHF, ACS, tamponade, valvular disease. <b>Other</b>: anemia, metabolic acidosis (Kussmaul), anxiety, neuromuscular disease (GBS, myasthenia), upper airway obstruction." },
            { q: "How do you differentiate cardiac from pulmonary dyspnea?", a: "<b>Cardiac</b>: orthopnea, PND, S3/S4, elevated JVP, peripheral edema, BNP elevated. <b>Pulmonary</b>: wheezing, cough, sputum, diminished breath sounds, hyperinflation. <b>Both</b>: hypoxia, tachypnea." },
            { q: "What is the differential for right upper quadrant abdominal pain?", a: "Biliary colic, acute cholecystitis, choledocholithiasis, cholangitis, hepatitis, hepatic abscess, Fitz-Hugh–Curtis syndrome, right lower lobe pneumonia, peptic ulcer disease, renal colic (right)." },
            { q: "What is the differential for left lower quadrant abdominal pain?", a: "Diverticulitis (most common), sigmoid volvulus, IBD (ulcerative colitis), ovarian pathology (torsion, cyst rupture, ectopic pregnancy), renal colic (left), mesenteric ischemia, hernia." },
            { q: "What is the differential for right lower quadrant abdominal pain?", a: "Appendicitis (most common), Meckel's diverticulitis, Crohn's disease (terminal ileum), cecal volvulus, mesenteric adenitis, ovarian pathology, ectopic pregnancy, psoas abscess, inguinal hernia." },
            { q: "What is the differential for epigastric abdominal pain?", a: "Peptic ulcer disease, acute pancreatitis, gastritis/GERD, acute coronary syndrome (inferior MI), biliary colic, aortic dissection/AAA, mesenteric ischemia, gastroparesis." },
            { q: "Differentiate primary from secondary headache.", a: "<b>Primary</b>: migraine, tension-type, cluster — no underlying pathology. <b>Secondary</b>: caused by another condition (SAH, meningitis, mass lesion, temporal arteritis, glaucoma, sinusitis, medication overuse, idiopathic intracranial hypertension)." },
            { q: "What are red flags in headache suggesting secondary cause? (SNOOP mnemonic)", a: "<b>S</b>ystemic symptoms/signs (fever, weight loss, cancer, HIV). <b>N</b>eurologic signs. <b>O</b>nset sudden (thunderclap). <b>O</b>lder age (>50, consider GCA). <b>P</b>rogressive pattern, positional, papilledema, precipitated by Valsalva, pregnancy/postpartum." },
            { q: "What is the differential diagnosis of syncope?", a: "<b>Neurally mediated</b>: vasovagal, situational (cough, micturition), carotid sinus hypersensitivity. <b>Cardiac</b>: arrhythmia (VT, bradycardia, long QT), structural (AS, HOCM, PE, tamponade, MI). <b>Orthostatic</b>: hypovolemia, autonomic dysfunction, meds. <b>Other</b>: seizure (not true syncope), hypoglycemia." },
            { q: "What is the differential diagnosis of jaundice by location?", a: "<b>Pre-hepatic</b> (↑ unconjugated): hemolysis, ineffective erythropoiesis, Gilbert's, Crigler-Najjar. <b>Hepatic</b> (↑ both): hepatitis, cirrhosis, drug-induced, Wilson's, hemochromatosis. <b>Post-hepatic</b> (↑ conjugated): choledocholithiasis, pancreatic head cancer, cholangiocarcinoma, PSC, stricture." },
            { q: "How does the pattern of liver function tests help localize jaundice?", a: "<b>Hepatocellular</b>: markedly ↑ AST/ALT with mild ↑ ALP/GGT. <b>Cholestatic</b>: markedly ↑ ALP/GGT with mild ↑ AST/ALT. <b>Pre-hepatic</b>: ↑ indirect bilirubin, normal LFTs. Direct vs. indirect bilirubin ratio is key." },
            { q: "Describe the anemia workup algorithm using MCV.", a: "<b>Microcytic (MCV <80)</b>: iron deficiency, thalassemia, anemia of chronic disease, sideroblastic, lead poisoning. <b>Normocytic (MCV 80–100)</b>: acute blood loss, ACD, hemolysis, bone marrow failure, renal disease. <b>Macrocytic (MCV >100)</b>: B12/folate deficiency (megaloblastic), liver disease, hypothyroidism, myelodysplasia, alcohol, drugs (methotrexate)." },
            { q: "How do you differentiate iron deficiency anemia from thalassemia trait?", a: "<b>IDA</b>: ↓ ferritin, ↓ iron, ↑ TIBC, ↑ RDW, low MCV. <b>Thalassemia trait</b>: normal/↑ ferritin, normal iron studies, normal RDW, very low MCV disproportionate to anemia, ↑ RBC count, target cells. Mentzer index (MCV/RBC): <13 = thalassemia, >13 = IDA." },
            { q: "How do you differentiate prerenal, intrinsic, and postrenal AKI?", a: "<b>Prerenal</b>: BUN/Cr >20, FENa <1%, UOsm >500, concentrated urine, responds to fluids. <b>Intrinsic (ATN)</b>: BUN/Cr ~15, FENa >2%, muddy brown casts, UOsm <350. <b>Postrenal</b>: bilateral hydronephrosis on US, urinary obstruction, BUN/Cr variable." },
            { q: "What is the formula for fractional excretion of sodium (FENa)?", a: "$\\\\text{FENa} = \\\\frac{U_{Na} \\\\times P_{Cr}}{P_{Na} \\\\times U_{Cr}} \\\\times 100$. <b><1%</b> = prerenal. <b>>2%</b> = intrinsic renal (ATN). Note: FENa is unreliable with diuretic use — use <b>FEUrea</b> instead (<35% = prerenal)." },
            { q: "What is the PICO framework in EBM?", a: "<b>P</b> = Patient/Population, <b>I</b> = Intervention, <b>C</b> = Comparison, <b>O</b> = Outcome. Used to formulate a focused, answerable clinical question for evidence-based practice." },
            { q: "What is the difference between absolute risk and relative risk?", a: "<b>Absolute risk</b>: the actual probability of an event (e.g., 2%). <b>Relative risk</b>: ratio of risk in exposed vs. unexposed ($\\\\text{RR} = \\\\frac{\\\\text{Risk}_{exposed}}{\\\\text{Risk}_{unexposed}}$). RR >1 = increased risk, RR <1 = protective, RR = 1 = no association." },
            { q: "What is critical appraisal of a study?", a: "Systematic evaluation of study <b>validity</b> (internal: study design, bias, confounding), <b>results</b> (magnitude, precision, statistical significance), and <b>applicability</b> (generalizability to your patient). Core skill of evidence-based medicine." },
            { q: "What are the Wilson-Jungner criteria for screening?", a: "10 criteria including: disease is an <b>important health problem</b>, accepted treatment exists, facilities available, <b>recognizable latent stage</b>, suitable test available, test acceptable to population, <b>natural history understood</b>, agreed policy on whom to treat, cost-effective, screening is a <b>continuing process</b>." },
            { q: "What are the USPSTF recommendation grades?", a: "<b>A</b>: High certainty of substantial net benefit — recommend. <b>B</b>: High certainty of moderate or moderate certainty of substantial benefit — recommend. <b>C</b>: Moderate certainty of small net benefit — selectively offer. <b>D</b>: Moderate/high certainty of no benefit or harms outweigh — discourage. <b>I</b>: Insufficient evidence." },
            { q: "What is overdiagnosis in screening?", a: "Detection of a disease that would <b>never have caused symptoms or death</b> during the patient's lifetime. Leads to unnecessary treatment, anxiety, and costs. Common with prostate (PSA), thyroid, and breast cancer screening." },
            { q: "What is an ROC curve?", a: "Receiver Operating Characteristic curve: plots <b>sensitivity (true positive rate) vs. 1−specificity (false positive rate)</b> at various test cutoff values. Area under the curve (AUC) measures overall discriminative ability; AUC = 1.0 is perfect, 0.5 is no better than chance." },
            { q: "How does changing the cutoff value of a diagnostic test affect sensitivity and specificity?", a: "Lowering the cutoff (calling more results positive) <b>increases sensitivity but decreases specificity</b>. Raising the cutoff <b>increases specificity but decreases sensitivity</b>. There is always a trade-off." },
            { q: "What is a gold standard in diagnostic testing?", a: "The reference test or method considered to have the <b>highest accuracy</b> for definitively diagnosing a condition. All new tests are compared against it. Example: biopsy for cancer, angiography for CAD, culture for infections." },
            { q: "What mnemonic helps recall causes of microcytic anemia?", a: "<b>TICS</b>: Thalassemia, Iron deficiency, Chronic disease (anemia of), Sideroblastic anemia. Also: <b>TAIL</b> — Thalassemia, Anemia of chronic disease, Iron deficiency, Lead poisoning." },
            { q: "What mnemonic helps recall causes of pancreatitis?", a: "<b>I GET SMASHED</b>: Idiopathic, Gallstones, Ethanol, Trauma, Steroids, Mumps/malignancy, Autoimmune, Scorpion sting, Hypertriglyceridemia/Hypercalcemia/Hypothermia, ERCP, Drugs (valproate, azathioprine, didanosine)." },
            { q: "What mnemonic helps recall secondary causes of hypertension?", a: "<b>RENAL</b>: Renal artery stenosis, Endocrine (Conn's, Cushing's, pheochromocytoma, thyroid), Narrowing of aorta (coarctation), Aldosteronism (primary), Lifestyle/drugs (NSAIDs, OCPs, cocaine, licorice)." },
            { q: "What is the Sgarbossa criteria used for?", a: "Diagnoses <b>acute MI in the presence of LBBB or ventricular paced rhythm</b>. Concordant ST elevation ≥1 mm (5 pts), concordant ST depression ≥1 mm in V1–V3 (3 pts), discordant ST elevation ≥5 mm (2 pts). ≥3 points = likely MI." },
            { q: "What is Chvostek's sign and what does it indicate?", a: "Tapping over the <b>facial nerve</b> (anterior to ear) causes ipsilateral facial muscle twitching. Indicates <b>hypocalcemia</b> (↑ neuromuscular excitability). Present in ~10% of normals." },
            { q: "What is the difference between Type I and Type II statistical errors?", a: "<b>Type I (α error)</b>: rejecting a true null hypothesis (false positive — concluding an effect exists when it doesn't). <b>Type II (β error)</b>: failing to reject a false null hypothesis (false negative — missing a real effect). Power = 1 − β." },
            { q: "What is statistical power?", a: "The probability of correctly <b>rejecting a false null hypothesis</b> (detecting a true effect). Power = 1 − β. Conventionally set at 0.80. Increased by: larger sample size, larger effect size, higher α level." },
            { q: "What is a confidence interval (CI)?", a: "A range of values within which the <b>true population parameter</b> is expected to lie with a specified probability (usually 95%). If the 95% CI for a difference includes 0, or for a ratio includes 1, the result is not statistically significant." },
            { q: "What is a p-value?", a: "The probability of obtaining results <b>at least as extreme as observed</b>, assuming the null hypothesis is true. p < 0.05 = statistically significant by convention. A small p-value does NOT tell you the magnitude or clinical significance of the effect." },
            { q: "What is the difference between intention-to-treat (ITT) and per-protocol analysis?", a: "<b>ITT</b>: analyzes all subjects in their <b>originally assigned groups</b>, regardless of compliance or crossover. Preserves randomization, reduces bias, preferred for RCTs. <b>Per-protocol</b>: analyzes only those who completed the protocol. May overestimate treatment effect." },
            { q: "What is the Fagan nomogram used for?", a: "A graphical tool for applying <b>Bayes' theorem</b>. A line drawn from pre-test probability through the likelihood ratio intersects the post-test probability axis, allowing quick estimation without calculation." },
            { q: "What is the CHADS₂ score?", a: "Older stroke risk tool for AF. <b>C</b>HF (1), <b>H</b>TN (1), <b>A</b>ge ≥75 (1), <b>D</b>iabetes (1), <b>S</b>troke/TIA (2). Max 6. ≥2 → anticoagulation recommended. Largely replaced by CHA₂DS₂-VASc for finer risk stratification." },
            { q: "What are the Light's criteria pitfalls?", a: "Light's criteria misclassify ~25% of <b>transudates as exudates</b>, especially in patients on diuretics (concentrates protein/LDH). If clinically suspected transudate meets exudative criteria, check <b>serum-effusion albumin gradient</b>: >1.2 g/dL suggests transudate." },
            { q: "What are the components of the Revised Cardiac Risk Index (RCRI/Lee Index)?", a: "Predicts perioperative cardiac risk. 6 factors (1 pt each): <b>high-risk surgery</b> (intraperitoneal, intrathoracic, suprainguinal vascular), <b>CAD</b>, <b>CHF</b>, <b>cerebrovascular disease</b>, <b>DM on insulin</b>, <b>creatinine >2</b>. 0 pts = ~3.9% risk; ≥3 = ~11%+ risk." },
            { q: "What is the Centor score treatment algorithm?", a: "Score 0–1: no testing, no antibiotics. Score 2–3: rapid antigen detection test (RADT); treat if positive. Score 4+: empiric antibiotics or RADT then treat. Goal: reduce unnecessary antibiotic use for viral pharyngitis." },
            { q: "What defines a thunderclap headache and what must be ruled out?", a: "Severe headache reaching <b>maximum intensity within seconds to 1 minute</b>. Must rule out <b>subarachnoid hemorrhage</b> (CT head → LP if CT negative). Other causes: cerebral venous thrombosis, RCVS, pituitary apoplexy, carotid/vertebral dissection." },
            { q: "What is the approach to an elevated reticulocyte count in anemia?", a: "↑ Reticulocyte count indicates <b>adequate marrow response</b> → consider blood loss or hemolysis. Evaluate hemolysis workup: ↑ LDH, ↑ indirect bilirubin, ↓ haptoglobin, peripheral smear (spherocytes, schistocytes), Coombs test (autoimmune vs. non-immune)." },
            { q: "Name the classic triad of hemolytic uremic syndrome (HUS).", a: "<b>Microangiopathic hemolytic anemia</b> (schistocytes), <b>thrombocytopenia</b>, <b>acute renal failure</b>. Typically in children after E. coli O157:H7 (Shiga toxin-producing) bloody diarrhea." },
            { q: "What distinguishes prerenal azotemia from ATN on urinalysis?", a: "<b>Prerenal</b>: bland sediment, hyaline casts, concentrated urine, high specific gravity. <b>ATN</b>: muddy brown granular casts, renal tubular epithelial cells, dilute urine, low specific gravity." },
            { q: "What is a Likelihood Ratio (LR) of 1 and what does it mean?", a: "LR = 1 means the test result is equally likely in <b>diseased and non-diseased</b> individuals. The test provides no diagnostic information and does not change post-test probability." },
            { q: "How are pre-test and post-test probabilities related via the Fagan nomogram?", a: "Draw a straight line from <b>pre-test probability</b> (left axis) through the <b>likelihood ratio</b> (center axis). Where it intersects the right axis = <b>post-test probability</b>. LR+ shifts probability up; LR− shifts it down." },
            { q: "What is verification (work-up) bias?", a: "Occurs when the decision to perform the <b>gold standard test</b> is influenced by the result of the index test. Patients with positive index tests are more likely to undergo the gold standard, inflating sensitivity." },
            { q: "What is the difference between inter-rater and intra-rater reliability?", a: "<b>Inter-rater</b>: agreement between <b>different observers</b> measuring the same thing. <b>Intra-rater</b>: consistency of the <b>same observer</b> on repeated measurements. Both measured by Cohen's kappa (κ)." },
            { q: "Interpret Cohen's kappa values.", a: "κ <0 = worse than chance; 0.0–0.20 = slight; 0.21–0.40 = fair; 0.41–0.60 = moderate; 0.61–0.80 = substantial; 0.81–1.00 = almost perfect agreement." },
            { q: "What is the difference between a screening test and a diagnostic test?", a: "<b>Screening</b>: applied to <b>asymptomatic</b> populations; must be highly <b>sensitive</b> (minimize false negatives). <b>Diagnostic</b>: applied to <b>symptomatic</b> patients; must be highly <b>specific</b> (minimize false positives). Positive screening tests require confirmatory diagnostic tests." },
            { q: "What is number needed to screen (NNS)?", a: "The number of people who need to be <b>screened</b> to prevent one death or adverse outcome. Analogous to NNT. Higher NNS = less efficient screening program." },
            { q: "What is the 'threshold approach' to clinical decision-making?", a: "Two thresholds divide probability space: <b>test threshold</b> (below = no test needed, disease unlikely) and <b>treatment threshold</b> (above = treat without testing, disease very likely). Between them = further testing is warranted." },
            { q: "What is the difference between internal and external validity?", a: "<b>Internal validity</b>: the degree to which results are <b>free from bias</b> within the study. <b>External validity</b> (generalizability): the degree to which results can be <b>applied to other populations</b> or settings." },
            { q: "What clinical features help differentiate transudative from exudative effusions before thoracentesis?", a: "<b>Transudate</b>: bilateral, no fever, associated with CHF/cirrhosis/nephrotic. <b>Exudate</b>: unilateral, pleuritic pain, fever, associated with infection/malignancy. However, thoracentesis with Light's criteria is needed for definitive classification." },
            { q: "What is the mnemonic for causes of an elevated anion gap metabolic acidosis?", a: "<b>MUDPILES</b>: Methanol, Uremia, Diabetic ketoacidosis, Propylene glycol/Paraldehyde, Iron/Isoniazid, Lactic acidosis, Ethylene glycol, Salicylates." },
            { q: "What is the mnemonic for causes of a normal anion gap (hyperchloremic) metabolic acidosis?", a: "<b>HARDUP</b>: Hyperalimentation, Acetazolamide/Addison's, Renal tubular acidosis, Diarrhea, Uretero-enterostomy, Pancreatic fistula/drainage. Also: <b>USED CARP</b>." },
            { q: "What is the anion gap formula and normal value?", a: "$\\\\text{AG} = Na^+ - (Cl^- + HCO_3^-)$. Normal ≈ 12 ± 4 mEq/L. Must correct for albumin: for every 1 g/dL ↓ albumin below 4, AG ↓ by ~2.5. An uncorrected AG may mask a true anion gap acidosis." },
            { q: "How do you apply the delta-delta (Δ/Δ) ratio?", a: "$\\\\Delta\\\\text{AG}/\\\\Delta\\\\text{HCO}_3 = \\\\frac{\\\\text{AG} - 12}{24 - \\\\text{HCO}_3}$. Ratio <1: concurrent non-AG metabolic acidosis. Ratio 1–2: pure AG metabolic acidosis. Ratio >2: concurrent metabolic alkalosis." },
            { q: "What is publication bias?", a: "Studies with <b>positive or significant results</b> are more likely to be published than those with negative results. Detected by asymmetry in a <b>funnel plot</b>. Can distort meta-analysis conclusions." },
            { q: "What is a forest plot?", a: "A graphical display of results from a <b>meta-analysis</b>. Each study shown as a point estimate (square, size proportional to weight) with CI (horizontal line). The <b>diamond</b> at bottom represents the pooled estimate. If the CI crosses the line of no effect (1 for OR/RR, 0 for mean difference), the result is not significant." },
            { q: "What is heterogeneity in meta-analysis and how is it measured?", a: "Variation in study results <b>beyond chance</b>. Measured by <b>I² statistic</b>: 0% = no heterogeneity; 25% = low; 50% = moderate; 75% = high. Also by Cochran's Q test. High heterogeneity may warrant subgroup analysis or random-effects model." },
            { q: "What is the difference between a fixed-effects and random-effects model in meta-analysis?", a: "<b>Fixed-effects</b>: assumes all studies estimate the <b>same true effect</b>; differences are due to sampling error. <b>Random-effects</b>: assumes true effect <b>varies between studies</b>; accounts for both within- and between-study variability. Random-effects gives wider CIs." },
            { q: "What is the CAGE questionnaire?", a: "Screens for <b>alcohol use disorder</b>. C = felt need to <b>Cut</b> down? A = <b>Annoyed</b> by criticism of drinking? G = felt <b>Guilty</b> about drinking? E = needed an <b>Eye-opener</b>? ≥2 positive = clinically significant." },
            { q: "What is the PHQ-9?", a: "Patient Health Questionnaire-9: screens and monitors <b>depression severity</b>. 9 items from DSM criteria scored 0–3 each (max 27). 5–9 mild, 10–14 moderate, 15–19 moderately severe, 20–27 severe depression." },
            { q: "What is Occam's razor vs. Hickam's dictum in clinical reasoning?", a: "<b>Occam's razor</b>: prefer the single simplest diagnosis that explains all findings (parsimony). <b>Hickam's dictum</b>: a patient can have as many diseases as they please — multiple diagnoses may coexist, especially in elderly or complex patients." },
            { q: "What is the Sutton's law in diagnosis?", a: "Go where the <b>money is</b> — pursue the most likely diagnosis first based on probability. Named after bank robber Willie Sutton. Emphasizes efficiency in the diagnostic workup." },
            { q: "What is the Aunt Minnie phenomenon?", a: "A diagnosis made by <b>instantaneous pattern recognition</b> from a characteristic visual appearance, requiring no further analysis. Common in radiology and dermatology. E.g., butterfly rash → lupus." },
            { q: "What are the Sepsis-3 screening tools in sequence?", a: "1. <b>qSOFA</b> (bedside, outside ICU): ≥2 → suspect sepsis. 2. <b>SOFA score</b> (full assessment): ≥2-point increase → sepsis confirmed. 3. If vasopressors needed for MAP ≥65 AND lactate >2 despite fluids → <b>septic shock</b>." },
            { q: "What is the sensitivity and specificity trade-off called?", a: "The <b>threshold effect</b>. Every continuous-value test has a cutoff point; changing it moves along the ROC curve. Choosing a lower cutoff favors sensitivity (ruling out); a higher cutoff favors specificity (ruling in)." },
            { q: "What is the SPIN and SNOUT mnemonic?", a: "<b>SpPIn</b>: a highly <b>Sp</b>ecific test, when <b>P</b>ositive, rules <b>In</b> disease. <b>SnNOut</b>: a highly <b>Sn</b>sensitive test, when <b>N</b>egative, rules <b>Out</b> disease. These are most useful when sensitivity or specificity is very high (>95%)." },
            { q: "How is the test-treatment threshold model used?", a: "If disease probability is <b>below the test threshold</b>, no testing is needed (too unlikely). If <b>above the treatment threshold</b>, treat empirically (too likely to waste time testing). Between thresholds, testing provides maximum decision value." },
            { q: "What is the difference between efficacy and effectiveness?", a: "<b>Efficacy</b>: does the intervention work under <b>ideal/controlled</b> conditions (RCT)? <b>Effectiveness</b>: does it work in <b>real-world/clinical</b> practice? Effectiveness is usually lower due to adherence, heterogeneity, and uncontrolled variables." }
          ]
        }
      ],
      'year4': [
{
          section: 'Obstetrics & Gynecology',
          topic: "Normal labor, delivery & postpartum care",
          icon: "baby",
          cards: [
            { q: "Define the first stage of labor.", a: "The first stage of labor begins with the onset of <b>regular uterine contractions</b> and ends with <b>complete cervical dilation (10 cm)</b>." },
            { q: "What are the two phases of the first stage of labor?", a: "The <b>latent phase</b> (characterized by gradual cervical change and effacement) and the <b>active phase</b> (characterized by rapid cervical dilation)." },
            { q: "At what cervical dilation does the active phase of labor typically begin according to Friedman versus modern ACOG guidelines?", a: "Friedman defined active phase onset at <b>3-4 cm</b>; modern guidelines (Zhang/ACOG) define it at <b>6 cm</b>." },
            { q: "What is the normal duration of the active phase of labor in a nulliparous patient?", a: "Approximately <b>8 to 12 hours</b>; dilation should progress at a rate of <b>$\\\\ge 1.0$ to $1.2$ cm/hour</b>." },
            { q: "What is the normal duration of the active phase of labor in a multiparous patient?", a: "Approximately <b>5 to 8 hours</b>; dilation should progress at a rate of <b>$\\\\ge 1.2$ to $1.5$ cm/hour</b>." },
            { q: "How is protraction of the active phase of the first stage of labor defined?", a: "Active phase cervical dilation progressing at <b>$< 1.2$ cm/hour</b> in nulliparas or <b>$< 1.5$ cm/hour</b> in multiparas." },
            { q: "How is arrest of the first stage of labor defined?", a: "No cervical change for <b>$\\\\ge 4$ hours</b> with adequate uterine contractions, or <b>$\\\\ge 6$ hours</b> with inadequate contractions on oxytocin." },
            { q: "Define the second stage of labor.", a: "The second stage of labor begins at <b>complete cervical dilation (10 cm)</b> and ends with the <b>delivery of the fetus</b>." },
            { q: "What are the two sub-phases of the second stage of labor?", a: "The <b>latent (passive) descent phase</b> (fetal descent without active maternal pushing) and the <b>active pushing phase</b>." },
            { q: "What is the upper limit of normal duration for the second stage of labor in a nulliparous patient without an epidural?", a: "<b>3 hours</b> (ACOG allows longer if progress is being made)." },
            { q: "What is the upper limit of normal duration for the second stage of labor in a nulliparous patient with an epidural?", a: "<b>4 hours</b> (adds 1 hour for epidural anesthesia)." },
            { q: "What is the upper limit of normal duration for the second stage of labor in a multiparous patient without an epidural?", a: "<b>2 hours</b>." },
            { q: "What is the upper limit of normal duration for the second stage of labor in a multiparous patient with an epidural?", a: "<b>3 hours</b>." },
            { q: "How is protraction of the second stage of labor defined?", a: "Fetal descent that takes longer than the normal time limits but continues to show progress." },
            { q: "How is arrest of the second stage of labor defined?", a: "No progress in descent/rotation after <b>3 hours</b> of pushing in nulliparas (4 with epidural) or <b>2 hours</b> in multiparas (3 with epidural)." },
            { q: "Define the third stage of labor.", a: "The third stage of labor begins immediately after the <b>delivery of the fetus</b> and ends with the <b>delivery of the placenta</b>." },
            { q: "What is the normal duration of the third stage of labor?", a: "Usually <b>5 to 15 minutes</b>; it is considered prolonged if it exceeds <b>30 minutes</b>." },
            { q: "What are the three classic signs of placental separation?", a: "1. <b>Gush of blood</b> from the vagina.<br>2. <b>Lengthening</b> of the umbilical cord.<br>3. <b>Uterus rises</b> in the abdomen and becomes firm/globular." },
            { q: "What is the active management of the third stage of labor (AMTSL) and why is it used?", a: "AMTSL involves <b>prophylactic uterotonics (oxytocin)</b>, <b>controlled cord traction</b> (Brandt-Andrews maneuver), and <b>uterine massage</b> to reduce postpartum hemorrhage risk." },
            { q: "What is the Brandt-Andrews maneuver?", a: "A method of controlled cord traction during the third stage of labor: one hand applies suprapubic pressure counter-traction upward while the other applies gentle downward traction on the cord." },
            { q: "What is the Crede maneuver and why is it avoided?", a: "Squeezing the uterine fundus to express the placenta; avoided because it can cause <b>uterine inversion</b> or severe pain." },
            { q: "Define the fourth stage of labor.", a: "The first <b>1 to 2 hours postpartum</b>, during which the mother's hemodynamic status stabilizes and the uterus undergoes initial involution." },
            { q: "How often should maternal vital signs and uterine tone be monitored during the fourth stage of labor?", a: "Every <b>15 minutes</b> for the first hour to detect early postpartum hemorrhage." },
            { q: "What are the '3 P's' that determine the progress of labor?", a: "<b>Power</b> (uterine contractions), <b>Passenger</b> (fetal factors), and <b>Passage</b> (maternal bony pelvis)." },
            { q: "How is the 'Power' component of labor quantified objectively?", a: "Using an <b>intrauterine pressure catheter (IUPC)</b> to measure uterine contraction strength in <b>Montevideo Units (MVUs)</b>." },
            { q: "How are Montevideo Units (MVUs) calculated?", a: "Multiply the average contraction amplitude (mmHg above baseline) by the number of contractions in a <b>10-minute window</b>." },
            { q: "What threshold of Montevideo Units (MVUs) represents adequate uterine power for labor progress?", a: "<b>200 to 250 MVUs</b>." },
            { q: "Define fetal lie and name the three main types.", a: "The relationship of the fetal long axis to the maternal long axis. Types: <b>longitudinal</b>, <b>transverse</b>, and <b>oblique</b>." },
            { q: "Define fetal presentation and list the major types.", a: "The fetal part closest to the birth canal. Types: <b>cephalic</b> (vertex, face, brow), <b>breech</b> (frank, complete, footling), and <b>shoulder</b>." },
            { q: "What landmark is used to describe cephalic vertex presentations?", a: "The <b>occiput</b> (e.g., Left Occiput Anterior - LOA)." },
            { q: "What landmark is used to describe breech presentations?", a: "The <b>sacrum</b> (e.g., Left Sacrum Anterior - LSA)." },
            { q: "What is fetal attitude and what is the normal attitude?", a: "The relationship of fetal parts to one another. Normal: <b>moderate flexion</b> of the head, spine, and extremities." },
            { q: "Define fetal station.", a: "The relationship of the presenting part of the fetus to the level of the maternal <b>ischial spines</b> (measured in centimeters from -5 to +5)." },
            { q: "What station is represented when the presenting part is at the level of the ischial spines?", a: "<b>Station 0</b> (indicates engagement of the fetal head)." },
            { q: "Define fetal engagement.", a: "When the widest diameter of the fetal presenting part (the biparietal diameter in vertex presentations) has passed through the pelvic inlet." },
            { q: "Name the four main types of maternal bony pelvis (Caldwell-Moloy classification).", a: "1. <b>Gynecoid</b> (normal female pelvis, round, most favorable)<br>2. <b>Android</b> (heart-shaped, male-type, high arrest rate)<br>3. <b>Anthropoid</b> (oval, long AP diameter, occiput posterior common)<br>4. <b>Platypelloid</b> (flat, wide transverse diameter, rare)" },
            { q: "Which pelvic type is associated with a high rate of persistent occiput posterior (OP) position?", a: "The <b>anthropoid</b> pelvis." },
            { q: "Which pelvic type has the worst prognosis for vaginal delivery?", a: "The <b>platypelloid</b> pelvis (due to the narrow anteroposterior diameter)." },
            { q: "List the seven cardinal movements of labor in correct sequence.", a: "1. <b>Engagement</b><br>2. <b>Descent</b><br>3. <b>Flexion</b><br>4. <b>Internal Rotation</b><br>5. <b>Extension</b><br>6. <b>External Rotation (Restitution)</b><br>7. <b>Expulsion</b>" },
            { q: "What movement occurs when the chin of the fetus is brought into contact with the chest?", a: "<b>Flexion</b> (presents the smallest suboccipital-bregmatic diameter of the head to the pelvis)." },
            { q: "What is the purpose of internal rotation during labor?", a: "To align the long diameter of the fetal head with the longest diameter of the maternal pelvic outlet (usually rotating the occiput anteriorly)." },
            { q: "When does extension of the fetal head occur?", a: "As the head reaches the pelvic outlet and passes under the pubic symphysis, pivoting on the subocciput." },
            { q: "What is restitution (external rotation)?", a: "Once the head is delivered, it rotates back to align with the fetal shoulders which are entering the pelvic outlet." },
            { q: "Define labor induction versus augmentation.", a: "<b>Induction:</b> initiating labor before its spontaneous onset. <b>Augmentation:</b> stimulating spontaneous labor that is progressing slowly." },
            { q: "What is the Bishop score used for?", a: "To assess cervical readiness ('ripeness') for induction. A high score predicts a successful vaginal delivery." },
            { q: "What five parameters are evaluated in the Bishop score?", a: "1. <b>Dilation</b> (cm)<br>2. <b>Effacement</b> (%)<br>3. <b>Station</b><br>4. <b>Consistency</b> of cervix (firm/medium/soft)<br>5. <b>Position</b> of cervix (posterior/mid/anterior)" },
            { q: "What Bishop score indicates a ripe cervix where induction success matches spontaneous labor?", a: "A score of <b>$\\\\ge 8$</b> (or $\\\\ge 6$ according to some guidelines)." },
            { q: "What Bishop score indicates an unfavorable cervix requiring cervical ripening agents?", a: "A score of <b>$\\\\le 6$</b>." },
            { q: "What chemical class of agents is used for medical cervical ripening?", a: "<b>Prostaglandins</b> (specifically Prostaglandin $E_1$ [Misoprostol] and Prostaglandin $E_2$ [Dinoprostone])." },
            { q: "What is the mechanism of action of prostaglandins in cervical ripening?", a: "They dissolve collagen fibers and increase water content in the cervical extracellular matrix, causing softening." },
            { q: "What mechanical methods are used for cervical ripening?", a: "<b>Foley bulb catheter</b> insertion through the internal os (applies mechanical pressure and stimulates local prostaglandin release) or osmotic dilators (laminaria)." },
            { q: "What is the major risk associated with prostaglandin use for labor induction?", a: "<b>Uterine tachysystole</b> (more than 5 contractions in 10 minutes) which can lead to fetal distress." },
            { q: "Prostaglandin-induced cervical ripening is contraindicated in which patients?", a: "Patients with a <b>history of prior uterine surgery (e.g., C-section)</b> due to an increased risk of uterine rupture." },
            { q: "What agent is first-line for labor induction when the cervix is favorable (Bishop $\\\\ge 8$)?", a: "<b>Oxytocin (Pitocin)</b>." },
            { q: "What is the mechanism of action of Oxytocin?", a: "Acts on G-protein coupled oxytocin receptors in the myometrium, activating phospholipase C to increase intracellular calcium and trigger contractions." },
            { q: "How is Oxytocin administered during labor?", a: "Via <b>continuous intravenous infusion</b> using a smart pump, starting at low doses (0.5-2 mU/min) and titrated up based on contraction pattern." },
            { q: "What is uterine tachysystole?", a: "<b>More than 5 contractions in 10 minutes</b> averaged over a 30-minute window." },
            { q: "What is the first step in managing uterine tachysystole with category II/III fetal heart rate patterns?", a: "Discontinue or decrease the oxytocin infusion, administer lateral positioning, and provide IV fluid bolus." },
            { q: "What pharmacological agent is used for acute tocolysis in severe tachysystole?", a: "<b>Terbutaline</b> (beta-2 agonist) administered subcutaneously." },
            { q: "What is amniotomy and what is its primary risk?", a: "Artificial rupture of membranes (AROM); primary risks are <b>umbilical cord prolapse</b> and chorioamnionitis if prolonged." },
            { q: "What must be checked immediately after performing an amniotomy?", a: "<b>Fetal heart rate (FHR)</b> to rule out cord compression/prolapse." },
            { q: "Describe the Ritgen maneuver.", a: "An obstetric technique to facilitate delivery of the head: apply upward pressure on the fetal chin through the perineum with one hand while the other hand controls the occiput, helping to prevent perineal lacerations." },
            { q: "What is the difference between a median and mediolateral episiotomy?", a: "<b>Median:</b> straight down from the fourchette toward the anus (easier to repair, less painful, but higher risk of 3rd/4th-degree extensions). <b>Mediolateral:</b> at a 45-degree angle (more painful, harder to repair, but protects the anal sphincter)." },
            { q: "How is a first-degree perineal laceration defined?", a: "Involves the <b>vaginal mucosa</b> and perineal skin only, without involving the underlying muscles." },
            { q: "How is a second-degree perineal laceration defined?", a: "Involves the vaginal mucosa, perineal skin, and <b>perineal body muscles</b> (transverse perineal muscle), but not the anal sphincter." },
            { q: "How is a third-degree perineal laceration defined?", a: "Involves injury to the vaginal mucosa, perineal muscles, and the <b>anal sphincter complex</b> (3a: <50% of external sphincter, 3b: >50% of external sphincter, 3c: internal anal sphincter)." },
            { q: "How is a fourth-degree perineal laceration defined?", a: "Involves the vaginal mucosa, perineal body, anal sphincter complex, and the <b>rectal mucosa</b> (opening into the anal canal)." },
            { q: "What is a nuchal cord and how is it managed at delivery?", a: "The umbilical cord is wrapped around the fetal neck. If loose, slip it over the head; if tight and blocking delivery, clamp and cut the cord before delivery of the shoulders." },
            { q: "Define the puerperium.", a: "The postpartum period, typically lasting <b>6 weeks</b>, during which the maternal anatomy and physiology return to the non-pregnant state." },
            { q: "What is uterine involution?", a: "The process by which the uterus contracts and shrinks back to its non-pregnant size. Immediately postpartum it is at the umbilicus, and by 2 weeks it should be within the true pelvis." },
            { q: "Define lochia rubra.", a: "Red, bloody postpartum vaginal discharge containing blood, shreds of decidua, and membranes. Lasts <b>3 to 4 days</b>." },
            { q: "Define lochia serosa.", a: "Pinkish-brown postpartum vaginal discharge containing serous exudate, erythrocytes, leukocytes, and cervical mucus. Lasts from day <b>4 to 10</b>." },
            { q: "Define lochia alba.", a: "Yellowish-white postpartum vaginal discharge containing leukocytes, epithelial cells, fat, and mucus. Lasts from day <b>10 to 4-6 weeks</b>." },
            { q: "Which hormone is primarily responsible for milk production (lactogenesis)?", a: "<b>Prolactin</b> (stimulated by the drop in progesterone and estrogen after placental delivery)." },
            { q: "Which hormone is primarily responsible for milk ejection ('let-down')?", a: "<b>Oxytocin</b> (stimulated by infant suckling, causing contraction of myoepithelial cells in breast alveoli)." },
            { q: "What is colostrum and its characteristics?", a: "The first milk produced in the first 2-3 days postpartum. It is thick, yellowish, rich in <b>IgA</b>, proteins, and minerals, but lower in fat and sugar than mature milk." },
            { q: "What is the recommended postpartum contraception strategy for breastfeeding women?", a: "<b>Progestin-only methods</b> (POP, Nexplanon, Depo, IUDs) or non-hormonal methods. Avoid estrogen-containing methods (COCPs) for the first 3-6 weeks as they decrease milk supply and increase DVT risk." },
            { q: "When should Rho(D) immune globulin (RhoGAM) be administered postpartum?", a: "Within <b>72 hours of delivery</b> to an Rh-negative mother who delivers an Rh-positive infant, to prevent Rh alloimmunization." },
            { q: "What test is used postpartum to determine the dose of RhoGAM needed for massive fetomaternal hemorrhage?", a: "The <b>Kleihauer-Betke (KB) test</b> (quantifies the percentage of fetal red blood cells in maternal circulation)." },
            { q: "What immunizations should be offered postpartum if the mother is non-immune?", a: "<b>MMR</b> (Measles, Mumps, Rubella) and <b>Varicella</b> vaccines (live vaccines, safe for breastfeeding, but avoid pregnancy for 4 weeks)." },
            { q: "What is postpartum thyroiditis?", a: "An autoimmune thyroid dysfunction occurring within 1 year postpartum, presenting with transient hyperthyroidism, followed by hypothyroidism, and eventual recovery. Associated with anti-TPO antibodies." },
            { q: "What is the management for normal postpartum urinary retention?", a: "Typically due to pelvic nerve bruising or epidural. Diagnosed if unable to void >6 hours post-delivery or post-catheter removal. Treat with a temporary indwelling catheter or intermittent straight catheterization." },
            { q: "What causes postpartum 'afterpains' and how are they treated?", a: "Myometrial contractions as the uterus undergoes involution, stimulated by breastfeeding oxytocin release. More severe in multiparas. Treated with <b>NSAIDs (Ibuprofen)</b>." },
            { q: "What is the normal postpartum weight loss pattern?", a: "Immediate loss of 10-13 lbs (fetus, placenta, amniotic fluid), followed by another 5-10 lbs from diuresis and uterine involution over the first week." },
            { q: "What is the physiological cause of postpartum diuresis?", a: "Reversal of gestational volume expansion, triggered by the loss of progesterone (which has mineralocorticoid-blocking properties)." },
            { q: "What is the diagnostic value of a normal postpartum hematocrit?", a: "Hematocrit drops initially due to blood loss, but hemodilution resolves by 3-5 days. A drop of >10 points compared to pre-delivery suggests significant hemorrhage." },
            { q: "How long postpartum does the hypercoagulable state persist?", a: "For at least <b>6 weeks</b> postpartum (estrogen and clotting factor levels take time to normalize)." },
            { q: "Define a prolonged latent phase of labor.", a: "Latent phase exceeding <b>20 hours</b> in a nullipara or <b>14 hours</b> in a multipara." },
            { q: "What is the primary management for a prolonged latent phase?", a: "Therapeutic rest (morphine) or augmentation with oxytocin/amniotomy. It is not an indication for C-section." },
            { q: "What is the Leopold maneuvers?", a: "A series of four abdominal palpation steps used to determine fetal lie, presentation, position, and engagement." },
            { q: "Describe the first Leopold maneuver.", a: "Palpation of the uterine fundus to determine what fetal part occupies the fundus (head vs. breech)." },
            { q: "Describe the second Leopold maneuver.", a: "Palpation of the lateral maternal abdomen to locate the fetal back versus the small parts (extremities)." },
            { q: "Describe the third Leopold maneuver (Pawlik's grip).", a: "Grasping the lower uterine segment above the pubic symphysis to determine the presenting part and its mobility (engaged vs. floating)." },
            { q: "Describe the fourth Leopold maneuver.", a: "Palpation facing the patient's feet to determine the cephalic prominence (flexion vs. extension of the head)." },
            { q: "What is the normal baseline fetal heart rate?", a: "<b>110 to 160 beats per minute (bpm)</b>." },
            { q: "What are the criteria for a reactive fetal non-stress test (NST)?", a: "<b>$\\\\ge 2$ accelerations</b> in a 20-minute window, each rising $\\\\ge 15$ bpm above baseline and lasting $\\\\ge 15$ seconds (10x10 if <32 weeks)." },
            { q: "Define fetal bradycardia and its common causes.", a: "Fetal heart rate <b>$< 110$ bpm</b> for $\\\\ge 10$ minutes. Causes: cord prolapse, uterine hyperstimulation, maternal hypotension, anesthetic blocks." },
            { q: "Define fetal tachycardia and its common causes.", a: "Fetal heart rate <b>$> 160$ bpm</b> for $\\\\ge 10$ minutes. Causes: maternal fever, chorioamnionitis, fetal hypoxia, sympathomimetic drugs." },
            { q: "How is short-term (beat-to-beat) FHR variability regulated?", a: "By the balanced interplay of the sympathetic and parasympathetic nervous systems acting on the SA node." },
            { q: "What is the significance of moderate FHR variability?", a: "Moderation (6-25 bpm amplitude) is the single best indicator of a <b>well-oxygenated fetal acid-base status</b>." },
            { q: "Name the five components of the Biophysical Profile (BPP).", a: "1. <b>Non-stress test (NST)</b><br>2. <b>Fetal breathing movements</b> (1 episode of $\\\\ge 30$ sec)<br>3. <b>Fetal movements</b> ($\\\\ge 3$ body/limb movements)<br>4. <b>Fetal tone</b> ($\\\\ge 1$ active extension/flexion)<br>5. <b>Amniotic fluid volume</b> (deepest pocket $\\\\ge 2$ cm)" },
            { q: "What is a normal versus abnormal BPP score?", a: "Normal: <b>8/10 or 10/10</b>. Equivocal: <b>6/10</b> (requires re-test). Abnormal: <b>$\\\\le 4/10$</b> (delivery indicated)." },
            { q: "Which component of the BPP is the best indicator of chronic uteroplacental function?", a: "<b>Amniotic fluid volume</b> (reflects fetal renal perfusion over time)." },
            { q: "What is the modified BPP?", a: "Combines the <b>Non-stress test (NST)</b> (acute marker) with the <b>Amniotic Fluid Index (AFI)</b> (chronic marker)." },
            { q: "How is the Amniotic Fluid Index (AFI) calculated?", a: "Sum of the deepest vertical fluid pockets in each of the four quadrants of the gravid uterus. Normal: <b>5 to 24 cm</b>." },
            { q: "Define oligohydramnios using AFI and deepest vertical pocket (DVP).", a: "AFI <b>$< 5$ cm</b> or DVP <b>$< 2$ cm</b>." },
            { q: "Define polyhydramnios using AFI and deepest vertical pocket (DVP).", a: "AFI <b>$> 24$ cm</b> or DVP <b>$> 8$ cm</b>." },
            { q: "What is the main physiological mechanism of epidural-induced maternal hypotension?", a: "Sympathetic blockade leading to systemic vasodilation and decreased venous return." },
            { q: "What is the treatment of choice for maternal hypotension secondary to epidural anesthesia?", a: "IV fluid bolus, lateral uterine displacement, and IV <b>phenylephrine</b> or <b>ephedrine</b>." },
            { q: "What is the definition of a trial of labor after cesarean (TOLAC)?", a: "Attempting vaginal delivery in a patient who has had a prior C-section." },
            { q: "What type of prior uterine incision is required for a patient to be a candidate for TOLAC?", a: "A <b>low transverse uterine incision</b>. Vertical/classical or T-shaped incisions are absolute contraindications due to rupture risk." },
            { q: "What is the success rate of TOLAC?", a: "Approximately <b>60% to 80%</b>." },
            { q: "What is the primary risk associated with TOLAC?", a: "<b>Uterine rupture</b> (occurs in 0.5-0.9% of trials with a low transverse incision)." },
            { q: "What is the clinical presentation of uterine rupture during labor?", a: "Loss of fetal station, sudden abdominal pain, vaginal bleeding, and non-reassuring fetal heart rate tracing (most common sign)." },
            { q: "Define the latent phase of labor according to Friedman.", a: "The period from the onset of labor contractions to the acceleration phase of cervical dilation (usually ending at 3-4 cm)." },
            { q: "How does parity affect the rate of cervical dilation in the active phase?", a: "Dilation is faster in multiparous patients (minimum 1.5 cm/hr) than in nulliparous patients (minimum 1.2 cm/hr)." },
            { q: "What is the function of the mucous plug and when is it expelled?", a: "A barrier of cervical mucus that seals the canal during pregnancy. Expelled ('bloody show') as the cervix begins to dilate and efface." },
            { q: "What is cervical effacement?", a: "The thinning and shortening of the cervix, expressed as a percentage from 0% (undilated, long) to 100% (paper thin)." },
            { q: "How does the sequence of effacement and dilation differ in nulliparas vs. multiparas?", a: "Nulliparas typically efface completely before dilating; multiparas often efface and dilate simultaneously." },
            { q: "What is a compound presentation?", a: "When a fetal extremity (usually a hand or arm) prolapses alongside the presenting part (usually the head)." },
            { q: "How is a compound presentation managed?", a: "Most resolve spontaneously as the head descends; gently pinch or push the hand back up if it arrests descent. C-section is only needed if there is arrest." },
            { q: "Define persistent occiput posterior (OP) position.", a: "The fetal head is engaged with the face facing the pubic symphysis ('sunny-side up'). Worsens back pain and prolongs the second stage." },
            { q: "What pelvic shape is classically associated with persistent occiput posterior (OP) position?", a: "<b>Anthropoid pelvis</b>." },
            { q: "What is the definition of clinical pelvimentry?", a: "Manual measurement of pelvic diameters (diagonal conjugate, interspinous distance) to evaluate pelvic capacity." },
            { q: "What is the diagonal conjugate and how is it measured?", a: "The distance from the lower border of the pubic symphysis to the sacral promontory. Normal: <b>$\\\\ge 11.5$ cm</b> (estimates obstetric conjugate by subtracting 1.5 cm)." },
            { q: "What is the obstetric conjugate?", a: "The shortest AP diameter of the pelvic inlet. Cannot be measured directly; estimated as Diagonal Conjugate - 1.5 cm. Normal <b>$\\\\ge 10$ cm</b>." },
            { q: "How is the pelvic outlet clinically assessed?", a: "By measuring the intertuberous diameter (normal >8 cm, fits a closed fist between the ischial tuberosities)." },
            { q: "What is the role of progesterone in maintaining uterine quiescence during pregnancy?", a: "It inhibits myometrial contractility by reducing intracellular calcium and downregulating gap junction formation." },
            { q: "What is the role of estrogen in labor initiation?", a: "It increases myometrial gap junctions, upregulates oxytocin receptors, and stimulates local prostaglandin synthesis." },
            { q: "What are Braxton Hicks contractions?", a: "Irregular, painless uterine contractions that do not cause cervical effacement or dilation. Often resolve with hydration and rest." },
            { q: "What is the Fern test and its purpose?", a: "Microscopic evaluation of vaginal fluid. Under high power, a 'crystallization' or ferning pattern confirms the presence of amniotic fluid (Rupture of Membranes)." },
            { q: "What is the Nitrazine test?", a: "pH indicator paper test for ROM. Amniotic fluid is alkaline (pH 7.0-7.5) and turns the paper blue. Falsely positive with semen, blood, or vaginosis." },
            { q: "What is the standard first-line treatment for a patient with PROM at 35 weeks?", a: "<b>Induction of labor</b> (GBS prophylaxis if positive or unknown; no benefit to expectant management at $\\\\ge 34$ weeks)." },
            { q: "What is the GBS screening window during pregnancy?", a: "<b>36 0/7 to 37 6/7 weeks</b> gestation via vaginal-rectal swab." },
            { q: "What is the drug of choice for intrapartum GBS prophylaxis?", a: "<b>Penicillin G</b> (5 million units IV loading, then 2.5-3 million units IV every 4 hours until delivery)." },
            { q: "What is the alternative drug for GBS prophylaxis in a penicillin-allergic patient with low risk of anaphylaxis?", a: "<b>Cefazolin</b> (Ancef)." },
            { q: "What GBS prophylaxis is used in a penicillin-allergic patient with high risk of anaphylaxis?", a: "<b>Clindamycin</b> (if isolate is sensitive) or <b>Vancomycin</b> (if resistant or sensitivity unknown)." },
            { q: "Name the indications for GBS prophylaxis when GBS status is unknown at onset of labor.", a: "1. Gestational age <b>$< 37$ weeks</b>.<br>2. Intrapartum fever <b>$\\\\ge 38^\\\\circ\\\\text{C}$ ($100.4^\\\\circ\\\\text{F}$)</b>.<br>3. Rupture of membranes <b>$\\\\ge 18$ hours</b>.<br>4. Prior infant with invasive GBS disease.<br>5. GBS bacteriuria during current pregnancy." },
            { q: "What is the Brandt-Andrews maneuver used for?", a: "To aid in the delivery of the placenta and prevent uterine inversion." },
            { q: "What is the management of choice for a retained placenta?", a: "Manual extraction of the placenta under anesthesia, followed by administration of uterotonics." },
            { q: "What are the common side effects of IV oxytocin infusion?", a: "Uterine tachysystole, water intoxication (due to its similarity to ADH at high doses, leading to hyponatremia), and transient hypotension if given as a rapid bolus." },
            { q: "Why is a rapid IV bolus of undiluted oxytocin avoided?", a: "Can cause acute, severe systemic vasodilation resulting in <b>profound hypotension</b> and cardiovascular collapse." },
            { q: "What are the contraindications to labor induction?", a: "Prior classical C-section, prior transmural myomectomy, active genital herpes, vasa previa, placenta previa, transverse fetal lie." },
            { q: "What is the purpose of the Bishop score consistency parameter?", a: "Evaluates how soft the cervix is (Firm = 0 points, Medium = 1, Soft = 2). A soft cervix indicates biochemical readiness for dilation." },
            { q: "What is the definition of a prolonged active phase in a nullipara?", a: "Progress of cervical dilation less than 1-1.2 cm per hour during the active phase of the first stage of labor." },
            { q: "What is a 'bloody show'?", a: "Vaginal discharge containing blood and mucus, signifying the extrusion of the cervical mucous plug as the cervix effaces and dilates." },
            { q: "What is the difference between true and false labor?", a: "<b>True labor:</b> regular contractions that increase in frequency/intensity and cause <b>progressive cervical change</b>. <b>False labor:</b> irregular contractions with no cervical change." },
            { q: "What is a posterior cervix?", a: "The cervix is angled toward the sacrum; typical of early or pre-labor states (scores 0 points on Bishop score)." },
            { q: "What is an anterior cervix?", a: "The cervix is angled forward toward the pubic symphysis; indicates advanced readiness for labor (scores 2 points on Bishop score)." },
            { q: "How is effacement measured in centimeters?", a: "An uneffaced cervix is about 3-4 cm long; a cervix that is 50% effaced is about 2 cm long; 100% effaced is paper thin (0 cm)." },
            { q: "What is a cephalic prominence?", a: "The part of the fetal head that is felt most prominently during abdominal palpation; helps determine if the head is flexed or extended." },
            { q: "What cephalic prominence is felt in a well-flexed vertex presentation?", a: "The forehead (sinciput), felt on the opposite side of the fetal back." },
            { q: "What cephalic prominence is felt in an extended face presentation?", a: "The occiput, felt on the same side as the fetal back." },
            { q: "Define fetal position.", a: "The relationship of a chosen landmark on the presenting part to the front, back, or sides of the maternal pelvis (e.g., ROA, LOP)." },
            { q: "What is a transverse presentation?", a: "Fetal lie is transverse, and the shoulder or trunk is the presenting part. Vaginal delivery is impossible; requires C-section." },
            { q: "What are the common causes of transverse lie?", a: "Prematurity, multiparity, uterine anomalies, placenta previa, polyhydramnios." },
            { q: "What is the definition of preterm labor?", a: "Regular uterine contractions causing cervical change occurring between <b>20 0/7 and 36 6/7 weeks</b> gestation." },
            { q: "What is a trial of labor (TOL)?", a: "The clinical management of labor in a patient attempting a vaginal delivery (often used in the context of TOLAC)." },
            { q: "What is the primary maternal benefit of a successful TOLAC?", a: "Avoids major abdominal surgery, leading to shorter recovery, fewer infectious complications, and lower risk of placenta accreta in future pregnancies." },
            { q: "What is the risk of uterine rupture in a patient with two prior low transverse C-sections?", a: "Approximately <b>1.8%</b> (about double the risk of one prior C-section)." },
            { q: "What is the role of amniotomy in labor augmentation?", a: "Rupturing membranes allows the fetal head to apply direct pressure to the cervix, stimulating endogenous oxytocin and accelerating contractions." },
            { q: "What is a vacuum-assisted delivery?", a: "An operative vaginal delivery method using a suction cup applied to the fetal occiput to apply traction during pushing." },
            { q: "What are the fetal risks of vacuum-assisted delivery?", a: "Cephalohematoma, subgaleal hemorrhage (can be life-threatening), retinal hemorrhage, scalp lacerations." },
            { q: "What are the maternal risks of operative vaginal delivery?", a: "Perineal lacerations (3rd/4th degree), vaginal lacerations, postpartum urinary retention, pelvic floor dysfunction." },
            { q: "What are the prerequisites for operative vaginal delivery (forceps or vacuum)?", a: "Complete dilation (10 cm), ruptured membranes, engaged head (station $\\\\ge +2$), known position, empty bladder, adequate maternal anesthesia." }
          ]
        },
        {
          section: 'Obstetrics & Gynecology',
          topic: "High-risk pregnancy — pre-eclampsia, GDM, placenta previa",
          icon: "alert-triangle",
          cards: [
            { q: "What is the diagnostic definition of gestational hypertension?", a: "New-onset systolic BP $\\\\ge 140$ mmHg and/or diastolic BP $\\\\ge 90$ mmHg after <b>20 weeks of gestation</b> in a previously normotensive patient, without proteinuria or systemic end-organ features." },
            { q: "What are the core diagnostic criteria for pre-eclampsia without severe features?", a: "New-onset BP $\\\\ge 140/90$ mmHg after 20 weeks of gestation AND <b>proteinuria</b> ($\\\\ge 300$ mg/24 hours, protein-to-creatinine ratio $\\\\ge 0.3$, or dipstick $\\\\ge 2+$ if quantitative tests are unavailable)." },
            { q: "How can pre-eclampsia be diagnosed in the absence of proteinuria?", a: "New-onset hypertension after 20 weeks of gestation plus any of the following <b>end-organ dysfunctions</b>: thrombocytopenia, renal insufficiency, impaired liver function, pulmonary edema, or new-onset headache/visual symptoms." },
            { q: "What blood pressure threshold constitutes a severe feature of pre-eclampsia?", a: "Systolic BP $\\\\ge 160$ mmHg and/or diastolic BP $\\\\ge 110$ mmHg on <b>two occasions</b> at least 4 hours apart while the patient is on bed rest (unless antihypertensive therapy is initiated sooner)." },
            { q: "What platelet count is defined as a severe feature of pre-eclampsia?", a: "Platelet count <b>less than 100,000/microL</b>." },
            { q: "What level of hepatic enzyme elevation constitutes a severe feature in pre-eclampsia?", a: "Serum transaminases (AST or ALT) <b>at least twice</b> the upper limit of normal, or severe persistent right upper quadrant/epigastric pain unresponsive to medication." },
            { q: "What serum creatinine level is considered a severe feature in pre-eclampsia?", a: "Serum creatinine <b>greater than 1.1 mg/dL</b>, or a doubling of serum creatinine in the absence of other renal disease." },
            { q: "Is pulmonary edema considered a severe feature of pre-eclampsia?", a: "<b>Yes</b>, pulmonary edema is a severe feature and requires immediate evaluation, oxygen supplementation, and consideration of delivery." },
            { q: "Which neurological symptoms are classified as severe features of pre-eclampsia?", a: "New-onset, persistent <b>headache</b> unresponsive to usual doses of analgesics, or <b>visual disturbances</b> (e.g., photopsia, scotoma, cortical blindness)." },
            { q: "Does the quantity of proteinuria (e.g., massive proteinuria > 5 g/24h) dictate the timing of delivery in pre-eclampsia?", a: "<b>No</b>; massive proteinuria is no longer used as a criterion for 'severe features' and does not solely dictate delivery timing." },
            { q: "What does the acronym HELLP stand for, and what are its three diagnostic components?", a: "<b>H</b>emolysis (microangiopathic hemolytic anemia), <b>E</b>levated <b>L</b>iver enzymes, and <b>L</b>ow <b>P</b>latelets." },
            { q: "What laboratory findings confirm the hemolysis component of HELLP syndrome?", a: "Abnormal peripheral smear (schistocytes/helmet cells), elevated indirect bilirubin, low haptoglobin, and lactate dehydrogenase (LDH) $\\\\ge 600$ U/L." },
            { q: "What is the definition of eclampsia?", a: "New-onset <b>tonic-clonic seizures</b> in a pregnant or postpartum patient with pre-eclampsia, which cannot be attributed to other organic causes." },
            { q: "What is the definition of chronic hypertension in pregnancy?", a: "Hypertension (BP $\\\\ge 140/90$ mmHg) present <b>before pregnancy</b>, diagnosed before <b>20 weeks of gestation</b>, or persisting beyond 12 weeks postpartum." },
            { q: "What features suggest superimposed pre-eclampsia in a patient with chronic hypertension?", a: "New-onset proteinuria or sudden increase in proteinuria after 20 weeks, sudden worsening of BP control, or development of any <b>end-organ severe features</b> (e.g., low platelets, elevated liver enzymes)." },
            { q: "When should low-dose aspirin prophylaxis be initiated in patients at high risk for pre-eclampsia?", a: "Initiate at <b>12 to 28 weeks</b> of gestation (optimally before 16 weeks) and continue daily until delivery." },
            { q: "What is the primary pharmacological purpose and mechanism of magnesium sulfate in pre-eclampsia?", a: "<b>Seizure prophylaxis</b>; it acts as a central nervous system depressant and neuromuscular blocker by competing with calcium at motor endplates." },
            { q: "What is the standard loading dose of magnesium sulfate for eclampsia prophylaxis?", a: "<b>4 to 6 grams IV</b> administered slowly over 15 to 20 minutes." },
            { q: "What is the standard maintenance infusion rate of magnesium sulfate for eclampsia prophylaxis?", a: "<b>1 to 2 grams per hour IV</b> continuous infusion." },
            { q: "What is the therapeutic target serum concentration range for magnesium sulfate?", a: "<b>4.8 to 8.4 mg/dL</b> (or 4.0 to 7.0 mEq/L)." },
            { q: "What is the first clinical sign of magnesium sulfate toxicity?", a: "Loss of <b>deep tendon reflexes (DTRs)</b>, which occurs at serum levels of 9.6 to 12.0 mg/dL (8 to 10 mEq/L)." },
            { q: "At what magnesium level does respiratory depression typically occur, and what is the clinical response?", a: "At levels <b>greater than 12 mg/dL</b> (10 mEq/L); immediately stop the infusion, secure the airway, and administer the antidote." },
            { q: "At what serum magnesium concentration does cardiac arrest occur?", a: "At levels <b>greater than 24 mg/dL</b> (20 mEq/L)." },
            { q: "What three clinical parameters must be monitored hourly during magnesium sulfate infusion?", a: "<b>Patellar reflexes</b>, <b>respiratory rate</b> (must be $\\\\ge 12$/min), and <b>urine output</b> (must be $\\\\ge 30$ mL/hour)." },
            { q: "What is the antidote for magnesium toxicity, and what is its standard dose?", a: "<b>Calcium gluconate</b>, 1 gram IV (10 mL of a 10% solution) administered over 5 to 10 minutes." },
            { q: "How is magnesium sulfate cleared from the body, and how must dosing be adjusted in renal impairment?", a: "Exclusively by the <b>kidneys</b>; in patients with renal impairment (creatinine > 1.1 or low urine output), the maintenance dose should be decreased or omitted, and serum levels monitored." },
            { q: "What is the immediate management for a patient experiencing an active eclamptic seizure?", a: "Ensure airway patency, administer oxygen, prevent maternal injury, and administer an <b>IV bolus of magnesium sulfate</b> (4-6g IV; if already on MgSO4, give an additional 2g bolus)." },
            { q: "What is the target blood pressure range when treating acute severe hypertension in pregnancy?", a: "Systolic <b>140-150 mmHg</b> and diastolic <b>90-100 mmHg</b> (avoid rapid drops to prevent uteroplacental hypoperfusion)." },
            { q: "What is the initial dose of IV labetalol for acute severe hypertension, and what are its contraindications?", a: "Initial dose is <b>20 mg IV</b> (followed by 40, then 80 mg at 10-minute intervals); contraindicated in patients with <b>asthma</b>, bradycardia, or decompensated heart failure." },
            { q: "What is the initial dose of IV hydralazine for acute severe hypertension, and what is a common adverse effect?", a: "Initial dose is <b>5 to 10 mg IV</b> (repeated in 20 minutes if needed); a common adverse effect is reflex tachycardia, headache, and flushing." },
            { q: "What is the dose of oral immediate-release nifedipine used for acute hypertensive emergency in pregnancy?", a: "<b>10 to 20 mg orally</b> (repeated in 20-30 minutes if necessary; avoid sublingual administration due to unpredictable absorption)." },
            { q: "Why are ACE inhibitors and ARBs contraindicated in pregnancy?", a: "They cause <b>fetal renal dysgenesis</b>, oligohydramnios, neonatal anuria, and skull hypoplasia (teratogenic in 2nd and 3rd trimesters)." },
            { q: "What are the preferred oral maintenance medications for chronic hypertension in pregnancy?", a: "<b>Labetalol</b>, <b>nifedipine (extended-release)</b>, and <b>methyldopa</b>." },
            { q: "What is the recommended gestational age for delivery in stable patients with gestational hypertension or pre-eclampsia without severe features?", a: "<b>37 0/7 weeks</b> of gestation." },
            { q: "What is the recommended timing of delivery for a patient with pre-eclampsia with severe features who is clinically stable?", a: "<b>34 0/7 weeks</b> of gestation." },
            { q: "What maternal or fetal conditions warrant immediate delivery in pre-eclampsia prior to 34 weeks?", a: "Eclampsia, pulmonary edema, DIC, renal failure, placental abruption, non-reassuring fetal status, or persistent severe hypertension refractory to 3 medications." },
            { q: "Should antenatal corticosteroids be administered if a pre-eclampsia patient requires delivery before 37 weeks?", a: "<b>Yes</b>, if between 24 0/7 and 36 6/7 weeks of gestation, to promote fetal lung maturity (12 mg IM betamethasone, 2 doses 24 hours apart)." },
            { q: "How long after delivery can new-onset pre-eclampsia or eclampsia manifest?", a: "Up to <b>6 weeks postpartum</b> (late-onset postpartum pre-eclampsia; often presents with headache and hypertension)." },
            { q: "Which drug has been proven superior to phenytoin and diazepam for the prevention of recurrent eclamptic seizures?", a: "<b>Magnesium sulfate</b>." },
            { q: "Is pre-eclampsia itself an absolute indication for Cesarean delivery?", a: "<b>No</b>; vaginal delivery is preferred and should be attempted via induction of labor unless obstetric contraindications exist." },
            { q: "What is the definition of Gestational Diabetes Mellitus (GDM)?", a: "Carbohydrate intolerance of variable severity with <b>onset or first recognition</b> during pregnancy." },
            { q: "Which hormone is primarily responsible for the insulin resistance observed in pregnancy, and what is its cell of origin?", a: "<b>Human placental lactogen (hPL)</b> (also known as human chorionic somatomammotropin), secreted by the syncytiotrophoblast." },
            { q: "What is the evolutionary physiological benefit of maternal insulin resistance in pregnancy?", a: "It ensures a continuous, abundant supply of glucose across the placenta to meet <b>fetal metabolic demands</b>." },
            { q: "At what gestational age is routine screening for GDM performed in low-risk patients?", a: "Between <b>24 and 28 weeks</b> of gestation." },
            { q: "Which risk factors warrant GDM screening at the first prenatal visit?", a: "Severe obesity, prior history of GDM, known impaired glucose metabolism, or a first-degree relative with type 2 diabetes." },
            { q: "What does the first step of the two-step GDM screening involve, and what is the screening threshold?", a: "A <b>50g oral glucose load</b> (non-fasting) followed by plasma glucose measurement 1 hour later; a value $\\\\ge 130$ or $140$ mg/dL is positive." },
            { q: "What does the second step of the two-step GDM diagnostic process involve?", a: "A fasting <b>100g oral glucose tolerance test (OGTT)</b> with venous plasma glucose measured at fasting, 1, 2, and 3 hours." },
            { q: "What are the 100g 3-hour OGTT diagnostic cutoffs according to the National Diabetes Data Group (NDDG) criteria?", a: "Fasting: <b>105</b> mg/dL; 1-hour: <b>190</b> mg/dL; 2-hour: <b>165</b> mg/dL; 3-hour: <b>145</b> mg/dL (2 or more abnormal values are diagnostic)." },
            { q: "What are the 100g 3-hour OGTT diagnostic cutoffs according to the Carpenter-Coustan criteria?", a: "Fasting: <b>95</b> mg/dL; 1-hour: <b>180</b> mg/dL; 2-hour: <b>155</b> mg/dL; 3-hour: <b>140</b> mg/dL (2 or more abnormal values are diagnostic)." },
            { q: "What is the one-step screening method for GDM recommended by the IADPSG?", a: "A fasting <b>75g 2-hour OGTT</b>; GDM is diagnosed if any single value is exceeded (Fasting $\\\\ge 92$, 1-hr $\\\\ge 180$, 2-hr $\\\\ge 153$ mg/dL)." },
            { q: "What is the difference between A1GDM and A2GDM?", a: "<b>A1GDM</b> is diet-controlled gestational diabetes; <b>A2GDM</b> requires pharmacotherapy (insulin or oral agents) to achieve glycemic control." },
            { q: "What is the target fasting capillary blood glucose level in gestational diabetes?", a: "<b>$< 95$ mg/dL</b>." },
            { q: "What is the target 1-hour postprandial capillary blood glucose level in gestational diabetes?", a: "<b>$< 140$ mg/dL</b>." },
            { q: "What is the target 2-hour postprandial capillary blood glucose level in gestational diabetes?", a: "<b>$< 120$ mg/dL</b>." },
            { q: "What is the birth weight threshold defining fetal macrosomia?", a: "A birth weight <b>$\\\\ge 4,500$ grams</b> in diabetic pregnancies (or $\\\\ge 4,000$g in some guidelines)." },
            { q: "What is the pathophysiology behind fetal macrosomia in diabetic pregnancies?", a: "Maternal hyperglycemia leads to <b>fetal hyperglycemia</b>; this stimulates the fetal pancreas to produce excess <b>insulin</b> (an anabolic hormone)." },
            { q: "Why do macrosomic infants of diabetic mothers have a higher risk of shoulder dystocia?", a: "They exhibit asymmetric macrosomia, with disproportionate deposition of fat around the <b>shoulders and abdomen</b>." },
            { q: "What causes immediate postpartum neonatal hypoglycemia in infants of diabetic mothers?", a: "Abrupt termination of high maternal glucose delivery combined with persistent <b>fetal hyperinsulinemia</b>." },
            { q: "How does maternal hyperglycemia increase the risk of neonatal respiratory distress syndrome?", a: "Fetal hyperinsulinism inhibits the action of cortisol, delaying the synthesis of <b>surfactant (specifically phosphatidylglycerol)</b>." },
            { q: "What other electrolyte and blood disorders are common in neonates of diabetic mothers?", a: "<b>Hypocalcemia</b>, <b>hypomagnesemia</b>, and <b>polycythemia</b> (caused by chronic fetal hypoxia driving erythropoietin production)." },
            { q: "What is the preferred first-line pharmacotherapy for gestational diabetes when lifestyle modifications fail?", a: "<b>Insulin</b> (does not cross the placenta and has the most predictable profile)." },
            { q: "What is the clinical role and limitation of metformin in GDM management?", a: "It is an oral option but <b>crosses the placenta</b>; up to 30-40% of patients require supplemental insulin, and long-term safety data are still accumulating." },
            { q: "Why is glyburide no longer preferred for GDM pharmacotherapy?", a: "It crosses the placenta and is associated with higher rates of <b>fetal macrosomia</b> and <b>neonatal hypoglycemia</b> compared to insulin." },
            { q: "Is routine antenatal fetal surveillance (e.g., NSTs) required in patients with well-controlled A1GDM?", a: "<b>No</b>, routine testing is generally not required unless other risk factors (e.g., chronic HTN, obesity) are present." },
            { q: "When should antenatal fetal testing (e.g., twice-weekly NST/BPP) begin in patients with A2GDM?", a: "Usually initiated at <b>32 weeks</b> of gestation (or earlier if additional complications exist)." },
            { q: "What is the recommended timing of delivery for patients with well-controlled A1GDM?", a: "Expectant management up to <b>39 0/7 to 40 6/7 weeks</b> of gestation." },
            { q: "What is the recommended timing of delivery for patients with A2GDM controlled on medication?", a: "Delivery is recommended between <b>39 0/7 and 39 6/7 weeks</b> of gestation (earlier only if poorly controlled)." },
            { q: "At what estimated fetal weight (EFW) should Cesarean delivery be offered to limit shoulder dystocia in GDM?", a: "When EFW is <b>$\\\\ge 4,500$ grams</b>." },
            { q: "What is the target maternal capillary blood glucose range during active labor to prevent neonatal hypoglycemia?", a: "<b>70 to 110 mg/dL</b> (often managed with IV insulin and dextrose infusions)." },
            { q: "What is the immediate postpartum management of insulin doses in a patient with GDM?", a: "<b>Discontinue</b> insulin therapy immediately after delivery of the placenta, as insulin sensitivity returns to normal rapidly." },
            { q: "What screening test is recommended postpartum for patients who had GDM, and when is it performed?", a: "A <b>75g 2-hour oral glucose tolerance test (OGTT)</b>, performed at <b>4 to 12 weeks postpartum</b>." },
            { q: "What is the long-term risk of developing type 2 diabetes mellitus in women with a history of GDM?", a: "Up to a <b>50% to 70% risk</b> of developing type 2 diabetes within 10 to 22 years postpartum." },
            { q: "Why is the risk of congenital anomalies NOT elevated in gestational diabetes compared to pregestational diabetes?", a: "GDM develops in the 2nd/3rd trimester, after <b>organogenesis</b> (weeks 3-8) has occurred." },
            { q: "What is the classic, highly specific cardiac structural anomaly seen in infants of mothers with poorly controlled pregestational diabetes?", a: "<b>Transient hypertrophic subaortic stenosis / asymmetric septal hypertrophy</b> (cardiomyopathy)." },
            { q: "What structural congenital defect of the lower spine is highly specific to poorly controlled pregestational diabetes?", a: "<b>Caudal regression syndrome</b> (sacral agenesis)." },
            { q: "What is the definition of antepartum hemorrhage?", a: "Genital tract bleeding occurring from <b>20 0/7 weeks of gestation</b> up to the birth of the baby." },
            { q: "What is the definition of placenta previa?", a: "The presence of placental tissue overlying or extending within <b>2 cm</b> of the internal cervical os." },
            { q: "What is the classic clinical presentation of placenta previa?", a: "Sudden onset of <b>painless, bright red vaginal bleeding</b> in the second half of pregnancy." },
            { q: "What are the key risk factors for developing placenta previa?", a: "Prior Cesarean delivery, prior placenta previa, multiparity, advanced maternal age, smoking, and multiple gestations." },
            { q: "Why is a digital cervical exam strictly contraindicated in a patient presenting with third-trimester vaginal bleeding until ultrasound is performed?", a: "It can cause <b>digital disruption of the placenta</b>, leading to catastrophic maternal hemorrhage." },
            { q: "What is the recommended timing of delivery for an uncomplicated patient with stable placenta previa?", a: "Cesarean delivery between <b>36 0/7 and 37 6/7 weeks</b> of gestation." },
            { q: "What are the three categories of Placenta Accreta Spectrum (PAS) based on depth of invasion?", a: "<b>Placenta accreta</b> (adheres to myometrium), <b>placenta increta</b> (invades myometrium), and <b>placenta percreta</b> (penetrates through serosa/adjacent organs)." },
            { q: "What combination of obstetric findings carries the highest risk for placenta accreta?", a: "The co-existence of <b>placenta previa</b> and a history of <b>prior Cesarean deliveries</b>." },
            { q: "What are the characteristic ultrasound signs of placenta accreta?", a: "Loss of the retroplacental hypoechoic zone, <b>multiple placental lacunae</b> ('Swiss cheese' appearance), and abnormality of the uterine serosa-bladder interface." },
            { q: "What is the standard planned management for a prenatally diagnosed placenta accreta spectrum?", a: "Scheduled Cesarean-hysterectomy at <b>34 0/7 to 35 6/7 weeks</b> of gestation with the placenta left in situ." },
            { q: "What is the definition of abruptio placentae?", a: "Premature <b>separation of a normally implanted placenta</b> from the uterine wall before delivery of the fetus." },
            { q: "What is the classic clinical presentation of placental abruption?", a: "<b>Painful vaginal bleeding</b>, uterine tenderness, hypertonic contractions, and non-reassuring fetal heart rate pattern." },
            { q: "What are the most significant risk factors for placental abruption?", a: "<b>Hypertension</b> (chronic or pre-eclampsia), <b>cocaine use</b>, abdominal trauma, smoking, and prior history of abruption." },
            { q: "What is a Couvelaire uterus?", a: "A complication of severe abruption where blood extravasates into the <b>uterine myometrium</b>, turning the uterine serosa purple/blue." },
            { q: "What is the clinical consequence of a Couvelaire uterus during delivery?", a: "It impairs myometrial contractility, leading to severe <b>uterine atony</b> and postpartum hemorrhage." },
            { q: "Why does placental abruption place the mother at high risk for Disseminated Intravascular Coagulation (DIC)?", a: "Release of tissue factor (thromboplastin) from the disrupted decidua activates the <b>extrinsic coagulation cascade</b>." },
            { q: "How is the diagnosis of placental abruption primarily made?", a: "It is a <b>clinical diagnosis</b>; ultrasound is insensitive and cannot rule out abruption (only 25% of cases show retroplacental clot)." },
            { q: "What is the clinical purpose of the Kleihauer-Betke (KB) test in antepartum hemorrhage?", a: "It detects and quantifies <b>fetal erythrocytes in maternal circulation</b> to determine the dose of Rho(D) immune globulin needed." },
            { q: "What is vasa previa?", a: "Fetal vessels running through the membranes overlying the <b>internal cervical os</b>, unprotected by placental tissue or umbilical cord." },
            { q: "Why is the bleeding in vasa previa immediately life-threatening to the fetus?", a: "The bleeding is entirely <b>fetal blood</b>; rupture of membranes tears these vessels, leading to rapid fetal exsanguination." },
            { q: "What laboratory test can differentiate maternal blood from fetal blood in vaginal discharge?", a: "The <b>Apt test</b> (based on fetal hemoglobin's resistance to alkali denaturing)." },
            { q: "What fetal heart rate pattern is classically seen during rupture of membranes in a patient with vasa previa?", a: "A <b>sinusoidal fetal heart rate pattern</b>, followed rapidly by bradycardia and death." },
            { q: "What is the management for a prenatally diagnosed vasa previa?", a: "Pelvic rest, scheduled hospitalization at 30-32 weeks for surveillance, and scheduled Cesarean delivery at <b>34 0/7 to 35 6/7 weeks</b>." },
            { q: "What is marginal sinus bleeding?", a: "Rupture of a marginal lake/sinus at the edge of a normally implanted placenta; it causes painless self-limiting bleeding." },
            { q: "What is the classic presentation of a uterine rupture during trial of labor?", a: "Sudden loss of fetal station, severe abdominal pain, <b>abnormal fetal heart rate tracing (bradycardia)</b>, and cessation of contractions." },
            { q: "What is the most significant risk factor for uterine rupture?", a: "A history of <b>prior uterine surgery</b>, especially a classical Cesarean incision." },
            { q: "What is the immediate management for a patient with placenta previa presenting with active, severe hemorrhage?", a: "Emergent <b>Cesarean delivery</b>, regardless of gestational age." },
            { q: "What is the first step in physical examination of a stable patient with suspected abruption or previa?", a: "A <b>sterile speculum examination</b> (after ultrasound rules out previa) to assess the source and amount of bleeding." },
            { q: "What umbilical cord pathology is strongly associated with vasa previa?", a: "<b>Velamentous cord insertion</b> (where umbilical vessels insert into membranes before reaching the placenta)." },
            { q: "What placental morphology increases the risk of vasa previa?", a: "A <b>succenturiate lobe</b> (accessory lobe of the placenta connected by fetal vessels passing through membranes)." },
            { q: "What is the difference between zygosity and chorionicity in multiple gestations?", a: "<b>Zygosity</b> refers to the genetic relationship (monozygotic vs. dizygotic); <b>chorionicity</b> refers to the number of placentas." },
            { q: "What ultrasound sign differentiates dichorionic from monochorionic twin gestations in early pregnancy?", a: "The <b>lambda ($\\\\lambda$) sign</b> (twin peak sign) indicates dichorionic; the <b>T sign</b> indicates monochorionic." },
            { q: "At what day post-fertilization does division occur to yield monochorionic monoamniotic (MoMo) twins?", a: "Division occurs between <b>days 8 and 12</b> after fertilization." },
            { q: "At what day post-fertilization does division occur to yield monochorionic diamniotic (MoDi) twins?", a: "Division occurs between <b>days 4 and 8</b> after fertilization." },
            { q: "At what day post-fertilization does division occur to yield conjoined twins?", a: "Division occurs <b>after day 13</b> post-fertilization." },
            { q: "What is the underlying vascular pathophysiology of Twin-Twin Transfusion Syndrome (TTTS)?", a: "Unbalanced blood flow through <b>arteriovenous (AV) anastomoses</b> in the shared placenta of monochorionic twins." },
            { q: "What are the classic fluid and growth findings in the donor vs. recipient twin in TTTS?", a: "Donor twin: <b>oligohydramnios</b> (stuck twin) and anemia; Recipient twin: <b>polyhydramnios</b> and fluid overload." },
            { q: "What is the name of the staging system used for Twin-Twin Transfusion Syndrome?", a: "The <b>Quintero staging system</b> (Stages I to V)." },
            { q: "What defines Quintero Stage I in TTTS?", a: "Polyhydramnios/oligohydramnios sequence, but the <b>donor twin's bladder is still visible</b>." },
            { q: "What defines Quintero Stage II in TTTS?", a: "The <b>donor twin's bladder is not visible</b> on ultrasound." },
            { q: "What defines Quintero Stage III in TTTS?", a: "<b>Critically abnormal doppler studies</b> in either twin (e.g., absent/reversed end-diastolic velocity in umbilical artery)." },
            { q: "What defines Quintero Stage IV in TTTS?", a: "<b>Hydrops fetalis</b> in one or both fetuses." },
            { q: "What defines Quintero Stage V in TTTS?", a: "<b>Death</b> of one or both fetuses." },
            { q: "What is the preferred treatment for advanced TTTS (Quintero Stage II-IV) before 26 weeks?", a: "<b>Fetoscopic laser photocoagulation</b> of the communicating placental anastomoses." },
            { q: "What is Intrahepatic Cholestasis of Pregnancy (ICP)?", a: "A liver disorder of pregnancy characterized by <b>pruritus (especially palms and soles)</b> and elevated serum bile acids." },
            { q: "What serum total bile acid level confirms the diagnosis of ICP?", a: "Total bile acid level <b>$\\\\ge 10$ micromol/L</b>." },
            { q: "What are the major fetal risks associated with Intrahepatic Cholestasis of Pregnancy?", a: "<b>Sudden intrauterine fetal demise (IUFD)</b>, preterm delivery, and meconium-stained amniotic fluid." },
            { q: "What is the first-line medication used to treat ICP, and what is its effect?", a: "<b>Ursodeoxycholic acid (UDCA)</b>; it improves maternal pruritus and lowers bile acid levels, though it may not completely eliminate IUFD risk." },
            { q: "What is the recommended delivery timing for a patient with ICP?", a: "Delivery between <b>36 0/7 and 37 6/7 weeks</b> of gestation (or 32-35 weeks if bile acids are $\\\\ge 100$ micromol/L)." },
            { q: "What is the recommended timing and mode of delivery for monochorionic monoamniotic twins?", a: "Cesarean delivery between <b>32 0/7 and 34 0/7 weeks</b> of gestation due to high risk of cord entanglement." }
          ]
        },
        {
          section: 'Obstetrics & Gynecology',
          topic: "Fetal monitoring & obstetric emergencies",
          icon: "activity",
          cards: [
            { q: "What is the normal baseline range for the fetal heart rate (FHR)?", a: "<b>110 to 160 beats per minute (bpm)</b>." },
            { q: "How is fetal bradycardia defined under NICHD guidelines?", a: "A baseline fetal heart rate of <b>< 110 bpm</b> for a duration of <b>10 minutes or longer</b>." },
            { q: "What are the common maternal causes of fetal bradycardia?", a: "Maternal hypotension (e.g., post-epidural), connective tissue disease (causing congenital heart block/maternal lupus), hypothermia, and drug administration (e.g., beta-blockers)." },
            { q: "What are the common fetal causes of fetal bradycardia?", a: "Fetal acidosis, umbilical cord prolapse/compression, congenital heart block, and late-stage fetal hypoxia." },
            { q: "How is fetal tachycardia defined under NICHD guidelines?", a: "A baseline fetal heart rate of <b>> 160 bpm</b> for a duration of <b>10 minutes or longer</b>." },
            { q: "What maternal conditions commonly lead to fetal tachycardia?", a: "Maternal fever/chorioamnionitis (most common), hyperthyroidism, dehydration, and drug use (e.g., terbutaline, cocaine, amphetamines)." },
            { q: "What fetal conditions commonly cause fetal tachycardia?", a: "Acute fetal hypoxia (early phase), fetal tachyarrhythmias (e.g., supraventricular tachycardia), fetal anemia, and fetal infection." },
            { q: "How is baseline FHR variability defined?", a: "Fluctuations in the baseline FHR that are <b>irregular in amplitude and frequency</b>, visually determined from peak to trough." },
            { q: "What defines absent FHR variability?", a: "An amplitude range that is visually <b>undetectable</b> (0 bpm)." },
            { q: "What defines minimal FHR variability?", a: "An amplitude range that is visually detectable but <b>$\\\\le 5$ bpm</b>." },
            { q: "What defines moderate FHR variability, and what does it indicate?", a: "An amplitude range of <b>6 to 25 bpm</b>; it indicates a normal, well-oxygenated fetal autonomic nervous system." },
            { q: "What defines marked FHR variability?", a: "An amplitude range of <b>> 25 bpm</b>." },
            { q: "What are the primary causes of minimal or absent FHR variability?", a: "Fetal sleep cycles (usually lasting 20-40 minutes), maternal medication (e.g., opioids, magnesium sulfate), fetal hypoxia, and acidosis." },
            { q: "What is the NICHD definition of a fetal heart rate acceleration at $\\\\ge 32$ weeks gestation?", a: "A visually apparent abrupt increase in FHR of <b>$\\\\ge 15$ bpm</b> above the baseline, with a duration from onset to return of <b>$\\\\ge 15$ seconds</b> (but < 2 minutes)." },
            { q: "What is the NICHD definition of a fetal heart rate acceleration at < 32 weeks gestation?", a: "A visually apparent abrupt increase in FHR of <b>$\\\\ge 10$ bpm</b> above the baseline, with a duration from onset to return of <b>$\\\\ge 10$ seconds</b> (but < 2 minutes)." },
            { q: "What is a prolonged acceleration?", a: "An acceleration that lasts <b>between 2 and 10 minutes</b>; an acceleration lasting $\\\\ge 10$ minutes is defined as a baseline change." },
            { q: "What does the presence of FHR accelerations indicate?", a: "Fetal movement and a non-acidotic fetus (reassuring finding)." },
            { q: "What is the definition of a FHR deceleration?", a: "A temporary decrease in the FHR below the baseline, classified as early, late, variable, or prolonged based on shape and timing." },
            { q: "What is the definition of an early deceleration?", a: "A visually apparent, gradual decrease (onset to nadir <b>$\\\\ge 30$ seconds</b>) and return of FHR associated with a contraction, where the nadir mirrors the peak of the contraction." },
            { q: "What is the pathophysiology behind early decelerations?", a: "<b>Fetal head compression</b> leading to vagal nerve stimulation, which transiently slows the heart rate." },
            { q: "What is the appropriate clinical management for early decelerations?", a: "No active intervention is required, as they are physiological and not associated with fetal hypoxia." },
            { q: "What is the definition of a late deceleration?", a: "A visually apparent, gradual decrease (onset to nadir <b>$\\\\ge 30$ seconds</b>) and return of FHR associated with a contraction, where the nadir occurs <b>after the peak</b> of the contraction." },
            { q: "What is the pathophysiology behind late decelerations?", a: "<b>Uteroplacental insufficiency</b> leading to transient fetal hypoxemia during uterine contractions." },
            { q: "What are the common maternal causes of late decelerations?", a: "Maternal hypotension (often from epidural anesthesia), uterine tachysystole (hyperstimulation), and chronic uteroplacental vascular disease (e.g., preeclampsia, chronic hypertension)." },
            { q: "What is the definition of a variable deceleration?", a: "A visually apparent, abrupt decrease (onset to nadir <b>< 30 seconds</b>) in FHR of <b>$\\\\ge 15$ bpm</b>, lasting <b>$\\\\ge 15$ seconds</b> but < 2 minutes." },
            { q: "What is the pathophysiology behind variable decelerations?", a: "<b>Umbilical cord compression</b>, which causes transient occlusion of umbilical vessels." },
            { q: "What are the accelerative phases before and after a variable deceleration called, and what do they represent?", a: "<b>Shoulders</b>; they represent a compensatory sympathetic response to transient occlusion of the umbilical vein before and after complete cord occlusion." },
            { q: "What features of variable decelerations are considered atypical or concerning?", a: "Slow return to baseline, loss of moderate variability within the deceleration, and a prolonged 'shoulder' with a subsequent drop." },
            { q: "What is the first-line intervention for recurrent variable decelerations?", a: "<b>Maternal position change</b> (e.g., left or right lateral decubitus) to relieve umbilical cord compression." },
            { q: "What medical procedure can be performed to treat persistent variable decelerations caused by oligohydramnios?", a: "<b>Amnioinfusion</b> (instillation of normal saline or lactated Ringer's into the uterine cavity via an IUPC)." },
            { q: "What defines a prolonged deceleration?", a: "A visually apparent decrease in FHR below the baseline of <b>$\\\\ge 15$ bpm</b> lasting <b>$\\\\ge 2$ minutes</b> but <b>< 10 minutes</b>." },
            { q: "What are the most common causes of a prolonged deceleration?", a: "Umbilical cord prolapse, maternal hypotension (e.g., post-epidural), uterine rupture, placental abruption, or rapid fetal descent." },
            { q: "What defines a baseline FHR change rather than a deceleration or acceleration?", a: "A change in FHR baseline lasting <b>$\\\\ge 10$ minutes</b>." },
            { q: "How is a sinusoidal FHR pattern described visually?", a: "A smooth, sine wave-like undulating pattern in FHR baseline with a cycle frequency of <b>3 to 5 cycles per minute</b> that persists for <b>$\\\\ge 20$ minutes</b>." },
            { q: "What does a true sinusoidal FHR pattern indicate clinically?", a: "Severe <b>fetal anemia</b> or severe acute fetal hypoxia." },
            { q: "What are the most common causes of a sinusoidal FHR pattern?", a: "Rh isoimmunization, severe feto-maternal hemorrhage, twin-to-twin transfusion syndrome, or ruptured vasa previa." },
            { q: "What causes a pseudo-sinusoidal FHR pattern, and how is it distinguished?", a: "Maternal administration of <b>opioids</b> (e.g., butorphanol, fentanyl, meperidine); it is typically transient (lasting < 30-40 minutes) and has a less regular waveform." },
            { q: "What are the specific criteria required for a Category I FHR tracing?", a: "Baseline 110-160 bpm, <b>moderate variability</b>, no late/variable decelerations, early decelerations present or absent, accelerations present or absent." },
            { q: "What is the clinical interpretation and management of a Category I FHR tracing?", a: "It is normal, strongly predictive of normal fetal acid-base status, and requires <b>routine management</b> (no specific intervention)." },
            { q: "What are the specific criteria for a Category III FHR tracing?", a: "Absent baseline FHR variability AND any of the following: <b>recurrent late decelerations</b>, <b>recurrent variable decelerations</b>, or <b>bradycardia</b>; OR a <b>sinusoidal pattern</b>." },
            { q: "What does a Category III FHR tracing indicate, and what is the management?", a: "It indicates abnormal fetal acid-base status; it requires <b>immediate preparation for delivery</b> and simultaneous <b>intrauterine resuscitation</b>." },
            { q: "How is a Category II FHR tracing defined?", a: "It is <b>indeterminate</b>; it includes all FHR tracings that do not meet the criteria for Category I or Category III." },
            { q: "What is the management algorithm for a Category II FHR tracing?", a: "Continued evaluation, close monitoring, and initiating <b>intrauterine resuscitation maneuvers</b> if there are signs of potential fetal decompensation." },
            { q: "How is uterine tachysystole defined?", a: "<b>> 5 contractions in 10 minutes</b>, averaged over a 30-minute window." },
            { q: "Why is uterine tachysystole dangerous to the fetus?", a: "It prevents adequate uterine relaxation, leading to progressive reduction in uteroplacental blood flow and fetal hypoxia." },
            { q: "What is the mechanism of left lateral maternal positioning in intrauterine resuscitation?", a: "It relieves <b>aortocaval compression</b> by the gravid uterus, increasing maternal venous return, cardiac output, and uteroplacental perfusion." },
            { q: "How does an IV fluid bolus aid in intrauterine resuscitation?", a: "It expands maternal intravascular volume, correcting hypotension (especially post-epidural) and increasing uterine blood flow." },
            { q: "Why is oxytocin discontinued during intrauterine resuscitation?", a: "To decrease contraction frequency and duration, thereby increasing uteroplacental perfusion and allowing the fetus to recover from hypoxic stress." },
            { q: "Which tocolytic agent is commonly administered to treat uterine tachysystole, and what is its dose/route?", a: "<b>Terbutaline</b>, 0.25 mg subcutaneously." },
            { q: "What maternal medications are used to treat hypotension during labor to improve FHR patterns?", a: "Vasopressors such as <b>ephedrine</b> or <b>phenylephrine</b>." },
            { q: "What is the purpose of performing fetal scalp stimulation?", a: "To assess fetal acid-base status; a resulting acceleration of FHR rules out significant fetal metabolic acidosis (<b>$\\\\text{pH} \\\\ge 7.20$</b>)." },
            { q: "What fetal scalp blood pH and lactate levels indicate significant acidosis requiring delivery?", a: "<b>$\\\\text{pH} < 7.20$</b> or <b>$\\\\text{lactate} > 4.8\\\\text{ mmol/L}$</b>." },
            { q: "What are the prerequisites for placing a fetal scalp electrode (FSE)?", a: "Ruptured membranes, adequate cervical dilation (typically <b>$\\\\ge 2$ cm</b>), and an accessible, engaged fetal presenting part." },
            { q: "What are the absolute contraindications to placing a fetal scalp electrode?", a: "Maternal infection with <b>HIV</b>, <b>active genital Herpes Simplex Virus (HSV)</b>, or <b>Hepatitis B/C</b>, and suspected fetal bleeding disorders." },
            { q: "What parameters are measured by an intrauterine pressure catheter (IUPC)?", a: "The frequency, duration, baseline tone, and peak pressure of uterine contractions in millimeters of mercury (mmHg)." },
            { q: "What is the formula for calculating Montevideo Units (MVUs) using an IUPC tracing?", a: "$$\\\\text{Montevideo Units} = \\\\sum (\\\\text{Peak pressure of each contraction in mmHg} - \\\\text{Baseline uterine tone in mmHg}) \\\\text{ over a } 10\\\\text{-minute window}$$" },
            { q: "What MVU threshold defines adequate uterine contractions in active labor?", a: "<b>$\\\\ge 200$ MVUs</b>." },
            { q: "What are the potential complications associated with IUPC placement?", a: "Placental abruption, uterine perforation, umbilical cord vessel laceration, and increased risk of intra-amniotic infection." },
            { q: "To determine the baseline FHR, what is the minimum required duration of interpretable tracing?", a: "At least <b>2 minutes</b> of interpretable baseline data in any 10-minute segment." },
            { q: "What is the definition of recurrent decelerations?", a: "Decelerations that occur with <b>$\\\\ge 50\\\\%$</b> of uterine contractions in any 20-minute window." },
            { q: "What is the definition of intermittent decelerations?", a: "Decelerations that occur with <b>$< 50\\\\%$</b> of uterine contractions in any 20-minute window." },
            { q: "What clinical scenario mandates umbilical cord blood gas analysis?", a: "Apgar score <b>$\\\\le 5$</b> at 5 minutes, assisted operative delivery, Category III FHR tracing, intrapartum fever, or severe growth restriction." },
            { q: "Which cord vessel (artery or vein) is more reflective of fetal tissue metabolism and acid-base status?", a: "The <b>umbilical artery</b> (carrying blood from the fetus to the placenta)." },
            { q: "What is the normal pH of umbilical artery blood at delivery?", a: "Approximately 7.20 to 7.30; a <b>$\\\\text{pH} < 7.00$</b> indicates pathological acidemia." },
            { q: "What is the definition of shoulder dystocia?", a: "A delivery requiring additional obstetric maneuvers to release the fetal shoulders after gentle downward traction on the fetal head has failed." },
            { q: "What are the primary antepartum risk factors for shoulder dystocia?", a: "Fetal macrosomia (birth weight > 4000g or > 4500g), maternal diabetes (pregestational or gestational), obesity, and prior history of shoulder dystocia." },
            { q: "What are the primary intrapartum risk factors for shoulder dystocia?", a: "Prolonged second stage of labor, oxytocin induction/augmentation, and operative vaginal delivery (forceps or vacuum)." },
            { q: "What is the 'turtle sign' in labor?", a: "The retraction of the delivered fetal head against the maternal perineum, signifying impaction of the anterior shoulder behind the pubic symphysis." },
            { q: "What is the first step in the management of shoulder dystocia?", a: "<b>Call for additional assistance</b> (anesthesiology, pediatrics, extra nursing staff) and instruct the mother to <b>stop pushing</b>." },
            { q: "Describe the McRoberts maneuver.", a: "Hyperflexion of the maternal hips against the abdomen, which flattens the sacrum and rotates the pubic symphysis cephalad, facilitating shoulder release." },
            { q: "How does suprapubic pressure assist in resolving shoulder dystocia?", a: "Pressure is applied to the maternal abdomen over the anterior shoulder, directing it downward and laterally to adduct and displace it from behind the pubic symphysis." },
            { q: "Why is fundal pressure contraindicated in shoulder dystocia?", a: "It worsens the impaction of the anterior shoulder against the pubic symphysis and increases the risk of uterine rupture and brachial plexus injury." },
            { q: "Describe the Rubin II maneuver.", a: "Insertion of two fingers into the vagina behind the posterior aspect of the anterior shoulder to apply pressure, adducting the shoulder and reducing its width." },
            { q: "Describe the Wood's screw maneuver.", a: "Applying pressure to the anterior aspect of the posterior shoulder to rotate it <b>$180^\\\\circ$</b>, turning the posterior shoulder into the anterior position." },
            { q: "What is the 'reverse Wood's screw' (Rubin I) maneuver?", a: "Applying pressure to the posterior aspect of the posterior shoulder to rotate the fetus in the opposite direction." },
            { q: "How is the delivery of the posterior arm performed?", a: "The clinician's hand is inserted into the vagina, the posterior forearm is swept across the fetal chest, and the hand is delivered, reducing the shoulder diameter." },
            { q: "What is the Gaskin maneuver?", a: "Placing the mother on her <b>hands and knees</b> (all-fours position), which increases pelvic dimensions and utilizes gravity to release the shoulder." },
            { q: "What is the Zavanelli maneuver, and when is it indicated?", a: "Cephalic replacement (flexing and pushing the fetal head back into the vagina) followed by emergency cesarean delivery; it is a last-resort maneuver." },
            { q: "What is a cleidotomy, and when is it performed?", a: "The surgical division of the fetal clavicle (using scissors) to reduce the biacromial diameter, typically reserved for cases of fetal demise." },
            { q: "What is a symphysiotomy?", a: "The surgical division of the cartilage of the maternal pubic symphysis under local anesthesia to increase pelvic capacity in extreme cases." },
            { q: "What is the most common neonatal nerve injury associated with shoulder dystocia?", a: "<b>Erb's palsy</b> (injury to the <b>$C_5\\\\text{-}C_6$</b> nerve roots of the brachial plexus), resulting in a 'waiter's tip' arm posture." },
            { q: "What is Klumpke's palsy, and what nerve roots are affected?", a: "Injury to the <b>$C_8\\\\text{-}T_1$</b> nerve roots, causing a 'claw hand' deformity and loss of sensation in the hand/forearm." },
            { q: "What is the difference between overt and occult umbilical cord prolapse?", a: "<b>Overt prolapse</b> is the descent of the cord past the presenting part into the vagina or vulva; <b>occult prolapse</b> is when the cord lies adjacent to the presenting part." },
            { q: "What are the key risk factors for umbilical cord prolapse?", a: "Fetal malpresentation (especially transverse lie or footling breech), polyhydramnios, prematurity, unengaged presenting part, and low birth weight." },
            { q: "What iatrogenic intervention is a major risk factor for umbilical cord prolapse?", a: "<b>Artificial rupture of membranes (AROM)</b> performed when the fetal presenting part is high and unengaged." },
            { q: "How is umbilical cord prolapse diagnosed?", a: "Palpation of a soft, pulsating loop of cord in the vaginal canal during a pelvic exam, often accompanied by sudden, severe variable decelerations or bradycardia." },
            { q: "What is the immediate first step upon diagnosing overt umbilical cord prolapse?", a: "Manually <b>elevate the fetal presenting part</b> off the cord by placing a hand in the vagina, and keep it there until delivery." },
            { q: "What maternal positions are used to reduce pressure on the prolapsed umbilical cord?", a: "<b>Knee-chest position</b> or <b>Trendelenburg position</b>." },
            { q: "How can bladder instillation assist in cord prolapse management?", a: "Instilling 500 to 700 mL of saline into the maternal bladder via a Foley catheter lifts the fetal presenting part off the prolapsed cord." },
            { q: "Why should you avoid manually pushing a prolapsed cord back into the uterus?", a: "It can cause <b>vasospasm</b> of the umbilical vessels, worsening fetal hypoxemia, and is associated with poorer outcomes." },
            { q: "What is the definitive treatment for umbilical cord prolapse during active labor?", a: "<b>Emergency cesarean delivery</b> (unless vaginal delivery is imminent)." },
            { q: "What is the difference between a complete uterine rupture and a uterine dehiscence?", a: "A <b>complete rupture</b> involves all layers of the uterus (endometrium, myometrium, and serosa) with communication into the peritoneal cavity; <b>dehiscence</b> is an incomplete separation with intact serosa." },
            { q: "What is the most significant risk factor for uterine rupture?", a: "A prior <b>cesarean delivery</b> or other transmural uterine surgery (e.g., myomectomy entering the endometrial cavity)." },
            { q: "What type of prior cesarean incision carries the highest risk of uterine rupture during a trial of labor after cesarean (TOLAC)?", a: "A prior <b>classical cesarean incision</b> (vertical incision in the active upper segment), carrying a <b>$4\\\\text{-}9\\\\%$</b> risk." },
            { q: "Which uterotonic/induction agents are contraindicated in patients undergoing TOLAC due to increased rupture risk?", a: "Prostaglandins (e.g., <b>misoprostol</b>, dinoprostone) are contraindicated; oxytocin must be used with extreme caution." },
            { q: "What is the most common presenting sign of uterine rupture?", a: "An <b>abnormal fetal heart rate tracing</b>, most commonly prolonged decelerations, deep variable decelerations, or bradycardia." },
            { q: "What classic physical exam signs suggest uterine rupture?", a: "Sudden loss of fetal station (fetal head recedes), palpable fetal parts through the maternal abdominal wall, and cessation of contractions." },
            { q: "What maternal symptoms are classic for uterine rupture?", a: "Sudden, tearing abdominal pain, vaginal bleeding, and referred shoulder/chest pain (due to hemoperitoneum irritating the diaphragm)." },
            { q: "What is the immediate management for uterine rupture?", a: "Immediate <b>emergency laparotomy</b>, delivery of the fetus, and uterine repair or hysterectomy." },
            { q: "What is amniotic fluid embolism (AFE)?", a: "A rare, life-threatening obstetric emergency where amniotic fluid, fetal cells, or debris enter the maternal circulation, triggering a severe immune/inflammatory response." },
            { q: "When does amniotic fluid embolism typically occur?", a: "During labor, delivery, or within 30 minutes of postpartum." },
            { q: "What is the classic clinical triad of amniotic fluid embolism?", a: "1. <b>Hypoxia</b> (sudden dyspnea, cyanosis, ARDS)<br>2. <b>Hypotension</b> (cardiogenic shock)<br>3. <b>Coagulopathy</b> (DIC)" },
            { q: "Describe the two phases of cardiovascular collapse in AFE.", a: "An initial phase of acute pulmonary hypertension and right ventricular failure, followed by a secondary phase of left ventricular failure and pulmonary edema." },
            { q: "What is the hallmark coagulopathy finding in AFE?", a: "Severe <b>Disseminated Intravascular Coagulopathy (DIC)</b>, characterized by rapid depletion of fibrinogen and profuse hemorrhage." },
            { q: "What is the primary management strategy for AFE?", a: "<b>Supportive care</b>: high-fraction oxygen/intubation, fluid resuscitation, vasopressors, inotropes, and massive transfusion protocol." },
            { q: "What does the 'AOK' protocol for AFE consist of?", a: "<b>Atropine</b> (0.8 mg), <b>Ondansetron</b> (8 mg), and <b>Ketorolac</b> (30 mg) IV, aimed at blocking the vagal and anaphylactoid-like reactions." },
            { q: "What is the definition of postpartum hemorrhage (PPH)?", a: "Cumulative blood loss <b>$\\\\ge 1000$ mL</b> or blood loss accompanied by signs or symptoms of hypovolemia within 24 hours after birth." },
            { q: "What is the most common cause of postpartum hemorrhage?", a: "<b>Uterine atony</b> (failure of the uterus to contract and compress spiral arteries), accounting for <b>$70\\\\text{-}80\\\\%$</b> of cases." },
            { q: "What are the '4 T's' of postpartum hemorrhage?", a: "1. <b>Tone</b> (uterine atony)<br>2. <b>Tissue</b> (retained placenta/clots)<br>3. <b>Trauma</b> (lacerations/inversion/rupture)<br>4. <b>Thrombin</b> (coagulopathy)" },
            { q: "What are the main risk factors for uterine atony?", a: "Uterine overdistension (polyhydramnios, multiples, macrosomia), prolonged labor, chorioamnionitis, and high parity." },
            { q: "What is the first-line medication for uterine atony, and what is its major side effect if given as a rapid IV bolus?", a: "<b>Oxytocin</b>; rapid IV bolus can cause severe <b>hypotension</b> and water intoxication/hyponatremia." },
            { q: "What is the mechanism of Methylergonovine (Methergine), and what is its primary contraindication?", a: "An ergot alkaloid that causes smooth muscle contraction; contraindicated in <b>hypertension</b> and <b>preeclampsia</b>." },
            { q: "What is Carboprost tromethamine (Hemabate), and what is its primary contraindication?", a: "A prostaglandin <b>$F_{2\\\\alpha}$</b> analog; contraindicated in patients with <b>asthma</b> (causes severe bronchospasm)." },
            { q: "What is the dosing and common routes of administration for Misoprostol (Cytotec) in PPH?", a: "<b>800 to 1000 mcg</b> administered rectally, buccally, or sublingually." },
            { q: "What are the common side effects of misoprostol?", a: "Transient <b>pyrexia</b> (fever) and <b>shivering/rigors</b>." },
            { q: "What is the role of Tranexamic Acid (TXA) in PPH management?", a: "An antifibrinolytic that reduces bleeding-related mortality when administered within <b>3 hours</b> of delivery." },
            { q: "What defines retained placenta, and what is the management?", a: "Failure to deliver the placenta within 30 minutes of birth; managed by manual extraction or curettage under anesthesia." },
            { q: "Define placenta accreta, increta, and percreta.", a: "<b>Accreta</b>: villi attach directly to myometrium;<br><b>Increta</b>: villi invade myometrium;<br><b>Percreta</b>: villi penetrate through myometrium and serosa (often into bladder)." },
            { q: "What is the primary risk factor for placenta accreta spectrum?", a: "Prior cesarean delivery combined with <b>placenta previa</b>." },
            { q: "What is a uterine inversion?", a: "A rare emergency where the uterine fundus collapses into the uterine cavity, turning inside out, often due to excessive cord traction on an unseparated placenta." },
            { q: "What is the immediate management for uterine inversion?", a: "<b>Manual replacement</b> of the uterine fundus (Johnson maneuver) before removing the placenta and before administering uterotonic agents." },
            { q: "What pharmacologic agents can be used to relax the uterus during uterine inversion replacement?", a: "Nitroglycerin, terbutaline, or halogenated inhalational anesthetics." },
            { q: "What is the purpose of an intrauterine balloon tamponade (e.g., Bakri balloon)?", a: "To exert hydrostatic pressure from within the uterine cavity to compress bleeding sinuses in uterine atony; it is filled with up to 500 mL of sterile fluid." },
            { q: "What is a B-Lynch suture?", a: "A surgical compression suture used during laparotomy that wraps around the uterus like suspenders to physically compress the anterior and posterior walls." },
            { q: "What is the surgical target for uterine artery ligation (O'Leary stitch)?", a: "Ligation of the uterine artery and its branches near the junction of the cervix and lower uterine segment." },
            { q: "What is the mechanism and risk of internal iliac (hypogastric) artery ligation?", a: "It reduces pelvic arterial pulse pressure; the main risk is accidental ligation of the <b>external iliac artery</b>, which compromises lower limb perfusion." },
            { q: "What is the definitive surgical management for postpartum hemorrhage when conservative medical and surgical therapies fail?", a: "<b>Emergency peripartum hysterectomy</b>." },
            { q: "What are the components of the standard bundle of intrauterine resuscitation maneuvers used for abnormal FHR patterns?", a: "Left lateral position change, intravenous fluid bolus, oxygen administration, discontinuation of oxytocin, and treatment of maternal hypotension or uterine tachysystole." }
          ]
        },
        {
          section: 'Obstetrics & Gynecology',
          topic: "Gynecological malignancies — cervical, uterine, ovarian",
          icon: "shield-alert",
          cards: [
            { q: "What is the USPSTF screening recommendation for cervical cancer in women aged 21 to 29?", a: "Cervical cytology (Pap smear) alone every <b>3 years</b>." },
            { q: "What are the three screening options recommended by the USPSTF for cervical cancer in women aged 30 to 65?", a: "Cervical cytology alone every <b>3 years</b>, high-risk HPV (hrHPV) testing alone every <b>5 years</b>, or co-testing (cytology + hrHPV) every <b>5 years</b>." },
            { q: "Under what conditions can cervical cancer screening be discontinued in women aged 65?", a: "Discontinued if there is <b>adequate prior screening</b> (3 consecutive negative cytology results or 2 consecutive negative co-tests/hrHPV tests within the last 10 years, with the most recent within 5 years) and no history of <b>CIN 2 or higher</b> in the past 25 years." },
            { q: "When is cervical cancer screening indicated for women who have undergone a total hysterectomy?", a: "Only if the hysterectomy was performed for <b>CIN 2 or higher</b> (screen for 25 years post-diagnosis) or cervical cancer. It is discontinued if the surgery was for benign disease and there is no history of high-grade dysplasia." },
            { q: "What is the cervical cancer screening guideline for immunocompromised patients (e.g., HIV-positive)?", a: "Initiated at onset of sexual activity or diagnosis (no later than age 21); screen with cytology annually for 3 years, then cytology alone or co-testing (if aged $\\\\ge 30$) every <b>3 years</b>." },
            { q: "Which high-risk HPV genotypes are responsible for approximately 70% of all cervical cancers worldwide?", a: "HPV genotypes <b>16</b> (most common in squamous cell carcinoma) and <b>18</b> (most common in adenocarcinoma)." },
            { q: "Which additional oncogenic HPV types, besides 16 and 18, are targeted by the 9-valent HPV vaccine?", a: "HPV types <b>31, 33, 45, 52, and 58</b>." },
            { q: "Which low-risk HPV genotypes are primarily associated with condyloma acuminata (genital warts)?", a: "HPV genotypes <b>6 and 11</b>." },
            { q: "What is the molecular mechanism of action of the HPV E6 oncoprotein?", a: "E6 binds to and promotes the ubiquitin-mediated degradation of the tumor suppressor protein <b>p53</b>, preventing apoptosis." },
            { q: "What is the molecular mechanism of action of the HPV E7 oncoprotein?", a: "E7 binds to and inactivates the retinoblastoma protein (<b>pRb</b>), releasing the <b>E2F</b> transcription factor and promoting cell cycle progression into the S phase." },
            { q: "What are the two major histological types of cervical cancer, and which is more common?", a: "<b>Squamous cell carcinoma</b> (approx. 70-80% of cases) and <b>adenocarcinoma</b> (approx. 20-25% of cases)." },
            { q: "What is the recommended workup for a Pap smear showing Atypical Glandular Cells (AGC) in a woman aged $\\\\ge 35$?", a: "<b>Colposcopy</b>, <b>endocervical curettage (ECC)</b>, and <b>endometrial biopsy (EMB)</b>." },
            { q: "What pathophysiology causes the acetowhite changes observed during colposcopy after applying 3-5% acetic acid?", a: "Acetic acid dehydrates cells; dysplastic cells have a high nuclear-to-cytoplasmic ratio and large amount of nuclear proteins, which <b>coagulate and reflect light</b>, appearing white." },
            { q: "What is mosaicism in the context of colposcopy, and what does it indicate?", a: "A pattern of abnormal capillaries forming polygonal tile-like structures on the cervix; it indicates neoangiogenesis and is characteristic of <b>higher-grade dysplastic lesions</b> (CIN II/III)." },
            { q: "What does punctuation during colposcopy represent histopathologically?", a: "The visual appearance of dilated capillary loops rising vertically to the epithelial surface, appearing as red dots; it suggests <b>moderate to severe dysplasia (CIN II/III)</b>." },
            { q: "What colposcopic vessel finding is most highly suspicious for invasive cervical carcinoma?", a: "<b>Atypical vessels</b> (irregular, horizontal, comma-shaped, corkscrew, or wastebasket-like vessels that lack normal branching)." },
            { q: "How are normal vs dysplastic cervical tissues differentiated using Schiller's test (Lugol's iodine)?", a: "Normal squamous cells contain glycogen and stain <b>dark brown</b> with iodine; glycogen-depleted dysplastic or cancerous cells do not take up the stain and remain <b>mustard-yellow/pale</b>." },
            { q: "What are the histologic criteria for Cervical Intraepithelial Neoplasia I (CIN I)?", a: "Mild dysplasia with cellular atypia and mitotic activity confined to the <b>lower one-third</b> of the squamous epithelial thickness." },
            { q: "What are the histologic criteria for Cervical Intraepithelial Neoplasia II (CIN II)?", a: "Moderate dysplasia with atypical cellular changes and mitotic figures extending into the <b>middle one-third</b> of the squamous epithelial thickness." },
            { q: "What are the histologic criteria for Cervical Intraepithelial Neoplasia III (CIN III)?", a: "Severe dysplasia or carcinoma in situ (CIS) with cytological atypia spanning the <b>upper one-third</b> or full thickness of the squamous epithelium." },
            { q: "What is the standard initial management for a biopsy-confirmed CIN I lesion in a 25-year-old patient with prior LSIL?", a: "<b>Observation</b> with repeat HPV testing or cytology in <b>1 year</b>, as regression rates are very high (approx. 60-80%)." },
            { q: "When is a Cold Knife Cone (CKC) preferred over a Loop Electrosurgical Excision Procedure (LEEP) for managing cervical lesions?", a: "When <b>adenocarcinoma in situ (AIS)</b> is suspected, microinvasive cancer is suspected, or the colposcopic examination is <b>unsatisfactory</b> (squamocolumnar junction not fully visualized)." },
            { q: "How is biopsy-confirmed CIN III managed during pregnancy?", a: "Managed with <b>colposcopy and cytology</b> no more frequently than every 10-12 weeks; treatment is deferred until 6-8 weeks postpartum unless invasive cancer is suspected." },
            { q: "What are the primary obstetric risks associated with excisional cervical procedures (LEEP/CKC)?", a: "<b>Cervical insufficiency</b> (incompetence) predisposing to preterm premature rupture of membranes (PPROM) and preterm birth, or <b>cervical stenosis</b>." },
            { q: "What defines a satisfactory colposcopic examination?", a: "The <b>entire squamocolumnar junction (SCJ)</b> and the margins of all identified cervical lesions are completely visualized." },
            { q: "What defines FIGO Stage I cervical cancer?", a: "Carcinoma strictly <b>confined to the cervix</b> (extension to the uterine corpus is disregarded)." },
            { q: "What are the criteria for FIGO Stage IA1 vs IA2 cervical cancer?", a: "<b>IA1</b>: Stromal invasion $< 3\\\\text{ mm}$ in depth. <b>IA2</b>: Stromal invasion $\\\\ge 3\\\\text{ mm}$ and $< 5\\\\text{ mm}$ in depth." },
            { q: "What are the criteria for FIGO Stage IB1, IB2, and IB3 cervical cancer?", a: "<b>IB1</b>: Invasion $\\\\ge 5\\\\text{ mm}$ depth and $< 2\\\\text{ cm}$ in maximum size; <b>IB2</b>: Size $\\\\ge 2\\\\text{ cm}$ and $< 4\\\\text{ cm}$; <b>IB3</b>: Size $\\\\ge 4\\\\text{ cm}$." },
            { q: "What defines FIGO Stage II cervical cancer?", a: "Carcinoma that invades <b>beyond the uterus</b> but has not extended to the pelvic wall or to the lower third of the vagina." },
            { q: "How are FIGO Stage IIA and Stage IIB cervical cancers differentiated?", a: "<b>IIA</b> involves the upper two-thirds of the vagina without parametrial invasion; <b>IIB</b> involves parametrial invasion." },
            { q: "What defines FIGO Stage III cervical cancer?", a: "Carcinoma extending to the <b>pelvic wall</b>, involving the <b>lower third of the vagina</b>, causing <b>hydronephrosis/non-functioning kidney</b>, or involving <b>pelvic/para-aortic lymph nodes</b>." },
            { q: "What defines FIGO Stage IV cervical cancer?", a: "Carcinoma extending <b>beyond the true pelvis</b> or invading the mucosa of the bladder or rectum (IVA), or distant metastasis (IVB)." },
            { q: "What is the standard treatment for FIGO Stage IA1 cervical cancer without lymphovascular space invasion (LVSI)?", a: "<b>Simple hysterectomy</b> (extrapleural/extrafascial), or <b>cervical conization</b> if the patient desires fertility preservation." },
            { q: "What is the preferred treatment for FIGO Stage IB1 or IIA1 cervical cancer in a patient who is a good surgical candidate?", a: "<b>Radical hysterectomy</b> (Type B/C, Wertheim's) with bilateral pelvic lymphadenectomy." },
            { q: "What is the primary treatment of choice for locally advanced cervical cancer (Stage IB3, IIB, III, or IVA)?", a: "<b>Concurrent chemoradiation</b> (external beam radiation therapy + brachytherapy + weekly <b>cisplatin-based chemotherapy</b>)." },
            { q: "What is the histological definition of endometrial hyperplasia?", a: "An abnormal proliferation of endometrial glands relative to stroma, resulting in an increased <b>gland-to-stroma ratio</b> (>50%)." },
            { q: "How does the Endometrial Intraepithelial Neoplasia (EIN) system classify endometrial hyperplasia?", a: "It simplifies classification into <b>Benign Endometrial Hyperplasia</b> (polyclonal, estrogen-driven) and <b>EIN / Atypical Hyperplasia</b> (monoclonal, premalignant)." },
            { q: "What are the four categories of endometrial hyperplasia under the 1994 WHO classification, and what are their approximate cancer progression rates?", a: "<b>Simple without atypia</b> (~1%), <b>complex without atypia</b> (~3%), <b>simple with atypia</b> (~8%), and <b>complex with atypia</b> (~29%)." },
            { q: "What is the long-term risk of progression to endometrial cancer for endometrial hyperplasia without atypia?", a: "Low, approximately <b>1% to 3%</b>." },
            { q: "What is the risk of progression to endometrial cancer for atypical endometrial hyperplasia (EIN) if left untreated?", a: "High, approximately <b>25% to 30%</b>; notably, up to 40% of patients have a concurrent undetected invasive cancer at hysterectomy." },
            { q: "What is the first-line medical therapy for endometrial hyperplasia without atypia?", a: "<b>Progestin therapy</b> (e.g., oral medroxyprogesterone acetate or a levonorgestrel-releasing IUD) followed by surveillance endometrial biopsy in 3-6 months." },
            { q: "What is the standard of care for atypical endometrial hyperplasia (EIN) in a postmenopausal woman?", a: "<b>Total hysterectomy with bilateral salpingo-oophorectomy (TH/BSO)</b>." },
            { q: "How is atypical endometrial hyperplasia managed in a premenopausal patient who strongly desires fertility preservation?", a: "Continuous high-dose oral progestins (e.g., <b>megestrol acetate</b>) or <b>LNG-IUD</b>, with endometrial biopsy every 3 months until regression, followed by immediate attempts to conceive once cleared." },
            { q: "How does obesity act as a major risk factor for the development of endometrial cancer?", a: "Adipose tissue contains the enzyme <b>aromatase</b>, which converts adrenal androstenedione into <b>estrone</b> (estrogen), causing chronic unopposed endometrial stimulation." },
            { q: "Why does tamoxifen therapy increase the risk of endometrial cancer?", a: "While tamoxifen is an estrogen antagonist in the breast, it acts as an <b>estrogen receptor agonist in the endometrium</b>, promoting glandular proliferation." },
            { q: "What gynecologic cancer screening is recommended for women with Lynch Syndrome (HNPCC), and at what age does it begin?", a: "Annual <b>endometrial biopsy</b> starting at age <b>30 to 35</b> (risk-reducing hysterectomy and bilateral salpingo-oophorectomy is recommended once childbearing is complete)." },
            { q: "Lynch Syndrome is caused by germline mutations in which DNA mismatch repair genes?", a: "<b>MLH1, MSH2, MSH6, and PMS2</b> (leading to microsatellite instability)." },
            { q: "What are the clinical and pathogenic differences between Type I and Type II endometrial cancers?", a: "<b>Type I (endometrioid)</b>: Estrogen-dependent, arises from hyperplasia, low-grade, good prognosis. <b>Type II (serous/clear cell)</b>: Estrogen-independent, arises in atrophic tissue, high-grade, p53 mutated, poor prognosis." },
            { q: "What is the diagnostic threshold for endometrial stripe thickness on transvaginal ultrasound (TVUS) in a postmenopausal woman with bleeding?", a: "An endometrial stripe <b>> 4 mm</b> requires tissue sampling via endometrial biopsy (EMB) to rule out malignancy." },
            { q: "What are the indications for performing an endometrial biopsy in a premenopausal patient?", a: "Abnormal uterine bleeding (AUB) in a patient aged <b>$\\\\ge 45$ years</b>, or AUB in a patient < 45 years with risk factors for unopposed estrogen (e.g., obesity, PCOS, chronic anovulation)." },
            { q: "If an endometrial biopsy is negative or insufficient in a postmenopausal patient with persistent vaginal bleeding, what is the next step?", a: "<b>Hysteroscopy with dilatation and curettage (D&C)</b> to obtain a definitive histological sample." },
            { q: "What is the classic histopathological finding of Type I endometrioid adenocarcinoma?", a: "Back-to-back crowded glands with <b>diminished intervening stroma</b>, cytological atypia, and loss of cellular polarity." },
            { q: "What histological feature and cellular structure are characteristic of uterine serous carcinoma?", a: "Papillary growth, high-grade nuclear atypia, prominent nucleoli, and the presence of <b>psammoma bodies</b> (laminated calcifications)." },
            { q: "Which tumor suppressor gene mutation is most frequently associated with Type I endometrioid adenocarcinoma?", a: "Loss-of-function mutation in the <b>PTEN</b> gene." },
            { q: "Which gene mutation is present in over 90% of uterine serous carcinomas (Type II)?", a: "<b>TP53</b> mutation (leading to p53 protein accumulation/overexpression)." },
            { q: "What defines FIGO Stage I uterine cancer?", a: "Tumor strictly <b>confined to the corpus uteri</b>." },
            { q: "What are the criteria for FIGO Stage IA vs IB uterine cancer?", a: "<b>IA</b>: Invasion of $< 50\\%$ of the myometrium. <b>IB</b>: Invasion of $\\\\ge 50\\%$ of the myometrium." },
            { q: "What defines FIGO Stage II uterine cancer?", a: "Tumor invades the <b>cervical stroma</b> but does not extend beyond the uterus." },
            { q: "What defines FIGO Stage III uterine cancer?", a: "Local and/or regional spread of the tumor (invasion of the uterine serosa, adnexa, vagina, parametrium, or pelvic/para-aortic lymph nodes)." },
            { q: "What are the definitions of FIGO Stage IIIA, IIIB, and IIIC endometrial cancer?", a: "<b>IIIA</b>: Invades serosa/adnexa; <b>IIIB</b>: Invades vagina/parametrium; <b>IIIC</b>: Metastasis to pelvic (IIIC1) or para-aortic (IIIC2) lymph nodes." },
            { q: "What defines FIGO Stage IV uterine cancer?", a: "Invasion of the bladder and/or bowel mucosa (IVA), or distant metastasis (IVB)." },
            { q: "What constitutes the standard surgical staging procedure for endometrial carcinoma?", a: "<b>Total extrafascial hysterectomy, bilateral salpingo-oophorectomy (TH/BSO)</b>, and pelvic/para-aortic lymphadenectomy or sentinel lymph node mapping." },
            { q: "What is the clinical value of Sentinel Lymph Node (SLN) mapping in endometrial cancer staging?", a: "Identifies the first draining lymph node(s) using a dye (e.g., indocyanine green) to detect micrometastases, reducing the risk of <b>lymphedema</b> compared to complete lymphadenectomy." },
            { q: "In which patients with Stage I endometrial cancer is adjuvant vaginal brachytherapy indicated?", a: "Patients with <b>high-intermediate risk</b> factors (e.g., age $\\\\ge 60$, deep myometrial invasion, lymphovascular space invasion [LVSI]) to reduce local recurrence at the vaginal cuff." },
            { q: "What is the primary treatment recommendation for Stage III or IV endometrial cancer, or high-risk histologies (serous/clear cell)?", a: "Systemic adjuvant <b>chemotherapy</b> (typically carboplatin and paclitaxel) $\\\\pm$ external beam radiation therapy." },
            { q: "What is a uterine carcinosarcoma (Malignant Mixed Müllerian Tumor [MMMT])?", a: "A highly aggressive metaplastic epithelial carcinoma that contains both malignant <b>epithelial</b> (carcinoma) and malignant <b>mesenchymal</b> (sarcoma) components." },
            { q: "What is the difference between homologous and heterologous sarcomatous components in uterine carcinosarcoma?", a: "<b>Homologous</b> components consist of tissues native to the uterus (e.g., stromal sarcoma); <b>heterologous</b> components contain tissues foreign to the uterus (e.g., rhabdomyosarcoma, chondrosarcoma)." },
            { q: "How does uterine leiomyosarcoma typically present clinically?", a: "Abnormal uterine bleeding, pelvic pain, and a <b>rapidly enlarging pelvic mass</b> in a postmenopausal woman." },
            { q: "What histological triad distinguishes uterine leiomyosarcoma from benign leiomyoma?", a: "1) <b>Coagulative tumor cell necrosis</b>, 2) <b>marked cellular atypia</b>, and 3) <b>high mitotic index</b> (usually $> 10$ mitoses per 10 HPFs)." },
            { q: "Why is power morcellation contraindicated in the management of a suspected leiomyosarcoma?", a: "It causes <b>intraperitoneal dissemination</b> of tumor fragments, which significantly worsens prognosis and upstages the disease." },
            { q: "What is the primary surgical management for uterine leiomyosarcoma?", a: "<b>Total hysterectomy</b> (bilateral salpingo-oophorectomy is performed, but lymphadenectomy is only needed if nodes are clinically enlarged)." },
            { q: "What are the lifetime risks of ovarian cancer associated with BRCA1 and BRCA2 germline mutations?", a: "Approximately <b>39-46%</b> for <b>BRCA1</b> and <b>12-20%</b> for <b>BRCA2</b>." },
            { q: "Which histopathological types of epithelial ovarian cancer are most associated with Lynch Syndrome?", a: "<b>Endometrioid</b> and <b>clear cell</b> adenocarcinoma." },
            { q: "What is the primary mechanism by which oral contraceptive pills (OCPs) reduce the risk of epithelial ovarian cancer?", a: "They prevent ovulation, thereby reducing <b>incessant ovulation-induced trauma</b> and inflammation to the ovarian surface epithelium." },
            { q: "Name three protective factors, other than OCPs, that decrease the risk of epithelial ovarian cancer.", a: "<b>Multiparity</b>, <b>breastfeeding</b>, and <b>bilateral salpingectomy</b> (or tubal ligation)." },
            { q: "What is the recommended age range for risk-reducing salpingo-oophorectomy (RRSO) in women with BRCA1 vs BRCA2 mutations?", a: "<b>BRCA1</b>: Age <b>35 to 40</b>; <b>BRCA2</b>: Age <b>40 to 45</b> (or once childbearing is complete)." },
            { q: "Which tumor marker is most commonly monitored in patients with epithelial ovarian cancer?", a: "<b>CA-125</b> (Cancer Antigen 125)." },
            { q: "What benign conditions can cause a false elevation of CA-125 in premenopausal women?", a: "<b>Endometriosis</b>, <b>uterine leiomyomas</b>, <b>pregnancy</b>, <b>pelvic inflammatory disease (PID)</b>, and normal menstruation." },
            { q: "Which tumor markers are typically elevated in patients with primary mucinous epithelial ovarian cancer?", a: "<b>CEA</b> (Carcinoembryonic Antigen) and <b>CA 19-9</b>." },
            { q: "Which tumor marker is classically elevated in dysgerminoma?", a: "<b>LDH</b> (Lactate Dehydrogenase)." },
            { q: "Which tumor marker is the hallmark of ovarian yolk sac (endodermal sinus) tumors?", a: "<b>AFP</b> (Alpha-Fetoprotein)." },
            { q: "Which tumor marker is secreted in high levels by non-gestational ovarian choriocarcinoma?", a: "<b>hCG</b> (Human Chorionic Gonadotropin)." },
            { q: "Which tumor marker is used to monitor granulosa cell tumors of the ovary?", a: "<b>Inhibin</b> (specifically Inhibin B) and estrogen." },
            { q: "What are the three main histogenetic categories of ovarian neoplasms?", a: "1) <b>Epithelial tumors</b>, 2) <b>Germ cell tumors</b>, and 3) <b>Sex cord-stromal tumors</b>." },
            { q: "What is the most common histopathological type of malignant epithelial ovarian cancer?", a: "<b>High-grade serous carcinoma</b>." },
            { q: "What is the current prevailing theory regarding the site of origin for high-grade serous ovarian cancer (HGSOC)?", a: "Arises from <b>Serous Tubal Intraepithelial Carcinoma (STIC)</b> lesions in the fimbria of the <b>fallopian tube</b>." },
            { q: "What is the characteristic histologic finding in serous ovarian carcinomas?", a: "<b>Psammoma bodies</b> (concentric, laminated calcified micro-concretions)." },
            { q: "Which clinical syndrome is characterized by mucinous ascites and is associated with ruptured mucinous tumors?", a: "<b>Pseudomyxoma peritonei</b>." },
            { q: "With which benign gynecologic disease is endometrioid ovarian cancer strongly associated?", a: "<b>Endometriosis</b> (often co-occurring with synchronous endometrioid endometrial cancer)." },
            { q: "What are the characteristic histologic features of clear cell carcinoma of the ovary?", a: "Glycogen-rich clear cells and <b>hobnail cells</b> (cells with protruding nuclei into the lumen)." },
            { q: "What type of epithelium is found in a Brenner tumor of the ovary?", a: "<b>Transitional epithelium</b> (urothelium) resembling bladder tissue, often with characteristic longitudinal nuclear grooves (coffee bean appearance)." },
            { q: "What is the purpose of obtaining pelvic washings during surgical staging for ovarian cancer?", a: "To detect microscopic malignant cells in the peritoneal fluid, which will upstage the disease from FIGO Stage IA/IB to <b>Stage IC</b>." },
            { q: "What is the definition of 'optimal debulking' (optimal cytoreduction) in ovarian cancer surgery?", a: "Surgical resection of all visible disease, leaving residual tumor nodules measuring <b>$< 1\\\\text{ cm}$</b> in maximum diameter." },
            { q: "What is the standard adjuvant chemotherapy regimen for advanced-stage epithelial ovarian cancer?", a: "Intravenous <b>carboplatin and paclitaxel</b> (usually 6 cycles)." },
            { q: "What is the mechanism of action and primary indication for Olaparib in ovarian cancer?", a: "It is a <b>PARP inhibitor</b> that blocks base excision repair, causing double-strand breaks that lead to cell death in homologous recombination-deficient (e.g., <b>BRCA1/2 mutated</b>) cells." },
            { q: "In which patient population do malignant ovarian germ cell tumors most commonly occur?", a: "Children, adolescents, and <b>young women aged < 30 years</b>." },
            { q: "Which malignant germ cell tumor is the ovarian counterpart to testicular seminoma?", a: "<b>Dysgerminoma</b>." },
            { q: "What is the histological presentation of an ovarian dysgerminoma?", a: "Sheets of large, round cells with clear cytoplasm and central nuclei, divided by fibrous septa infiltrated with <b>lymphocytes</b>." },
            { q: "What is the pathognomonic histological structure found in ovarian yolk sac tumors?", a: "<b>Schiller-Duval body</b> (a central capillary surrounded by connective tissue and lined by malignant epithelial cells, projecting into a space lined by tumor cells)." },
            { q: "What is the grading of an immature teratoma based on?", a: "The amount of <b>immature neuroectoderm</b> (neuroepithelium) present per low-power field." },
            { q: "What are the two trophoblastic cell types seen in choriocarcinoma, and what is notably absent?", a: "<b>Cytotrophoblasts</b> and <b>syncytiotrophoblasts</b>; there is a complete absence of <b>chorionic villi</b>." },
            { q: "What are the classic histological findings of granulosa cell tumors of the ovary?", a: "<b>Call-Exner bodies</b> (small follicles containing eosinophilic fluid) and cells with grooved <b>coffee-bean nuclei</b>." },
            { q: "How does a granulosa cell tumor classically present in a postmenopausal woman?", a: "With abnormal uterine bleeding or postmenopausal bleeding, due to <b>estrogen production</b> causing endometrial hyperplasia." },
            { q: "What is the clinical presentation of a granulosa cell tumor in a prepubertal girl?", a: "<b>Precocious puberty</b> (due to autonomous estrogen secretion by the tumor)." },
            { q: "What hormone is secreted by Sertoli-Leydig cell tumors, and what symptoms does it cause?", a: "<b>Testosterone</b> (androgens), causing rapid <b>virilization</b> (hirsutism, temporal balding, clitoromegaly, deepening of the voice)." },
            { q: "What is the characteristic diagnostic intracellular inclusion found in Sertoli-Leydig cell tumors?", a: "<b>Reinke crystals</b> (rod-shaped, eosinophilic cytoplasmic inclusions in Leydig cells)." },
            { q: "What is the classic triad of Meigs Syndrome?", a: "Ovarian <b>fibroma</b>, <b>ascites</b>, and <b>pleural effusion</b> (usually right-sided)." },
            { q: "Which ovarian stromal tumor is benign, composed of lipid-laden cells, and produces estrogen?", a: "<b>Thecoma</b>." },
            { q: "What is a Krukenberg tumor, and where does it most commonly originate?", a: "A metastatic signet-ring cell adenocarcinoma to the ovary, most commonly originating from the <b>stomach</b> (gastric cancer)." },
            { q: "What is the characteristic histological finding of a Krukenberg tumor?", a: "Mucin-filled <b>signet-ring cells</b> that displace the nucleus to the periphery, infiltrating the ovarian stroma." },
            { q: "What defines FIGO Stage I ovarian cancer?", a: "Tumor strictly <b>limited to one or both ovaries</b> or fallopian tubes." },
            { q: "What are the two distinct types of Vulvar Intraepithelial Neoplasia (VIN)?", a: "<b>Usual-type VIN (uVIN)</b> (HPV-associated) and <b>Differentiated VIN (dVIN)</b> (HPV-independent)." },
            { q: "What are the clinical characteristics and etiology of usual-type VIN (uVIN)?", a: "Associated with high-risk <b>HPV 16 and 18</b>, occurs in younger patients, often multifocal, and is strongly linked to smoking." },
            { q: "What are the clinical characteristics and etiology of differentiated VIN (dVIN)?", a: "HPV-independent, associated with <b>lichen sclerosus</b> or chronic inflammation, occurs in older patients, and has a high risk of rapid progression to squamous cell carcinoma." },
            { q: "What is the most common histological type of vulvar cancer?", a: "<b>Squamous cell carcinoma</b> (representing $\\\\ge 90\\\\%$ of cases)." },
            { q: "What are the two distinct etiologic pathways for vulvar squamous cell carcinoma?", a: "1) <b>HPV-mediated pathway</b> (younger women, smoking-related, usual VIN precursor). 2) <b>HPV-independent pathway</b> (older women, associated with lichen sclerosus, differentiated VIN precursor)." },
            { q: "What is the most common presenting symptom of vulvar cancer?", a: "Longstanding <b>vulvar pruritus</b> (itching), often accompanied by a visible plaque, ulcer, or mass on the labia." },
            { q: "What is the definition of extramammary Paget's disease of the vulva?", a: "An intraepithelial adenocarcinoma of the vulvar skin, characterized by malignant glandular cells within the squamous epidermis." },
            { q: "What is the classic visual appearance of Paget's disease of the vulva?", a: "A pruritic, well-demarcated, erythematous, eczematous lesion described as a <b>'fiery red background with white plaques'</b> ('strawberries and cream')." },
            { q: "What are the histopathological characteristics of vulvar Paget cells?", a: "Large, round cells with pale, mucin-rich cytoplasm, positive for <b>PAS</b> and <b>Mucicarmine</b> stains, and immunopositive for <b>CK7</b>." },
            { q: "How does the association with underlying malignancy differ between vulvar Paget's disease and mammary Paget's disease?", a: "Vulvar Paget's has a low association with underlying adenocarcinoma ($< 15\\\\%$), whereas mammary Paget's is almost always ($> 90\\\\%$) associated with an underlying ductal breast carcinoma." },
            { q: "What is Vaginal Intraepithelial Neoplasia (VaIN)?", a: "A premalignant squamous lesion of the vagina, highly associated with high-risk <b>HPV</b> infection, and often found concurrently with CIN or VIN." },
            { q: "In which anatomical area of the vagina is Vaginal Intraepithelial Neoplasia (VaIN) and vaginal cancer most commonly located?", a: "The <b>upper third</b> of the posterior vaginal wall." },
            { q: "What is the most common histopathological type of primary vaginal cancer?", a: "<b>Squamous cell carcinoma</b> (associated with high-risk HPV)." },
            { q: "Exposure in utero to which substance is associated with clear cell adenocarcinoma of the vagina and cervix?", a: "<b>Diethylstilbestrol (DES)</b> (prescribed to pregnant women in the 1940s-1970s)." },
            { q: "What structural anomalies of the female reproductive tract are associated with in utero DES exposure?", a: "<b>T-shaped uterus</b>, cervical collars, cockscomb cervix, and vaginal adenosis." },
            { q: "What is vaginal adenosis, and why is it clinically significant?", a: "The persistence of glandular columnar epithelium in the vagina (instead of squamous epithelium); it is a precursor to <b>clear cell adenocarcinoma</b>." },
            { q: "What is the primary treatment modality for Stage II or advanced primary vaginal cancer?", a: "<b>Radiation therapy</b> (combination of external beam radiotherapy and brachytherapy), as radical surgery is often anatomically challenging and disfiguring." },
            { q: "What is Sarcoma Botryoides (embryonal rhabdomyosarcoma), and how does it classically present?", a: "A highly malignant vaginal tumor of young girls (usually $< 5$ years old) presenting with vaginal bleeding and a <b>grape-like mass</b> protruding from the vagina." }
          ]
        },
        {
          section: 'Obstetrics & Gynecology',
          topic: "Benign gynecology — fibroids, endometriosis, PCOS",
          icon: "clipboard",
          cards: [
            { q: "What is the most common benign solid pelvic tumor in women?", a: "<b>Uterine leiomyoma</b> (fibroid), which is a monoclonal benign smooth muscle tumor." },
            { q: "From which cell type do uterine leiomyomas originate?", a: "Myometrial <b>smooth muscle cells</b> (myocytes)." },
            { q: "How does estrogen affect the growth of leiomyomas?", a: "Estrogen <b>stimulates</b> leiomyoma growth by upregulating progesterone receptor expression, which is the primary driver of proliferation." },
            { q: "How does progesterone affect the growth of leiomyomas?", a: "Progesterone acts as a key <b>growth promoter</b> of fibroids by stimulating cell proliferation and inhibiting apoptosis." },
            { q: "What is an intramural fibroid?", a: "A fibroid located <b>within the myometrium</b> wall; it may distort the uterine cavity if large." },
            { q: "What is a subserosal fibroid?", a: "A fibroid located <b>beneath the uterine serosa</b>, projecting outward from the outer surface of the uterus." },
            { q: "What is a submucosal fibroid?", a: "A fibroid located <b>beneath the endometrium</b>, projecting into the uterine cavity; it is the most likely type to cause menorrhagia." },
            { q: "What is a pedunculated fibroid?", a: "A fibroid attached to the uterus by a <b>pedicle or stalk</b>, which can occur either subserosally or submucosally." },
            { q: "What FIGO type classifies a submucosal fibroid that is entirely intracavitary?", a: "<b>FIGO Type 0</b> (pedunculated intracavitary fibroid)." },
            { q: "What FIGO type classifies a submucosal fibroid with less than 50% intramural extension?", a: "<b>FIGO Type 1</b> (distorts uterine cavity with less than 50% myometrial involvement)." },
            { q: "What FIGO type classifies a submucosal fibroid with 50% or more intramural extension?", a: "<b>FIGO Type 2</b> (distorts uterine cavity with $\\\\ge 50\\\\%$ myometrial involvement)." },
            { q: "What is the most common clinical presentation of symptomatic uterine fibroids?", a: "<b>Heavy menstrual bleeding (menorrhagia)</b>, particularly associated with submucosal or intramural fibroids." },
            { q: "What is the primary mechanism of menorrhagia in patients with submucosal fibroids?", a: "Increased endometrial <b>surface area</b>, altered local vascularity, and <b>impaired myometrial contractility</b>." },
            { q: "How can fibroids lead to bulk symptoms in the pelvis?", a: "Large fibroids exert pressure on the bladder (causing <b>urinary frequency/urgency</b>) or the rectosigmoid (causing <b>constipation</b>)." },
            { q: "What are the common pregnancy complications associated with fibroids?", a: "<b>Preterm labor</b>, fetal malpresentation, <b>placental abruption</b>, and postpartum hemorrhage." },
            { q: "What is red (carneous) degeneration of a fibroid?", a: "An acute aseptic necrosis occurring during <b>pregnancy</b> when a rapidly growing fibroid outgrows its blood supply, leading to hemorrhage and severe pain." },
            { q: "What is the clinical management for red degeneration of fibroids in pregnancy?", a: "<b>Conservative management</b> with analgesics (e.g., NSAIDs, acetaminophen) and bed rest; surgery is avoided during pregnancy." },
            { q: "What is the initial, most cost-effective imaging modality for diagnosing uterine fibroids?", a: "<b>Transvaginal ultrasound (TVUS)</b>." },
            { q: "When is saline infusion sonohysterography (SIS) indicated for fibroid workup?", a: "To evaluate the <b>degree of cavity distortion</b> caused by submucosal fibroids and differentiate them from endometrial polyps." },
            { q: "What is the role of pelvic MRI in fibroid management?", a: "Reserved for <b>complex cases</b> to map multiple fibroids prior to myomectomy, or to differentiate fibroids from adenomyosis or leiomyosarcoma." },
            { q: "What is the risk of a benign leiomyoma transforming into a leiomyosarcoma?", a: "Extremely low, estimated at <b>< 0.3%</b>; leiomyosarcomas generally arise <i>de novo</i> rather than from existing fibroids." },
            { q: "How do NSAIDs help in the medical management of fibroid symptoms?", a: "They <b>reduce menstrual blood loss</b> and alleviate pelvic pain by inhibiting endometrial prostaglandins (does not decrease tumor size)." },
            { q: "What is the mechanism of tranexamic acid in treating fibroid-induced menorrhagia?", a: "It is an <b>antifibrinolytic</b> that reversibly blocks lysine-binding sites on plasminogen, reducing bleeding by up to 50% without hormonal side effects." },
            { q: "How do GnRH agonists (e.g., leuprolide) work in treating fibroids?", a: "They cause an initial gonadotropin flare followed by <b>downregulation/desensitization of GnRH receptors</b>, causing hypogonadotropic hypogonadism that shrinks fibroids." },
            { q: "Why is GnRH agonist therapy limited to a maximum of 6 months without add-back therapy?", a: "To avoid long-term side effects of hypoestrogenism, specifically <b>bone mineral density loss</b> and severe vasomotor symptoms." },
            { q: "What is the mechanism of GnRH antagonists (e.g., elagolix) in fibroid management?", a: "They provide <b>immediate, dose-dependent suppression</b> of gonadotropins without the initial flare effect seen with GnRH agonists." },
            { q: "When is a myomectomy indicated instead of a hysterectomy for symptomatic fibroids?", a: "For patients who desire <b>future fertility</b> or wish to retain their uterus." },
            { q: "What is the main risk/complication of myomectomy regarding future deliveries?", a: "Increased risk of <b>uterine rupture during labor</b>, necessitating cesarean delivery if the myometrial cavity was entered." },
            { q: "What is uterine artery embolization (UAE) and its mechanism?", a: "A minimally invasive procedure where polyvinyl alcohol particles block the uterine arteries, causing <b>ischemic necrosis and shrinkage</b> of the fibroids." },
            { q: "What is a key contraindication to uterine artery embolization?", a: "Desire for <b>future fertility</b> (due to risk of ovarian failure or placental issues) and active pelvic infection." },
            { q: "What is the role of endometrial ablation in patients with fibroids?", a: "Used only for <b>small ($< 3\\\\text{ cm}$) submucosal fibroids</b> or intramural fibroids in patients who do not want fertility, to treat menorrhagia by destroying the endometrium." },
            { q: "What is the definition of endometriosis?", a: "The presence of <b>endometrial glands and stroma</b> outside the uterine cavity, most commonly on the pelvic peritoneum and ovaries." },
            { q: "What is Sampson's theory of retrograde menstruation?", a: "The theory that endometriosis is caused by the <b>retrograde flow of menstrual blood</b> through the fallopian tubes into the peritoneal cavity." },
            { q: "What is the coelomic metaplasia theory of endometriosis?", a: "The theory that multipotent <b>peritoneal mesothelial cells</b> undergo metaplasia into endometrial-like tissue." },
            { q: "What is the lymphatic/hematogenous dissemination theory (Halban's theory) of endometriosis?", a: "The theory that endometrial cells are transported via <b>blood vessels or lymphatics</b> to distant sites, explaining pleural or brain endometriosis." },
            { q: "What is the classic clinical triad of symptoms in endometriosis?", a: "<b>Dysmenorrhea</b> (painful menses), <b>dyspareunia</b> (painful intercourse), and <b>dyschezia</b> (painful defecation)." },
            { q: "What physical exam finding is highly suggestive of endometriosis?", a: "<b>Uterosacral ligament nodularity</b> or a <b>fixed, retroverted uterus</b> due to pelvic adhesions." },
            { q: "What is the gold standard for the definitive diagnosis of endometriosis?", a: "<b>Laparoscopy with direct visualization</b> and histopathological biopsy confirming endometrial glands and stroma." },
            { q: "What are 'powder-burn' or 'gunshot' lesions on laparoscopy?", a: "Dark brown or black <b>peritoneal implants</b> that represent old, encapsulated hemorrhages contained within fibrotic scar tissue." },
            { q: "What is an endometrioma, and what is its common nickname?", a: "A benign, estrogen-dependent cyst on the ovary filled with thick, dark-brown hemolyzed blood, commonly called a <b>'chocolate cyst.'</b>" },
            { q: "What is the classic ultrasound appearance of an endometrioma?", a: "A unilocular ovarian cyst with <b>homogeneous, low-level internal echoes</b> ('ground-glass' appearance)." },
            { q: "Why is CA-125 not used as a primary screening tool for endometriosis?", a: "Because it lacks specificity; CA-125 can be elevated in <b>endometriosis</b>, but also in PID, ovarian cancer, fibroids, pregnancy, and menstruation." },
            { q: "What is the first-line medical treatment for pelvic pain in suspected endometriosis?", a: "<b>NSAIDs combined with continuous oral contraceptive pills (OCPs)</b> or progestins to induce decidualization and atrophy of implants." },
            { q: "How does the levonorgestrel-releasing intrauterine system (LNG-IUS) help in endometriosis?", a: "It causes <b>local endometrial decidualization and atrophy</b>, significantly reducing dysmenorrhea and chronic pelvic pain." },
            { q: "What is the mechanism of danazol in endometriosis, and why is its use limited?", a: "It is an <b>androgen derivative</b> that suppresses LH/FSH and inhibits steroidogenic enzymes; it is limited by androgenic side effects (hirsutism, voice deepening, acne)." },
            { q: "What surgical approach is indicated for endometriosis in patients desiring fertility?", a: "<b>Laparoscopic excision or ablation</b> of endometrial implants and adhesiolysis to restore normal pelvic anatomy." },
            { q: "What is the definitive surgical treatment for endometriosis in patients who have completed childbearing?", a: "<b>Total hysterectomy with bilateral salpingo-oophorectomy (BSO)</b> and removal of all visible peritoneal implants." },
            { q: "What is the definition of adenomyosis?", a: "The presence of <b>endometrial glands and stroma</b> deep within the <b>myometrium</b>, accompanied by reactive myometrial hypertrophy." },
            { q: "What is the classic clinical presentation of adenomyosis?", a: "<b>Heavy menstrual bleeding (menorrhagia)</b> and <b>progressive dysmenorrhea</b> in a multiparous woman in her 30s or 40s." },
            { q: "What are the key physical exam findings in adenomyosis?", a: "A <b>symmetrically enlarged, globular, boggy, and tender uterus</b> (usually $< 12$ weeks size)." },
            { q: "What is the pathophysiological origin of adenomyosis?", a: "Invagination of the <b>endometrial basalis layer</b> into the myometrium, possibly due to disruption of the myometrial-endometrial interface." },
            { q: "How does the uterine tenderness in adenomyosis vary with the menstrual cycle?", a: "The uterus is most <b>tender immediately before and during menstruation</b> due to cyclic swelling and hemorrhage within the myometrium." },
            { q: "What is the classic transvaginal ultrasound finding of adenomyosis?", a: "<b>Asymmetric myometrial thickening</b>, myometrial cysts, and linear striations radiating from the endometrium." },
            { q: "What MRI finding is diagnostic of adenomyosis?", a: "A thickened uterine myometrial junctional zone (JZ) of <b>$> 12\\\\text{ mm}$</b>." },
            { q: "How do you distinguish a fibroid from adenomyosis on pelvic ultrasound?", a: "Fibroids are <b>well-circumscribed, hypoechoic masses</b> that displace vessels, whereas adenomyosis shows <b>diffuse, ill-defined infiltration</b> without distinct borders." },
            { q: "What is the gold standard for the definitive diagnosis of adenomyosis?", a: "<b>Histopathological examination</b> of the uterus after hysterectomy." },
            { q: "What is the first-line medical therapy for cycle and pain control in adenomyosis?", a: "<b>Levonorgestrel-releasing IUD (LNG-IUS)</b> or continuous OCPs/progestins to induce endometrial atrophy." },
            { q: "What is the definitive treatment for adenomyosis?", a: "<b>Hysterectomy</b> (preservation of ovaries is optional, as adenomyosis is confined to the myometrium)." },
            { q: "Can myomectomy be used to treat diffuse adenomyosis?", a: "<b>No</b>, because adenomyosis is diffusely infiltrative and lacks a surgical cleavage plane, making excision of diffuse disease impossible." },
            { q: "What is the relationship between parity and adenomyosis?", a: "Adenomyosis is most commonly diagnosed in <b>multiparous women</b>, whereas endometriosis is more common in <b>nulliparous women</b>." },
            { q: "What is the primary source of pain in adenomyosis?", a: "<b>Intramyometrial bleeding and swelling</b>, which stretches the myometrium and stimulates local prostaglandin production." },
            { q: "How does uterine artery embolization (UAE) perform in adenomyosis compared to fibroids?", a: "UAE is <b>less effective</b> long-term for adenomyosis compared to fibroids, with higher recurrence rates of symptoms." },
            { q: "What is the Rotterdam diagnostic criteria for PCOS?", a: "Diagnosis requires at least <b>two of three</b>: 1. Oligo/anovulation, 2. Clinical/biochemical hyperandrogenism, 3. Polycystic ovaries on ultrasound." },
            { q: "What other etiologies must be excluded before diagnosing PCOS?", a: "<b>Congenital adrenal hyperplasia (21-hydroxylase deficiency)</b>, hyperprolactinemia, thyroid dysfunction, and Cushing's syndrome." },
            { q: "What is the characteristic ultrasound definition of 'polycystic ovaries' under Rotterdam criteria?", a: "Presence of <b>$\\\\ge 12$ follicles</b> (often updated to $\\\\ge 20$) measuring 2-9 mm in diameter ('string of pearls'), or increased ovarian volume <b>$> 10\\\\text{ mL}$</b>." },
            { q: "How are LH and FSH secretion altered in PCOS?", a: "There is an increase in <b>GnRH pulse frequency</b>, leading to <b>elevated LH secretion</b> and relatively low or normal FSH secretion." },
            { q: "What is the typical LH to FSH ratio seen in patients with PCOS?", a: "An <b>$\\\\text{LH}:\\\\text{FSH}$ ratio $> 2:1$</b> or $3:1$ (highly suggestive, though not diagnostic)." },
            { q: "What role does hyperinsulinemia play in the pathogenesis of PCOS?", a: "Hyperinsulinemia <b>stimulates ovarian theca cells</b> to produce more androgens and <b>inhibits hepatic SHBG</b> synthesis, increasing free testosterone." },
            { q: "What is sex hormone-binding globulin (SHBG) and how is it altered in PCOS?", a: "SHBG binds circulating testosterone; in PCOS, it is <b>decreased</b> (primarily by insulin), leading to an increased fraction of active <b>free testosterone</b>." },
            { q: "Which ovarian cells produce androgens in response to LH stimulation?", a: "<b>Theca lutein cells</b> of the ovary." },
            { q: "Why does anovulation occur in PCOS despite multiple growing follicles?", a: "Relative <b>deficiency in FSH</b> prevents any single follicle from reaching dominance, leading to follicular arrest and chronic anovulation." },
            { q: "What is the clinical presentation of hyperandrogenism in PCOS?", a: "<b>Hirsutism</b> (excess terminal hair in male pattern), <b>recalcitrant acne</b>, and <b>androgenetic alopecia</b> (male-pattern baldness)." },
            { q: "What scoring system is used to evaluate the severity of hirsutism?", a: "The <b>Ferriman-Gallwey score</b>, which evaluates terminal hair in 9 body areas; a score <b>$\\\\ge 8$</b> indicates hirsutism." },
            { q: "How does chronic anovulation in PCOS manifest clinically?", a: "<b>Oligomenorrhea</b> (menstrual cycles $> 35$ days apart) or <b>amenorrhea</b>, often alternating with episodes of heavy, unpredictable bleeding." },
            { q: "What is the mechanism of metabolic syndrome in PCOS?", a: "<b>Insulin resistance</b> (independent of obesity) coupled with obesity, leading to dyslipidemia, hypertension, and glucose intolerance." },
            { q: "What percentage of patients with PCOS are obese?", a: "Approximately <b>50% to 60%</b> of PCOS patients are obese, which exacerbates insulin resistance." },
            { q: "What is acanthosis nigricans and its significance in PCOS?", a: "Velvety, hyperpigmented plaques on the neck or axillae, indicating severe <b>insulin resistance</b> and epidermal hyperplasia." },
            { q: "What is the first-line treatment for an overweight PCOS patient to restore ovulation?", a: "<b>Weight loss and exercise</b> (lifestyle modification); losing 5-10% of body weight can restore regular menses and ovulation." },
            { q: "What is the first-line medical therapy for cycle regulation and hirsutism in patients NOT desiring pregnancy?", a: "<b>Combined oral contraceptive pills (OCPs)</b>." },
            { q: "How do OCPs help treat hyperandrogenism in PCOS?", a: "Progestins suppress LH secretion (decreasing ovarian androgen production) and estrogens increase <b>hepatic SHBG synthesis</b> (lowering free testosterone)." },
            { q: "Why is a progestin-only method or cyclic progestins crucial if a PCOS patient refuses OCPs?", a: "To protect the endometrium from <b>unopposed estrogen</b> and prevent endometrial hyperplasia or cancer." },
            { q: "What is the first-line medication for ovulation induction in PCOS patients desiring fertility?", a: "<b>Letrozole</b> (an aromatase inhibitor), which has shown higher live birth rates than clomiphene in PCOS." },
            { q: "What is the mechanism of action of letrozole in ovulation induction?", a: "It inhibits estrogen synthesis, reducing negative feedback on the pituitary, which <b>increases endogenous FSH secretion</b> to stimulate follicular growth." },
            { q: "What is the mechanism of action of clomiphene citrate?", a: "A <b>selective estrogen receptor modulator (SERM)</b> that blocks estrogen receptors in the hypothalamus, preventing negative feedback and increasing gonadotropin release." },
            { q: "What is the role of metformin in the management of PCOS?", a: "An <b>insulin sensitizer</b> that decreases hepatic glucose production and increases peripheral insulin sensitivity; it helps restore ovulation and improves glucose tolerance." },
            { q: "What is the first-line medical therapy targeting hirsutism specifically, and how long does it take to work?", a: "<b>Spironolactone</b> (an androgen receptor antagonist); it takes <b>6 months</b> to see clinical effects due to the hair growth cycle." },
            { q: "Why must spironolactone always be paired with effective contraception in reproductive-age PCOS patients?", a: "Because it is a teratogen that can cause <b>feminization of a male fetus</b> due to its anti-androgen effects." },
            { q: "What other anti-androgen is sometimes used for hirsutism in PCOS but carries significant hepatotoxicity risk?", a: "<b>Flutamide</b> (a non-steroidal anti-androgen)." },
            { q: "What is eflornithine cream used for in PCOS?", a: "A topical cream that inhibits ornithine decarboxylase in hair follicles; used as an <b>adjuvant treatment for facial hirsutism</b>." },
            { q: "What is ovarian drilling and when is it used?", a: "A laparoscopic surgical procedure that uses heat or laser to puncture the ovarian stroma; used to induce ovulation in patients <b>resistant to medical therapy</b>." },
            { q: "What long-term gynecological cancer risk is highly associated with PCOS?", a: "<b>Endometrial carcinoma</b>, due to chronic unopposed estrogen stimulation of the endometrium." },
            { q: "Why is there NO increased risk of ovarian cancer associated with PCOS?", a: "Ovarian cancer risk is linked to incessant ovulation; PCOS patients undergo <b>fewer lifetime ovulations</b>, which is protective." },
            { q: "What metabolic screening is recommended for all women diagnosed with PCOS?", a: "A <b>2-hour oral glucose tolerance test (OGTT)</b> to screen for impaired glucose tolerance and Type 2 diabetes." },
            { q: "What cardiovascular risk factors are common in PCOS?", a: "<b>Atherogenic dyslipidemia</b> (low HDL, high triglycerides, high LDL), hypertension, and endothelial dysfunction, increasing long-term cardiovascular risk." },
            { q: "What is pelvic organ prolapse (POP)?", a: "The <b>herniation of pelvic organs</b> (bladder, uterus, vaginal vault, or bowel) into or through the vaginal canal due to support failure." },
            { q: "What is a cystocele?", a: "Prolapse of the bladder, resulting in hernia of the <b>anterior vaginal wall</b>." },
            { q: "What is a rectocele?", a: "Prolapse of the rectum, resulting in hernia of the <b>posterior vaginal wall</b>." },
            { q: "What is an enterocele?", a: "Prolapse of the small bowel and peritoneum, herniating into the <b>vaginal apex</b>, often between the rectum and vagina." },
            { q: "What is uterine prolapse?", a: "Descent of the <b>uterus and cervix</b> down into the vaginal canal toward or past the introitus." },
            { q: "What is vaginal vault prolapse?", a: "Descent of the <b>vaginal apex</b> following a hysterectomy." },
            { q: "What is the primary level of support for the vaginal apex and cervix?", a: "<b>Level I support (DeLancey)</b>, which is provided by the <b>uterosacral and cardinal ligaments</b>." },
            { q: "What provides Level II support for the vagina?", a: "<b>Paravaginal attachments</b> of the vagina to the arcus tendineus fasciae pelvis (white line) and levator ani." },
            { q: "What provides Level III support for the vagina?", a: "The <b>perineal body</b> and perineal membrane, supporting the distal third of the vagina." },
            { q: "What is the most significant risk factor for pelvic organ prolapse?", a: "<b>Vaginal childbirth (multiparity)</b>, which stretches and tears pelvic fascia and levator ani muscles." },
            { q: "What is the POP-Q system?", a: "The <b>Pelvic Organ Prolapse Quantification system</b>, an objective, site-specific system using 9 points of measurement relative to the hymen to stage prolapse." },
            { q: "What defines POP-Q Stage 0?", a: "<b>No prolapse</b>; all points are at their normal anatomical positions." },
            { q: "What defines POP-Q Stage I?", a: "The most distal point of prolapse is <b>$> 1\\\\text{ cm}$ above</b> the level of the hymen." },
            { q: "What defines POP-Q Stage II?", a: "The most distal point of prolapse is <b>$\\\\le 1\\\\text{ cm}$ above or below</b> the hymen." },
            { q: "What defines POP-Q Stage III?", a: "The most distal point of prolapse is <b>$> 1\\\\text{ cm}$ below</b> the hymen, but does not represent complete vaginal eversion." },
            { q: "What defines POP-Q Stage IV?", a: "<b>Complete eversion</b> of the total length of the lower genital tract." },
            { q: "What is a vaginal pessary?", a: "A removable <b>silicone device</b> inserted into the vagina to provide structural support for pelvic organ prolapse or urinary incontinence." },
            { q: "What is the primary surgical option for apical prolapse that suspends the apex to the sacral promontory?", a: "<b>Sacrocolpopexy</b>, using mesh to secure the vaginal vault to the longitudinal ligament of the sacrum." },
            { q: "What is a colpocleisis?", a: "An obliterative surgical procedure that <b>sews the vaginal walls together</b> to treat severe prolapse; suitable only for patients who do not desire future penetrative intercourse." },
            { q: "What is stress urinary incontinence (SUI)?", a: "Involuntary leakage of urine on <b>effort or physical exertion</b> (e.g., coughing, sneezing, laughing) due to increased intra-abdominal pressure." },
            { q: "What are the two primary pathophysiological mechanisms of stress urinary incontinence?", a: "1. <b>Urethral hypermobility</b> (weakness of pelvic floor support) and 2. <b>Intrinsic sphincter deficiency (ISD)</b> (loss of mucosal seal and sphincter tone)." },
            { q: "What is the Q-tip test and what does it assess?", a: "Insertion of a lubricated Q-tip into the urethra; an angle of deflection <b>$> 30^\\\\circ$</b> upon Valsalva indicates <b>urethral hypermobility</b>." },
            { q: "What is the first-line conservative management for stress urinary incontinence?", a: "<b>Pelvic floor muscle training (Kegel exercises)</b> with or without biofeedback to strengthen the levator ani." },
            { q: "What is the gold-standard surgical treatment for stress urinary incontinence due to urethral hypermobility?", a: "<b>Midurethral sling</b> (e.g., tension-free vaginal tape [TVT] or transobturator tape [TOT])." },
            { q: "What is the preferred surgical option for stress urinary incontinence caused by intrinsic sphincter deficiency (ISD) without hypermobility?", a: "<b>Urethral bulking agents</b>, which are injectable biomaterials used to increase mucosal coaptation." },
            { q: "What is urgency urinary incontinence (UUI)?", a: "Involuntary leakage of urine accompanied or immediately preceded by a <b>sudden, compelling desire to void (urgency)</b>." },
            { q: "What is the primary pathophysiological cause of urgency incontinence?", a: "<b>Detrusor muscle overactivity</b> (uninhibited detrusor contractions during the bladder filling phase)." },
            { q: "What is the first-line therapy for urgency urinary incontinence?", a: "<b>Behavioral therapy</b> (bladder training, timed voiding, fluid management, avoiding bladder irritants like caffeine)." },
            { q: "What class of medications is used as second-line treatment for urgency incontinence, and what is their mechanism?", a: "<b>Antimuscarinics (anticholinergics)</b> like oxybutynin or tolterodine, which block M3 muscarinic receptors on the detrusor muscle to inhibit contraction." },
            { q: "What is a common side effect of anticholinergics that limits their use, especially in elderly patients?", a: "Dry mouth, constipation, blurry vision, and <b>cognitive decline/confusion</b> due to central nervous system effects." },
            { q: "What is the mechanism of action of mirabegron in treating overactive bladder?", a: "A <b>$\\\\beta_3$-adrenergic agonist</b> that relaxes the detrusor muscle during the storage phase, increasing bladder capacity without anticholinergic side effects." },
            { q: "What is a key contraindication for the use of mirabegron?", a: "<b>Severe uncontrolled hypertension</b>, as it can increase blood pressure." },
            { q: "What is overflow urinary incontinence?", a: "Involuntary leakage of urine associated with <b>detrusor underactivity</b> or <b>bladder outlet obstruction</b>, leading to incomplete emptying and bladder overdistension." },
            { q: "What diagnostic finding on postvoid residual (PVR) volume indicates overflow incontinence?", a: "A PVR volume <b>$> 200\\\\text{ mL}$</b> (normal is typically $< 50\\\\text{ mL}$, and $< 100\\\\text{ mL}$ is acceptable in elderly)." },
            { q: "What are common causes of overflow incontinence in women?", a: "<b>Severe pelvic organ prolapse</b> (causing mechanical urethral obstruction) or neuropathy (e.g., diabetic neuropathy affecting detrusor function)." },
            { q: "What is the primary treatment for overflow incontinence due to detrusor underactivity?", a: "<b>Intermittent self-catheterization</b> or chronic indwelling catheterization." },
            { q: "What is mixed urinary incontinence?", a: "Involuntary leakage of urine associated with symptoms of <b>both stress and urgency</b> urinary incontinence." },
            { q: "How is mixed urinary incontinence managed clinically?", a: "Treat the <b>most bothersome symptom first</b> (usually starting with behavioral/medical therapy for urgency, followed by surgery for stress if needed)." }
          ]
        },
        {
          section: 'Obstetrics & Gynecology',
          topic: "Contraception & family planning",
          icon: "heart",
          cards: [
            { q: "What is the typical use versus perfect use failure rate of male condoms?", a: "<b>Typical use:</b> ~13% failure rate in the first year. <b>Perfect use:</b> ~2% failure rate." },
            { q: "What is the primary mechanism of action of male and female condoms?", a: "They act as a <b>mechanical barrier</b> that prevents semen from entering the vagina, and they are the only contraceptive method that provides protection against <b>STIs (including HIV)</b>." },
            { q: "What type of lubricants should be avoided with latex condoms and why?", a: "<b>Oil-based lubricants</b> (e.g., Vaseline, baby oil, butter) because they degrade latex, causing the condom to tear or slip." },
            { q: "Describe the diaphragm contraceptive method.", a: "A dome-shaped latex or silicone cup with a flexible rim that is inserted into the vagina to cover the cervix, acting as a physical barrier. It must be used with <b>spermicide</b>." },
            { q: "How long must a diaphragm remain in the vagina after intercourse?", a: "It must remain in place for at least <b>6 hours</b> after the last intercourse, but should not be left in for more than <b>24 hours</b> due to the risk of <b>Toxic Shock Syndrome (TSS)</b>." },
            { q: "What is the primary risk associated with leaving a diaphragm or cervical cap in the vagina for a prolonged period?", a: "<b>Toxic Shock Syndrome (TSS)</b>, a life-threatening toxin-mediated illness caused by <i>Staphylococcus aureus</i>." },
            { q: "Describe the cervical cap and how it differs from a diaphragm.", a: "A smaller silicone cup that fits snugly over the cervix by suction. It must be used with spermicide, can be left in place for up to <b>48 hours</b>, and is less effective in parous women than nulliparous women." },
            { q: "What is the primary mechanism of action of Combined Hormonal Contraceptives (COCs, patch, vaginal ring)?", a: "They <b>suppress ovulation</b> by inhibiting gonadotropin-releasing hormone (GnRH) and gonadotropins (LH and FSH), preventing the midcycle LH surge." },
            { q: "How does the estrogen component of COCs contribute to preventing pregnancy?", a: "It suppresses <b>FSH secretion</b> (preventing folliculogenesis) and stabilizes the endometrium to prevent breakthrough bleeding." },
            { q: "How does the progestin component of COCs contribute to preventing pregnancy?", a: "It suppresses <b>LH secretion</b> (preventing ovulation), <b>thickens cervical mucus</b> (blocking sperm penetration), and alters the endometrium to prevent implantation." },
            { q: "List three non-contraceptive benefits of Combined Oral Contraceptive Pills (COCPs).", a: "1. <b>Decreased risk</b> of ovarian and endometrial cancers.<br>2. Improvement in <b>acne and hirsutism</b>.<br>3. Reduction in menstrual blood loss and dysmenorrhea." },
            { q: "By what percentage does COCP use reduce the risk of endometrial cancer?", a: "By approximately <b>50%</b>, and this protective effect persists for up to 20 years after discontinuing use." },
            { q: "Why do COCPs improve acne and hirsutism?", a: "They increase <b>Sex Hormone-Binding Globulin (SHBG)</b> synthesis in the liver, which binds free testosterone and reduces circulating levels of active androgens." },
            { q: "What are the absolute contraindications to combined hormonal contraceptives (estrogen-containing)?", a: "1. Age <b>$\\\\ge 35$ and smoking $\\\\ge 15$ cigarettes/day</b>.<br>2. History of <b>DVT/PE</b>.<br>3. History of stroke or ischemic heart disease.<br>4. Uncontrolled <b>hypertension ($\\\\ge 160/100$)</b>.<br>5. Migraine <b>with aura</b>.<br>6. Current or history of <b>breast cancer</b>.<br>7. Active liver disease or cirrhosis." },
            { q: "Why is estrogen contraindicated in patients with migraine with aura?", a: "It significantly increases the risk of <b>ischemic stroke</b> (synergistic effect of migraine with aura and estrogen on stroke risk)." },
            { q: "Why are combined hormonal contraceptives avoided in the first 3-6 weeks postpartum?", a: "Due to the increased baseline risk of <b>venous thromboembolism (VTE)</b> postpartum, which is further elevated by the estrogen component." },
            { q: "What is the transdermal contraceptive patch (Ortho Evra / Xulane) and its dosing schedule?", a: "A patch containing estrogen and progestin applied weekly for <b>3 weeks</b>, followed by <b>1 patch-free week</b> for withdrawal bleeding." },
            { q: "What is a major limitation of the transdermal contraceptive patch regarding efficacy?", a: "It has decreased efficacy in women weighing <b>$\\\\ge 90$ kg (198 lbs)</b>." },
            { q: "What is the vaginal ring (NuvaRing) and its usage schedule?", a: "A flexible ring containing estrogen and progestin inserted into the vagina for <b>3 weeks</b>, then removed for <b>1 week</b> to allow for withdrawal bleeding." },
            { q: "What should a patient do if the vaginal ring falls out during the 3 weeks of active use?", a: "If out for <b>$< 3$ hours</b>, rinse with lukewarm water and reinsert (no backup needed). If out for <b>$> 3$ hours</b>, reinsert and use backup contraception for <b>7 days</b>." },
            { q: "What is the primary mechanism of action of the progestin-only pill (POP or minipill)?", a: "It primarily acts by <b>thickening cervical mucus</b> to prevent sperm entry. It does not consistently suppress ovulation (except in newer drospirenone-only formulations)." },
            { q: "What is the strict timing rule for taking the traditional norethindrone progestin-only pill (minipill)?", a: "It must be taken at the <b>exact same time every day</b>. If taken more than <b>3 hours late</b>, a backup contraceptive method must be used for the next <b>48 hours</b>." },
            { q: "Who are the primary candidates for progestin-only pills?", a: "Breastfeeding women, and women with contraindications to estrogen (e.g., smokers over 35, patients with hypertension or DVT history)." },
            { q: "Describe Depot Medroxyprogesterone Acetate (DMPA / Depo-Provera) and its dosing interval.", a: "A progestin-only injection administered intramuscularly or subcutaneously once every <b>3 months (12-13 weeks)</b>." },
            { q: "What is the primary mechanism of action of DMPA?", a: "It <b>suppresses ovulation</b> by blocking the LH surge, thickens cervical mucus, and causes endometrial thinning." },
            { q: "What are the common side effects of DMPA?", a: "Irregular spotting, amenorrhea (up to 50% after 1 year), <b>weight gain</b> (averaging 5-10 lbs), and a **delay in the return of fertility** (averaging 9-10 months)." },
            { q: "What is the FDA Black Box Warning associated with long-term DMPA use?", a: "Loss of <b>bone mineral density (BMD)</b>. Users should be advised to take adequate calcium and Vitamin D, and use beyond 2 years should be re-evaluated." },
            { q: "What is the subdermal contraceptive implant (Nexplanon)?", a: "A single-rod progestin-only implant inserted under the skin of the upper arm, releasing **etonogestrel**." },
            { q: "What is the duration of action of the subdermal contraceptive implant (Nexplanon)?", a: "Approved for **3 years** of continuous use." },
            { q: "What is the mechanism of action of Nexplanon?", a: "Suppresses ovulation, thickens cervical mucus, and prevents endometrial proliferation." },
            { q: "What is the most common side effect of Nexplanon that leads to discontinuation?", a: "<b>Unpredictable, irregular bleeding</b> or spotting." },
            { q: "What is the failure rate of the subdermal implant (Nexplanon)?", a: "Less than **0.05%** (it is the **most effective** reversible contraceptive method available)." },
            { q: "Define Long-Acting Reversible Contraception (LARC) and list the two main types.", a: "Contraceptive methods that require no user adherence and last for years. Types: **Intrauterine Devices (IUDs)** and the **Subdermal Implant**." },
            { q: "Name the two categories of Intrauterine Devices (IUDs) based on active components.", a: "1. <b>Levonorgestrel-releasing IUDs</b> (e.g., Mirena, Liletta, Kyleena, Skyla).<br>2. <b>Copper IUD</b> (Paragard)." },
            { q: "What is the duration of action of the Copper IUD (Paragard)?", a: "Approved for up to **10 years** (and highly effective up to 12 years)." },
            { q: "What is the mechanism of action of the Copper IUD?", a: "It causes a sterile local inflammatory reaction in the endometrium that is toxic to sperm and eggs, preventing fertilization." },
            { q: "What are the primary side effects of the Copper IUD?", a: "Increased **menstrual bleeding (menorrhagia)** and more painful menstrual cramps (**dysmenorrhea**)." },
            { q: "What is the duration of action of the 52mg Levonorgestrel IUD (Mirena/Liletta)?", a: "Approved for up to **8 years**." },
            { q: "What is the mechanism of action of the Levonorgestrel-releasing IUD?", a: "Thickens cervical mucus, causes endometrial decidualization and thinning (atrophy), and impairs sperm motility." },
            { q: "What is the common effect of LNG-IUDs on menstrual bleeding patterns over time?", a: "Initial irregular spotting, followed by a significant reduction in blood loss, with **amenorrhea** rates up to 30-50% at 1 year." },
            { q: "Which IUD is FDA-approved for the treatment of heavy menstrual bleeding (menorrhagia)?", a: "The **52mg Levonorgestrel IUD (Mirena)**." },
            { q: "What is the absolute contraindication for inserting any IUD?", a: "Active pelvic infection (e.g., **acute PID**, purulent cervicitis) or unexplained vaginal bleeding before diagnosis." },
            { q: "What should be done if a patient becomes pregnant with an IUD in place?", a: "Remove the IUD immediately if the strings are visible to reduce the risk of **spontaneous abortion** and **preterm labor**. First, rule out **ectopic pregnancy**." },
            { q: "Does the presence of an IUD increase the absolute risk of ectopic pregnancy?", a: "No. The overall risk is lower because the IUD is highly effective at preventing all pregnancies. However, if a pregnancy does occur, there is a **higher relative probability** that it is ectopic." },
            { q: "What is the risk of Pelvic Inflammatory Disease (PID) associated with IUD insertion?", a: "There is a small, transient increase in PID risk during the first **20 days** after insertion, related to the insertion procedure introducing vaginal flora into the uterus. The risk returns to baseline after 20 days." },
            { q: "What is IUD expulsion and its rate of occurrence?", a: "The IUD is partially or completely pushed out of the uterus. The expulsion rate is **2% to 10%**, most commonly occurring in the first year or immediately postpartum." },
            { q: "What is uterine perforation during IUD insertion and its frequency?", a: "The IUD is pushed through the uterine wall during insertion. Occurs in about **1 in 1000 insertions**, higher in breastfeeding women and those within 36 weeks postpartum." },
            { q: "Name the four emergency contraception methods in order of clinical efficacy.", a: "1. <b>Copper IUD</b> (most effective, >99%).<br>2. <b>Ulipristal acetate (Ella)</b>.<br>3. <b>Levonorgestrel (Plan B)</b>.<br>4. <b>Yuzpe method</b> (least effective, highest side effects)." },
            { q: "Within what timeframe must emergency contraception be administered to be effective?", a: "Within **120 hours (5 days)** of unprotected intercourse, though sooner is better for oral methods." },
            { q: "How does the Copper IUD work as emergency contraception?", a: "It prevents fertilization or implantation through its spermicidal inflammatory effect. It can be inserted up to **5 days** after intercourse and provides ongoing contraception." },
            { q: "What is the mechanism of action of Ulipristal acetate (Ella)?", a: "It is a **selective progesterone receptor modulator (SPRM)** that delays or inhibits ovulation even **after the LH surge has started** (effective up to 120 hours)." },
            { q: "What is the mechanism of action of Levonorgestrel (Plan B One-Step) for emergency contraception?", a: "It inhibits or delays ovulation by preventing the LH surge. It is **ineffective once the LH surge has begun** or after fertilization." },
            { q: "Within what timeframe is Levonorgestrel (Plan B) most effective?", a: "Within **72 hours (3 days)** of unprotected intercourse, though it has some efficacy up to 120 hours. Efficacy is reduced in women with **BMI > 25-30**." },
            { q: "What is the Yuzpe method of emergency contraception?", a: "Taking high doses of combined oral contraceptive pills containing ethinyl estradiol and levonorgestrel in two doses, 12 hours apart. Widespread side effect of severe nausea/vomiting." },
            { q: "What should a patient do if they vomit within 2 hours of taking oral emergency contraception?", a: "They must **repeat the dose** to ensure adequate hormone absorption." },
            { q: "Define permanent sterilization and list the two main types.", a: "Surgical methods designed to permanently prevent pregnancy. Types: **Bilateral tubal ligation** (female) and **Vasectomy** (male)." },
            { q: "What are the common surgical methods for bilateral tubal ligation?", a: "Salpingectomy (complete removal of the fallopian tubes - now preferred to reduce ovarian cancer risk), Pomeroy or Parkland ligation, silastic bands, or spring clips." },
            { q: "Why is complete salpingectomy preferred over partial tubal ligation?", a: "It significantly reduces the risk of **epithelial ovarian cancer**, which often originates in the fimbriated end of the fallopian tube." },
            { q: "What is the clinical significance of a pregnancy occurring after a tubal ligation?", a: "There is a **high risk of ectopic pregnancy** (up to 30% of failures are ectopic)." },
            { q: "Describe the vasectomy procedure and its mechanism.", a: "A minor outpatient procedure involving excision and occlusion of a segment of the **vas deferens**, preventing sperm from entering the ejaculate." },
            { q: "Is a vasectomy immediately effective?", a: "No. Sperm remain in the reproductive tract distal to the incision. The patient must use backup contraception until **semen analysis** confirms azoospermia (typically **3 months** or after **20 ejaculations**)." },
            { q: "How is a vasectomy reversal called and its success rate?", a: "Vasovasostomy. Success rate is variable (50-90%), depending on the time elapsed since the vasectomy; it is not guaranteed, so the procedure should be considered permanent." },
            { q: "What is the Pearl Index?", a: "A standard metric used to describe the efficacy of a contraceptive method, representing the number of unintended pregnancies per **100 woman-years** of exposure." },
            { q: "Which contraceptive method has the lowest typical-use Pearl Index (highest efficacy)?", a: "The **Subdermal Etonogestrel Implant (Nexplanon)** (Pearl Index ~0.05)." },
            { q: "How do anticonvulsants (like phenytoin, carbamazepine) affect COCP efficacy?", a: "They induce hepatic cytochrome P450 enzymes (specifically **CYP3A4**), increasing the metabolism of estrogen and progestins and **reducing contraceptive efficacy**." },
            { q: "Which antibiotic is proven to decrease the effectiveness of oral contraceptives?", a: "**Rifampin** (a potent inducer of hepatic enzymes). Standard short-course antibiotics (e.g., amoxicillin, doxycycline) do not significantly affect OCP efficacy." },
            { q: "What is the recommended delay before initiating estrogen-containing contraceptives in a non-breastfeeding postpartum patient?", a: "Delay for **21 days** if low risk for VTE, or **42 days** if high risk (due to postpartum hypercoagulability)." },
            { q: "When can a Copper IUD or LNG-IUD be inserted postpartum?", a: "Either **immediately after delivery (within 10 minutes of the placenta)**, or delayed until **4 to 6 weeks** postpartum (to allow for uterine involution and reduce expulsion risk)." },
            { q: "What contraceptive method is recommended immediately postpartum for a breastfeeding mother?", a: "The **Etonogestrel implant (Nexplanon)** or a **Progestin-only pill**, as progestin-only methods do not interfere with lactation." },
            { q: "What is the Lactational Amenorrhea Method (LAM) and its requirements?", a: "A natural contraceptive method for breastfeeding women. Requirements: **exclusive breastfeeding** (no formula, intervals <4h day / <6h night), **amenorrhea**, and infant **< 6 months** old." },
            { q: "What is the contraceptive patch's effect on estrogen exposure compared to COCPs?", a: "The patch results in higher steady-state estrogen concentrations and overall **higher systemic estrogen exposure (AUC)**, which may carry a slightly higher risk of thromboembolism." },
            { q: "What is the primary estrogen component in most combined oral contraceptive pills?", a: "**Ethinyl estradiol (EE)**, typically in doses ranging from 10 to 35 micrograms." },
            { q: "How do progestins differ across OCP generations?", a: "1st gen (norethindrone) is low potency; 2nd gen (levonorgestrel) is highly androgenic; 3rd gen (desogestrel, norgestimate) is less androgenic but has slightly higher DVT risk; 4th gen (drospirenone) is anti-androgenic." },
            { q: "What is Drospirenone and its unique properties?", a: "A 4th-generation progestin derived from spironolactone. It has **anti-androgenic** and **anti-mineralocorticoid** properties, reducing acne and water retention, but can cause **hyperkalemia**." },
            { q: "In which patients is drospirenone-containing OCP use contraindicated?", a: "Patients with renal insufficiency, hepatic dysfunction, or adrenal insufficiency (due to the risk of hyperkalemia)." },
            { q: "What is the mechanism of action of spermicides (typically Nonoxynol-9)?", a: "They are surfactants that disrupt the cell membrane of sperm, disabling or killing them." },
            { q: "What is a major safety concern with frequent use of Nonoxynol-9 spermicide?", a: "It causes vaginal mucosal irritation and micro-ulcerations, actually <b>increasing the risk of HIV transmission</b>." },
            { q: "Describe the contraceptive sponge.", a: "A polyurethane foam device containing nonoxynol-9 inserted over the cervix. It provides protection for up to 24 hours, must be left in place for 6 hours after sex, and has lower efficacy in parous women." },
            { q: "What is the Symptothermal Method of family planning?", a: "A fertility awareness-based method combining daily <b>basal body temperature (BBT)</b> monitoring with tracking of <b>cervical mucus changes</b>." },
            { q: "How does basal body temperature (BBT) change after ovulation?", a: "BBT rises by <b>0.4 to 0.8 degrees Fahrenheit</b> due to the thermogenic effect of <b>progesterone</b> secreted by the corpus luteum." },
            { q: "Describe cervical mucus changes during the fertile window.", a: "Under estrogen influence, mucus becomes clear, abundant, thin, and stretchy, resembling <b>raw egg whites (spinnbarkeit)</b> to facilitate sperm transport." },
            { q: "What are the US Medical Eligibility Criteria (US MEC) categories for contraceptive use?", a: "<b>Category 1:</b> No restriction.<br><b>Category 2:</b> Advantages generally outweigh risks.<br><b>Category 3:</b> Risks usually outweigh advantages.<br><b>Category 4:</b> Unacceptable health risk (absolute contraindication)." },
            { q: "According to US MEC, what category is COC use in a 36-year-old who smokes 20 cigarettes per day?", a: "<b>Category 4</b> (absolute contraindication). Age ≥35 + smoking ≥15 cigarettes/day carries unacceptable VTE and MI risk with estrogen-containing methods." },
            { q: "What US MEC category is the Copper IUD for a patient with Wilson disease?", a: "<b>Category 4.</b> Wilson disease causes impaired copper metabolism; a copper-releasing IUD could worsen copper toxicity." },
            { q: "What US MEC category is the LNG-IUD in a patient with current breast cancer?", a: "<b>Category 4.</b> Breast cancer is hormone-receptor positive in many cases; systemic progestin absorption from LNG-IUD is contraindicated." },
            { q: "What US MEC category is DMPA for a woman with multiple cardiovascular risk factors (smoking, diabetes, hypertension)?", a: "<b>Category 3.</b> DMPA may worsen lipid profiles and is not first-line, but it is not absolutely contraindicated like estrogen-containing methods (Category 4)." },
            { q: "What is the Quick Start method for initiating hormonal contraception?", a: "Starting the contraceptive method <b>on the day of the visit</b> (regardless of cycle day) after ruling out pregnancy. Backup contraception is used for <b>7 days</b>. This improves adherence compared to the traditional Sunday or first-day start." },
            { q: "What is the 'Sunday Start' method for COCPs?", a: "Beginning the first pill on the <b>first Sunday after menses onset</b>. Backup contraception is needed for the first 7 days. Advantage: withdrawal bleeding does not occur on weekends." },
            { q: "What is the 'First Day Start' method for COCPs?", a: "Starting the pill on <b>Day 1 of menstruation</b>. No backup contraception is needed as it aligns with the natural hormonal cycle." },
            { q: "What is extended-cycle or continuous OCP use?", a: "Taking active pills for <b>84 days</b> followed by 7 days of placebo (e.g., Seasonale/Seasonique), resulting in only <b>4 withdrawal bleeds per year</b>. Continuous use skips all placebos for amenorrhea." },
            { q: "What is the clinical benefit of extended-cycle OCP regimens?", a: "Reduces frequency of withdrawal bleeding, decreases menstrual-related symptoms (dysmenorrhea, menstrual migraines, endometriosis pain), and improves quality of life. <b>Breakthrough bleeding</b> is common initially but decreases over time." },
            { q: "What is the 'missed pill' rule for COCPs (one pill missed)?", a: "Take the missed pill <b>as soon as remembered</b> (even if it means taking two pills at once). No backup contraception needed." },
            { q: "What is the management if 2 or more consecutive active COCP pills are missed?", a: "Take the most recent missed pill ASAP, continue the pack, and use <b>backup contraception for 7 days</b>. If pills were missed in the <b>last week of active pills</b>, skip the placebo week and start a new pack immediately." },
            { q: "What is the relationship between COCPs and venous thromboembolism (VTE)?", a: "COCPs increase VTE risk <b>3-4 fold</b> (from ~1-5/10,000 to ~3-9/10,000 woman-years). Risk is highest in the <b>first 3-12 months</b> of use and with higher estrogen doses." },
            { q: "Which progestins carry the highest VTE risk?", a: "<b>3rd generation</b> (desogestrel, gestodene) and <b>4th generation</b> (drospirenone) carry a slightly higher VTE risk (~6-8/10,000) compared to <b>2nd generation</b> (levonorgestrel, ~4/10,000)." },
            { q: "How does obesity affect VTE risk with COCP use?", a: "Obesity (BMI ≥30) is an independent VTE risk factor. Combined with COCP use, the risk is <b>synergistically increased</b> (up to 10-fold compared to non-obese non-users)." },
            { q: "What is the effect of COCPs on blood pressure?", a: "Estrogen increases hepatic production of <b>angiotensinogen</b>, which can raise blood pressure. Blood pressure should be monitored, and COCPs are <b>Category 4</b> if BP is ≥160/100 mmHg." },
            { q: "What screening is required before initiating COCPs?", a: "<b>Blood pressure measurement</b> is the only required screening. A pelvic exam, Pap smear, and STI testing are NOT required before initiation (per CDC/ACOG guidelines)." },
            { q: "What is the effect of COCPs on the risk of ovarian cancer?", a: "COCPs reduce ovarian cancer risk by <b>40-50%</b> with 5+ years of use. Protection persists for <b>up to 30 years</b> after discontinuation. Mechanism: suppression of ovulation reduces epithelial trauma." },
            { q: "What is the Annovera vaginal ring and how does it differ from NuvaRing?", a: "Annovera is a reusable ring containing <b>segesterone acetate + ethinyl estradiol</b> that lasts for <b>1 full year (13 cycles)</b>. Unlike NuvaRing, it is washed and reinserted each cycle rather than discarded." },
            { q: "What is the Slynd pill and how does it differ from traditional POPs?", a: "Slynd contains <b>drospirenone 4mg</b> (a 4th-gen progestin). Unlike norethindrone POPs, it <b>consistently suppresses ovulation</b> and has a <b>24-hour missed pill window</b> (vs 3 hours for traditional POPs)." },
            { q: "What is the Phexxi contraceptive gel?", a: "A non-hormonal, on-demand vaginal gel containing <b>lactic acid, citric acid, and potassium bitartrate</b> that maintains vaginal pH at 3.5-4.5 to immobilize sperm. Applied <b>within 1 hour before intercourse</b>." },
            { q: "What are the indications for postcoital testing of emergency contraception efficacy?", a: "Postcoital testing is <b>NOT routinely recommended</b>. Follow-up includes a <b>pregnancy test</b> if menses are delayed by more than <b>1 week</b> after the expected date." },
            { q: "How does ulipristal acetate (Ella) interact with hormonal contraception?", a: "Ulipristal is a progesterone receptor modulator and may <b>reduce the efficacy of hormonal contraceptives</b>. Hormonal methods should not be started until <b>5 days after</b> taking ulipristal." },
            { q: "Can Plan B (levonorgestrel EC) and ulipristal (Ella) be taken together?", a: "<b>No.</b> They should not be combined. Ulipristal's progesterone-receptor modulating effect may antagonize levonorgestrel's action, reducing efficacy of both." },
            { q: "What is the typical-use failure rate of fertility awareness-based methods (FABMs)?", a: "Typical use failure rate: <b>12-24%</b> per year. Perfect use can be as low as 0.4-5% depending on the specific method (symptothermal being the most effective)." },
            { q: "What is the Standard Days Method (SDM) of family planning?", a: "Avoiding intercourse on days <b>8-19</b> of a regular menstrual cycle (26-32 days). Uses CycleBeads as a visual tracking tool. Not suitable for women with irregular cycles." },
            { q: "What is the Two-Day Method of family planning?", a: "A cervical mucus-based method where the patient asks: 'Did I notice secretions <b>today</b>?' and 'Did I notice secretions <b>yesterday</b>?' If 'yes' to either, avoid intercourse." },
            { q: "When can contraception be initiated after a first-trimester abortion?", a: "<b>Immediately.</b> All methods (including IUDs and implants) can be started on the same day as a first-trimester surgical or medical abortion." },
            { q: "When can an IUD be placed after a second-trimester abortion?", a: "IUD insertion can occur <b>immediately after</b> a second-trimester surgical abortion. However, <b>expulsion rates are higher</b> (~5-10%) compared to first-trimester insertion." },
            { q: "What is the effect of St. John's Wort on hormonal contraception?", a: "St. John's Wort is a potent <b>CYP3A4 inducer</b> that significantly reduces serum levels of estrogen and progestin, potentially causing <b>breakthrough bleeding and contraceptive failure</b>." },
            { q: "Which antiretroviral medications interact with hormonal contraceptives?", a: "<b>Protease inhibitors</b> (ritonavir, lopinavir) and <b>NNRTIs</b> (efavirenz, nevirapine) can significantly reduce or increase hormone levels via CYP3A4 modulation. DMPA and IUDs are preferred in these patients." },
            { q: "What is the World Health Organization (WHO) tiered effectiveness model?", a: "A framework ranking contraceptive methods by effectiveness:<br><b>Tier 1</b> (most effective): Implant, IUDs, sterilization (<1% failure).<br><b>Tier 2:</b> DMPA, COCs, patch, ring (6-12% typical failure).<br><b>Tier 3:</b> Condoms, diaphragm, FABMs (12-24% typical failure).<br><b>Tier 4:</b> Spermicide, withdrawal (18-28% typical failure)." },
            { q: "What is the withdrawal (coitus interruptus) method and its failure rate?", a: "The male partner withdraws the penis before ejaculation. <b>Typical use failure rate: ~20%.</b> Perfect use: ~4%. Failure is due to pre-ejaculatory fluid containing sperm and timing errors." },
            { q: "What counseling framework is recommended for contraceptive discussions?", a: "The <b>shared decision-making</b> model, emphasizing patient autonomy, reproductive justice, and informed consent. The provider presents options using a <b>tiered effectiveness</b> approach while respecting patient preferences." },
            { q: "What is reproductive coercion and its relevance to contraceptive counseling?", a: "Behaviors by a partner to maintain power and control over reproductive decisions (e.g., sabotaging contraception, pressuring pregnancy). Providers should screen for it and offer <b>discreet methods</b> (IUD, implant, DMPA)." },
            { q: "What is the contraceptive efficacy of breastfeeding alone (without meeting LAM criteria)?", a: "Without meeting all three LAM criteria, breastfeeding alone is <b>NOT a reliable contraceptive method</b>. Ovulation can return as early as <b>6 weeks postpartum</b>." },
            { q: "What is the difference between monophasic, biphasic, and triphasic OCPs?", a: "<b>Monophasic:</b> Same dose of estrogen and progestin in all active pills.<br><b>Biphasic:</b> Two different progestin doses across the cycle.<br><b>Triphasic:</b> Three different progestin (and sometimes estrogen) doses, mimicking physiologic hormone fluctuations." },
            { q: "What is a 'placebo week' in COCPs and what happens hormonally?", a: "The 7 inactive (hormone-free) pills at the end of a 28-day pack. The drop in exogenous hormones triggers <b>endometrial shedding</b> (withdrawal bleeding), which is <b>NOT a true menstrual period</b>." },
            { q: "What is the effect of COCPs on dysmenorrhea?", a: "COCPs reduce dysmenorrhea by <b>suppressing ovulation</b> (eliminating prostaglandin production from the corpus luteum) and causing <b>endometrial thinning</b> (less tissue to shed, fewer prostaglandins released)." },
            { q: "What hormonal contraceptives are FDA-approved for treating acne?", a: "Several COCPs: <b>Ortho Tri-Cyclen</b> (norgestimate), <b>Yaz</b> (drospirenone), <b>Estrostep</b> (norethindrone acetate), and <b>Beyaz</b> (drospirenone + levomefolate). All increase SHBG and reduce free testosterone." },
            { q: "What is the contraceptive sponge's failure rate in nulliparous vs parous women?", a: "<b>Nulliparous:</b> ~9% perfect use, ~12% typical use.<br><b>Parous:</b> ~20% perfect use, ~24% typical use. The cervical os is wider in parous women, reducing the sponge's barrier effectiveness." },
            { q: "What is the female condom (FC2) and its unique advantages?", a: "A polyurethane or nitrile pouch inserted into the vagina. Advantages: <b>can be inserted up to 8 hours before intercourse</b>, provides STI protection, and is <b>not affected by oil-based lubricants</b> (unlike latex male condoms)." },
            { q: "What is the role of levonorgestrel in the hormonal IUD vs in emergency contraception?", a: "In the <b>IUD</b>: local progestin effect (cervical mucus, endometrial atrophy) with minimal systemic absorption.<br>In <b>EC (Plan B)</b>: systemic dose to delay/inhibit ovulation by suppressing the LH surge." },
            { q: "What is the ACOG recommendation for LARC use in adolescents?", a: "ACOG recommends LARCs (IUDs and implants) as <b>first-line contraceptives for adolescents</b> due to superior efficacy, safety, and elimination of adherence issues. Nulliparity is NOT a contraindication." },
            { q: "Can IUDs be used in women who have never been pregnant (nulliparous)?", a: "<b>Yes.</b> Both copper and LNG-IUDs are safe and effective in nulliparous women. Smaller IUDs (Kyleena, Skyla) may be preferred for comfort, but all IUD types are US MEC Category 1-2." },
            { q: "What is the mechanism by which DMPA causes weight gain?", a: "DMPA stimulates <b>appetite centrally</b> and promotes <b>fat deposition</b>. It may also cause fluid retention. Average weight gain is <b>5-10 lbs</b> over the first year." },
            { q: "What is the return to fertility after stopping different contraceptive methods?", a: "<b>COCPs/patch/ring:</b> 1-3 months.<br><b>Implant:</b> Within weeks of removal.<br><b>IUD:</b> Immediate upon removal.<br><b>DMPA:</b> Delayed average <b>9-10 months</b> (up to 18 months)." }
          ]
        },
        {
          section: 'Obstetrics & Gynecology',
          topic: "Menstrual disorders & infertility basics",
          icon: "calendar",
          cards: [
            { q: "What is Abnormal Uterine Bleeding (AUB) by definition?", a: "Bleeding from the uterine corpus that is abnormal in volume, regularity, and/or timing, and has been present for most of the past 6 months." },
            { q: "What does the FIGO acronym PALM-COEIN stand for?", a: "<b>P</b>olyp, <b>A</b>denomyosis, <b>L</b>eiomyoma, <b>M</b>alignancy/hyperplasia, <b>C</b>oagulopathy, <b>O</b>vulatory dysfunction, <b>E</b>ndometrial, <b>I</b>atrogenic, and <b>N</b>ot yet classified." },
            { q: "In the FIGO classification, which categories represent structural anomalies vs. non-structural conditions?", a: "<b>PALM</b> represents structural anomalies (defined by imaging or histopathology); <b>COEIN</b> represents non-structural, functional, or systemic conditions." },
            { q: "What is AUB-P and what is its typical clinical presentation?", a: "AUB caused by endometrial polyps; typically presents as <b>intermenstrual bleeding</b> (spotting between periods) or postcoital spotting." },
            { q: "Which non-invasive imaging modality is most sensitive for differentiating endometrial polyps from general hyperplasia?", a: "<b>Saline infusion sonohysterography (SIS)</b> or transvaginal ultrasound (TVUS) with color Doppler showing a single feeding vessel." },
            { q: "What is the pathophysiology of Adenomyosis (AUB-A)?", a: "The benign invasion of endometrial glands and stroma into the myometrium, inducing hypertrophy and hyperplasia of the surrounding smooth muscle." },
            { q: "What is the classic clinical triad of symptoms associated with adenomyosis (AUB-A)?", a: "<b>Heavy menstrual bleeding</b> (menorrhagia), severe <b>dysmenorrhea</b> (painful periods), and a symmetrically enlarged, boggy, tender uterus." },
            { q: "What are the characteristic MRI findings of adenomyosis?", a: "A thickened myometrial junctional zone (JZ) exceeding $\\\\ge 12$ mm, along with small hyperintense myometrial cysts on T2-weighted imaging." },
            { q: "What are leiomyomas (AUB-L), and how are they primary categorized by location?", a: "Benign smooth muscle tumors (fibroids) of the myometrium; classified as <b>submucosal</b> (distorting the endometrial cavity) or <b>other</b> (intramural, subserosal)." },
            { q: "Which FIGO subclassification of leiomyoma is most strongly associated with heavy bleeding and pregnancy loss?", a: "<b>Submucosal leiomyomas</b> (FIGO types 0, 1, and 2), which directly distort the endometrial cavity." },
            { q: "What is the primary neoplastic etiology of AUB-M, and what is its precursor lesion?", a: "<b>Endometrial carcinoma</b>, which typically arises from <b>atypical endometrial hyperplasia</b> (also known as endometrial intraepithelial neoplasia)." },
            { q: "What are the key risk factors for developing atypical endometrial hyperplasia and carcinoma (AUB-M)?", a: "Conditions of <b>unopposed estrogen</b>: obesity, chronic anovulation (PCOS), early menarche, late menopause, nulliparity, tamoxifen therapy, or estrogen-only hormone therapy." },
            { q: "What is the most common inherited bleeding disorder causing coagulopathy-related abnormal uterine bleeding (AUB-C)?", a: "<b>von Willebrand disease (vWD)</b>, which features a deficiency or dysfunction of von Willebrand factor." },
            { q: "According to FIGO/ACOG, what screening history suggests a coagulopathy (AUB-C) in a patient with heavy menstrual bleeding?", a: "Heavy menses since menarche, postpartum hemorrhage, surgery-related bleeding, dental bleeding, or two of: bruising, epistaxis, gum bleeding, or family history of bleeding." },
            { q: "How does ovulatory dysfunction (AUB-O) lead to irregular, heavy bleeding?", a: "Anovulation prevents corpus luteum formation and progesterone production; unopposed estrogen causes continuous endometrial proliferation until it outgrows its blood supply, causing irregular <b>estrogen breakthrough bleeding</b>." },
            { q: "Which endocrine disorders must be routinely ruled out in the workup of ovulatory dysfunction (AUB-O)?", a: "<b>Hypothyroidism</b> (TSH), <b>hyperprolactinemia</b> (Prolactin), and <b>Polycystic Ovary Syndrome (PCOS)</b>." },
            { q: "What is the mechanism behind primary endometrial dysfunction (AUB-E) in a patient with regular, heavy menses?", a: "Local endometrial vasoconstrictor deficiencies (e.g., endothelin-1, prostaglandin $F_{2\\\\alpha}$) and/or accelerated clot lysis (increased tissue plasminogen activator)." },
            { q: "What are common pharmacological and mechanical causes of iatrogenic abnormal uterine bleeding (AUB-I)?", a: "Anticoagulants, copper IUDs (which increase local inflammation), levonorgestrel-releasing IUDs (causing breakthrough spotting in first 3-6 months), and tamoxifen." },
            { q: "What type of conditions fall under the 'Not yet classified' (AUB-N) category of FIGO?", a: "Rare or poorly defined conditions, such as <b>arteriovenous malformations (AVMs)</b>, myometrial hypertrophy, or chronic endometritis." },
            { q: "What is the initial imaging modality of choice for evaluating abnormal uterine bleeding?", a: "<b>Transvaginal pelvic ultrasound (TVUS)</b>." },
            { q: "When is saline-infusion sonohysterography (SIS) indicated over standard transvaginal ultrasound in AUB?", a: "To better delineate intracavitary lesions (such as distinguishing submucosal fibroids from polyps) and evaluate the endometrium when TVUS shows focal thickening." },
            { q: "What is the diagnostic and therapeutic role of hysteroscopy in AUB?", a: "It allows direct visualization of the endometrial cavity (gold standard for diagnosing polyps/fibroids) and facilitates targeted biopsy or resection." },
            { q: "At what age is an endometrial biopsy automatically indicated for any patient presenting with AUB?", a: "Age <b>45 years or older</b>." },
            { q: "In women under 45, what clinical scenarios require an endometrial biopsy for AUB?", a: "Unopposed estrogen exposure (e.g., obesity, PCOS), failed medical management of bleeding, or persistent intermenstrual bleeding." },
            { q: "In a postmenopausal woman with AUB, what transvaginal ultrasound endometrial thickness threshold warrants a biopsy?", a: "An endometrial thickness of <b>$> 4$ mm</b> (or if the endometrium cannot be fully visualized)." },
            { q: "What endometrial thickness threshold warrants biopsy in an asymptomatic postmenopausal woman (without AUB)?", a: "<b>$> 8$ mm</b>, although clinical judgment and individual risk factors dictate intervention." },
            { q: "What is the first-line non-surgical medical option to control acute, heavy, non-hemodynamically unstable AUB?", a: "High-dose oral estrogens, multi-dose combined oral contraceptives (COCs), or oral <b>tranexamic acid</b>." },
            { q: "What is the mechanism of action of tranexamic acid, and what is its primary contraindication in AUB?", a: "It is an <b>antifibrinolytic</b> that reversibly blocks lysine-binding sites on plasminogen; contraindicated in active thromboembolic disease or history of DVT/PE." },
            { q: "Why is the Levonorgestrel-releasing intrauterine system (LNG-IUS) highly effective for chronic AUB-O and AUB-E?", a: "It delivers local progestin directly to the endometrium, causing profound decidualization and endometrial atrophy, reducing menstrual blood loss by up to 90%." },
            { q: "What is the preferred initial medical treatment for dysmenorrhea and heavy bleeding in adenomyosis?", a: "<b>Levonorgestrel-releasing IUD (LNG-IUS)</b> or continuous combined oral contraceptives; NSAIDs are used for acute pain control." },
            { q: "What is the only definitive treatment for adenomyosis?", a: "<b>Hysterectomy</b>." },
            { q: "What is the mechanism and a major contraindication of uterine artery embolization (UAE) for uterine fibroids?", a: "It obstructs blood flow to the uterus, causing ischemic necrosis of fibroids; a major contraindication is the <b>desire for future pregnancy</b>." },
            { q: "What is the preferred surgical intervention for submucosal fibroids in women desiring future fertility?", a: "<b>Hysteroscopic myomectomy</b>." },
            { q: "What is the preferred surgical intervention for intramural fibroids in women desiring future fertility?", a: "<b>Abdominal or laparoscopic myomectomy</b>." },
            { q: "Which drug class is commonly used to reduce fibroid size and uterine volume prior to planned surgery?", a: "<b>GnRH agonists</b> (e.g., leuprolide acetate), which induce a hypoestrogenic state." },
            { q: "What are the primary long-term risks of GnRH agonist therapy, and how are they mitigated?", a: "Bone mineral density loss and vasomotor symptoms (hot flashes); mitigated by <b>'add-back' therapy</b> (low-dose estrogen and progestin) if used for $> 6$ months." },
            { q: "What is the most common cause of irregular, heavy cycles (AUB-O) in the first 1-2 years after menarche?", a: "<b>Hypothalamic-pituitary-ovarian (HPO) axis immaturity</b>, leading to a lack of LH surges and chronic anovulation." },
            { q: "What is the physiological mechanism of AUB-O during the perimenopausal transition?", a: "Declining oocyte quality and quantity lead to fluctuating estrogen levels, erratic follicular development, and frequent anovulatory cycles." },
            { q: "What is the Rotterdam criteria used to diagnose Polycystic Ovary Syndrome (PCOS)?", a: "Diagnosis requires at least 2 of: (1) oligo- or anovulation, (2) clinical or biochemical hyperandrogenism, (3) polycystic ovaries on ultrasound ($\\\\ge 12$ follicles of 2-9 mm or volume $> 10$ mL)." },
            { q: "Why are patients with PCOS at an increased risk of endometrial hyperplasia and adenocarcinoma?", a: "Chronic anovulation leads to continuous, unopposed estrogen stimulation of the endometrium without the protective, differentiating effects of progesterone." },
            { q: "What is the first-line pharmacotherapy for regulating menses and protecting the endometrium in PCOS patients not desiring pregnancy?", a: "<b>Combined oral contraceptives (COCs)</b>." },
            { q: "What is the mechanism of spironolactone in treating hirsutism in PCOS, and what precaution must be taken?", a: "It is an aldosterone antagonist and <b>androgen receptor blocker</b>; it is teratogenic (causes feminization of male fetuses), so reliable contraception (like COCs) is required." },
            { q: "How does hypothyroidism cause ovulatory dysfunction and irregular menses?", a: "Low thyroid hormone levels stimulate TRH release, which increases both TSH and <b>prolactin</b>. Elevated prolactin inhibits GnRH pulsatility, leading to anovulation." },
            { q: "What initial laboratory tests should be ordered if coagulopathy (AUB-C) is suspected?", a: "CBC (platelet count), prothrombin time (PT), activated partial thromboplastin time (aPTT), von Willebrand factor (vWF) antigen, and Ristocetin cofactor activity." },
            { q: "How is endometrial dysfunction (AUB-E) diagnosed in clinical practice?", a: "It is a <b>diagnosis of exclusion</b> in women with regular, heavy menses and no identifiable structural, coagulopathic, or other systemic causes." },
            { q: "What is the clinical definition of primary amenorrhea?", a: "The absence of menarche by <b>age 15</b> in the presence of normal secondary sexual characteristics, OR by <b>age 13</b> in the absence of secondary sexual characteristics." },
            { q: "What is the clinical definition of secondary amenorrhea?", a: "The absence of menses for <b>3 consecutive months</b> in a woman with previously regular cycles, OR for <b>6 consecutive months</b> in a woman with previously irregular cycles." },
            { q: "What is the absolute first diagnostic step in evaluating both primary and secondary amenorrhea?", a: "A <b>urine or serum beta-hCG test</b> to rule out pregnancy." },
            { q: "What physical exam and imaging findings guide the initial diagnostic algorithm for primary amenorrhea?", a: "The presence or absence of <b>breast development</b> (reflecting estrogen exposure) and the presence of a <b>uterus</b> on pelvic ultrasound." },
            { q: "In primary amenorrhea, if breast development is present but the uterus is absent on ultrasound, what are the two main differential diagnoses?", a: "<b>Müllerian agenesis</b> (Mayer-Rokitansky-Küster-Hauser syndrome) and <b>Androgen Insensitivity Syndrome (AIS)</b>." },
            { q: "In primary amenorrhea, if breasts are absent but a uterus is present, what is the next diagnostic step?", a: "Measure serum <b>FSH</b> and <b>LH</b> to differentiate hypergonadotropic hypogonadism from hypogonadotropic hypogonadism." },
            { q: "What does an elevated FSH level ($> 20-40$ IU/L) in a primary amenorrhea patient with an intact uterus and absent breasts indicate?", a: "<b>Hypergonadotropic hypogonadism</b> due to gonadal dysgenesis or ovarian failure (e.g., Turner syndrome)." },
            { q: "What does a low or normal FSH level in a primary amenorrhea patient with an intact uterus and absent breasts indicate?", a: "<b>Hypogonadotropic hypogonadism</b> due to hypothalamic or pituitary failure (e.g., Kallmann syndrome, severe stress/exercise, HPO axis delay)." },
            { q: "What is the classic karyotype of Turner syndrome?", a: "<b>45,XO</b> (gonadal dysgenesis)." },
            { q: "What are the classic physical exam findings of Turner syndrome?", a: "Short stature, webbed neck (pterygium colli), shield chest with widely spaced nipples, low-set ears, and cubitus valgus." },
            { q: "What cardiac and renal anomalies are most commonly associated with Turner syndrome?", a: "<b>Coarctation of the aorta</b>, bicuspid aortic valve, and <b>horseshoe kidney</b>." },
            { q: "What is the characteristic histologic description of ovaries in Turner syndrome?", a: "<b>Streak ovaries</b> (fibrous stromal tissue devoid of follicles)." },
            { q: "What is the karyotype and hormone profile of a patient with Müllerian agenesis (MRKH)?", a: "<b>46,XX</b> with normal female-range testosterone and estrogen levels." },
            { q: "What anatomical reproductive structures are absent or hypoplastic in Müllerian agenesis (MRKH) syndrome?", a: "The uterus, cervix, and upper two-thirds of the vagina; the ovaries are intact and functional, leading to normal secondary sex characteristics." },
            { q: "What non-reproductive organ systems must be imaged in a patient diagnosed with Müllerian agenesis (MRKH)?", a: "The <b>renal system</b> (renal ultrasound to check for unilateral renal agenesis or ectopia) and the <b>skeletal system</b> (spinal X-rays)." },
            { q: "What is the karyotype and genotype of a patient with Androgen Insensitivity Syndrome (AIS)?", a: "<b>46,XY</b>." },
            { q: "What is the underlying molecular defect in Androgen Insensitivity Syndrome (AIS)?", a: "A mutation in the <b>androgen receptor gene</b>, rendering target tissues completely unresponsive to testosterone and dihydrotestosterone (DHT)." },
            { q: "Describe the physical appearance of a patient with complete Androgen Insensitivity Syndrome (AIS).", a: "Phenotypically female with normal breast development (due to peripheral conversion of testosterone to estrogen), absent/sparse axillary and pubic hair, a blind-vaginal pouch, and absent uterus." },
            { q: "Where are the testes located in AIS, and why must they be removed?", a: "Intra-abdominally or in the inguinal canals; they must be removed (gonadectomy) to prevent malignant transformation (gonadoblastoma/dysgerminoma)." },
            { q: "When should gonadectomy be performed in a patient with complete Androgen Insensitivity Syndrome (AIS)?", a: "<b>After puberty</b> (late adolescence) to allow natural breast development and growth via estrogen derived from peripheral conversion of testicular androgens." },
            { q: "How do serum testosterone levels differ between Müllerian agenesis (MRKH) and Androgen Insensitivity Syndrome (AIS)?", a: "MRKH patients have normal female-range testosterone; AIS patients have normal male-range testosterone levels." },
            { q: "What is the genetic and developmental cause of Kallmann syndrome?", a: "Defective migration of <b>GnRH-producing neurons</b> and olfactory neurons from the olfactory placode to the hypothalamus." },
            { q: "What unique non-reproductive symptom distinguishes Kallmann syndrome from other forms of hypogonadotropic hypogonadism?", a: "<b>Anosmia</b> or hyposmia (complete or partial loss of smell)." },
            { q: "What is the karyotype and clinical presentation at birth vs. puberty of 5-alpha-reductase deficiency?", a: "<b>46,XY</b>; presents with ambiguous genitalia at birth, but undergoes virilization at puberty (voice deepening, muscle mass, phallic growth) due to high testosterone levels." },
            { q: "What enzyme is deficient in 5-alpha-reductase deficiency, and what is its role?", a: "5-alpha-reductase, which converts testosterone to the more potent androgen <b>dihydrotestosterone (DHT)</b>, responsible for external male genital development." },
            { q: "Following a negative hCG, what three laboratory hormones should be measured next in secondary amenorrhea?", a: "<b>TSH</b>, <b>Prolactin</b>, and <b>FSH</b>." },
            { q: "What is the primary purpose of the progesterone challenge (withdrawal) test?", a: "To assess the presence of endogenous estrogen priming the endometrium and the patency of the outflow tract." },
            { q: "How is the progesterone challenge test performed?", a: "Administer oral medroxyprogesterone acetate (10 mg daily) or micronized progesterone for 7–10 days, then withdraw the medication and observe for bleeding." },
            { q: "What does a positive withdrawal bleed (bleeding within 2-7 days after stopping progesterone) indicate?", a: "The patient is <b>anovulatory</b> (AUB-O/PCOS), has adequate endogenous estrogen to proliferate the endometrium, and has a patent outflow tract." },
            { q: "What does a negative withdrawal bleed (no bleeding) indicate in the progesterone challenge test?", a: "Either a <b>lack of estrogen priming</b> (estrogen deficiency) OR an <b>outflow tract obstruction/uterine defect</b> (e.g., Asherman syndrome)." },
            { q: "What is the next diagnostic step if the progesterone challenge test is negative?", a: "Administer sequential <b>estrogen</b> (to proliferate endometrium) followed by <b>progesterone</b> (to induce withdrawal), then stop." },
            { q: "If bleeding occurs after the estrogen-progesterone challenge, what is the diagnosis?", a: "The outflow tract is patent, and the amenorrhea is due to <b>hypoestrogenism</b> (either ovarian failure or hypothalamic/pituitary dysfunction)." },
            { q: "If no bleeding occurs after the estrogen-progesterone challenge, what is the diagnosis?", a: "An <b>outflow tract obstruction</b> or endometrial destruction (e.g., Asherman syndrome or cervical stenosis)." },
            { q: "What is the primary cause of Asherman syndrome?", a: "Intrauterine adhesions (synechiae) resulting from endometrial trauma, most commonly post-abortion or postpartum dilation and curettage (D&C) complicated by endometritis." },
            { q: "What is the gold standard diagnostic test for Asherman syndrome?", a: "<b>Hysteroscopy</b>, which allows both visualization and lysis of adhesions." },
            { q: "What is the definition of Premature Ovarian Insufficiency (POI)?", a: "Hypergonadotropic hypogonadism with depletion of ovarian follicles in a woman <b>under the age of 40</b>." },
            { q: "What laboratory findings confirm a diagnosis of Premature Ovarian Insufficiency (POI)?", a: "Two serum <b>FSH levels $> 30-40$ IU/L</b> measured at least 4 weeks apart, accompanied by low estradiol levels." },
            { q: "What is the most common chromosomal etiology of Premature Ovarian Insufficiency (POI)?", a: "Turner syndrome mosaicism (e.g., 45,XO/46,XX) or FMR1 gene premutation (associated with <b>Fragile X syndrome</b>)." },
            { q: "How do stress, extreme weight loss, or excessive exercise lead to functional hypothalamic amenorrhea?", a: "Corticotropin-releasing hormone (CRH) and beta-endorphins inhibit the pulsatile release of <b>GnRH</b> from the hypothalamus, leading to low FSH/LH and hypoestrogenism." },
            { q: "What are the three interrelated components of the Female Athlete Triad?", a: "Low energy availability (with or without eating disorder), menstrual dysfunction (amenorrhea), and low bone mineral density (osteopenia/osteoporosis)." },
            { q: "What is the most significant long-term systemic risk of prolonged hypoestrogenism in hypothalamic amenorrhea or POI?", a: "<b>Osteoporosis</b> (loss of bone density) and increased risk of cardiovascular disease." },
            { q: "How does hyperprolactinemia cause amenorrhea?", a: "Elevated prolactin inhibits the pulsatile secretion of <b>GnRH</b> from the hypothalamus, which decreases FSH and LH secretion, preventing ovulation." },
            { q: "What class of psychiatric medications is most commonly associated with secondary amenorrhea due to hyperprolactinemia?", a: "<b>Dopamine antagonists</b> (typical and atypical antipsychotics, e.g., risperidone, haloperidol) because dopamine normally inhibits prolactin release." },
            { q: "What is Sheehan syndrome, and how does it present?", a: "Ischemic necrosis of the anterior pituitary gland due to severe postpartum hemorrhage; presents as failure to lactate (lack of prolactin) and amenorrhea (lack of gonadotropins)." },
            { q: "What is Savage syndrome (gonadotropin-resistant ovary syndrome)?", a: "A rare cause of primary or secondary amenorrhea where ovaries have normal follicles but are resistant to FSH and LH stimulation due to receptor defects." },
            { q: "How is infertility defined for women under 35 vs. women 35 and older?", a: "Under 35: Failure to conceive after <b>12 months</b> of regular, unprotected intercourse. 35 and older: Failure to conceive after <b>6 months</b>." },
            { q: "What is fecundability, and what is its average value per cycle in a young, healthy couple?", a: "The probability of achieving a pregnancy in one menstrual cycle; approximately <b>20% to 25%</b>." },
            { q: "What are the three core areas evaluated in the initial infertility workup?", a: "(1) <b>Male factor</b> (semen), (2) <b>Ovulatory factor</b> (ovaries), and (3) <b>Tubal/Uterine factor</b> (anatomy)." },
            { q: "What is the single most important screening test for male factor infertility?", a: "A <b>semen analysis</b>." },
            { q: "How many days of ejaculatory abstinence are required prior to obtaining a semen analysis?", a: "<b>2 to 7 days</b>." },
            { q: "What should be done if a semen analysis returns abnormal?", a: "Repeat the semen analysis in 2-4 weeks (spermatogenesis takes ~74 days, so transient factors can cause abnormal results)." },
            { q: "According to WHO guidelines, what are the lower limits of normal for semen volume and sperm concentration?", a: "Volume: $\\\\ge 1.5$ mL; Concentration: $\\\\ge 15$ million/mL." },
            { q: "According to WHO guidelines, what are the lower limits of normal for total motility and Kruger strict morphology?", a: "Total motility: $\\\\ge 40\\\\%$ (or $\\\\ge 32\\\\%$ progressive motility); Morphology: $\\\\ge 4\\\\%$ normal forms." },
            { q: "What simple, home-based method can confirm ovulation by tracking temperature?", a: "<b>Basal Body Temperature (BBT) charting</b>; ovulation causes a progesterone-mediated biphasic rise of 0.5–1.0°F." },
            { q: "What serum progesterone level on day 21 (or 7 days before expected menses) confirms ovulation?", a: "A level of <b>$> 3$ ng/mL</b> (levels $> 10$ ng/mL suggest optimal corpus luteum function)." },
            { q: "What are the three primary clinical markers used to assess a patient's ovarian reserve?", a: "Day 3 FSH, Day 3 Estradiol, and <b>Antimüllerian Hormone (AMH)</b>." },
            { q: "What does an elevated Day 3 FSH ($> 10-12$ IU/L) indicate?", a: "<b>Diminished ovarian reserve (DOR)</b>; the pituitary is secreting more FSH to stimulate resistant follicles." },
            { q: "Why is Day 3 Estradiol measured alongside FSH?", a: "An artificially elevated estradiol ($> 60-80$ pg/mL) can prematurely suppress FSH into the 'normal' range, masking diminished ovarian reserve." },
            { q: "Which cells produce AMH, and why is it a reliable marker of ovarian reserve?", a: "Granulosa cells of <b>preantral and small antral follicles</b>; levels are stable throughout the menstrual cycle and decline with age." },
            { q: "What is Antral Follicle Count, and how is it measured?", a: "The total number of follicles measuring 2–10 mm in both ovaries, visualized via <b>transvaginal ultrasound</b> during the early follicular phase." },
            { q: "During which phase of the menstrual cycle should a hysterosalpingography (HSG) be performed, and why?", a: "During the <b>early follicular phase</b> (days 5-10), after menses has ended but before ovulation, to ensure the patient is not pregnant and the endometrium is thin." },
            { q: "What does the spill of contrast dye into the peritoneal cavity during HSG represent?", a: "<b>Tubal patency</b>; failure of dye to spill, or dilation of the tube (hydrosalpinx), indicates tubal obstruction." },
            { q: "What secondary clinical benefit is sometimes observed after an HSG?", a: "Increased pregnancy rates in the subsequent 2-3 cycles, likely due to flushing of debris or mucus plugs from the fallopian tubes." },
            { q: "What are the main contraindications to performing an HSG?", a: "Active pelvic infection/PID, pregnancy, and active undiagnosed uterine bleeding." },
            { q: "What is the mechanism of action of letrozole in ovulation induction, and what is its main indication?", a: "An <b>aromatase inhibitor</b> that blocks estrogen synthesis, reducing negative feedback on the pituitary, thereby increasing endogenous FSH release; first-line for PCOS." },
            { q: "What is the mechanism of action of clomiphene citrate?", a: "A <b>selective estrogen receptor modulator (SERM)</b> that blocks estrogen receptors in the hypothalamus, preventing negative feedback and stimulating GnRH and FSH/LH release." },
            { q: "Why is letrozole preferred over clomiphene citrate for ovulation induction in PCOS patients?", a: "Letrozole is associated with higher live birth and ovulation rates in PCOS, and does not negatively affect the endometrium or cervical mucus (unlike clomiphene)." },
            { q: "Why can clomiphene citrate cause a thin endometrium despite follicular growth?", a: "Its long half-life leads to persistent estrogen receptor antagonism in the endometrium, preventing normal proliferation." },
            { q: "When are exogenous gonadotropins (FSH/LH injections) indicated for ovulation induction?", a: "For patients with hypogonadotropic hypogonadism (hypothalamic amenorrhea) or patients who have failed oral ovulation induction agents." },
            { q: "What is IUI, and what are its primary indications?", a: "Insertion of washed, concentrated sperm directly into the uterine cavity; indicated for mild male factor infertility, cervical factor, unexplained infertility, or use of donor sperm." },
            { q: "What anatomical requirement must be met before planning IUI?", a: "The patient must have at least one <b>patent fallopian tube</b>." },
            { q: "What is the primary indication for proceeding directly to IVF without attempting IUI or oral induction?", a: "Severe bilateral tubal blockage or absence of fallopian tubes (e.g., bilateral salpingectomy)." },
            { q: "What is the standard sequence of events in a fresh IVF cycle?", a: "Controlled ovarian hyperstimulation $\\\\rightarrow$ trigger shot $\\\\rightarrow$ transvaginal oocyte retrieval $\\\\rightarrow$ fertilization in vitro $\\\\rightarrow$ embryo culture $\\\\rightarrow$ embryo transfer." },
            { q: "What is ICSI, and when is it indicated during IVF?", a: "The microinjection of a single sperm directly into the cytoplasm of a mature oocyte; indicated for severe male factor infertility (low count/motility) or prior fertilization failure." },
            { q: "What hormone is traditionally administered as the 'trigger shot' to induce final oocyte maturation in IVF, and why?", a: "<b>hCG</b> (human chorionic gonadotropin), which binds to LH receptors and mimics the natural mid-cycle LH surge." },
            { q: "What is the primary mediator and pathophysiology of Ovarian Hyperstimulation Syndrome (OHSS)?", a: "Release of <b>Vascular Endothelial Growth Factor (VEGF)</b> from hyperstimulated ovaries, leading to massive fluid shifts, third-spacing (ascites, pleural effusion), and hemoconcentration." },
            { q: "What are the signs and symptoms of severe Ovarian Hyperstimulation Syndrome (OHSS)?", a: "Abdominal distension/pain, ascites, rapid weight gain ($> 2$ lbs/day), oliguria, dyspnea, pleural effusion, and hemoconcentration (hematocrit $> 45\\\\%$)." },
            { q: "How can Ovarian Hyperstimulation Syndrome (OHSS) be prevented in high-risk patients during IVF stimulation?", a: "Using a <b>GnRH antagonist protocol</b> and triggering final maturation with a <b>GnRH agonist</b> instead of hCG, followed by a 'freeze-all' embryo cycle." },
            { q: "What patient characteristics increase the risk of developing Ovarian Hyperstimulation Syndrome (OHSS)?", a: "Young age, low body weight, PCOS, high antral follicle count, high AMH, and rapid rise in serum estradiol during stimulation." },
            { q: "What is the standard treatment progression for couples with unexplained infertility and normal workups?", a: "Expectant management, followed by ovarian stimulation (Letrozole/Clomiphene) + IUI (usually 3 cycles), progressing to IVF if unsuccessful." }
          ]
        },
        {
          section: 'Obstetrics & Gynecology',
          topic: "Neonatology & newborn resuscitation",
          icon: "baby",
          cards: [
            { q: "What is the primary stimulus for the neonate's first breath at birth?", a: "<b>Hypoxia, hypercapnia, and acidosis</b> resulting from cord clamping, combined with sensory stimuli (cold, touch)." },
            { q: "What is the vascular effect of clamping the umbilical cord on the neonate's systemic circulation?", a: "It removes the low-resistance placental circuit, causing an immediate <b>increase in systemic vascular resistance (SVR)</b>." },
            { q: "How does lung expansion at birth affect pulmonary vascular resistance (PVR)?", a: "Alveolar oxygenation and mechanical inflation cause <b>pulmonary vasodilation</b>, leading to a dramatic <b>decrease in pulmonary vascular resistance (PVR)</b>." },
            { q: "What causes the physiological closure of the foramen ovale after birth?", a: "The increase in pulmonary venous return increases <b>left atrial pressure</b> while decreased venous return from the cord lowers <b>right atrial pressure</b>, forcing the valve closed." },
            { q: "What is the primary mediator responsible for the closure of the ductus arteriosus after birth?", a: "<b>Increased arterial oxygen tension ($\\\\text{PaO}_2$)</b> and a <b>decrease in circulating prostaglandin $\\\\text{PGE}_2$</b> (due to placental separation and lung metabolism)." },
            { q: "What is the anatomical remnant of the closed ductus arteriosus?", a: "The <b>ligamentum arteriosum</b>." },
            { q: "How long does physiological closure of the ductus arteriosus typically take in a term neonate?", a: "Functional closure occurs within <b>10 to 15 hours</b> of life, while anatomical closure is complete by 2 to 3 weeks." },
            { q: "What anatomical structure does the umbilical vein become after closure?", a: "The <b>ligamentum teres hepatis</b> (round ligament of the liver)." },
            { q: "What causes the closure of the ductus venosus after birth?", a: "The cessation of umbilical vein flow when the cord is clamped, leading to its collapse and gradual fibrosis into the <b>ligamentum venosum</b>." },
            { q: "What do the umbilical arteries become after they close anatomically?", a: "The <b>medial umbilical ligaments</b>." },
            { q: "Why are fetal lungs filled with fluid in utero, and how is this fluid cleared during birth?", a: "Active secretion by lung epithelium maintains fluid volume; clearance occurs via <b>mechanical squeezing of the chest in the birth canal</b> (~1/3) and <b>transepithelial absorption</b> stimulated by epinephrine." },
            { q: "What is the direction of blood flow through the ductus arteriosus in the fetus?", a: "<b>Right-to-left</b> (from the pulmonary artery to the descending aorta), bypassing the high-resistance fetal lungs." },
            { q: "What is the direction of blood flow through the foramen ovale in the fetus?", a: "<b>Right-to-left</b> (from the right atrium to the left atrium), directing highly oxygenated blood from the ductus venosus toward the fetal brain." },
            { q: "What is the function of the ductus venosus in fetal circulation?", a: "It shunts approximately 50% of the oxygenated blood from the umbilical vein <b>directly to the inferior vena cava</b>, bypassing the fetal liver." },
            { q: "What are the five components of the APGAR score?", a: "<b>A</b>ctivity (muscle tone), <b>P</b>ulse (heart rate), <b>G</b>rimace (reflex irritability), <b>A</b>ppearance (skin color), and <b>R</b>espiration." },
            { q: "What are the timing intervals at which the APGAR score is routinely assigned?", a: "At <b>1 minute</b> and <b>5 minutes</b> after birth (and every 5 minutes up to 20 minutes if the 5-minute score is <7)." },
            { q: "What APGAR score represents a normal, healthy transition?", a: "A score of <b>7 to 10</b>." },
            { q: "How is a heart rate of >100 bpm scored on the APGAR scale?", a: "It receives a score of <b>2</b> (heart rate <100 bpm receives 1; absent heart rate receives 0)." },
            { q: "What constitutes a score of 1 for Respiration in the APGAR assessment?", a: "A <b>slow, irregular, or weak cry</b> (absent cry receives 0; strong, lusty cry receives 2)." },
            { q: "What constitutes a score of 1 for Activity (muscle tone) in the APGAR assessment?", a: "<b>Some flexion of the extremities</b> (flaccid receives 0; active motion and flexion receives 2)." },
            { q: "How is Grimace (reflex irritability) scored as a 2 in response to stimulation?", a: "<b>Sneeze, cough, or vigorous cry</b> (grimace alone receives 1; floppy/no response receives 0)." },
            { q: "What is the APGAR Appearance (color) score for a neonate with a pink body but blue extremities?", a: "<b>1 (acrocyanosis)</b>. A score of 2 requires the infant to be completely pink." },
            { q: "True or False: The APGAR score at 1 minute is used to decide whether to initiate neonatal resuscitation.", a: "<b>False</b>. Resuscitation must begin immediately if needed and is not delayed to calculate the 1-minute APGAR score." },
            { q: "What does a low 1-minute APGAR score (0–3) typically indicate?", a: "The need for <b>immediate active resuscitation</b>, though it does not predict long-term neurological outcomes." },
            { q: "What does a low 5-minute APGAR score (<7) indicate, and what is the management?", a: "It indicates a <b>suboptimal transition</b>; the score should be repeated every 5 minutes up to 20 minutes while supportive interventions continue." },
            { q: "What APGAR score is assigned to a baby who is flaccid, has a pulse of 80 bpm, grimaces to stimulation, has a weak cry, and has blue extremities?", a: "<b>4</b> (Activity = 0, Pulse = 1, Grimace = 1, Respiration = 1, Appearance = 1)." },
            { q: "How is a heart rate of 0 scored on the APGAR scale?", a: "It receives a score of <b>0</b>." },
            { q: "What three questions must be asked immediately after birth to determine if the baby can stay with the mother?", a: "(1) Is the baby <b>term</b>? (2) Does the baby have <b>good muscle tone</b>? (3) Is the baby <b>breathing or crying</b>?" },
            { q: "What are the four initial steps of newborn care for a baby who is not term, has poor tone, or is not breathing?", a: "<b>Warm (provide warmth), dry, stimulate, and position the airway</b> (clear secretions if obstructed)." },
            { q: "Why is drying the newborn a critical initial step in resuscitation?", a: "It prevents heat loss via <b>evaporative cooling</b>, which can trigger cold stress, metabolic acidosis, and increased oxygen demand." },
            { q: "How should the head of a newborn be positioned to open the airway?", a: "In a slightly extended <b>'sniffing' position</b> (avoid hyperextension or flexion of the neck)." },
            { q: "What is the correct sequence of suctioning a newborn's airway if there are secretions obstructing breathing?", a: "Suction the <b>mouth first, then the nose</b> ('M before N' to prevent aspiration if the baby gasps when the nose is suctioned)." },
            { q: "What is the risk of inserting a suction catheter too deeply or vigorously into the posterior pharynx?", a: "It can stimulate the vagal nerve and cause <b>severe bradycardia or apnea</b>." },
            { q: "How should a clinician stimulate a non-breathing newborn during the initial steps?", a: "Gently <b>rub the baby's back</b> or <b>flick the soles of the feet</b> (avoid shaking or slapping)." },
            { q: "What is the maximum duration that should be spent on the initial steps before reassessing the baby's breathing and heart rate?", a: "<b>30 seconds</b>." },
            { q: "Where on the neonate should the pulse oximeter probe be placed for the most accurate pre-ductal saturation reading?", a: "On the <b>right wrist or right hand</b> (reflects oxygenation of blood prior to the ductus arteriosus)." },
            { q: "What are the three primary indications for initiating Positive Pressure Ventilation (PPV) in a newborn?", a: "(1) <b>Apnea</b>, (2) <b>Gasping</b>, or (3) <b>Heart rate < 100 bpm</b>." },
            { q: "What is the target ventilation rate when administering PPV to a newborn?", a: "<b>40 to 60 breaths per minute</b> (using the rhythm: 'Breathe, two, three, Breathe, two, three')." },
            { q: "What is the recommended initial oxygen concentration for PPV in a term newborn ($ge 35$ weeks gestation)?", a: "<b>21% $\\text{FiO}_2$ (room air)</b>." },
            { q: "What is the recommended initial oxygen concentration for PPV in a preterm newborn ($< 35$ weeks gestation)?", a: "<b>21% to 30% $\\text{FiO}_2$</b>." },
            { q: "What are the target pre-ductal oxygen saturations at 1 minute and 5 minutes of life according to NRP?", a: "1 minute: <b>60%–65%</b>; 5 minutes: <b>80%–85%</b>." },
            { q: "What is the target pre-ductal oxygen saturation at 10 minutes of life?", a: "<b>85% to 95%</b>." },
            { q: "What is the first sign of successful ventilation during PPV in a newborn?", a: "A <b>rising heart rate</b>." },
            { q: "If the heart rate is not rising and the chest is not moving during PPV, what mnemonic guides the corrective steps?", a: "<b>MR. SOPA</b>." },
            { q: "What do the letters 'M' and 'R' in MR. SOPA stand for?", a: "<b>M</b>ask adjustment (re-apply and ensure a tight seal) and <b>R</b>eposition airway (bring head to sniffing position)." },
            { q: "What do the letters 'S' and 'O' in MR. SOPA stand for?", a: "<b>S</b>uction mouth and nose (clear secretions) and <b>O</b>pen mouth (slightly open the mouth and pull the jaw forward)." },
            { q: "What do the letters 'P' and 'A' in MR. SOPA stand for?", a: "<b>P</b>ressure increase (increase pressure in 5–10 $\\text{cm H}_2\\text{O}$ increments up to max 40 $\\text{cm H}_2\\text{O}$) and <b>A</b>lternative airway (intubation or laryngeal mask airway)." },
            { q: "How long should you perform effective PPV before checking the heart rate to decide on the next step?", a: "<b>30 seconds</b>." },
            { q: "What is the preferred initial peak inspiratory pressure (PIP) setting for PPV?", a: "<b>20 to 25 $\\text{cm H}_2\\text{O}$</b>." },
            { q: "What level of Positive End-Expiratory Pressure (PEEP) is recommended during PPV?", a: "<b>5 $\\text{cm H}_2\\text{O}$</b>." },
            { q: "What is the indication for starting chest compressions in a newborn?", a: "A <b>heart rate < 60 bpm</b> despite at least 30 seconds of <b>effective PPV</b> that inflates the lungs (usually via alternative airway)." },
            { q: "What is the preferred technique for delivering chest compressions in a newborn?", a: "The <b>two-thumb circle technique</b> (thumbs on the lower third of the sternum, fingers encircling the chest to support the back)." },
            { q: "What is the correct depth of chest compressions in a newborn?", a: "Approximately <b>one-third of the anterior-posterior diameter of the chest</b>." },
            { q: "What is the ratio of compressions to ventilations during newborn CPR?", a: "<b>3:1</b> (3 compressions followed by 1 breath)." },
            { q: "How many compressions and ventilations are delivered per minute during coordinated newborn resuscitation?", a: "<b>90 compressions and 30 ventilations</b> (total of 120 events per minute)." },
            { q: "What oxygen concentration should be used when chest compressions are initiated?", a: "<b>100% $\\text{FiO}_2$</b>." },
            { q: "How long should chest compressions and coordinated ventilation be performed before pausing to check the heart rate?", a: "<b>60 seconds</b> (to allow enough time to establish coronary perfusion pressure)." },
            { q: "At what heart rate can you discontinue chest compressions?", a: "When the heart rate is <b>60 bpm or greater</b>." },
            { q: "What size endotracheal tube (ETT) is appropriate for a term infant (>3,000 g)?", a: "<b>3.5 mm</b> (internal diameter)." },
            { q: "How is correct ETT placement initially confirmed in the delivery room?", a: "<b>Detection of exhaled $\\text{CO}_2$</b> (colorimetric detector turns from purple to yellow) and a rapid rise in heart rate." },
            { q: "What is the indication for administering epinephrine during neonatal resuscitation?", a: "A <b>heart rate < 60 bpm</b> despite at least 60 seconds of coordinated <b>chest compressions and 100% PPV</b>." },
            { q: "What is the preferred route for administering epinephrine in a newborn?", a: "<b>Intravenous (IV) or intraosseous (IO)</b> via an umbilical venous catheter (UVC)." },
            { q: "What is the recommended IV/IO dose of epinephrine ($1:10,000$ concentration) in neonatal resuscitation?", a: "<b>0.01 to 0.03 mg/kg</b> (equivalent to 0.1 to 0.3 mL/kg of $\\text{1:10,000}$ solution)." },
            { q: "What is the endotracheal (ET) dose of epinephrine, and when should it be used?", a: "<b>0.05 to 0.1 mg/kg</b> (0.5 to 1.0 mL/kg); use only as a temporary measure while IV access is being established." },
            { q: "How quickly can epinephrine doses be repeated if the heart rate remains <60 bpm?", a: "Every <b>3 to 5 minutes</b>." },
            { q: "What are the two indicated volume expanders for neonatal resuscitation in the setting of acute blood loss?", a: "<b>Normal saline (0.9% NaCl)</b> or <b>O-negative packed red blood cells</b>." },
            { q: "What is the recommended dose and administration rate of volume expanders during neonatal resuscitation?", a: "<b>10 mL/kg</b> administered over <b>5 to 10 minutes</b>." },
            { q: "What are clinical signs that suggest a need for volume expansion during resuscitation?", a: "History of acute blood loss (e.g., abruption, twin-to-twin transfusion), signs of shock (pallor, weak pulses, poor perfusion), and a poor response to CPR." },
            { q: "Why is the routine use of sodium bicarbonate avoided during neonatal resuscitation?", a: "It can form carbon dioxide, worsening <b>intracellular acidosis</b>, and increase the risk of intraventricular hemorrhage (IVH) due to hyperosmolality." },
            { q: "What is the recommended time frame for stopping resuscitation efforts if there is no heart rate detected?", a: "If the heart rate remains undetectable after <b>20 minutes</b> of redirection and optimization of all resuscitation steps, redirection of care should be discussed." },
            { q: "What is the purpose of administering erythromycin 0.5% ophthalmic ointment to all newborns?", a: "Prevention of <b>ophthalmia neonatorum</b> caused by <b>Neisseria gonorrhoeae</b>." },
            { q: "Within what time frame should erythromycin ointment be applied after birth?", a: "Within <b>2 hours</b> of birth." },
            { q: "True or False: Erythromycin ophthalmic ointment is highly effective at preventing neonatal conjunctivitis caused by Chlamydia trachomatis.", a: "<b>False</b>. It is primarily effective against Gonorrhea; systemic antibiotics are required for Chlamydia prevention/treatment." },
            { q: "Why do newborns require intramuscular Vitamin K prophylaxis at birth?", a: "They have <b>low baseline vitamin K levels</b> due to poor placental transfer, a sterile gut (no synthesis), and low levels in breast milk, placing them at risk for <b>vitamin K deficiency bleeding (VKDB)</b>." },
            { q: "What is the standard dose and route for Vitamin K prophylaxis in a term newborn?", a: "<b>1 mg intramuscularly (IM)</b> in the vastus lateralis muscle within 6 hours of birth." },
            { q: "What are the three clinical presentations of Vitamin K Deficiency Bleeding (VKDB)?", a: "<b>Early</b> (first 24 hours, often maternal drug-induced), <b>classic</b> (days 2–7, cutaneous/GI bleeding), and <b>late</b> (weeks 2–12, often presents as intracranial hemorrhage)." },
            { q: "What vaccine is routinely recommended for all stable newborns within 24 hours of birth?", a: "The <b>Hepatitis B vaccine</b>." },
            { q: "If a mother is Hepatitis B surface antigen (HBsAg) positive, what does the newborn receive at birth?", a: "Both the <b>Hepatitis B vaccine</b> and <b>Hepatitis B immune globulin (HBIG)</b> within 12 hours of birth (at separate injection sites)." },
            { q: "What is the management for a newborn whose mother's HBsAg status is unknown at birth?", a: "Administer the <b>Hepatitis B vaccine within 12 hours</b>, test the mother immediately, and give HBIG if the mother tests positive (or within 7 days for low-birthweight infants)." },
            { q: "What enzyme is immature in the newborn liver, leading to physiologic unconjugated hyperbilirubinemia?", a: "<b>Uridine diphosphate glucuronosyltransferase (UGT1A1)</b>." },
            { q: "What is the source of the increased bilirubin load in newborns compared to adults?", a: "A <b>higher red blood cell mass</b> and a <b>shorter RBC lifespan</b> (~80 days in neonates vs. 120 days in adults)." },
            { q: "What is the role of beta-glucuronidase in neonatal bilirubin metabolism?", a: "It is present in the neonatal gut and <b>deconjugates bilirubin</b> back into unconjugated bilirubin, which is then reabsorbed via the enterohepatic circulation." },
            { q: "Define physiologic jaundice in a term newborn.", a: "Unconjugated hyperbilirubinemia that appears <b>after 24 hours</b> of life, peaks at days 3–5, and resolves by 1–2 weeks, with bilirubin levels not exceeding physiologic thresholds." },
            { q: "What are three key features that define pathologic jaundice?", a: "(1) Jaundice appearing within the <b>first 24 hours</b> of life, (2) Total bilirubin rising <b>>5 mg/dL/day</b>, or (3) Direct (conjugated) bilirubin <b>>1.0 mg/dL</b> (or >20% of total)." },
            { q: "What is the danger of high levels of unconjugated bilirubin in the brain?", a: "Unconjugated bilirubin can cross the blood-brain barrier and deposit in the basal ganglia, causing <b>kernicterus (bilirubin-induced neurologic dysfunction)</b>." },
            { q: "What are the chronic neurological sequelae of kernicterus?", a: "<b>Choreoathetoid cerebral palsy</b>, sensorineural hearing loss, upward gaze palsy, and dental enamel dysplasia." },
            { q: "What is the difference in timing and mechanism between breastfeeding jaundice and breast milk jaundice?", a: "<b>Breastfeeding jaundice</b> (lactation failure) occurs in the <b>first week</b> due to low milk intake and dehydration; <b>breast milk jaundice</b> occurs <b>after 1 week</b> due to factors in breast milk that increase enterohepatic circulation." },
            { q: "How does breastfeeding jaundice (lack of breast milk) lead to hyperbilirubinemia?", a: "Low intake leads to mild dehydration, slow bowel movements, and <b>increased enterohepatic circulation</b> of bilirubin." },
            { q: "What substance in breast milk is thought to cause breast milk jaundice?", a: "<b>Beta-glucuronidase</b> (which deconjugates bilirubin in the gut) and high concentrations of free fatty acids that inhibit hepatic glucuronidation." },
            { q: "What is the first-line screening tool for neonatal jaundice before drawing blood?", a: "<b>Transcutaneous bilirubinometry (TcB)</b>." },
            { q: "What is the gold standard test to confirm hyperbilirubinemia severity?", a: "<b>Total serum bilirubin (TSB)</b>." },
            { q: "What does a positive direct antiglobulin test (DAT/Coombs) indicate in a jaundiced newborn?", a: "<b>Immune-mediated hemolysis</b> due to maternal-fetal blood group incompatibility (e.g., ABO or Rh incompatibility)." },
            { q: "How does phototherapy reduce serum bilirubin levels?", a: "It uses blue-green light (430-490 nm) to convert unconjugated bilirubin into water-soluble isomers (<b>lumirubin</b> and photobilirubin) that can be excreted in bile and urine without conjugation." },
            { q: "What clinical chart is used to determine if a newborn requires phototherapy?", a: "The <b>Bhutani nomogram</b> (which plots bilirubin level against post-natal age in hours)." },
            { q: "What is the main potential side effect of phototherapy in infants with conjugated hyperbilirubinemia?", a: "<b>Bronze baby syndrome</b> (a grey-brown discoloration of skin, serum, and urine)." },
            { q: "What is the indication for an emergent exchange transfusion in hyperbilirubinemia?", a: "Bilirubin levels at or above exchange threshold on the nomogram, or signs of <b>acute bilirubin encephalopathy</b> (hypertonia, arching, high-pitched cry) regardless of level." },
            { q: "What is the mechanism of action of IV immunoglobulin (IVIG) in Rh or ABO hemolytic disease?", a: "It blocks Fc receptors on neonatal splenic macrophages, <b>reducing the destruction of antibody-coated RBCs</b> and limiting bilirubin production." },
            { q: "What is the underlying pathophysiology of Transient Tachypnea of the Newborn (TTN)?", a: "<b>Delayed clearance of fetal lung fluid</b> by the alveolar epithelial sodium channels ($\\\\text{ENaC}$)." },
            { q: "What are the two major risk factors for TTN?", a: "<b>Cesarean delivery</b> (lack of mechanical thoracic squeeze) and <b>maternal asthma or diabetes</b>." },
            { q: "Within what time frame does TTN typically present, and how long does it last?", a: "It presents <b>within hours of birth</b> and typically resolves spontaneously within <b>24 to 72 hours</b>." },
            { q: "What are the classic chest X-ray (CXR) findings in TTN?", a: "<b>Perihilar streaking ('wet silhouette')</b>, prominent interlobar fissures, hyperinflation, and occasional mild cardiomegaly." },
            { q: "What is the primary management for TTN?", a: "<b>Supportive care</b>, including supplemental oxygen (usually <40% $\\\\text{FiO}_2$) and/or nasal CPAP; it is self-limiting." },
            { q: "What is the primary cause of Respiratory Distress Syndrome (RDS) in newborns?", a: "<b>Surfactant deficiency</b> due to lung immaturity, primarily affecting preterm infants." },
            { q: "What cell type produces pulmonary surfactant?", a: "<b>Type II alveolar pneumocytes</b>." },
            { q: "What is the main lipid component of pulmonary surfactant?", a: "<b>Dipalmitoylphosphatidylcholine (DPPC)</b>, also known as lecithin." },
            { q: "How does surfactant deficiency lead to progressive atelectasis in RDS?", a: "It increases <b>alveolar surface tension</b>, leading to alveolar collapse at end-expiration, decreased functional residual capacity, and ventilation-perfusion mismatch." },
            { q: "What are the classic clinical signs of respiratory distress in a newborn?", a: "<b>Tachypnea, nasal flaring, intercostal/subcostal retractions, and expiratory grunting</b>." },
            { q: "Why do newborns with RDS grunt during expiration?", a: "Grunting is an expiratory sigh against a partially closed glottis, which acts to <b>maintain PEEP</b> and prevent alveolar collapse." },
            { q: "What is the classic chest X-ray appearance of RDS?", a: "<b>Diffuse, fine 'ground-glass' reticulogranular patterns</b> with <b>air bronchograms</b> and low lung volumes." },
            { q: "What antenatal intervention can accelerate fetal lung maturity and prevent RDS?", a: "Administering <b>antenatal corticosteroids</b> (e.g., betamethasone or dexamethasone) to mothers at risk of preterm delivery between 24 and 34 weeks." },
            { q: "What is the immediate respiratory management for a preterm infant showing signs of RDS in the delivery room?", a: "Early initiation of <b>nasal Continuous Positive Airway Pressure (CPAP)</b>." },
            { q: "When is endotracheal surfactant replacement therapy indicated for an infant with RDS?", a: "When the infant has progressive respiratory distress and high oxygen requirements ($\\\\text{FiO}_2 > 30\\\\%$) despite optimal CPAP." },
            { q: "What technique allows for surfactant administration followed by rapid extubation to CPAP?", a: "The <b>INSURE technique</b> (INtubate, Surfactant, Extubate to CPAP)." },
            { q: "What triggers in utero passage of meconium into the amniotic fluid?", a: "<b>Fetal distress or hypoxia</b>, which stimulates vagal activity, causing hyperperistalsis and relaxation of the anal sphincter." },
            { q: "What are the three primary mechanisms of lung injury in Meconium Aspiration Syndrome (MAS)?", a: "(1) <b>Mechanical airway obstruction</b> (ball-valve effect), (2) <b>Chemical pneumonitis</b>, and (3) <b>Surfactant inactivation</b>." },
            { q: "What are the classic chest X-ray findings in MAS?", a: "<b>Patchy, asymmetric infiltrates</b>, areas of hyperinflation alternating with atelectasis, and flat diaphragms." },
            { q: "What severe cardiovascular complication is frequently associated with MAS?", a: "<b>Persistent Pulmonary Hypertension of the Newborn (PPHN)</b> due to pulmonary vasoconstriction from hypoxia and inflammation." },
            { q: "True or False: If a baby is born through meconium-stained amniotic fluid and is non-vigorous, the airway should be routinely suctioned via endotracheal tube before starting PPV.", a: "<b>False</b>. Current NRP guidelines do NOT recommend routine endotracheal suctioning; start PPV immediately if the baby is apneic or gasping." },
            { q: "What is the timeline distinction between early-onset and late-onset neonatal sepsis?", a: "<b>Early-onset sepsis</b> occurs <b>within 72 hours</b> of birth; <b>late-onset sepsis</b> occurs after 72 hours of life." },
            { q: "What is the most common pathogen responsible for early-onset neonatal sepsis?", a: "<b>Group B Streptococcus (GBS)</b> (Streptococcus agalactiae)." },
            { q: "What is the second most common pathogen causing early-onset neonatal sepsis, especially in preterm infants?", a: "<b>Escherichia coli</b>." },
            { q: "What is the maternal risk factor management that has significantly reduced GBS early-onset sepsis?", a: "<b>Intrapartum antibiotic prophylaxis (IAP)</b> (penicillin or ampicillin) for mothers who test GBS-positive at 36-37 weeks, or have risk factors like intrapartum fever or prolonged rupture of membranes." },
            { q: "What constitutes prolonged rupture of membranes (PROM) as a risk factor for neonatal sepsis?", a: "Rupture of membranes lasting <b>$\\\\ge 18$ hours</b> before delivery." },
            { q: "What is the standard empiric antibiotic regimen for suspected early-onset neonatal sepsis?", a: "<b>Ampicillin and Gentamicin</b>." },
            { q: "Why is ampicillin specifically included in the empiric treatment of neonatal sepsis?", a: "To cover <b>Listeria monocytogenes</b>, which is resistant to cephalosporins." },
            { q: "Why is ceftriaxone avoided in newborns under 28 days of age?", a: "It displaces bilirubin from albumin, increasing the risk of <b>kernicterus</b>, and can precipitate with calcium in neonatal blood/tissue." },
            { q: "What pathogen should be suspected in late-onset neonatal sepsis in an infant with a central line in the NICU?", a: "<b>Coagulase-negative Staphylococci (CoNS)</b>, such as Staphylococcus epidermidis." },
            { q: "What are the clinical signs of neonatal sepsis, which are often subtle and non-specific?", a: "<b>Temperature instability (hypothermia or hyperthermia)</b>, lethargy, poor feeding, apnea, tachypnea, and poor perfusion." }
          ]
        }
      ,
        {
          section: 'Emergency Medicine',
          topic: "ACLS & BLS protocols",
          icon: "heart",
          cards: [
            { q: "What are the links in the <b>adult Chain of Survival</b> (AHA)?", a: "1. <b>Recognition & activation</b> of emergency response<br>2. <b>Early CPR</b> with emphasis on chest compressions<br>3. <b>Rapid defibrillation</b><br>4. <b>Advanced resuscitation</b> (ACLS)<br>5. <b>Post-cardiac arrest care</b><br>6. <b>Recovery</b>" },
            { q: "How does the <b>pediatric Chain of Survival</b> differ from the adult chain?", a: "Pediatric chain emphasizes <b>prevention of arrest</b> as the first link (injury prevention, safe environments) because pediatric arrests are more often <b>respiratory in etiology</b> rather than cardiac. It also includes early CPR, activation of EMS, advanced resuscitation, post-arrest care, and recovery." },
            { q: "What is the recommended <b>chest compression rate</b> for CPR in all age groups?", a: "<b>100–120 compressions per minute</b> for adults, children, and infants. Rates >120/min reduce compression depth and coronary perfusion." },
            { q: "What is the recommended <b>compression depth</b> for adult CPR?", a: "<b>At least 2 inches (5 cm) but no more than 2.4 inches (6 cm)</b>. Excessive depth increases risk of rib fractures, sternal fractures, and internal organ injury." },
            { q: "What is the recommended <b>compression depth</b> for child (age 1–puberty) CPR?", a: "<b>At least one-third AP diameter of the chest</b>, approximately <b>2 inches (5 cm)</b>." },
            { q: "What is the recommended <b>compression depth</b> for infant CPR?", a: "<b>At least one-third AP diameter of the chest</b>, approximately <b>1.5 inches (4 cm)</b>. Use <b>two-finger technique</b> (single rescuer) or <b>two-thumb encircling hands technique</b> (two rescuers)." },
            { q: "What is the <b>compression-to-ventilation ratio</b> for <b>single-rescuer</b> CPR in adults?", a: "<b>30:2</b> (30 compressions followed by 2 breaths). This ratio applies to all single-rescuer scenarios regardless of patient age." },
            { q: "What is the <b>compression-to-ventilation ratio</b> for <b>two-rescuer pediatric</b> CPR?", a: "<b>15:2</b> (15 compressions to 2 breaths). The lower ratio provides more ventilations because pediatric arrests are often <b>respiratory in origin</b>." },
            { q: "What is the <b>compression-to-ventilation ratio</b> for <b>two-rescuer adult</b> CPR?", a: "<b>30:2</b> without an advanced airway. Once an <b>advanced airway</b> is placed, deliver <b>continuous compressions</b> (no pauses) with <b>1 breath every 6 seconds</b> (10 breaths/min)." },
            { q: "When is <b>hands-only (compression-only) CPR</b> indicated?", a: "For <b>untrained bystanders</b> or rescuers unwilling/unable to give breaths witnessing an <b>adult sudden cardiac arrest</b>. Not recommended for <b>children, infants, drowning, or respiratory-cause arrests</b> where ventilation is critical." },
            { q: "What is the correct <b>AED pad placement</b> for adults?", a: "<b>Anterolateral placement</b>:<br>• Right pad: <b>right infraclavicular</b> (below right clavicle)<br>• Left pad: <b>left lateral chest wall</b> (left midaxillary line, lateral to the breast)<br>Alternative: <b>anteroposterior</b> placement." },
            { q: "What AED pad modification is needed for <b>children < 8 years</b>?", a: "Use <b>pediatric dose-attenuator pads</b> if available (deliver reduced energy ~50-75J). If unavailable, use <b>standard adult pads</b>. For infants, a <b>manual defibrillator</b> is preferred; if unavailable, use an AED with pediatric pads." },
            { q: "What should you do if the AED advises <b>'No shock advised'</b>?", a: "Immediately <b>resume CPR for 2 minutes</b> (5 cycles of 30:2), then reanalyze. The rhythm is likely <b>PEA or asystole</b>. Do NOT delay compressions to recheck the rhythm." },
            { q: "What is <b>full chest recoil</b> and why is it important in CPR?", a: "Allowing the chest to <b>return completely to its normal position</b> between compressions. This creates negative intrathoracic pressure that promotes <b>venous return and coronary perfusion</b>. Leaning on the chest reduces cardiac output by ~25%." },
            { q: "What is the maximum <b>interruption time</b> recommended during CPR?", a: "Chest compression interruptions should be <b>< 10 seconds</b>. Compression fraction (percentage of time compressions are being performed) should be <b>≥ 60%</b>, ideally <b>≥ 80%</b>." },
            { q: "How often should rescuers <b>switch compressor roles</b> during CPR?", a: "<b>Every 2 minutes</b> (or every 5 cycles of 30:2) to prevent fatigue-related decline in compression quality. Switches should take <b>< 5 seconds</b>." },
            { q: "What is the ventilation rate when an <b>advanced airway</b> is in place during CPR?", a: "<b>1 breath every 6 seconds</b> (10 breaths/min) with <b>continuous chest compressions</b>. Avoid excessive ventilation, which increases intrathoracic pressure and reduces venous return." },
            { q: "What are the two <b>shockable cardiac arrest rhythms</b>?", a: "<b>Ventricular fibrillation (VFib)</b> and <b>pulseless ventricular tachycardia (pVT)</b>. These have the best prognosis of all arrest rhythms because they respond to defibrillation." },
            { q: "What is the <b>first priority</b> when VFib/pVT is identified on a monitor?", a: "<b>Immediate defibrillation</b>. Time to first shock is the single most important determinant of survival. For every minute defibrillation is delayed, survival decreases by <b>7–10%</b>." },
            { q: "What <b>defibrillation energy</b> is recommended for VFib/pVT with a <b>biphasic</b> defibrillator?", a: "First shock: <b>manufacturer-recommended dose (typically 120–200 J)</b>. If unknown, use <b>maximum available energy</b>. Subsequent shocks: same or higher dose." },
            { q: "What <b>defibrillation energy</b> is recommended for VFib/pVT with a <b>monophasic</b> defibrillator?", a: "<b>360 J</b> for all shocks (first and subsequent). Monophasic defibrillators deliver energy in one direction only and require higher energy." },
            { q: "What is the <b>ACLS algorithm sequence</b> for VFib/pVT?", a: "1. <b>Shock → CPR 2 min</b> → rhythm check<br>2. <b>Shock → CPR 2 min</b> → <b>Epinephrine 1 mg IV/IO</b> → rhythm check<br>3. <b>Shock → CPR 2 min</b> → <b>Amiodarone 300 mg IV/IO</b> → rhythm check<br>4. Repeat: Shock → CPR 2 min → Epi q3-5 min, Amiodarone 150 mg (2nd dose)" },
            { q: "What is the dose and frequency of <b>epinephrine</b> in cardiac arrest?", a: "<b>1 mg IV/IO every 3–5 minutes</b>. In VFib/pVT, give after the <b>2nd shock</b>. In PEA/asystole, give <b>as soon as IV/IO access</b> is obtained. Continue throughout resuscitation." },
            { q: "What is the dose of <b>amiodarone</b> in refractory VFib/pVT?", a: "First dose: <b>300 mg IV/IO bolus</b> (after the 3rd shock).<br>Second dose: <b>150 mg IV/IO</b> (can be given after the 5th shock or later). Maximum two doses during arrest." },
            { q: "What is an <b>alternative antiarrhythmic</b> to amiodarone in VFib/pVT arrest?", a: "<b>Lidocaine</b>: First dose <b>1–1.5 mg/kg IV/IO</b>, subsequent doses <b>0.5–0.75 mg/kg IV/IO</b> every 5–10 minutes (max total <b>3 mg/kg</b>)." },
            { q: "When should you consider <b>defibrillation vs. CPR first</b> in a witnessed VFib arrest?", a: "For a <b>witnessed arrest</b> with a defibrillator immediately available: <b>shock first</b>. If the arrest is <b>unwitnessed</b> or the defibrillator is not immediately available, perform <b>CPR while preparing the defibrillator</b>." },
            { q: "What are the two <b>non-shockable cardiac arrest rhythms</b>?", a: "<b>Pulseless electrical activity (PEA)</b> and <b>Asystole</b>. These are NOT treated with defibrillation. Focus is on <b>high-quality CPR, epinephrine, and identifying reversible causes</b>." },
            { q: "What is the <b>ACLS algorithm</b> for PEA/Asystole?", a: "1. <b>CPR 2 min</b> → <b>Epinephrine 1 mg IV/IO ASAP</b><br>2. Rhythm check every 2 min<br>3. Continue Epi <b>q3-5 min</b><br>4. Aggressively search for <b>reversible causes (H's and T's)</b><br>5. If rhythm changes to shockable → switch to VFib/pVT algorithm" },
            { q: "Why is early epinephrine critical in <b>non-shockable rhythms</b>?", a: "PEA/asystole have a <b>poor prognosis</b>. The AHA recommends giving epinephrine <b>as early as possible</b> in these rhythms. The PARAMEDIC2 trial showed epinephrine improved survival, with the greatest benefit in <b>non-shockable rhythms</b>." },
            { q: "What are the <b>5 H's</b> (reversible causes of cardiac arrest)?", a: "1. <b>Hypovolemia</b><br>2. <b>Hypoxia</b><br>3. <b>Hydrogen ion (acidosis)</b><br>4. <b>Hypo/Hyperkalemia</b><br>5. <b>Hypothermia</b>" },
            { q: "What are the <b>5 T's</b> (reversible causes of cardiac arrest)?", a: "1. <b>Tension pneumothorax</b><br>2. <b>Tamponade (cardiac)</b><br>3. <b>Toxins/Tablets</b><br>4. <b>Thrombosis — pulmonary (PE)</b><br>5. <b>Thrombosis — coronary (MI)</b>" },
            { q: "How is <b>hypovolemia</b> identified and treated during cardiac arrest?", a: "<b>Clues</b>: Trauma, GI bleed, ruptured AAA/ectopic, flat IVC on POCUS, narrow-complex PEA<br><b>Treatment</b>: Aggressive <b>volume resuscitation</b> with crystalloid and <b>blood products</b>; identify and control source of bleeding." },
            { q: "How is <b>hypoxia</b> identified and treated during cardiac arrest?", a: "<b>Clues</b>: Cyanosis, preceding respiratory distress, pulse oximetry, known pulmonary disease<br><b>Treatment</b>: <b>Advanced airway management</b> (ETT or SGA), confirm placement with <b>waveform capnography</b>, ensure adequate oxygenation and ventilation." },
            { q: "How is <b>hydrogen ion excess (acidosis)</b> identified and treated during cardiac arrest?", a: "<b>Clues</b>: Known renal failure, DKA, preceding sepsis, prolonged arrest<br><b>Treatment</b>: Adequate ventilation to blow off CO₂. Consider <b>sodium bicarbonate 1 mEq/kg IV</b> for severe metabolic acidosis, preexisting hyperkalemia, or tricyclic antidepressant overdose." },
            { q: "How is <b>hyperkalemia</b> identified and treated during cardiac arrest?", a: "<b>Clues</b>: Renal failure, peaked T waves → wide QRS → sine wave on ECG, dialysis patient<br><b>Treatment</b>:<br>• <b>Calcium chloride 10%</b> 10 mL IV (or calcium gluconate 30 mL) — membrane stabilization<br>• <b>Sodium bicarbonate</b> 50 mEq IV<br>• <b>Insulin 10 units + D50 25g IV</b><br>• Consider emergent dialysis" },
            { q: "How is <b>hypokalemia</b> identified and treated during cardiac arrest?", a: "<b>Clues</b>: Diuretic use, vomiting/diarrhea, U waves, flat T waves, prolonged QT on ECG<br><b>Treatment</b>: <b>IV potassium</b> replacement (central line preferred for rapid infusion, up to 20 mEq/hr peripherally). Also replete <b>magnesium</b> as hypomagnesemia often coexists." },
            { q: "How is <b>hypothermia</b> identified and treated during cardiac arrest?", a: "<b>Clues</b>: Environmental exposure, core temp < 30°C, Osborn (J) waves on ECG<br><b>Treatment</b>: <b>Active rewarming</b> — warm IV fluids (42°C), bladder/pleural/peritoneal lavage, ECMO/cardiopulmonary bypass for severe cases. Continue CPR until rewarmed to ≥ 32°C — <i>'not dead until warm and dead'</i>." },
            { q: "How is <b>tension pneumothorax</b> identified and treated during cardiac arrest?", a: "<b>Clues</b>: Trauma, absent breath sounds unilaterally, tracheal deviation, distended neck veins, hypotension<br><b>Treatment</b>: <b>Needle decompression</b> (14G needle, 2nd intercostal space midclavicular line or 4th/5th ICS anterior axillary line) followed by <b>chest tube thoracostomy</b>." },
            { q: "How is <b>cardiac tamponade</b> identified and treated during cardiac arrest?", a: "<b>Clues</b>: Beck's triad (hypotension, JVD, muffled heart sounds), trauma, pericardial effusion on POCUS<br><b>Treatment</b>: <b>Pericardiocentesis</b> (subxiphoid approach, ultrasound-guided) or emergent <b>thoracotomy</b> in traumatic arrest." },
            { q: "How are <b>toxins/tablets</b> identified and treated during cardiac arrest?", a: "<b>Clues</b>: Pill bottles, toxidrome, known ingestion, wide QRS (Na channel blockers)<br><b>Treatment</b>: Specific antidotes:<br>• Opioids → <b>Naloxone</b><br>• TCA/Na-channel blockers → <b>Sodium bicarbonate</b><br>• Beta-blockers → <b>Glucagon, high-dose insulin</b><br>• CCBs → <b>Calcium, high-dose insulin</b><br>• Digoxin → <b>Digoxin-specific Fab</b><br>• Consider <b>lipid emulsion therapy</b>" },
            { q: "How is <b>pulmonary embolism (thrombosis — pulmonary)</b> treated during cardiac arrest?", a: "Consider <b>systemic thrombolytics</b> (e.g., <b>alteplase 50 mg IV bolus</b>) during CPR. If given, continue CPR for at least <b>60–90 minutes</b> before termination. Also consider <b>surgical embolectomy</b> or <b>catheter-directed therapy</b> if available." },
            { q: "How is <b>coronary thrombosis (acute MI)</b> identified and treated during cardiac arrest?", a: "<b>Clues</b>: Preceding chest pain, ST changes, known CAD, STEMI on ECG<br><b>Treatment</b>: Consider emergent <b>PCI</b> with ongoing mechanical CPR (LUCAS device). Post-ROSC: immediate <b>cardiac catheterization</b> regardless of mental status if STEMI is suspected." },
            { q: "What is <b>targeted temperature management (TTM)</b> after cardiac arrest?", a: "Maintaining core body temperature at <b>32–36°C for at least 24 hours</b> in comatose patients (not following commands) after ROSC. Prevents <b>reperfusion injury, cerebral edema, and secondary brain injury</b>. Fever prevention (< 37.5°C) should continue for at least 72 hours." },
            { q: "Which patients are candidates for <b>targeted temperature management</b>?", a: "All <b>comatose adult patients</b> (not following commands) with ROSC after cardiac arrest, regardless of <b>initial rhythm</b> (shockable or non-shockable) or <b>location</b> (in-hospital or out-of-hospital)." },
            { q: "What are the <b>hemodynamic goals</b> in post-cardiac arrest care?", a: "• Maintain <b>SBP ≥ 90 mmHg</b> (MAP ≥ 65 mmHg)<br>• Use <b>IV fluids, vasopressors</b> (norepinephrine, epinephrine, dopamine), or <b>inotropes</b> (dobutamine) as needed<br>• Target <b>SpO₂ 92–98%</b> (avoid hyperoxia)<br>• Target <b>PaCO₂ 35–45 mmHg</b> (avoid hyperventilation)<br>• Treat <b>seizures</b> aggressively" },
            { q: "When should <b>PCI (percutaneous coronary intervention)</b> be performed post-cardiac arrest?", a: "Immediate PCI for patients with <b>STEMI on post-ROSC ECG</b>, regardless of neurological status. For patients <b>without STEMI</b>, emergent angiography may be reasonable if there is high suspicion for cardiac etiology." },
            { q: "When can <b>neurological prognostication</b> be reliably performed after cardiac arrest?", a: "<b>≥ 72 hours after ROSC</b> (or ≥ 72 hours after rewarming if TTM was used). Use <b>multimodal approach</b>: clinical exam (absent pupillary/corneal reflexes), EEG, somatosensory evoked potentials (SSEPs), neuroimaging, and biomarkers (NSE)." },
            { q: "What clinical findings suggest <b>poor neurological prognosis</b> after cardiac arrest?", a: "At ≥ 72 hours post-arrest:<br>• <b>Absent pupillary light reflex</b> bilaterally<br>• <b>Absent corneal reflexes</b> bilaterally<br>• <b>Status myoclonus</b> within 72h (though not reliable alone)<br>• <b>Bilaterally absent N20 SSEP</b> response<br>• <b>Highly malignant EEG patterns</b> (burst suppression, status epilepticus)" },
            { q: "Why should <b>hyperoxia</b> be avoided in post-cardiac arrest care?", a: "Hyperoxia (PaO₂ > 300 mmHg) generates excessive <b>reactive oxygen species (ROS)</b> that worsen <b>reperfusion injury</b> and increase mortality. Titrate FiO₂ to maintain <b>SpO₂ 92–98%</b> once ROSC is achieved." },
            { q: "What defines <b>hemodynamic instability</b> in tachycardia requiring immediate cardioversion?", a: "Signs of <b>unstable tachycardia</b>:<br>• <b>Hypotension</b> (SBP < 90 mmHg)<br>• <b>Altered mental status</b><br>• <b>Signs of shock</b> (pallor, diaphoresis)<br>• <b>Ischemic chest pain</b><br>• <b>Acute heart failure</b> (pulmonary edema)<br>If ANY of these are present and caused by the tachycardia → immediate <b>synchronized cardioversion</b>." },
            { q: "What is <b>synchronized cardioversion</b> and when is it used?", a: "Delivery of a shock <b>synchronized to the R wave</b> of the QRS complex to avoid shocking during the vulnerable period (T wave), which could cause VFib. Used for <b>unstable tachycardia with a pulse</b>: SVT, atrial flutter, atrial fibrillation, and monomorphic VT." },
            { q: "What are the <b>synchronized cardioversion energy doses</b> for different tachyarrhythmias?", a: "• <b>Narrow regular (SVT)</b>: 50–100 J<br>• <b>Narrow irregular (AFib)</b>: 120–200 J biphasic<br>• <b>Wide regular (monomorphic VT)</b>: 100 J, escalate if needed<br>• <b>Wide irregular (polymorphic VT)</b>: <b>Defibrillation</b> (unsynchronized) at high energy — treat as VFib" },
            { q: "What is the <b>initial approach</b> to a stable <b>narrow-complex regular tachycardia (SVT)</b>?", a: "1. <b>Vagal maneuvers</b> (Valsalva, carotid sinus massage, ice to face)<br>2. If unsuccessful: <b>Adenosine 6 mg rapid IV push</b> → flush with 20 mL NS<br>3. If unsuccessful: <b>Adenosine 12 mg rapid IV push</b> (may repeat once)<br>4. If unsuccessful: <b>IV diltiazem</b> or <b>IV beta-blocker</b>" },
            { q: "How does <b>adenosine</b> work and what are key administration considerations?", a: "<b>Mechanism</b>: Blocks AV node conduction transiently (half-life 6–10 seconds), interrupting reentrant circuits involving the AV node.<br><b>Administration</b>: Must be given as <b>rapid IV push</b> via a <b>large proximal vein</b> (antecubital or above) followed by <b>20 mL NS rapid flush</b> with arm elevation.<br><b>Contraindications</b>: Asthma (relative), heart transplant (reduce dose to 3 mg), WPW with AFib." },
            { q: "What is the dose of <b>diltiazem</b> for rate control of SVT or atrial fibrillation?", a: "<b>Diltiazem 0.25 mg/kg IV</b> (typically 15–20 mg) over 2 minutes. If inadequate response, repeat at <b>0.35 mg/kg IV</b> (typically 20–25 mg) after 15 minutes. Follow with <b>infusion at 5–15 mg/hr</b>." },
            { q: "How do you differentiate <b>SVT with aberrancy</b> from <b>ventricular tachycardia</b>?", a: "Assume <b>VT until proven otherwise</b> if wide-complex tachycardia. Clues favoring VT:<br>• <b>AV dissociation</b> (most reliable)<br>• <b>Capture/fusion beats</b><br>• <b>Concordance</b> (all precordial leads positive or negative)<br>• <b>Very wide QRS > 160 ms</b><br>• Older patient with <b>history of MI/structural heart disease</b><br>Use <b>Brugada criteria</b> for systematic differentiation." },
            { q: "What is the treatment for <b>stable monomorphic ventricular tachycardia</b>?", a: "First-line: <b>Amiodarone 150 mg IV over 10 minutes</b>, may repeat. Then <b>infusion 1 mg/min × 6 hr</b>, then <b>0.5 mg/min × 18 hr</b>.<br>Alternative: <b>Procainamide 20–50 mg/min IV</b> until arrhythmia suppressed, hypotension, QRS widens > 50%, or max dose 17 mg/kg.<br><b>Lidocaine 1–1.5 mg/kg IV</b> also an option." },
            { q: "What is <b>Torsades de Pointes</b> and how is it treated?", a: "<b>Polymorphic VT occurring in the setting of prolonged QT interval</b>. The QRS complexes 'twist' around the baseline.<br><b>Treatment</b>:<br>• <b>IV Magnesium sulfate 2 g IV over 10 min</b> (first-line)<br>• <b>Overdrive pacing</b> (transcutaneous or transvenous) to shorten QT<br>• <b>Isoproterenol</b> infusion to increase heart rate<br>• <b>Defibrillation</b> if pulseless<br>• <b>Avoid</b> amiodarone, procainamide, and other QT-prolonging agents" },
            { q: "How does treatment of <b>polymorphic VT with normal QT</b> differ from Torsades?", a: "Polymorphic VT with <b>normal QT interval</b> is usually caused by <b>ischemia</b>. Treatment focuses on <b>anti-ischemic therapy</b> (beta-blockers, reperfusion). <b>Amiodarone</b> may be used. <b>Magnesium is NOT first-line</b> (unlike Torsades). If unstable/pulseless → defibrillation (unsynchronized)." },
            { q: "Why is <b>synchronized cardioversion contraindicated</b> in polymorphic VT/Torsades?", a: "The QRS morphology and amplitude continuously change, making it impossible for the defibrillator to reliably <b>synchronize to the R wave</b>. Attempted synchronization causes dangerous delays. Treat with <b>unsynchronized defibrillation</b> (same as VFib)." },
            { q: "What is the approach to <b>stable narrow-complex irregular tachycardia</b>?", a: "Most commonly <b>atrial fibrillation</b>. Treatment:<br>• <b>Rate control</b>: Diltiazem, beta-blockers, or digoxin<br>• <b>Rhythm control</b>: Consider if < 48h onset (amiodarone, flecainide, ibutilide)<br>• <b>Anticoagulation</b>: Assess stroke risk with CHA₂DS₂-VASc score<br>• Also consider: <b>atrial flutter, multifocal atrial tachycardia (MAT)</b>" },
            { q: "At what heart rate does the <b>ACLS bradycardia algorithm</b> apply?", a: "<b>Heart rate < 50 bpm</b> with signs/symptoms of <b>hemodynamic compromise</b> (hypotension, altered mental status, chest pain, acute heart failure, syncope). Bradycardia that is well-tolerated does not require emergent treatment." },
            { q: "What is the <b>first-line drug</b> for symptomatic bradycardia?", a: "<b>Atropine 1 mg IV</b> every 3–5 minutes, <b>maximum total dose 3 mg</b>. Atropine blocks vagal (parasympathetic) tone at the SA and AV nodes to increase heart rate." },
            { q: "When is <b>atropine ineffective</b> for bradycardia?", a: "Atropine is <b>ineffective</b> in:<br>• <b>Second-degree type II (Mobitz II) AV block</b><br>• <b>Third-degree (complete) AV block</b> with wide QRS (infranodal block)<br>• <b>Heart transplant patients</b> (denervated heart)<br>In these cases, proceed directly to <b>pacing</b> or <b>chronotropic infusions</b>." },
            { q: "What is <b>transcutaneous pacing</b> and how is it performed?", a: "External pacing using adhesive pads on the chest:<br>• <b>Rate</b>: Start at 60–80 bpm<br>• <b>Output (mA)</b>: Start at lowest and increase until <b>electrical capture</b> (pacing spike followed by wide QRS and T wave) and <b>mechanical capture</b> (palpable pulse)<br>• Provide <b>analgesia/sedation</b> as it is painful<br>• Bridge to <b>transvenous pacing</b>" },
            { q: "What are the <b>second-line infusions</b> for symptomatic bradycardia unresponsive to atropine?", a: "• <b>Dopamine 5–20 mcg/kg/min IV infusion</b> (chronotropic at beta-1 doses)<br>• <b>Epinephrine 2–10 mcg/min IV infusion</b><br>• <b>Isoproterenol</b> (if available, pure beta-agonist)<br>These are used as a <b>bridge to transvenous pacing</b>." },
            { q: "Differentiate between <b>Mobitz Type I</b> and <b>Mobitz Type II</b> AV block.", a: "<b>Mobitz Type I (Wenckebach)</b>:<br>• Progressive <b>PR prolongation</b> until a dropped beat<br>• Block at <b>AV node</b> level, usually benign<br>• Often responds to <b>atropine</b><br><br><b>Mobitz Type II</b>:<br>• <b>Constant PR interval</b> with sudden dropped QRS<br>• Block <b>below AV node</b> (His-Purkinje), high risk for progression to <b>complete heart block</b><br>• <b>Atropine usually ineffective</b> — requires <b>pacing</b>" },
            { q: "What defines a <b>STEMI</b> on ECG?", a: "<b>ST elevation</b> in ≥ 2 contiguous leads:<br>• <b>≥ 1 mm</b> in all leads except V2–V3<br>• V2–V3: <b>≥ 2 mm in men ≥ 40</b>, <b>≥ 2.5 mm in men < 40</b>, <b>≥ 1.5 mm in women</b><br>• <b>New LBBB</b> in clinical context of ACS<br>• <b>Posterior MI</b>: ST depression V1–V3 (obtain posterior leads V7–V9)" },
            { q: "What defines an <b>NSTEMI</b> vs <b>unstable angina</b>?", a: "<b>NSTEMI</b>: Ischemic symptoms + <b>elevated troponin</b> WITHOUT ST elevation. May have ST depression, T-wave inversions, or normal ECG.<br><b>Unstable angina</b>: Ischemic symptoms with <b>normal troponin</b> and dynamic ECG changes. Differentiation requires serial troponin measurement." },
            { q: "What is the <b>door-to-balloon time</b> goal for STEMI?", a: "<b>≤ 90 minutes</b> from first medical contact to PCI balloon inflation at a <b>PCI-capable facility</b>. If transfer to PCI center is needed, the first medical contact-to-device time should be <b>≤ 120 minutes</b>. If this cannot be met, consider <b>fibrinolytic therapy</b> within 30 minutes." },
            { q: "What is the <b>MONA-B</b> protocol for ACS?", a: "<b>M</b>orphine — 2–4 mg IV for refractory pain (use cautiously, may increase mortality in some studies)<br><b>O</b>xygen — only if SpO₂ < 90%<br><b>N</b>itroglycerin — 0.4 mg SL q5min × 3, then IV drip (avoid if RV infarct, SBP < 90, PDE5 inhibitor use)<br><b>A</b>spirin — <b>162–325 mg chewed</b> immediately<br><b>B</b>eta-blocker — Oral within 24h if no contraindications (HF, bradycardia, hypotension)" },
            { q: "What <b>antiplatelet therapy</b> is recommended for ACS patients undergoing PCI?", a: "<b>Dual antiplatelet therapy (DAPT)</b>:<br>• <b>Aspirin 162–325 mg</b> loading, then 81 mg daily<br>• P2Y12 inhibitor loading: <b>Ticagrelor 180 mg</b> (preferred) or <b>Clopidogrel 600 mg</b> or <b>Prasugrel 60 mg</b><br>Continue DAPT for at least <b>12 months</b> post-PCI." },
            { q: "What <b>anticoagulation</b> options are used in ACS?", a: "• <b>Unfractionated heparin (UFH)</b>: 60 U/kg bolus (max 4000 U) + 12 U/kg/hr (max 1000 U/hr)<br>• <b>Enoxaparin (LMWH)</b>: 1 mg/kg SC q12h (0.75 mg/kg if ≥ 75 years)<br>• <b>Bivalirudin</b>: 0.75 mg/kg bolus + 1.75 mg/kg/hr infusion (for PCI)<br>• <b>Fondaparinux</b>: 2.5 mg SC daily (avoid as sole anticoagulant for PCI)" },
            { q: "What are the <b>indications for fibrinolytic therapy</b> in STEMI?", a: "• <b>STEMI with symptom onset ≤ 12 hours</b><br>• <b>PCI not available within 120 minutes</b> of first medical contact<br>• No absolute contraindications<br>Agent: <b>Alteplase, Reteplase, or Tenecteplase</b><br>Administer within <b>30 minutes</b> of arrival (door-to-needle)." },
            { q: "What are the <b>absolute contraindications</b> to fibrinolytic therapy?", a: "• <b>Active internal bleeding</b> (excluding menses)<br>• <b>History of hemorrhagic stroke</b> at any time<br>• <b>Ischemic stroke within 3 months</b><br>• <b>Intracranial neoplasm, AVM, or aneurysm</b><br>• <b>Known structural cerebrovascular lesion</b><br>• <b>Significant closed head/facial trauma within 3 months</b><br>• <b>Suspected aortic dissection</b><br>• <b>Active bleeding or bleeding diathesis</b> (excluding menses)" },
            { q: "What are <b>relative contraindications</b> to fibrinolytic therapy?", a: "• <b>Severe uncontrolled HTN</b> (> 180/110 mmHg)<br>• <b>Ischemic stroke > 3 months ago</b><br>• <b>Prolonged CPR > 10 minutes</b><br>• <b>Major surgery within 3 weeks</b><br>• <b>Internal bleeding within 2–4 weeks</b><br>• <b>Non-compressible vascular punctures</b><br>• <b>Pregnancy</b><br>• <b>Active peptic ulcer</b><br>• <b>Current anticoagulant use</b> (higher INR = higher risk)" },
            { q: "What ECG leads correspond to which <b>coronary artery territories</b>?", a: "• <b>Anterior wall</b> (V1–V4): <b>LAD</b><br>• <b>Lateral wall</b> (I, aVL, V5–V6): <b>LCx</b><br>• <b>Inferior wall</b> (II, III, aVF): <b>RCA</b> (85%) or LCx (15%)<br>• <b>Posterior wall</b> (V7–V9, reciprocal ST depression V1–V3): <b>RCA or LCx</b><br>• <b>Right ventricle</b> (V4R): <b>Proximal RCA</b>" },
            { q: "Why is <b>nitroglycerin contraindicated</b> in right ventricular infarction?", a: "RV infarction makes the right ventricle <b>preload-dependent</b>. Nitroglycerin causes <b>venodilation and reduces preload</b>, which can cause severe <b>hypotension and cardiogenic shock</b>. Treatment of RV infarct hypotension: <b>IV fluid boluses</b> to maintain preload." },
            { q: "What are the components of the <b>Cincinnati Prehospital Stroke Scale (CPSS)</b>?", a: "Three components (any 1 abnormal = 72% probability of stroke):<br>1. <b>Facial droop</b>: Ask patient to smile — one side doesn't move as well<br>2. <b>Arm drift</b>: Eyes closed, arms extended 10 sec — one arm drifts down<br>3. <b>Speech</b>: Repeat a phrase — slurred, inappropriate words, or unable to speak" },
            { q: "What is the <b>NIHSS (National Institutes of Health Stroke Scale)</b>?", a: "A <b>15-item standardized neurological assessment</b> scoring stroke severity (0–42). Evaluates: level of consciousness, gaze, visual fields, facial palsy, motor arm/leg, limb ataxia, sensory, language, dysarthria, extinction/inattention.<br>• <b>0</b>: No stroke symptoms<br>• <b>1–4</b>: Minor stroke<br>• <b>5–15</b>: Moderate stroke<br>• <b>16–20</b>: Moderate-severe<br>• <b>21–42</b>: Severe stroke" },
            { q: "What are the <b>inclusion criteria</b> for IV tPA (alteplase) in acute ischemic stroke?", a: "• <b>Clinical diagnosis of ischemic stroke</b> causing measurable deficit<br>• <b>Onset ≤ 4.5 hours</b> (or last known well time)<br>• <b>Age ≥ 18 years</b><br>• <b>CT scan excluding hemorrhage</b><br>• Additional criteria for 3–4.5h window: Age < 80, no diabetes + prior stroke combo, NIHSS ≤ 25, not on oral anticoagulants" },
            { q: "What is the <b>dose and administration</b> of alteplase (tPA) for acute ischemic stroke?", a: "<b>0.9 mg/kg IV</b> (maximum <b>90 mg</b>):<br>• <b>10%</b> of total dose as <b>IV bolus over 1 minute</b><br>• Remaining <b>90%</b> infused <b>over 60 minutes</b><br>• <b>No anticoagulants or antiplatelets</b> for 24 hours after administration<br>• Monitor in ICU/stroke unit with frequent neuro checks and BP monitoring" },
            { q: "What are <b>major exclusion criteria</b> for IV tPA in stroke?", a: "• <b>Intracranial hemorrhage</b> on CT<br>• <b>BP > 185/110 mmHg</b> despite treatment<br>• <b>Blood glucose < 50 mg/dL</b><br>• <b>Platelet count < 100,000</b><br>• <b>INR > 1.7</b> or PT > 15 seconds<br>• <b>Heparin use within 48h</b> with elevated aPTT<br>• <b>Major surgery or serious trauma within 14 days</b><br>• <b>GI/urinary hemorrhage within 21 days</b><br>• <b>Recent intracranial/spinal surgery within 3 months</b>" },
            { q: "What is the time window for <b>mechanical thrombectomy</b> in acute ischemic stroke?", a: "<b>Up to 24 hours</b> from last known well time for <b>large vessel occlusion (LVO)</b> in the anterior circulation (ICA, M1 MCA). Requires <b>advanced imaging</b> (CT perfusion or MRI diffusion/perfusion mismatch) showing salvageable tissue per <b>DAWN</b> and <b>DEFUSE 3</b> trials. Within 6 hours, CTA demonstrating LVO is sufficient." },
            { q: "What are the <b>blood pressure targets</b> for acute ischemic stroke management?", a: "• <b>Pre-tPA</b>: Must be <b>< 185/110 mmHg</b> before and during administration<br>• <b>Post-tPA (24 hours)</b>: Maintain <b>< 180/105 mmHg</b><br>• <b>Not receiving tPA and not for thrombectomy</b>: Allow <b>permissive hypertension up to 220/120 mmHg</b><br>• Agents: <b>IV labetalol, nicardipine, or clevidipine</b>" },
            { q: "What is the <b>blood pressure management</b> for hemorrhagic stroke?", a: "For <b>intracerebral hemorrhage (ICH)</b>:<br>• If SBP 150–220 mmHg: <b>Rapidly lower to SBP 140 mmHg</b> (INTERACT2 trial)<br>• If SBP > 220 mmHg: Aggressive IV reduction<br>• Agents: <b>Nicardipine, labetalol, clevidipine</b><br>• <b>Reverse anticoagulation</b> if applicable" },
            { q: "What is the approach to cardiac arrest in <b>drowning</b>?", a: "Key differences from standard ACLS:<br>• <b>Ventilations are priority</b> — drowning is a hypoxic arrest<br>• Begin with <b>5 rescue breaths</b> before compressions if possible<br>• <b>Do NOT attempt to drain water</b> from the lungs<br>• Standard CPR ratio and ACLS algorithms apply thereafter<br>• Consider <b>hypothermia</b> as a reversible cause<br>• Prolonged resuscitation may be warranted (especially in cold water/children)" },
            { q: "How does <b>hypothermia</b> modify cardiac arrest management?", a: "• <b>Extend pulse check to 60 seconds</b> (bradycardia may be difficult to detect)<br>• If <b>core temp < 30°C</b>: Give initial defibrillation, withhold medications, and focus on <b>rewarming</b><br>• If <b>core temp 30–35°C</b>: Space medications at <b>longer intervals</b><br>• If <b>core temp ≥ 35°C</b>: Use <b>standard ACLS protocols</b><br>• Continue CPR until rewarmed to ≥ 32°C: <i>'Not dead until warm and dead'</i>" },
            { q: "What modifications are needed for <b>cardiac arrest in pregnancy</b>?", a: "• <b>Left uterine displacement (LUD)</b>: Manual displacement of the uterus to the left to relieve <b>aortocaval compression</b> (preferred over lateral tilt during CPR)<br>• Perform compressions <b>slightly higher on the sternum</b> (to account for elevated diaphragm)<br>• Provide <b>continuous waveform capnography</b> with early advanced airway<br>• <b>Remove fetal monitors</b><br>• Consider <b>IV access above the diaphragm</b>" },
            { q: "When should <b>perimortem cesarean delivery (PMCD)</b> be performed?", a: "Begin at <b>4 minutes</b> of maternal cardiac arrest if no ROSC, aim for <b>delivery by 5 minutes</b>. Indicated when:<br>• <b>Uterine fundus at or above the umbilicus</b> (≥ 20 weeks gestation)<br>• Purpose: <b>Relieve aortocaval compression</b> to improve maternal resuscitation, not primarily for fetal survival<br>• Perform <b>at bedside</b> — do NOT transport to OR" },
            { q: "What is the role of <b>naloxone</b> in opioid-associated cardiac arrest?", a: "• <b>Naloxone (Narcan)</b>: 0.4–2 mg IV/IM/IN, may repeat every 2–3 minutes<br>• Indicated for <b>respiratory arrest</b> or <b>severe respiratory depression</b> with a pulse<br>• In <b>full cardiac arrest</b>, standard BLS/ACLS takes priority; naloxone is an <b>adjunct</b> but does not replace CPR/defibrillation<br>• Intranasal: <b>4 mg IN</b> (single dose device)<br>• Duration of action: 30–90 min (may need repeat dosing)" },
            { q: "What is the approach to cardiac arrest from <b>anaphylaxis</b>?", a: "• <b>Epinephrine</b> is the cornerstone: <b>1 mg IV q3-5 min</b> during arrest (standard ACLS dose)<br>• Pre-arrest: <b>0.3–0.5 mg IM</b> (1:1000) into anterolateral thigh<br>• Aggressive <b>IV fluid resuscitation</b> (distributive shock component)<br>• <b>Prolonged CPR</b> may be warranted — these patients are often young with reversible cause<br>• Adjuncts: H1/H2 blockers, steroids, albuterol (but do NOT delay epinephrine)" },
            { q: "What is <b>waveform capnography (ETCO₂)</b> and its role in cardiac arrest?", a: "Measures exhaled CO₂ continuously:<br>• <b>Confirms ETT placement</b> (persistent ETCO₂ waveform = tracheal)<br>• <b>Monitors CPR quality</b>: Target ETCO₂ <b>≥ 10 mmHg</b> (ideally 20 mmHg); if < 10, improve compression quality<br>• <b>Identifies ROSC</b>: Abrupt sustained rise in ETCO₂ to <b>≥ 40 mmHg</b> = likely ROSC<br>• <b>Prognostication</b>: ETCO₂ < 10 mmHg after 20 min of CPR = poor prognosis" },
            { q: "What are the <b>routes of medication administration</b> during cardiac arrest?", a: "1. <b>IV (intravenous)</b> — preferred, fastest onset<br>2. <b>IO (intraosseous)</b> — if IV cannot be established quickly; sites include proximal tibia, humeral head, distal tibia<br>3. <b>Endotracheal (ET)</b> — only if IV/IO unavailable; limited to <b>naloxone, atropine, vasopressin, epinephrine, lidocaine (NAVEL)</b>; give <b>2–2.5× the IV dose</b> diluted in 5–10 mL NS" },
            { q: "What is <b>PEA (Pulseless Electrical Activity)</b>?", a: "Organized electrical activity on the cardiac monitor <b>without a palpable pulse</b>. It is NOT a specific rhythm — any organized rhythm without a pulse qualifies. Can range from <b>narrow complex (pseudo-PEA, may have some cardiac motion)</b> to <b>wide complex (poor prognosis)</b>. Always search for <b>reversible causes</b>." },
            { q: "When should resuscitation be <b>terminated</b> in the field (out-of-hospital)?", a: "Consider termination if (BLS termination rule):<br>• <b>Arrest not witnessed</b> by EMS<br>• <b>No ROSC</b> after full BLS/ACLS<br>• <b>No AED shock delivered</b><br>• EMS did not witness arrest<br>Also consider: <b>ETCO₂ < 10 mmHg after 20 min</b> of CPR, <b>asystole > 20 min</b> with no reversible cause, patient's wishes/advance directive." },
            { q: "What is the role of <b>vasopressin</b> in cardiac arrest?", a: "The AHA <b>removed vasopressin</b> from the 2015 ACLS guidelines as an alternative to epinephrine. Studies (e.g., the VAM trial) showed <b>no survival benefit</b> over epinephrine alone. <b>Epinephrine 1 mg IV/IO q3-5 min</b> is the sole recommended vasopressor during arrest." },
            { q: "What is the <b>High-Performance CPR</b> concept?", a: "Pit crew approach with defined roles:<br>• <b>Compression fraction ≥ 80%</b><br>• Rate <b>100–120/min</b>, depth <b>≥ 2 inches</b>, full recoil<br>• <b>Minimize interruptions</b> (< 10 sec for pulse/rhythm checks)<br>• <b>Switch compressors q2 min</b><br>• <b>Avoid excessive ventilation</b><br>• Continuous <b>ETCO₂ monitoring</b> for quality feedback<br>• Coordinated <b>team dynamics</b> with clear leader and closed-loop communication" },
            { q: "What is <b>ROSC (Return of Spontaneous Circulation)</b> and how is it identified?", a: "<b>Signs of ROSC</b>:<br>• <b>Palpable pulse</b> (carotid or femoral)<br>• <b>Abrupt sustained rise in ETCO₂</b> (typically ≥ 40 mmHg)<br>• <b>Spontaneous arterial blood pressure waveform</b> (if arterial line in place)<br>• <b>Spontaneous breathing/movement</b><br>Once identified: Begin <b>post-cardiac arrest care</b> bundle immediately." },
            { q: "What <b>ECG rhythm</b> should be confirmed as <b>asystole</b> and not fine VFib?", a: "To confirm asystole:<br>• Check <b>leads/connections</b><br>• <b>Increase gain/amplitude</b> on the monitor<br>• Check in <b>multiple leads</b> (confirm in at least 2 leads perpendicular to each other)<br>If there is any doubt, treat as <b>VFib</b> and defibrillate. True asystole appears as a <b>flat line</b> with no discernible electrical activity." },
            { q: "What is the mechanism of <b>epinephrine</b> in cardiac arrest?", a: "<b>Alpha-1 agonism</b> is the primary beneficial effect: causes <b>peripheral vasoconstriction</b> → increases <b>aortic diastolic pressure</b> → improves <b>coronary perfusion pressure (CPP)</b> and <b>cerebral perfusion</b>.<br>Beta effects (increased heart rate, contractility) are secondary and may actually increase myocardial oxygen demand." },
            { q: "What is the mechanism of <b>amiodarone</b> and its side effects during resuscitation?", a: "<b>Class III antiarrhythmic</b> (K⁺ channel blocker) with properties of all 4 Vaughan-Williams classes.<br><b>Mechanism</b>: Prolongs action potential duration and refractory period, slows conduction.<br><b>Acute side effects</b>: <b>Hypotension</b> (from solvent), <b>bradycardia</b>.<br>Long-term: Pulmonary fibrosis, thyroid dysfunction, hepatotoxicity, corneal deposits." },
            { q: "What is the mechanism and dosing of <b>procainamide</b> in stable VT?", a: "<b>Class IA antiarrhythmic</b>: Blocks Na⁺ channels (slows conduction) and K⁺ channels (prolongs repolarization).<br><b>Dosing</b>: <b>20–50 mg/min IV infusion</b>.<br><b>Stop if</b>: arrhythmia suppressed, hypotension, QRS widens > 50%, or max dose <b>17 mg/kg</b> reached.<br><b>Maintenance</b>: 1–4 mg/min infusion." },
            { q: "What is the role of <b>magnesium sulfate</b> in cardiac arrest/arrhythmias?", a: "• <b>Torsades de Pointes</b>: <b>2 g IV over 10 min</b> — first-line treatment<br>• <b>Refractory VFib</b>: <b>1–2 g IV push</b> — may be considered<br>• <b>Hypomagnesemia-related arrhythmias</b><br>• <b>Mechanism</b>: Stabilizes cardiac membranes, suppresses early afterdepolarizations that cause Torsades<br>• <b>Not routinely recommended</b> in all cardiac arrest" },
            { q: "What are the key differences between <b>calcium chloride</b> and <b>calcium gluconate</b>?", a: "<b>Calcium chloride 10%</b>: Contains <b>3× more elemental calcium</b> (270 mg per 10 mL). Preferred in <b>cardiac arrest</b> (faster, more reliable). Requires <b>central line</b> (causes tissue necrosis if extravasated).<br><b>Calcium gluconate</b>: Safer peripherally, contains 90 mg elemental Ca per 10 mL. Give <b>30 mL</b> for equivalent effect. Preferred for non-arrest hyperkalemia." },
            { q: "What is the difference between <b>monophasic</b> and <b>biphasic</b> defibrillation?", a: "<b>Monophasic</b>: Current flows in <b>one direction</b>. Requires higher energy (<b>360 J</b>). Older technology.<br><b>Biphasic</b>: Current flows in <b>both directions</b> sequentially. More effective at lower energy (<b>120–200 J</b>). Better first-shock efficacy. Less myocardial damage. Most modern defibrillators are biphasic." },
            { q: "What is the <b>pediatric defibrillation energy</b> dose?", a: "• First shock: <b>2 J/kg</b><br>• Second shock: <b>4 J/kg</b><br>• Subsequent shocks: <b>≥ 4 J/kg, maximum 10 J/kg</b> or adult dose<br>Use a <b>manual defibrillator</b> if available. If not, use AED with <b>pediatric dose-attenuator pads</b>. If neither available, use standard AED." },
            { q: "What are special considerations for <b>AED use</b> with chest hair, water, or implanted devices?", a: "• <b>Chest hair</b>: If pads don't adhere, <b>shave the area</b> or press firmly. May need to rip off pads to remove hair, then apply new pads.<br>• <b>Water</b>: Move patient to dry surface, <b>wipe chest dry</b> before pad placement.<br>• <b>Implanted pacemaker/ICD</b>: Place pads at least <b>1 inch (2.5 cm) away</b> from the device.<br>• <b>Medication patches</b>: Remove and wipe skin before pad placement." },
            { q: "What are the key elements of <b>effective team dynamics</b> in ACLS?", a: "• <b>Clear team leader</b> — directs and oversees<br>• <b>Closed-loop communication</b>: Leader gives order → team member repeats → confirms completion<br>• <b>Clear role assignments</b><br>• <b>Knowledge sharing</b> — any team member can suggest corrections<br>• <b>Constructive intervention</b> — speak up if an error is noticed<br>• <b>Mutual respect</b><br>• <b>Debriefing after every event</b>" },
            { q: "What is <b>closed-loop communication</b> in ACLS?", a: "A 3-step process ensuring orders are accurately received:<br>1. <b>Leader</b> gives a clear order (e.g., 'Give 1 mg epinephrine IV')<br>2. <b>Team member</b> repeats the order back (e.g., 'Giving 1 mg epinephrine IV now')<br>3. <b>Team member</b> confirms task completion (e.g., 'Epinephrine 1 mg IV given')<br>Reduces errors from miscommunication." },
            { q: "What causes of PEA have a <b>narrow-complex QRS</b> pattern?", a: "Narrow-complex PEA (pseudo-PEA) suggests <b>mechanical causes</b> where the heart is electrically normal but cannot generate output:<br>• <b>Cardiac tamponade</b><br>• <b>Tension pneumothorax</b><br>• <b>Massive PE</b><br>• <b>Mechanical hyperinflation</b><br>These patients may have organized cardiac contractions visible on <b>POCUS</b> and have a better prognosis." },
            { q: "What is the difference between <b>cardioversion</b> and <b>defibrillation</b>?", a: "<b>Cardioversion</b>: <b>Synchronized</b> shock timed to R wave; used for <b>unstable tachycardia WITH a pulse</b> (SVT, AFib, atrial flutter, monomorphic VT). Lower energy.<br><b>Defibrillation</b>: <b>Unsynchronized</b> shock delivered at any time; used for <b>VFib, pulseless VT, and polymorphic VT</b>. Higher energy. Goal: depolarize entire myocardium to allow SA node reset." },
            { q: "What is <b>coronary perfusion pressure (CPP)</b> and its significance in CPR?", a: "<b>CPP = Aortic diastolic pressure − Right atrial diastolic pressure</b>.<br>A CPP of <b>≥ 15 mmHg</b> is associated with ROSC. This is why <b>compression quality</b> (adequate depth, rate, full recoil) and <b>epinephrine</b> (increases aortic diastolic pressure) are critical." },
            { q: "What is the <b>modified Valsalva maneuver</b> for SVT?", a: "Patient performs Valsalva strain (bearing down or blowing into a syringe) for <b>15 seconds</b> in a semi-recumbent position, then is immediately <b>laid flat and legs passively raised to 45°</b> for 15 seconds. The REVERT trial showed this modified technique has <b>43% conversion rate</b> vs. 17% for standard Valsalva." },
            { q: "What is <b>Wolff-Parkinson-White (WPW) syndrome</b> and why is it dangerous with AFib?", a: "WPW has an <b>accessory pathway (Bundle of Kent)</b> that bypasses the AV node. In AFib, impulses can conduct rapidly through the accessory pathway (which has no decremental conduction), causing <b>extremely rapid ventricular rates → VFib</b>.<br><b>Avoid</b>: AV nodal blockers (adenosine, CCBs, beta-blockers, digoxin).<br><b>Treat</b>: <b>Procainamide</b> or <b>synchronized cardioversion</b>." },
            { q: "What are the <b>ECG features of hyperkalemia</b> in order of increasing severity?", a: "Progressive changes with rising K⁺:<br>1. <b>Peaked T waves</b> (earliest, K⁺ 5.5–6.5)<br>2. <b>Prolonged PR interval</b><br>3. <b>Flattened P waves</b> (loss of atrial activity)<br>4. <b>Widened QRS complex</b><br>5. <b>Sine wave pattern</b> (QRS merges with T wave)<br>6. <b>VFib or asystole</b> (K⁺ > 8–9)" },
            { q: "What are the <b>5 H's and 5 T's</b> mnemonic items — summarize treatments in one card.", a: "<b>H's</b>:<br>• <b>Hypovolemia</b> → Volume/blood<br>• <b>Hypoxia</b> → Airway/O₂<br>• <b>H⁺ (acidosis)</b> → Bicarb/ventilation<br>• <b>Hypo/Hyperkalemia</b> → K⁺ correction/Ca²⁺<br>• <b>Hypothermia</b> → Rewarming<br><b>T's</b>:<br>• <b>Tension PTX</b> → Needle decompression<br>• <b>Tamponade</b> → Pericardiocentesis<br>• <b>Toxins</b> → Antidotes<br>• <b>Thrombosis (PE)</b> → Thrombolytics<br>• <b>Thrombosis (MI)</b> → PCI" },
            { q: "What is the role of <b>point-of-care ultrasound (POCUS)</b> during cardiac arrest?", a: "• <b>Identify reversible causes</b>: tamponade (pericardial effusion), PE (RV dilation), hypovolemia (empty IVC), pneumothorax (absent lung sliding)<br>• <b>Pseudo-PEA</b>: Detect cardiac activity not generating palpable pulse<br>• <b>Timing</b>: Perform during <b>rhythm checks</b> (< 10 sec) to <b>minimize CPR interruptions</b><br>• <b>Subxiphoid</b> or <b>parasternal long axis</b> views preferred" },
            { q: "What is <b>ECMO-facilitated CPR (ECPR)</b>?", a: "Use of <b>veno-arterial ECMO (VA-ECMO)</b> during cardiac arrest to provide circulatory support when conventional CPR fails. AHA considers it reasonable for <b>select patients with reversible causes</b> when:<br>• <b>Refractory arrest</b> (no ROSC after 10–20 min of ACLS)<br>• <b>Expertise and equipment</b> available<br>• <b>Potentially reversible etiology</b><br>• The ARREST trial showed improved survival." },
            { q: "What is the <b>door-to-needle time</b> goal for fibrinolytic therapy in STEMI?", a: "<b>≤ 30 minutes</b> from hospital arrival to initiation of fibrinolytic infusion. This applies when PCI is not available within the recommended timeframe (120 min from first medical contact)." },
            { q: "What <b>post-tPA monitoring</b> is required for stroke patients?", a: "• <b>BP monitoring q15 min × 2 hours</b>, then q30 min × 6 hours, then q1h × 16 hours<br>• <b>Neuro checks (NIHSS)</b> q15 min during infusion, then q1h for 24 hours<br>• Maintain <b>BP < 180/105 mmHg</b> for 24 hours<br>• <b>No antiplatelets or anticoagulants</b> for 24 hours<br>• Repeat <b>CT at 24 hours</b> before starting antiplatelets<br>• Watch for <b>angioedema</b> (orolingual — from tPA + ACE inhibitor interaction)" },
            { q: "What is the <b>Sgarbossa criteria</b> for STEMI in the presence of LBBB?", a: "Diagnose STEMI in LBBB when:<br>1. <b>Concordant ST elevation ≥ 1 mm</b> in leads with positive QRS (most specific, 5 points)<br>2. <b>Concordant ST depression ≥ 1 mm</b> in V1–V3 (3 points)<br>3. <b>Discordant ST elevation ≥ 5 mm</b> in leads with negative QRS (least specific, 2 points)<br>Score ≥ 3 points = high probability of STEMI.<br><b>Modified Sgarbossa</b>: Discordant ST/S ratio > 0.25 is more sensitive." },
            { q: "What are the causes of <b>prolonged QT interval</b> that predispose to Torsades de Pointes?", a: "<b>Acquired causes</b> (most common):<br>• Drugs: <b>antiarrhythmics (sotalol, procainamide, dofetilide), antipsychotics, antibiotics (macrolides, fluoroquinolones), methadone</b><br>• <b>Hypokalemia, hypomagnesemia, hypocalcemia</b><br>• <b>Bradycardia</b><br>• <b>Hypothermia</b><br><b>Congenital</b>: Romano-Ward (autosomal dominant), Jervell & Lange-Nielsen (autosomal recessive + deafness)" },
            { q: "What are <b>Beck's triad</b> findings in cardiac tamponade?", a: "1. <b>Hypotension</b> (from decreased cardiac output)<br>2. <b>Jugular venous distension (JVD)</b> (from impaired venous return to the heart)<br>3. <b>Muffled/distant heart sounds</b> (from fluid around the heart)<br>Present in < 50% of cases. <b>Pulsus paradoxus</b> (> 10 mmHg drop in SBP during inspiration) is another classic finding." },
            { q: "What is the <b>CHA₂DS₂-VASc score</b> used for?", a: "Estimates <b>stroke risk</b> in patients with <b>atrial fibrillation</b> to guide anticoagulation:<br><b>C</b> – CHF (1)<br><b>H</b> – Hypertension (1)<br><b>A₂</b> – Age ≥ 75 (2)<br><b>D</b> – Diabetes (1)<br><b>S₂</b> – Stroke/TIA/VTE history (2)<br><b>V</b> – Vascular disease (1)<br><b>A</b> – Age 65–74 (1)<br><b>Sc</b> – Sex category (female = 1)<br>Score ≥ 2 (men) or ≥ 3 (women): <b>oral anticoagulation recommended</b>" },
            { q: "What is <b>commotio cordis</b>?", a: "Sudden cardiac arrest (typically <b>VFib</b>) caused by a blunt <b>precordial impact</b> during the vulnerable period of repolarization (upstroke of the T wave, ~20 ms window). Occurs in <b>young athletes</b> struck by a projectile (baseball, hockey puck). Treatment: <b>immediate CPR and defibrillation</b>. Good prognosis if defibrillated promptly." },
            { q: "What are the <b>immediate post-ROSC priorities</b> (first 20 minutes)?", a: "1. <b>12-lead ECG</b> — evaluate for STEMI<br>2. <b>Optimize ventilation</b>: SpO₂ 92–98%, ETCO₂ 35–45 mmHg, avoid hyperventilation<br>3. <b>Hemodynamics</b>: SBP ≥ 90, MAP ≥ 65, IV fluids/vasopressors as needed<br>4. <b>Initiate TTM</b> if patient remains comatose<br>5. <b>Treat precipitating cause</b> (emergent PCI for STEMI, PE workup, etc.)<br>6. <b>Labs</b>: ABG, lactate, electrolytes, troponin, CBC" },
            { q: "What is <b>dual sequential defibrillation (DSD)</b> for refractory VFib?", a: "Application of <b>two sets of defibrillation pads</b> with near-simultaneous shocks using two defibrillators. Pads placed in <b>anterolateral + anteroposterior</b> positions. Some observational studies and the <b>DOSE VF trial</b> showed improved conversion rates in <b>refractory VFib</b>. AHA considers it a <b>reasonable option</b> when standard defibrillation fails." },
            { q: "What is <b>electrical storm</b> and how is it managed?", a: "<b>≥ 3 episodes of sustained VT/VFib within 24 hours</b>.<br>Management:<br>• <b>Amiodarone IV</b> loading + infusion<br>• <b>Beta-blocker</b> (esmolol or propranolol) — reduces sympathetic drive<br>• <b>Lidocaine infusion</b><br>• <b>Deep sedation</b> or <b>stellate ganglion block</b><br>• <b>Catheter ablation</b> if refractory<br>• Correct underlying cause (ischemia, electrolytes)" },
            { q: "What is the significance of <b>lactate levels</b> in post-cardiac arrest care?", a: "<b>Lactate</b> is a marker of tissue hypoperfusion and anaerobic metabolism. In post-cardiac arrest:<br>• <b>Elevated lactate</b> (> 2 mmol/L) indicates inadequate tissue perfusion<br>• <b>Lactate clearance</b> (decrease ≥ 10% per 2 hours) predicts better outcomes<br>• Used to guide <b>fluid resuscitation and vasopressor therapy</b><br>• Persistent elevation despite resuscitation suggests <b>poor prognosis</b>" },
            { q: "What is the <b>ACLS approach to wide-complex tachycardia of unknown origin</b>?", a: "If uncertain whether WCT is VT or SVT with aberrancy:<br>• <b>Stable</b>: Treat as <b>VT</b> — safer approach. <b>Amiodarone 150 mg IV over 10 min</b> is effective for both VT and many SVTs.<br>• <b>Avoid adenosine if irregular WCT or suspected preexcitation</b><br>• <b>Unstable</b>: Immediate <b>synchronized cardioversion</b> (100 J, escalate)<br>• <b>Pulseless</b>: Defibrillation + standard cardiac arrest algorithm" },
            { q: "What is <b>Multifocal Atrial Tachycardia (MAT)</b> and how is it treated?", a: "<b>≥ 3 different P-wave morphologies</b> with varying PR, PP, and RR intervals. Rate > 100 bpm. Often associated with <b>COPD, hypoxia, hypomagnesemia, theophylline use</b>.<br><b>Treatment</b>:<br>• Treat <b>underlying condition</b> (correct hypoxia, electrolytes)<br>• <b>Magnesium IV</b><br>• <b>Non-dihydropyridine CCBs</b> (diltiazem, verapamil) for rate control<br>• <b>Avoid</b> cardioversion (ineffective) and digoxin" },
            { q: "What is <b>Brugada syndrome</b> and its significance in cardiac arrest?", a: "<b>Genetic sodium channelopathy</b> causing characteristic ECG pattern and risk of sudden cardiac death from <b>VFib</b>. ECG: <b>Coved ST elevation (≥ 2 mm) in V1-V2</b> followed by negative T wave (Type 1 Brugada pattern).<br>• Often young males, cardiac arrest during <b>sleep or fever</b><br>• Treatment: <b>ICD implantation</b> (only definitive prevention)<br>• During arrest: standard VFib protocol; <b>avoid Class IA/IC antiarrhythmics</b>" },
            { q: "What is <b>high-dose insulin euglycemic therapy (HIET)</b> for beta-blocker/CCB overdose?", a: "<b>Regular insulin 1 U/kg IV bolus</b> followed by <b>0.5–1 U/kg/hr infusion</b> (may escalate to 10 U/kg/hr).<br>• Maintain <b>glucose > 100 mg/dL</b> with dextrose infusion (D10 or D25)<br>• Monitor <b>potassium</b> closely (insulin shifts K⁺ intracellularly)<br>• <b>Mechanism</b>: Improves cardiac inotropy by enhancing myocardial glucose uptake independent of catecholamines<br>• Most effective for <b>CCB overdose</b> (especially verapamil/diltiazem)" },
            { q: "What is <b>lipid emulsion (Intralipid) therapy</b> and when is it used?", a: "<b>20% IV lipid emulsion</b>: 1.5 mL/kg bolus over 1 min, then <b>0.25 mL/kg/min infusion</b>. May repeat bolus 1–2 times.<br>Indicated for <b>cardiac arrest or hemodynamic collapse</b> from lipophilic drug toxicity:<br>• <b>Local anesthetic systemic toxicity (LAST)</b> — most established indication<br>• <b>Beta-blockers, CCBs, TCAs</b><br>• <b>Mechanism</b>: Creates a 'lipid sink' that sequesters lipophilic drugs away from tissues" },
            { q: "What is the <b>recovery position</b> and when should it be used?", a: "Placing an <b>unconscious, breathing patient</b> on their <b>side</b> with the <b>top leg bent forward</b> to stabilize position and prevent aspiration.<br><b>Indications</b>: Unresponsive patient with <b>normal breathing and pulse</b> (e.g., post-seizure, post-ROSC with adequate respirations).<br><b>Contraindications</b>: Suspected <b>spinal injury</b>, need for ongoing CPR or advanced interventions." },
            { q: "What is the significance of the <b>10-second pulse check</b> in BLS?", a: "Healthcare providers should check for a <b>carotid pulse (adults) or brachial pulse (infants)</b> for <b>no more than 10 seconds</b>. If no definite pulse is felt within 10 seconds, <b>begin CPR</b>. Prolonged pulse checks delay compressions. Lay rescuers should <b>skip the pulse check</b> and begin CPR if the victim is unresponsive and not breathing normally." },
            { q: "What <b>medication</b> can be given via the <b>endotracheal tube</b> if IV/IO access is unavailable?", a: "Mnemonic: <b>NAVEL</b><br>• <b>N</b>aloxone<br>• <b>A</b>tropine<br>• <b>V</b>asopressin (no longer recommended in ACLS but historically included)<br>• <b>E</b>pinephrine<br>• <b>L</b>idocaine<br>Give at <b>2–2.5× the IV dose</b>, diluted in <b>5–10 mL normal saline or sterile water</b>. ET route is <b>least preferred</b> — establish IO if IV fails." },
            { q: "What are the key features of <b>third-degree (complete) heart block</b>?", a: "• <b>Complete dissociation</b> between atrial and ventricular activity (P waves and QRS complexes are independent)<br>• <b>Regular P-P intervals</b> and <b>regular R-R intervals</b>, but no relationship between them<br>• Ventricular rate determined by <b>escape pacemaker</b>: junctional (40–60 bpm, narrow QRS) or ventricular (20–40 bpm, wide QRS)<br>• <b>High risk</b> for hemodynamic instability and asystole<br>• Requires <b>transcutaneous pacing</b> → <b>transvenous pacing</b>" },
            { q: "How does <b>sodium bicarbonate</b> work in cardiac arrest and when is it indicated?", a: "<b>Buffers hydrogen ions</b> to correct metabolic acidosis.<br><b>Dose</b>: 1 mEq/kg IV.<br><b>Indications</b>:<br>• <b>Known preexisting hyperkalemia</b><br>• <b>Tricyclic antidepressant (TCA) overdose</b> — widens QRS, alkalinizes blood to reduce drug-receptor binding<br>• <b>Preexisting metabolic acidosis</b><br>• <b>Prolonged arrest</b> (considered)<br><b>Not routinely recommended</b> — adequate ventilation and CPR are the primary treatments for arrest-related acidosis." },
            { q: "What is the <b>Utstein style</b> reporting for cardiac arrest outcomes?", a: "A <b>standardized template</b> for reporting cardiac arrest data to allow comparison across systems. Key elements include:<br>• <b>Location of arrest</b> (in/out-of-hospital)<br>• <b>Witnessed status</b><br>• <b>Initial rhythm</b><br>• <b>Bystander CPR</b> rate<br>• <b>ROSC</b> rate<br>• <b>Survival to discharge</b><br>• <b>Neurological outcome</b> (Cerebral Performance Category, CPC 1-2 = good)" }
          ]
        },
        {
          section: 'Emergency Medicine',
          topic: "Trauma management (ATLS advanced)",
          icon: "shield",
          cards: [
            { q: "What is the <b>correct sequence</b> of the ATLS primary survey?", a: "<b>A</b> — Airway with C-spine protection<br><b>B</b> — Breathing and ventilation<br><b>C</b> — Circulation with hemorrhage control<br><b>D</b> — Disability (neurologic status)<br><b>E</b> — Exposure / Environmental control<br><br>Each step is addressed <u>in order</u>; life-threatening problems are treated as identified before moving on." },
            { q: "In the trauma patient, which airway maneuver is preferred and why: <b>jaw thrust</b> or <b>chin lift</b>?", a: "<b>Jaw thrust</b> is preferred because it opens the airway <u>without extending the cervical spine</u>.<br><br>Chin lift (head-tilt) risks exacerbating a potential C-spine injury. If a chin lift is used, it should be a <b>modified chin lift without head tilt</b>." },
            { q: "List <b>5 indications</b> for a definitive airway in trauma.", a: "1. <b>GCS ≤ 8</b> (inability to protect airway)<br>2. Severe maxillofacial fractures<br>3. Risk of aspiration (bleeding, vomiting)<br>4. Risk of obstruction (neck hematoma, laryngeal/tracheal injury, stridor)<br>5. Apnea / inadequate respiratory effort<br><br>A <b>definitive airway</b> = cuffed tube in the trachea, secured, connected to O₂-enriched ventilation." },
            { q: "What is the <b>GCS threshold</b> that mandates endotracheal intubation in ATLS, and why?", a: "<b>GCS ≤ 8</b><br><br>At this level, protective airway reflexes are lost, placing the patient at high risk for <b>aspiration</b> and <b>hypoxia</b>. The patient cannot maintain or protect their own airway." },
            { q: "A trauma patient needs intubation but has a suspected C-spine injury. How should <b>in-line stabilization</b> be performed?", a: "An assistant holds the head and neck in <b>neutral alignment</b> (manual in-line stabilization — MILS) while the front of the cervical collar is removed to allow mouth opening.<br><br>Axial traction is <u>avoided</u>. The goal is to <b>prevent movement</b>, not to apply traction." },
            { q: "When is a <b>surgical airway (cricothyroidotomy)</b> indicated in trauma?", a: "When a definitive airway is needed but <b>orotracheal or nasotracheal intubation is impossible or contraindicated</b>:<br>• Severe maxillofacial trauma<br>• Massive oropharyngeal hemorrhage<br>• Laryngeal distortion / edema preventing tube passage<br><br><b>Contraindication:</b> Age < 12 years (use needle cricothyroidotomy with jet insufflation instead)." },
            { q: "How do you <b>clinically diagnose</b> a tension pneumothorax?", a: "• <b>Hypotension</b> + <b>respiratory distress</b><br>• <b>Absent breath sounds</b> on affected side<br>• <b>Tracheal deviation</b> away from affected side (late sign)<br>• <b>Distended neck veins</b> (may be absent if hypovolemic)<br>• <b>Hyperresonance</b> to percussion<br><br>This is a <u>clinical diagnosis</u> — do <b>NOT</b> delay treatment for imaging." },
            { q: "Where is <b>needle decompression</b> performed for tension pneumothorax? Give <b>both</b> accepted sites.", a: "<b>1. 2nd intercostal space, midclavicular line</b> (classical ATLS site)<br><b>2. 4th–5th intercostal space, anterior axillary line</b> (preferred in recent ATLS updates — higher success rate, especially in muscular/obese patients)<br><br>Insert over the <u>superior border</u> of the rib to avoid the neurovascular bundle." },
            { q: "How is an <b>open pneumothorax</b> (sucking chest wound) initially managed?", a: "Apply an <b>occlusive (three-sided) dressing</b>:<br>• Taped on <b>3 sides</b>, leaving 1 side open as a flutter valve<br>• Allows air to escape during expiration but prevents entry during inspiration<br><br>A <b>chest tube</b> should then be placed at a <u>separate site</u> (not through the wound), followed by definitive wound closure." },
            { q: "Define <b>massive hemothorax</b> and state its management.", a: "<b>Definition:</b> > <b>1,500 mL</b> blood immediately drained after chest tube insertion, <u>OR</u> > <b>200 mL/hr</b> ongoing drainage for 2–4 hours.<br><br><b>Management:</b><br>1. Large-bore (36–40 Fr) chest tube<br>2. Volume resuscitation / massive transfusion protocol<br>3. <b>Emergent thoracotomy</b> if criteria met" },
            { q: "What is <b>flail chest</b> and what causes the respiratory compromise?", a: "<b>Flail chest</b> = ≥ 2 consecutive ribs fractured in ≥ 2 places, creating a free-floating segment.<br><br><b>Paradoxical movement:</b> segment moves <u>inward</u> on inspiration, <u>outward</u> on expiration.<br><br>The main cause of hypoxia is the underlying <b>pulmonary contusion</b>, not the paradoxical wall motion. Management: pain control, positive-pressure ventilation if needed." },
            { q: "Describe <b>Class I hemorrhage</b> with estimated blood loss and vital sign changes.", a: "<b>Class I:</b><br>• Blood loss: up to <b>750 mL</b> (≤ 15% blood volume)<br>• Heart rate: <b>< 100</b><br>• Blood pressure: <b>Normal</b><br>• Respiratory rate: <b>14–20</b><br>• Mental status: <b>Slightly anxious</b><br>• Urine output: <b>≥ 30 mL/hr</b><br><br>Example: routine blood donation." },
            { q: "Describe <b>Class II hemorrhage</b> with estimated blood loss and vital sign changes.", a: "<b>Class II:</b><br>• Blood loss: <b>750–1,500 mL</b> (15–30%)<br>• Heart rate: <b>100–120</b><br>• Blood pressure: <b>Normal</b> (narrowed pulse pressure)<br>• Respiratory rate: <b>20–30</b><br>• Mental status: <b>Anxious</b><br>• Urine output: <b>20–30 mL/hr</b><br><br>Usually responds to <b>crystalloid</b> alone." },
            { q: "Describe <b>Class III hemorrhage</b> with estimated blood loss and vital sign changes.", a: "<b>Class III:</b><br>• Blood loss: <b>1,500–2,000 mL</b> (30–40%)<br>• Heart rate: <b>120–140</b><br>• Blood pressure: <b>Decreased</b><br>• Respiratory rate: <b>30–40</b><br>• Mental status: <b>Confused</b><br>• Urine output: <b>5–15 mL/hr</b><br><br>Requires <b>crystalloid + blood products</b>." },
            { q: "Describe <b>Class IV hemorrhage</b> with estimated blood loss and vital sign changes.", a: "<b>Class IV:</b><br>• Blood loss: <b>> 2,000 mL</b> (> 40%)<br>• Heart rate: <b>> 140</b> (may become bradycardic preterminally)<br>• Blood pressure: <b>Markedly decreased</b><br>• Respiratory rate: <b>> 35</b><br>• Mental status: <b>Lethargic / obtunded</b><br>• Urine output: <b>Negligible</b><br><br><b>Immediately life-threatening</b> — requires massive transfusion and likely operative intervention." },
            { q: "What is the <b>massive transfusion protocol (MTP)</b> ratio and when is it activated?", a: "<b>Ratio: 1:1:1</b> — packed RBCs : fresh frozen plasma : platelets.<br><br><b>Activation criteria</b> (varies by institution):<br>• Anticipated need for ≥ 10 units pRBCs in 24 hrs<br>• Hemodynamic instability despite initial resuscitation<br>• Class III/IV hemorrhage<br>• Positive FAST with hemodynamic instability<br><br>Goal: replicate <b>whole blood</b> to prevent coagulopathy." },
            { q: "What are the <b>4 windows</b> of the FAST (Focused Assessment with Sonography for Trauma) exam?", a: "1. <b>Right upper quadrant (RUQ)</b> — Morrison's pouch (hepatorenal recess)<br>2. <b>Left upper quadrant (LUQ)</b> — splenorenal recess + left paracolic gutter<br>3. <b>Subxiphoid / pericardial</b> — pericardial effusion<br>4. <b>Suprapubic / pelvic</b> — rectovesical (♂) or rectouterine (♀) pouch<br><br>Detects <b>free fluid</b> (as little as 200 mL in Morrison's pouch)." },
            { q: "What are the <b>indications for DPL</b> (Diagnostic Peritoneal Lavage) in trauma?", a: "DPL is used when <b>FAST is equivocal</b> or <b>unavailable</b>, and the patient is <b>hemodynamically unstable</b> (cannot go to CT).<br><br><b>Positive DPL</b> for blunt trauma:<br>• ≥ 10 mL gross blood on aspiration<br>• RBC > 100,000/mm³<br>• WBC > 500/mm³<br>• Bile, bacteria, or food particles<br><br>Largely replaced by FAST and CT, but still tested on exams." },
            { q: "What is <b>permissive hypotension</b> and what is the target SBP?", a: "<b>Permissive hypotension</b> = accepting a lower-than-normal BP to avoid disrupting early clot formation from aggressive fluid resuscitation.<br><br><b>Target SBP: 80–90 mmHg</b> (MAP ~50) in hemorrhagic shock.<br><br><b>Contraindication:</b> <u>Traumatic brain injury</u> — hypotension worsens secondary brain injury; maintain SBP ≥ 90 in TBI." },
            { q: "What are the <b>5 non-compressible sites</b> of hemorrhage to consider in the shocked trauma patient ('blood on the floor and 4 more')?", a: "1. <b>External</b> (floor)<br>2. <b>Thorax</b> (hemothorax)<br>3. <b>Abdomen/pelvis</b> (intraperitoneal)<br>4. <b>Retroperitoneum</b> (pelvic fracture, retroperitoneal vessels)<br>5. <b>Long bones</b> (femur fracture — up to 1,500 mL per femur)<br><br>Mnemonic: <i>blood on the floor and 4 more</i>." },
            { q: "What are the <b>3 components</b> of the Glasgow Coma Scale and their score ranges?", a: "<b>Eye Opening (E):</b> 1–4<br>• 4 Spontaneous, 3 To voice, 2 To pain, 1 None<br><br><b>Verbal Response (V):</b> 1–5<br>• 5 Oriented, 4 Confused, 3 Inappropriate words, 2 Incomprehensible sounds, 1 None<br><br><b>Motor Response (M):</b> 1–6<br>• 6 Obeys commands, 5 Localizes pain, 4 Withdrawal, 3 Abnormal flexion, 2 Extension, 1 None<br><br><b>Total range: 3–15</b>" },
            { q: "What GCS scores define <b>mild, moderate, and severe</b> TBI?", a: "<b>Mild TBI:</b> GCS <b>13–15</b><br><b>Moderate TBI:</b> GCS <b>9–12</b><br><b>Severe TBI:</b> GCS <b>3–8</b><br><br>Severe TBI (GCS ≤ 8) mandates <b>definitive airway</b> management." },
            { q: "During the primary survey, what <b>pupil findings</b> are assessed and what do they indicate?", a: "Assess <b>size, equality, and reactivity</b> of both pupils.<br><br>• <b>Unilateral fixed, dilated pupil</b> → ipsilateral uncal herniation compressing CN III (until proven otherwise)<br>• <b>Bilateral fixed, dilated pupils</b> → bilateral herniation, severe brainstem injury, or drug effect<br>• <b>Bilateral pinpoint pupils</b> → pontine lesion or opioid toxicity<br><br>Always correlate with GCS and mechanism." },
            { q: "What does <b>'E' (Exposure)</b> in the primary survey entail?", a: "• <b>Completely undress</b> the patient to identify all injuries<br>• Perform a <b>log roll</b> to inspect the back<br>• <b>Prevent hypothermia</b>: warm blankets, warmed IV fluids, warm environment<br><br>Hypothermia is part of the <b>lethal triad</b> (hypothermia, acidosis, coagulopathy) and worsens outcomes." },
            { q: "What is the <b>lethal triad</b> (trauma triad of death)?", a: "1. <b>Hypothermia</b><br>2. <b>Acidosis</b> (metabolic — lactic acidosis from hypoperfusion)<br>3. <b>Coagulopathy</b><br><br>Each element exacerbates the others in a <b>vicious cycle</b>. Management: <b>damage control resuscitation</b> — permissive hypotension, massive transfusion 1:1:1, limit crystalloid, prevent heat loss, early surgical hemorrhage control." },
            { q: "When does the <b>secondary survey</b> begin, and what does it involve?", a: "Begins <b>after</b> the primary survey is complete and resuscitation is underway with demonstrating <b>normalization of vital signs</b>.<br><br>Involves:<br>• <b>Complete head-to-toe physical examination</b><br>• <b>AMPLE history</b><br>• Reassessment of all vital signs<br>• Adjunct studies (X-rays, labs, CT)" },
            { q: "What does the <b>AMPLE</b> mnemonic stand for?", a: "<b>A</b> — Allergies<br><b>M</b> — Medications (including anticoagulants, antiplatelets)<br><b>P</b> — Past medical / surgical history, Pregnancy<br><b>L</b> — Last meal (aspiration risk, anesthesia planning)<br><b>E</b> — Events / Environment related to the injury" },
            { q: "What are the <b>contraindications to Foley catheter</b> placement in trauma?", a: "Suspect <b>urethral injury</b> — do NOT pass a Foley until ruled out.<br><br><b>Signs of urethral injury:</b><br>• <b>Blood at the urethral meatus</b><br>• <b>High-riding or non-palpable prostate</b> (on DRE)<br>• <b>Perineal/scrotal ecchymosis</b> (butterfly pattern)<br>• Pelvic fracture<br><br>Obtain a <b>retrograde urethrogram</b> first if any signs are present." },
            { q: "When is a <b>nasogastric tube contraindicated</b> in trauma? What is the alternative?", a: "<b>Contraindicated in suspected midface / basilar skull fractures</b> — risk of intracranial placement through the cribriform plate.<br><br><b>Signs:</b> raccoon eyes, Battle sign, CSF rhinorrhea, midface instability<br><br><b>Alternative:</b> <b>Orogastric (OG) tube</b>" },
            { q: "What is an <b>epidural hematoma (EDH)</b>? Describe the classic presentation and CT finding.", a: "<b>Epidural hematoma:</b> arterial bleed between skull and dura mater, most commonly from the <b>middle meningeal artery</b> (temporal bone fracture).<br><br><b>Classic presentation:</b> initial LOC → <b>lucid interval</b> → rapid deterioration<br><br><b>CT:</b> <b>Biconvex (lens-shaped)</b> hyperdense collection that does <u>not</u> cross suture lines." },
            { q: "What is a <b>subdural hematoma (SDH)</b>? Describe the cause and CT finding.", a: "<b>Subdural hematoma:</b> venous bleed between dura and arachnoid, from torn <b>bridging veins</b>.<br><br><b>Risk factors:</b> elderly, alcoholics, anticoagulated patients (brain atrophy → stretched bridging veins)<br><br><b>CT:</b> <b>Crescent-shaped</b> hyperdense (acute) collection that <u>crosses suture lines</u> but not the midline falx." },
            { q: "Compare <b>acute vs. chronic subdural hematoma</b> on CT.", a: "<b>Acute SDH (< 3 days):</b> <b>Hyperdense</b> (bright white) crescent<br><b>Subacute SDH (3 days–3 weeks):</b> <b>Isodense</b> (may be missed)<br><b>Chronic SDH (> 3 weeks):</b> <b>Hypodense</b> (dark) crescent<br><br>Chronic SDH may have <b>membranes</b> and re-bleed (mixed density)." },
            { q: "What is <b>diffuse axonal injury (DAI)</b> and how does it present?", a: "<b>DAI</b> = shearing of axons due to <b>rotational acceleration/deceleration</b> forces.<br><br><b>Presentation:</b> Immediate unconsciousness / coma disproportionate to CT findings.<br><br><b>CT:</b> often <u>normal</u> or shows small punctate hemorrhages at <b>gray-white matter junction, corpus callosum, brainstem</b>.<br><br><b>MRI</b> is far more sensitive. Prognosis is generally <b>poor</b>." },
            { q: "What are the clinical signs of a <b>basilar skull fracture</b>?", a: "• <b>Raccoon eyes</b> (periorbital ecchymosis) — anterior fossa fracture<br>• <b>Battle sign</b> (postauricular ecchymosis) — middle fossa / petrous bone fracture<br>• <b>CSF rhinorrhea</b> (anterior fossa) or <b>CSF otorrhea</b> (middle fossa)<br>• <b>Hemotympanum</b> (blood behind tympanic membrane)<br>• Cranial nerve palsies (VII, VIII most common)<br><br>Diagnosis is <b>clinical</b>; CT may show fracture lines." },
            { q: "How do you differentiate <b>CSF</b> from other nasal/ear discharge in basilar skull fracture?", a: "<b>Halo (ring) sign:</b> drop fluid on gauze — CSF migrates further than blood, forming a <b>clear halo</b> around a central blood stain.<br><br><b>Beta-2 transferrin test:</b> <b>confirmatory</b> — present only in CSF, perilymph, and aqueous humor. Highly specific for CSF leak." },
            { q: "What is <b>Cushing's triad</b> and what does it signify?", a: "<b>Cushing's triad:</b><br>1. <b>Hypertension</b> (widened pulse pressure)<br>2. <b>Bradycardia</b><br>3. <b>Irregular respirations</b><br><br>Indicates <b>dangerously elevated ICP</b> with impending <b>brainstem herniation</b>. This is a <u>late</u> and <u>ominous</u> sign requiring emergent intervention." },
            { q: "Describe the <b>medical management of elevated ICP</b> in severe TBI.", a: "1. <b>Head of bed elevation 30°</b>, head midline<br>2. <b>Hyperventilation</b> (temporary bridge — target PaCO₂ 30–35 mmHg)<br>3. <b>Mannitol</b> (0.25–1 g/kg IV) — osmotic diuresis; avoid if hypotensive<br>4. <b>Hypertonic saline</b> (3% or 23.4%) — preferred if hypotensive; no rebound effect<br>5. <b>Sedation</b> (propofol, barbiturates)<br>6. <b>EVD</b> (external ventricular drain) for CSF drainage<br>7. Target <b>ICP < 22 mmHg</b>, <b>CPP 60–70 mmHg</b>" },
            { q: "Compare <b>mannitol vs. hypertonic saline</b> for ICP management.", a: "<table><tr><th></th><th>Mannitol</th><th>Hypertonic Saline</th></tr><tr><td><b>Mechanism</b></td><td>Osmotic diuresis</td><td>Osmotic shift without diuresis</td></tr><tr><td><b>Effect on BP</b></td><td>May ↓ BP (diuresis)</td><td>May ↑ BP (volume expansion)</td></tr><tr><td><b>Contraindication</b></td><td>Hypotension, hypovolemia</td><td>Hypernatremia (Na > 160)</td></tr><tr><td><b>Rebound</b></td><td>Possible</td><td>Less likely</td></tr></table><br>Hypertonic saline preferred in <b>hypotensive</b> patients." },
            { q: "What is an <b>EVD (External Ventricular Drain)</b> and when is it indicated?", a: "<b>EVD</b> = catheter placed into the <b>lateral ventricle</b> (usually via Kocher's point) to drain CSF and <b>directly monitor ICP</b>.<br><br><b>Indications:</b><br>• Severe TBI (GCS ≤ 8) with abnormal CT<br>• Obstructive hydrocephalus<br>• ICP monitoring and therapeutic CSF drainage<br><br><b>Target ICP:</b> < 22 mmHg (Brain Trauma Foundation guidelines)" },
            { q: "What is the <b>cerebral perfusion pressure (CPP)</b> formula and target?", a: "\\( CPP = MAP - ICP \\)<br><br><b>Target CPP: 60–70 mmHg</b><br><br>If CPP falls below 60, cerebral ischemia occurs. If ICP rises, MAP must be supported (vasopressors) while ICP is lowered." },
            { q: "What are the <b>NEXUS criteria</b> for clearing the C-spine clinically?", a: "The C-spine can be cleared <b>without imaging</b> if <u>ALL 5</u> are met:<br><br>1. <b>No midline cervical tenderness</b><br>2. <b>No focal neurologic deficit</b><br>3. <b>Normal alertness</b><br>4. <b>No intoxication</b><br>5. <b>No painful distracting injury</b><br><br>If ANY criterion is not met → imaging is required." },
            { q: "Outline the <b>Canadian C-Spine Rules (CCR)</b>.", a: "<b>Step 1 — High-risk factors</b> (mandates imaging):<br>• Age ≥ 65, dangerous mechanism, paresthesias in extremities<br><br><b>Step 2 — Low-risk factors</b> (allows ROM assessment):<br>• Simple rear-end MVC, seated in ED, ambulatory, delayed neck pain, no midline tenderness<br><br><b>Step 3:</b> Can patient <b>actively rotate neck 45°</b> L and R?<br>• Yes → No imaging needed<br>• No → Imaging required<br><br>CCR is more sensitive and specific than NEXUS." },
            { q: "Differentiate <b>spinal shock</b> from <b>neurogenic shock</b>.", a: "<b>Spinal shock:</b><br>• <b>Temporary</b> loss of all spinal cord function <u>below</u> the level of injury<br>• Flaccid paralysis, areflexia, loss of sensation<br>• Can last hours to weeks<br>• Resolution heralded by return of <b>bulbocavernosus reflex</b><br><br><b>Neurogenic shock:</b><br>• <b>Hemodynamic</b> state — loss of sympathetic tone<br>• <b>Hypotension + bradycardia + warm/dry skin</b> (vasodilation)<br>• Occurs with injuries above <b>T6</b><br>• Treatment: fluids ± vasopressors (phenylephrine/norepinephrine)" },
            { q: "Describe <b>anterior cord syndrome</b>: mechanism, deficits, and prognosis.", a: "<b>Mechanism:</b> occlusion of the <b>anterior spinal artery</b> or direct anterior cord compression (burst fractures, disc herniation).<br><br><b>Deficits:</b><br>• Loss of <b>motor function</b> (corticospinal tracts)<br>• Loss of <b>pain and temperature</b> (spinothalamic tracts)<br>• <b>Preserved</b>: proprioception, vibration, light touch (posterior columns)<br><br><b>Prognosis:</b> <b>Worst</b> of the incomplete cord syndromes (~10–20% recovery)." },
            { q: "Describe <b>central cord syndrome</b>: mechanism, deficits, and prognosis.", a: "<b>Mechanism:</b> Hyperextension injury, typically in <b>elderly with cervical spondylosis</b>.<br><br><b>Deficits:</b><br>• <b>Upper extremity weakness > lower extremity</b> (\"cape-like\" distribution)<br>• Variable sensory loss<br>• Bladder dysfunction<br><br><b>Prognosis:</b> <b>Best</b> of the incomplete cord syndromes — lower extremities recover first, then bladder, then upper extremities. Fine hand motor function recovers last." },
            { q: "Describe <b>Brown-Séquard syndrome</b>: mechanism, deficits, and prognosis.", a: "<b>Mechanism:</b> <b>Hemisection</b> of the spinal cord (classically from penetrating trauma).<br><br><b>Ipsilateral:</b><br>• Loss of <b>motor function</b> (corticospinal tract)<br>• Loss of <b>proprioception / vibration</b> (dorsal columns)<br><br><b>Contralateral:</b><br>• Loss of <b>pain and temperature</b> (spinothalamic tract — crosses 1–2 levels above entry)<br><br><b>Prognosis:</b> <b>Best overall prognosis</b> — >90% regain ambulatory function." },
            { q: "What is <b>SCIWORA</b> and in whom is it most common?", a: "<b>SCIWORA = Spinal Cord Injury Without Radiographic Abnormality</b><br><br>• Most common in <b>children < 8 years</b><br>• Due to the <b>elastic pediatric spine</b> — ligaments and vertebrae stretch without fracturing, but the cord is injured<br>• Plain films and CT are <b>normal</b><br>• <b>MRI</b> is the imaging modality of choice for diagnosis<br>• May have delayed neurologic deterioration" },
            { q: "What is the current stance on <b>methylprednisolone</b> in acute spinal cord injury?", a: "<b>NOT recommended</b> by current ATLS and AANS/CNS guidelines.<br><br>The NASCIS trials (basis for its historical use) had significant <b>methodological flaws</b>.<br><br><b>Risks:</b> increased infection (pneumonia, sepsis), GI bleeding, hyperglycemia, wound complications.<br><br>Some centers still offer it as an <b>option</b> (not standard of care) within 8 hours of injury, but the <b>evidence does not support routine use</b>." },
            { q: "What is <b>Beck's triad</b> and what does it indicate?", a: "<b>Beck's triad</b> — classic signs of <b>cardiac tamponade</b>:<br><br>1. <b>Hypotension</b><br>2. <b>Distended neck veins</b> (JVD)<br>3. <b>Muffled heart sounds</b><br><br>The triad may be incomplete in the hypovolemic trauma patient (JVD may be absent). Confirmed with <b>FAST</b> (subxiphoid view) showing pericardial fluid." },
            { q: "How is <b>cardiac tamponade</b> managed in trauma?", a: "<b>Acute management:</b><br>• IV fluid bolus (temporizing — increases preload)<br>• <b>Pericardiocentesis</b> (subxiphoid approach, needle directed toward left shoulder) — <u>temporizing measure</u><br><br><b>Definitive management:</b><br>• <b>Emergency thoracotomy / sternotomy</b> with pericardiotomy and repair<br><br>Removal of as little as <b>15–20 mL</b> can dramatically improve hemodynamics." },
            { q: "What is the <b>most common CXR finding</b> in traumatic aortic injury, and what is the diagnostic study of choice?", a: "<b>CXR finding:</b> <b>Widened mediastinum</b> (> 8 cm at T4 level)<br><br>Other CXR signs:<br>• Loss of aortic knob contour<br>• Left apical cap<br>• Deviation of NG tube / trachea to the right<br>• Depression of left mainstem bronchus<br>• Left hemothorax<br><br><b>Diagnostic study:</b> <b>CT angiography (CTA) of the chest</b> — gold standard<br><br>Most common location: <b>aortic isthmus</b> (distal to left subclavian, at ligamentum arteriosum)." },
            { q: "What is the most common site of <b>traumatic aortic rupture</b> and why?", a: "The <b>aortic isthmus</b> — just distal to the origin of the <b>left subclavian artery</b>, at the <b>ligamentum arteriosum</b>.<br><br><b>Why:</b> This is the junction between the relatively mobile aortic arch and the fixed descending aorta. During rapid deceleration, shear forces are maximal at this fixation point.<br><br>~85% of patients with complete rupture <b>die at the scene</b>." },
            { q: "Describe the presentation and management of <b>pulmonary contusion</b>.", a: "<b>Presentation:</b><br>• Hypoxia, tachypnea, often associated with flail chest<br>• CXR: patchy alveolar infiltrate (may be <b>delayed 6–24 hrs</b>)<br>• CT chest is more sensitive than CXR<br><br><b>Management:</b><br>• Supportive: O₂, judicious fluids (avoid overhydration)<br>• Pain management (intercostal nerve blocks, epidural)<br>• <b>Intubation and mechanical ventilation</b> if respiratory failure<br>• Avoid excess crystalloid — worsens contusion" },
            { q: "How does <b>tracheobronchial injury</b> present and what is the classic finding?", a: "<b>Presentation:</b><br>• Hemoptysis, subcutaneous emphysema, respiratory distress<br>• <b>Persistent large air leak</b> after chest tube placement (pneumothorax that does not resolve)<br>• Pneumomediastinum<br><br><b>Classic finding:</b> <b>Fallen lung sign</b> — lung falls laterally/dependently (away from hilum) rather than collapsing toward hilum<br><br><b>Diagnosis:</b> Bronchoscopy (definitive)<br><b>Treatment:</b> Surgical repair" },
            { q: "What is the classic presentation of <b>esophageal perforation</b> in trauma?", a: "• <b>Left pneumothorax or hemothorax</b> without rib fracture<br>• <b>Mediastinal air</b> (pneumomediastinum)<br>• Particulate matter in chest tube drainage<br>• Pain, fever, tachycardia (may develop <b>mediastinitis</b>)<br><br><b>Diagnosis:</b> Esophagography (water-soluble contrast → then barium if negative) or CT with oral contrast<br><b>Treatment:</b> Surgical repair (high morbidity/mortality if delayed > 24 hrs)" },
            { q: "How does <b>diaphragmatic rupture</b> present and which side is more commonly diagnosed?", a: "<b>Left side</b> is more commonly <b>diagnosed</b> (because the liver protects the right hemidiaphragm and may plug the defect).<br><br><b>CXR findings:</b><br>• Elevated hemidiaphragm<br>• <b>Bowel or NG tube in the chest</b><br>• Obscured diaphragmatic border<br><br><b>Diagnosis:</b> CT chest/abdomen (sensitivity ~60–80%), definitive via thoracoscopy/laparoscopy<br><b>Treatment:</b> Surgical repair (will not heal spontaneously; risk of herniation and strangulation)" },
            { q: "What is the <b>initial management algorithm</b> for blunt abdominal trauma?", a: "<b>Hemodynamically UNSTABLE:</b><br>• FAST → <b>Positive:</b> Emergent laparotomy<br>• FAST → <b>Negative:</b> Search for other causes of shock; consider DPL if FAST equivocal<br><br><b>Hemodynamically STABLE:</b><br>• <b>CT abdomen/pelvis with IV contrast</b> — gold standard for evaluating solid organ injury<br>• Serial abdominal exams<br>• FAST can be used as screening" },
            { q: "What is the management algorithm for <b>penetrating abdominal trauma</b> (gunshot vs. stab wound)?", a: "<b>Gunshot wound to abdomen:</b><br>• <b>Mandatory exploratory laparotomy</b> in most cases (unless tangential/superficial)<br><br><b>Stab wound to abdomen:</b><br>• <b>Unstable / peritonitis / evisceration:</b> Emergent laparotomy<br>• <b>Stable, no peritonitis:</b> Options include:<br>  – Local wound exploration (if fascia intact → observe)<br>  – CT with triple contrast<br>  – Serial abdominal exams (q4–6hrs for 24 hrs)" },
            { q: "What are the <b>absolute indications for laparotomy</b> in abdominal trauma?", a: "1. <b>Hemodynamic instability</b> with positive FAST/DPL<br>2. <b>Peritonitis</b> (diffuse guarding, rigidity)<br>3. <b>Evisceration</b> of abdominal contents<br>4. <b>Free air</b> under diaphragm (hollow viscus injury)<br>5. <b>Diaphragmatic rupture</b><br>6. <b>Gunshot wound</b> traversing the peritoneal cavity<br>7. <b>Impalement</b> injury (do NOT remove in field)" },
            { q: "What is the most commonly injured <b>solid organ</b> in blunt abdominal trauma?", a: "The <b>spleen</b> is the most commonly injured solid organ in blunt abdominal trauma.<br><br>The <b>liver</b> is the most commonly injured organ in <b>penetrating</b> abdominal trauma.<br><br><b>Non-operative management</b> of splenic injury is appropriate in <b>hemodynamically stable</b> patients — involves serial exams, ICU monitoring, and repeat imaging." },
            { q: "What determines <b>operative vs. non-operative management</b> of solid organ injuries (spleen, liver, kidney)?", a: "<b>Non-operative management</b> if:<br>• Hemodynamically <b>stable</b><br>• No peritonitis<br>• Low-grade injury (I–III)<br>• Reliable serial exam (no distracting injuries, alert patient)<br>• ICU monitoring available<br>• Interventional radiology available for angioembolization<br><br><b>Operative management</b> if:<br>• Hemodynamically <b>unstable despite resuscitation</b><br>• High-grade injury (IV–V) with active hemorrhage<br>• Peritonitis / hollow viscus injury<br>• Failed non-operative management" },
            { q: "What is the <b>seatbelt sign</b> and what injuries should it raise suspicion for?", a: "<b>Seatbelt sign:</b> Linear ecchymosis across the abdomen from a lap belt.<br><br><b>Associated injuries:</b><br>• <b>Hollow viscus injury</b> (small bowel perforation — most common)<br>• <b>Mesenteric tear / avulsion</b><br>• <b>Chance fracture</b> (lumbar spine)<br>• <b>Pancreatic injury</b><br><br>A seatbelt sign increases the risk of intra-abdominal injury <b>8-fold</b> and warrants CT or serial exams." },
            { q: "What is a <b>Chance fracture</b> and what is it associated with?", a: "<b>Chance fracture</b> = horizontal splitting fracture through the <b>vertebral body</b> (and posterior elements) of the <b>thoracolumbar spine</b> (typically L1–L3).<br><br><b>Mechanism:</b> Flexion-distraction injury — lap seatbelt acts as a fulcrum.<br><br><b>Association:</b> <b>Intra-abdominal injuries</b> in up to <b>50%</b> of cases (hollow viscus, mesenteric, aortic). Always perform abdominal CT." },
            { q: "What are <b>retroperitoneal injuries</b> in trauma and why are they challenging?", a: "<b>Retroperitoneal organs:</b> kidneys, pancreas (body/tail partially), aorta, IVC, duodenum (2nd–4th parts), ureters, ascending/descending colon.<br><br><b>Challenges:</b><br>• <b>Not detected by FAST or DPL</b> (retroperitoneal blood ≠ intraperitoneal fluid)<br>• Physical exam may be unreliable<br>• <b>CT abdomen/pelvis</b> is the modality of choice<br>• Pelvic fractures can cause massive retroperitoneal hemorrhage (up to 4L)" },
            { q: "What is the <b>Gustilo-Anderson classification</b> of open fractures?", a: "<b>Type I:</b> Wound <b>< 1 cm</b>, clean, minimal soft-tissue damage, simple fracture pattern<br><br><b>Type II:</b> Wound <b>1–10 cm</b>, moderate soft-tissue damage, no flap/avulsion<br><br><b>Type III:</b> Wound <b>> 10 cm</b> or extensive soft-tissue injury:<br>• <b>IIIA:</b> Adequate soft-tissue coverage despite extensive laceration<br>• <b>IIIB:</b> Extensive soft-tissue loss requiring flap coverage; periosteal stripping<br>• <b>IIIC:</b> Vascular injury requiring repair (regardless of wound size)" },
            { q: "What is the initial management of an <b>open fracture</b>?", a: "1. <b>Sterile dressing</b> and wound irrigation (do NOT repeatedly examine)<br>2. <b>Realignment / splinting</b><br>3. <b>Tetanus prophylaxis</b><br>4. <b>IV antibiotics within 1 hour:</b><br>  – Type I/II: <b>1st-gen cephalosporin</b> (cefazolin)<br>  – Type III: Add <b>aminoglycoside</b> (gentamicin)<br>  – Farm/soil contamination: Add <b>penicillin</b> (for Clostridium)<br>5. Emergent <b>operative irrigation, debridement, and fixation</b> (ideally within 6 hours)" },
            { q: "What are the <b>5 P's</b> of compartment syndrome?", a: "1. <b>Pain</b> — out of proportion, worsened by <b>passive stretch</b> (earliest and most reliable)<br>2. <b>Pressure</b> — firm, tense compartment on palpation<br>3. <b>Paresthesias</b> — altered sensation (early nerve ischemia)<br>4. <b>Paralysis</b> — late finding indicating significant damage<br>5. <b>Pulselessness</b> — very late; <u>pulses are often preserved</u> until late stages<br><br><b>Key:</b> Do NOT wait for all 5 P's — <b>pain on passive stretch</b> is the earliest warning." },
            { q: "What are the <b>diagnostic pressure criteria</b> for compartment syndrome?", a: "<b>Absolute pressure:</b> > <b>30 mmHg</b> (abnormal compartment pressure)<br><br><b>Delta pressure (ΔP):</b> Diastolic BP − compartment pressure < <b>30 mmHg</b><br><br>ΔP < 30 mmHg is considered more clinically reliable, especially in hypotensive patients.<br><br><b>Treatment:</b> Emergent <b>fasciotomy</b> — ALL compartments of the affected limb must be released." },
            { q: "What is the definitive treatment for <b>compartment syndrome</b>?", a: "<b>Emergent fasciotomy</b> — must release ALL compartments in the affected limb.<br><br><b>Leg (most common):</b> 4 compartments — anterior, lateral, superficial posterior, deep posterior<br>• Performed via <b>2-incision technique</b> (medial and lateral)<br><br><b>Forearm:</b> 3 compartments — volar, dorsal, lateral (mobile wad)<br><br>Delay > <b>6–8 hours</b> → risk of Volkmann ischemic contracture, rhabdomyolysis, limb loss, renal failure." },
            { q: "How are <b>pelvic fractures</b> managed in the hemodynamically unstable patient?", a: "<b>Initial stabilization:</b><br>1. <b>Pelvic binder / sheet</b> — reduces pelvic volume, tamponades venous bleeding<br>2. Massive transfusion protocol<br>3. Avoid log roll / repeated manipulation<br><br><b>If still unstable:</b><br>• <b>Angioembolization</b> — for <b>arterial bleeding</b> (CT shows contrast extravasation)<br>• <b>Preperitoneal packing</b> — for venous bleeding<br>• <b>External fixation</b> — if binder inadequate<br><br>Most pelvic hemorrhage is <b>venous</b> (85%) from the presacral plexus." },
            { q: "What is <b>fat embolism syndrome (FES)</b> and what is the classic triad?", a: "<b>FES</b> occurs 24–72 hours after long bone (usually <b>femur</b>) or pelvic fractures.<br><br><b>Classic triad (Gurd's criteria):</b><br>1. <b>Respiratory distress</b> (dyspnea, hypoxia, ARDS-like picture) — most common<br>2. <b>Neurologic changes</b> (confusion, agitation, coma)<br>3. <b>Petechial rash</b> (upper body, axillae, conjunctivae) — pathognomonic but appears <u>late</u><br><br><b>Management:</b> Supportive (O₂, fluids, mechanical ventilation if needed). Early fracture fixation reduces risk." },
            { q: "Describe the <b>Rule of 9's</b> for estimating %TBSA in <b>adult</b> burns.", a: "• <b>Head/neck:</b> 9%<br>• <b>Each upper extremity:</b> 9%<br>• <b>Anterior trunk:</b> 18%<br>• <b>Posterior trunk:</b> 18%<br>• <b>Each lower extremity:</b> 18%<br>• <b>Perineum/genitalia:</b> 1%<br><br><b>Total = 100%</b><br><br>Patient's palm (including fingers) ≈ <b>1% TBSA</b> — useful for estimating scattered burns." },
            { q: "How does the <b>Rule of 9's differ in children</b> compared to adults?", a: "<b>Children</b> have proportionally <b>larger heads</b> and <b>smaller legs</b>:<br><br>• <b>Head:</b> 18% (vs. 9% in adults)<br>• <b>Each lower extremity:</b> 14% (vs. 18% in adults)<br>• Trunk and upper extremities remain approximately the same<br><br>The <b>Lund-Browder chart</b> is more accurate for children as it adjusts for age-dependent body proportions." },
            { q: "What is the <b>Parkland formula</b> and how is it applied?", a: "<b>Parkland formula:</b><br>\\( \\text{Total fluids (24 hrs)} = 4 \\text{ mL} \\times \\text{kg} \\times \\text{\\% TBSA} \\)<br><br>Use <b>Lactated Ringer's</b> solution.<br><br><b>Administration:</b><br>• <b>First 8 hours:</b> Give <b>½</b> of total (from time of burn, NOT time of presentation)<br>• <b>Next 16 hours:</b> Give remaining <b>½</b><br><br><b>Titrate to urine output:</b><br>• Adults: <b>0.5 mL/kg/hr</b><br>• Children: <b>1 mL/kg/hr</b>" },
            { q: "What is the <b>Lund-Browder chart</b> and when is it preferred?", a: "The <b>Lund-Browder chart</b> is a <b>more accurate</b> method of estimating %TBSA that accounts for <b>age-related differences</b> in body proportions.<br><br>It assigns different percentages to body regions based on age groups (infant → adult).<br><br><b>Preferred over Rule of 9's in:</b><br>• <b>Children</b> (head is larger, legs smaller)<br>• <b>Irregular burn patterns</b><br>• Clinical situations requiring precise estimation (burn center transfers)" },
            { q: "What are the clinical features of <b>inhalation injury</b> in burn patients?", a: "<b>Suspect inhalation injury if:</b><br>• Burns in an <b>enclosed space</b><br>• <b>Facial/nasal hair singes</b><br>• <b>Carbonaceous sputum</b><br>• Hoarseness, stridor, wheezing<br>• <b>Soot</b> in oropharynx<br>• Dyspnea, altered mental status<br><br><b>Diagnosis:</b> <b>Fiberoptic bronchoscopy</b> (gold standard — shows edema, erythema, soot, mucosal sloughing)<br><br><b>Treatment:</b> Early intubation (airway edema progresses rapidly), 100% O₂, humidified air" },
            { q: "How is <b>carbon monoxide (CO) poisoning</b> diagnosed and managed in burn patients?", a: "<b>Diagnosis:</b><br>• <b>Carboxyhemoglobin (COHb)</b> level on co-oximetry (NOT pulse oximetry — SpO₂ is falsely normal)<br>• COHb > <b>10%</b> symptomatic, > <b>25%</b> severe, > <b>60%</b> lethal<br>• <b>Cherry-red skin</b> (classic but often not seen)<br><br><b>Management:</b><br>• <b>100% O₂ via NRB mask</b> — reduces COHb half-life from 4–6 hrs to ~60–90 min<br>• <b>Hyperbaric O₂ (HBO)</b>: Consider if COHb > 25%, LOC, pregnancy, cardiac ischemia — reduces half-life to ~20 min" },
            { q: "How is <b>cyanide poisoning</b> suspected and treated in burn patients?", a: "<b>Suspect in:</b> enclosed-space fire + persistent <b>lactic acidosis</b> despite O₂ therapy, altered mental status<br><br><b>Mechanism:</b> Cyanide (from combustion of plastics, wool, silk) inhibits <b>cytochrome oxidase</b> → blocks cellular aerobic metabolism<br><br><b>Treatment:</b><br>• <b>Hydroxocobalamin (Cyanokit)</b> — first-line; binds CN⁻ to form cyanocobalamin (vitamin B12)<br>• Sodium thiosulfate (adjunct)<br>• Amyl/sodium nitrite (caution: worsens methemoglobinemia and is problematic with concurrent CO poisoning)" },
            { q: "What are the <b>indications for escharotomy</b> in burns?", a: "<b>Escharotomy</b> = full-thickness incision through burned eschar to relieve pressure.<br><br><b>Indications:</b><br>• <b>Circumferential full-thickness burns</b> of extremities with signs of <b>vascular compromise</b> (diminished pulses, cyanosis, pain, paresthesias)<br>• <b>Circumferential chest/torso burns</b> restricting <b>ventilation</b> (↓ tidal volume, ↑ airway pressures)<br><br>Performed at the <b>bedside</b> — incise through eschar into subcutaneous fat along mid-lateral lines." },
            { q: "What unique considerations apply to <b>electrical burns</b>?", a: "• <b>Internal injury >> external appearance</b> (iceberg effect) — deep tissue destruction along the current path<br>• <b>Cardiac:</b> Arrhythmias (VF from AC current, asystole from DC current); <b>ECG monitoring for ≥ 24 hrs</b><br>• <b>Rhabdomyolysis:</b> Aggressive IV fluids, target UO <b>1–2 mL/kg/hr</b>, monitor CK and myoglobin<br>• <b>Compartment syndrome</b> — may need fasciotomy<br>• <b>Fractures / dislocations</b> — from tetanic muscle contractions or falls<br>• Renal failure from myoglobinuria<br>• Fluid needs exceed Parkland estimates" },
            { q: "What are the key <b>anatomic and physiologic differences</b> in pediatric trauma?", a: "• <b>Larger head-to-body ratio</b> → more head injuries, higher C-spine pivot point (C2-C3 vs. C5-C6 in adults)<br>• <b>Pliable thorax</b> → internal injuries without rib fractures (rib fractures = massive force)<br>• <b>Larger body surface area</b> → faster hypothermia<br>• <b>Solid organs proportionally larger</b> → more susceptible to injury<br>• <b>Better compensatory mechanisms</b> → vital signs may remain normal until 25–30% blood volume lost, then <b>sudden decompensation</b>" },
            { q: "How does <b>estimated blood volume</b> differ in pediatric patients, and what is the fluid bolus?", a: "<b>Estimated blood volume:</b><br>• Neonates: <b>80 mL/kg</b><br>• Children: <b>80 mL/kg</b><br>• Adults: <b>70 mL/kg</b><br><br><b>Fluid resuscitation bolus:</b><br>• <b>20 mL/kg</b> isotonic crystalloid (vs. 1–2 L in adults)<br>• Give up to <b>3 boluses</b>, then transfuse <b>10 mL/kg</b> pRBCs<br>• IO access if IV access not obtained in 90 seconds" },
            { q: "What are the key considerations in <b>geriatric trauma</b>?", a: "• <b>↓ Physiologic reserve</b> — limited cardiac output augmentation<br>• <b>Medications:</b> β-blockers mask tachycardia; anticoagulants increase bleeding risk<br>• <b>Pre-existing conditions</b> (CAD, CKD, COPD) limit compensatory mechanisms<br>• <b>Brain atrophy</b> → higher risk of <b>subdural hematoma</b> (stretched bridging veins)<br>• <b>Cervical spondylosis</b> → risk of <b>central cord syndrome</b><br>• <b>Osteoporosis</b> → fractures with minimal mechanism<br>• <b>Lower threshold for injury</b> — treat as high-acuity despite 'minor' mechanism" },
            { q: "Why can <b>elderly patients on β-blockers</b> present misleadingly in trauma?", a: "β-blockers <b>blunt the tachycardic response</b> to hypovolemia and pain.<br><br>The patient may have <b>normal or low heart rate</b> despite significant hemorrhage (Class III/IV shock), leading to <b>underestimation</b> of blood loss severity.<br><br><b>Key:</b> In elderly trauma patients, <b>base deficit and lactate</b> are more reliable markers of shock severity than heart rate." },
            { q: "What are the unique considerations in <b>trauma during pregnancy</b>?", a: "• <b>Resuscitate the mother to save the fetus</b> — maternal stabilization is the priority<br>• <b>Left lateral decubitus position</b> (or manual uterine displacement to the left) after 20 weeks — prevents <b>IVC compression</b> (supine hypotensive syndrome)<br>• <b>↑ Blood volume (40–50%)</b> — may lose significant blood before showing signs of shock<br>• <b>Physiologic changes:</b> ↑ HR, ↓ BP, ↑ WBC, ↓ hematocrit (dilutional)<br>• <b>Rh-negative mothers:</b> Give <b>RhoGAM</b> after trauma to prevent isoimmunization<br>• <b>Kleihauer-Betke test</b> — quantifies fetomaternal hemorrhage" },
            { q: "What is <b>perimortem cesarean section</b> and when is it indicated?", a: "<b>Perimortem C-section (resuscitative hysterotomy)</b> should be initiated within <b>4 minutes</b> of maternal cardiac arrest, with delivery by <b>5 minutes</b>.<br><br><b>Indications:</b><br>• Gestational age ≥ <b>24 weeks</b> (viable fetus)<br>• Maternal cardiac arrest unresponsive to standard resuscitation<br><br><b>Benefits:</b><br>• Improves maternal hemodynamics by relieving <b>aortocaval compression</b><br>• Allows direct fetal resuscitation<br>• May improve maternal survival even if fetus is non-viable" },
            { q: "What is the <b>ATLS</b> approach to the <b>'responsive' trauma patient</b> on arrival?", a: "A patient who is <b>talking</b> demonstrates a <b>patent airway</b>, sufficient <b>breathing</b>, and adequate <b>cerebral perfusion</b> — but this does NOT mean the primary survey is complete.<br><br>Proceed with structured ABCDE evaluation, as conditions can <b>deteriorate rapidly</b>. A patent airway at arrival does not guarantee a patent airway 10 minutes later." },
            { q: "What type of shock presents with <b>hypotension, bradycardia, and warm extremities</b> in a trauma patient?", a: "<b>Neurogenic shock</b> — caused by loss of sympathetic tone from a spinal cord injury at or above <b>T6</b>.<br><br>This produces:<br>• <b>Hypotension</b> (vasodilation — loss of peripheral resistance)<br>• <b>Bradycardia</b> (unopposed vagal tone)<br>• <b>Warm, dry skin</b> (loss of cutaneous vasoconstriction)<br><br>Contrast with <b>hemorrhagic shock</b>: hypotension + <b>tachycardia</b> + <b>cold/clammy</b> skin." },
            { q: "What <b>imaging studies</b> are obtained during the primary survey per ATLS?", a: "<b>Adjuncts to the primary survey:</b><br>1. <b>Chest X-ray</b> (AP, supine)<br>2. <b>Pelvic X-ray</b> (AP)<br>3. <b>FAST exam</b><br><br>These are obtained to identify <b>immediately life-threatening</b> conditions (tension pneumothorax, massive hemothorax, pelvic fracture, intraperitoneal hemorrhage, cardiac tamponade).<br><br><b>CT</b> is reserved for the secondary survey in <b>hemodynamically stable</b> patients." },
            { q: "What is <b>damage control surgery (DCS)</b> and when is it applied?", a: "<b>DCS</b> = abbreviated initial surgery focused on <b>hemorrhage control and contamination control</b> only, with planned reoperation after stabilization.<br><br><b>Steps:</b><br>1. <b>DCS:</b> Stop bleeding (packing, ligation), control contamination (staple/clamp bowel), temporary abdominal closure<br>2. <b>ICU resuscitation:</b> Correct the lethal triad (warm, correct coagulopathy, correct acidosis)<br>3. <b>Definitive repair:</b> Return to OR in 24–72 hrs for reconstruction<br><br><b>Indications:</b> Coagulopathy, hypothermia < 35°C, acidosis (pH < 7.2), hemodynamic instability" },
            { q: "What is the <b>damage control resuscitation (DCR)</b> strategy?", a: "<b>DCR</b> is the <b>resuscitative counterpart</b> to damage control surgery:<br><br>1. <b>Permissive hypotension</b> (target SBP 80–90 mmHg)<br>2. <b>Massive transfusion protocol</b> (1:1:1 ratio)<br>3. <b>Limit crystalloid</b> use (avoids hemodilution, coagulopathy)<br>4. <b>Early use of TXA</b> (tranexamic acid — within 3 hrs of injury per CRASH-2 trial)<br>5. <b>Prevent hypothermia</b> (warm fluids, blankets, warm OR)" },
            { q: "What is the role of <b>tranexamic acid (TXA)</b> in trauma?", a: "<b>TXA</b> = antifibrinolytic that inhibits plasminogen activation → stabilizes clots.<br><br><b>CRASH-2 trial:</b><br>• Reduced mortality in hemorrhagic trauma when given within <b>3 hours</b> of injury<br>• <b>Dose:</b> 1 g IV over 10 min, then 1 g IV over 8 hours<br>• <b>Contraindicated > 3 hours</b> post-injury (may increase mortality)<br><br>Now a standard component of massive transfusion protocols in many centers." },
            { q: "What is <b>resuscitative endovascular balloon occlusion of the aorta (REBOA)</b>?", a: "<b>REBOA</b> = endovascular catheter with a balloon placed in the aorta to <b>occlude flow below the injury</b> and maintain proximal perfusion.<br><br><b>Zones:</b><br>• <b>Zone I:</b> Descending thoracic aorta (for abdominal/pelvic hemorrhage)<br>• <b>Zone III:</b> Infrarenal aorta (for pelvic hemorrhage)<br>• Zone II: NOT used (visceral vessels)<br><br><b>Role:</b> Bridge to definitive surgery in <b>non-compressible torso hemorrhage</b> — alternative to resuscitative thoracotomy." },
            { q: "When is <b>resuscitative (ED) thoracotomy</b> indicated?", a: "<b>Greatest benefit:</b><br>• <b>Penetrating thoracic trauma</b> with witnessed cardiac arrest / recent loss of vital signs (survival ~35% for stab wounds with tamponade)<br><br><b>Consider:</b><br>• Penetrating non-thoracic trauma with loss of vitals<br>• Blunt trauma with witnessed arrest (survival < 2%)<br><br><b>Procedure goals:</b><br>• Release tamponade (pericardiotomy)<br>• Control cardiac hemorrhage<br>• Cross-clamp aorta for distal hemorrhage control<br>• Internal cardiac massage" },
            { q: "What is the <b>extended FAST (eFAST)</b> and what additional information does it provide?", a: "<b>eFAST</b> adds <b>bilateral anterior chest views</b> to the standard 4 FAST windows.<br><br><b>Additional assessment:</b><br>• <b>Pneumothorax:</b> Absence of <b>lung sliding</b> and <b>comet-tail artifacts</b><br>• <b>Hemothorax:</b> Fluid above the diaphragm<br><br>The <b>lung point</b> (transition between sliding and non-sliding lung) confirms pneumothorax and localizes its extent.<br><br>eFAST has <b>higher sensitivity</b> for pneumothorax than supine CXR." },
            { q: "What is the <b>significance of rib fractures</b> in different age groups?", a: "<b>Children:</b> Ribs are very pliable — rib fractures indicate <b>massive force</b> and significant underlying injury (pulmonary contusion, great vessel injury). Mortality is <b>high</b>.<br><br><b>Adults:</b> Fractures of ribs 1–2 suggest <b>high-energy mechanism</b> (associated with aortic/great vessel injury). Lower rib fractures (9–12) → suspect <b>hepatic or splenic</b> injury.<br><br><b>Elderly:</b> Even minor rib fractures carry significant morbidity — <b>pain control is critical</b> to prevent atelectasis, pneumonia." },
            { q: "Describe the <b>zones of the neck</b> and their clinical significance in penetrating trauma.", a: "<b>Zone I:</b> Clavicles to <b>cricoid cartilage</b><br>• Contains: Great vessels, trachea, esophagus, lung apices, thoracic duct<br>• <b>CTA</b> before surgery; operative exposure is difficult<br><br><b>Zone II:</b> Cricoid to <b>angle of mandible</b><br>• Contains: Carotid, jugular, larynx, pharynx<br>• <b>Most common zone injured</b>; historically: mandatory exploration; now: selective management with CTA<br><br><b>Zone III:</b> Angle of mandible to <b>base of skull</b><br>• Contains: Distal carotid, vertebral arteries, pharynx<br>• <b>CTA / angiography</b> before surgery; operative access difficult" },
            { q: "What is the <b>Le Fort classification</b> of midface fractures?", a: "<b>Le Fort I:</b> Horizontal fracture above the alveolar ridge — separates <b>hard palate / maxillary teeth</b> from the upper face (mobile upper dental arch)<br><br><b>Le Fort II:</b> Pyramidal fracture through the <b>nasal bridge, maxilla, and infraorbital rim</b> — mobile midface<br><br><b>Le Fort III:</b> Complete <b>craniofacial disjunction</b> — fracture through nasofrontal suture, orbits, and zygomatic arches — entire face is mobile from the cranium<br><br>All Le Fort fractures involve the <b>pterygoid plates</b>." },
            { q: "What is <b>commotio cordis</b>?", a: "<b>Commotio cordis</b> = sudden cardiac arrest caused by a <b>blunt precordial impact</b> (often a ball) during a vulnerable phase of the cardiac cycle (10–30 ms before the T-wave peak).<br><br>• Typically affects <b>young athletes</b> (thin, compliant chest wall)<br>• Mechanism: induces <b>ventricular fibrillation</b><br>• <b>No structural damage</b> to the heart<br>• Treatment: <b>Immediate CPR + AED/defibrillation</b><br>• Survival ~60% with prompt defibrillation" },
            { q: "What are the indications for <b>emergency department thoracotomy (EDT)</b> vs. when should it <b>not</b> be performed?", a: "<b>Indications:</b><br>• Penetrating thoracic injury with < 15 min CPR<br>• Penetrating non-thoracic injury with < 5 min CPR<br>• Blunt trauma with < 10 min CPR (very low survival)<br><br><b>Do NOT perform if:</b><br>• Blunt trauma with > 10 min CPR without signs of life<br>• Penetrating trauma with > 15 min CPR<br>• No signs of life (no pupillary response, no organized cardiac activity, no respiratory effort)" },
            { q: "What is the difference between <b>primary blast injury, secondary, tertiary, and quaternary</b>?", a: "<b>Primary:</b> Direct effect of <b>blast wave</b> (overpressure) on gas-filled organs — <b>lungs</b> (blast lung), <b>ears</b> (TM rupture — most common), <b>GI tract</b><br><br><b>Secondary:</b> Injuries from <b>flying debris/shrapnel</b> — penetrating trauma (most common cause of death)<br><br><b>Tertiary:</b> Body <b>thrown by blast wind</b> — blunt trauma, fractures, traumatic amputations<br><br><b>Quaternary:</b> Everything else — burns, inhalation, crush injury, exacerbation of chronic disease" },
            { q: "What is <b>'blast lung'</b> and how is it managed?", a: "<b>Blast lung</b> = primary blast injury to the lungs from <b>overpressure waves</b>.<br><br><b>Presentation:</b> Dyspnea, cough, hemoptysis, chest tightness<br><b>CXR:</b> Bilateral infiltrates (butterfly pattern), pneumothorax<br><br><b>Management:</b><br>• High-flow O₂<br>• Positive-pressure ventilation cautiously (risk of <b>air embolism</b> and pneumothorax)<br>• Low tidal volumes, avoid high PEEP initially<br>• Chest tube for pneumothorax<br>• <b>Avoid bag-mask ventilation</b> in suspected air embolism" },
            { q: "What is the <b>Focused Assessment with Sonography for Trauma (FAST)</b> sensitivity and limitations?", a: "<b>Sensitivity:</b><br>• For <b>free fluid</b>: ~85–95% (operator dependent)<br>• Detects ≥ <b>200 mL</b> in Morrison's pouch<br><br><b>Limitations:</b><br>• <b>Operator dependent</b><br>• Poor sensitivity for <b>hollow viscus</b> injury<br>• Cannot detect <b>retroperitoneal hemorrhage</b><br>• Poor in <b>obesity, subcutaneous emphysema</b><br>• Cannot grade solid organ injuries (CT needed)<br>• May be negative early in hemorrhage (not enough fluid to detect)" },
            { q: "What is the <b>most common cause of preventable death</b> in trauma?", a: "<b>Uncontrolled hemorrhage</b> — specifically <b>non-compressible truncal hemorrhage</b>.<br><br>This is why the ATLS approach prioritizes rapid identification and management of hemorrhagic shock, damage control resuscitation, and early surgical intervention.<br><br>The second most common preventable cause is <b>airway compromise</b>." },
            { q: "What is the role of the <b>log roll</b> in trauma assessment?", a: "The <b>log roll</b> is performed during exposure (primary survey) or secondary survey to:<br><br>• Inspect the <b>entire posterior surface</b> (back, flanks, buttocks, posterior legs)<br>• Palpate the <b>entire spine</b> for tenderness, step-offs, or deformity<br>• Perform a <b>digital rectal exam</b> if indicated<br><br><b>Technique:</b> Requires ≥ 4 people; one person maintains <b>inline cervical stabilization</b>. The patient is rolled as a <b>single unit</b>." },
            { q: "A patient has blunt chest trauma with <b>subcutaneous emphysema, respiratory distress, and a persistent air leak</b> after chest tube placement. What is the most likely diagnosis?", a: "<b>Tracheobronchial injury</b> (bronchial disruption).<br><br><b>Key clue:</b> Pneumothorax that <b>fails to resolve</b> despite a properly functioning chest tube, with a <b>continuous large air leak</b>.<br><br><b>Diagnosis:</b> <b>Bronchoscopy</b><br><b>Treatment:</b> Surgical repair (thoracotomy)<br><br>Most injuries occur within <b>2.5 cm of the carina</b>." },
            { q: "What are the <b>signs of a tension pneumothorax</b> on CXR (if obtained)?", a: "• <b>Hyperlucent hemithorax</b> with absent lung markings<br>• <b>Mediastinal shift</b> away from affected side<br>• <b>Depressed ipsilateral diaphragm</b><br>• <b>Widened intercostal spaces</b><br><br><b>IMPORTANT:</b> Tension pneumothorax is a <u>clinical diagnosis</u>. Treatment (needle decompression) should <b>NOT</b> be delayed for imaging." },
            { q: "What is the appropriate <b>chest tube size</b> for a hemothorax vs. pneumothorax?", a: "<b>Hemothorax:</b> <b>36–40 Fr</b> (large bore — to drain blood and prevent clotting of the tube)<br><br><b>Pneumothorax:</b> <b>28–32 Fr</b> (can use smaller tube since air drains easily)<br><br><b>Insertion site:</b> <b>4th–5th intercostal space, anterior to mid-axillary line</b> (safe triangle). Insert above the rib to avoid the intercostal neurovascular bundle." },
            { q: "What is the <b>Kleihauer-Betke test</b> and when is it performed?", a: "<b>Kleihauer-Betke test</b> detects <b>fetal hemoglobin</b> in maternal blood, quantifying <b>fetomaternal hemorrhage</b>.<br><br><b>Indication:</b> All <b>Rh-negative pregnant trauma patients</b> (and selected Rh-positive patients at risk).<br><br><b>Purpose:</b><br>• Determines if additional <b>RhoGAM</b> is needed beyond the standard 300 µg dose<br>• Standard RhoGAM covers ~30 mL of fetal blood; KB test determines if more is required" },
            { q: "At what gestational age does the <b>uterus become an intra-abdominal organ</b> and why does this matter in trauma?", a: "The uterus rises above the <b>pelvic brim at ~12 weeks</b> and reaches the <b>umbilicus at ~20 weeks</b>.<br><br><b>Clinical significance:</b><br>• After 12 weeks, the uterus is increasingly vulnerable to <b>direct abdominal trauma</b><br>• After 20 weeks, the gravid uterus can compress the <b>IVC in supine position</b> → supine hypotensive syndrome<br>• <b>Placental abruption</b> is the most common cause of fetal death in trauma" },
            { q: "What is <b>placental abruption</b> in the setting of trauma and how is it diagnosed?", a: "<b>Placental abruption</b> = premature separation of the placenta from the uterine wall.<br><br>• <b>Most common cause of fetal death</b> in trauma (60–70%)<br>• Can occur with <b>minor</b> mechanism<br><br><b>Presentation:</b> vaginal bleeding, uterine tenderness/rigidity, fetal distress, DIC<br><br><b>Diagnosis:</b><br>• <b>Cardiotocographic (CTG) monitoring</b> — most sensitive (uterine contractions, fetal heart rate abnormalities)<br>• Ultrasound has <b>poor sensitivity</b> (~25%) for abruption<br>• Monitor for ≥ <b>4–6 hours</b> minimum (24 hrs if concerning findings)" },
            { q: "What are the components of the <b>Revised Trauma Score (RTS)</b>?", a: "<b>RTS</b> uses 3 physiologic parameters:<br><br>1. <b>GCS</b> (weighted most heavily)<br>2. <b>Systolic blood pressure</b><br>3. <b>Respiratory rate</b><br><br>Each is coded 0–4 and weighted:<br>\\( RTS = 0.9368 \\times GCS_c + 0.7326 \\times SBP_c + 0.2908 \\times RR_c \\)<br><br>Range: 0–7.84<br>Used for <b>triage</b> and <b>outcome prediction</b>. RTS < 4 → consider trauma center transport." },
            { q: "What is the <b>Injury Severity Score (ISS)</b>?", a: "<b>ISS</b> = anatomical scoring system based on the <b>Abbreviated Injury Scale (AIS)</b>.<br><br><b>Calculation:</b> Sum of squares of the <b>3 highest AIS scores</b> from 3 different body regions (out of 6 regions).<br><br>\\( ISS = AIS_1^2 + AIS_2^2 + AIS_3^2 \\)<br><br><b>Range:</b> 1–75<br>• Any AIS of 6 (unsurvivable) → ISS automatically = 75<br>• <b>ISS > 15</b> = major trauma<br>• Correlates with mortality, morbidity, and hospital stay" },
            { q: "What is the <b>management of a patient with suspected splenic injury</b> who is hemodynamically stable?", a: "<b>Non-operative management (NOM)</b> is the standard for hemodynamically stable patients:<br><br>1. <b>ICU admission</b> with serial abdominal exams<br>2. <b>Serial hemoglobin</b> monitoring<br>3. <b>Bed rest</b><br>4. <b>CT with IV contrast</b> to grade injury and identify active extravasation<br>5. <b>Angioembolization</b> if contrast blush / pseudoaneurysm seen<br>6. Follow-up imaging in 48–72 hrs for Grade III+ injuries<br><br>NOM success rate: > <b>90%</b> for Grade I–III injuries in adults." },
            { q: "What are the <b>American Association for the Surgery of Trauma (AAST)</b> spleen injury grades?", a: "<b>Grade I:</b> Subcapsular hematoma < 10%, capsular laceration < 1 cm depth<br><b>Grade II:</b> Subcapsular hematoma 10–50%, parenchymal laceration 1–3 cm<br><b>Grade III:</b> Subcapsular hematoma > 50% or expanding, laceration > 3 cm or involving trabecular vessels<br><b>Grade IV:</b> Laceration involving segmental/hilar vessels with > 25% devascularization<br><b>Grade V:</b> Shattered spleen or hilar vascular injury with complete devascularization<br><br>Grades IV–V often require <b>splenectomy</b>." },
            { q: "After a splenectomy, what <b>vaccinations</b> must be given and why?", a: "The spleen is critical for opsonization of <b>encapsulated organisms</b>. Post-splenectomy patients are at risk for <b>overwhelming post-splenectomy infection (OPSI)</b>.<br><br><b>Vaccinate against:</b><br>1. <b>Streptococcus pneumoniae</b> (PCV13 → PPSV23)<br>2. <b>Neisseria meningitidis</b> (MenACWY + MenB)<br>3. <b>Haemophilus influenzae type b</b> (Hib)<br><br><b>Timing:</b> Ideally ≥ <b>14 days</b> post-splenectomy (or pre-op if elective). If emergent, give at discharge.<br>Also prescribe <b>prophylactic penicillin</b> or amoxicillin." },
            { q: "What is a <b>flail chest</b> managed with initially — and when does the patient need <b>intubation</b>?", a: "<b>Initial management:</b><br>• Supplemental O₂<br>• Aggressive <b>pain control</b> (epidural, intercostal nerve blocks, IV analgesics) to allow deep breathing<br>• Pulmonary toilet<br>• Avoid fluid overload (worsens underlying contusion)<br><br><b>Intubation indicated if:</b><br>• Respiratory failure (PaO₂ < 60, PaCO₂ > 45 despite supplemental O₂)<br>• Severe underlying pulmonary contusion<br>• Associated injuries requiring general anesthesia<br>• Fatigue / inability to maintain adequate ventilation" },
            { q: "What is the <b>most sensitive indicator of ongoing hemorrhage</b> in trauma?", a: "<b>Base deficit and serum lactate</b> are the most sensitive and earliest indicators of tissue hypoperfusion and ongoing hemorrhage.<br><br>• <b>Base deficit > 6 mEq/L</b> → significant shock<br>• <b>Lactate > 4 mmol/L</b> → high mortality<br><br>These are more reliable than vital signs (especially in elderly patients on β-blockers or athletes with high physiologic reserve). <b>Serial trending</b> is essential." },
            { q: "What are the <b>types of IV access</b> in order of preference for trauma resuscitation?", a: "1. <b>2 large-bore (14–16 gauge) peripheral IVs</b> in the antecubital fossae — <b>first choice</b><br>2. <b>Intraosseous (IO) access</b> — proximal tibia, humeral head (rapid if IV fails; works in all ages)<br>3. <b>Central venous catheter</b> — femoral (preferred in trauma — no risk to airway), subclavian, IJ<br>4. <b>Venous cutdown</b> — saphenous vein at ankle (rarely used now)<br><br><b>Key:</b> Short, wide-bore catheters deliver fluids faster than long central lines (Poiseuille's law)." },
            { q: "What are the <b>indications for intubation</b> during the primary survey (beyond GCS ≤ 8)?", a: "1. <b>GCS ≤ 8</b> — cannot protect airway<br>2. <b>Apnea or respiratory failure</b><br>3. <b>Severe maxillofacial trauma</b> with airway compromise<br>4. <b>Expanding neck hematoma</b> or laryngeal injury<br>5. <b>Inhalation injury</b> with progressive stridor/edema<br>6. <b>Combative hypoxic patient</b> needing airway protection for imaging/procedures<br>7. <b>Hemorrhagic shock</b> requiring operative intervention<br>8. <b>High spinal cord injury</b> with respiratory failure (C3-C5 — phrenic nerve)" },
            { q: "What is a <b>simple pneumothorax</b> vs. a <b>tension pneumothorax</b>?", a: "<b>Simple pneumothorax:</b><br>• Air in pleural space WITHOUT mediastinal shift<br>• Decreased breath sounds, hyperresonance<br>• Hemodynamically <b>stable</b><br>• <b>Treatment:</b> Chest tube (or observation if small and asymptomatic)<br><br><b>Tension pneumothorax:</b><br>• Air accumulates with <b>one-way valve effect</b> → progressive pressure<br>• Mediastinal shift, compressed contralateral lung, impaired venous return<br>• Hemodynamically <b>unstable</b><br>• <b>Treatment:</b> Immediate needle decompression → chest tube" },
            { q: "What is a <b>sucking chest wound</b> critical size threshold?", a: "A chest wall defect approximately <b>two-thirds the diameter of the trachea</b> or larger creates an open pneumothorax.<br><br>At this size, air preferentially enters through the wound rather than the trachea (path of least resistance), causing a <b>'sucking' sound</b> and effective ventilatory compromise.<br><br><b>Initial management:</b> Three-sided occlusive dressing → chest tube at a <b>separate</b> site → definitive surgical closure." },
            { q: "How do you calculate <b>estimated blood loss</b> from fractures?", a: "<b>Estimated blood loss by fracture site:</b><br><br>• <b>Humerus:</b> 750 mL<br>• <b>Radius/ulna:</b> 250–500 mL<br>• <b>Pelvis:</b> 500 mL – 5,000+ mL (life-threatening)<br>• <b>Femur:</b> 1,000–1,500 mL <b>per femur</b><br>• <b>Tibia/fibula:</b> 500–1,000 mL<br>• <b>Rib (each):</b> 100–150 mL<br><br>Bilateral femur fractures can result in <b>Class III–IV</b> hemorrhage from fractures alone." },
            { q: "What is the <b>obturator sign</b> and <b>Kehr's sign</b> in abdominal trauma?", a: "<b>Kehr's sign:</b> Referred <b>left shoulder pain</b> due to diaphragmatic irritation from <b>splenic injury</b> or free blood (phrenic nerve → C3-C5 dermatome).<br><br><b>Obturator sign:</b> Pain with <b>internal rotation of the flexed hip</b> — suggests irritation near the <b>obturator internus muscle</b> (pelvic abscess, appendicitis, but in trauma may indicate pelvic hemorrhage/injury)." },
            { q: "What is <b>Waddell's triad</b> and in what population is it seen?", a: "<b>Waddell's triad</b> is the classic injury pattern in <b>pediatric pedestrians struck by vehicles</b>:<br><br>1. <b>Bumper injury</b> — femur or tibia fracture (lower extremity)<br>2. <b>Trunk injury</b> — intra-abdominal or intrathoracic injury (child is thrown onto the car hood)<br>3. <b>Head injury</b> — contralateral head injury (child is thrown from the car)<br><br>The pattern reflects the child's smaller stature relative to the vehicle bumper height." },
            { q: "What is <b>myocardial contusion (blunt cardiac injury)</b> and how is it evaluated?", a: "<b>Mechanism:</b> Direct sternal impact (steering wheel, dashboard)<br><br><b>Evaluation:</b><br>• <b>ECG</b> — most important initial test; look for new arrhythmias, ST changes, conduction abnormalities<br>• <b>Troponin</b> — if elevated, correlates with significant injury<br>• <b>Echocardiography</b> — wall motion abnormalities, valvular damage, pericardial effusion<br><br><b>Management:</b><br>• <b>Normal ECG + normal troponin</b> → safe to discharge (low risk)<br>• Abnormal → <b>telemetry monitoring for 24–48 hrs</b>, echocardiography<br>• Treat arrhythmias as they arise" },
            { q: "What is the <b>correct management sequence</b> for a trauma patient with both a <b>tension pneumothorax</b> and a <b>scalp laceration bleeding profusely</b>?", a: "Per ATLS:<br><b>A</b> → <b>B</b> → <b>C</b><br><br>1. Ensure <b>airway</b> is patent<br>2. Address <b>breathing</b>: <b>Needle decompression</b> for tension pneumothorax (immediate life threat under 'B')<br>3. Then address <b>circulation</b>: Apply <b>direct pressure</b> to scalp laceration<br><br>Tension pneumothorax is treated during 'B' because it impairs ventilation <b>and</b> circulation. The scalp laceration, while potentially significant, is addressed under 'C' (hemorrhage control)." },
            { q: "What are the indications for a <b>CT cervical spine</b> vs. <b>X-ray</b> in trauma?", a: "<b>CT cervical spine</b> is the <b>preferred imaging modality</b> in trauma (ATLS 10th edition):<br>• Higher sensitivity and specificity than plain films<br>• Recommended for all patients who require imaging per NEXUS/CCR<br><br><b>Plain X-rays</b> (3-view: AP, lateral, open-mouth odontoid):<br>• Only if CT is unavailable<br>• Must visualize C1 through T1 (inadequate → CT)<br>• Miss up to <b>50%</b> of fractures detected by CT<br><br><b>MRI:</b> For suspected ligamentous injury, SCIWORA, cord compression" },
            { q: "What is a <b>Type II odontoid (dens) fracture</b> and why is it clinically significant?", a: "<b>Type II odontoid fracture</b> = fracture through the <b>base of the dens</b> (junction with C2 body).<br><br><b>Clinical significance:</b><br>• <b>Most common odontoid fracture</b> (~60%)<br>• <b>Highest rate of non-union</b> (poor blood supply at the base of the dens)<br>• Common in elderly patients after falls<br>• May cause <b>atlantoaxial instability</b><br><br><b>Treatment:</b> Surgical fixation (especially if displaced > 5mm, age > 50) or halo vest immobilization." },
            { q: "What is a <b>Jefferson fracture</b> and what is its mechanism?", a: "<b>Jefferson fracture</b> = <b>burst fracture of C1 (atlas)</b> — bilateral fractures of anterior and posterior arches.<br><br><b>Mechanism:</b> <b>Axial loading</b> (diving, falling objects onto head)<br><br><b>Imaging:</b> Open-mouth odontoid view shows <b>lateral mass overhang</b> of C1 beyond C2.<br><br><b>Stability:</b> Depends on <b>transverse ligament</b> integrity (overhang > 7mm total = unstable).<br><br>Usually <b>neurologically intact</b> (wide spinal canal at C1)." },
            { q: "What is a <b>hangman's fracture</b>?", a: "<b>Hangman's fracture</b> = bilateral fracture of the <b>pars interarticularis of C2</b> (traumatic spondylolisthesis of the axis).<br><br><b>Mechanism:</b> <b>Hyperextension + axial loading</b> (judicial hanging, MVA with forehead impact on dashboard)<br><br><b>Usually neurologically intact</b> (canal expands as C2 ring fractures).<br><br><b>Treatment:</b><br>• Stable: Rigid cervical collar<br>• Unstable (significant angulation/displacement): Halo vest or surgical fixation" },
            { q: "What is <b>neurogenic pulmonary edema</b> and when does it occur?", a: "<b>Neurogenic pulmonary edema</b> = acute pulmonary edema following severe <b>CNS injury</b> (usually TBI or SAH).<br><br><b>Mechanism:</b> Massive sympathetic discharge → systemic and pulmonary vasoconstriction → pulmonary capillary injury → protein-rich edema<br><br><b>Presentation:</b> Rapid-onset bilateral pulmonary infiltrates, hypoxia, pink frothy sputum<br><br><b>Management:</b><br>• Treat the underlying CNS injury<br>• Supportive ventilation (lung-protective strategy)<br>• Cautious diuresis" },
            { q: "What is <b>traumatic asphyxia</b>?", a: "<b>Traumatic asphyxia</b> occurs from <b>prolonged severe compression of the thorax</b> (crush injury, crowd stampede).<br><br><b>Presentation:</b><br>• <b>Cervicofacial cyanosis</b> (deep purple/blue discoloration of face, neck, upper chest)<br>• <b>Subconjunctival hemorrhage</b> (bilateral)<br>• <b>Petechiae</b> of face and upper body<br>• <b>Cerebral edema</b>, altered mental status<br><br><b>Mechanism:</b> Sudden increase in intrathoracic pressure forces blood retrograde through SVC into valveless jugular veins and head vasculature." },
            { q: "What are the <b>burn depth classifications</b> and their characteristics?", a: "<b>Superficial (1st degree):</b> Epidermis only; red, painful, dry (sunburn). <u>Not included in %TBSA</u>.<br><br><b>Partial thickness — Superficial (2nd degree):</b> Epidermis + superficial dermis; red, painful, <b>blistered</b>, moist. Blanches with pressure. Heals in 2–3 weeks.<br><br><b>Partial thickness — Deep (2nd degree):</b> Extends into deep dermis; pale/mottled, <b>less painful</b>, may require grafting.<br><br><b>Full thickness (3rd degree):</b> Entire dermis destroyed; white/brown/black, <b>painless</b>, leathery, no blanching. Requires grafting.<br><br><b>4th degree:</b> Into muscle, bone, tendon." },
            { q: "What are the criteria for <b>burn center referral</b> per the American Burn Association?", a: "1. Partial-thickness burns > <b>10% TBSA</b><br>2. <b>Full-thickness</b> burns of any size<br>3. Burns involving <b>face, hands, feet, genitalia, perineum, or major joints</b><br>4. <b>Electrical burns</b> (including lightning)<br>5. <b>Chemical burns</b><br>6. <b>Inhalation injury</b><br>7. Burns in patients with <b>significant comorbidities</b><br>8. Burns with concomitant <b>trauma</b> (if burn is the greater risk)<br>9. Burns in <b>children</b> at hospitals without pediatric capability<br>10. Patients requiring <b>social, emotional, or rehabilitative</b> intervention" },
            { q: "What is <b>abdominal compartment syndrome</b> and how is it managed?", a: "<b>Abdominal compartment syndrome</b> = intra-abdominal pressure (IAP) > <b>20 mmHg</b> with new organ dysfunction.<br><br><b>Causes in trauma:</b> Massive resuscitation, abdominal packing, retroperitoneal hemorrhage, bowel edema.<br><br><b>Effects:</b> ↓ venous return, ↓ renal perfusion, ↑ airway pressures, ↓ cardiac output<br><br><b>Diagnosis:</b> Measure IAP via <b>bladder (Foley) pressure transducer</b><br><br><b>Treatment:</b> <b>Decompressive laparotomy</b> with temporary abdominal closure (Bogotá bag, vacuum-assisted closure)" },
            { q: "What is the <b>significance of hypothermia</b> in the trauma patient (beyond the lethal triad)?", a: "<b>Core temperature < 35°C</b> in trauma:<br><br>• <b>Coagulopathy:</b> Impairs clotting factor enzymatic activity and platelet function (even if lab coag studies appear normal — they're run at 37°C)<br>• <b>Cardiac:</b> Arrhythmias (AF, VF at < 28°C), ↓ cardiac output<br>• <b>Metabolic:</b> Lactic acidosis, ↓ drug metabolism<br>• <b>Immune:</b> ↑ infection risk<br><br><b>Prevention/Treatment:</b> Warm IV fluids (39–40°C), warm blankets, ↑ room temperature, bear hugger, remove wet clothing." }
          ]
        },
        {
          section: 'Emergency Medicine',
          topic: "Toxicology & poisoning management",
          icon: "alert-triangle",
          cards: [
            { q: "What are the <b>5 classic vital-sign findings</b> in a <u>sympathomimetic toxidrome</u>?", a: "<b>Sympathomimetic toxidrome:</b><br>1. <b>Hypertension</b><br>2. <b>Tachycardia</b><br>3. <b>Hyperthermia</b><br>4. <b>Tachypnea</b><br>5. <b>Mydriasis</b> (dilated pupils)<br><br>Additional: diaphoresis, agitation, seizures.<br>Common agents: cocaine, amphetamines, MDMA, pseudoephedrine." },
            { q: "What is the key feature that <b>distinguishes</b> a <u>sympathomimetic</u> from an <u>anticholinergic</u> toxidrome?", a: "<b>Skin moisture:</b><br>• <b>Sympathomimetic</b> → <b>diaphoresis</b> (wet skin)<br>• <b>Anticholinergic</b> → <b>dry skin</b> (\"dry as a bone\")<br><br>Both share: tachycardia, hypertension, mydriasis, hyperthermia, and agitation." },
            { q: "List the <b>classic mnemonic</b> for the <u>anticholinergic toxidrome</u> and the signs it represents.", a: "<b>\"Hot as a hare, dry as a bone, red as a beet, mad as a hatter, blind as a bat, full as a flask\"</b><br><br>• <b>Hot</b> — hyperthermia (no sweating to cool)<br>• <b>Dry</b> — anhidrosis, dry mucous membranes<br>• <b>Red</b> — flushed skin<br>• <b>Mad</b> — agitation, delirium, hallucinations<br>• <b>Blind</b> — mydriasis, cycloplegia<br>• <b>Full</b> — urinary retention, ileus<br><br>Agents: atropine, antihistamines (diphenhydramine), TCAs, jimsonweed." },
            { q: "Describe the <b>cholinergic toxidrome</b> using the <u>DUMBBBELS</u> mnemonic.", a: "<b>D</b> — Defecation / Diarrhea<br><b>U</b> — Urination<br><b>M</b> — Miosis<br><b>B</b> — Bradycardia / Bronchospasm<br><b>B</b> — Bronchorrhea<br><b>B</b> — Body fasciculations<br><b>E</b> — Emesis<br><b>L</b> — Lacrimation<br><b>S</b> — Salivation / Sweating<br><br>Agents: organophosphates, carbamates, nerve agents, pilocarpine." },
            { q: "What is the alternative cholinergic mnemonic <u>SLUDGE</u>?", a: "<b>S</b> — Salivation<br><b>L</b> — Lacrimation<br><b>U</b> — Urination<br><b>D</b> — Defecation / Diaphoresis<br><b>G</b> — GI distress (cramping, emesis)<br><b>E</b> — Emesis<br><br><i>SLUDGE omits some nicotinic effects (fasciculations, weakness) that DUMBBBELS captures.</i>" },
            { q: "What are the <b>cardinal features</b> of the <u>opioid toxidrome</u>?", a: "<b>Classic triad:</b><br>1. <b>CNS depression</b> (sedation → coma)<br>2. <b>Respiratory depression</b> (↓ rate > ↓ depth)<br>3. <b>Miosis</b> (pinpoint pupils)<br><br>Additional: hypotension, hypothermia, bradycardia, decreased bowel sounds.<br><br><i>Note: Meperidine & tramadol may cause mydriasis and seizures.</i>" },
            { q: "What defines the <b>sedative-hypnotic toxidrome</b>?", a: "<b>Sedative-hypnotic toxidrome:</b><br>• <b>CNS depression</b> (confusion → coma)<br>• <b>Respiratory depression</b><br>• <b>Hypotension</b><br>• <b>Hypothermia</b><br>• Normal or <b>mid-position pupils</b> (key difference from opioids)<br><br>Agents: benzodiazepines, barbiturates, zolpidem, GHB, ethanol." },
            { q: "What are the <b>Hunter Criteria</b> for diagnosing <u>Serotonin Syndrome</u>?", a: "<b>Requires serotonergic agent + ONE of:</b><br>1. Spontaneous <b>clonus</b><br>2. Inducible clonus + <b>agitation or diaphoresis</b><br>3. Ocular clonus + agitation or diaphoresis<br>4. <b>Tremor + hyperreflexia</b><br>5. <b>Hypertonia + temperature &gt;38°C</b> + ocular or inducible clonus<br><br>Key features: <b>clonus</b> (especially lower extremity), hyperreflexia, diaphoresis, diarrhea, agitation." },
            { q: "How do you differentiate <u>Serotonin Syndrome</u> from <u>Neuroleptic Malignant Syndrome (NMS)</u>?", a: "<table><tr><th>Feature</th><th>Serotonin Syndrome</th><th>NMS</th></tr><tr><td><b>Onset</b></td><td>Rapid (hours)</td><td>Slow (days-weeks)</td></tr><tr><td><b>Muscle tone</b></td><td>Clonus, hyperreflexia</td><td><b>Lead-pipe rigidity</b></td></tr><tr><td><b>Reflexes</b></td><td>↑ Hyperreflexia</td><td>↓ or normal</td></tr><tr><td><b>Pupils</b></td><td>Mydriasis</td><td>Normal</td></tr><tr><td><b>Bowel sounds</b></td><td>↑ (diarrhea)</td><td>↓ (ileus)</td></tr><tr><td><b>Skin</b></td><td>Diaphoretic</td><td>Diaphoretic</td></tr><tr><td><b>Trigger</b></td><td>Serotonergic drugs</td><td>Dopamine antagonists</td></tr></table>" },
            { q: "What is <b>Neuroleptic Malignant Syndrome (NMS)</b> and what are its cardinal features?", a: "<b>NMS</b> — idiosyncratic reaction to dopamine antagonists (antipsychotics, metoclopramide) or sudden withdrawal of dopaminergic agents.<br><br><b>Classic tetrad:</b><br>1. <b>Hyperthermia</b> (often &gt;40°C)<br>2. <b>Lead-pipe rigidity</b><br>3. <b>Altered mental status</b><br>4. <b>Autonomic instability</b> (tachycardia, labile BP, diaphoresis)<br><br>Labs: <b>↑↑ CK</b>, leukocytosis, ↑ LDH, metabolic acidosis.<br>Treatment: <b>dantrolene</b>, bromocriptine, supportive cooling." },
            { q: "What is the recommended <b>time window</b> for administering <u>activated charcoal</u>?", a: "<b>Ideally within 1 hour</b> of ingestion for maximal benefit.<br><br>• Standard dose: <b>1 g/kg</b> (max ~50–100 g in adults)<br>• May still be considered &gt;1 h for substances with:<br>&nbsp;&nbsp;– Delayed GI absorption<br>&nbsp;&nbsp;– Sustained-release formulations<br>&nbsp;&nbsp;– Large ingestions" },
            { q: "What are the <b>contraindications</b> to activated charcoal?", a: "<b>Contraindications to activated charcoal:</b><br>1. <b>Unprotected airway</b> (obtunded without intubation)<br>2. <b>Caustic ingestion</b> (acids/alkalis) — obscures endoscopy<br>3. <b>GI perforation or obstruction</b><br>4. Substances NOT adsorbed: <b>PHAILS</b><br>&nbsp;&nbsp;– <b>P</b>esticides (some), <b>H</b>ydrocarbons, <b>A</b>cids/Alkalis, <b>I</b>ron, <b>L</b>ithium, <b>S</b>olvents/alcohols<br>5. Risk of aspiration" },
            { q: "What are the <b>indications</b> for <u>whole bowel irrigation (WBI)</u>?", a: "<b>Whole bowel irrigation</b> (polyethylene glycol solution, GoLYTELY):<br><br><b>Indications:</b><br>1. <b>Iron</b> overdose (not charcoal-bound)<br>2. <b>Lithium</b> overdose<br>3. <b>Sustained-release</b> or enteric-coated preparations<br>4. <b>Body packers</b> (drug-packet ingestion)<br>5. <b>Lead paint chips</b><br><br>Rate: 1.5–2 L/hr (adults) until clear rectal effluent.<br>Contraindications: ileus, obstruction, hemodynamic instability, unprotected airway." },
            { q: "What are the current <b>indications</b> for <u>gastric lavage</u>?", a: "<b>Gastric lavage</b> is <u>rarely indicated</u>. Consider ONLY if:<br><br>1. <b>Life-threatening ingestion</b><br>2. Within <b>1 hour</b> of ingestion<br>3. <b>Protected airway</b> (intubation if obtunded)<br><br><b>Contraindications:</b><br>• Caustic ingestion<br>• Hydrocarbon ingestion (aspiration risk)<br>• Sharp objects<br>• Unprotected airway<br><br><i>Per APA/AACT: routine use is not recommended.</i>" },
            { q: "Name <b>3 toxidromes</b> that present with <u>mydriasis</u> and <b>2</b> that present with <u>miosis</u>.", a: "<b>Mydriasis (dilated pupils):</b><br>1. Sympathomimetic<br>2. Anticholinergic<br>3. Serotonin syndrome<br><br><b>Miosis (constricted pupils):</b><br>1. Opioid<br>2. Cholinergic (organophosphates)<br><br><i>Mnemonic: \"Sympathetic eyes are large to spot danger; parasympathetic eyes are small and relaxed.\"</i>" },
            { q: "What is the <b>hepatotoxic dose</b> of acetaminophen in a single acute ingestion?", a: "<b>≥150 mg/kg</b> (or ≥7.5 g in adults, whichever is less) is considered potentially hepatotoxic.<br><br>• Maximum recommended daily dose: <b>4 g/day</b> (2 g in chronic alcohol users per some guidelines)<br>• Toxic metabolite: <b>NAPQI</b> (N-acetyl-p-benzoquinone imine) — normally detoxified by glutathione." },
            { q: "What is <b>NAPQI</b> and how does it cause liver injury?", a: "<b>NAPQI</b> (N-acetyl-p-benzoquinone imine):<br><br>• Toxic metabolite of APAP produced by <b>CYP2E1</b> (cytochrome P450)<br>• Normally conjugated by <b>glutathione</b> → harmless<br>• In overdose: glutathione stores <b>depleted (&lt;30%)</b> → NAPQI accumulates<br>• Causes <b>centrilobular hepatic necrosis</b> (zone 3)<br><br>NAC works by <b>replenishing glutathione</b> and serving as a glutathione substitute." },
            { q: "Describe the <b>4 phases of acetaminophen toxicity</b> with their timelines and features.", a: "<b>Phase I (0–24 h):</b> Nausea, vomiting, anorexia, malaise — or <u>completely asymptomatic</u><br><br><b>Phase II (24–72 h):</b> RUQ pain, rising <b>AST/ALT</b>, possible ↑ PT/INR, ↑ bilirubin; initial symptoms may improve<br><br><b>Phase III (72–96 h):</b> Peak hepatotoxicity — <b>fulminant hepatic failure</b>, jaundice, coagulopathy, renal failure, encephalopathy, lactic acidosis. AST can exceed 10,000<br><br><b>Phase IV (&gt;96 h – 2 weeks):</b> <b>Recovery</b> phase in survivors; complete hepatic regeneration is possible" },
            { q: "What is the <b>Rumack-Matthew nomogram</b> and when is it used?", a: "<b>Rumack-Matthew nomogram:</b> Plots <b>serum APAP level</b> vs. <b>time since acute single ingestion</b>.<br><br>• <b>Treatment line</b>: 150 µg/mL at 4 hours → 37.5 µg/mL at 12 hours<br>• Levels <b>above the line</b> → treat with <b>NAC</b><br><br><b>Requirements for use:</b><br>• <b>Single acute ingestion</b> with known time<br>• Level drawn at <b>≥4 hours</b> post-ingestion<br><br><b>Not valid for:</b> chronic ingestions, unknown time, staggered doses, extended-release formulations." },
            { q: "When should an <b>APAP level</b> be drawn after an acute ingestion?", a: "<b>At 4 hours post-ingestion</b> (or as soon as possible thereafter).<br><br>• Levels drawn <b>before 4 hours</b> are unreliable — absorption may be incomplete<br>• Plot on Rumack-Matthew nomogram only for <b>acute single ingestion</b> at <b>4–24 hours</b><br>• If time of ingestion unknown: draw level immediately + check <b>AST/ALT</b>" },
            { q: "Compare the <b>oral (72 h)</b> and <b>IV (21 h)</b> NAC protocols for APAP overdose.", a: "<b>Oral NAC (Mucomyst) — 72-hour protocol:</b><br>• Loading: <b>140 mg/kg</b><br>• Then: <b>70 mg/kg q4h × 17 additional doses</b><br>• Total: 18 doses over 72 hours<br><br><b>IV NAC (Acetadote) — 21-hour protocol:</b><br>• <b>150 mg/kg</b> over 1 hour<br>• <b>50 mg/kg</b> over 4 hours<br>• <b>100 mg/kg</b> over 16 hours<br><br>IV preferred for: hepatic failure, inability to tolerate PO, pregnancy.<br>Both are equally effective when given within <b>8 hours</b>." },
            { q: "What are the <b>King's College Criteria</b> for liver transplant in APAP-induced acute liver failure?", a: "<b>King's College Criteria (APAP):</b><br><br><b>Arterial pH &lt;7.30</b> after adequate resuscitation (irrespective of grade of encephalopathy)<br><br><b>OR all 3 of the following:</b><br>1. Grade <b>III–IV encephalopathy</b><br>2. <b>PT &gt;100 seconds</b> (INR &gt;6.5)<br>3. <b>Creatinine &gt;3.4 mg/dL</b><br><br>These criteria predict <b>&gt;90% mortality</b> without transplant." },
            { q: "In what situations should you start <b>NAC empirically</b> without waiting for APAP levels?", a: "<b>Start NAC empirically if:</b><br><br>1. <b>Suspected massive ingestion</b> (≥150 mg/kg) and level will not be back within 8 hours<br>2. <b>Unknown time of ingestion</b> + detectable APAP or elevated transaminases<br>3. <b>Chronic APAP ingestion</b> with elevated AST/ALT<br>4. <b>Evidence of hepatotoxicity</b> (elevated LFTs) regardless of APAP level<br>5. <b>Late presentation</b> (&gt;24 hours) with any detectable APAP<br><br><i>NAC is most effective within 8 hours but still beneficial up to 72+ hours.</i>" },
            { q: "What is the <b>classic acid-base disturbance</b> in salicylate poisoning?", a: "<b>Mixed disorder:</b><br><br>1. <b>Primary respiratory alkalosis</b> — direct stimulation of medullary respiratory center → hyperventilation<br>2. <b>Anion gap metabolic acidosis (AGMA)</b> — uncoupling of oxidative phosphorylation, accumulation of lactic acid, ketoacids, and salicylic acid<br><br><i>Early: respiratory alkalosis predominates<br>Late: metabolic acidosis predominates (ominous sign)</i><br><br>ABG pattern: ↓ pCO₂, ↓ HCO₃⁻, elevated anion gap." },
            { q: "What classic <b>symptom</b> is associated with early salicylate toxicity?", a: "<b>Tinnitus</b> (ringing in the ears) — one of the earliest symptoms of salicylism.<br><br>Other early symptoms:<br>• Nausea, vomiting<br>• Hyperventilation (Kussmaul-type breathing)<br>• Diaphoresis<br>• Hyperthermia<br><br>Late findings: <b>altered mental status, seizures, pulmonary edema (non-cardiogenic), cerebral edema</b>." },
            { q: "What is the <b>treatment</b> of moderate-to-severe <u>salicylate poisoning</u>?", a: "<b>Sodium bicarbonate:</b><br>• IV bolus then infusion (150 mEq in 1L D5W)<br>• Goal: <b>urine pH &gt;7.5</b> (alkalinize urine to trap salicylate in renal tubules as ionized form)<br>• Also maintain <b>serum pH 7.45–7.55</b><br><br><b>Avoid intubation if possible</b> — loss of compensatory hyperventilation → rapid acidemia → ↑ CNS salicylate penetration<br><br><b>Replace potassium</b> aggressively — hypokalemia prevents urine alkalinization." },
            { q: "What are the <b>indications for hemodialysis</b> in salicylate poisoning?", a: "<b>Indications for hemodialysis:</b><br><br>1. <b>Salicylate level &gt;90-100 mg/dL</b> (acute) or &gt;60 mg/dL (chronic)<br>2. <b>Renal failure</b> (unable to excrete salicylate)<br>3. <b>Pulmonary edema / ARDS</b><br>4. <b>Severe CNS toxicity</b> (altered mental status, seizures)<br>5. <b>Clinical deterioration</b> despite aggressive therapy<br>6. <b>Acidemia refractory</b> to bicarbonate<br>7. <b>Cardiovascular collapse</b><br><br>Salicylate is <b>readily dialyzable</b> (small molecule, low Vd, protein-bound but saturated in OD)." },
            { q: "Why is <b>intubation dangerous</b> in severe salicylate poisoning?", a: "Patients compensate for metabolic acidosis with <b>profound hyperventilation</b> (minute ventilation up to 20–30 L/min).<br><br><b>Risks of intubation:</b><br>1. Brief apneic period during RSI → <b>rapid pH drop</b><br>2. Ventilator often cannot match the patient's respiratory rate/tidal volume<br>3. ↓ pH → salicylate shifts from ionized (plasma) to <b>unionized form</b> → crosses BBB → <b>↑ CNS toxicity → death</b><br><br><b>If intubation required:</b> pre-bolus bicarbonate, match high minute ventilation immediately." },
            { q: "What is the <b>Done nomogram</b> and is it still used?", a: "The <b>Done nomogram</b> plotted serum salicylate levels against time post-ingestion to predict toxicity severity.<br><br><b>It is largely obsolete and unreliable because:</b><br>1. Assumes single acute ingestion of non-enteric-coated ASA<br>2. Does not account for <b>chronic toxicity</b> (which occurs at lower levels)<br>3. <b>Clinical status</b> is a better predictor of severity than levels alone<br><br>Current practice: use <b>clinical assessment + serial levels + acid-base status</b> to guide management." },
            { q: "What is the <b>primary mechanism of cardiac toxicity</b> in TCA overdose?", a: "<b>Fast sodium channel blockade</b> (Class Ia antiarrhythmic effect):<br><br>• Slows phase 0 depolarization → <b>wide QRS complex (&gt;100 ms)</b><br>• Causes conduction delays, ventricular dysrhythmias<br>• <b>Right axis deviation</b> of terminal 40 ms<br>• <b>Terminal R wave in aVR &gt;3 mm</b> (most sensitive ECG marker)<br><br>Other mechanisms: anticholinergic effects, α₁-adrenergic blockade (hypotension), GABA-A antagonism (seizures)." },
            { q: "What <b>ECG findings</b> predict serious toxicity in TCA overdose?", a: "<b>Key ECG findings:</b><br><br>1. <b>QRS &gt;100 ms</b> → risk of <b>seizures</b><br>2. <b>QRS &gt;160 ms</b> → risk of <b>ventricular arrhythmias</b><br>3. <b>Terminal R wave in aVR &gt;3 mm</b> — most sensitive/specific for TCA toxicity<br>4. <b>Right axis deviation</b> of terminal 40 ms QRS vector<br>5. <b>Sinus tachycardia</b> (anticholinergic effect)<br>6. <b>Brugada-like pattern</b> in V1-V3<br>7. Prolonged QTc" },
            { q: "What is the <b>treatment for TCA-induced QRS widening</b>?", a: "<b>Sodium bicarbonate</b> — first-line treatment:<br><br>• <b>1–2 mEq/kg IV bolus</b>, may repeat<br>• Target <b>serum pH 7.45–7.55</b><br>• Overcomes sodium channel blockade by increasing extracellular Na⁺<br>• Alkalemia favors protein binding of TCA<br><br><b>Indications:</b><br>• QRS &gt;100 ms<br>• Ventricular arrhythmias<br>• Hypotension refractory to fluids<br><br><b>Goal: QRS narrowing to &lt;100 ms</b>. Follow with bicarb drip." },
            { q: "Why should <b>flumazenil</b> be avoided in suspected TCA co-ingestion?", a: "Flumazenil reverses benzodiazepine effects, which may <b>unmask TCA-induced seizures</b>.<br><br>• Benzodiazepines enhance <b>GABA inhibition</b> → protective against seizures<br>• TCAs are <b>GABA-A antagonists</b> → lower seizure threshold<br>• Removing benzo effect → <b>precipitates refractory seizures and fatal arrhythmias</b><br><br><b>Never give flumazenil</b> if TCA ingestion is suspected or unknown mixed OD." },
            { q: "What is the <b>treatment of TCA-induced seizures</b>?", a: "<b>First-line: Benzodiazepines</b><br>• Lorazepam 0.1 mg/kg IV or diazepam 0.2 mg/kg IV<br><br><b>Second-line: Sodium bicarbonate</b><br>• Seizures may worsen acidosis → worsens sodium channel blockade<br><br><b>Do NOT use:</b><br>• <b>Phenytoin</b> — also blocks sodium channels, worsens toxicity<br>• <b>Physostigmine</b> — may cause asystole<br><br>If refractory: propofol, barbiturates (phenobarbital), or general anesthesia." },
            { q: "What are the <b>anticholinergic effects</b> of TCA toxicity?", a: "<b>Anticholinergic effects of TCAs:</b><br><br>• <b>Sinus tachycardia</b> (often earliest sign)<br>• <b>Mydriasis</b><br>• <b>Dry mouth / skin</b><br>• <b>Urinary retention</b><br>• <b>Decreased bowel sounds / ileus</b><br>• <b>Hyperthermia</b><br>• <b>Delirium / agitation</b><br><br>These overlap with anticholinergic toxidrome. <b>Sinus tachycardia</b> may be the only early finding." },
            { q: "What is the <b>initial naloxone dosing</b> for suspected opioid overdose?", a: "<b>Naloxone (Narcan) dosing:</b><br><br>• <b>IV/IM/SC: 0.4–2 mg</b>, repeat q2–3 min as needed<br>• <b>Intranasal: 4 mg</b> (concentrated spray)<br>• Maximum: no absolute ceiling, but typical cumulative max ~10 mg<br><br><b>Considerations:</b><br>• <b>Synthetic opioids (fentanyl, carfentanil)</b>: may require <b>higher and repeated doses</b> (up to 10+ mg)<br>• Start low (0.04–0.1 mg) in <b>known chronic users</b> to avoid precipitated withdrawal<br>• <b>Duration of action: 30–90 min</b> — may be shorter than opioid → watch for resedation" },
            { q: "What is <b>precipitated withdrawal</b> from naloxone and how is it managed?", a: "<b>Precipitated withdrawal</b> occurs when naloxone abruptly displaces opioids from μ-receptors in dependent patients.<br><br><b>Symptoms:</b><br>• Agitation, anxiety, yawning<br>• Piloerection (\"gooseflesh\"), rhinorrhea, lacrimation<br>• Nausea, vomiting, <b>diarrhea</b><br>• Abdominal cramps, myalgias<br>• Tachycardia, hypertension<br><br><b>Management:</b> supportive care; <b>not fatal</b> in adults (but can be dangerous in neonates). Avoid by titrating naloxone to <b>respiratory effort, not full consciousness</b>." },
            { q: "Why are <b>fentanyl and carfentanil</b> particularly dangerous in opioid overdoses?", a: "<b>Fentanyl</b> — 50–100× more potent than morphine<br><b>Carfentanil</b> — ~10,000× more potent than morphine<br><br><b>Challenges:</b><br>1. Small quantities → large effect; easy to overdose<br>2. <b>Standard naloxone doses may be insufficient</b> — may need 10+ mg<br>3. Rapid onset → rapid respiratory arrest<br>4. Often mixed with heroin or pressed into counterfeit pills<br>5. <b>Not detected on standard urine drug screens</b> (need specific immunoassay)<br>6. Chest wall rigidity (\"wooden chest syndrome\") at high doses" },
            { q: "When should a patient be <b>observed after naloxone administration</b>?", a: "<b>Observation considerations:</b><br><br>• Naloxone half-life: <b>30–90 min</b><br>• If opioid has <b>longer half-life</b> (methadone ~24–36 h, extended-release formulations) → risk of <b>resedation</b><br>• Minimum observation: <b>4–6 hours</b> after last naloxone dose<br>• May need <b>naloxone infusion</b>: 2/3 of effective bolus dose per hour<br>• <b>Short-acting opioid</b> (heroin) + single naloxone dose + 1 hour observation → may discharge if reliable" },
            { q: "What is the <b>mechanism of toxicity</b> in benzodiazepine overdose?", a: "<b>Benzodiazepines</b> enhance <b>GABA-A receptor</b> activity → ↑ chloride channel opening frequency → CNS depression.<br><br><b>Toxicity features:</b><br>• <b>CNS depression</b> (sedation → coma)<br>• <b>Respiratory depression</b> (usually mild in isolation)<br>• Ataxia, slurred speech<br>• Hypotension (mild)<br><br><b>Key point:</b> Benzodiazepines alone rarely cause death. Most fatal BZD ODs involve <b>co-ingestion</b> (opioids, alcohol, other sedatives)." },
            { q: "What are the <b>indications and contraindications</b> for <u>flumazenil</u>?", a: "<b>Flumazenil</b> — competitive GABA-A antagonist:<br><br><b>Indications:</b><br>• Reversal of <b>iatrogenic</b> benzodiazepine sedation (procedural sedation)<br>• <b>Known pure BZD overdose</b> in BZD-naive patient<br><br><b>Contraindications (critical):</b><br>1. <b>Chronic benzodiazepine use</b> → precipitates withdrawal seizures<br>2. <b>Seizure disorder</b> (BZDs may be anticonvulsant)<br>3. <b>TCA co-ingestion</b> → unmasks seizures and arrhythmias<br>4. <b>Unknown overdose / mixed ingestion</b><br>5. <b>Elevated ICP</b><br><br>Dose: <b>0.2 mg IV over 30 sec</b>, repeat 0.3–0.5 mg q1 min (max 3–5 mg)." },
            { q: "What is the <b>mechanism of toxicity</b> of organophosphates?", a: "<b>Organophosphates</b> irreversibly inhibit <b>acetylcholinesterase (AChE)</b> → accumulation of acetylcholine at:<br><br>1. <b>Muscarinic receptors</b> → DUMBBBELS/SLUDGE (parasympathetic overactivation)<br>2. <b>Nicotinic receptors</b> → fasciculations, weakness, paralysis, tachycardia<br>3. <b>CNS</b> → seizures, coma<br><br>Common agents: malathion, parathion, sarin, VX, tabun, soman.<br>Carbamates are <b>reversible</b> AChE inhibitors (shorter duration)." },
            { q: "What is the <b>mechanism and dosing of atropine</b> in organophosphate poisoning?", a: "<b>Atropine</b> — competitive <b>muscarinic antagonist</b>:<br><br>• Blocks excessive ACh at muscarinic receptors<br>• Does <b>NOT</b> reverse nicotinic effects (fasciculations, paralysis)<br><br><b>Dosing:</b><br>• Adult: <b>2–4 mg IV</b> initially<br>• <b>Double the dose q3–5 min</b> until <b>secretions dry</b><br>• May require <b>massive doses</b> (100+ mg in severe cases)<br><br><b>Endpoint: drying of bronchial secretions</b> (NOT pupil size or heart rate).<br><br>Give <b>before 2-PAM</b>. Atropinize first to prevent worsening." },
            { q: "What is <b>pralidoxime (2-PAM)</b> and why is timing critical?", a: "<b>Pralidoxime (2-PAM)</b>:<br><br>• <b>Reactivates acetylcholinesterase</b> by cleaving the organophosphate-enzyme bond<br>• Effective at both <b>muscarinic and nicotinic sites</b> (unlike atropine)<br><br><b>Dosing:</b> 1–2 g IV over 15–30 min, may repeat or continuous infusion<br><br><b>Timing is critical:</b><br>• Must be given <b>before \"aging\"</b> occurs — irreversible bond between OP and enzyme<br>• Aging time varies: <b>sarin ~5 h, soman ~2 min, VX ~48 h</b><br>• After aging → 2-PAM is <b>ineffective</b><br>• Generally give within <b>24–48 hours</b> of exposure" },
            { q: "What is the <b>intermediate syndrome</b> in organophosphate poisoning?", a: "<b>Intermediate syndrome:</b><br><br>• Occurs <b>24–96 hours</b> after acute cholinergic crisis resolves<br>• Weakness of <b>proximal limb muscles, neck flexors, respiratory muscles, and cranial nerves</b><br>• Primarily a <b>nicotinic effect</b><br>• Risk of <b>respiratory failure</b><br>• Does NOT respond well to atropine or 2-PAM<br>• Treatment: <b>supportive care + mechanical ventilation</b> as needed<br>• Resolves in <b>1–3 weeks</b>" },
            { q: "What toxic metabolite does <b>methanol</b> produce and what is its primary organ toxicity?", a: "<b>Methanol</b> is metabolized by alcohol dehydrogenase to <b>formaldehyde</b> → then to <b>formic acid</b>.<br><br><b>Formic acid</b> causes:<br>• <b>Optic nerve/retinal toxicity</b> → blurred vision, blindness (\"snowfield vision\")<br>• Severe <b>anion gap metabolic acidosis</b><br>• Basal ganglia hemorrhage/necrosis<br><br>Sources: windshield washer fluid, antifreeze, solvents, moonshine." },
            { q: "What toxic metabolite does <b>ethylene glycol</b> produce and what is its primary organ toxicity?", a: "<b>Ethylene glycol</b> → glycoaldehyde → glycolic acid → <b>oxalic acid</b><br><br><b>Oxalic acid</b> combines with calcium → <b>calcium oxalate crystals</b>:<br>• <b>Renal tubular deposition</b> → acute kidney injury / renal failure<br>• <b>Envelope-shaped crystals</b> on urinalysis (pathognomonic)<br>• Hypocalcemia → QT prolongation, tetany<br><br>Also causes severe <b>AGMA</b>.<br>Sources: antifreeze (sweet taste), coolants." },
            { q: "How does <b>isopropanol</b> toxicity differ from methanol and ethylene glycol?", a: "<b>Isopropanol</b> (rubbing alcohol) → metabolized to <b>acetone</b> (by ADH).<br><br><b>Key difference: ketosis WITHOUT acidosis</b><br>• Acetone is a ketone → <b>elevated serum ketones</b><br>• Acetone is <b>not an acid</b> → <b>no metabolic acidosis</b><br>• <b>No anion gap elevation</b><br>• Causes <b>osmol gap elevation</b><br><br>Clinical: CNS depression, GI irritation, fruity breath (acetone).<br>Treatment: <b>supportive care</b>; fomepizole and dialysis rarely needed." },
            { q: "How is the <b>osmol gap</b> calculated and what does an elevated gap suggest?", a: "<b>Osmol gap</b> = Measured serum osmolality − Calculated osmolality<br><br>$$\\\\text{Calculated Osm} = 2[\\\\text{Na}^+] + \\\\frac{\\\\text{Glucose}}{18} + \\\\frac{\\\\text{BUN}}{2.8} + \\\\frac{\\\\text{EtOH}}{4.6}$$<br><br><b>Normal osmol gap: &lt;10 mOsm/kg</b><br><br><b>Elevated osmol gap (&gt;10) suggests:</b><br>• Methanol<br>• Ethylene glycol<br>• Isopropanol<br>• Ethanol (if not included in calculation)<br>• Mannitol, propylene glycol<br><br><i>Note: Normal osmol gap does NOT rule out toxic alcohol if metabolized to acid form.</i>" },
            { q: "What is the <b>treatment</b> for methanol and ethylene glycol poisoning?", a: "<b>Antidote: Fomepizole (Antizol)</b> — preferred over ethanol<br>• Competitive inhibitor of <b>alcohol dehydrogenase (ADH)</b><br>• Prevents formation of toxic metabolites<br>• Dose: <b>15 mg/kg loading</b>, then 10 mg/kg q12h<br><br><b>Ethanol</b> — alternative if fomepizole unavailable<br>• Also competitive ADH inhibitor<br>• Harder to dose, causes inebriation, hypoglycemia<br><br><b>Hemodialysis indications:</b><br>• Severe acidosis (pH &lt;7.25)<br>• Renal failure<br>• Visual symptoms (methanol)<br>• Level &gt;50 mg/dL<br>• Deterioration despite fomepizole<br><br><b>Adjuncts:</b> folic acid (methanol), thiamine + pyridoxine (ethylene glycol)." },
            { q: "Why is <b>fomepizole preferred over ethanol</b> for toxic alcohol poisoning?", a: "<b>Fomepizole advantages:</b><br><br>1. Predictable pharmacokinetics — <b>easy to dose</b><br>2. <b>No CNS depression</b><br>3. No hypoglycemia<br>4. Does not require ICU for monitoring<br>5. Does not require frequent level checks<br>6. Can be given as simple IV infusion<br><br><b>Ethanol disadvantages:</b><br>• Inebriation, respiratory depression<br>• Hypoglycemia (especially children)<br>• Requires ICU monitoring + frequent ethanol levels<br>• Difficult to maintain therapeutic level (100–150 mg/dL)" },
            { q: "Why is <b>pulse oximetry unreliable</b> in carbon monoxide poisoning?", a: "<b>Pulse oximetry reads falsely normal in CO poisoning</b> because:<br><br>• Standard pulse ox uses <b>two wavelengths</b> (660 nm, 940 nm)<br>• <b>Carboxyhemoglobin (COHb)</b> absorbs light at 660 nm similarly to <b>oxyhemoglobin</b><br>• Pulse ox cannot distinguish COHb from O₂Hb → reads <b>SpO₂ ~100%</b> even with significant CO poisoning<br><br><b>Must use: CO-oximetry</b> (uses multiple wavelengths) → directly measures COHb, MetHb, O₂Hb.<br>Obtain <b>ABG with co-oximetry</b>." },
            { q: "What are the <b>carboxyhemoglobin (COHb) levels</b> and their clinical significance?", a: "<b>COHb levels and symptoms:</b><br><br>• <b>&lt;5%</b>: Normal (smokers up to 10%)<br>• <b>10–20%</b>: Headache, mild dyspnea<br>• <b>20–30%</b>: Severe headache, nausea, impaired judgment<br>• <b>30–40%</b>: Confusion, syncope, tachycardia<br>• <b>40–60%</b>: Coma, seizures, cardiovascular collapse<br>• <b>&gt;60%</b>: Usually fatal<br><br><i>Note: COHb levels may not correlate well with clinical severity, especially if treatment has started before measurement.</i>" },
            { q: "What are the <b>indications for hyperbaric oxygen (HBO)</b> in CO poisoning?", a: "<b>Indications for HBO therapy:</b><br><br>1. <b>Loss of consciousness</b> (at any point)<br>2. <b>COHb &gt;25%</b> (some say &gt;25–40%)<br>3. <b>Cardiac ischemia or arrhythmia</b><br>4. <b>Neurological deficits</b> (confusion, ataxia, focal findings)<br>5. <b>Pregnancy</b> with COHb &gt;15–20%<br>6. <b>Persistent symptoms</b> despite normobaric O₂<br><br>HBO reduces half-life of COHb:<br>• Room air: ~5–6 hours<br>• 100% NRB: ~60–90 min<br>• HBO (2.5–3 atm): ~20–30 min<br><br>Goal: prevent <b>delayed neuropsychiatric syndrome</b> (DNS)." },
            { q: "What is <b>delayed neuropsychiatric syndrome (DNS)</b> of CO poisoning?", a: "<b>DNS</b> occurs <b>2–40 days</b> after apparent recovery from CO poisoning.<br><br><b>Features:</b><br>• Cognitive impairment, memory loss<br>• Personality changes, irritability<br>• Parkinsonism, gait disturbance<br>• Dementia, psychosis<br>• Incontinence<br><br>Occurs in <b>15–40%</b> of significant CO exposures.<br><b>MRI</b> may show bilateral globus pallidus necrosis, white matter demyelination.<br><b>HBO therapy</b> may reduce incidence but evidence is debated." },
            { q: "Compare <b>alkali</b> vs. <b>acid</b> caustic ingestion injuries.", a: "<table><tr><th>Feature</th><th>Alkali (base)</th><th>Acid</th></tr><tr><td><b>Mechanism</b></td><td><b>Liquefactive necrosis</b></td><td><b>Coagulative necrosis</b></td></tr><tr><td><b>Depth</b></td><td>Deep, penetrating</td><td>Superficial (eschar limits depth)</td></tr><tr><td><b>Primary site</b></td><td><b>Esophagus</b></td><td><b>Stomach</b> (antrum/pylorus)</td></tr><tr><td><b>Stricture risk</b></td><td>Higher (esophageal)</td><td>Lower (gastric outlet obstruction)</td></tr><tr><td><b>Perforation risk</b></td><td>Higher (full-thickness)</td><td>Present but less common</td></tr><tr><td><b>Examples</b></td><td>Lye, bleach, drain cleaner, oven cleaner</td><td>Battery acid, toilet bowl cleaner, HCl, HF</td></tr></table>" },
            { q: "What procedures are <b>contraindicated</b> after caustic ingestion?", a: "<b>Contraindicated after caustic ingestion (5 NOs):</b><br><br>1. <b>NO emesis / ipecac</b> — re-exposes esophagus to caustic<br>2. <b>NO activated charcoal</b> — does not bind caustics, obscures endoscopy<br>3. <b>NO nasogastric tube (blind)</b> — perforation risk<br>4. <b>NO neutralization</b> (e.g., acid to neutralize alkali) — exothermic reaction → thermal injury<br>5. <b>NO dilution</b> with large volumes (controversial; small sips of water may be acceptable early)<br><br><b>DO:</b> NPO, IV access, consult GI for <b>endoscopy within 12–24 hours</b>." },
            { q: "When should <b>endoscopy</b> be performed after caustic ingestion?", a: "<b>Endoscopy timing:</b><br><br>• <b>Within 12–24 hours</b> of ingestion (ideally within 12 h)<br>• <b>Do not delay beyond 48 hours</b> — tissue weakening → perforation risk increases<br>• Avoid between <b>day 5–15</b> (maximum tissue weakness → highest perforation risk)<br><br><b>Grading of caustic injury:</b><br>• Grade 1: superficial edema, erythema<br>• Grade 2a: non-circumferential ulcers<br>• Grade 2b: circumferential ulcers<br>• Grade 3a: focal necrosis<br>• Grade 3b: extensive necrosis → surgery likely needed" },
            { q: "What are the <b>5 stages of iron toxicity</b>?", a: "<b>Stage I (0–6 h):</b> GI phase — nausea, vomiting, <b>bloody diarrhea</b>, abdominal pain (direct GI mucosal corrosion)<br><br><b>Stage II (6–24 h):</b> \"Quiescent\" phase — <b>apparent improvement</b> (deceptive!). Iron absorbing into tissues<br><br><b>Stage III (12–48 h):</b> Systemic toxicity — <b>shock</b>, metabolic acidosis, hepatic failure, coagulopathy, multi-organ failure<br><br><b>Stage IV (2–5 days):</b> Hepatotoxicity — <b>hepatic necrosis</b>, elevated LFTs, coagulopathy<br><br><b>Stage V (2–8 weeks):</b> GI scarring — <b>pyloric/gastric outlet obstruction</b> from strictures" },
            { q: "At what serum iron level is toxicity considered <b>severe</b> and what are the treatment thresholds?", a: "<b>Serum iron levels and severity:</b><br><br>• <b>&lt;300 µg/dL</b>: Mild or no toxicity<br>• <b>300–500 µg/dL</b>: Moderate toxicity<br>• <b>&gt;500 µg/dL</b>: <b>Severe toxicity</b> — systemic effects likely<br><br><b>Deferoxamine indications:</b><br>• Serum iron <b>&gt;500 µg/dL</b><br>• Clinically significant toxicity (shock, altered mental status, severe GI symptoms)<br>• Metabolic acidosis<br>• Radiopaque pills on AXR after decontamination<br><br>Peak iron levels are typically at <b>4–6 hours</b> post-ingestion." },
            { q: "What is <b>deferoxamine</b> and what is the classic urine finding?", a: "<b>Deferoxamine (Desferal)</b>:<br><br>• <b>Iron chelator</b> — binds free iron → forms ferrioxamine (renally excreted)<br>• Dose: <b>15 mg/kg/h IV</b> continuous infusion (max 6–8 g/day)<br>• <b>Vin rosé colored urine</b> — classic finding indicating iron-deferoxamine complex excretion<br><br><b>Side effects:</b><br>• Hypotension (if infused too rapidly)<br>• <b>ARDS</b> (if infusion &gt;24 hours)<br>• Yersinia sepsis (iron-dependent organism)<br><br>Continue until clinical improvement and urine color normalizes." },
            { q: "What is the role of <b>abdominal X-ray</b> in iron overdose?", a: "<b>Iron tablets are radiopaque</b> and can be visualized on abdominal X-ray (KUB).<br><br><b>Uses:</b><br>• Confirm ingestion<br>• Estimate pill burden<br>• Monitor decontamination effectiveness (whole bowel irrigation)<br><br><b>Limitations:</b><br>• Chewable/liquid preparations may NOT be visible<br>• Already dissolved tablets may not be seen<br>• Children's vitamins may be poorly visible<br><br><b>Other radiopaque substances (mnemonic CHIPS):</b> Chloral hydrate, Heavy metals, Iron, Phenothiazines, Sustained-release/enteric-coated." },
            { q: "What is <b>basophilic stippling</b> and what condition is it classically associated with?", a: "<b>Basophilic stippling</b>:<br><br>• <b>Blue-purple granules</b> (aggregated ribosomes) seen in RBCs on peripheral blood smear<br>• Classic finding in <b>lead poisoning</b><br>• Caused by inhibition of <b>pyrimidine-5'-nucleotidase</b> → ribosomal RNA aggregation<br><br><b>Also seen in:</b> thalassemia, sideroblastic anemia, myelodysplastic syndrome, arsenic poisoning.<br><br>Lead also causes <b>microcytic, hypochromic anemia</b> (inhibits ALA dehydratase and ferrochelatase in heme synthesis)." },
            { q: "What are <b>Burton lines</b> (lead lines)?", a: "<b>Burton lines</b>:<br><br>• <b>Blue-black discoloration</b> along the gingival margin (gum line)<br>• Caused by deposition of <b>lead sulfide</b> in the gingiva<br>• Requires coexisting <b>poor dental hygiene</b> (bacterial H₂S reacts with lead)<br>• Classic finding of <b>chronic lead poisoning</b><br>• More common in <b>adults</b> than children<br><br>Other classic findings: <b>lead lines</b> on long bone X-rays (children) — dense metaphyseal bands." },
            { q: "What are the <b>clinical features</b> of <u>lead encephalopathy</u>?", a: "<b>Lead encephalopathy</b> (blood lead usually <b>&gt;70–100 µg/dL</b>):<br><br>• <b>Headache</b>, irritability<br>• <b>Altered mental status</b>, confusion<br>• <b>Seizures</b><br>• <b>Cerebral edema</b> → ↑ ICP → coma<br>• <b>Vomiting</b> (may mimic gastroenteritis)<br><br><b>Medical emergency</b> — mortality up to 65% if untreated.<br><br>Treatment: <b>CaNa₂EDTA + BAL (dimercaprol)</b> for severe/encephalopathic cases.<br>BAL given <b>IM first</b>, then EDTA (to avoid redistribution of lead to brain)." },
            { q: "What are the <b>chelation agents</b> used for lead poisoning?", a: "<b>Chelation therapy for lead:</b><br><br><b>Mild-moderate (BLL 45–69 µg/dL):</b><br>• <b>Succimer (DMSA)</b> — oral chelator<br>• 10 mg/kg q8h × 5 days, then q12h × 14 days<br><br><b>Severe / encephalopathy (BLL ≥70 µg/dL):</b><br>• <b>BAL (dimercaprol)</b> — IM injection (given first!)<br>• + <b>CaNa₂EDTA</b> — IV (given 4 hours AFTER BAL)<br>• BAL first to prevent EDTA from redistributing lead to brain<br><br><b>Never use D-penicillamine first-line</b> (many side effects).<br><b>Never use CaNa₂EDTA alone in encephalopathy.</b>" },
            { q: "What are the <b>classic clinical features</b> of digoxin toxicity?", a: "<b>Digoxin toxicity features:</b><br><br><b>GI:</b> Nausea, vomiting, anorexia (often earliest symptoms)<br><br><b>Visual:</b> <b>Yellow-green halos (xanthopsia)</b>, blurred vision, photophobia<br><br><b>Cardiac:</b> Almost <b>any arrhythmia</b> can occur:<br>• Bradycardia, heart block (AV block)<br>• Atrial tachycardia with block<br>• Bidirectional VT (classic!)<br>• Junctional rhythms<br>• PVCs (most common)<br><br><b>EXCEPT: rapid atrial fibrillation/flutter</b> (digoxin slows AV node → would need to overcome this)<br><br><b>Metabolic:</b> <b>Hyperkalemia</b> (inhibits Na⁺/K⁺ ATPase)" },
            { q: "Why does <b>hyperkalemia</b> occur in acute digoxin toxicity?", a: "Digoxin inhibits the <b>Na⁺/K⁺-ATPase</b> pump:<br><br>• Normally pumps <b>3 Na⁺ out, 2 K⁺ in</b><br>• Inhibition → <b>K⁺ remains extracellular</b> → hyperkalemia<br>• Intracellular Na⁺ accumulates → Na⁺/Ca²⁺ exchanger reverses → ↑ intracellular Ca²⁺ → ↑ contractility but also arrhythmias<br><br><b>Hyperkalemia in acute digoxin toxicity is a marker of severity</b> and correlates with mortality.<br><b>K⁺ &gt;5.5 mEq/L</b> → consider Digibind/DigiFab.<br><br><i>Note: In chronic toxicity, hypokalemia may precipitate toxicity at therapeutic levels.</i>" },
            { q: "What are the <b>indications</b> for <u>Digibind/DigiFab</u> (digoxin-specific antibody fragments)?", a: "<b>Digibind/DigiFab indications:</b><br><br>1. <b>Life-threatening arrhythmias</b> (hemodynamically unstable VT/VF, high-grade AV block)<br>2. <b>Hyperkalemia &gt;5.0–5.5 mEq/L</b> in acute poisoning<br>3. <b>Acute ingestion &gt;10 mg</b> (adult) or &gt;4 mg (child)<br>4. <b>Digoxin level &gt;10–15 ng/mL</b> at steady state<br>5. <b>Hemodynamic instability</b><br>6. <b>End-organ dysfunction</b> (renal failure, altered mental status)<br><br><b>Dosing:</b> based on ingested dose or steady-state level.<br>Each vial binds ~0.5 mg of digoxin.<br><i>Note: After DigiFab, total digoxin levels rise (bound + free) but free (active) digoxin drops.</i>" },
            { q: "What arrhythmia is <b>virtually pathognomonic</b> for digoxin toxicity?", a: "<b>Bidirectional ventricular tachycardia</b>:<br><br>• Alternating QRS axis (beat-to-beat variation)<br>• Wide-complex tachycardia with two alternating morphologies<br>• <b>Nearly pathognomonic</b> for digoxin toxicity<br><br><b>Other classic arrhythmias:</b><br>• <b>Atrial tachycardia with AV block</b> (PAT with block) — enhanced automaticity + AV nodal suppression<br>• <b>Regularized atrial fibrillation</b> — accelerated junctional rhythm taking over → regular rate in a patient with AF<br><br><b>Treat: DigiFab, NOT cardioversion</b> (may cause refractory VF)." },
            { q: "What is <b>high-dose insulin euglycemic therapy (HIET)</b> and when is it used?", a: "<b>HIET</b> — increasingly considered <b>first-line</b> for severe CCB/BB toxicity:<br><br><b>Mechanism:</b><br>• Insulin promotes <b>myocardial glucose uptake</b> (preferred substrate in toxicity)<br>• <b>Positive inotropic effect</b> independent of catecholamine receptors<br>• Improves cardiac contractility and hemodynamics<br><br><b>Dosing:</b><br>• <b>Bolus: 1 unit/kg regular insulin</b><br>• <b>Infusion: 0.5–1 unit/kg/hr</b>, titrate up to 10 units/kg/hr<br>• Coadminister <b>D50 bolus + D10 infusion</b> to prevent hypoglycemia<br>• Monitor glucose q15–30 min initially, then hourly<br>• Monitor K⁺ closely (supplement as needed)" },
            { q: "What is the role of <b>glucagon</b> in beta-blocker overdose?", a: "<b>Glucagon</b> — traditionally considered first-line for BB overdose:<br><br><b>Mechanism:</b><br>• Activates adenylyl cyclase via <b>glucagon receptor</b> (G-protein coupled)<br>• <b>Bypasses β-receptor blockade</b><br>• Increases cAMP → ↑ intracellular Ca²⁺ → <b>positive inotropy and chronotropy</b><br><br><b>Dosing:</b><br>• <b>3–5 mg IV bolus</b> (50–150 µg/kg) over 1 min<br>• May repeat in 5 min<br>• Infusion: <b>2–5 mg/hr</b><br><br><b>Side effects:</b> nausea/vomiting (pretreat with ondansetron), hyperglycemia, hypokalemia.<br><i>HIET is increasingly preferred over glucagon due to better evidence.</i>" },
            { q: "Compare <b>calcium chloride</b> vs. <b>calcium gluconate</b> in CCB overdose.", a: "<b>Calcium salts</b> increase extracellular Ca²⁺ to overcome CCB channel blockade:<br><br><table><tr><th>Feature</th><th>Calcium Chloride (10%)</th><th>Calcium Gluconate (10%)</th></tr><tr><td><b>Elemental Ca²⁺</b></td><td><b>272 mg per 10 mL</b> (3× more)</td><td>93 mg per 10 mL</td></tr><tr><td><b>Route</b></td><td><b>Central line preferred</b></td><td>Peripheral IV safe</td></tr><tr><td><b>Tissue necrosis risk</b></td><td>High if extravasation</td><td>Low</td></tr><tr><td><b>Dose</b></td><td>10–20 mL (1–2 g)</td><td>30–60 mL (3–6 g)</td></tr></table><br>Calcium chloride preferred via central line for maximal effect." },
            { q: "What is <b>intralipid emulsion therapy (ILE)</b> and when is it used?", a: "<b>Intralipid (20% lipid emulsion)</b>:<br><br><b>Mechanism (proposed):</b><br>• Creates a \"lipid sink\" — sequesters lipophilic drugs from tissues<br>• Provides fatty acid substrate for cardiac metabolism<br><br><b>Indications:</b><br>• <b>Last resort / cardiac arrest</b> from lipophilic drug toxicity<br>• Local anesthetic systemic toxicity (<b>LAST</b>) — strongest evidence<br>• Severe CCB/BB toxicity refractory to other therapies<br>• TCA, other lipophilic drug overdose<br><br><b>Dosing:</b><br>• <b>1.5 mL/kg IV bolus</b> over 1 min<br>• Infusion: <b>0.25 mL/kg/min</b> × 30–60 min<br>• May repeat bolus q5 min (max 3 boluses)" },
            { q: "How do you differentiate <b>beta-blocker</b> from <b>calcium channel blocker</b> overdose?", a: "<b>Key differentiating features:</b><br><br><table><tr><th>Feature</th><th>Beta-blocker OD</th><th>CCB OD (dihydropyridine vs non-DHP)</th></tr><tr><td><b>Blood glucose</b></td><td><b>Hypoglycemia</b></td><td><b>Hyperglycemia</b> (insulin secretion blocked by L-type Ca²⁺ channels in pancreas)</td></tr><tr><td><b>Mental status</b></td><td>May be preserved</td><td>Often altered (especially verapamil/diltiazem)</td></tr><tr><td><b>Bronchospasm</b></td><td>Present (β₂ blockade)</td><td>Absent</td></tr></table><br>Both cause: bradycardia, hypotension, conduction delays.<br><b>Glucose level is the key lab differentiator.</b>" },
            { q: "What are the <b>clinical manifestations</b> of lithium toxicity?", a: "<b>Lithium toxicity features (by severity):</b><br><br><b>Mild (1.5–2.5 mEq/L):</b> Tremor, nausea, diarrhea, muscle weakness, drowsiness<br><br><b>Moderate (2.5–3.5 mEq/L):</b> Confusion, ataxia, dysarthria, myoclonus, fasciculations, hyperreflexia, nystagmus<br><br><b>Severe (&gt;3.5 mEq/L):</b> Seizures, coma, renal failure, cardiovascular collapse<br><br><b>Chronic findings:</b><br>• <b>Nephrogenic diabetes insipidus</b> (polyuria, polydipsia) — most common renal effect<br>• Hypothyroidism, hyperparathyroidism<br>• Ebstein anomaly (teratogenic — avoid in pregnancy 1st trimester)" },
            { q: "Why is <b>activated charcoal ineffective</b> for lithium?", a: "<b>Activated charcoal does NOT adsorb lithium</b> because:<br><br>• Lithium is a <b>small monovalent cation</b> (Li⁺)<br>• Charcoal preferentially binds <b>large, organic molecules</b><br>• Lithium has minimal binding affinity for charcoal<br><br><b>Alternatives for GI decontamination:</b><br>• <b>Whole bowel irrigation</b> with polyethylene glycol (PEG) — especially for sustained-release preparations<br>• Sodium polystyrene sulfonate (Kayexalate) — ion exchange resin, may bind lithium in GI tract (limited evidence)" },
            { q: "What are the <b>indications for hemodialysis</b> in lithium toxicity?", a: "<b>Hemodialysis indications for lithium:</b><br><br>1. <b>Level &gt;4 mEq/L</b> (acute ingestion)<br>2. <b>Level &gt;2.5 mEq/L</b> with significant symptoms (chronic toxicity)<br>3. <b>Renal failure</b> (unable to excrete lithium)<br>4. <b>Severe neurological symptoms</b> (seizures, coma)<br>5. <b>Life-threatening toxicity</b> unresponsive to fluids<br><br><b>Lithium is ideally dialyzable:</b> small molecule, low Vd (0.6–0.9 L/kg), no protein binding, water-soluble.<br><br><b>Watch for rebound</b>: lithium redistributes from tissues after HD → may need <b>prolonged or repeat dialysis</b>." },
            { q: "What causes <b>nephrogenic diabetes insipidus</b> in lithium use?", a: "<b>Lithium-induced nephrogenic DI:</b><br><br>• Lithium enters principal cells via <b>ENaC channels</b> in collecting duct<br>• Inhibits <b>aquaporin-2 (AQP2)</b> expression and trafficking<br>• Inhibits <b>vasopressin (ADH) signaling</b> via GSK-3β<br>• Collecting duct becomes <b>resistant to ADH</b> → impaired water reabsorption<br><br><b>Result:</b> Dilute polyuria (up to 3–6 L/day), polydipsia, hypernatremia risk.<br><br><b>Treatment:</b> amiloride (blocks Li⁺ entry), hydrochlorothiazide (paradoxical), adequate hydration." },
            { q: "What is the <b>mechanism of cyanide toxicity</b>?", a: "<b>Cyanide (CN⁻)</b> inhibits <b>cytochrome c oxidase</b> (Complex IV) in the mitochondrial electron transport chain:<br><br>• Blocks <b>oxidative phosphorylation</b> → cells cannot use O₂ for ATP<br>• <b>Cellular hypoxia despite adequate O₂ delivery</b><br>• Shifts to <b>anaerobic metabolism</b> → severe <b>lactic acidosis</b><br><br>Sources: fire smoke (burning synthetics), industrial (mining, electroplating), sodium nitroprusside (prolonged use), bitter almonds, cassava." },
            { q: "What is the finding of <b>cherry-red venous blood</b> in cyanide poisoning?", a: "<b>Cherry-red venous blood:</b><br><br>• Cells cannot extract/utilize O₂ → <b>venous blood remains oxygenated</b><br>• <b>Narrowed A-V O₂ difference</b> (venous PaO₂ approaches arterial)<br>• Venous blood appears <b>bright red</b><br><br><b>Lactic acidosis</b> is the key lab finding — severe, unexplained ↑ lactate &gt;8–10 mmol/L<br><br><i>Note: \"Cherry red\" is a late finding, similar to CO poisoning. Do not rely on it clinically.</i>" },
            { q: "Compare <b>hydroxocobalamin</b> vs. the <b>cyanide antidote kit</b> (nitrite + thiosulfate).", a: "<table><tr><th>Feature</th><th>Hydroxocobalamin (Cyanokit)</th><th>Nitrite/Thiosulfate Kit</th></tr><tr><td><b>Mechanism</b></td><td>Binds CN⁻ → cyanocobalamin (vitamin B₁₂)</td><td>Nitrites induce <b>methemoglobin</b> (MetHb binds CN⁻); thiosulfate donates sulfur for rhodanese enzyme → thiocyanate</td></tr><tr><td><b>Preferred?</b></td><td><b>YES — first-line</b></td><td>Alternative</td></tr><tr><td><b>Advantage</b></td><td>No MetHb formation, safe in <b>smoke inhalation</b> (concurrent CO)</td><td>Available, effective</td></tr><tr><td><b>Disadvantage</b></td><td>Red discoloration of skin/urine, expensive</td><td>Nitrites induce MetHb → dangerous if concurrent <b>CO poisoning</b> (further reduces O₂ carrying capacity)</td></tr><tr><td><b>Dose</b></td><td>5 g IV over 15 min</td><td>Amyl nitrite pearls (inhaled) → Na nitrite 300 mg IV → Na thiosulfate 12.5 g IV</td></tr></table>" },
            { q: "Why is <b>hydroxocobalamin preferred</b> over the nitrite kit in <u>smoke inhalation</u>?", a: "In smoke inhalation, patients often have <b>combined CO + CN poisoning</b>.<br><br><b>Problem with nitrites:</b><br>• Nitrites induce <b>methemoglobin (MetHb)</b><br>• MetHb <b>cannot carry O₂</b><br>• Patient already has <b>COHb</b> (also cannot carry O₂)<br>• Adding MetHb to COHb → <b>catastrophic reduction in O₂ delivery</b><br><br><b>Hydroxocobalamin:</b><br>• Does NOT induce MetHb<br>• Directly binds cyanide → non-toxic cyanocobalamin<br>• <b>Safe in concurrent CO poisoning</b><br>• Therefore <b>preferred in fire/smoke victims</b>" },
            { q: "What substances are <b>NOT adsorbed by activated charcoal</b>? (Mnemonic: PHAILS)", a: "<b>PHAILS — substances charcoal won't bind:</b><br><br><b>P</b> — Pesticides (some), Potassium<br><b>H</b> — Hydrocarbons, Heavy metals<br><b>A</b> — Acids, Alkalis, Alcohols<br><b>I</b> — Iron, Iodine, Isopropanol<br><b>L</b> — Lithium, Laxatives<br><b>S</b> — Solvents<br><br><i>Alternative mnemonic: \"Can't CLIMB\" — Cyanide, Caustics, Lithium, Iron, MetOH/mineral acids, Boric acid</i>" },
            { q: "What is <b>multi-dose activated charcoal (MDAC)</b> and when is it used?", a: "<b>Multi-dose activated charcoal:</b><br>• Repeated doses of AC (without cathartic) q2–4 hours<br>• Creates a <b>concentration gradient</b> across GI mucosa → \"gut dialysis\"<br>• Interrupts enterohepatic recirculation<br><br><b>Effective for (mnemonic: ABCD):</b><br>• <b>A</b>minophylline / theophylline<br>• <b>B</b>arbiturates (phenobarbital)<br>• <b>C</b>arbamazepine<br>• <b>D</b>apsone, Digoxin<br>• Also: quinine, salicylates (debated)<br><br>Dose: 0.5 g/kg q2–4h (first dose 1 g/kg)." },
            { q: "What are the key features of <b>anticholinesterase (carbamate)</b> poisoning compared to organophosphates?", a: "<b>Carbamate vs. Organophosphate poisoning:</b><br><br><table><tr><th>Feature</th><th>Carbamate</th><th>Organophosphate</th></tr><tr><td><b>AChE inhibition</b></td><td><b>Reversible</b></td><td><b>Irreversible</b> (without 2-PAM)</td></tr><tr><td><b>Duration</b></td><td>Shorter (hours)</td><td>Longer (days-weeks)</td></tr><tr><td><b>CNS effects</b></td><td>Fewer (poor BBB penetration)</td><td>Significant (seizures, coma)</td></tr><tr><td><b>Aging</b></td><td>Does not occur</td><td>Occurs (prevents 2-PAM effectiveness)</td></tr><tr><td><b>2-PAM</b></td><td>Generally not needed</td><td>Indicated</td></tr><tr><td><b>Atropine</b></td><td>YES</td><td>YES</td></tr></table>" },
            { q: "What is the <b>anion gap</b> and what is the mnemonic for elevated anion gap metabolic acidosis?", a: "<b>Anion gap</b> = Na⁺ − (Cl⁻ + HCO₃⁻)<br>Normal: <b>12 ± 4 mEq/L</b><br><br><b>MUDPILES mnemonic for AGMA:</b><br><b>M</b> — Methanol<br><b>U</b> — Uremia<br><b>D</b> — Diabetic ketoacidosis<br><b>P</b> — Paraldehyde, Propylene glycol<br><b>I</b> — Iron, Isoniazid, Ibuprofen<br><b>L</b> — Lactic acidosis<br><b>E</b> — Ethylene glycol<br><b>S</b> — Salicylates<br><br><i>Updated mnemonic: CAT MUDPILES adds Cyanide, Acetaminophen, Toluene</i>" },
            { q: "What are the <b>indications for enhanced elimination</b> techniques and what are the options?", a: "<b>Enhanced elimination techniques:</b><br><br>1. <b>Multi-dose activated charcoal (MDAC)</b> — theophylline, carbamazepine, phenobarbital, dapsone<br>2. <b>Urinary alkalinization</b> — salicylates, phenobarbital (trap ionized form in urine)<br>3. <b>Hemodialysis</b> — lithium, salicylates, methanol, ethylene glycol, theophylline, valproic acid<br>4. <b>Hemoperfusion</b> — theophylline, carbamazepine (rarely used now)<br><br><b>Ideal dialyzable drug properties:</b><br>• Low molecular weight<br>• Low protein binding<br>• Low volume of distribution<br>• Water-soluble" },
            { q: "What are the <b>ECG findings</b> in <u>hyperkalemia</u> (relevant to digoxin toxicity)?", a: "<b>Progressive ECG changes with rising K⁺:</b><br><br>1. <b>K⁺ 5.5–6.5:</b> <b>Peaked (tall, narrow) T waves</b> (earliest sign)<br>2. <b>K⁺ 6.5–7.5:</b> Prolonged PR interval, flattened P waves, widened QRS<br>3. <b>K⁺ 7.5–8.0:</b> Loss of P waves, further QRS widening, <b>sine wave pattern</b><br>4. <b>K⁺ &gt;8.0:</b> Ventricular fibrillation, asystole<br><br><b>Treatment priority:</b><br>1. <b>Calcium</b> (membrane stabilization)<br>2. Insulin + glucose, bicarbonate, albuterol (shift K⁺ intracellular)<br>3. Kayexalate, diuretics, dialysis (eliminate K⁺)" },
            { q: "What is the clinical presentation and treatment of <b>methemoglobinemia</b>?", a: "<b>Methemoglobinemia:</b><br>• Fe²⁺ (ferrous) oxidized to Fe³⁺ (ferric) → cannot bind O₂<br><br><b>Causes:</b> Dapsone, benzocaine/lidocaine (topical anesthetics), nitrites, aniline dyes, nitric oxide<br><br><b>Features:</b><br>• <b>Cyanosis unresponsive to O₂</b><br>• <b>\"Chocolate brown\" blood</b> that does not turn red with O₂ exposure<br>• Pulse ox reads ~85% (falsely low if mild, falsely high if severe)<br>• MetHb &gt;20%: headache, dyspnea; &gt;50%: seizures, coma; &gt;70%: lethal<br><br><b>Treatment: Methylene blue 1–2 mg/kg IV</b> over 5 min<br>Contraindicated in <b>G6PD deficiency</b> (use ascorbic acid instead)." },
            { q: "What is the <b>toxic dose</b> and presentation of <u>theophylline toxicity</u>?", a: "<b>Theophylline toxicity:</b><br><br><b>Levels:</b><br>• Therapeutic: 10–20 µg/mL<br>• Toxic: &gt;20 µg/mL<br>• Severe/life-threatening: &gt;80–100 µg/mL (acute) or &gt;40–60 µg/mL (chronic)<br><br><b>Features:</b><br>• <b>GI:</b> Severe vomiting (protracted)<br>• <b>Cardiac:</b> Tachyarrhythmias (SVT, multifocal AT, VT)<br>• <b>Neuro:</b> Seizures (often refractory, may be first sign in chronic OD)<br>• <b>Metabolic:</b> Hypokalemia, hyperglycemia, metabolic acidosis<br><br><b>Treatment:</b> MDAC, hemodialysis (level &gt;90 acute, &gt;40 chronic with symptoms)." },
            { q: "What is the treatment for <b>isoniazid (INH) overdose</b>?", a: "<b>INH toxicity:</b><br><br><b>Mechanism:</b> Depletes <b>pyridoxine (vitamin B₆)</b> → decreased GABA synthesis → seizures<br><br><b>Classic triad:</b><br>1. <b>Refractory seizures</b><br>2. <b>Metabolic acidosis</b> (AGMA from lactic acidosis)<br>3. <b>Coma</b><br><br><b>Treatment:</b><br>• <b>Pyridoxine (vitamin B₆)</b> — <b>gram-for-gram</b> of INH ingested (1 g B₆ per 1 g INH)<br>• If unknown ingestion amount: give <b>5 g IV empirically</b><br>• Benzodiazepines for seizure control (adjunct)<br>• <b>Phenytoin is INEFFECTIVE</b> for INH seizures" },
            { q: "What is the antidote for <b>ethylene glycol</b> toxicity and what adjunct vitamins are given?", a: "<b>Ethylene glycol treatment:</b><br><br><b>Antidote:</b> <b>Fomepizole</b> (preferred) or ethanol — ADH inhibitors<br><br><b>Adjunct vitamins:</b><br>1. <b>Thiamine (B₁)</b> — cofactor for conversion of glyoxylic acid → non-toxic metabolite (α-hydroxy-β-ketoadipate)<br>2. <b>Pyridoxine (B₆)</b> — cofactor for conversion of glyoxylic acid → glycine (non-toxic)<br><br>These divert metabolism away from oxalic acid formation.<br><br><b>Hemodialysis</b> for severe cases (level &gt;50 mg/dL, severe acidosis, renal failure, visual symptoms)." },
            { q: "What is <b>serotonin syndrome</b> treatment?", a: "<b>Serotonin syndrome management:</b><br><br>1. <b>Discontinue all serotonergic agents</b><br>2. <b>Supportive care:</b> IV fluids, cooling measures<br>3. <b>Benzodiazepines</b> — for agitation, seizures, muscle rigidity<br>4. <b>Cyproheptadine</b> — serotonin antagonist (5-HT₂A)<br>&nbsp;&nbsp;• 12 mg PO initial dose, then 2 mg q2h until improvement<br>&nbsp;&nbsp;• Only available PO/NG (no IV form)<br>5. Severe: intubation, paralysis (prevent hyperthermia from muscular rigidity)<br><br><b>Avoid:</b> antipyretics (ineffective — hyperthermia is from muscle activity, not hypothalamic)." },
            { q: "What drugs commonly cause <b>serotonin syndrome</b> when combined?", a: "<b>High-risk serotonergic combinations:</b><br><br>• <b>MAOIs + SSRIs/SNRIs</b> — most dangerous combination<br>• <b>MAOIs + meperidine</b> (classic lethal combination)<br>• <b>SSRIs + tramadol</b><br>• <b>SSRIs + triptans</b><br>• <b>SSRIs + linezolid</b> (weak MAOI)<br>• <b>SSRIs + St. John's wort</b><br>• <b>SSRIs + dextromethorphan</b><br><br>Single agents at high doses: SSRIs, venlafaxine, MAOIs<br><br><b>Washout period needed:</b><br>• MAOIs: 14 days before starting serotonergic agent<br>• Fluoxetine: 5 weeks (long half-life) before MAOI" },
            { q: "What is the management of <b>hydrofluoric acid (HF) burns</b>?", a: "<b>Hydrofluoric acid:</b><br><br><b>Mechanism:</b> Fluoride ion binds Ca²⁺ and Mg²⁺ → tissue necrosis + <b>systemic hypocalcemia/hypomagnesemia</b> → fatal arrhythmias<br><br><b>Local treatment:</b><br>• <b>Topical calcium gluconate gel (2.5%)</b> — apply liberally<br>• If refractory: <b>intradermal/subcutaneous calcium gluconate injection</b><br>• Intra-arterial calcium gluconate for digital exposure<br><br><b>Systemic treatment:</b><br>• IV calcium replacement for hypocalcemia<br>• Cardiac monitoring (QT prolongation, arrhythmias)<br>• <b>Burns &gt;2.5% BSA with concentrated HF → potentially fatal</b>" },
            { q: "What is the emergency treatment for <b>beta-blocker-induced bradycardia and hypotension</b>?", a: "<b>Stepwise management:</b><br><br>1. <b>Atropine</b> 0.5–1 mg IV (often ineffective in severe OD)<br>2. <b>Glucagon</b> 3–5 mg IV bolus → infusion 2–5 mg/hr<br>3. <b>High-dose insulin (HIET)</b> — 1 unit/kg bolus + 0.5–1 unit/kg/hr<br>4. <b>Vasopressors:</b> norepinephrine, epinephrine (high doses may be needed)<br>5. <b>Calcium chloride/gluconate</b><br>6. <b>Intralipid emulsion</b> — especially for lipophilic BBs (propranolol)<br>7. <b>Transvenous pacing</b><br>8. <b>ECMO / VA-ECLS</b> as bridge therapy in refractory cases" },
            { q: "What is the <b>approach to the unknown overdose patient</b> in the ED?", a: "<b>Systematic approach:</b><br><br><b>1. ABCs + stabilize</b><br>• Intubate if GCS ≤8 or loss of protective reflexes<br><br><b>2. \"Coma cocktail\" (empiric):</b><br>• <b>Dextrose</b> (D50 or check glucose first)<br>• <b>Naloxone</b> (if opioid suspected)<br>• <b>Thiamine</b> (before glucose in suspected alcoholism)<br>• Flumazenil — only if KNOWN pure benzo OD<br><br><b>3. Identify toxidrome</b> (vital signs + pupils + skin + mental status)<br><br><b>4. Labs:</b> BMP, hepatic panel, APAP level, salicylate level, EtOH, UDS, ECG, osmol gap, VBG/ABG<br><br><b>5. Decontamination</b> (charcoal if appropriate)<br><br><b>6. Specific antidotes</b> as indicated" },
            { q: "What lab tests should be ordered on <b>every intentional overdose patient</b>?", a: "<b>Standard overdose workup:</b><br><br>1. <b>Acetaminophen level</b> — #1 cause of acute liver failure, often co-ingested<br>2. <b>Salicylate level</b> — mixed acid-base disorder<br>3. <b>Ethanol level</b><br>4. <b>BMP/CMP</b> — electrolytes, glucose, renal function, anion gap<br>5. <b>Hepatic panel</b> — AST/ALT, bilirubin<br>6. <b>ECG</b> — QRS, QTc, arrhythmias<br>7. <b>VBG or ABG</b> — acid-base status<br>8. <b>Urine drug screen</b> (limited utility — many false positives/negatives)<br>9. <b>Osmol gap</b> (if toxic alcohol suspected)<br>10. <b>Pregnancy test</b> (all women of childbearing age)<br>11. <b>Serum lactate</b>" },
            { q: "What is <b>lipid emulsion therapy</b> primarily used for in toxicology?", a: "<b>Primary indication: Local Anesthetic Systemic Toxicity (LAST)</b><br><br>• Strongest evidence base<br>• Bupivacaine is the most cardiotoxic local anesthetic<br>• LAST presents with: perioral numbness → seizures → cardiovascular collapse<br><br><b>Other potential uses (rescue therapy):</b><br>• TCA overdose (refractory)<br>• CCB/BB overdose (refractory)<br>• Lipophilic drug toxicity<br><br><b>Key principle:</b> the more <b>lipophilic</b> the drug, the more likely lipid emulsion will be effective (creates \"lipid sink\")." },
            { q: "What is the significance of a <b>QTc prolongation</b> in toxicology?", a: "<b>Prolonged QTc (&gt;500 ms)</b> → risk of <b>Torsades de Pointes (TdP)</b><br><br><b>Common QT-prolonging toxins:</b><br>• <b>Antipsychotics</b> (haloperidol, droperidol, ziprasidone)<br>• <b>Antiarrhythmics</b> (sotalol, amiodarone, procainamide)<br>• <b>Antibiotics</b> (fluoroquinolones, macrolides)<br>• <b>Antiemetics</b> (ondansetron at high doses)<br>• <b>Methadone</b><br>• <b>TCAs</b><br><br><b>Treatment of TdP:</b><br>• <b>IV magnesium sulfate</b> 2 g IV (first-line)<br>• <b>Overdrive pacing</b> (increase HR to shorten QT)<br>• <b>Isoproterenol</b> (temporizing measure)" },
            { q: "What is <b>physostigmine</b> and when is it used?", a: "<b>Physostigmine</b> — reversible acetylcholinesterase inhibitor (crosses BBB):<br><br><b>Indication:</b> <b>Pure anticholinergic toxicity</b> with significant delirium/agitation<br><br><b>Dose:</b> 0.5–2 mg IV slowly over 5 min; may repeat q10–30 min<br><br><b>Contraindications:</b><br>• <b>TCA ingestion</b> (risk of asystole, seizures)<br>• <b>Conduction delays</b> on ECG (QRS &gt;100 ms, AV block)<br>• Asthma/COPD<br>• GI/GU obstruction<br>• Peripheral neuropathy<br><br><b>Must have atropine at bedside</b> (to reverse cholinergic crisis if excessive)." },
            { q: "What is the <b>toxicity profile of valproic acid</b> and its management?", a: "<b>Valproic acid toxicity:</b><br><br><b>Features:</b><br>• CNS depression → coma<br>• <b>Hepatotoxicity</b> (idiosyncratic or dose-related)<br>• <b>Hyperammonemia</b> (even at therapeutic levels) → encephalopathy<br>• Pancreatitis<br>• Bone marrow suppression (thrombocytopenia)<br>• Metabolic acidosis<br>• Cerebral edema<br><br><b>Treatment:</b><br>• <b>L-carnitine</b> — for hyperammonemia/hepatotoxicity (100 mg/kg IV, max 6 g)<br>• <b>Hemodialysis</b> for severe cases (level &gt;850–1000 µg/mL, hemodynamic instability)<br>• Activated charcoal if early<br>• Naloxone may partially reverse CNS depression (debated)" },
            { q: "What is the toxic dose of <b>iron</b> and which iron preparations are most dangerous?", a: "<b>Iron toxic doses:</b><br><br>• <b>&lt;20 mg/kg</b> elemental iron: non-toxic<br>• <b>20–60 mg/kg</b>: mild-moderate GI toxicity<br>• <b>&gt;60 mg/kg</b>: severe, potentially lethal<br><br><b>Elemental iron content by preparation:</b><br>• Ferrous sulfate (325 mg) = <b>65 mg</b> (20%) elemental iron<br>• Ferrous gluconate (325 mg) = <b>39 mg</b> (12%) elemental iron<br>• Ferrous fumarate (325 mg) = <b>106 mg</b> (33%) elemental iron — <b>most dangerous per tablet</b><br><br><b>Key:</b> Calculate total <b>elemental</b> iron ingested, not total salt weight." },
            { q: "What is the <b>management of calcium channel blocker overdose</b> (systematic approach)?", a: "<b>CCB overdose management (stepwise):</b><br><br>1. <b>IV fluids</b> (isotonic crystalloid bolus)<br>2. <b>IV calcium</b> — calcium chloride (central) or calcium gluconate (peripheral)<br>3. <b>High-dose insulin (HIET)</b> — 1 unit/kg bolus + infusion (increasingly first-line)<br>4. <b>Vasopressors</b> (norepinephrine, epinephrine)<br>5. <b>Atropine</b> (for symptomatic bradycardia — often insufficient)<br>6. <b>Glucagon</b> (3–5 mg IV — less effective for CCBs than BBs)<br>7. <b>Intralipid emulsion</b> (rescue therapy)<br>8. <b>Transvenous pacing</b> (capture may be difficult)<br>9. <b>ECMO</b> (bridge to recovery in refractory cases)<br>10. <b>Methylene blue</b> (for vasoplegia — emerging evidence)" },
            { q: "What is the <b>serum drug level</b> approach to acetaminophen when time of ingestion is unknown?", a: "<b>Unknown time of APAP ingestion:</b><br><br>• <b>Rumack-Matthew nomogram cannot be used</b> (requires known time)<br>• Draw <b>APAP level immediately</b> + <b>AST/ALT</b><br><br><b>Treat with NAC if:</b><br>1. <b>Any detectable APAP level</b> + elevated AST/ALT<br>2. <b>AST/ALT elevated</b> with history of APAP ingestion (even if level undetectable — may have already been metabolized)<br>3. <b>APAP level &gt;10 µg/mL</b> (some sources use any detectable level)<br><br><b>Serial levels</b> and LFTs guide ongoing treatment." },
            { q: "What is <b>N-acetylcysteine (NAC)</b> and how does it protect against APAP toxicity?", a: "<b>NAC mechanisms of hepatoprotection:</b><br><br>1. <b>Replenishes glutathione stores</b> — GSH directly conjugates and detoxifies NAPQI<br>2. Acts as <b>glutathione substitute</b> — directly binds NAPQI<br>3. <b>Enhances sulfate conjugation</b> of APAP (non-toxic pathway)<br>4. <b>Anti-inflammatory and antioxidant</b> effects<br>5. Improves <b>microcirculatory blood flow</b> to the liver<br><br><b>Most effective within 8 hours</b> of ingestion but beneficial even at 24+ hours (reduces mortality in established hepatic failure)." },
            { q: "What is the treatment for <b>NMS (Neuroleptic Malignant Syndrome)</b>?", a: "<b>NMS management:</b><br><br>1. <b>Discontinue offending agent</b> (antipsychotic) — most important step<br>2. <b>Aggressive cooling</b> (evaporative, ice packs, cold IV fluids)<br>3. <b>IV fluids</b> (aggressive hydration for rhabdomyolysis prevention)<br>4. <b>Dantrolene</b> — direct-acting muscle relaxant (inhibits ryanodine receptor → ↓ Ca²⁺ release from SR)<br>&nbsp;&nbsp;• 1–2.5 mg/kg IV q5–10 min (max 10 mg/kg/day)<br>5. <b>Bromocriptine</b> — dopamine agonist (2.5 mg PO/NG q8h)<br>6. <b>Benzodiazepines</b> — for agitation, rigidity<br>7. Monitor and treat <b>hyperkalemia, rhabdomyolysis, AKI, DIC</b>" },
            { q: "What is the <b>role of sodium bicarbonate</b> in various poisonings?", a: "<b>Sodium bicarbonate uses in toxicology:</b><br><br>1. <b>TCA overdose</b> — overcomes Na⁺ channel blockade (QRS widening)<br>2. <b>Salicylate poisoning</b> — urinary alkalinization (trap salicylate in urine)<br>3. <b>Phenobarbital</b> — urinary alkalinization<br>4. <b>Chlorpropamide</b> — urinary alkalinization<br>5. <b>Cocaine-induced wide QRS</b> — Na⁺ channel blockade<br>6. <b>Class Ia/Ic antiarrhythmic OD</b> (flecainide, procainamide)<br><br><b>Mechanism:</b> ↑ extracellular Na⁺ (overcomes channel block), alkalemia (↑ protein binding of drug, ↑ ionized form in urine)." },
            { q: "What is the <b>toxic dose of salicylates</b> and what symptoms occur at different levels?", a: "<b>Salicylate toxicity levels:</b><br><br>• Therapeutic: <b>15–30 mg/dL</b><br>• Toxic: <b>&gt;40 mg/dL</b> (acute)<br>• Severe: <b>&gt;90–100 mg/dL</b> (acute) — consider hemodialysis<br>• Chronic toxicity occurs at <b>lower levels</b> (&gt;30 mg/dL)<br><br><b>Acute toxic dose: &gt;150 mg/kg</b><br><br><b>Level-symptom correlation (acute):</b><br>• 40–60: tinnitus, nausea, vomiting<br>• 60–90: hyperventilation, agitation, diaphoresis<br>• &gt;90–100: seizures, coma, pulmonary edema, death<br><br><i>Clinical status matters more than level, especially in chronic toxicity.</i>" },
            { q: "What is <b>acetylcholinesterase</b> testing and its role in organophosphate poisoning diagnosis?", a: "<b>Cholinesterase levels:</b><br><br>1. <b>RBC (true) cholinesterase</b> — reflects <b>synaptic AChE</b> activity<br>&nbsp;&nbsp;• More accurate for confirming OP exposure<br>&nbsp;&nbsp;• Slow to recover (weeks)<br><br>2. <b>Plasma (pseudo/butyryl) cholinesterase</b><br>&nbsp;&nbsp;• Faster to obtain, more widely available<br>&nbsp;&nbsp;• Depressed earlier; recovers faster (days-weeks)<br>&nbsp;&nbsp;• Less specific (also low in liver disease, pregnancy, malnutrition)<br><br><b>Diagnosis is primarily clinical</b> — do NOT delay treatment for lab confirmation.<br>Both levels will be <b>depressed</b> in OP poisoning." },
            { q: "What medications can cause a <b>falsely elevated osmol gap</b> (mimicking toxic alcohols)?", a: "<b>Non-toxic causes of elevated osmol gap:</b><br><br>1. <b>Propylene glycol</b> (solvent in IV lorazepam, phenytoin)<br>2. <b>Mannitol</b> (IV osmotic diuretic)<br>3. <b>Ethanol</b> (if not included in calculation)<br>4. <b>Sorbitol</b><br>5. <b>Glycerol</b><br>6. <b>Contrast media</b><br>7. <b>Chronic kidney disease</b><br>8. <b>Diabetic ketoacidosis</b> (acetone contributes)<br>9. <b>Lactic acidosis</b><br><br><b>Key point:</b> An elevated osmol gap (&gt;10) is suggestive but NOT diagnostic of toxic alcohols. Must correlate with clinical picture." },
            { q: "What is the <b>approach to the seizing patient</b> in the context of toxicology?", a: "<b>Toxin-induced seizures:</b><br><br><b>First-line: Benzodiazepines</b> (lorazepam, diazepam, midazolam)<br><br><b>Common seizure-causing toxins (mnemonic: OTIS CAMPBELL):</b><br>• Organophosphates<br>• TCAs / Theophylline<br>• INH (isoniazid), Insulin (hypoglycemia)<br>• Sympathomimetics (cocaine, amphetamines)<br>• Camphor, CO<br>• Anticholinergics, Antipsychotics<br>• Methylxanthines<br>• PCP, Propoxyphene, Phenol<br>• BZD withdrawal, Botanicals<br>• EtOH withdrawal, Ethylene glycol<br>• Lithium, Lidocaine, Lead<br>• Lindane<br><br><b>Specific antidotes:</b> Pyridoxine for INH, dextrose for insulin." },
            { q: "What is <b>whole bowel irrigation (WBI)</b> and how is it administered?", a: "<b>WBI — mechanical GI decontamination:</b><br><br><b>Solution:</b> Polyethylene glycol electrolyte solution (GoLYTELY/CoLyte)<br><br><b>Rate:</b><br>• Adults: <b>1.5–2 L/hr</b> (PO or via NG tube)<br>• Children 6–12 y: 1 L/hr<br>• Children &lt;6 y: 500 mL/hr<br><br><b>Endpoint:</b> Clear rectal effluent<br><br><b>Contraindications:</b><br>• Bowel obstruction/ileus/perforation<br>• Unprotected airway<br>• GI hemorrhage<br>• Hemodynamic instability<br>• Intractable vomiting<br><br><b>Pre-treat with ondansetron</b> to reduce vomiting." },
            { q: "What is the <b>cherry-red skin</b> finding and which poisonings cause it?", a: "<b>Cherry-red coloration in poisoning:</b><br><br>1. <b>Carbon monoxide</b> — COHb causes cherry-red skin (late finding, often post-mortem)<br>2. <b>Cyanide</b> — cherry-red venous blood (cells can't use O₂)<br>3. <b>Hydrogen sulfide</b> — similar appearance<br><br><b>Important caveats:</b><br>• Cherry-red skin is a <b>late and unreliable</b> clinical sign<br>• Often only seen <b>post-mortem</b><br>• <b>Do NOT rely on it</b> for diagnosis<br>• Use <b>co-oximetry</b> for CO and clinical picture + lactate for cyanide" },
            { q: "What are the <b>antidotes</b> that every emergency physician should know? (High-yield list)", a: "<table><tr><th>Toxin</th><th>Antidote</th></tr><tr><td>Acetaminophen</td><td><b>N-acetylcysteine (NAC)</b></td></tr><tr><td>Opioids</td><td><b>Naloxone</b></td></tr><tr><td>Benzodiazepines</td><td><b>Flumazenil</b> (limited use)</td></tr><tr><td>TCAs (wide QRS)</td><td><b>Sodium bicarbonate</b></td></tr><tr><td>Organophosphates</td><td><b>Atropine + pralidoxime (2-PAM)</b></td></tr><tr><td>Methanol / ethylene glycol</td><td><b>Fomepizole</b></td></tr><tr><td>Iron</td><td><b>Deferoxamine</b></td></tr><tr><td>Digoxin</td><td><b>DigiFab</b></td></tr><tr><td>Cyanide</td><td><b>Hydroxocobalamin</b></td></tr><tr><td>β-blockers</td><td><b>Glucagon, HIET</b></td></tr><tr><td>CCBs</td><td><b>Calcium, HIET</b></td></tr><tr><td>INH</td><td><b>Pyridoxine (B₆)</b></td></tr><tr><td>Warfarin</td><td><b>Vitamin K, FFP, PCC</b></td></tr><tr><td>Heparin</td><td><b>Protamine</b></td></tr><tr><td>Lead</td><td><b>Succimer, CaNa₂EDTA + BAL</b></td></tr><tr><td>MetHb</td><td><b>Methylene blue</b></td></tr></table>" },
            { q: "What is the <b>significance of the terminal R wave in aVR</b> in toxicology?", a: "<b>Terminal R wave in aVR &gt;3 mm:</b><br><br>• <b>Most sensitive and specific ECG marker</b> for TCA poisoning<br>• Represents <b>rightward deviation of the terminal QRS vector</b><br>• Caused by <b>delayed depolarization</b> of the right ventricle (Na⁺ channel blockade slows His-Purkinje conduction preferentially on the right)<br><br><b>Prognostic value:</b><br>• R in aVR &gt;3 mm → <b>increased risk of seizures and arrhythmias</b><br>• R/S ratio in aVR &gt;0.7 also predictive<br><br><b>Other causes:</b> right ventricular hypertrophy, right bundle branch block, Class Ic antiarrhythmics." },
            { q: "What is <b>Drug-induced prolonged QT interval</b> and the risk of Torsades de Pointes?", a: "<b>Risk factors for drug-induced TdP:</b><br><br>1. <b>QTc &gt;500 ms</b> (highest risk)<br>2. Female sex (longer baseline QT)<br>3. <b>Hypokalemia</b> (most important modifiable risk factor)<br>4. Hypomagnesemia<br>5. Bradycardia<br>6. Structural heart disease<br>7. Recent cardioversion<br>8. Multiple QT-prolonging drugs<br>9. Hepatic/renal impairment (reduced drug clearance)<br><br><b>Prevention:</b> Monitor QTc, correct electrolytes, avoid drug interactions.<br><b>Treatment of TdP: IV magnesium 2 g</b> → overdrive pacing." },
            { q: "How does <b>chronic lithium toxicity</b> differ from <b>acute lithium toxicity</b>?", a: "<b>Key differences:</b><br><br><table><tr><th>Feature</th><th>Acute Ingestion</th><th>Chronic Toxicity</th></tr><tr><td><b>GI symptoms</b></td><td>Prominent (nausea, vomiting, diarrhea)</td><td>Less prominent</td></tr><tr><td><b>Neuro symptoms</b></td><td>Delayed (Li⁺ distributes slowly into CNS)</td><td><b>Early and severe</b> (CNS already saturated)</td></tr><tr><td><b>Serum levels</b></td><td>May be very high (&gt;4) but clinical toxicity may lag</td><td><b>Severe toxicity at lower levels</b> (2–3.5 mEq/L)</td></tr><tr><td><b>Prognosis</b></td><td>Generally better (tissue distribution takes time)</td><td>Worse — neurological damage may be irreversible</td></tr><tr><td><b>HD threshold</b></td><td>&gt;4 mEq/L</td><td>&gt;2.5 mEq/L with symptoms</td></tr></table><br><b>Chronic toxicity is often precipitated by:</b> dehydration, NSAIDs, ACE inhibitors, diuretics, renal impairment." },
            { q: "What are the <b>radiographic findings</b> that can help in toxicological emergencies?", a: "<b>Radiopaque substances on abdominal X-ray (mnemonic: CHIPS):</b><br><br><b>C</b> — Chloral hydrate, Calcium carbonate<br><b>H</b> — Heavy metals (lead, arsenic, mercury)<br><b>I</b> — Iron<br><b>P</b> — Phenothiazines, Play-Doh, Potassium<br><b>S</b> — Sustained-release/enteric-coated tablets<br><br><b>Chest X-ray findings:</b><br>• Pulmonary edema: salicylates, opioids, organophosphates<br>• Pneumomediastinum: caustic perforation, crack cocaine<br>• ARDS: deferoxamine (prolonged use), paraquat<br><br><b>CT head:</b> Basal ganglia necrosis in CO or methanol poisoning." },
            { q: "What is the management of <b>cocaine toxicity</b>?", a: "<b>Cocaine toxicity management:</b><br><br><b>Sympathomimetic crisis:</b><br>• <b>Benzodiazepines</b> — first-line for agitation, seizures, hypertension, tachycardia, chest pain<br>• <b>Cooling measures</b> for hyperthermia<br><br><b>Cardiac:</b><br>• <b>Chest pain / STEMI:</b> benzodiazepines, nitroglycerin, aspirin, PCI<br>• <b>Wide QRS:</b> sodium bicarbonate (Na⁺ channel blockade)<br>• <b>AVOID β-blockers</b> — unopposed α-stimulation → worsened hypertension, coronary vasoconstriction<br>• Phentolamine (α-blocker) if refractory HTN<br><br><b>Seizures:</b> benzodiazepines (avoid phenytoin)" },
            { q: "Why are <b>beta-blockers contraindicated</b> in cocaine toxicity?", a: "<b>Cocaine + β-blockers → \"unopposed alpha stimulation\":</b><br><br>• Cocaine stimulates both <b>α and β adrenergic receptors</b><br>• β₂ receptors cause <b>vasodilation</b> (partially counterbalances α₁ vasoconstriction)<br>• Blocking β₂ → removes vasodilatory effect → <b>pure α₁ vasoconstriction</b><br>• Results in: <b>severe hypertension, coronary vasoconstriction, paradoxical bradycardia</b><br><br><b>Use instead:</b><br>• Benzodiazepines (first-line)<br>• Phentolamine (α-blocker)<br>• Nitroglycerin/nitroprusside<br>• <b>Labetalol</b> (mixed α/β) — controversial, some experts permit cautious use" },
            { q: "What are the phases of <b>salicylate toxicity</b> from a metabolic standpoint?", a: "<b>Metabolic phases of salicylate toxicity:</b><br><br><b>Phase 1 (early, hours):</b><br>• Direct stimulation of respiratory center → <b>respiratory alkalosis</b> (hyperventilation)<br>• Alkalemia predominates<br><br><b>Phase 2 (12–24 h):</b><br>• Mixed: respiratory alkalosis + developing <b>AGMA</b><br>• Paradoxical aciduria (kidneys excrete HCO₃⁻ to compensate for respiratory alkalosis)<br><br><b>Phase 3 (late, &gt;24 h):</b><br>• <b>AGMA predominates</b> (salicylic acid, lactic acid, ketoacids)<br>• Dehydration, hypokalemia<br>• Cerebral edema, pulmonary edema<br><br><i>Young children may skip phase 1 and present directly with AGMA.</i>" },
            { q: "What urine finding is <b>pathognomonic</b> for ethylene glycol poisoning?", a: "<b>Calcium oxalate crystals</b> in the urine:<br><br>• <b>Envelope-shaped (monohydrate: needle-shaped)</b> crystals<br>• Formed when oxalic acid (EG metabolite) binds calcium<br>• <b>Pathognomonic</b> for ethylene glycol poisoning (when seen with appropriate clinical context)<br><br><b>Additional urine finding:</b><br>• Urine may fluoresce under <b>Wood's lamp</b> (UV light) due to <b>fluorescein</b> additive in some antifreeze products<br>• Sensitivity is <b>limited</b> and absence does NOT rule out EG ingestion<br><br><b>Also check:</b> BMP (Ca²⁺ may be low), osmol gap, anion gap." },
            { q: "How does <b>digoxin toxicity</b> differ in acute vs. chronic poisoning?", a: "<table><tr><th>Feature</th><th>Acute Toxicity</th><th>Chronic Toxicity</th></tr><tr><td><b>Potassium</b></td><td><b>Hyperkalemia</b> (Na⁺/K⁺ ATPase inhibition)</td><td><b>Hypokalemia</b> (from diuretics) → precipitates toxicity</td></tr><tr><td><b>GI symptoms</b></td><td>Prominent (nausea, vomiting)</td><td>Variable</td></tr><tr><td><b>Digoxin level</b></td><td>Very high</td><td>May be near therapeutic range</td></tr><tr><td><b>Precipitants</b></td><td>Intentional/accidental ingestion</td><td>Renal failure, dehydration, drug interactions, hypoK⁺, hypoCa²⁺, hypoMg²⁺</td></tr><tr><td><b>Arrhythmia</b></td><td>Bradycardia, AV block common</td><td>Atrial tachycardia with block, bidirectional VT</td></tr><tr><td><b>DigiFab dose</b></td><td>Based on amount ingested</td><td>Based on steady-state level</td></tr></table>" },
            { q: "What is <b>ECMO</b> and when is it considered in toxicology?", a: "<b>Extracorporeal Membrane Oxygenation (ECMO)</b> / VA-ECLS:<br><br><b>Indication in toxicology:</b><br>• <b>Refractory cardiogenic shock / cardiac arrest</b> from drug toxicity unresponsive to all pharmacologic measures<br>• Bridge to drug clearance / recovery<br><br><b>Most studied for:</b><br>• <b>CCB overdose</b> (especially verapamil)<br>• <b>BB overdose</b><br>• <b>TCA overdose</b><br>• <b>Flecainide / Class I antiarrhythmic OD</b><br>• <b>Local anesthetic toxicity</b><br><br><b>Key concept:</b> Most drug toxicity is <b>time-limited</b> — if you can maintain perfusion, the patient will likely survive. ECMO buys time." },
            { q: "What are the key features of <b>gamma-hydroxybutyrate (GHB)</b> toxicity?", a: "<b>GHB toxicity:</b><br><br><b>Features:</b><br>• Rapid onset CNS depression (dose-dependent)<br>• <b>Profound coma</b> with abrupt onset<br>• <b>Respiratory depression</b><br>• <b>Bradycardia</b><br>• Hypothermia<br>• Myoclonus<br>• <b>Rapid, complete recovery</b> (typically within 2–6 hours) — \"in and out like a light\"<br><br><b>Management:</b> Supportive care, protect airway<br>• No specific antidote<br>• <b>NOT detected on standard UDS</b><br><br><b>Withdrawal:</b> Can cause severe, life-threatening withdrawal (similar to alcohol/BZD withdrawal) — tachycardia, delirium, seizures." },
            { q: "What is the <b>Wood's lamp</b> urine test in suspected ethylene glycol ingestion?", a: "<b>Wood's lamp (UV light) urine fluorescence:</b><br><br>• Some antifreeze products contain <b>fluorescein dye</b> as a leak-detection additive<br>• Urine may fluoresce <b>blue-green</b> under Wood's lamp<br><br><b>Limitations:</b><br>• <b>Low sensitivity</b> — not all antifreeze contains fluorescein<br>• <b>False positives</b> — other substances fluoresce (urine concentrates, IV contrast, vitamins)<br>• <b>Should NOT be used to rule out</b> ethylene glycol ingestion<br>• <b>Not a reliable screening tool</b><br><br>Rely instead on: osmol gap, anion gap, calcium oxalate crystals, EG level." },
            { q: "In what clinical scenario should you suspect <b>body packing (drug mule)</b> and how is it managed?", a: "<b>Body packing / stuffing:</b><br><br><b>Suspect when:</b><br>• Recent international travel + acute toxicity or drug smuggling concern<br>• Abdominal distension, obstruction symptoms<br>• Drug packets visible on <b>abdominal CT</b> (superior to plain X-ray)<br><br><b>Body PACKER</b> (swallowed, better wrapped): <b>whole bowel irrigation</b><br><b>Body STUFFER</b> (hastily swallowed to avoid arrest, poorly wrapped): higher rupture risk<br><br><b>Management:</b><br>• <b>WBI</b> until packets pass in stool<br>• Monitor for packet rupture (acute toxicity)<br>• <b>Surgery</b> for obstruction, packet rupture, or failure to pass<br>• <b>Cocaine packet rupture</b> → massive toxicity → benzodiazepines, supportive care<br>• <b>Heroin packet rupture</b> → naloxone infusion" },
            { q: "What are the clinical features of <b>arsenic poisoning</b>?", a: "<b>Arsenic poisoning:</b><br><br><b>Acute:</b><br>• Severe <b>\"rice-water\" diarrhea</b> (resembles cholera)<br>• Nausea, vomiting, abdominal pain<br>• <b>Garlic breath</b> odor<br>• Multi-organ failure, QT prolongation<br><br><b>Chronic:</b><br>• <b>Mees' lines</b> (transverse white lines on nails)<br>• <b>Peripheral neuropathy</b> (stocking-glove)<br>• <b>Skin changes:</b> hyperpigmentation, keratoses (\"raindrop\" pattern)<br>• Pancytopenia, basophilic stippling<br>• ↑ Cancer risk (skin, lung, bladder)<br><br><b>Treatment:</b> BAL (dimercaprol) for acute severe; succimer (DMSA) for chronic.<br>Diagnosis: <b>24-hour urine arsenic level</b>." },
            { q: "What are the <b>contraindications to ipecac</b> (syrup of ipecac)?", a: "<b>Ipecac is NO LONGER recommended</b> by AAP or AACT/EAPCCT.<br><br><b>Historical contraindications:</b><br>1. <b>Age &lt;6 months</b><br>2. <b>Caustic ingestion</b> (re-exposure)<br>3. <b>Hydrocarbon ingestion</b> (aspiration risk)<br>4. <b>Sharp objects</b><br>5. <b>Altered mental status</b> or anticipated decline<br>6. <b>Seizure risk</b><br>7. <b>Hemorrhagic diathesis</b><br><br><b>Reasons for abandonment:</b><br>• No evidence of improved outcomes<br>• Delays more effective treatments (AC, WBI)<br>• Protracted vomiting → aspiration risk<br>• May impair charcoal administration" },
            { q: "What is <b>Mees' lines</b> and what toxin exposure do they suggest?", a: "<b>Mees' lines:</b><br><br>• <b>Transverse white bands</b> across the fingernails<br>• Represent disruption of nail matrix protein synthesis<br>• Appear <b>weeks after exposure</b><br><br><b>Classically associated with:</b><br>• <b>Arsenic poisoning</b> (most classic association)<br>• <b>Thallium poisoning</b><br><br>Also seen in: severe systemic illness, chemotherapy, renal failure, CO poisoning.<br><br><i>Compare with:</i><br>• <b>Beau's lines</b> — transverse grooves/depressions (any severe illness)<br>• <b>Muehrcke's lines</b> — paired white bands (hypoalbuminemia)" },
            { q: "What are the <b>unique features of metformin toxicity</b>?", a: "<b>Metformin-associated lactic acidosis (MALA):</b><br><br>• <b>Severe AGMA with elevated lactate</b> (often &gt;15–20 mmol/L)<br>• Mechanism: metformin inhibits <b>Complex I</b> of mitochondrial electron transport chain → impaired oxidative phosphorylation<br>• Risk factors: <b>renal failure</b> (metformin is renally excreted), dehydration, sepsis, contrast dye<br>• High mortality (30–50%)<br><br><b>Treatment:</b><br>• <b>Hemodialysis</b> — effective (small molecule, no protein binding, low Vd)<br>• Bicarbonate infusion for acidosis<br>• Supportive care<br>• Activated charcoal if early ingestion" },
            { q: "What is the <b>management of acute ethanol withdrawal</b> and its complications?", a: "<b>Ethanol withdrawal timeline:</b><br><br>• <b>6–12 h:</b> Tremor, anxiety, insomnia, nausea, tachycardia<br>• <b>12–24 h:</b> <b>Alcoholic hallucinosis</b> (visual/tactile hallucinations with clear sensorium)<br>• <b>24–48 h:</b> <b>Withdrawal seizures</b> (brief, generalized tonic-clonic)<br>• <b>48–96 h:</b> <b>Delirium tremens</b> (confusion, agitation, autonomic instability, hallucinations, hyperthermia) — <b>5–15% mortality if untreated</b><br><br><b>Treatment:</b><br>• <b>Benzodiazepines</b> — first-line (symptom-triggered dosing per CIWA score preferred)<br>• <b>Thiamine</b> (before glucose) — prevent Wernicke encephalopathy<br>• Electrolyte repletion (Mg²⁺, K⁺, PO₄)<br>• Phenobarbital for refractory DTs" },
            { q: "What is the <b>utility and limitations</b> of the <u>urine drug screen (UDS)</u>?", a: "<b>UDS — standard immunoassay panel:</b><br><br>Typically tests for: amphetamines, barbiturates, benzodiazepines, cocaine, opioids, PCP, cannabinoids, methadone<br><br><b>Limitations (critical for EM):</b><br><br><b>False negatives (not detected):</b><br>• <b>Synthetic opioids:</b> fentanyl, tramadol, meperidine, buprenorphine<br>• <b>Designer benzodiazepines:</b> clonazolam<br>• <b>GHB, LSD, ketamine</b><br><br><b>False positives:</b><br>• Amphetamine: pseudoephedrine, bupropion, labetalol, selegiline<br>• PCP: dextromethorphan, ketamine, diphenhydramine<br>• Opioids: poppy seeds, dextromethorphan<br><br><b>UDS rarely changes acute management</b> — treat based on clinical presentation." },
            { q: "What is <b>Wernicke encephalopathy</b> and why must thiamine be given before glucose in alcoholic patients?", a: "<b>Wernicke encephalopathy</b> — classic triad:<br>1. <b>Encephalopathy</b> (confusion, altered sensorium)<br>2. <b>Oculomotor dysfunction</b> (nystagmus, ophthalmoplegia, lateral rectus palsy)<br>3. <b>Ataxia</b> (cerebellar dysfunction)<br><br><b>Thiamine before glucose:</b><br>• Glucose metabolism requires thiamine (B₁) as a cofactor (pyruvate dehydrogenase, α-KGDH)<br>• Giving glucose to a thiamine-depleted patient → <b>consumes remaining thiamine</b> → may <b>precipitate or worsen</b> Wernicke encephalopathy<br>• Give <b>thiamine 100 mg IV first</b> (or simultaneously with glucose)<br><br>If untreated → progresses to <b>Korsakoff syndrome</b> (irreversible confabulation, amnesia)." },
            { q: "What is the significance of a <b>lactate level</b> in the evaluation of poisoned patients?", a: "<b>Elevated lactate in toxicology:</b><br><br><b>Mechanisms:</b><br>1. <b>Cellular hypoxia</b> (CO, cyanide, MetHb) → anaerobic metabolism<br>2. <b>Mitochondrial dysfunction</b> (metformin, cyanide, salicylates, nucleoside analogs)<br>3. <b>Seizures</b> → massive muscle activity → lactic acid<br>4. <b>Shock / hypoperfusion</b> → tissue hypoxia<br>5. <b>Impaired clearance</b> (hepatic failure from APAP)<br><br><b>Key toxicological causes of severely elevated lactate:</b><br>• Cyanide: >8–10 mmol/L highly suggestive<br>• CO poisoning<br>• Metformin<br>• Salicylates<br>• Acetaminophen (late)" },
            { q: "What is <b>mercury poisoning</b> — acute and chronic forms?", a: "<b>Mercury exists in 3 forms:</b><br><br><b>1. Elemental (Hg⁰):</b> Thermometers, dental amalgam<br>• Inhalation → pneumonitis, CNS effects<br>• Liquid ingestion usually benign (poorly absorbed)<br><br><b>2. Inorganic (Hg²⁺):</b> Antiseptics, batteries<br>• GI corrosion → renal tubular necrosis<br><br><b>3. Organic (methyl-Hg):</b> Fish, Minamata disease<br>• <b>CNS toxicity</b> — paresthesias, ataxia, visual field constriction, hearing loss<br>• Teratogenic (fetal brain damage)<br><br><b>Treatment:</b><br>• Inorganic/elemental: <b>succimer (DMSA)</b> or <b>unithiol (DMPS)</b><br>• Organic (methyl-Hg): <b>succimer</b><br>• BAL: for severe inorganic mercury only<br>• Whole bowel irrigation if elemental mercury ingested in large amounts" },
            { q: "What are the <b>stages of ethylene glycol poisoning</b>?", a: "<b>Three stages of ethylene glycol toxicity:</b><br><br><b>Stage 1 (30 min–12 h): \"Inebriation\"</b><br>• CNS depression mimicking ethanol intoxication<br>• Nausea, vomiting<br>• Elevated osmol gap (parent compound)<br><br><b>Stage 2 (12–24 h): \"Cardiopulmonary\"</b><br>• Severe metabolic acidosis (AGMA)<br>• Tachycardia, hypertension → cardiovascular collapse<br>• Pulmonary edema, ARDS<br>• Hypocalcemia → QT prolongation<br><br><b>Stage 3 (24–72 h): \"Renal\"</b><br>• <b>Acute renal failure</b> (calcium oxalate crystal deposition in tubules)<br>• Flank pain, oliguria/anuria<br>• Hematuria<br><br><b>Treatment goal:</b> Block ADH with fomepizole BEFORE metabolism occurs." },
            { q: "What are the <b>key drug interactions</b> that increase digoxin toxicity risk?", a: "<b>Drugs that increase digoxin levels / toxicity:</b><br><br><b>Decreased renal clearance:</b><br>• <b>Amiodarone</b> — ↑ digoxin level by 50–100% (most important!)<br>• <b>Verapamil</b><br>• <b>Quinidine</b><br>• <b>Spironolactone</b><br>• <b>Cyclosporine</b><br>• <b>Erythromycin / clarithromycin</b><br><br><b>Electrolyte derangements that potentiate toxicity:</b><br>• <b>Hypokalemia</b> (K⁺ and digoxin compete for Na⁺/K⁺ ATPase binding)<br>• <b>Hypomagnesemia</b><br>• <b>Hypercalcemia</b><br><br><b>When adding amiodarone:</b> reduce digoxin dose by 50%." },
            { q: "What is the <b>treatment approach for massive propranolol overdose</b> specifically?", a: "<b>Propranolol-specific concerns:</b><br><br>• <b>Most lethal β-blocker</b> in overdose<br>• Additional toxicity: <b>sodium channel blockade</b> (like TCAs) → QRS widening<br>• <b>Lipophilic</b> → large Vd, CNS effects (seizures, coma)<br>• Membrane-stabilizing activity<br><br><b>Treatment approach:</b><br>1. <b>Glucagon</b> (3–5 mg IV bolus → infusion)<br>2. <b>HIET</b> (1 unit/kg bolus)<br>3. <b>Sodium bicarbonate</b> — for QRS widening (sodium channel blockade)<br>4. <b>Vasopressors</b> (high-dose epinephrine/norepinephrine)<br>5. <b>Intralipid emulsion</b> — propranolol is highly lipophilic (ideal candidate)<br>6. <b>ECMO</b> for refractory shock<br>7. <b>Benzodiazepines</b> for seizures" },
            { q: "What is the <b>clinical significance of the osmol gap and anion gap</b> changing over time in toxic alcohol ingestion?", a: "<b>Osmol gap and anion gap evolve inversely over time:</b><br><br><b>Early (before metabolism):</b><br>• <b>↑ Osmol gap</b> (parent alcohol present in serum → unmeasured osmoles)<br>• <b>Normal anion gap</b> (no acid metabolites yet)<br><br><b>Late (after metabolism by ADH):</b><br>• <b>Normal osmol gap</b> (parent alcohol metabolized)<br>• <b>↑ Anion gap</b> (formic acid or oxalic acid produced)<br><br><b>Key implication:</b><br>• A <b>normal osmol gap does NOT exclude</b> toxic alcohol poisoning if the patient presents late — parent compound already metabolized<br>• Simultaneous <b>↑ osmol gap + ↑ anion gap</b> = \"transition period\" — partially metabolized" },
            { q: "What are the key features of <b>mushroom poisoning</b> from <i>Amanita phalloides</i>?", a: "<b><i>Amanita phalloides</i> (\"Death Cap\"):</b><br><br><b>Toxin:</b> Amatoxin (α-amanitin) — inhibits <b>RNA polymerase II</b> → stops protein synthesis<br><br><b>Phases:</b><br>1. <b>Latent period (6–12 h)</b>: Asymptomatic → delayed onset is KEY clue!<br>2. <b>GI phase (6–24 h)</b>: Severe cholera-like watery diarrhea, vomiting, abdominal pain<br>3. <b>Apparent improvement (24–72 h)</b><br>4. <b>Hepatorenal failure (3–5 days)</b>: Fulminant hepatic necrosis, coagulopathy, AKI → death<br><br><b>KEY RULE:</b> GI symptoms <b>&gt;6 h after mushroom ingestion</b> = potentially lethal species until proven otherwise.<br><br><b>Treatment:</b> Silibinin (milk thistle extract), NAC, penicillin G, liver transplant evaluation." },
            { q: "What is the recommended approach to <b>unknown pill identification</b> in the ED?", a: "<b>Pill identification resources:</b><br><br>1. <b>Poison Control Center (1-800-222-1222)</b> — always consult early<br>2. <b>Online databases:</b> Micromedex, DailyMed, Drugs.com pill identifier<br>3. <b>Imprint codes</b> — required by FDA on all solid oral dosage forms → look up using imprint + shape + color<br>4. <b>Abdominal X-ray</b> — radiopaque pills (CHIPS mnemonic)<br>5. <b>Pharmacy records</b> — check prescription history<br>6. <b>Family/friends</b> — bring medication bottles from home<br><br><b>General approach:</b><br>• Focus on clinical toxidrome rather than specific pill ID<br>• Treat empirically based on presentation<br>• <b>Always check APAP and salicylate levels</b> regardless of reported ingestion" },
            { q: "What is the <b>mechanism</b> by which alkalinization of urine works for salicylate and phenobarbital poisoning?", a: "<b>Ion trapping (urinary alkalinization):</b><br><br>• Salicylate and phenobarbital are <b>weak acids</b><br>• In alkaline urine (pH &gt;7.5), weak acids become <b>ionized (deprotonated)</b><br>• Ionized form is <b>charged</b> → <b>cannot cross tubular membrane</b> → trapped in urine<br>• This prevents <b>reabsorption</b> from renal tubules → enhanced excretion<br><br>$$\\\\text{HA} \\\\rightleftharpoons \\\\text{H}^+ + \\\\text{A}^-$$<br><br>Alkaline pH shifts equilibrium → more A⁻ (ionized, trapped).<br><br><b>Requirement:</b> Must correct <b>hypokalemia first</b> — kidneys will reabsorb K⁺ in exchange for H⁺, acidifying urine despite bicarb administration." },
            { q: "What are the <b>critical differences between calcium chloride and calcium gluconate</b> for the treatment of hyperkalemia in digoxin toxicity?", a: "<b>CAUTION: Calcium use in digoxin toxicity is controversial!</b><br><br>• Traditionally, IV calcium was considered <b>contraindicated</b> in digoxin toxicity (\"stone heart\" theory — hypercalcemia potentiates digoxin's effects on cardiac myocytes)<br>• Recent evidence suggests this risk may be <b>overstated</b><br><br><b>Current recommendations:</b><br>• Use <b>DigiFab as first-line</b> for hyperkalemia in digoxin toxicity<br>• If hyperkalemia is <b>life-threatening</b> and DigiFab is delayed → <b>cautious calcium use may be considered</b><br>• Use <b>insulin + glucose</b> and <b>sodium bicarbonate</b> to shift K⁺<br>• <b>Avoid potassium-lowering with Kayexalate</b> in digoxin toxicity — hypokalemia worsens toxicity" },
            { q: "What is the significance of <b>anion gap in DKA vs. toxic alcohol ingestion</b> differential?", a: "<b>Differentiating AGMA causes:</b><br><br><b>DKA:</b><br>• Positive serum <b>ketones</b> (β-hydroxybutyrate)<br>• Hyperglycemia<br>• History of diabetes<br>• Normal osmol gap (usually)<br><br><b>Toxic alcohols:</b><br>• <b>Elevated osmol gap</b> (early — parent compound present)<br>• <b>Elevated anion gap</b> (late — toxic metabolites present)<br>• Specific findings: blindness (methanol), renal failure + Ca oxalate crystals (ethylene glycol)<br>• Negative ketones (usually)<br><br><b>Isopropanol:</b><br>• <b>Positive ketones</b> (acetone) but <b>NO acidosis</b><br>• May mimic DKA but with normal glucose and no acidosis<br><br><b>Key lab:</b> Check <b>serum β-hydroxybutyrate</b> (specific for DKA, not elevated in toxic alcohols)." },
            { q: "What is <b>sodium nitroprusside toxicity</b> and how does it relate to cyanide?", a: "<b>Sodium nitroprusside (SNP)</b> — IV antihypertensive:<br><br>• Contains <b>5 cyanide molecules</b> per molecule of SNP<br>• CN⁻ released during metabolism<br>• Normally: CN⁻ converted to <b>thiocyanate</b> by hepatic rhodanese (using thiosulfate as sulfur donor)<br><br><b>Risk of cyanide toxicity with:</b><br>• <b>Prolonged infusions</b> (&gt;24–48 h)<br>• <b>High doses</b> (&gt;2 µg/kg/min)<br>• <b>Renal failure</b> (thiocyanate accumulation)<br>• <b>Hepatic failure</b> (impaired rhodanese activity)<br><br><b>Monitoring:</b> Thiocyanate levels (&gt;10 mg/dL toxic)<br><b>Prevention:</b> Co-administer <b>sodium thiosulfate</b> with prolonged use<br><b>Treatment of CN⁻ toxicity:</b> Hydroxocobalamin or nitrite/thiosulfate kit" },
            { q: "What is the emergency management of <b>sulfonylurea-induced hypoglycemia</b>?", a: "<b>Sulfonylurea overdose — prolonged hypoglycemia:</b><br><br><b>Key concern:</b> Long duration of action → <b>recurrent hypoglycemia for 24–72+ hours</b><br><br><b>Treatment:</b><br>1. <b>IV dextrose</b> (D50 bolus, then D10 infusion) — mainstay<br>2. <b>Octreotide</b> — somatostatin analog<br>&nbsp;&nbsp;• <b>Inhibits insulin secretion</b> from pancreatic β-cells<br>&nbsp;&nbsp;• 50–100 µg SC/IV q6–12h<br>&nbsp;&nbsp;• <b>Preferred over repeated dextrose boluses</b> (dextrose stimulates further insulin release in sulfonylurea OD → vicious cycle)<br>3. <b>Activated charcoal</b> if early (&lt;1 h)<br><br><b>Admission:</b> All intentional sulfonylurea ingestions require <b>24-hour minimum observation</b> with glucose monitoring." },
            { q: "What is the role of <b>Poison Control Centers</b> in toxicological emergencies?", a: "<b>Poison Control Center (PCC):</b><br><br>• <b>National number: 1-800-222-1222</b> (US)<br>• Available <b>24/7</b>, staffed by pharmacists, nurses, and physicians with toxicology expertise<br><br><b>When to call:</b><br>• <b>Any suspected poisoning</b> — ingestion, exposure, envenomation<br>• Antidote dosing guidance<br>• Disposition decisions (home management vs. ED)<br>• Substance identification<br><br><b>Services:</b><br>• Immediate phone consultation<br>• Medical toxicologist backup<br>• Follow-up calls<br>• Epidemiological surveillance<br><br><b>Key point:</b> Most poisonings can be managed at home with PCC guidance. Only ~15% require ED evaluation." }
          ]
        },
        {
          section: 'Emergency Medicine',
          topic: "Shock types & resuscitation",
          icon: "activity",
          cards: [
            { q: "Define <b>shock</b> in terms of oxygen kinetics.", a: "Shock is a state of <b>inadequate tissue perfusion</b> where oxygen delivery fails to meet oxygen consumption:<br>$$\\\\text{DO}_2 < \\\\text{VO}_2$$<br>This leads to cellular hypoxia, anaerobic metabolism, and end-organ dysfunction." },
            { q: "Write the <b>oxygen delivery equation</b> and define each component.", a: "$$\\\\text{DO}_2 = CO \\\\times CaO_2 \\\\times 10$$<br><b>CO</b> = Cardiac Output (L/min)<br><b>CaO₂</b> = Arterial oxygen content = (1.34 × Hb × SaO₂) + (0.003 × PaO₂)<br>The factor <b>10</b> converts units to mL O₂/min." },
            { q: "What determines <b>cardiac output (CO)</b>?", a: "$$CO = HR \\\\times SV$$<br><b>HR</b> = Heart Rate<br><b>SV</b> = Stroke Volume, which depends on:<br>• <b>Preload</b> (venous return / end-diastolic volume)<br>• <b>Afterload</b> (systemic vascular resistance)<br>• <b>Contractility</b> (intrinsic myocardial force)" },
            { q: "Explain the <b>Frank-Starling mechanism</b> and its relevance to shock.", a: "The Frank-Starling mechanism states that <b>↑ preload → ↑ stroke volume</b> up to an optimal point, due to greater myofilament overlap.<br>Beyond this point, further volume loading causes <b>no increase (or a decrease)</b> in SV.<br>In cardiogenic shock, the curve is <b>flattened and shifted down</b>, meaning the heart cannot augment output with additional preload." },
            { q: "How is <b>Mean Arterial Pressure (MAP)</b> calculated, and what is the minimum target in shock?", a: "$$MAP = DBP + \\\\frac{1}{3}(SBP - DBP)$$<br>Or equivalently: $$MAP = CO \\\\times SVR$$<br>Minimum target in shock resuscitation: <b>MAP ≥ 65 mmHg</b> to maintain organ perfusion." },
            { q: "Why is <b>lactate</b> an important marker in shock? What level indicates severity?", a: "Lactate rises due to <b>anaerobic glycolysis</b> when tissue oxygen delivery is insufficient.<br>• Normal: <b>&lt;2 mmol/L</b><br>• Elevated: <b>2–4 mmol/L</b> — mild tissue hypoperfusion<br>• Severe: <b>&gt;4 mmol/L</b> — associated with significantly increased mortality<br>Lactate clearance guides resuscitation adequacy." },
            { q: "What is <b>base deficit</b> and how is it used in shock?", a: "<b>Base deficit</b> reflects the amount of base (in mmol/L) needed to normalize blood pH.<br>• <b>Mild:</b> −2 to −5<br>• <b>Moderate:</b> −6 to −14<br>• <b>Severe:</b> &lt; −14 (correlates with major hemorrhage & mortality)<br>It is an <b>early surrogate for tissue hypoperfusion</b> and helps estimate blood loss in trauma." },
            { q: "How do you interpret <b>ScvO₂</b> (central venous oxygen saturation)?", a: "<b>ScvO₂</b> measures oxygen saturation in the superior vena cava (via central line):<br>• <b>Normal:</b> 65–75%<br>• <b>&lt;70%:</b> Suggests ↑ extraction → inadequate DO₂ (e.g., cardiogenic, hypovolemic shock)<br>• <b>&gt;80%:</b> Suggests ↓ extraction → mitochondrial dysfunction or shunting (e.g., late sepsis, cyanide toxicity)" },
            { q: "What is <b>SvO₂</b> vs <b>ScvO₂</b>? Which is more commonly used in the ED?", a: "<b>SvO₂</b> = Mixed venous O₂ sat, measured from a <b>pulmonary artery catheter</b> (gold standard).<br><b>ScvO₂</b> = Central venous O₂ sat, measured from a <b>central venous catheter</b> (IJ or subclavian).<br>ScvO₂ is <b>~5% higher</b> than SvO₂. ScvO₂ is more commonly used in the ED as it doesn't require a PA catheter." },
            { q: "List the <b>four main categories</b> of shock.", a: "1. <b>Hypovolemic</b> — ↓ preload (hemorrhage, dehydration)<br>2. <b>Distributive</b> — ↓ SVR (septic, anaphylactic, neurogenic)<br>3. <b>Cardiogenic</b> — pump failure (MI, myocarditis)<br>4. <b>Obstructive</b> — mechanical obstruction to flow (tamponade, tension PTX, PE)" },
            { q: "What are the <b>compensatory mechanisms</b> the body activates in early shock?", a: "1. <b>Sympathetic activation:</b> ↑ HR, ↑ SVR, ↑ contractility<br>2. <b>RAAS activation:</b> Na⁺/H₂O retention → ↑ preload<br>3. <b>ADH release:</b> Free water reabsorption<br>4. <b>Baroreceptor reflexes:</b> Vasoconstriction<br>5. <b>Transcapillary refill:</b> Fluid shifts from interstitium to intravascular space<br>These maintain BP initially, making <b>tachycardia</b> the earliest vital sign change." },
            { q: "What are the <b>two subtypes</b> of hypovolemic shock?", a: "1. <b>Hemorrhagic:</b> Trauma, GI bleed, ruptured AAA, ectopic pregnancy<br>2. <b>Non-hemorrhagic:</b> Dehydration (vomiting, diarrhea), burns (plasma loss), third-spacing (pancreatitis, bowel obstruction)" },
            { q: "Describe <b>Class I hemorrhage</b> (ATLS classification).", a: "<b>Class I Hemorrhage:</b><br>• Blood loss: <b>&lt;750 mL (&lt;15%)</b> of blood volume<br>• HR: <b>&lt;100</b><br>• BP: <b>Normal</b><br>• RR: <b>14–20</b><br>• Urine output: <b>&gt;30 mL/hr</b><br>• Mental status: <b>Slightly anxious</b><br>• Fluid replacement: <b>Crystalloid</b>" },
            { q: "Describe <b>Class II hemorrhage</b> (ATLS classification).", a: "<b>Class II Hemorrhage:</b><br>• Blood loss: <b>750–1500 mL (15–30%)</b><br>• HR: <b>100–120</b><br>• BP: <b>Normal</b> (narrowed pulse pressure)<br>• RR: <b>20–30</b><br>• Urine output: <b>20–30 mL/hr</b><br>• Mental status: <b>Mildly anxious</b><br>• Fluid replacement: <b>Crystalloid</b>" },
            { q: "Describe <b>Class III hemorrhage</b> (ATLS classification).", a: "<b>Class III Hemorrhage:</b><br>• Blood loss: <b>1500–2000 mL (30–40%)</b><br>• HR: <b>120–140</b><br>• BP: <b>Decreased</b><br>• RR: <b>30–40</b><br>• Urine output: <b>5–15 mL/hr</b><br>• Mental status: <b>Anxious, confused</b><br>• Fluid replacement: <b>Crystalloid + blood products</b>" },
            { q: "Describe <b>Class IV hemorrhage</b> (ATLS classification).", a: "<b>Class IV Hemorrhage:</b><br>• Blood loss: <b>&gt;2000 mL (&gt;40%)</b><br>• HR: <b>&gt;140</b><br>• BP: <b>Severely decreased</b><br>• RR: <b>&gt;35</b><br>• Urine output: <b>Negligible</b><br>• Mental status: <b>Confused, lethargic</b><br>• Fluid replacement: <b>Massive transfusion protocol</b><br>• <b>Immediately life-threatening</b>" },
            { q: "At what class of hemorrhage does <b>blood pressure begin to drop</b>?", a: "<b>Class III</b> (30–40% blood loss).<br>Blood pressure is maintained in Classes I and II by compensatory <b>tachycardia and vasoconstriction</b>. Hypotension is a <b>late finding</b> in hemorrhagic shock." },
            { q: "What is the <b>estimated blood volume</b> in an average 70 kg adult?", a: "Approximately <b>5 liters</b> (or ~70 mL/kg).<br>In pediatric patients: <b>80 mL/kg</b>.<br>This is essential for calculating percentage blood loss in hemorrhage classes." },
            { q: "Compare <b>crystalloids vs colloids</b> in shock resuscitation.", a: "<b>Crystalloids</b> (NS, LR): Isotonic, inexpensive, widely available. Only ~25% stays intravascular.<br><b>Colloids</b> (albumin, hetastarch): Larger molecules, better intravascular retention.<br><b>Evidence:</b> SAFE trial showed <b>no mortality benefit</b> of albumin over saline. HES (hydroxyethyl starch) is associated with <b>↑ AKI and mortality</b> in sepsis → generally avoided." },
            { q: "Why is <b>Lactated Ringer's (LR)</b> preferred over <b>Normal Saline (NS)</b>?", a: "Large-volume NS causes <b>hyperchloremic metabolic acidosis</b> (excess Cl⁻ from 154 mEq/L).<br>LR is a <b>balanced crystalloid</b> (Cl⁻ = 109 mEq/L, contains lactate buffer, K⁺, Ca²⁺).<br>The <b>SMART trial</b> showed balanced crystalloids reduced the composite of death, new renal replacement therapy, and persistent renal dysfunction vs NS." },
            { q: "What is the <b>Massive Transfusion Protocol (MTP)</b>?", a: "Activated when massive hemorrhage is anticipated.<br>Ratio: <b>1:1:1</b> — pRBCs : FFP : Platelets<br>Based on the <b>PROPPR trial</b>.<br>Goal: Prevent the <b>lethal triad</b> of hypothermia, acidosis, and coagulopathy.<br>Also give <b>calcium</b> (citrate in blood products chelates Ca²⁺) and consider <b>TXA</b>." },
            { q: "What is <b>permissive hypotension</b> and when is it used?", a: "<b>Permissive hypotension</b> = targeting a <b>lower-than-normal BP</b> (SBP ~80–90 mmHg or MAP ~50 mmHg) in uncontrolled hemorrhage until surgical hemostasis.<br><b>Rationale:</b> Aggressive fluid resuscitation before bleeding is controlled can dislodge clots, dilute clotting factors, and worsen hemorrhage.<br><b>Contraindication:</b> Traumatic brain injury (requires MAP ≥ 80 to maintain cerebral perfusion)." },
            { q: "What is <b>TXA (tranexamic acid)</b> and when should it be given in trauma?", a: "<b>TXA</b> is an antifibrinolytic (lysine analog) that inhibits plasminogen activation → stabilizes clots.<br><b>CRASH-2 trial:</b> Reduced mortality in bleeding trauma patients.<br><b>Dose:</b> 1 g IV over 10 min, then 1 g IV over 8 hours.<br><b>Must be given within 3 hours</b> of injury — gives <b>no benefit (may harm)</b> if given after 3 hours." },
            { q: "What is <b>Damage Control Resuscitation (DCR)</b>?", a: "A strategy combining:<br>1. <b>Permissive hypotension</b> (limit crystalloids)<br>2. <b>Hemostatic resuscitation</b> (1:1:1 MTP, TXA)<br>3. <b>Damage control surgery</b> (abbreviate surgery, pack & close, stabilize in ICU, return for definitive repair)<br>Goal: Prevent/reverse the <b>lethal triad</b> (hypothermia, acidosis, coagulopathy)." },
            { q: "What is the <b>lethal triad</b> in hemorrhagic shock?", a: "1. <b>Hypothermia</b> — impairs clotting enzyme function<br>2. <b>Acidosis</b> — from hypoperfusion, inhibits coagulation cascade<br>3. <b>Coagulopathy</b> — dilutional + consumptive<br>These three create a <b>vicious cycle</b> that is rapidly fatal if not interrupted. Damage control resuscitation specifically targets breaking this triad." },
            { q: "What type of fluid loss occurs in <b>burn shock</b>?", a: "Burns cause <b>massive capillary leak</b> → loss of plasma (protein-rich fluid) into the interstitium.<br>This is <b>non-hemorrhagic hypovolemic shock</b>.<br>Resuscitate with <b>Parkland formula</b>: 4 mL × %TBSA burned × body weight (kg) over 24h (half in first 8h).<br>Use <b>LR</b> as the preferred fluid." },
            { q: "What is <b>third-spacing</b> and name conditions that cause it.", a: "<b>Third-spacing</b> = redistribution of fluid from the intravascular space into a <b>non-functional third compartment</b> (peritoneum, bowel lumen, interstitium).<br>Causes:<br>• Pancreatitis<br>• Bowel obstruction<br>• Peritonitis<br>• Post-surgical states<br>• Severe hypoalbuminemia<br>Results in <b>intravascular depletion</b> despite total body fluid overload." },
            { q: "Define <b>sepsis</b> per <b>Sepsis-3</b> criteria.", a: "<b>Sepsis</b> = Life-threatening organ dysfunction caused by a dysregulated host response to infection.<br>Operationalized as: <b>Suspected infection + SOFA score ≥ 2</b> (or increase ≥ 2 from baseline)." },
            { q: "What is the <b>SOFA score</b> and what organ systems does it assess?", a: "<b>Sequential Organ Failure Assessment (SOFA)</b> score evaluates <b>6 organ systems</b>:<br>1. <b>Respiration</b> (PaO₂/FiO₂)<br>2. <b>Coagulation</b> (Platelets)<br>3. <b>Liver</b> (Bilirubin)<br>4. <b>Cardiovascular</b> (MAP / vasopressor use)<br>5. <b>CNS</b> (GCS)<br>6. <b>Renal</b> (Creatinine / Urine output)<br>Each scored 0–4; total range 0–24." },
            { q: "What is <b>qSOFA</b> and what are its components?", a: "<b>Quick SOFA (qSOFA)</b> — bedside screening tool:<br>1. <b>RR ≥ 22</b><br>2. <b>Altered mentation</b> (GCS &lt; 15)<br>3. <b>SBP ≤ 100 mmHg</b><br>Score ≥ 2 suggests <b>possible sepsis</b> → warrants further workup with SOFA score.<br><i>Note: qSOFA has high specificity but low sensitivity; it is a screening tool, not diagnostic.</i>" },
            { q: "Define <b>septic shock</b> per Sepsis-3.", a: "<b>Septic shock</b> = Sepsis with:<br>1. <b>Persistent hypotension</b> requiring vasopressors to maintain <b>MAP ≥ 65 mmHg</b><br>2. <b>Lactate &gt; 2 mmol/L</b><br>…despite <b>adequate fluid resuscitation</b>.<br>Hospital mortality exceeds <b>40%</b>." },
            { q: "What is the <b>Surviving Sepsis Campaign (SSC) 1-hour bundle</b>?", a: "Initiate within <b>1 hour</b> of recognition:<br>1. <b>Measure lactate</b> (re-measure if &gt;2)<br>2. <b>Obtain blood cultures</b> before antibiotics<br>3. <b>Administer broad-spectrum antibiotics</b><br>4. <b>Begin rapid IV crystalloid 30 mL/kg</b> for hypotension or lactate ≥ 4<br>5. <b>Apply vasopressors</b> if hypotensive during or after fluid resuscitation (target MAP ≥ 65)" },
            { q: "What is the <b>first-line vasopressor</b> in septic shock?", a: "<b>Norepinephrine</b> is the first-line vasopressor.<br>Mechanism: Potent <b>α1 agonist</b> (vasoconstriction) with mild <b>β1</b> activity (↑ CO).<br>Start at 0.1–0.5 μg/kg/min and titrate to <b>MAP ≥ 65 mmHg</b>." },
            { q: "What is the <b>vasopressor hierarchy</b> in septic shock?", a: "1. <b>Norepinephrine</b> — first-line<br>2. <b>Vasopressin</b> (0.03–0.04 U/min) — second-line, added to NE (not titrated)<br>3. <b>Epinephrine</b> — added if NE + vasopressin insufficient<br>4. <b>Phenylephrine</b> — consider if tachyarrhythmias limit NE use<br>5. <b>Dopamine</b> — alternative only in select patients (low tachyarrhythmia risk); ↑ arrhythmia risk vs NE" },
            { q: "When is <b>hydrocortisone</b> indicated in septic shock?", a: "<b>Hydrocortisone 200 mg/day</b> (50 mg IV q6h or continuous infusion) is indicated for:<br>• <b>Refractory septic shock</b> — hemodynamic instability despite adequate fluids + high-dose vasopressors<br>Based on <b>ADRENAL</b> and <b>APROCCHSS</b> trials.<br>Do NOT wait for cosyntropin stimulation test — start empirically in refractory shock." },
            { q: "What is the hemodynamic profile of <b>septic shock</b>?", a: "<b>Septic shock hemodynamics:</b><br>• <b>CO:</b> ↑ (hyperdynamic) or ↓ (late/myocardial depression)<br>• <b>SVR:</b> ↓↓ (vasodilation, hallmark)<br>• <b>PCWP:</b> ↓ or normal (relative hypovolemia)<br>• <b>ScvO₂:</b> ↑ (impaired O₂ extraction) or ↓ (if CO is low)<br>• <b>Skin:</b> Warm, flushed (warm shock) initially" },
            { q: "What is the <b>first-line treatment</b> for anaphylactic shock?", a: "<b>Epinephrine IM</b> into the <b>anterolateral thigh</b>:<br>• Adults: <b>0.3–0.5 mg</b> of 1:1000 (1 mg/mL)<br>• Pediatric: <b>0.01 mg/kg</b> (max 0.3 mg)<br>Repeat every <b>5–15 minutes</b> as needed.<br><b>Do NOT delay epinephrine</b> — it is the most important intervention." },
            { q: "Why is <b>IM epinephrine</b> preferred over IV in anaphylaxis?", a: "IM injection into the <b>vastus lateralis</b> provides:<br>• <b>Faster absorption</b> than subcutaneous<br>• <b>Safer</b> — IV epi bolus can cause fatal arrhythmias if given too quickly<br>IV epinephrine is reserved for <b>cardiac arrest or refractory anaphylaxis</b> (use 1:10,000 or epinephrine drip)." },
            { q: "What is a <b>biphasic anaphylactic reaction</b> and how long should patients be observed?", a: "A <b>biphasic reaction</b> is recurrence of anaphylaxis symptoms <b>after initial resolution</b>, without re-exposure.<br>Occurs in <b>~5–20%</b> of cases, typically <b>4–6 hours</b> after initial reaction (can occur up to 72h).<br>Patients should be observed for a <b>minimum of 4–6 hours</b> after symptom resolution; severe cases may require longer." },
            { q: "Besides epinephrine, what <b>adjunctive therapies</b> are used in anaphylaxis?", a: "• <b>IV fluids:</b> 1–2 L NS bolus (up to 20 mL/kg) for hypotension<br>• <b>Albuterol</b> nebulized for bronchospasm<br>• <b>H1 blocker:</b> Diphenhydramine 25–50 mg IV<br>• <b>H2 blocker:</b> Famotidine 20 mg IV<br>• <b>Glucocorticoids:</b> Methylprednisolone 125 mg IV (may prevent biphasic reaction, limited evidence)<br>• <b>Glucagon:</b> For patients on β-blockers (refractory to epi)" },
            { q: "What is the pathophysiology of <b>anaphylactic shock</b>?", a: "<b>IgE-mediated</b> (type I hypersensitivity) mast cell and basophil degranulation → massive release of:<br>• <b>Histamine</b> → vasodilation, ↑ permeability, bronchospasm<br>• <b>Leukotrienes & prostaglandins</b><br>Results in: <b>↓↓ SVR</b>, <b>↓ preload</b> (capillary leak), <b>bronchospasm</b>, and <b>angioedema</b>." },
            { q: "What is the classic triad of <b>neurogenic shock</b>?", a: "1. <b>Hypotension</b><br>2. <b>Bradycardia</b> (loss of sympathetic tone → unopposed vagal activity)<br>3. <b>Warm, flushed extremities</b> (peripheral vasodilation)<br>This contrasts with hypovolemic shock, which presents with <b>tachycardia</b> and <b>cool extremities</b>." },
            { q: "What causes <b>neurogenic shock</b>?", a: "Disruption of <b>sympathetic outflow</b> from the spinal cord, most commonly due to:<br>• <b>Spinal cord injury above T6</b><br>• Spinal anesthesia<br>Results in <b>loss of vasomotor tone</b> (↓ SVR) and <b>loss of cardiac sympathetic innervation</b> (↓ HR)." },
            { q: "How is <b>neurogenic shock</b> treated?", a: "1. <b>IV fluids</b> (carefully — risk of over-resuscitation without vasomotor tone)<br>2. <b>Vasopressors:</b><br>&nbsp;&nbsp;• <b>Norepinephrine</b> or <b>phenylephrine</b> (α1-mediated vasoconstriction)<br>3. <b>Atropine</b> for symptomatic <b>bradycardia</b><br>4. Maintain <b>MAP ≥ 85–90 mmHg</b> for 7 days (spinal cord perfusion)<br>5. Rule out concurrent hemorrhage (spinal shock ≠ neurogenic shock)." },
            { q: "Differentiate <b>neurogenic shock</b> from <b>spinal shock</b>.", a: "<b>Neurogenic shock:</b> Hemodynamic instability (↓ BP, ↓ HR) from loss of sympathetic tone.<br><b>Spinal shock:</b> Temporary <b>loss of all spinal reflexes</b> and flaccid paralysis below the level of injury.<br>Spinal shock is a <b>neurological phenomenon</b>, not a circulatory one. They can coexist." },
            { q: "What are the most common <b>causes of cardiogenic shock</b>?", a: "1. <b>Acute MI</b> (most common, especially large anterior STEMI or RV infarct)<br>2. <b>Acute valvular disease</b> (mitral regurgitation from papillary muscle rupture, acute AR)<br>3. <b>Myocarditis</b> (viral, autoimmune)<br>4. <b>Takotsubo cardiomyopathy</b> (stress-induced)<br>5. <b>Decompensated heart failure</b><br>6. <b>Arrhythmias</b> (sustained VT, rapid AF)" },
            { q: "What is the <b>hemodynamic profile</b> of cardiogenic shock?", a: "<b>Cardiogenic shock:</b><br>• <b>CO / CI:</b> ↓↓ (CI &lt;2.2 L/min/m²)<br>• <b>PCWP:</b> ↑↑ (&gt;18 mmHg, elevated filling pressures)<br>• <b>SVR:</b> ↑↑ (compensatory vasoconstriction)<br>• <b>ScvO₂:</b> ↓ (↑ oxygen extraction due to low output)<br>• <b>Skin:</b> Cool, clammy, mottled" },
            { q: "What inotropes are used in <b>cardiogenic shock</b>?", a: "1. <b>Dobutamine</b> — first-line inotrope; β1 > β2 agonist → ↑ contractility, mild ↓ SVR<br>2. <b>Milrinone</b> — PDE3 inhibitor → ↑ contractility + vasodilation (inodilator); risk of ↓ BP<br><b>Key point:</b> If SBP is low, <b>add norepinephrine</b> (or use it first) to maintain perfusion pressure before/with inotropes." },
            { q: "What <b>mechanical circulatory support</b> options exist for cardiogenic shock?", a: "1. <b>IABP</b> (Intra-Aortic Balloon Pump) — inflates in diastole (↑ coronary perfusion), deflates in systole (↓ afterload). IABP-SHOCK II showed no mortality benefit.<br>2. <b>Impella</b> — percutaneous axial flow pump; provides more hemodynamic support than IABP<br>3. <b>ECMO</b> (VA-ECMO) — provides full cardiopulmonary support; bridge to recovery/transplant/decision<br>4. <b>TandemHeart</b> — percutaneous LA-to-femoral artery bypass" },
            { q: "Why should you <b>avoid volume overload</b> in cardiogenic shock?", a: "In cardiogenic shock, the failing ventricle is already on the <b>flat or descending portion</b> of the Frank-Starling curve.<br>Additional volume:<br>• Does NOT improve stroke volume<br>• ↑ PCWP → <b>worsens pulmonary edema</b><br>• ↑ Wall stress → ↑ myocardial oxygen demand<br>Give fluids <b>only if there is clear evidence of hypovolemia</b> (e.g., RV infarct)." },
            { q: "How does <b>RV infarction</b> present differently from LV cardiogenic shock?", a: "<b>RV infarct</b> (inferior STEMI + RV involvement):<br>• <b>Hypotension</b> with <b>clear lungs</b> (no pulmonary edema)<br>• <b>Elevated JVP / CVP</b><br>• <b>ST elevation in V4R</b><br>Treatment: <b>Volume loading</b> (unlike LV failure), avoid nitroglycerin and diuretics, maintain AV synchrony." },
            { q: "What is <b>Takotsubo cardiomyopathy</b>?", a: "Also called <b>stress (broken heart) cardiomyopathy</b>.<br>• Triggered by intense <b>emotional or physical stress</b><br>• Apical ballooning with basal hyperkinesis on echo<br>• Mimics <b>ACS</b> (chest pain, ST changes, ↑ troponin) but coronary arteries are <b>normal</b> on angiography<br>• Due to <b>catecholamine surge</b> → direct myocardial stunning<br>• Usually <b>reversible</b> within days to weeks" },
            { q: "Name the <b>four classic causes</b> of obstructive shock.", a: "1. <b>Tension pneumothorax</b><br>2. <b>Cardiac tamponade</b><br>3. <b>Massive pulmonary embolism</b><br>4. <b>Dynamic hyperinflation (auto-PEEP)</b><br>All cause <b>impaired ventricular filling or outflow obstruction</b>, reducing cardiac output despite adequate intravascular volume." },
            { q: "How is <b>tension pneumothorax</b> diagnosed and treated?", a: "<b>Clinical diagnosis</b> (do NOT delay for imaging):<br>• Hypotension, tachycardia, ↓ breath sounds, tracheal deviation, distended neck veins<br><b>Treatment:</b><br>1. <b>Needle decompression:</b> 14–16G needle, 2nd intercostal space, midclavicular line (or 4th–5th ICS, anterior axillary line)<br>2. <b>Tube thoracostomy (chest tube)</b> — definitive management" },
            { q: "What is <b>Beck's triad</b> in cardiac tamponade?", a: "<b>Beck's triad:</b><br>1. <b>Hypotension</b> (↓ CO from impaired filling)<br>2. <b>Distended neck veins</b> (↑ venous pressure)<br>3. <b>Muffled heart sounds</b><br>Present in only ~10–40% of cases. <b>Pulsus paradoxus</b> (&gt;10 mmHg drop in SBP with inspiration) is another key finding." },
            { q: "How is <b>cardiac tamponade</b> treated?", a: "<b>Emergent pericardiocentesis</b> — needle aspiration of pericardial fluid (subxiphoid approach, ultrasound-guided).<br>Even <b>small-volume drainage</b> (20–50 mL) can dramatically improve hemodynamics.<br><b>Pericardial window</b> (surgical) — definitive drainage, especially for recurrent effusions.<br><b>Bridge:</b> IV fluids to ↑ preload while preparing for drainage." },
            { q: "What echo findings suggest <b>cardiac tamponade</b>?", a: "1. <b>Pericardial effusion</b> (anechoic space around the heart)<br>2. <b>RA diastolic collapse</b> (most sensitive early sign)<br>3. <b>RV diastolic collapse</b> (most specific)<br>4. <b>IVC plethora</b> (dilated IVC without respiratory variation)<br>5. <b>Respiratory variation in mitral/tricuspid inflow velocities</b> (&gt;25% variation)" },
            { q: "What are the treatment options for <b>massive PE</b>?", a: "<b>Massive PE</b> (with hemodynamic instability):<br>1. <b>Systemic thrombolytics:</b> tPA (alteplase) 100 mg IV over 2 hours — first-line<br>2. <b>Surgical embolectomy</b> — if thrombolytics contraindicated/failed<br>3. <b>Catheter-directed therapy</b> (catheter-directed thrombolysis or suction thrombectomy)<br>4. <b>Supportive:</b> IV fluids (cautious, 500 mL bolus), vasopressors (NE), heparin anticoagulation" },
            { q: "Why should fluids be given <b>cautiously</b> in massive PE?", a: "In massive PE, the RV is already <b>acutely dilated and failing</b>.<br>Excessive fluids can:<br>• Further <b>distend the RV</b> → septal bowing into LV → ↓ LV filling → ↓ CO<br>• Worsen <b>RV wall stress and ischemia</b><br>Give a <b>small fluid challenge</b> (250–500 mL) and assess response." },
            { q: "What is <b>dynamic hyperinflation (auto-PEEP)</b> and how does it cause obstructive shock?", a: "<b>Auto-PEEP</b> occurs when expiratory time is insufficient to fully exhale (e.g., severe asthma, COPD on mechanical ventilation).<br>Air trapping → <b>↑↑ intrathoracic pressure</b> → <b>↓ venous return</b> → <b>↓ CO</b>.<br><b>Treatment:</b> <b>Disconnect the ventilator</b> (allow full exhalation), ↓ RR, ↓ tidal volume, ↑ expiratory time, treat underlying cause (bronchodilators)." },
            { q: "A ventilated asthmatic patient becomes acutely hypotensive with rising peak pressures. What should you do <b>first</b>?", a: "<b>Disconnect from the ventilator</b> and allow full exhalation.<br>This immediately relieves <b>auto-PEEP</b> (dynamic hyperinflation) and restores venous return.<br>If no improvement, consider other causes: <b>tension PTX</b> (especially with unilateral ↓ breath sounds)." },
            { q: "What are the <b>limitations of CVP</b> as a resuscitation endpoint?", a: "<b>CVP is a poor predictor of fluid responsiveness.</b><br>Limitations:<br>• Does not reliably predict preload or volume status<br>• Affected by ventricular compliance, valvular disease, intrathoracic pressure, PPV<br>• Static measure — does not predict response to fluid bolus<br>Surviving Sepsis Campaign <b>de-emphasized CVP</b> targets in recent guidelines." },
            { q: "When is an <b>arterial line</b> indicated in shock management?", a: "Indications:<br>• <b>Vasopressor use</b> — continuous MAP monitoring for titration<br>• <b>Frequent blood gas sampling</b><br>• <b>Non-invasive BP unreliable</b> (severe vasoconstriction, obesity, arrhythmias)<br>Preferred sites: <b>Radial</b> (most common) > femoral > dorsalis pedis." },
            { q: "How is <b>point-of-care ultrasound (POCUS)</b> used in shock assessment?", a: "<b>POCUS in shock</b> evaluates:<br>1. <b>IVC:</b> Collapsibility index (>50% = likely fluid responsive; plethoric = volume overload/obstructive)<br>2. <b>Cardiac:</b> LV/RV function, pericardial effusion, wall motion abnormalities<br>3. <b>Lungs:</b> B-lines (pulmonary edema), sliding (PTX), pleural effusion<br>4. <b>Aorta:</b> Aneurysm<br>5. <b>Free fluid:</b> FAST exam for hemorrhage" },
            { q: "What does <b>IVC collapsibility &gt;50%</b> suggest in a spontaneously breathing patient?", a: "IVC collapsibility &gt;50% (IVC diameter decreases &gt;50% with inspiration) suggests:<br>• <b>Low CVP / intravascular depletion</b><br>• <b>Likely fluid responsive</b><br>A <b>plethoric (dilated, non-collapsing) IVC</b> suggests elevated RA pressure (tamponade, RV failure, tension PTX, volume overload)." },
            { q: "What are <b>B-lines</b> on lung ultrasound and their significance in shock?", a: "<b>B-lines</b> = Vertical, hyperechoic artifacts arising from the pleural line to the bottom of the screen, moving with respiration.<br>Significance:<br>• <b>≥3 B-lines per zone</b> = interstitial syndrome (pulmonary edema, ARDS)<br>• Presence of B-lines in a hypotensive patient suggests <b>cardiogenic cause</b> or volume overload<br>• Helps <b>differentiate cardiogenic from hypovolemic</b> shock" },
            { q: "What is the target for <b>lactate clearance</b> as a resuscitation endpoint?", a: "Target: <b>≥10% decrease in lactate every 2 hours</b>.<br>Lactate clearance is at least equivalent to ScvO₂ monitoring for guiding resuscitation (ANDROMEDA-SHOCK trial suggested lactate-guided is preferred).<br>Failure to clear lactate suggests <b>ongoing tissue hypoperfusion</b> or inadequate resuscitation." },
            { q: "What is the target <b>urine output</b> in adult shock resuscitation?", a: "<b>Urine output ≥ 0.5 mL/kg/hr</b> indicates adequate renal perfusion.<br>It is a <b>simple, continuous marker</b> of end-organ perfusion.<br>Requires a <b>Foley catheter</b> for accurate measurement.<br>Oliguria (&lt;0.5 mL/kg/hr) in shock → consider inadequate resuscitation or developing AKI." },
            { q: "How is <b>capillary refill time</b> used in shock assessment?", a: "<b>Capillary refill time (CRT)</b> — press fingertip for 10 seconds, release, measure time for color to return.<br>• <b>Normal:</b> &lt;3 seconds<br>• <b>Prolonged:</b> Indicates poor peripheral perfusion<br><b>ANDROMEDA-SHOCK trial</b> suggested CRT-targeted resuscitation may be superior to lactate-targeted resuscitation, with lower 28-day mortality." },
            { q: "What is the <b>passive leg raise (PLR) test</b>?", a: "<b>PLR</b> = Raising the legs to 45° from semi-recumbent position → autotransfuses ~300 mL of venous blood to the heart.<br>• <b>Positive:</b> ↑ CO by ≥ 10% (measured by cardiac output monitor, not BP alone)<br>• <b>Advantages:</b> Reversible, no fluid given, works in spontaneous or mechanical ventilation, works with arrhythmias<br>• <b>Limitations:</b> Requires real-time CO monitoring; unreliable with ↑ intra-abdominal pressure" },
            { q: "What is <b>pulse pressure variation (PPV)</b> and what value predicts fluid responsiveness?", a: "<b>PPV</b> = cyclical variation in pulse pressure during positive-pressure ventilation.<br>$$PPV = \\\\frac{PP_{max} - PP_{min}}{(PP_{max} + PP_{min})/2} \\\\times 100$$<br><b>PPV &gt;13%</b> predicts fluid responsiveness.<br><b>Requirements:</b> Mechanically ventilated, Vt ≥ 8 mL/kg, sinus rhythm, closed chest." },
            { q: "Differentiate <b>dynamic vs static indices</b> of fluid responsiveness.", a: "<b>Static indices</b> (poor predictors):<br>• CVP, PCWP, IVC diameter alone<br>• Single-point measurements; do not predict response to fluids<br><br><b>Dynamic indices</b> (better predictors):<br>• <b>PPV, SVV</b> (pulse pressure / stroke volume variation)<br>• <b>PLR test</b><br>• <b>IVC collapsibility/distensibility index</b><br>• <b>Fluid challenge</b> (measure CO response)<br>Dynamic indices assess <b>preload dependence</b>, not just preload." },
            { q: "Describe the <b>fluid challenge technique</b>.", a: "Give a <b>small, defined bolus</b> (e.g., 250 mL crystalloid over 10–15 min) and assess response:<br>• <b>Responder:</b> ↑ CO/SV by ≥10–15%, improved MAP<br>• <b>Non-responder:</b> No significant hemodynamic improvement → stop fluids, consider vasopressors/inotropes<br>Avoids unnecessary fluid loading in non-responders." },
            { q: "What are the <b>limitations of PPV/SVV</b> as predictors of fluid responsiveness?", a: "<b>PPV and SVV are unreliable when:</b><br>• Patient is <b>spontaneously breathing</b> or triggering the ventilator<br>• <b>Tidal volume &lt;8 mL/kg</b> (ARDS lung-protective settings)<br>• <b>Arrhythmias</b> (AF → irregular RR intervals)<br>• <b>Open chest</b><br>• <b>Elevated intra-abdominal pressure</b><br>• <b>RV failure</b> (PPV may be elevated without fluid responsiveness)" },
            { q: "Describe the receptor profile and effects of <b>norepinephrine</b>.", a: "<b>Norepinephrine:</b><br>• <b>Receptors:</b> α1 &gt;&gt; β1 &gt; β2<br>• <b>Effects:</b> Potent vasoconstriction (↑ SVR, ↑ MAP), mild ↑ HR and contractility<br>• <b>Use:</b> First-line in septic shock, neurogenic shock<br>• <b>Risk:</b> Peripheral ischemia, ↑ afterload (caution in cardiogenic shock)" },
            { q: "Describe the receptor profile and effects of <b>epinephrine</b>.", a: "<b>Epinephrine:</b><br>• <b>Low dose</b> (≤0.1 μg/kg/min): <b>β1 &amp; β2 dominant</b> → ↑ HR, ↑ contractility, bronchodilation, mild ↓ SVR<br>• <b>High dose</b> (&gt;0.1 μg/kg/min): <b>α1 dominant</b> → vasoconstriction, ↑ SVR<br>• <b>Use:</b> Anaphylaxis (IM), cardiac arrest (IV), refractory septic shock (add-on)<br>• <b>Adverse:</b> Tachyarrhythmias, ↑ lactate (aerobic glycolysis), splanchnic vasoconstriction" },
            { q: "Describe the mechanism and effects of <b>vasopressin</b>.", a: "<b>Vasopressin (ADH):</b><br>• <b>Receptor:</b> V1 (vascular smooth muscle)<br>• <b>Effects:</b> Vasoconstriction independent of adrenergic receptors; restores vascular tone in catecholamine-resistant vasodilatory shock<br>• <b>Dose:</b> 0.03–0.04 U/min (<b>fixed dose, NOT titrated</b>)<br>• <b>Use:</b> Second-line in septic shock (added to NE); vasodilatory shock<br>• <b>Advantage:</b> Does not increase HR; may reduce NE requirements" },
            { q: "Describe the receptor profile and effects of <b>phenylephrine</b>.", a: "<b>Phenylephrine:</b><br>• <b>Receptor:</b> Pure <b>α1 agonist</b><br>• <b>Effects:</b> ↑ SVR, ↑ MAP, <b>no β activity</b> → no ↑ HR or contractility<br>• <b>Use:</b> Septic shock with tachyarrhythmias (when NE would worsen), neurogenic shock<br>• <b>Risk:</b> Reflex bradycardia, ↓ CO in patients with poor cardiac function (↑ afterload without ↑ contractility)" },
            { q: "Describe <b>dopamine's</b> dose-dependent receptor activity.", a: "<b>Dopamine</b> — dose-dependent effects:<br>• <b>Low dose (1–5 μg/kg/min):</b> D1 receptors → renal/mesenteric vasodilation (\"renal dose\" — <b>no proven clinical benefit</b>)<br>• <b>Medium dose (5–10 μg/kg/min):</b> β1 → ↑ HR, ↑ contractility<br>• <b>High dose (&gt;10 μg/kg/min):</b> α1 → vasoconstriction<br><b>Note:</b> Higher arrhythmia risk than NE; inferior to NE in septic shock (SOAP II trial)." },
            { q: "Describe the mechanism and effects of <b>dobutamine</b>.", a: "<b>Dobutamine:</b><br>• <b>Receptors:</b> β1 &gt; β2 (synthetic catecholamine)<br>• <b>Effects:</b> ↑ Contractility (inotropy), ↑ HR (chronotropy), mild vasodilation (β2 → ↓ SVR)<br>• <b>Use:</b> Cardiogenic shock, septic shock with myocardial depression (added to NE)<br>• <b>Risk:</b> ↓ BP (due to vasodilation), tachycardia, arrhythmias<br>• <b>Often paired with a vasopressor</b> (NE) to offset the hypotensive effect" },
            { q: "Describe <b>milrinone's</b> mechanism and when it is preferred.", a: "<b>Milrinone:</b><br>• <b>Mechanism:</b> <b>PDE3 (phosphodiesterase-3) inhibitor</b> → ↑ intracellular cAMP → ↑ contractility + vasodilation<br>• <b>Classification:</b> <b>Inodilator</b><br>• <b>Effects:</b> ↑ CO, ↓ SVR, ↓ PVR (beneficial in RV failure / pulmonary hypertension)<br>• <b>Preferred when:</b> RV failure, pulmonary hypertension, β-blocker on board (mechanism is non-adrenergic)<br>• <b>Risk:</b> Hypotension, arrhythmias; <b>renally cleared</b> (↓ dose in renal failure)" },
            { q: "Which vasopressor should be <b>avoided</b> as first-line in septic shock and why?", a: "<b>Dopamine</b> should be avoided as first-line.<br><b>SOAP II trial</b>: Dopamine was associated with <b>↑ arrhythmias</b> (especially atrial fibrillation) and <b>↑ mortality</b> in cardiogenic shock subgroup compared to norepinephrine.<br>Dopamine may be considered <b>only in select patients</b> with low tachyarrhythmia risk and absolute/relative bradycardia." },
            { q: "A patient on high-dose norepinephrine for septic shock remains hypotensive. What is your next step?", a: "Add <b>vasopressin 0.03 U/min</b> (second-line agent).<br>If still refractory, consider:<br>• <b>Epinephrine</b> as a third agent<br>• <b>Hydrocortisone 200 mg/day</b> for possible relative adrenal insufficiency<br>• Reassess: Rule out undrained source, obstructive cause, or new pathology." },
            { q: "How does <b>shock recognition differ in children</b> compared to adults?", a: "Children maintain BP through <b>potent compensatory tachycardia and vasoconstriction</b>.<br><b>Tachycardia</b> is the <b>earliest and most sensitive sign</b>.<br><b>Hypotension</b> is a <b>very late and ominous sign</b> in pediatric shock (indicates &gt;25% blood volume loss).<br>Look for: ↑ HR, prolonged capillary refill, altered mental status, weak pulses, mottled skin." },
            { q: "What is the initial <b>fluid bolus</b> for a child in shock?", a: "<b>20 mL/kg</b> isotonic crystalloid (NS or LR) over <b>5–20 minutes</b>.<br>Reassess after each bolus. May repeat up to <b>60 mL/kg</b> in the first hour.<br>If no improvement after <b>40–60 mL/kg</b>, consider <b>vasopressor support</b> and other causes (cardiogenic, obstructive).<br><b>Exception:</b> In DKA, give <b>10–20 mL/kg</b> more cautiously." },
            { q: "Differentiate <b>cold shock vs warm shock</b> in pediatric patients.", a: "<b>Cold shock</b> (more common in children):<br>• ↑ SVR, ↓ CO<br>• Cool extremities, weak pulses, prolonged capillary refill, narrow pulse pressure<br>• Treat with: <b>Epinephrine</b> (vasopressor + inotrope)<br><br><b>Warm shock:</b><br>• ↓ SVR, ↑ CO (vasodilatory)<br>• Warm extremities, flash capillary refill, wide pulse pressure<br>• Treat with: <b>Norepinephrine</b> (vasopressor)" },
            { q: "What is the <b>first-line vasopressor</b> in pediatric <b>cold shock</b>?", a: "<b>Epinephrine</b> — provides both <b>inotropy (↑ contractility)</b> and <b>vasoconstriction</b>, which addresses the ↓ CO and ↑ SVR pattern.<br>Dose: 0.1–1 μg/kg/min IV.<br>Peripheral (temporary) or IO access acceptable while central access is obtained." },
            { q: "What is the <b>first-line vasopressor</b> in pediatric <b>warm shock</b>?", a: "<b>Norepinephrine</b> — potent α1-mediated vasoconstriction to counteract the <b>↓ SVR</b>.<br>Dose: 0.1–2 μg/kg/min IV.<br>This is the same first-line agent as in adult septic shock." },
            { q: "What defines <b>hypotension</b> in pediatric patients by age group?", a: "<b>SBP thresholds for hypotension:</b><br>• <b>Term neonates (0–28 days):</b> &lt;60 mmHg<br>• <b>Infants (1–12 months):</b> &lt;70 mmHg<br>• <b>Children (1–10 years):</b> &lt;70 + (2 × age in years) mmHg<br>• <b>Children ≥10 years:</b> &lt;90 mmHg<br>Remember: Hypotension in a child is a <b>pre-arrest</b> sign." },
            { q: "What is <b>Shock Index (SI)</b> and what does an elevated value indicate?", a: "$$SI = \\\\frac{HR}{SBP}$$<br>• <b>Normal:</b> 0.5–0.7<br>• <b>SI &gt; 0.9:</b> Suggests significant hemodynamic compromise<br>• <b>SI &gt; 1.0:</b> Associated with increased mortality<br>Useful as a <b>rapid bedside tool</b> to identify occult shock when BP is still normal." },
            { q: "What is the <b>Modified Shock Index (MSI)</b>?", a: "$$MSI = \\\\frac{HR}{MAP}$$<br>More accurate than SI in some studies.<br>• <b>MSI &gt; 1.3</b> is associated with ↑ mortality and need for massive transfusion.<br>Accounts for <b>both systolic and diastolic components</b> of blood pressure." },
            { q: "What is the <b>RUSH exam</b> (Rapid Ultrasound in Shock and Hypotension)?", a: "<b>RUSH exam</b> — a structured POCUS protocol with 3 components:<br>1. <b>The Pump:</b> Cardiac views — pericardial effusion, LV/RV function, contractility<br>2. <b>The Tank:</b> IVC (volume status), FAST (free fluid), lungs (B-lines, pleural effusion)<br>3. <b>The Pipes:</b> Aorta (AAA), DVT (femoral/popliteal veins for PE)<br>Helps <b>differentiate shock types</b> rapidly at bedside." },
            { q: "In the RUSH exam, what findings suggest <b>hypovolemic shock</b>?", a: "<b>Pump:</b> Hyperdynamic, small (\"kissing\") LV, empty chambers<br><b>Tank:</b> Small, collapsing IVC; (+) FAST exam if hemorrhagic; dry lung fields (A-lines)<br><b>Pipes:</b> Normal aorta (unless AAA is the source)" },
            { q: "In the RUSH exam, what findings suggest <b>cardiogenic shock</b>?", a: "<b>Pump:</b> Dilated, hypokinetic LV, ↓ EF, possible wall motion abnormalities, ± pericardial effusion<br><b>Tank:</b> Distended, plethoric IVC; bilateral B-lines (pulmonary edema); possible pleural effusions<br><b>Pipes:</b> Normal" },
            { q: "In the RUSH exam, what findings suggest <b>obstructive shock</b> from tamponade?", a: "<b>Pump:</b> Pericardial effusion, RA/RV diastolic collapse, \"swinging heart\"<br><b>Tank:</b> Distended, plethoric IVC<br><b>Pipes:</b> Normal" },
            { q: "What is the role of <b>ECMO</b> in shock?", a: "<b>Veno-Arterial (VA) ECMO</b> provides:<br>• Full <b>cardiopulmonary support</b> — takes over both heart and lung function<br>• Used in: <b>Refractory cardiogenic shock, massive PE, cardiac arrest, post-cardiotomy</b><br>• Serves as bridge to: <b>Recovery, decision, transplant, or LVAD</b><br><b>Veno-Venous (VV) ECMO</b> — for respiratory failure only (does NOT provide hemodynamic support)." },
            { q: "What is <b>pulsus paradoxus</b> and in what conditions is it seen?", a: "<b>Pulsus paradoxus</b> = Exaggerated ↓ in SBP (&gt;10 mmHg) during inspiration.<br>Mechanism: Inspiration → ↑ RV filling → septal bowing into LV → ↓ LV output<br><b>Seen in:</b><br>• Cardiac tamponade (classic)<br>• Severe asthma / COPD<br>• Constrictive pericarditis<br>• Tension pneumothorax" },
            { q: "What is the <b>Surviving Sepsis Campaign recommendation</b> regarding choice of crystalloid?", a: "The SSC suggests using <b>balanced crystalloids</b> (Lactated Ringer's, Plasma-Lyte) <b>over normal saline</b> for resuscitation of sepsis/septic shock.<br>Rationale: Large-volume NS → <b>hyperchloremic metabolic acidosis</b> → potential ↑ AKI risk.<br>Evidence: SMART trial, BaSICS trial." },
            { q: "What is the <b>CaO₂</b> (arterial oxygen content) formula, and which component contributes most?", a: "$$CaO_2 = (1.34 \\\\times Hb \\\\times SaO_2) + (0.003 \\\\times PaO_2)$$<br>The <b>hemoglobin-bound portion</b> (1.34 × Hb × SaO₂) contributes <b>&gt;98%</b> of oxygen content.<br>The dissolved O₂ component (0.003 × PaO₂) is clinically negligible under normal conditions.<br>This is why <b>anemia</b> critically reduces DO₂." },
            { q: "At what hemoglobin threshold should you <b>transfuse pRBCs</b> in critically ill patients (non-hemorrhagic)?", a: "<b>Restrictive threshold:</b> Hb &lt; <b>7 g/dL</b> for most critically ill patients.<br>Based on <b>TRICC</b> and <b>TRISS</b> trials — restrictive strategy is <b>non-inferior or superior</b> to liberal (Hb &lt;10).<br><b>Exceptions:</b> Active ACS (target Hb &gt;8), massive hemorrhage (MTP), symptomatic anemia." },
            { q: "What is <b>sepsis-induced myocardial dysfunction</b>?", a: "Occurs in <b>~40–60%</b> of patients with septic shock.<br>• <b>Biventricular dilation</b> with ↓ EF<br>• Caused by circulating <b>myocardial depressant factors</b> (TNF-α, IL-1β, NO)<br>• <b>Paradoxically:</b> Ventricular dilation may be a <b>compensatory mechanism</b> (Frank-Starling) and is associated with better survival<br>• Usually <b>reversible</b> within 7–10 days if patient survives" },
            { q: "What is the role of <b>angiotensin II (Giapreza)</b> in refractory shock?", a: "<b>Angiotensin II</b> is a vasopressor acting on <b>AT1 receptors</b> → potent vasoconstriction.<br><b>ATHOS-3 trial:</b> Improved MAP response in catecholamine-resistant vasodilatory shock.<br>Considered as a <b>rescue agent</b> when NE + vasopressin + hydrocortisone are insufficient.<br>Also stimulates <b>aldosterone</b> release and <b>ADH</b> secretion." },
            { q: "How does <b>methylene blue</b> work in refractory vasodilatory shock?", a: "<b>Methylene blue</b> inhibits <b>nitric oxide synthase (NOS)</b> and <b>guanylate cyclase</b> → blocks NO-mediated vasodilation.<br>Used as a <b>rescue therapy</b> in refractory vasoplegic shock (especially post-cardiac surgery or anaphylaxis).<br>Dose: <b>1–2 mg/kg IV</b> bolus, may repeat.<br><b>Contraindicated:</b> G6PD deficiency, serotonergic medications (risk of serotonin syndrome)." },
            { q: "What are the <b>SIRS criteria</b> and why were they replaced by Sepsis-3?", a: "<b>SIRS criteria</b> (≥2 of 4):<br>1. Temp &gt;38°C or &lt;36°C<br>2. HR &gt;90<br>3. RR &gt;20 or PaCO₂ &lt;32<br>4. WBC &gt;12,000 or &lt;4,000 or &gt;10% bands<br><b>Replaced because:</b> Too <b>sensitive, not specific</b> — met by many non-infectious conditions (exercise, post-op, pancreatitis). SOFA-based Sepsis-3 better predicts mortality." },
            { q: "When should you consider <b>push-dose pressors</b> in the ED?", a: "<b>Push-dose pressors</b> = Small IV bolus doses of vasopressors for immediate, short-term BP support.<br><b>Indications:</b><br>• Peri-intubation hypotension<br>• Bridge while setting up vasopressor drip<br>• Acute cardiovascular collapse<br><b>Common agents:</b><br>• <b>Push-dose phenylephrine:</b> 100–200 μg IV q2–5 min<br>• <b>Push-dose epinephrine:</b> 10–20 μg IV q2–5 min" },
            { q: "What is <b>stress-dose steroids</b> and the dosing in shock?", a: "<b>Hydrocortisone 50 mg IV q6h</b> (200 mg/day) or continuous infusion.<br>Some protocols add <b>fludrocortisone 50 μg PO daily</b>.<br>Duration: Continue until vasopressors are weaned, then taper.<br><b>Do NOT wait</b> for a cortisol stimulation test before starting in refractory septic shock." },
            { q: "What laboratory studies should be ordered in the initial workup of <b>undifferentiated shock</b>?", a: "• <b>CBC</b> (Hb, WBC, platelets)<br>• <b>BMP/CMP</b> (electrolytes, renal function, glucose)<br>• <b>Lactate</b><br>• <b>ABG/VBG</b> (acid-base, base deficit)<br>• <b>Coagulation studies</b> (PT/INR, PTT, fibrinogen)<br>• <b>Type & screen / crossmatch</b><br>• <b>Blood cultures × 2</b><br>• <b>Troponin, BNP</b><br>• <b>Liver function tests</b><br>• <b>Lipase</b><br>• <b>Urinalysis + urine culture</b><br>• <b>CXR, ECG</b>" },
            { q: "What is the difference between <b>compensated</b> and <b>decompensated</b> shock?", a: "<b>Compensated shock:</b><br>• BP is maintained by compensatory mechanisms (↑ HR, ↑ SVR)<br>• Tachycardia, cool/clammy skin, ↑ lactate<br>• <b>BP is still normal</b><br><br><b>Decompensated shock:</b><br>• Compensatory mechanisms fail<br>• <b>Hypotension develops</b><br>• End-organ dysfunction evident (altered mental status, oliguria)<br>• Requires <b>immediate aggressive intervention</b>" },
            { q: "What is the <b>IABP (Intra-Aortic Balloon Pump)</b> mechanism?", a: "<b>IABP</b> counterpulsation:<br>• <b>Inflates during diastole:</b> ↑ Coronary perfusion pressure, ↑ diastolic augmentation<br>• <b>Deflates during systole:</b> ↓ Afterload (↓ LV wall stress, ↓ myocardial O₂ demand), ↑ CO<br><b>IABP-SHOCK II trial:</b> No 30-day or 12-month mortality benefit in cardiogenic shock complicating MI.<br><b>Contraindications:</b> Aortic regurgitation, aortic dissection, severe PVD." },
            { q: "What <b>vasopressor</b> should be used through a <b>peripheral IV</b> if central access is unavailable?", a: "<b>Any vasopressor</b> can be given peripherally for <b>short durations</b> in emergencies.<br>Preferred: <b>Norepinephrine or phenylephrine</b> via a well-functioning, <b>proximal peripheral IV</b> (antecubital or above).<br>Monitor closely for <b>extravasation</b>.<br>If extravasation occurs: <b>Phentolamine</b> (α-blocker) 5–10 mg in 10 mL NS injected SQ into the area." },
            { q: "What is <b>phentolamine</b> used for in vasopressor management?", a: "<b>Phentolamine</b> is a non-selective <b>α-adrenergic antagonist</b>.<br>Used as <b>antidote for vasopressor extravasation</b>.<br>Dose: <b>5–10 mg diluted in 10–15 mL NS</b>, injected subcutaneously into the affected area within <b>12 hours</b> of extravasation.<br>Causes local <b>vasodilation</b> to reverse ischemia." },
            { q: "What are the hemodynamic differences between the <b>four types of shock</b>?", a: "<table><tr><th>Parameter</th><th>Hypovolemic</th><th>Cardiogenic</th><th>Distributive</th><th>Obstructive</th></tr><tr><td><b>CO</b></td><td>↓</td><td>↓↓</td><td>↑ (early)</td><td>↓</td></tr><tr><td><b>SVR</b></td><td>↑</td><td>↑↑</td><td>↓↓</td><td>↑</td></tr><tr><td><b>PCWP</b></td><td>↓</td><td>↑↑</td><td>↓</td><td>↑ (tamponade) or ↓</td></tr><tr><td><b>CVP</b></td><td>↓</td><td>↑</td><td>↓</td><td>↑</td></tr></table>" },
            { q: "What is <b>stroke volume variation (SVV)</b> and its threshold for fluid responsiveness?", a: "$$SVV = \\\\frac{SV_{max} - SV_{min}}{SV_{mean}} \\\\times 100$$<br><b>SVV &gt; 10–13%</b> during mechanical ventilation predicts fluid responsiveness.<br>Same limitations as PPV: Requires <b>passive, controlled ventilation</b>, Vt ≥ 8 mL/kg, sinus rhythm." },
            { q: "What is <b>septic shock's</b> effect on the microcirculation?", a: "Sepsis causes <b>microcirculatory dysfunction</b>:<br>• <b>Endothelial damage</b> → glycocalyx shedding → ↑ capillary leak<br>• <b>Microthrombosis</b> (DIC) → heterogeneous capillary flow<br>• <b>Impaired O₂ extraction</b> (mitochondrial dysfunction)<br>• <b>Arteriolar vasodilation</b> + <b>venular constriction</b><br>This explains why <b>ScvO₂ may be high</b> despite tissue hypoxia (oxygen can't be utilized)." },
            { q: "What is the <b>door-to-antibiotic</b> time goal in sepsis?", a: "Antibiotics should be administered <b>within 1 hour</b> of sepsis recognition.<br>Each <b>hour of delay</b> in antibiotic administration is associated with an estimated <b>~4% increase in mortality</b> (Kumar et al.).<br>Blood cultures should be obtained <b>before</b> antibiotics, but should <b>NOT delay</b> antibiotic administration." },
            { q: "What is <b>adrenal crisis</b> and how can it mimic distributive shock?", a: "<b>Adrenal crisis</b> (acute adrenal insufficiency) presents with:<br>• <b>Refractory hypotension</b> (unresponsive to fluids/vasopressors)<br>• Hypoglycemia, hyperkalemia, hyponatremia<br>• Nausea, vomiting, abdominal pain<br>Can be precipitated by <b>abrupt steroid withdrawal</b>, sepsis, or acute illness in patients with chronic adrenal suppression.<br>Treatment: <b>Hydrocortisone 100 mg IV bolus</b>, then 50 mg q8h + aggressive fluid resuscitation." },
            { q: "What is the <b>Impella device</b> and how does it work?", a: "<b>Impella</b> = Percutaneous microaxial flow pump placed across the aortic valve.<br>• Draws blood from <b>LV → ascending aorta</b><br>• Directly <b>unloads the LV</b> → ↓ LV wall stress, ↓ PCWP, ↑ CO<br>• Provides <b>2.5–5.5 L/min</b> of support depending on model<br>• More hemodynamic support than IABP<br>• Used in: High-risk PCI, cardiogenic shock, bridge to recovery/LVAD/transplant" },
            { q: "What are the <b>contraindications to tPA</b> in massive PE?", a: "<b>Absolute contraindications:</b><br>• Active internal bleeding (excluding menses)<br>• Recent intracranial surgery/trauma (&lt;3 months)<br>• Intracranial neoplasm / AVM<br>• Hemorrhagic stroke (any time) or ischemic stroke (&lt;3 months)<br><b>Relative contraindications:</b><br>• Major surgery &lt;3 weeks, active peptic ulcer, severe HTN<br><b>Note:</b> In <b>cardiac arrest from PE</b>, most contraindications become <b>relative</b>." },
            { q: "How much fluid should be given in the <b>initial resuscitation of sepsis/septic shock</b>?", a: "<b>30 mL/kg of crystalloid</b> within the first <b>3 hours</b> for patients with sepsis-induced hypotension or lactate ≥ 4 mmol/L.<br>For a 70 kg patient: ~<b>2.1 liters</b>.<br>After initial bolus, <b>reassess fluid responsiveness</b> using dynamic measures before additional fluids.<br>Avoid excessive fluid — <b>fluid overload</b> is associated with ↑ mortality." },
            { q: "What is the <b>ANDROMEDA-SHOCK</b> trial's main finding?", a: "The <b>ANDROMEDA-SHOCK trial</b> compared <b>peripheral perfusion (capillary refill time)</b>-targeted vs <b>lactate</b>-targeted resuscitation in septic shock.<br>CRT-guided resuscitation resulted in <b>less organ dysfunction at 72h</b> (lower SOFA scores) and a trend toward <b>lower 28-day mortality</b> (not statistically significant).<br>Supports using <b>CRT as a resuscitation target</b>." },
            { q: "What is the <b>Fick equation</b> and how does it relate to shock?", a: "$$VO_2 = CO \\\\times (CaO_2 - CvO_2) \\\\times 10$$<br>Where:<br>• VO₂ = Oxygen consumption<br>• CO = Cardiac output<br>• CaO₂ − CvO₂ = Arteriovenous O₂ difference<br>In shock, the body compensates for ↓ CO by <b>↑ O₂ extraction</b> (widened A-V O₂ difference). When extraction is maximal, further ↓ CO leads to <b>anaerobic metabolism</b>." },
            { q: "What is <b>occult shock</b> and how is it identified?", a: "<b>Occult (cryptic) shock</b> = tissue hypoperfusion with <b>normal vital signs</b>.<br>Identified by:<br>• <b>↑ Lactate</b> (>2 mmol/L with normal BP)<br>• <b>↑ Base deficit</b><br>• <b>↑ Shock Index</b> (>0.7–0.9)<br>• <b>↓ ScvO₂</b><br>• Mottled skin, prolonged capillary refill<br>Important to recognize early — untreated occult shock progresses to overt shock with ↑ mortality." },
            { q: "What is the <b>lethal diamond</b> (sometimes called lethal pentagon) in massive hemorrhage?", a: "An expansion of the <b>lethal triad</b> to include:<br>1. <b>Hypothermia</b><br>2. <b>Acidosis</b><br>3. <b>Coagulopathy</b><br>4. <b>Hypocalcemia</b> (from citrate in blood products chelating calcium)<br>Some add a 5th: <b>Hyperkalemia</b> (from stored blood / tissue ischemia).<br><b>Calcium replacement</b> (CaCl₂ or Ca gluconate) is essential during MTP." },
            { q: "How does <b>calcium</b> relate to massive transfusion?", a: "Blood products contain <b>citrate</b> (anticoagulant preservative), which <b>chelates ionized calcium</b>.<br>Massive transfusion → <b>hypocalcemia</b> → impairs:<br>• <b>Myocardial contractility</b><br>• <b>Coagulation cascade</b><br>• <b>Vasomotor tone</b><br>Monitor <b>ionized calcium</b> and replace with <b>calcium chloride (10 mL of 10%) or calcium gluconate</b> after every 4 units of pRBCs." },
            { q: "What is <b>permissive hypercapnia</b> and when is it relevant in shock management?", a: "<b>Permissive hypercapnia</b> = Tolerating elevated PaCO₂ to allow lung-protective ventilation (low Vt 6 mL/kg).<br>Relevant in shock patients who also have <b>ARDS</b>.<br>However, in shock with <b>severe metabolic acidosis</b>, some respiratory compensation (↑ RR) may be needed. Overly aggressive permissive hypercapnia can worsen acidosis → ↓ vasopressor responsiveness." },
            { q: "What is <b>Kussmaul sign</b> and in what shock-causing conditions is it seen?", a: "<b>Kussmaul sign</b> = Paradoxical <b>rise in JVP with inspiration</b> (normally JVP falls).<br>Indicates impaired RV filling.<br>Seen in:<br>• <b>Constrictive pericarditis</b> (classic)<br>• <b>Restrictive cardiomyopathy</b><br>• <b>RV infarction</b><br>• Severe RV failure<br><b>NOT typically seen</b> in cardiac tamponade (important distinction)." },
            { q: "How do <b>β-blockers</b> affect the presentation of shock?", a: "β-blockers can <b>mask compensatory tachycardia</b>, making shock harder to recognize.<br>Patients on β-blockers may present with:<br>• <b>Relative bradycardia</b> despite hypovolemia/sepsis<br>• Blunted heart rate response → <b>delayed recognition</b> of hemorrhage<br>In anaphylaxis with β-blocker use: <b>Glucagon 1–5 mg IV</b> (bypasses β-receptor blockade via cAMP increase)." },
            { q: "What is <b>ScvO₂ &lt; 70%</b> vs <b>&gt; 80%</b> in the context of septic shock?", a: "<b>ScvO₂ &lt; 70%</b> (early sepsis):<br>• ↓ Delivery or ↑ consumption → tissues extracting more O₂<br>• Suggests: Inadequate CO, anemia, hypoxemia → optimize DO₂ (fluids, transfusion, O₂)<br><br><b>ScvO₂ &gt; 80%</b> (late sepsis):<br>• Cells <b>cannot extract</b> oxygen (mitochondrial dysfunction, microvascular shunting)<br>• Correlates with <b>worse prognosis</b> despite normal O₂ delivery" },
            { q: "What are the <b>indications for emergent thoracotomy (EDT)</b> in traumatic shock?", a: "<b>Emergent department thoracotomy (EDT)</b> indications:<br>• <b>Penetrating thoracic trauma</b> with witnessed cardiac arrest / loss of vitals in ED (best survival)<br>• <b>Penetrating trauma</b> with refractory shock<br>• <b>Blunt trauma</b> with witnessed arrest (much lower survival)<br><b>Goals:</b> Release tamponade, cross-clamp aorta, control hemorrhage, open cardiac massage.<br><b>Contraindicated:</b> Prolonged CPR without response, blunt arrest without vitals in ED." },
            { q: "What is <b>REBOA</b> and when is it used?", a: "<b>REBOA</b> = Resuscitative Endovascular Balloon Occlusion of the Aorta.<br>• Catheter-based balloon placed in aorta to <b>occlude flow</b> → ↑ afterload + redirects blood to heart and brain<br>• <b>Zone 1</b> (descending thoracic aorta): For abdominal/pelvic hemorrhage<br>• <b>Zone 3</b> (infrarenal aorta): For pelvic hemorrhage<br>• <b>Bridge</b> to definitive surgical/IR intervention<br>• Less invasive alternative to EDT aortic cross-clamp" },
            { q: "What is the <b>Parkland formula</b> for burn resuscitation?", a: "$$\\\\text{Total fluids (24h)} = 4 \\\\times \\\\text{%TBSA} \\\\times \\\\text{weight (kg)}$$<br>• Use <b>Lactated Ringer's</b><br>• Give <b>50% in the first 8 hours</b> (from time of burn, not presentation)<br>• Give remaining <b>50% over the next 16 hours</b><br>• Titrate to <b>urine output 0.5–1 mL/kg/hr</b> in adults<br>• Only count <b>2nd and 3rd degree burns</b> for %TBSA" },
            { q: "What is <b>distributive shock</b> pathophysiology?", a: "Distributive shock results from <b>profound systemic vasodilation</b> (↓↓ SVR) → maldistribution of blood flow.<br>Despite adequate or even ↑ CO (early), <b>tissue perfusion is impaired</b>.<br>Key mediators:<br>• <b>Nitric oxide (NO)</b> — vasodilation<br>• <b>Cytokines</b> (TNF-α, IL-1, IL-6) — endothelial activation<br>• <b>Histamine</b> (anaphylaxis)<br>• <b>Loss of sympathetic tone</b> (neurogenic)" },
            { q: "What are the <b>Surviving Sepsis Campaign 2021</b> key changes from previous guidelines?", a: "Key updates:<br>1. <b>1-hour bundle</b> replaces 3h/6h bundles<br>2. <b>Balanced crystalloids preferred</b> over NS<br>3. <b>De-emphasis of CVP</b> as a resuscitation target<br>4. <b>Against routine use of hydrocortisone</b> unless refractory shock<br>5. Suggest <b>capillary refill time</b> as perfusion guide<br>6. Consider <b>restrictive fluid strategy</b> after initial resuscitation<br>7. <b>MAP ≥ 65 mmHg</b> initial target (over higher targets)" },
            { q: "Why is <b>dopamine</b> particularly dangerous in cardiogenic shock?", a: "The <b>SOAP II trial</b> subgroup analysis showed that dopamine was associated with <b>significantly higher mortality</b> in the cardiogenic shock subgroup compared to norepinephrine.<br>Reasons:<br>• <b>↑ Myocardial oxygen demand</b> (strong chronotropic effect)<br>• <b>↑ Arrhythmias</b> (especially atrial fibrillation)<br>• Less predictable dose-response relationship<br><b>Norepinephrine</b> is preferred." },
            { q: "What is <b>warm shock</b> vs <b>cold shock</b> in adults with sepsis?", a: "<b>Warm shock</b> (early / hyperdynamic):<br>• ↓ SVR, ↑ CO<br>• Warm, flushed skin; bounding pulses; wide pulse pressure<br>• Flash capillary refill<br><br><b>Cold shock</b> (late / hypodynamic):<br>• ↓ CO (myocardial depression), ↑ SVR<br>• Cool, mottled skin; weak pulses; narrow pulse pressure<br>• Prolonged capillary refill<br>Cold shock indicates <b>decompensation</b> and carries a worse prognosis." },
            { q: "What is the target <b>MAP</b> in septic shock and should higher targets be used?", a: "Target: <b>MAP ≥ 65 mmHg</b>.<br><b>SEPSISPAM trial:</b> Higher MAP target (80–85 mmHg) showed no overall mortality benefit but was associated with <b>↑ atrial fibrillation</b>.<br><b>Exception:</b> Patients with <b>chronic hypertension</b> may benefit from a slightly higher target (75–80 mmHg) — reduced need for renal replacement therapy in the high-target group." },
            { q: "What <b>POCUS finding</b> differentiates tension pneumothorax from cardiac tamponade?", a: "Both present with hypotension + distended neck veins, but on POCUS:<br><b>Tension PTX:</b><br>• <b>Absent lung sliding</b> on affected side<br>• <b>Barcode / stratosphere sign</b> on M-mode<br>• No pericardial effusion<br><br><b>Tamponade:</b><br>• <b>Pericardial effusion</b> with RA/RV collapse<br>• Normal lung sliding bilaterally<br>• Plethoric IVC" },
            { q: "What is <b>levosimendan</b> and when might it be considered?", a: "<b>Levosimendan</b> = Calcium sensitizer + K<sub>ATP</sub> channel opener.<br>• <b>↑ Contractility</b> without increasing myocardial O₂ demand (unlike dobutamine)<br>• <b>Vasodilation</b> (systemic + pulmonary)<br>• Used in some countries for <b>acute decompensated heart failure</b> and cardiogenic shock<br>• Not FDA-approved in the US<br>• Evidence: <b>LIDO trial</b> suggested better outcomes vs dobutamine in severe HF" },
            { q: "What is the <b>end-tidal CO₂ (ETCO₂)</b> role in shock and cardiac arrest?", a: "<b>ETCO₂</b> reflects <b>cardiac output</b> and pulmonary blood flow:<br>• <b>Low ETCO₂</b> (&lt;10 mmHg during CPR) → poor perfusion, unlikely ROSC<br>• <b>Sudden rise in ETCO₂</b> during CPR → suggests <b>ROSC</b><br>• In shock: Low ETCO₂ correlates with ↓ CO<br>• After 20 min CPR: <b>ETCO₂ &lt;10 mmHg</b> is one criterion to consider terminating resuscitation." },
            { q: "How does <b>positive pressure ventilation</b> affect hemodynamics in shock?", a: "<b>Positive pressure ventilation:</b><br>• ↑ Intrathoracic pressure → <b>↓ venous return</b> → ↓ preload → ↓ CO<br>• This is exaggerated in <b>hypovolemic and obstructive shock</b><br>• May <b>worsen hypotension</b> — the \"post-intubation arrest\"<br><b>Protective strategies:</b><br>• Volume load before intubation<br>• Have vasopressors ready (push-dose epi/phenylephrine)<br>• Avoid excessive PEEP initially<br>• In cardiogenic shock: PPV may ↓ afterload (beneficial)" },
            { q: "A trauma patient has HR 130, BP 80/60, RR 35, confused. Classify the hemorrhage and outline management.", a: "<b>Class IV hemorrhage</b> (&gt;40% blood volume loss):<br>• HR &gt;140, SBP severely decreased, altered mentation, negligible UO<br><b>Management:</b><br>1. <b>Activate MTP</b> (1:1:1)<br>2. <b>TXA 1g IV</b> (within 3 hours)<br>3. <b>Permissive hypotension</b> (SBP ~80–90 unless TBI)<br>4. <b>Damage control resuscitation</b><br>5. <b>Warm the patient</b> (prevent hypothermia)<br>6. <b>Replace calcium</b><br>7. <b>Emergent surgical hemorrhage control</b>" },
            { q: "A septic patient remains hypotensive after 30 mL/kg crystalloid and norepinephrine at 0.5 μg/kg/min. Next steps?", a: "1. <b>Add vasopressin 0.03 U/min</b><br>2. <b>Start hydrocortisone 50 mg IV q6h</b> (refractory shock)<br>3. <b>Re-check lactate</b> — assess trend<br>4. <b>Obtain POCUS</b> — assess cardiac function (septic cardiomyopathy?), IVC, rule out other pathology<br>5. Consider <b>dobutamine</b> if echo shows poor cardiac function (sepsis-induced myocardial dysfunction)<br>6. <b>Source control</b> — ensure adequate drainage of any abscess/infection<br>7. If still refractory: consider <b>epinephrine</b> or <b>angiotensin II</b>" },
            { q: "A patient with known asthma on mechanical ventilation suddenly becomes hypotensive. How do you approach this?", a: "Think <b>DOPES</b> mnemonic:<br>• <b>D</b>isplacement of ETT<br>• <b>O</b>bstruction of ETT (mucus plug)<br>• <b>P</b>neumothorax<br>• <b>E</b>quipment failure<br>• <b>S</b>tacking of breaths (auto-PEEP)<br><b>First step:</b> <b>Disconnect from ventilator</b> to relieve auto-PEEP. If no improvement, auscultate for tension PTX → needle decompression if present." },
            { q: "What mnemonic helps remember causes of <b>PEA (Pulseless Electrical Activity)</b> which presents as shock progressing to arrest?", a: "<b>H's and T's:</b><br><b>H's:</b><br>• <b>H</b>ypovolemia<br>• <b>H</b>ypoxia<br>• <b>H</b>ydrogen ion (acidosis)<br>• <b>H</b>ypo/hyperkalemia<br>• <b>H</b>ypothermia<br><b>T's:</b><br>• <b>T</b>ension pneumothorax<br>• <b>T</b>amponade (cardiac)<br>• <b>T</b>oxins<br>• <b>T</b>hrombosis (PE)<br>• <b>T</b>hrombosis (coronary/MI)" },
            { q: "What is the <b>SMART trial</b> and its significance for fluid choice?", a: "<b>SMART trial</b> (2018) — RCT of ~15,000 critically ill adults in the MICU:<br>Compared <b>balanced crystalloids (LR/Plasma-Lyte)</b> vs <b>normal saline</b>.<br><b>Result:</b> Balanced crystalloids reduced the composite of <b>death, new RRT, or persistent renal dysfunction</b> (14.3% vs 15.4%).<br><b>Impact:</b> Supports using balanced crystalloids as the <b>default resuscitation fluid</b> in critically ill patients." },
            { q: "What is the <b>PROPPR trial</b> and its recommendation?", a: "<b>PROPPR trial</b> (2015) — multicenter RCT in severely injured trauma patients:<br>Compared <b>1:1:1</b> (plasma:platelets:pRBC) vs <b>1:1:2</b> ratios.<br><b>Result:</b> 1:1:1 ratio achieved <b>better hemostasis</b> and trended toward ↓ 24-hour mortality (no significant difference at 30 days).<br><b>Recommendation:</b> Use <b>1:1:1 ratio</b> in massive transfusion protocols." },
            { q: "Summarize the <b>SOAP II trial</b> findings.", a: "<b>SOAP II trial</b> (2010) — RCT comparing <b>dopamine vs norepinephrine</b> as first-line vasopressor in shock:<br>• <b>No overall mortality difference</b><br>• Dopamine associated with <b>more arrhythmic events</b> (especially AF)<br>• Subgroup: Dopamine showed <b>↑ mortality in cardiogenic shock</b><br><b>Conclusion:</b> <b>Norepinephrine</b> is preferred first-line; dopamine should be avoided, especially in cardiogenic shock." }
          ]
        },
        {
          section: 'Emergency Medicine',
          topic: "Neurological emergencies — stroke protocol, status epilepticus",
          icon: "brain",
          cards: [
            { q: "What are the 3 components of the <b>Cincinnati Prehospital Stroke Scale (CPSS)</b>?", a: "<b>1.</b> <b>Facial droop</b> — ask patient to smile (unilateral droop = abnormal)<br><b>2.</b> <b>Arm drift</b> — hold arms out 10 sec with eyes closed (one arm drifts down = abnormal)<br><b>3.</b> <b>Speech</b> — repeat a sentence (slurred or incorrect words = abnormal)<br><br>Any <b>1 abnormal finding</b> → 72% probability of stroke." },
            { q: "What does <b>FAST</b> stand for in stroke screening?", a: "<b>F</b> — Face drooping<br><b>A</b> — Arm weakness<br><b>S</b> — Speech difficulty<br><b>T</b> — Time to call 911<br><br>A public awareness mnemonic to recognise stroke and act urgently." },
            { q: "How many categories does the <b>NIH Stroke Scale (NIHSS)</b> assess? List all 11.", a: "<b>11 categories:</b><br>1. Level of consciousness (LOC) — alertness<br>2. LOC questions (month, age)<br>3. LOC commands (open/close eyes, grip/release)<br>4. Best gaze (horizontal eye movements)<br>5. Visual fields<br>6. Facial palsy<br>7. Motor — arm (L &amp; R scored separately)<br>8. Motor — leg (L &amp; R scored separately)<br>9. Limb ataxia<br>10. Sensory<br>11. Best language (aphasia)<br>12. Dysarthria<br>13. Extinction/inattention (neglect)<br><br>Total score range: <b>0–42</b>." },
            { q: "What NIHSS score ranges correspond to <b>minor, moderate, moderate-severe, and severe</b> stroke?", a: "<b>0–4:</b> Minor stroke<br><b>5–15:</b> Moderate stroke<br><b>16–20:</b> Moderate-to-severe stroke<br><b>21–42:</b> Severe stroke<br><br>NIHSS ≥6 suggests <b>large-vessel occlusion (LVO)</b> and should prompt CTA." },
            { q: "What is the <b>primary purpose</b> of non-contrast CT head in acute stroke evaluation?", a: "To <b>rule out hemorrhage</b> (intracerebral or subarachnoid).<br><br>Ischemic stroke may appear <b>normal</b> on CT in the first 6–12 hours. Early signs include:<br>• Loss of grey-white differentiation<br>• Sulcal effacement<br>• Hyperdense vessel sign (clot in MCA)<br>• Insular ribbon sign" },
            { q: "What is the role of <b>CT angiography (CTA)</b> in acute ischemic stroke?", a: "To detect <b>large vessel occlusion (LVO)</b> of the anterior circulation (ICA, M1/M2 of MCA) that may be amenable to <b>mechanical thrombectomy</b>.<br><br>CTA should <b>not delay</b> tPA administration — it can be performed concurrently or immediately after." },
            { q: "What does <b>CT perfusion (CTP)</b> evaluate in acute stroke, and what are its two key zones?", a: "<b>CT perfusion</b> differentiates:<br>• <b>Core infarct</b> — irreversibly damaged tissue (↓ cerebral blood volume)<br>• <b>Ischemic penumbra</b> — hypoperfused but salvageable tissue (↓ cerebral blood flow, preserved CBV)<br><br>A large <b>mismatch</b> (penumbra ≫ core) favours intervention even in <b>extended time windows</b> (6–24 h)." },
            { q: "What is the dose and administration protocol for <b>alteplase (tPA)</b> in acute ischemic stroke?", a: "<b>Alteplase 0.9 mg/kg</b> (max <b>90 mg</b>):<br>• <b>10% as IV bolus</b> over 1 minute<br>• <b>Remaining 90% infused over 60 minutes</b><br><br>Must be given within <b>4.5 hours</b> of symptom onset (3 h in standard criteria, extended to 4.5 h with additional exclusions)." },
            { q: "What is <b>tenecteplase</b> and how does it differ from alteplase in stroke treatment?", a: "<b>Tenecteplase</b> is a modified tPA given as a <b>single IV bolus</b> (0.25 mg/kg, max 25 mg).<br><br><b>Advantages over alteplase:</b><br>• Single bolus — no 60-min infusion<br>• Higher fibrin specificity<br>• Easier to administer (especially pre-hospital or before transfer for thrombectomy)<br>• Non-inferior to alteplase in recent trials (AcT, TASTE)" },
            { q: "List <b>5 major inclusion criteria</b> for IV thrombolysis in ischemic stroke.", a: "<b>Inclusion criteria:</b><br>1. Clinical diagnosis of ischemic stroke with measurable neurological deficit<br>2. Symptom onset (or last known well) <b>&lt;4.5 hours</b><br>3. Age ≥18 years<br>4. CT head excluding hemorrhage<br>5. BP controllable to &lt;185/110 mmHg before treatment" },
            { q: "List <b>6 absolute exclusion criteria</b> for IV alteplase in acute ischemic stroke.", a: "<b>Absolute exclusions:</b><br>1. <b>Intracranial hemorrhage</b> on CT<br>2. <b>Active internal bleeding</b> (excluding menses)<br>3. <b>Platelet count &lt;100,000</b><br>4. <b>INR &gt;1.7</b> or PT &gt;15 s<br>5. Recent <b>intracranial/spinal surgery</b> within 3 months<br>6. <b>Ischemic stroke or serious head trauma</b> within 3 months<br><br>Additional for 3–4.5 h window: age &gt;80, NIHSS &gt;25, oral anticoagulant use, diabetes + prior stroke." },
            { q: "What are the <b>BP targets before, during, and after</b> IV tPA administration?", a: "<b>Before tPA:</b> Must be &lt;<b>185/110</b> mmHg<br><b>During &amp; for 24 h after tPA:</b> Maintain &lt;<b>180/105</b> mmHg<br><br>Agents: IV <b>labetalol</b> 10–20 mg, <b>nicardipine</b> infusion 5 mg/h (titrate up to 15 mg/h), or <b>clevidipine</b>." },
            { q: "What is <b>permissive hypertension</b> in acute ischemic stroke when tPA is <b>NOT</b> given?", a: "If thrombolysis is <b>not</b> administered, allow BP up to <b>&lt;220/120 mmHg</b> without treatment.<br><br><b>Rationale:</b> Elevated BP maintains perfusion to ischemic penumbra via collaterals. Aggressive lowering may worsen infarct." },
            { q: "What are the <b>criteria for mechanical thrombectomy</b> in acute ischemic stroke?", a: "<b>Standard criteria (AHA/ASA 2019):</b><br>• <b>Large vessel occlusion (LVO)</b> — ICA or MCA M1 (anterior circulation)<br>• <b>NIHSS ≥6</b><br>• <b>ASPECTS ≥6</b> (Alberta Stroke Program Early CT Score)<br>• Pre-stroke mRS 0–1<br>• Within <b>6 hours</b> of onset (standard) or up to <b>24 hours</b> with favourable perfusion imaging (DAWN/DEFUSE-3 criteria)<br>• Age ≥18" },
            { q: "What are the <b>DAWN</b> and <b>DEFUSE-3</b> trials and their significance?", a: "Both trials extended the <b>thrombectomy window to 16–24 hours</b> using advanced imaging:<br><br><b>DAWN:</b> 6–24 h, clinical-imaging mismatch (NIHSS vs core infarct volume)<br><b>DEFUSE-3:</b> 6–16 h, perfusion-core mismatch on CTP or MRI-DWI<br><br>Both showed significant benefit of thrombectomy over medical therapy alone in selected patients." },
            { q: "When can <b>antiplatelet therapy</b> be started after IV alteplase?", a: "<b>24 hours after tPA</b> administration.<br><br>A follow-up <b>CT head</b> must be obtained at 24 h (before starting antiplatelets) to rule out <b>hemorrhagic transformation</b>.<br><br>If tPA was NOT given: aspirin 325 mg within 24–48 h of stroke onset." },
            { q: "What is <b>hemorrhagic transformation</b> and when does it typically occur after tPA?", a: "<b>Hemorrhagic transformation</b> = bleeding into infarcted brain tissue.<br><br>• Occurs in ~<b>6.4%</b> of tPA-treated patients (symptomatic ICH)<br>• Risk factors: large infarct, hyperglycemia, elevated BP, advanced age, high NIHSS<br>• <b>Management:</b> Stop tPA, stat CT, cryoprecipitate (target fibrinogen &gt;200), tranexamic acid, neurosurgical consultation" },
            { q: "What is the <b>ASPECTS score</b> and how is it used?", a: "<b>Alberta Stroke Program Early CT Score:</b><br>• Evaluates <b>10 regions</b> of the MCA territory on non-contrast CT<br>• Score of <b>10</b> = normal; each region with early ischemic changes subtracts 1 point<br>• <b>ASPECTS ≥6:</b> favourable for thrombectomy<br>• <b>ASPECTS &lt;6:</b> large established infarct, lower benefit from intervention" },
            { q: "What is the <b>hyperdense MCA sign</b> on non-contrast CT?", a: "A <b>hyperdense (bright white) middle cerebral artery</b> on CT indicating acute <b>thrombus</b> within the vessel.<br><br>• Suggests <b>large vessel occlusion</b><br>• Present in ~30% of MCA strokes<br>• Should prompt urgent CTA and thrombectomy evaluation" },
            { q: "What are the <b>two main types</b> of hemorrhagic stroke?", a: "<b>1. Intracerebral hemorrhage (ICH)</b> — bleeding within brain parenchyma<br><b>2. Subarachnoid hemorrhage (SAH)</b> — bleeding into the subarachnoid space<br><br>ICH is more common (~10–15% of all strokes); SAH accounts for ~5% but has very high mortality." },
            { q: "What is the <b>ICH Score</b> and what components does it include?", a: "<b>ICH Score</b> predicts 30-day mortality (range 0–6):<br><br>• <b>GCS 3–4:</b> 2 pts; <b>GCS 5–12:</b> 1 pt; <b>GCS 13–15:</b> 0 pts<br>• <b>ICH volume ≥30 mL:</b> 1 pt<br>• <b>Intraventricular hemorrhage (IVH):</b> 1 pt<br>• <b>Infratentorial origin:</b> 1 pt<br>• <b>Age ≥80:</b> 1 pt<br><br>ICH Score 0 → ~0% mortality; Score 5 → ~100% mortality" },
            { q: "What is the <b>BP target</b> for acute intracerebral hemorrhage?", a: "Target <b>systolic BP &lt;140 mmHg</b> (per AHA/ASA and INTERACT2 trial).<br><br>• Initiate IV <b>nicardipine</b> or <b>clevidipine</b> infusion<br>• Rapid lowering to &lt;140 within <b>1 hour</b> is safe and may reduce hematoma expansion<br>• Avoid SBP &lt;110 mmHg (risk of renal injury)" },
            { q: "How do you <b>reverse anticoagulation</b> in ICH for a patient on <b>warfarin</b>?", a: "<b>Warfarin reversal:</b><br>• <b>4-factor PCC (prothrombin complex concentrate)</b> — 25–50 units/kg IV (preferred, rapid onset)<br>• <b>IV Vitamin K 10 mg</b> — slow infusion (takes 6–24 h for full effect)<br>• <b>Target INR ≤1.4</b> within 4 hours<br><br>FFP is <b>second-line</b> (slower, volume overload risk)." },
            { q: "How do you reverse <b>dabigatran</b> (direct thrombin inhibitor) in life-threatening hemorrhage?", a: "<b>Idarucizumab (Praxbind)</b> — <b>5 g IV</b> given as two 2.5 g boluses.<br><br>• <b>Specific monoclonal antibody fragment</b> that binds dabigatran<br>• Onset within <b>minutes</b><br>• If idarucizumab unavailable: 4-factor PCC 50 units/kg or activated PCC (FEIBA)" },
            { q: "How do you reverse <b>factor Xa inhibitors</b> (rivaroxaban, apixaban, edoxaban) in ICH?", a: "<b>Andexanet alfa (Andexxa)</b> — recombinant modified factor Xa decoy.<br><br>• <b>Low dose:</b> 400 mg bolus → 4 mg/min × 120 min (for apixaban, rivaroxaban taken &gt;7 h prior)<br>• <b>High dose:</b> 800 mg bolus → 8 mg/min × 120 min (rivaroxaban taken ≤7 h prior or dose unknown)<br><br>If unavailable: <b>4-factor PCC 50 units/kg</b>." },
            { q: "What are <b>indications for surgical evacuation</b> of intracerebral hemorrhage?", a: "<b>Surgical evacuation considered when:</b><br>• <b>Cerebellar hemorrhage &gt;3 cm</b> or with brainstem compression / hydrocephalus<br>• <b>Lobar hemorrhage &gt;30 mL</b> within 1 cm of cortical surface<br>• Neurological deterioration despite medical management<br>• Young patient with large hematoma and mass effect<br><br>Deep basal ganglia hemorrhages generally managed <b>medically</b>." },
            { q: "What is the <b>classic presentation</b> of subarachnoid hemorrhage (SAH)?", a: "<b>'Thunderclap headache'</b> — sudden-onset, maximal intensity at onset ('worst headache of my life').<br><br>Associated features:<br>• Nausea / vomiting<br>• Neck stiffness (meningismus)<br>• Photophobia<br>• Loss of consciousness (~50%)<br>• Sentinel headache (warning leak) in ~30% days–weeks prior" },
            { q: "What is the <b>Hunt-Hess grading scale</b> for SAH?", a: "<b>Hunt-Hess Grade:</b><br>• <b>I:</b> Asymptomatic or mild headache/nuchal rigidity<br>• <b>II:</b> Moderate-severe headache, nuchal rigidity, CN palsy (no focal deficit except CN)<br>• <b>III:</b> Drowsy, confused, mild focal deficit<br>• <b>IV:</b> Stuporous, moderate-severe hemiparesis, early decerebrate posturing<br>• <b>V:</b> Deep coma, decerebrate posturing, moribund<br><br>Higher grade → worse prognosis. Grade I–III generally treated with early intervention." },
            { q: "What is the <b>Fisher grade</b> for SAH and what does it predict?", a: "<b>Fisher Grade</b> (CT appearance, predicts <b>vasospasm</b> risk):<br>• <b>1:</b> No blood detected → low risk<br>• <b>2:</b> Diffuse thin SAH (&lt;1 mm) → low risk<br>• <b>3:</b> Localized clot or thick layer (&gt;1 mm) → <b>HIGH risk of vasospasm</b><br>• <b>4:</b> Intraventricular or intraparenchymal blood ± diffuse SAH → moderate risk<br><br><b>Modified Fisher</b> scale is now more commonly used." },
            { q: "If CT head is <b>negative</b> but clinical suspicion for SAH is high, what is the next step?", a: "<b>Lumbar puncture (LP)</b>:<br>• Collect CSF in sequential tubes<br>• Look for <b>xanthochromia</b> (yellow discoloration from bilirubin) — most reliable finding<br>• Elevated RBC count that does <b>NOT</b> clear between tube 1 → tube 4<br>• Elevated opening pressure<br><br>CT sensitivity: ~98% within 6 h, drops to ~90% at 24 h. LP fills the diagnostic gap." },
            { q: "What is <b>xanthochromia</b> and why is it important in SAH diagnosis?", a: "<b>Xanthochromia</b> = yellow discoloration of CSF supernatant caused by <b>oxyhemoglobin → bilirubin</b> degradation of RBCs.<br><br>• Takes <b>~6–12 hours</b> to develop after SAH<br>• Distinguishes true SAH from <b>traumatic tap</b> (which does NOT produce xanthochromia if LP done early)<br>• Best detected by <b>spectrophotometry</b>" },
            { q: "What medication is used for <b>vasospasm prophylaxis</b> in SAH and its dosing?", a: "<b>Nimodipine 60 mg PO/NG q4h × 21 days</b>.<br><br>• <b>Calcium channel blocker</b> — improves neurological outcomes (reduces vasospasm-related ischemia)<br>• Vasospasm typically occurs <b>days 3–14</b> after SAH (peak days 7–10)<br>• Nimodipine does NOT prevent angiographic vasospasm but improves functional outcomes" },
            { q: "What is the definitive treatment for a <b>ruptured cerebral aneurysm</b> causing SAH?", a: "<b>Two options:</b><br>1. <b>Endovascular coiling</b> — catheter-based deployment of platinum coils into the aneurysm (preferred for most posterior circulation aneurysms, elderly patients)<br>2. <b>Surgical clipping</b> — craniotomy with clip placement across aneurysm neck<br><br>ISAT trial: Coiling associated with better outcomes at 1 year for anterior circulation aneurysms." },
            { q: "What is the role of an <b>external ventricular drain (EVD)</b> in SAH?", a: "<b>EVD indications in SAH:</b><br>• Acute <b>hydrocephalus</b> (blood obstructing CSF drainage)<br>• Decreased level of consciousness from elevated ICP<br>• Allows CSF drainage and <b>ICP monitoring</b><br><br>Placed in the lateral ventricle via a frontal burr hole (Kocher's point)." },
            { q: "What is the <b>definition of status epilepticus (SE)</b>?", a: "<b>Status epilepticus:</b><br>• Continuous seizure lasting <b>≥5 minutes</b>, OR<br>• <b>≥2 seizures without return to baseline</b> consciousness between them<br><br>Older definition used 30 min cutoff, but treatment should begin at 5 min to prevent neuronal injury." },
            { q: "What is <b>refractory status epilepticus (RSE)</b>?", a: "Status epilepticus that <b>persists despite adequate doses of:</b><br>1. First-line benzodiazepine, AND<br>2. At least one second-line antiepileptic drug<br><br>Requires <b>ICU admission</b> and continuous IV anesthetic infusions (midazolam, propofol, or pentobarbital) with <b>continuous EEG monitoring</b>." },
            { q: "What is <b>super-refractory status epilepticus (SRSE)</b>?", a: "<b>SRSE</b> = status epilepticus that continues or recurs <b>≥24 hours after onset of anesthetic therapy</b>, including recurrence during weaning.<br><br>Management options include: ketamine, immunotherapy, hypothermia, ketogenic diet, electroconvulsive therapy, and neurosurgical intervention." },
            { q: "What is the <b>first-line treatment</b> for status epilepticus?", a: "<b>Benzodiazepines:</b><br>• <b>Lorazepam 0.1 mg/kg IV</b> (max <b>4 mg/dose</b>), may repeat once in 5–10 min<br>• <b>Midazolam 10 mg IM</b> if <b>no IV access</b> (RAMPART trial: IM midazolam non-inferior to IV lorazepam)<br>• <b>Diazepam 0.15 mg/kg IV</b> (max 10 mg), or rectal diazepam 0.2 mg/kg<br><br>Lorazepam preferred IV due to longer duration of action in the brain." },
            { q: "Why is <b>lorazepam</b> preferred over diazepam for IV treatment of status epilepticus?", a: "Lorazepam has a <b>longer duration of anticonvulsant action</b> (~12–24 h) compared to diazepam (~20 min for brain effect despite long serum half-life).<br><br>Diazepam is <b>highly lipophilic</b> → rapidly redistributes out of the brain → seizures recur more quickly.<br>Lorazepam is <b>less lipophilic</b> → stays in the brain longer." },
            { q: "What is <b>fosphenytoin</b> and its dosing in status epilepticus?", a: "<b>Fosphenytoin</b> — water-soluble prodrug of phenytoin.<br><br>• Dose: <b>20 mg PE/kg IV</b> (PE = phenytoin equivalents)<br>• Infusion rate: up to <b>150 mg PE/min</b> (vs 50 mg/min for phenytoin)<br>• Can give IM (phenytoin cannot)<br>• Monitor for <b>hypotension and cardiac arrhythmias</b> during infusion<br>• Requires cardiac monitoring" },
            { q: "What is <b>purple glove syndrome</b> and which AED is it associated with?", a: "<b>Purple glove syndrome</b> = limb edema, discoloration, and pain distal to the IV site.<br><br>• Caused by <b>IV phenytoin</b> extravasation (highly alkaline pH 12, contains propylene glycol)<br>• Can lead to tissue necrosis and compartment syndrome<br>• <b>Fosphenytoin</b> has a neutral pH → much lower risk → preferred" },
            { q: "Why should fosphenytoin/phenytoin be <b>avoided in patients with cardiac disease</b>?", a: "Phenytoin/fosphenytoin can cause:<br>• <b>Hypotension</b><br>• <b>Cardiac arrhythmias</b> (bradycardia, heart block, QT prolongation, ventricular fibrillation)<br>• Due to <b>sodium channel blockade</b> and propylene glycol (in phenytoin)<br><br>Avoid or use with extreme caution in patients with known <b>cardiac conduction abnormalities</b>. Consider levetiracetam or valproate instead." },
            { q: "What is the dose of <b>levetiracetam</b> in status epilepticus?", a: "<b>Levetiracetam (Keppra) 60 mg/kg IV</b> (max <b>4500 mg</b>), infused over 15 minutes.<br><br><b>Advantages:</b><br>• No cardiac toxicity<br>• No hepatic interactions<br>• No need for drug level monitoring<br>• Safe in liver disease<br><br><b>ESETT trial:</b> Levetiracetam, fosphenytoin, and valproate were equally effective as second-line agents." },
            { q: "What is the dose of <b>valproate (valproic acid)</b> in status epilepticus?", a: "<b>Valproate 40 mg/kg IV</b> (max 3000 mg), infused over 10 minutes.<br><br>• Broad-spectrum antiepileptic<br>• <b>Avoid in:</b> pregnancy (teratogenic), liver disease, mitochondrial disorders, pancreatitis<br>• Side effects: hepatotoxicity, thrombocytopenia, hyperammonemia<br>• Equivalent efficacy to fosphenytoin and levetiracetam (ESETT trial)" },
            { q: "What are the <b>third-line agents</b> for refractory status epilepticus?", a: "<b>Continuous IV infusions (ICU with EEG monitoring):</b><br>1. <b>Midazolam drip:</b> 0.2 mg/kg bolus → 0.1–2 mg/kg/h<br>2. <b>Propofol:</b> 1–2 mg/kg bolus → 20–65 µg/kg/min (watch for propofol infusion syndrome)<br>3. <b>Pentobarbital:</b> 5–15 mg/kg bolus → 0.5–5 mg/kg/h (most potent, most hypotension)<br>4. <b>Ketamine:</b> NMDA antagonist, used in super-refractory SE<br><br>Titrate to <b>burst suppression</b> on EEG." },
            { q: "What is <b>burst suppression</b> on EEG and why is it targeted in refractory SE?", a: "<b>Burst suppression</b> = EEG pattern of alternating high-voltage activity (bursts) and flat periods (suppression).<br><br>• Indicates profound CNS depression<br>• Targeted in refractory SE to confirm <b>seizure cessation</b><br>• Maintained for <b>24–48 hours</b> before slowly weaning anesthetics<br>• Continuous EEG monitoring is essential" },
            { q: "What is <b>propofol infusion syndrome (PRIS)</b>?", a: "<b>PRIS</b> — rare but fatal complication of prolonged propofol infusion (&gt;48 h or &gt;4 mg/kg/h).<br><br><b>Features:</b><br>• Metabolic acidosis (lactic acidosis)<br>• Rhabdomyolysis (↑CK)<br>• Hyperkalemia<br>• Cardiac failure / arrhythmias<br>• Renal failure<br>• Lipemia<br><br><b>Management:</b> Immediately discontinue propofol, supportive care." },
            { q: "Outline the <b>stepwise algorithm</b> for managing status epilepticus.", a: "<b>0–5 min:</b> ABCs, glucose check, IV access<br><b>5–10 min (1st line):</b> Lorazepam 0.1 mg/kg IV (or midazolam 10 mg IM)<br><b>10–20 min:</b> Repeat benzodiazepine if seizure continues<br><b>20–40 min (2nd line):</b> Fosphenytoin 20 mg PE/kg, levetiracetam 60 mg/kg, or valproate 40 mg/kg<br><b>40+ min (3rd line):</b> Intubation, continuous IV midazolam/propofol/pentobarbital + EEG monitoring" },
            { q: "What <b>lab studies</b> should be obtained in a patient with status epilepticus?", a: "<b>Essential labs:</b><br>• <b>Glucose</b> (hypoglycemia is reversible cause)<br>• BMP (sodium, calcium, magnesium — metabolic causes)<br>• CBC<br>• Hepatic panel<br>• Antiepileptic drug levels (if on AEDs)<br>• Toxicology screen<br>• ABG/VBG (acidosis assessment)<br>• Lactate<br>• Blood cultures (if infection suspected)" },
            { q: "What is the significance of the <b>RAMPART trial</b> in SE management?", a: "<b>RAMPART (2012):</b> Demonstrated that <b>IM midazolam 10 mg</b> was non-inferior (actually statistically superior) to <b>IV lorazepam 4 mg</b> for prehospital seizure termination.<br><br>Key finding: IM midazolam's faster <b>time to treatment</b> (no need for IV access) compensated for slower absorption, resulting in faster seizure cessation." },
            { q: "What is the significance of the <b>ESETT trial</b> in SE management?", a: "<b>ESETT (Established Status Epilepticus Treatment Trial, 2019):</b><br><br>Compared <b>fosphenytoin, levetiracetam, and valproate</b> as second-line agents after benzodiazepine failure.<br><br><b>Result:</b> All three were <b>equally effective</b> (~45–50% seizure cessation at 60 min).<br>→ Choice based on patient factors (cardiac history, liver disease, pregnancy)." },
            { q: "What is the <b>Monro-Kellie doctrine</b>?", a: "The skull is a <b>fixed, rigid compartment</b> containing three components:<br>1. <b>Brain parenchyma</b> (~80%)<br>2. <b>Blood</b> (~10%)<br>3. <b>CSF</b> (~10%)<br><br>An increase in any one component must be compensated by a decrease in another, otherwise <b>ICP rises</b>. Compensatory mechanisms: CSF displacement → venous blood compression → eventual decompensation." },
            { q: "What is <b>Cushing's triad</b> and what does it indicate?", a: "<b>Cushing's triad</b> — a late sign of <b>critically elevated ICP</b> with impending herniation:<br><br>1. <b>Hypertension</b> (widened pulse pressure)<br>2. <b>Bradycardia</b> (reflex vagal response)<br>3. <b>Irregular respirations</b> (Cheyne-Stokes, ataxic breathing)<br><br>Represents <b>brainstem compression</b> — requires emergent intervention." },
            { q: "What are the <b>signs and symptoms of increased ICP</b>?", a: "<b>Symptoms:</b> Headache (worse supine/morning), nausea/vomiting, visual changes, altered mental status<br><br><b>Signs:</b><br>• <b>Papilledema</b> (optic disc swelling)<br>• <b>CN VI palsy</b> (false localizing sign — long intracranial course)<br>• Cushing's triad (late)<br>• Altered consciousness → coma<br>• <b>Pupil changes</b> (unilateral dilation = ipsilateral uncal herniation)" },
            { q: "Describe <b>uncal herniation</b> — mechanism, signs, and management.", a: "<b>Uncal herniation</b> — medial temporal lobe (uncus) herniates through the tentorial notch.<br><br><b>Classic triad:</b><br>1. <b>Ipsilateral CN III palsy</b> — fixed, dilated pupil ('blown pupil')<br>2. <b>Contralateral hemiparesis</b> (compression of ipsilateral cerebral peduncle)<br>3. Decreased consciousness (reticular activating system compression)<br><br><b>Kernohan's notch:</b> Ipsilateral hemiparesis (false localizing) from contralateral peduncle compression against tentorial edge." },
            { q: "Describe <b>central (transtentorial) herniation</b>.", a: "<b>Central herniation</b> — bilateral downward displacement of cerebral hemispheres through the tentorial notch.<br><br><b>Progression:</b><br>• Bilateral small reactive pupils → bilateral fixed dilated pupils<br>• <b>Bilateral posturing</b> (decorticate → decerebrate)<br>• Progressive loss of brainstem reflexes (rostral to caudal)<br>• Loss of consciousness → coma<br>• Cheyne-Stokes → ataxic breathing → apnea" },
            { q: "Describe <b>tonsillar herniation</b> and its consequences.", a: "<b>Tonsillar herniation</b> — cerebellar tonsils herniate through the <b>foramen magnum</b>.<br><br>• Compresses the <b>medulla oblongata</b><br>• Causes <b>cardiorespiratory arrest</b> (compression of respiratory and cardiovascular centres)<br>• <b>Most lethal</b> herniation syndrome<br>• Often seen with posterior fossa masses<br>• Risk with LP in setting of elevated ICP (contraindication to LP)" },
            { q: "What is the <b>medical management of elevated ICP</b>?", a: "<b>Acute management:</b><br>1. <b>Head of bed elevation 30°</b> (midline position, no jugular vein compression)<br>2. <b>Osmotic therapy:</b><br>&nbsp;&nbsp;• Mannitol 1–1.5 g/kg IV bolus (20% solution)<br>&nbsp;&nbsp;• Hypertonic saline: 3% NaCl infusion or <b>23.4% NaCl 30 mL</b> via central line<br>3. <b>Hyperventilation:</b> Target PCO₂ <b>30–35 mmHg</b> (short-term <b>bridge</b> only — causes cerebral vasoconstriction)<br>4. Sedation, analgesia, fever control<br>5. <b>EVD placement</b> for CSF drainage" },
            { q: "Compare <b>mannitol</b> vs <b>hypertonic saline</b> for ICP management.", a: "<table><tr><th>Feature</th><th>Mannitol</th><th>Hypertonic Saline</th></tr><tr><td>Mechanism</td><td>Osmotic diuresis</td><td>Osmotic gradient without diuresis</td></tr><tr><td>Dose</td><td>1–1.5 g/kg IV</td><td>3% 250–500 mL or 23.4% 30 mL</td></tr><tr><td>Onset</td><td>15–30 min</td><td>Minutes</td></tr><tr><td>Concern</td><td>Hypotension (diuresis)</td><td>Central pontine myelinolysis (rapid Na shift)</td></tr><tr><td>Advantage</td><td>Peripheral IV OK</td><td>No hypotension, better in hypovolemia</td></tr><tr><td>Monitoring</td><td>Serum osmolality &lt;320</td><td>Serum Na &lt;160</td></tr></table>" },
            { q: "Why is <b>hyperventilation</b> only a <b>temporary bridge</b> measure for elevated ICP?", a: "Hyperventilation → ↓PCO₂ → <b>cerebral vasoconstriction</b> → ↓cerebral blood volume → ↓ICP.<br><br><b>Limitation:</b><br>• Effect lasts only <b>a few hours</b> (CSF buffering compensates)<br>• Prolonged use → <b>cerebral ischemia</b> from excessive vasoconstriction<br>• Target: PCO₂ <b>30–35 mmHg</b> (never &lt;25)<br>• Use as bridge to definitive treatment (surgery, EVD, osmotherapy)" },
            { q: "What is the purpose of an <b>EVD (External Ventricular Drain)</b> in ICP management?", a: "<b>EVD placement:</b><br>• Allows <b>direct CSF drainage</b> to reduce ICP<br>• Provides <b>continuous ICP monitoring</b><br>• Placed through a burr hole at <b>Kocher's point</b> (mid-pupillary line, 1 cm anterior to coronal suture) into the lateral ventricle<br>• Most accurate method of ICP measurement<br>• Normal ICP: <b>5–15 mmHg</b>; treat if &gt;20–22 mmHg" },
            { q: "What is the <b>classic triad</b> of bacterial meningitis?", a: "<b>Classic triad</b> (only ~44% of patients have all three):<br>1. <b>Fever</b><br>2. <b>Neck stiffness</b> (nuchal rigidity)<br>3. <b>Altered mental status</b><br><br>Other findings: headache, photophobia, seizures, petechial rash (<i>N. meningitidis</i>). Almost all patients have ≥2 of: headache, fever, stiffness, AMS." },
            { q: "Describe <b>Kernig's sign</b> and <b>Brudzinski's sign</b>.", a: "<b>Kernig's sign:</b> Patient supine → flex hip to 90° → attempt to extend the knee → <b>pain/resistance</b> in the hamstrings = positive (meningeal irritation).<br><br><b>Brudzinski's sign:</b> Patient supine → passive neck flexion → <b>involuntary hip/knee flexion</b> = positive.<br><br>Both have <b>low sensitivity</b> (~5%) but <b>high specificity</b> (~95%) for meningitis." },
            { q: "What is the <b>empiric antibiotic therapy</b> for bacterial meningitis by <b>age group</b>?", a: "<b>Neonates (0–28 days):</b> Ampicillin + gentamicin (or cefotaxime)<br><br><b>Infants/Children (1 mo–18 yr):</b> Vancomycin + ceftriaxone (cover <i>S. pneumoniae, N. meningitidis, H. influenzae</i>)<br><br><b>Adults (18–50 yr):</b> Vancomycin + ceftriaxone<br><br><b>Adults &gt;50 yr / immunocompromised:</b> Vancomycin + ceftriaxone + <b>ampicillin</b> (for <i>Listeria monocytogenes</i>)" },
            { q: "Compare <b>CSF findings</b> in bacterial, viral, fungal/TB meningitis.", a: "<table><tr><th>Parameter</th><th>Bacterial</th><th>Viral</th><th>Fungal/TB</th></tr><tr><td>Opening pressure</td><td><b>↑↑ (&gt;25)</b></td><td>Normal/↑</td><td>↑↑</td></tr><tr><td>WBC</td><td><b>&gt;1000</b></td><td>10–500</td><td>10–500</td></tr><tr><td>Predominant cell</td><td><b>Neutrophils</b></td><td>Lymphocytes</td><td>Lymphocytes</td></tr><tr><td>Glucose</td><td><b>↓↓ (&lt;40)</b></td><td>Normal</td><td>↓</td></tr><tr><td>Protein</td><td><b>↑↑ (&gt;250)</b></td><td>Mildly ↑</td><td>↑↑</td></tr><tr><td>Gram stain</td><td>Positive 60–90%</td><td>Negative</td><td>Special stains (India ink, AFB)</td></tr></table>" },
            { q: "When should <b>dexamethasone</b> be given in bacterial meningitis?", a: "<b>Dexamethasone 0.15 mg/kg IV q6h × 4 days</b><br><br>• Give <b>before or with the first dose</b> of antibiotics (NOT after)<br>• Greatest benefit in <b><i>S. pneumoniae</i></b> meningitis<br>• Reduces <b>hearing loss</b> and mortality in pneumococcal meningitis<br>• Mechanism: reduces inflammatory cascade from bacterial lysis<br>• Discontinue if non-pneumococcal etiology confirmed" },
            { q: "What is <b>HSV encephalitis</b> and what is its characteristic imaging finding?", a: "<b>HSV-1 encephalitis</b> — most common sporadic fatal encephalitis.<br><br><b>Presentation:</b> Fever, altered mental status, focal neurological deficits, seizures, personality changes<br><br><b>Imaging:</b> MRI shows <b>temporal lobe</b> involvement (hyperintense on T2/FLAIR), often with hemorrhagic component — <b>bilateral but asymmetric</b><br><br><b>CSF:</b> Lymphocytic pleocytosis, ↑protein, normal glucose, RBCs (hemorrhagic necrosis), PCR for HSV DNA" },
            { q: "What is the treatment for <b>HSV encephalitis</b>?", a: "<b>IV acyclovir 10 mg/kg q8h × 14–21 days</b><br><br>• Must be started <b>empirically</b> whenever HSV encephalitis is suspected (don't wait for PCR results)<br>• Reduces mortality from ~70% to ~20%<br>• Adequate hydration essential (acyclovir can cause <b>crystalline nephropathy</b>)<br>• Duration: minimum 14 days; 21 days in immunocompromised" },
            { q: "What is the order of priorities when meningitis is suspected: <b>CT vs LP vs antibiotics</b>?", a: "<b>If CT is NOT needed before LP:</b><br>→ Blood cultures → LP → Antibiotics + dexamethasone immediately<br><br><b>If CT is needed before LP</b> (indications: immunocompromised, new seizure, papilledema, focal deficits, altered consciousness):<br>→ Blood cultures → <b>Antibiotics + dexamethasone FIRST</b> → CT → LP<br><br><b>Never delay antibiotics</b> for imaging or LP!" },
            { q: "What is <b>myasthenia gravis (MG)</b> and what is its pathophysiology?", a: "<b>Myasthenia gravis</b> — autoimmune disorder with antibodies against <b>postsynaptic acetylcholine receptors (AChR)</b> at the neuromuscular junction.<br><br>• <b>Fatigable weakness</b> — worsens with repetitive use, improves with rest<br>• Ocular symptoms most common initial presentation (ptosis, diplopia)<br>• Associated with <b>thymoma</b> (10–15%)<br>• Anti-AChR antibodies positive in ~85%; anti-MuSK in seronegative cases" },
            { q: "What is <b>myasthenic crisis</b> and how does it differ from <b>cholinergic crisis</b>?", a: "<b>Myasthenic crisis:</b> Acute exacerbation of MG with <b>respiratory failure</b> (weakness of diaphragm/intercostal muscles). Triggered by infection, surgery, medications, non-compliance.<br><br><b>Cholinergic crisis:</b> Excessive <b>acetylcholinesterase inhibitor</b> (pyridostigmine) → too much ACh → <b>SLUDGE/DUMBELS</b> (salivation, lacrimation, urination, diarrhea, emesis, bradycardia) + weakness.<br><br><b>Key distinguisher:</b> Edrophonium (Tensilon) test — <b>improves</b> myasthenic crisis, <b>worsens</b> cholinergic crisis." },
            { q: "What is the <b>edrophonium (Tensilon) test</b>?", a: "<b>Edrophonium</b> — short-acting acetylcholinesterase inhibitor (onset 30 s, duration 5 min).<br><br>• IV dose: <b>2 mg test dose → 8 mg if no adverse reaction</b><br>• <b>Positive:</b> Rapid improvement in weakness = myasthenic crisis<br>• <b>Negative/worsening:</b> Cholinergic crisis<br>• Have <b>atropine</b> at bedside for cholinergic side effects (bradycardia)<br>• Largely replaced by ice pack test and serologic testing" },
            { q: "What is the <b>respiratory monitoring threshold for intubation</b> in myasthenic crisis?", a: "<b>Indications for intubation (20/30/40 rule):</b><br>• <b>FVC &lt;20 mL/kg</b> (or &lt;1 L) — most important<br>• <b>NIF (negative inspiratory force) &gt; −30 cmH₂O</b> (less negative = weaker)<br>• <b>MEP &lt;40 cmH₂O</b><br><br>Serial measurements q2–4h are critical. Don't rely on ABGs — respiratory failure occurs suddenly." },
            { q: "What are the <b>acute treatments</b> for myasthenic crisis?", a: "<b>1. IVIG</b> — 0.4 g/kg/day × 5 days (or 1 g/kg/day × 2 days)<br><b>2. Plasmapheresis (PLEX)</b> — 5 exchanges over 7–14 days<br><br>Both are equally effective; choice depends on availability and patient factors:<br>• IVIG: easier access, risk of anaphylaxis in IgA deficiency, renal failure<br>• PLEX: faster onset, requires large-bore access, hypotension risk<br><br>Hold <b>cholinesterase inhibitors</b> during crisis (may worsen secretions)." },
            { q: "What <b>medications should be AVOIDED</b> in myasthenia gravis?", a: "<b>Medications that exacerbate MG:</b><br>• <b>Aminoglycosides</b> (and fluoroquinolones, macrolides)<br>• <b>Beta-blockers</b><br>• <b>Magnesium</b><br>• <b>Calcium channel blockers</b> (especially verapamil)<br>• <b>Neuromuscular blocking agents</b> (prolonged effect)<br>• <b>D-penicillamine</b><br>• <b>Botulinum toxin</b><br>• Phenytoin, lithium, procainamide<br><br>Always check drug interactions before prescribing in MG patients." },
            { q: "What is <b>Guillain-Barré syndrome (GBS)</b> and what is its typical presentation?", a: "<b>GBS</b> — acute inflammatory demyelinating polyradiculoneuropathy (AIDP, most common subtype).<br><br><b>Classic presentation:</b><br>• <b>Ascending symmetric weakness</b> (starts in legs → arms → respiratory muscles)<br>• <b>Areflexia/hyporeflexia</b><br>• May have sensory symptoms (paresthesias) but motor predominant<br>• Often preceded by GI illness (<i>Campylobacter jejuni</i>) or URI 1–4 weeks prior<br>• Progression over days to 4 weeks" },
            { q: "What is <b>albuminocytologic dissociation</b> in CSF and what does it indicate?", a: "<b>Albuminocytologic dissociation</b> = <b>elevated CSF protein with normal WBC count</b>.<br><br>• Classic CSF finding in <b>Guillain-Barré syndrome</b><br>• Protein often 100–1000 mg/dL (normal &lt;45)<br>• WBC &lt;10 cells/µL<br>• May be <b>normal in first week</b> of illness (sensitivity increases after week 1)<br>• If WBC &gt;50 → consider alternative diagnosis (HIV, Lyme, CMV)" },
            { q: "What are the <b>nerve conduction study (NCS)</b> findings in GBS?", a: "<b>AIDP (demyelinating) subtype:</b><br>• <b>Prolonged distal latencies</b><br>• <b>Slowed conduction velocities</b><br>• <b>Conduction block</b><br>• <b>Prolonged or absent F-waves</b><br>• Temporal dispersion<br><br><b>AMAN (axonal) subtype:</b><br>• Reduced CMAP amplitudes with preserved conduction velocities<br><br>NCS may be <b>normal early</b> in disease; repeat in 1–2 weeks if initially normal." },
            { q: "What are the <b>treatments for GBS</b>?", a: "<b>1. IVIG</b> — 0.4 g/kg/day × 5 days (preferred first-line, easier to administer)<br><b>2. Plasmapheresis (PLEX)</b> — 5 exchanges over 7–14 days<br><br>• Both equally effective; <b>do NOT combine</b> (no added benefit)<br>• Start within <b>2 weeks of symptom onset</b> for maximal benefit<br>• <b>Corticosteroids are NOT effective</b> in GBS (unlike CIDP)<br>• Supportive care: DVT prophylaxis, pain management, autonomic monitoring" },
            { q: "What <b>respiratory parameters</b> should be monitored in GBS and when to intubate?", a: "<b>Monitor FVC and NIF serially (q4–6h):</b><br><br><b>Intubation criteria:</b><br>• <b>FVC &lt;20 mL/kg</b> (or &lt;1 L, or &gt;30% decline from baseline)<br>• <b>NIF &gt; −30 cmH₂O</b> (less negative = weaker)<br>• <b>MEP &lt;40 cmH₂O</b><br>• Bulbar dysfunction (inability to swallow, aspiration risk)<br><br>~30% of GBS patients require mechanical ventilation." },
            { q: "What are <b>autonomic complications</b> of GBS?", a: "<b>Autonomic dysfunction</b> occurs in ~70% of GBS patients:<br><br>• <b>Cardiac:</b> Tachycardia/bradycardia, arrhythmias (may need temporary pacing), asystole<br>• <b>Blood pressure:</b> Labile BP — hypertension alternating with hypotension<br>• <b>GI:</b> Ileus, urinary retention<br>• <b>Skin:</b> Anhidrosis or excessive sweating<br><br>Autonomic instability is a leading cause of <b>death</b> in GBS. Continuous cardiac monitoring required." },
            { q: "What are the <b>red flags</b> for acute spinal cord compression?", a: "<b>Red flags:</b><br>• <b>Bilateral motor weakness</b> (especially ascending)<br>• <b>Sensory level</b> (dermatomal level below which sensation is lost)<br>• <b>Bowel/bladder dysfunction</b> (retention &gt; incontinence early)<br>• <b>Saddle anesthesia</b><br>• <b>Back pain</b> with progressive neurological deficit<br>• History of <b>cancer</b> (metastatic disease)<br>• <b>Bilateral Babinski signs</b> / hyperreflexia below the lesion" },
            { q: "What is the <b>most important imaging study</b> for suspected spinal cord compression?", a: "<b>MRI of the entire spine</b> — <b>emergent</b> (within hours).<br><br>• <b>Gold standard</b> for spinal cord compression<br>• Images cord, disc, epidural space, vertebral bodies<br>• Contrast (gadolinium) helps identify tumour vs abscess<br>• Must image the <b>entire spine</b> (multiple levels may be involved in metastatic disease)<br>• If MRI contraindicated: CT myelography" },
            { q: "What is the role of <b>dexamethasone</b> in acute spinal cord compression?", a: "<b>Dexamethasone</b> — given for <b>malignant spinal cord compression</b>:<br><br>• <b>10 mg IV bolus</b> followed by <b>4 mg IV/PO q6h</b><br>• Reduces <b>vasogenic edema</b> around the tumour<br>• Should be given <b>immediately</b> upon clinical suspicion (don't wait for MRI)<br>• May also temporarily improve neurological function<br><br>Note: Role in <b>traumatic</b> cord injury is controversial — no longer routinely recommended (NASCIS trials criticized)." },
            { q: "When is <b>surgical decompression</b> indicated for spinal cord compression?", a: "<b>Urgent/emergent surgical decompression if:</b><br>• Rapidly progressive neurological deficit<br>• Cauda equina syndrome (bowel/bladder dysfunction)<br>• Structural instability<br>• Failure to improve with medical management<br>• Epidural abscess (also requires antibiotics)<br><br><b>Timing:</b> Ideally within <b>24–48 hours</b> of symptom onset for best outcomes. Earlier = better prognosis (especially if deficit &lt;48 h)." },
            { q: "What is <b>cauda equina syndrome</b> and how does it differ from cord compression?", a: "<b>Cauda equina syndrome (CES)</b> — compression of nerve roots below the <b>conus medullaris (L1–L2)</b>.<br><br><b>Features (LMN pattern):</b><br>• <b>Saddle anesthesia</b> (perineal numbness)<br>• <b>Urinary retention</b> → overflow incontinence<br>• Decreased rectal tone<br>• Bilateral sciatica<br>• <b>Areflexia</b> (LMN, not UMN)<br><br>Unlike cord compression (UMN signs: hyperreflexia, Babinski, spasticity), CES causes <b>flaccid weakness and hyporeflexia</b>." },
            { q: "What are the <b>common causes</b> of ischemic stroke?", a: "<b>Major etiologies (TOAST classification):</b><br>1. <b>Large artery atherosclerosis</b> — carotid stenosis, intracranial atherosclerosis<br>2. <b>Cardioembolism</b> — atrial fibrillation (most common), valvular disease, mural thrombus<br>3. <b>Small vessel occlusion</b> — lacunar infarcts (HTN, DM)<br>4. <b>Other determined</b> — dissection, vasculitis, hypercoagulable states, sickle cell<br>5. <b>Cryptogenic</b> — unknown despite workup" },
            { q: "What is a <b>stroke mimic</b> and what are the most common causes?", a: "<b>Stroke mimics</b> = conditions that present with acute focal neurological deficits but are NOT true strokes.<br><br><b>Common mimics:</b><br>• <b>Seizure</b> with Todd's paralysis<br>• <b>Hypoglycemia</b><br>• <b>Migraine with aura</b> (hemiplegic migraine)<br>• Conversion disorder / functional neurological disorder<br>• Brain tumour (mass effect)<br>• Hypertensive encephalopathy<br>• Peripheral vertigo (vs posterior stroke)<br><br>Always check <b>glucose</b> before tPA." },
            { q: "What are <b>posterior circulation stroke</b> symptoms that may be easily missed?", a: "<b>Posterior circulation (vertebrobasilar) strokes are frequently missed:</b><br><br>• <b>Vertigo, nystagmus, ataxia</b> (cerebellar stroke)<br>• <b>Diplopia</b> (brainstem — CN III, IV, VI)<br>• <b>Dysarthria, dysphagia</b><br>• <b>Crossed findings</b> — ipsilateral cranial nerve + contralateral motor/sensory (brainstem localization)<br>• <b>Wallenberg syndrome</b> (lateral medullary) — vertigo, Horner's, ipsilateral facial pain, contralateral body pain/temp loss<br>• May have <b>normal CT</b>; MRI/DWI is superior for posterior fossa" },
            { q: "What is the <b>ABCD² score</b> and what does it predict?", a: "<b>ABCD² score</b> — predicts stroke risk after TIA (range 0–7):<br><br>• <b>A</b>ge ≥60: 1 pt<br>• <b>B</b>P ≥140/90: 1 pt<br>• <b>C</b>linical features: unilateral weakness (2 pts), speech disturbance without weakness (1 pt)<br>• <b>D</b>uration: ≥60 min (2 pts), 10–59 min (1 pt)<br>• <b>D</b>iabetes: 1 pt<br><br>Score ≥4 = high risk (8% 2-day stroke risk) → urgent workup and admission." },
            { q: "What antihypertensive agents are recommended for <b>acute BP lowering</b> in stroke?", a: "<b>IV agents for acute stroke BP management:</b><br><br>• <b>Labetalol:</b> 10–20 mg IV push q10–20 min (max 300 mg); combined α/β blocker<br>• <b>Nicardipine:</b> 5 mg/h infusion, titrate by 2.5 mg/h q5–15 min (max 15 mg/h); dihydropyridine CCB<br>• <b>Clevidipine:</b> 1–2 mg/h infusion, titrate q90 sec (max 32 mg/h); ultra-short-acting CCB<br>• <b>Hydralazine:</b> 10–20 mg IV (less predictable, avoid in ↑ICP)" },
            { q: "What is the significance of <b>glucose management</b> in acute stroke?", a: "<b>Hyperglycemia</b> (>180 mg/dL) is associated with worse stroke outcomes:<br>• Worsens ischemic injury (lactic acidosis, free radical production)<br>• Increases hemorrhagic transformation risk after tPA<br><br><b>Hypoglycemia</b> can mimic stroke — ALWAYS check glucose before tPA.<br><br><b>Target:</b> 140–180 mg/dL; use insulin if needed. Avoid hypoglycemia (&lt;60)." },
            { q: "What is a <b>'wake-up' stroke</b> and how is it managed?", a: "A stroke discovered upon <b>awakening</b> — time of onset is unknown.<br><br>• <b>'Last known well'</b> time = when the patient was last seen normal (e.g., bedtime)<br>• If last known well is &gt;4.5 h: IV tPA generally excluded (standard criteria)<br>• <b>WAKE-UP trial:</b> MRI-based selection (DWI-FLAIR mismatch) identified patients who benefited from tPA despite unknown onset<br>• <b>Thrombectomy:</b> Can still be considered up to 24 h with favourable perfusion imaging (DAWN/DEFUSE-3)" },
            { q: "What is <b>decompressive hemicraniectomy</b> and when is it indicated?", a: "<b>Decompressive hemicraniectomy</b> = surgical removal of a large bone flap to allow swelling brain to expand outward.<br><br><b>Indications:</b><br>• <b>Malignant MCA territory infarction</b> (>50% MCA territory)<br>• <b>Age &lt;60</b> (strongest evidence)<br>• Within <b>48 hours</b> of symptom onset<br>• Clinical deterioration despite medical ICP management<br><br>Trials (DECIMAL, DESTINY, HAMLET): Reduces mortality from ~78% to ~29%, but many survivors have moderate-severe disability." },
            { q: "What is <b>cerebral venous sinus thrombosis (CVST)</b> and how is it managed?", a: "<b>CVST</b> — thrombosis of cerebral venous sinuses (sagittal, transverse, sigmoid).<br><br><b>Risk factors:</b> OCP, pregnancy, prothrombotic states, infection, dehydration<br><b>Presentation:</b> Severe headache, papilledema, seizures, focal deficits, altered mental status<br><b>Diagnosis:</b> CT/MR venography<br><b>Treatment:</b> <b>Anticoagulation with heparin</b> (even if hemorrhagic infarction present), treat ICP, AEDs for seizures" },
            { q: "What is the <b>most common cause</b> of spontaneous SAH?", a: "<b>Ruptured saccular (berry) aneurysm</b> — accounts for ~85% of non-traumatic SAH.<br><br><b>Common locations:</b><br>• Anterior communicating artery (AcomA) — most common (~30%)<br>• Posterior communicating artery (PcomA) — ~25%<br>• MCA bifurcation — ~20%<br><br><b>Risk factors:</b> Smoking, HTN, family history, ADPKD, Ehlers-Danlos, female sex, heavy alcohol use." },
            { q: "What are the <b>complications of SAH</b> (beyond initial hemorrhage)?", a: "<b>SAH complications (days):</b><br>• <b>Rebleeding</b> (highest risk in first 24 h → early aneurysm treatment)<br>• <b>Vasospasm</b> (days 3–14, peak 7–10) → delayed cerebral ischemia<br>• <b>Hydrocephalus</b> (acute or chronic, blood blocking CSF absorption)<br>• <b>Hyponatremia</b> (SIADH or cerebral salt wasting)<br>• <b>Seizures</b><br>• <b>Cardiac dysfunction</b> (neurogenic stunned myocardium, Takotsubo-like)" },
            { q: "What is <b>delayed cerebral ischemia (DCI)</b> in SAH and how is it managed?", a: "<b>DCI</b> — neurological deterioration occurring days 4–14 after SAH, primarily due to <b>vasospasm</b>.<br><br><b>Diagnosis:</b><br>• Clinical deterioration (new focal deficit, decreased consciousness)<br>• Transcranial Doppler (↑flow velocities)<br>• CT angiography / conventional angiography<br><br><b>Management:</b><br>• <b>Nimodipine</b> prophylaxis (prevention)<br>• <b>Hemodynamic augmentation</b> — IV fluids, induced hypertension (vasopressors)<br>• <b>Endovascular intervention</b> — intra-arterial vasodilators, balloon angioplasty" },
            { q: "What is <b>cerebral salt wasting</b> vs <b>SIADH</b> in the setting of SAH?", a: "<table><tr><th>Feature</th><th>Cerebral Salt Wasting</th><th>SIADH</th></tr><tr><td>Volume status</td><td><b>Hypovolemic</b></td><td><b>Euvolemic/hypervolemic</b></td></tr><tr><td>Urine output</td><td>High</td><td>Low/normal</td></tr><tr><td>Urine Na</td><td>High (&gt;40)</td><td>High (&gt;40)</td></tr><tr><td>Serum Na</td><td>Low</td><td>Low</td></tr><tr><td>Treatment</td><td>Volume replacement (NS/HTS)</td><td>Fluid restriction</td></tr></table><br>Distinction is critical: fluid restriction in CSW → <b>dangerous hypovolemia → vasospasm</b>." },
            { q: "What are <b>common seizure triggers and reversible causes</b> to evaluate in SE?", a: "<b>Reversible causes (mnemonic: AEIOU TIPS):</b><br>• <b>A</b>lcohol withdrawal<br>• <b>E</b>lectrolyte abnormalities (Na, Ca, Mg, glucose)<br>• <b>I</b>nfection (meningitis, encephalitis, abscess)<br>• <b>O</b>verdose/withdrawal (benzodiazepines, barbiturates, baclofen)<br>• <b>U</b>remia<br>• <b>T</b>rauma / tumour<br>• <b>I</b>schemia (stroke)<br>• <b>P</b>sychiatric (PNES — pseudoseizures)<br>• <b>S</b>ubtherapeutic AED levels / non-compliance" },
            { q: "What are the <b>complications of prolonged seizures</b>?", a: "<b>Systemic complications of SE:</b><br>• <b>Rhabdomyolysis</b> → acute kidney injury, hyperkalemia<br>• <b>Lactic acidosis</b><br>• <b>Hyperthermia</b><br>• <b>Aspiration pneumonia</b><br>• <b>Neurogenic pulmonary edema</b><br>• <b>Cardiac arrhythmias</b><br>• <b>Permanent neuronal injury</b> (excitotoxicity — glutamate mediated)<br>• <b>DIC</b><br>• <b>Cerebral edema</b><br><br>Neuronal death begins after ~<b>30 minutes</b> of continuous seizure activity." },
            { q: "What is <b>nonconvulsive status epilepticus (NCSE)</b>?", a: "<b>NCSE</b> = ongoing seizure activity on EEG <b>without overt motor manifestations</b>.<br><br><b>Clues:</b><br>• Unexplained altered mental status / coma<br>• Subtle findings: eye deviation, nystagmus, eyelid fluttering, lip smacking<br>• Post-convulsive patient who doesn't 'wake up'<br><br><b>Diagnosis:</b> Requires <b>continuous EEG (cEEG) monitoring</b><br><br>Occurs in ~<b>48%</b> of patients after convulsive SE is treated — always get cEEG after treating SE." },
            { q: "What is <b>Wernicke encephalopathy</b> and why must it be considered in SE?", a: "<b>Wernicke encephalopathy</b> — acute <b>thiamine (B1) deficiency</b>.<br><br><b>Classic triad:</b><br>1. <b>Confusion/altered mental status</b><br>2. <b>Oculomotor dysfunction</b> (nystagmus, ophthalmoplegia, CN VI palsy)<br>3. <b>Ataxia</b><br><br><b>Relevance to SE:</b> Always give <b>thiamine 100 mg IV BEFORE glucose</b> in alcoholic or malnourished patients to prevent precipitation of Wernicke's.<br><br>Treatment: <b>Thiamine 500 mg IV TID × 3 days</b>." },
            { q: "What is the role of <b>continuous EEG monitoring</b> in the ICU?", a: "<b>Indications for continuous EEG (cEEG):</b><br>• After treating convulsive SE (detect NCSE)<br>• Unexplained altered mental status / coma<br>• Refractory SE — titrate anesthetic drips to burst suppression<br>• Post-cardiac arrest (detect seizures, prognostication)<br>• TBI with altered consciousness<br><br><b>Duration:</b> Minimum <b>24–48 hours</b> of monitoring recommended; longer if seizures detected." },
            { q: "What structures are supplied by the <b>anterior circulation</b> vs <b>posterior circulation</b>?", a: "<b>Anterior circulation</b> (ICA → ACA + MCA):<br>• Frontal, parietal, temporal lobes (lateral), basal ganglia, internal capsule<br>• Motor/sensory cortex, Broca's/Wernicke's areas<br><br><b>Posterior circulation</b> (vertebral → basilar → PCA):<br>• Occipital lobe (vision), thalamus, brainstem, cerebellum<br>• CN nuclei, reticular activating system<br><br>Thrombectomy is primarily indicated for <b>anterior circulation LVO</b> (ICA, M1 MCA). Posterior circulation thrombectomy: emerging evidence." },
            { q: "What is the <b>MCA syndrome</b> (middle cerebral artery stroke)?", a: "<b>MCA stroke</b> — most common ischemic stroke territory.<br><br><b>Dominant hemisphere (usually left):</b><br>• Contralateral face/arm > leg weakness and sensory loss<br>• <b>Broca's aphasia</b> (superior division) or <b>Wernicke's aphasia</b> (inferior division) or global aphasia<br><br><b>Non-dominant hemisphere (usually right):</b><br>• Contralateral face/arm > leg weakness<br>• <b>Hemispatial neglect</b> (ignores left side)<br>• Anosognosia<br><br>Both: contralateral homonymous hemianopia, gaze deviation toward the lesion." },
            { q: "What is the difference between <b>UMN</b> and <b>LMN</b> signs in neurological emergencies?", a: "<table><tr><th>Feature</th><th>UMN (Upper Motor Neuron)</th><th>LMN (Lower Motor Neuron)</th></tr><tr><td>Tone</td><td>↑ Spasticity</td><td>↓ Flaccidity</td></tr><tr><td>Reflexes</td><td>↑ Hyperreflexia</td><td>↓ Hyporeflexia/areflexia</td></tr><tr><td>Babinski</td><td>Positive (upgoing toe)</td><td>Negative (downgoing)</td></tr><tr><td>Atrophy</td><td>Minimal/late (disuse)</td><td>Prominent/early</td></tr><tr><td>Fasciculations</td><td>Absent</td><td>Present</td></tr><tr><td>Distribution</td><td>Pyramidal (extensors in UE, flexors in LE)</td><td>Segmental/dermatomal</td></tr></table>" },
            { q: "What is the <b>Glasgow Coma Scale (GCS)</b> and its components?", a: "<b>GCS (range 3–15):</b><br><br><b>Eye Opening (E, 1–4):</b><br>4-Spontaneous, 3-To voice, 2-To pain, 1-None<br><br><b>Verbal Response (V, 1–5):</b><br>5-Oriented, 4-Confused, 3-Inappropriate words, 2-Incomprehensible sounds, 1-None<br><br><b>Motor Response (M, 1–6):</b><br>6-Obeys commands, 5-Localizes pain, 4-Withdrawal, 3-Abnormal flexion (decorticate), 2-Extension (decerebrate), 1-None<br><br><b>Intubation threshold:</b> GCS ≤8 → intubate for airway protection." },
            { q: "What is the difference between <b>decorticate</b> and <b>decerebrate</b> posturing?", a: "<b>Decorticate posturing</b> (abnormal flexion):<br>• Arms flexed/adducted, legs extended<br>• Lesion above the <b>red nucleus</b> (cortex or internal capsule)<br>• 'Arms toward the COR(e)/heart'<br><br><b>Decerebrate posturing</b> (extension):<br>• Arms extended/internally rotated, legs extended<br>• Lesion at or below the <b>red nucleus</b> (midbrain/pons)<br>• Worse prognosis than decorticate<br><br>Progression: decorticate → decerebrate → flaccid = worsening." },
            { q: "What are the common <b>organisms causing bacterial meningitis by age</b>?", a: "<b>Neonates (0–28 d):</b> <i>Group B Streptococcus</i>, <i>E. coli</i>, <i>Listeria</i><br><br><b>1 month–2 years:</b> <i>S. pneumoniae</i>, <i>N. meningitidis</i>, <i>H. influenzae</i> (if unvaccinated)<br><br><b>2–50 years:</b> <i>S. pneumoniae</i> (most common), <i>N. meningitidis</i><br><br><b>&gt;50 years / immunocompromised:</b> <i>S. pneumoniae</i>, <i>N. meningitidis</i>, <i>Listeria monocytogenes</i> (ampicillin coverage needed)" },
            { q: "What is <b>Waterhouse-Friderichsen syndrome</b>?", a: "<b>Waterhouse-Friderichsen syndrome</b> = <b>bilateral adrenal hemorrhage</b> leading to acute adrenal insufficiency.<br><br>• Associated with <b><i>Neisseria meningitidis</i></b> (meningococcemia)<br>• Presents with: purpura fulminans, DIC, shock, cardiovascular collapse<br>• Mortality is very high even with treatment<br>• Management: aggressive resuscitation, antibiotics, <b>stress-dose steroids</b> (hydrocortisone 100 mg IV)" },
            { q: "What are the <b>indications for CT before LP</b> in suspected meningitis?", a: "<b>CT before LP if any of the following:</b><br>• <b>Immunocompromised</b> (HIV, transplant, immunosuppressive therapy)<br>• <b>History of CNS disease</b> (mass, stroke, focal infection)<br>• <b>New-onset seizure</b> (within 1 week)<br>• <b>Papilledema</b><br>• <b>Abnormal level of consciousness</b><br>• <b>Focal neurological deficit</b><br><br>If any present → blood cultures + empiric antibiotics → CT → LP. <b>Do NOT delay antibiotics for CT.</b>" },
            { q: "What is <b>Miller Fisher syndrome</b>?", a: "<b>Miller Fisher syndrome</b> — GBS variant characterized by:<br><br>1. <b>Ophthalmoplegia</b> (CN III, IV, VI palsies)<br>2. <b>Ataxia</b> (cerebellar-like)<br>3. <b>Areflexia</b><br><br>• Anti-<b>GQ1b antibodies</b> (positive in &gt;90%)<br>• Often follows respiratory/GI infection<br>• CSF: albuminocytologic dissociation<br>• Generally good prognosis — most recover fully<br>• Treatment: IVIG or plasmapheresis if severe; supportive care often sufficient" },
            { q: "What are the indications for <b>anticoagulation</b> after cardioembolic stroke?", a: "<b>Anticoagulation for secondary prevention:</b><br>• Indicated for <b>cardioembolic sources</b> (atrial fibrillation, mechanical valves, LV thrombus)<br>• <b>Timing:</b> Generally start 4–14 days after stroke onset (depends on infarct size)<br>• Small infarct → start in 1–3 days<br>• Moderate → 5–7 days<br>• Large → 14 days (risk of hemorrhagic transformation)<br>• <b>DOACs</b> preferred over warfarin for non-valvular AF (apixaban, rivaroxaban, etc.)" },
            { q: "What is the <b>blood glucose threshold</b> that is an exclusion for IV tPA?", a: "<b>Glucose &lt;50 mg/dL (2.7 mmol/L)</b> is an exclusion for IV tPA.<br><br>• Hypoglycemia is a common <b>stroke mimic</b><br>• Must correct glucose and reassess deficits before considering tPA<br>• If deficits resolve with glucose correction → not a stroke, tPA not needed<br>• <b>Always check glucose</b> before giving tPA — it is the ONLY lab required before initiating treatment" },
            { q: "What is the <b>door-to-needle time</b> goal for IV tPA?", a: "<b>Door-to-needle time goal: ≤60 minutes</b> (ideally &lt;45 min).<br><br>• <b>'Time is brain'</b> — 1.9 million neurons die per minute during ischemia<br>• Key to achieving this: pre-notification, rapid triage, CT availability, pre-mixed tPA, stroke team activation<br>• <b>Door-to-groin puncture</b> for thrombectomy: ≤90 minutes" },
            { q: "What is the <b>only lab test</b> required before administering IV tPA?", a: "<b>Blood glucose</b> is the only lab that MUST result before giving tPA.<br><br>• Other labs (CBC, coagulation, BMP) should be drawn but do <b>NOT need to result</b> before tPA unless:<br>&nbsp;&nbsp;- Known to be on anticoagulants (check INR/PTT)<br>&nbsp;&nbsp;- Known thrombocytopenia (check platelets)<br>&nbsp;&nbsp;- Clinical suspicion of bleeding disorder<br><br>This ensures no unnecessary delays." },
            { q: "What is the <b>ICH volume estimation</b> using the <b>ABC/2 method</b>?", a: "<b>ABC/2 (simplified ellipsoid) method:</b><br><br>On CT:<br>• <b>A</b> = largest diameter of hemorrhage on the slice with most blood (cm)<br>• <b>B</b> = diameter perpendicular to A on the same slice (cm)<br>• <b>C</b> = number of CT slices with blood × slice thickness (cm)<br>• <b>Volume ≈ (A × B × C) / 2</b> in mL<br><br>Volume ≥30 mL associated with worse outcomes (used in ICH Score)." },
            { q: "What is a <b>sentinel headache</b> in the context of SAH?", a: "<b>Sentinel headache</b> = a sudden, severe headache occurring <b>days to weeks before</b> a major SAH.<br><br>• Represents a <b>'warning leak'</b> from the aneurysm<br>• Occurs in ~30–50% of SAH patients<br>• Often dismissed as migraine or tension headache<br>• <b>Key teaching point:</b> Any sudden-onset thunderclap headache needs SAH evaluation, even if it improves" },
            { q: "What is the <b>Ottawa SAH Rule</b>?", a: "<b>Ottawa SAH Rule</b> — clinical decision tool to determine which patients with acute headache need investigation for SAH:<br><br>Investigate if ≥1:<br>• Age ≥40<br>• Neck pain or stiffness<br>• Witnessed loss of consciousness<br>• Onset during exertion<br>• Thunderclap headache (peak intensity immediately)<br>• Limited neck flexion on exam<br><br><b>100% sensitivity</b> (rules out SAH if all negative). Does not apply if GCS &lt;15, focal deficits, or prior aneurysm/SAH." },
            { q: "What is <b>Brown-Séquard syndrome</b>?", a: "<b>Brown-Séquard syndrome</b> — hemisection of the spinal cord.<br><br><b>Ipsilateral:</b><br>• <b>Motor paralysis</b> (corticospinal tract)<br>• <b>Loss of vibration/proprioception</b> (dorsal columns)<br><br><b>Contralateral:</b><br>• <b>Loss of pain/temperature</b> (spinothalamic tract — crosses 1–2 levels above entry)<br><br>Causes: penetrating trauma (stab wound), tumour, disc herniation, MS<br>Best prognosis of all incomplete cord syndromes." },
            { q: "What is <b>anterior cord syndrome</b>?", a: "<b>Anterior cord syndrome</b> — infarction/compression of the anterior 2/3 of the spinal cord.<br><br><b>Affected:</b><br>• <b>Bilateral motor paralysis</b> (corticospinal tracts)<br>• <b>Bilateral loss of pain/temperature</b> (spinothalamic tracts)<br><br><b>Preserved:</b><br>• <b>Proprioception, vibration, light touch</b> (dorsal columns = posterior 1/3)<br><br>Causes: anterior spinal artery occlusion, disc herniation, aortic surgery complication<br><b>Worst prognosis</b> of incomplete cord syndromes." },
            { q: "What is <b>central cord syndrome</b>?", a: "<b>Central cord syndrome</b> — most common incomplete cord injury.<br><br><b>Pattern:</b> Upper extremity weakness <b>greater than</b> lower extremity weakness (due to somatotopic organization — arms are medial in corticospinal tract).<br><br>• Sensory loss variable (sacral sparing may occur)<br>• Bladder dysfunction common<br>• Classic cause: <b>hyperextension injury in elderly with pre-existing cervical spondylosis</b><br>• Prognosis: better than anterior cord syndrome; legs recover first, then bladder, then arms, then hands (last)." },
            { q: "What is <b>neurogenic shock</b> vs <b>spinal shock</b>?", a: "<b>Neurogenic shock:</b><br>• Disruption of <b>sympathetic outflow</b> from cord injury (above T6)<br>• <b>Hypotension + bradycardia</b> + warm/dry skin (loss of vasomotor tone)<br>• Treatment: fluids + vasopressors (norepinephrine, phenylephrine)<br><br><b>Spinal shock:</b><br>• Temporary <b>loss of all neurological function</b> below the level of injury<br>• <b>Areflexia, flaccidity, loss of sensation</b><br>• Resolves in days–weeks (return of bulbocavernosus reflex = end of spinal shock)<br>• NOT a circulatory problem" },
            { q: "What is the <b>'spot sign'</b> on CT angiography in ICH?", a: "<b>Spot sign</b> = contrast extravasation within the hematoma on CTA.<br><br>• Indicates <b>active bleeding</b> / ongoing hematoma expansion<br>• Predicts: larger final hematoma volume, higher mortality, worse functional outcome<br>• May identify patients who benefit from aggressive hemostatic therapies<br>• Present in ~30% of ICH patients scanned within 6 hours" },
            { q: "What is <b>tranexamic acid (TXA)</b> and its role in ICH?", a: "<b>Tranexamic acid</b> — antifibrinolytic that inhibits plasminogen → plasmin conversion.<br><br><b>In ICH:</b><br>• TICH-2 trial: TXA 1 g IV bolus + 1 g over 8 h<br>• Reduced early hematoma growth but did NOT improve 90-day functional outcomes<br>• Not routinely recommended for spontaneous ICH<br><br><b>In hemorrhagic transformation after tPA:</b><br>• May be considered as adjunct with cryoprecipitate for fibrinolytic-associated ICH" },
            { q: "What are the <b>EEG patterns</b> associated with <b>status epilepticus</b>?", a: "<b>SE on EEG:</b><br>• <b>Generalized spike-and-wave</b> or <b>polyspike-and-wave</b> (generalized SE)<br>• <b>Lateralized periodic discharges (LPDs)</b> — formerly PLEDs; associated with focal SE<br>• <b>Generalized periodic discharges (GPDs)</b> — associated with NCSE<br>• <b>Electrographic seizures</b> — evolving rhythmic activity (frequency evolution, amplitude evolution, spatial evolution)<br>• <b>Burst suppression</b> — targeted pattern during treatment of refractory SE" },
            { q: "What is the <b>Salzburg criteria</b> for diagnosing NCSE on EEG?", a: "<b>Salzburg criteria for NCSE:</b><br><br>Epileptiform discharges &gt;2.5 Hz, OR<br>Epileptiform discharges ≤2.5 Hz or rhythmic delta/theta with ONE of:<br>• <b>EEG and clinical improvement</b> after IV AED<br>• <b>Subtle clinical ictal phenomena</b> temporally correlated to EEG changes<br>• <b>Spatial/frequency evolution</b><br><br>These criteria help standardize NCSE diagnosis, which historically had variable definitions." },
            { q: "What is the recommended <b>target temperature</b> for fever management in neurological emergencies?", a: "<b>Maintain normothermia (36–37.5°C / 96.8–99.5°F)</b> in all acute neurological emergencies.<br><br>• Fever worsens neurological injury (↑ metabolic demand, excitotoxicity, BBB disruption)<br>• <b>Aggressive fever control:</b> Acetaminophen, cooling blankets, intravascular cooling catheters<br>• In SE: fever may be caused by the seizure itself or underlying infection<br>• In stroke: each 1°C rise in temperature is associated with worse outcomes" },
            { q: "What is <b>Listeria meningitis</b> and who is at risk?", a: "<b><i>Listeria monocytogenes</i></b> — gram-positive rod causing meningitis in:<br>• Age <b>&gt;50 years</b><br>• <b>Immunocompromised</b> (transplant, steroids, HIV, chemo)<br>• <b>Pregnant</b> women<br>• <b>Neonates</b><br>• Alcoholics<br><br><b>Key:</b> Resistant to <b>cephalosporins</b> → must add <b>ampicillin</b> to empiric regimen<br>CSF may show <b>monocyte</b> predominance (or mixed). Blood cultures often positive." },
            { q: "What is the significance of <b>opening pressure</b> on LP in meningitis?", a: "<b>Opening pressure (OP)</b> measured in lateral decubitus position:<br><br>• <b>Normal:</b> 6–20 cmH₂O<br>• <b>Bacterial meningitis:</b> Usually <b>&gt;25 cmH₂O</b> (often 20–50+)<br>• <b>Viral meningitis:</b> Normal or mildly elevated<br>• <b>Fungal (Cryptococcal):</b> Very elevated (may need serial LPs or VP shunt)<br><br>Elevated OP + clinical picture helps differentiate bacterial from viral before culture results." },
            { q: "What are the <b>key differences</b> between <b>epidural abscess</b> and <b>spinal cord compression from tumor</b>?", a: "<b>Epidural abscess:</b><br>• <b>Fever</b> + back pain + neurological deficit<br>• Risk factors: IVDU, recent procedure, diabetes, immunosuppression<br>• <b>Organism:</b> <i>Staph aureus</i> (most common), including MRSA<br>• <b>Treatment:</b> IV antibiotics + urgent surgical drainage<br><br><b>Metastatic compression:</b><br>• Back pain + progressive deficit ± known cancer<br>• No fever typically<br>• <b>Treatment:</b> Dexamethasone + radiation ± surgery<br><br>Both require <b>emergent MRI</b>." },
            { q: "What is the <b>most common location</b> for hypertensive intracerebral hemorrhage?", a: "<b>Basal ganglia / putamen</b> (~35–50% of hypertensive ICH).<br><br><b>Other locations:</b><br>• <b>Thalamus</b> (~15%)<br>• <b>Pons</b> (~10%)<br>• <b>Cerebellum</b> (~10%)<br>• <b>Lobar</b> (~20% — more common in elderly, consider amyloid angiopathy)<br><br>Hypertensive ICH results from <b>Charcot-Bouchard microaneurysm</b> rupture in penetrating arteries (lenticulostriate)." },
            { q: "What are the <b>clinical features</b> of <b>cerebellar hemorrhage</b> and why is it a surgical emergency?", a: "<b>Cerebellar hemorrhage presentation:</b><br>• Sudden occipital headache, vomiting, ataxia/vertigo<br>• <b>Cannot walk</b> (truncal ataxia)<br>• May rapidly deteriorate (posterior fossa = confined space)<br><br><b>Surgical emergency if:</b><br>• Hematoma <b>&gt;3 cm</b> diameter<br>• <b>Brainstem compression</b> (obstructive hydrocephalus, decreased consciousness)<br>• <b>Suboccipital craniectomy</b> with hematoma evacuation<br>• <b>EVD</b> for acute hydrocephalus<br><br>Delay → tonsillar herniation → death." },
            { q: "What is <b>cerebral perfusion pressure (CPP)</b> and its target?", a: "<b>CPP = MAP − ICP</b><br>(Mean Arterial Pressure − Intracranial Pressure)<br><br>• <b>Target CPP: 60–70 mmHg</b><br>• CPP &lt;50 mmHg → cerebral ischemia<br>• CPP &gt;70 mmHg → may worsen edema (ARDS risk with vasopressors)<br><br>Optimize CPP by:<br>1. Treating elevated ICP (osmotherapy, EVD, surgery)<br>2. Maintaining adequate MAP (fluids, vasopressors if needed)" },
            { q: "What are <b>early vs late seizures</b> after stroke?", a: "<b>Early seizures:</b> Within <b>7 days</b> of stroke<br>• More common with hemorrhagic stroke and cortical involvement<br>• Do not necessarily require long-term AEDs (treat acutely, reassess)<br><br><b>Late seizures:</b> &gt;7 days after stroke<br>• Represent post-stroke epilepsy<br>• Require long-term AED therapy<br>• Risk: ~5% in ischemic stroke, ~10–15% in hemorrhagic stroke<br><br><b>Prophylactic AEDs</b> are NOT recommended in stroke." },
            { q: "What is the <b>role of dual antiplatelet therapy (DAPT)</b> in acute minor stroke/TIA?", a: "<b>DAPT (aspirin + clopidogrel)</b> for <b>minor ischemic stroke (NIHSS ≤3) or high-risk TIA:</b><br><br>• <b>CHANCE/POINT trials:</b> Start within 24 h, continue for <b>21 days</b> (then aspirin monotherapy)<br>• Reduces 90-day stroke recurrence vs aspirin alone<br>• <b>Increased bleeding risk</b> beyond 21 days (do NOT continue DAPT long-term)<br>• <b>Loading:</b> Aspirin 325 mg + clopidogrel 300–600 mg on day 1" },
            { q: "What are the <b>autonomic features</b> to monitor in GBS?", a: "<b>Autonomic dysfunction in GBS:</b><br>• <b>Labile blood pressure</b> — monitor for hypertensive surges and orthostatic hypotension<br>• <b>Heart rate abnormalities</b> — sinus tachycardia (most common), bradycardia (may need pacing), asystole<br>• <b>Urinary retention</b><br>• <b>Gastroparesis / ileus</b><br>• <b>Temperature dysregulation</b><br><br>Autonomic instability is most dangerous in the <b>first 2–4 weeks</b> and is a leading cause of mortality." },
            { q: "What is the <b>Hughes Disability Scale</b> for GBS?", a: "<b>Hughes (GBS Disability) Scale:</b><br>• <b>0:</b> Normal<br>• <b>1:</b> Minor symptoms, able to run<br>• <b>2:</b> Able to walk ≥10 m without assistance but unable to run<br>• <b>3:</b> Able to walk ≥10 m with assistance (walker/cane)<br>• <b>4:</b> Bed-bound or chair-bound<br>• <b>5:</b> Requiring assisted ventilation<br>• <b>6:</b> Death<br><br>Used to assess disease severity and response to treatment." },
            { q: "What are the <b>contraindications to LP</b>?", a: "<b>Absolute contraindications:</b><br>• <b>Signs of raised ICP</b> with mass effect (risk of herniation)<br>• <b>Skin infection</b> at the puncture site<br>• <b>Spinal epidural abscess</b> at the puncture level<br><br><b>Relative contraindications:</b><br>• <b>Coagulopathy</b> (INR &gt;1.4, platelets &lt;50,000)<br>• <b>Anticoagulant use</b> (hold or reverse first)<br>• <b>Thrombocytopenia</b><br><br>If LP contraindicated but meningitis suspected → <b>empiric antibiotics immediately</b>." },
            { q: "What is the <b>Cushing reflex</b> mechanism?", a: "<b>Cushing reflex</b> — physiological response to <b>critically elevated ICP:</b><br><br>1. ↑ICP → ↓cerebral perfusion → <b>brainstem ischemia</b><br>2. Medullary vasomotor centers trigger <b>massive sympathetic discharge</b> → <b>systemic hypertension</b> (to overcome ICP and perfuse the brain)<br>3. <b>Baroreceptor-mediated vagal response</b> → <b>reflex bradycardia</b><br>4. <b>Brainstem respiratory center</b> dysfunction → <b>irregular breathing</b><br><br>= <b>Cushing's triad</b> (hypertension + bradycardia + irregular respirations)" },
            { q: "What is the <b>initial evaluation and management</b> of a first-time seizure in the ED?", a: "<b>First-time seizure evaluation:</b><br><br><b>Labs:</b> Glucose, BMP (Na, Ca, Mg), CBC, toxicology screen, AED levels if applicable, lactate, pregnancy test<br><br><b>Imaging:</b> CT head (rule out structural cause) — MRI if available/indicated<br><br><b>EEG:</b> Not emergent for first single seizure; arrange outpatient<br><br><b>LP:</b> If fever, immunocompromised, or meningitis suspected<br><br><b>AED initiation:</b> Not mandatory after single unprovoked seizure (~40% recurrence risk); consider based on EEG, imaging, risk factors" },
            { q: "What is <b>Todd's paralysis</b>?", a: "<b>Todd's paralysis (postictal paralysis)</b> — transient <b>focal neurological deficit</b> (usually hemiparesis) following a seizure.<br><br>• Duration: minutes to <b>24–48 hours</b> (usually resolves &lt;24 h)<br>• Important <b>stroke mimic</b><br>• Corresponds to the brain region involved in the seizure<br>• If deficit persists &gt;24 h → strongly consider stroke (and pursue imaging)<br>• History of witnessed seizure is key to differentiation" },
            { q: "What are the <b>types of cerebral herniation syndromes</b>?", a: "<b>Herniation syndromes:</b><br><br>1. <b>Uncal (transtentorial lateral):</b> Ipsilateral CN III palsy, contralateral hemiparesis<br>2. <b>Central (transtentorial):</b> Bilateral posturing, bilateral pupil changes<br>3. <b>Tonsillar:</b> Cerebellar tonsils through foramen magnum → cardiorespiratory arrest<br>4. <b>Subfalcine (cingulate):</b> Under falx cerebri → ACA compression → contralateral leg weakness<br>5. <b>Upward (ascending):</b> Posterior fossa mass herniates upward through tentorial notch<br>6. <b>External:</b> Through skull defect (post-surgical)" },
            { q: "What is <b>subfalcine herniation</b> and what artery is at risk?", a: "<b>Subfalcine (cingulate) herniation</b> — cingulate gyrus herniates under the <b>falx cerebri</b> to the opposite side.<br><br>• Most common type of herniation<br>• Compresses the <b>anterior cerebral artery (ACA)</b> → <b>contralateral leg weakness</b><br>• Imaging: midline shift on CT<br>• May progress to uncal or central herniation<br>• Often seen with large frontal/parietal mass lesions" },
            { q: "What is the role of <b>ketamine</b> in super-refractory status epilepticus?", a: "<b>Ketamine</b> — NMDA receptor antagonist.<br><br><b>Rationale in SRSE:</b><br>• As SE progresses, GABA receptors are <b>internalized</b> (benzodiazepines/barbiturates become less effective)<br>• Simultaneously, <b>NMDA receptors are trafficked to the surface</b><br>• Ketamine targets these upregulated NMDA receptors<br><br><b>Dosing:</b> 1.5–4.5 mg/kg bolus → 1–10 mg/kg/h infusion<br>• Does NOT cause hypotension (sympathomimetic)<br>• Emerging evidence supports early use in SE" },
            { q: "What is the <b>most common cause of death</b> in GBS?", a: "<b>Autonomic dysfunction</b> (primarily cardiac arrhythmias — bradycardia, asystole) and <b>respiratory failure</b>.<br><br>• Mortality: ~3–7% even with treatment<br>• ~20% of patients have long-term disability<br>• Predictors of poor outcome: age &gt;60, rapid onset, preceding <i>C. jejuni</i> infection, need for mechanical ventilation, axonal subtype on NCS" },
            { q: "What is the role of <b>MRI DWI-FLAIR mismatch</b> in acute stroke?", a: "<b>DWI-FLAIR mismatch</b> on MRI:<br>• <b>DWI positive</b> (restricted diffusion = acute ischemia) but <b>FLAIR negative</b> (no signal change yet)<br>• Suggests the stroke occurred within <b>&lt;4.5 hours</b><br>• Useful in <b>wake-up strokes</b> or unknown time of onset<br>• <b>WAKE-UP trial:</b> Patients with DWI-FLAIR mismatch who received tPA had better outcomes than placebo<br>• Acts as a <b>'tissue clock'</b> instead of a wall clock" },
            { q: "What is <b>heparin-induced thrombocytopenia (HIT)</b> and its relevance to neurological emergencies?", a: "<b>HIT</b> — immune-mediated platelet activation caused by heparin → thrombocytopenia + paradoxical <b>thrombosis</b>.<br><br><b>Relevance:</b><br>• CVST patients on heparin may develop HIT → worse thrombosis<br>• Post-surgical neurology patients on DVT prophylaxis<br>• <b>Diagnosis:</b> 4T score, anti-PF4 antibodies, SRA<br>• <b>Treatment:</b> Stop ALL heparin, start <b>argatroban</b> or <b>bivalirudin</b> (direct thrombin inhibitors)<br>• Do NOT give warfarin until platelets recover (risk of venous limb gangrene)" },
            { q: "What are the <b>differences between AIDP and AMAN</b> subtypes of GBS?", a: "<table><tr><th>Feature</th><th>AIDP</th><th>AMAN</th></tr><tr><td>Pathology</td><td>Demyelinating</td><td>Axonal</td></tr><tr><td>Geography</td><td>Western countries (most common)</td><td>Asia, South America</td></tr><tr><td>NCS</td><td>↓ conduction velocity, ↑ distal latency</td><td>↓ CMAP amplitude, normal velocity</td></tr><tr><td>Association</td><td>Various infections</td><td><i>C. jejuni</i> (strong association)</td></tr><tr><td>Prognosis</td><td>Generally good</td><td>Can be rapid recovery or poor (depends on severity)</td></tr><tr><td>Antibodies</td><td>Variable</td><td>Anti-GM1, anti-GD1a</td></tr></table>" },
            { q: "What is the <b>Modified Fisher Scale</b> for SAH?", a: "<b>Modified Fisher Scale (predicts vasospasm risk):</b><br><br>• <b>Grade 0:</b> No SAH or IVH → 0% vasospasm<br>• <b>Grade 1:</b> Thin SAH, no IVH → 24% vasospasm<br>• <b>Grade 2:</b> Thin SAH with IVH → 33% vasospasm<br>• <b>Grade 3:</b> Thick SAH, no IVH → 33% vasospasm<br>• <b>Grade 4:</b> Thick SAH with IVH → <b>40% vasospasm</b><br><br>More accurate than original Fisher scale for predicting delayed cerebral ischemia." },
            { q: "What is <b>'triple H therapy'</b> and is it still recommended for SAH vasospasm?", a: "<b>Triple H therapy:</b> <b>H</b>ypertension + <b>H</b>ypervolemia + <b>H</b>emodilution<br><br>• Previously standard for treating vasospasm/DCI in SAH<br>• <b>Current practice:</b> Only <b>induced hypertension</b> is supported (with vasopressors after aneurysm secured)<br>• <b>Hypervolemia and hemodilution abandoned</b> — no proven benefit, risk of pulmonary edema and dilutional anemia<br>• <b>Euvolemia</b> is now maintained (avoid hypovolemia)" },
            { q: "What is the <b>time course</b> of SAH complications?", a: "<b>Timeline of SAH complications:</b><br><br>• <b>Day 0:</b> Initial hemorrhage, acute hydrocephalus, rebleeding risk highest<br>• <b>Days 1–3:</b> Rebleeding (4% day 1, then ~1.5%/day for first 2 weeks) → secure aneurysm early<br>• <b>Days 3–14:</b> <b>Vasospasm</b> (peak days 7–10) → delayed cerebral ischemia<br>• <b>Days 4–10:</b> Hyponatremia (SIADH or CSW)<br>• <b>Weeks–months:</b> Chronic hydrocephalus (communicating, may need VP shunt)" },
            { q: "What is <b>posterior reversible encephalopathy syndrome (PRES)</b>?", a: "<b>PRES</b> — clinical-radiographic syndrome characterized by:<br><br><b>Presentation:</b> Headache, visual disturbance (cortical blindness), seizures, altered mental status<br><br><b>Causes:</b> Hypertensive emergency, eclampsia, immunosuppressive drugs (cyclosporine, tacrolimus), renal failure<br><br><b>Imaging:</b> MRI shows vasogenic edema in <b>posterior (parieto-occipital)</b> white matter bilaterally<br><br><b>Treatment:</b> Treat underlying cause (BP control, remove offending drug). Usually <b>reversible</b>." },
            { q: "What is the <b>emergent management sequence</b> for a patient presenting with suspected acute ischemic stroke?", a: "<b>Acute stroke protocol:</b><br><br>1. <b>ABCs</b>, IV access, cardiac monitoring, O₂ if SpO₂ &lt;94%<br>2. <b>Finger-stick glucose</b> — treat hypoglycemia<br>3. <b>NIHSS</b> assessment<br>4. <b>Non-contrast CT head</b> (rule out hemorrhage) — door to CT &lt;25 min<br>5. <b>CTA</b> (if NIHSS ≥6, assess for LVO/thrombectomy candidate)<br>6. <b>tPA decision</b> if within 4.5 h and no contraindications → door-to-needle &lt;60 min<br>7. <b>Thrombectomy evaluation</b> if LVO confirmed<br>8. <b>CT perfusion</b> if extended window (6–24 h)<br>9. Admit to stroke unit/neuro ICU" }
          ]
        },
        {
          section: 'Emergency Medicine',
          topic: "Cardiac emergencies",
          icon: "heart",
          cards: [
            { q: "What is the primary pathophysiology of an <b>Acute Coronary Syndrome (ACS)</b>?", a: "Atherosclerotic plaque rupture or erosion leading to platelet activation, thrombus formation, and partial or complete coronary artery occlusion." },
            { q: "How are <b>Unstable Angina (UA)</b>, <b>NSTEMI</b>, and <b>STEMI</b> differentiated?", a: "• <b>UA:</b> Ischemic symptoms without cardiac biomarker elevation or persistent ST elevation.<br>• <b>NSTEMI:</b> Elevated cardiac biomarkers (troponin) without persistent ST elevation.<br>• <b>STEMI:</b> Persistent ST-segment elevation (or equivalent) with elevated cardiac biomarkers." },
            { q: "What are the standard <b>ECG criteria for STEMI</b> in adults?", a: "ST elevation in ≥2 contiguous leads:<br>• <b>Leads V2-V3:</b> ≥2.0 mm in men ≥40 years, ≥2.5 mm in men <40 years, or ≥1.5 mm in women.<br>• <b>Other leads:</b> ≥1.0 mm (in men and women)." },
            { q: "What is the <b>de Winter ECG pattern</b> and what does it represent?", a: "A <b>STEMI equivalent</b> indicating acute proximal LAD occlusion. Features:<br>• Upsloping ST-segment depression (>1 mm) at the J-point in leads V1-V6.<br>• Tall, prominent, symmetric T waves in precordial leads.<br>• Normal or slightly elevated ST elevation in lead aVR." },
            { q: "Describe the two types of <b>Wellens Syndrome</b> on ECG and their significance.", a: "A sign of critical proximal LAD stenosis in patients with resolved chest pain:<br>• <b>Type A:</b> Biphasic T waves in leads V2-V3 (less common).<br>• <b>Type B:</b> Deeply and symmetrically inverted T waves in V2-V3 (more common).<br><b>Management:</b> High risk for anterior MI; avoid stress test; proceed to angiography." },
            { q: "What are the <b>Modified Sgarbossa criteria</b> for diagnosing acute STEMI in the presence of LBBB or ventricular pacing?", a: "Requires ≥1 point or meets the ratio:<br>1. <b>Concordant ST elevation</b> ≥1 mm in any lead with a positive QRS complex (Score 5).<br>2. <b>Concordant ST depression</b> ≥1 mm in leads V1, V2, or V3 (Score 3).<br>3. <b>Discordant ST elevation</b> with an ST/S ratio ≤ -0.25 (modified rule; replaces absolute ≥5 mm rule)." },
            { q: "How is a <b>Posterior Wall Myocardial Infarction</b> identified on a standard 12-lead ECG, and how is it confirmed?", a: "• <b>Standard ECG:</b> Horizontal ST depression, tall R waves, and upright T waves in V1-V3.<br>• <b>Confirmation:</b> Place posterior leads V7-V9 (placed at left posterior axillary line, parascapular line, and vertebral border at 5th ICS). ST elevation ≥0.5 mm in these leads confirms posterior STEMI." },
            { q: "What are the kinetic characteristics of <b>high-sensitivity troponin (hs-cTn)</b> in acute MI?", a: "hs-cTn detects troponin at much lower concentrations. Levels rise within 1-3 hours of injury, peak at 12-24 hours, and can remain elevated for 5-14 days. Allows rapid 0/1-hour and 0/3-hour rule-out algorithms." },
            { q: "What are the components of the <b>HEART Score</b> for chest pain risk stratification?", a: "Scores 0-10 based on:<br>• <b>H</b>istory (Highly suspicious = 2, Moderately = 1, Slightly = 0)<br>• <b>E</b>CG (Significant ST deviation = 2, LBBB/LVH/nonspecific = 1, Normal = 0)<br>• <b>A</b>ge (≥65 = 2, 45-64 = 1, <45 = 0)<br>• <b>R</b>isk factors (≥3 or DM/CAD history = 2, 1-2 risk factors = 1, None = 0)<br>• <b>T</b>roponin (≥3x limit = 2, 1-3x limit = 1, Normal = 0)" },
            { q: "What are the clinical implications of a low vs. high <b>HEART Score</b>?", a: "• <b>Score 0-3 (Low):</b> ~1-2% MACE (major adverse cardiac event) risk at 6 weeks; candidates for early discharge and outpatient workup.<br>• <b>Score 4-6 (Moderate):</b> ~12-17% MACE risk; admit for observation and serial testing.<br>• <b>Score 7-10 (High):</b> ~50-65% MACE risk; early invasive strategy (angiography)." },
            { q: "What is the rationale behind the controversial use of <b>Morphine</b> in the MONA protocol for acute coronary syndrome?", a: "While morphine relieves pain and anxiety, observational studies suggest it is associated with increased mortality and may <b>delay absorption of oral antiplatelets</b> (clopidogrel, ticagrelor, prasugrel) due to delayed gastric emptying." },
            { q: "What are the absolute contraindications to <b>Nitroglycerin</b> in patients presenting with acute MI?", a: "1. <b>Systolic BP <90 mmHg</b> (or >30 mmHg drop from baseline).<br>2. Severe bradycardia (<50 bpm) or tachycardia (>100 bpm).<br>3. <b>Right Ventricular (RV) Infarction</b> (preload-dependent).<br>4. Use of <b>phosphodiesterase-5 inhibitors</b> within 24-48 hours (sildenafil/vardenafil within 24h, tadalafil within 48h)." },
            { q: "What is the loading dose of <b>Aspirin</b> in acute coronary syndrome and how should it be administered?", a: "<b>162–325 mg</b>. It must be <b>chewed and swallowed</b> (non-enteric coated) to ensure rapid buccal absorption and platelet inhibition within minutes." },
            { q: "Compare the P2Y12 inhibitors <b>Ticagrelor</b>, <b>Clopidogrel</b>, and <b>Prasugrel</b> in ACS management.", a: "• <b>Ticagrelor:</b> Reversible, faster onset than clopidogrel, preferred in NSTE-ACS. Side effect: transient dyspnea.<br>• <b>Clopidogrel:</b> Irreversible prodrug, slower onset, preferred when fibrinolysis is used or bleeding risk is high.<br>• <b>Prasugrel:</b> Irreversible, highly potent, but contraindicated in patients with history of TIA/stroke, age ≥75, or weight <60 kg." },
            { q: "What are the door-to-balloon and door-to-needle time targets for STEMI patients?", a: "• <b>PCI-capable center:</b> Door-to-balloon time <b>≤90 minutes</b>.<br>• <b>Non-PCI-capable center:</b> If transfer delay to PCI is >120 minutes from first medical contact, perform <b>fibrinolysis within 30 minutes</b> (door-to-needle)." },
            { q: "What are the diagnostic cutoffs for <b>BNP</b> and <b>NT-proBNP</b> in acute decompensated heart failure (ADHF)?", a: "• <b>BNP:</b> <100 pg/mL (unlikely ADHF), >400 pg/mL (likely ADHF).<br>• <b>NT-proBNP:</b> Age-dependent cutoffs to rule-in: >450 pg/mL (<50 years), >900 pg/mL (50-75 years), >1800 pg/mL (>75 years)." },
            { q: "Describe the <b>Forrester Classification</b> for cardiogenic shock and heart failure based on perfusion and congestion.", a: "• <b>Class I (Warm & Dry):</b> Normal perfusion (CI >2.2) & normal pressure (PAOP <18) → normal.<br>• <b>Class II (Warm & Wet):</b> Perfusion OK, high congestion (PAOP >18) → diuretics & vasodilators.<br>• <b>Class III (Cold & Dry):</b> Poor perfusion (CI <2.2), low PAOP (<18) → volume expansion.<br>• <b>Class IV (Cold & Wet):</b> Poor perfusion & high congestion → inotropes, vasopressors, mechanical support." },
            { q: "What is the clinical mnemonic <b>LMNOP</b> for acute pulmonary edema treatment?", a: "• <b>L</b>asix (Furosemide) IV (venodilation & diuresis).<br>• <b>M</b>orphine (venodilation & anxiolysis; used less frequently now).<br>• <b>N</b>itroglycerin SL/IV (reduces preload & afterload).<br>• <b>O</b>xygen / Non-invasive ventilation (BiPAP).<br>• <b>P</b>ositioning (sit upright with legs dangling to decrease venous return)." },
            { q: "How does <b>Non-invasive Positive Pressure Ventilation (NIPPV/BiPAP)</b> assist in acute pulmonary edema?", a: "• Increases intrathoracic pressure, which decreases venous return (preload) and ventricular afterload.<br>• Recruits collapsed alveoli, improving oxygenation and decreasing the work of breathing. Reduces intubation rates." },
            { q: "When are inotropes like <b>Dobutamine</b> or <b>Milrinone</b> indicated in acute heart failure?", a: "In patients with severe systolic dysfunction and cardiogenic shock (hypoperfusion, Cold & Wet state) to improve cardiac output. Avoid in severe hypotension unless combined with a vasopressor (norepinephrine)." },
            { q: "Explain the <b>Stanford Classification</b> of aortic dissection.", a: "• <b>Type A:</b> Involves the ascending aorta (requires emergent surgical repair).<br>• <b>Type B:</b> Involves only the descending aorta distal to the left subclavian artery (typically managed medically)." },
            { q: "Explain the <b>DeBakey Classification</b> of aortic dissection.", a: "• <b>Type I:</b> Originates in the ascending aorta and propagates to the arch and descending aorta.<br>• <b>Type II:</b> Confined to the ascending aorta.<br>• <b>Type III:</b> Originates in the descending aorta." },
            { q: "What is the classic presentation of an <b>acute aortic dissection</b>?", a: "Sudden onset of severe, 'ripping' or 'tearing' chest pain that radiates to the back (interscapular region). Associated with pulse deficits, asymmetric blood pressure (>20 mmHg difference between arms), or a new diastolic murmur of aortic regurgitation." },
            { q: "What are the target heart rate and blood pressure goals in acute aortic dissection management?", a: "• <b>Heart Rate:</b> <60 bpm.<br>• <b>Systolic Blood Pressure:</b> 100–120 mmHg (or lowest tolerated to maintain cerebral/renal perfusion).<br><b>Rationale:</b> Minimize shear stress (dP/dt) on the aortic wall." },
            { q: "Which pharmacological agents are used to control HR and BP in aortic dissection, and in what order?", a: "1. <b>Beta-blocker first (e.g., Esmolol IV):</b> To control HR. Giving a vasodilator first causes reflex tachycardia, which increases aortic shear stress.<br>2. <b>Vasodilator second (e.g., Nitroprusside or Nicardipine IV):</b> If SBP remains >120 mmHg after target HR is achieved." },
            { q: "What is the classic clinical triad of a <b>ruptured Abdominal Aortic Aneurysm (AAA)</b>?", a: "1. Severe abdominal, back, or flank pain.<br>2. Hypotension / shock.<br>3. Pulsatile abdominal mass (present in <50% of cases)." },
            { q: "What is <b>Beck's Triad</b> for cardiac tamponade?", a: "1. <b>Hypotension</b> (narrow pulse pressure).<br>2. <b>Jugular Venous Distension (JVD)</b>.<br>3. <b>Muffled or distant heart sounds</b>." },
            { q: "What is <b>Pulsus Paradoxus</b>, how is it measured, and what does it indicate?", a: "An inspiratory drop in systolic blood pressure of <b>>10 mmHg</b>. Measured using a manual sphygmomanometer (first hearing Korotkoff sounds only during expiration, then continuously). Indicates cardiac tamponade, severe asthma, or COPD." },
            { q: "What are the classic ECG findings in <b>cardiac tamponade</b>?", a: "• <b>Low voltage QRS</b> in all leads.<br>• <b>Electrical alternans</b> (alternating amplitude/axis of the QRS complex due to the heart swinging back and forth in the fluid-filled pericardial sac)." },
            { q: "What are the bedside ultrasound (POCUS) findings in <b>cardiac tamponade</b>?", a: "• Pericardial effusion.<br>• <b>Right ventricular diastolic collapse</b> (high specificity).<br>• Right atrial systolic collapse.<br>• Plethoric IVC with lack of respiratory variation." },
            { q: "Where is the needle inserted for an emergent <b>subxiphoid pericardiocentesis</b>?", a: "Insert the needle between the xiphoid process and the left costal margin at a 30-45 degree angle, aiming toward the left shoulder. Use ultrasound guidance if available." },
            { q: "What are the classic ECG stages of <b>acute pericarditis</b>?", a: "• <b>Stage 1:</b> Diffuse, concave-upwards ST elevation and PR depression (except in aVR where there is ST depression and PR elevation).<br>• <b>Stage 2:</b> Normalization of ST and PR segments.<br>• <b>Stage 3:</b> Diffuse T-wave inversions.<br>• <b>Stage 4:</b> Normalization of ECG." },
            { q: "How is the pain of <b>acute pericarditis</b> typically described, and what makes it better/worse?", a: "Sharp, pleuritic chest pain that is <b>worse when lying flat</b> and improved by <b>sitting up and leaning forward</b>. May radiate to the trapezius ridge." },
            { q: "What is the standard medical treatment for uncomplicated <b>acute pericarditis</b>?", a: "High-dose <b>NSAIDs</b> (e.g., Ibuprofen 600-800 mg TID or Indomethacin 50 mg TID) for 1-2 weeks plus <b>Colchicine</b> (0.5-0.6 mg daily or BID) for 3 months to reduce recurrence." },
            { q: "What is the clinical presentation and diagnostic workup for <b>Myocarditis</b>?", a: "• <b>Presentation:</b> Dyspnea, chest pain, arrhythmias, or heart failure symptoms, often preceded by a viral illness.<br>• <b>Workup:</b> Elevated troponin, ECG changes (nonspecific), echocardiogram showing ventricular dysfunction. <b>Cardiac MRI</b> is the gold standard non-invasive test." },
            { q: "List the components of the <b>Wells Criteria</b> for Pulmonary Embolism.", a: "• Clinical signs/symptoms of DVT (3.0)<br>• PE is number one diagnosis or equally likely (3.0)<br>• Heart rate >100 bpm (1.5)<br>• Immobilization ≥3 days or surgery within 4 weeks (1.5)<br>• Previous DVT/PE (1.5)<br>• Hemoptysis (1.0)<br>• Malignancy active/treated within 6 months (1.0)" },
            { q: "How is the <b>PERC (Pulmonary Embolism Rule-out Criteria)</b> used?", a: "In patients with low clinical suspicion (Wells <2). If they meet <b>ALL 8 criteria</b>, PE is ruled out without further testing (no D-dimer):<br>1. Age <50<br>2. HR <100 bpm<br>3. SpO2 ≥95% on room air<br>4. No unilateral leg swelling<br>5. No hemoptysis<br>6. No recent trauma/surgery (<4 weeks)<br>7. No prior DVT/PE<br>8. No oral hormone use" },
            { q: "What are the ECG findings associated with <b>Pulmonary Embolism</b>?", a: "• Sinus tachycardia (most common).<br>• Right axis deviation, RBBB (new).<br>• <b>S1Q3T3 pattern:</b> Deep S wave in lead I, Q wave in lead III, T-wave inversion in lead III (sign of acute cor pulmonale; present in <20% of cases)." },
            { q: "How is PE stratified into <b>Massive</b>, <b>Submassive</b>, and <b>Low-risk</b>?", a: "• <b>Massive (High-risk):</b> Sustained hypotension (SBP <90 mmHg for >15 min) or requiring inotropes/vasopressors.<br>• <b>Submassive (Intermediate-risk):</b> Hemodynamically stable but with signs of <b>RV strain</b> (elevated troponin/BNP or RV dysfunction on echo/CT).<br>• <b>Low-risk:</b> Stable blood pressure, normal biomarkers, no RV strain." },
            { q: "What are the indications for <b>systemic thrombolysis</b> in acute Pulmonary Embolism?", a: "Indicated in patients with <b>Massive PE</b> (hemodynamic instability/shock) who do not have absolute contraindications. Dose: Alteplase 100 mg IV over 2 hours." },
            { q: "What is the definition of a <b>Hypertensive Emergency</b>?", a: "Severe elevation in blood pressure (usually SBP >180 mmHg and/or DBP >120 mmHg) associated with evidence of <b>acute, progressive end-organ damage</b> (e.g., encephalopathy, stroke, acute pulmonary edema, aortic dissection, ACS, acute kidney injury, eclampsia)." },
            { q: "What is the general target for blood pressure reduction in a <b>Hypertensive Emergency</b>, and what is the major exception?", a: "• <b>General rule:</b> Reduce MAP by <b>no more than 20-25%</b> within the first hour, then to 160/100-110 mmHg over the next 2-6 hours. Avoid rapid drops to prevent cerebral ischemia.<br>• <b>Exception:</b> Acute aortic dissection (requires immediate reduction of SBP to <120 mmHg within minutes) and acute ischemic stroke before tPA." },
            { q: "Which IV antihypertensives are preferred for <b>Acute Pulmonary Edema</b> with hypertension?", a: "IV <b>Nitroglycerin</b> (reduces preload & afterload) and IV <b>Nicardipine</b> or <b>Clevidipine</b>. Avoid beta-blockers (e.g., labetalol) as they can worsen acute heart failure." },
            { q: "What is the concern with prolonged or high-dose administration of <b>Sodium Nitroprusside</b>?", a: "<b>Cyanide and thiocyanate toxicity</b>. Nitroprusside is metabolized to cyanide, which blocks mitochondrial oxygen utilization, causing lactic acidosis. Increased risk in renal or hepatic impairment." },
            { q: "What is the management of stable vs. unstable <b>Atrial Fibrillation</b>?", a: "• <b>Unstable:</b> Emergent synchronized cardioversion.<br>• <b>Stable rate control:</b> IV Beta-blockers (Metoprolol, Esmolol) or Non-dihydropyridine CCBs (Diltiazem).<br>• <b>Stable rhythm control:</b> Consider if onset <48 hours or anticoagulated for ≥3 weeks." },
            { q: "What are the components of the <b>CHA2DS2-VASc Score</b> for stroke risk in atrial fibrillation?", a: "• <b>C</b>ongestive HF (1)<br>• <b>H</b>ypertension (1)<br>• <b>A</b>ge ≥75 (2)<br>• <b>D</b>iabetes (1)<br>• <b>S</b>troke/TIA/Thromboembolism history (2)<br>• <b>V</b>ascular disease (prior MI, PAD) (1)<br>• <b>A</b>ge 65-74 (1)<br>• <b>S</b>ex category female (1)" },
            { q: "What ECG findings define <b>Brugada Syndrome Type 1</b>?", a: "Coved ST elevation <b>≥2 mm</b> followed by a negative T wave in leads V1-V2 (often precipitated by fever or sodium channel blockers). Associated with sudden cardiac death due to polymorphic VT/VFib." },
            { q: "What is the management of a stable patient with <b>Wolff-Parkinson-White (WPW)</b> presenting with atrial fibrillation?", a: "Use IV <b>Procainamide</b>. It slows conduction through the accessory pathway. <b>Do NOT use AV nodal blockers</b> (Adenosine, Beta-blockers, CCBs, Digoxin) as they will shunt all impulses through the accessory pathway, causing ventricular fibrillation." },
            { q: "What is the mechanism of <b>Clevidipine</b> and its clinical advantages?", a: "An ultra-short-acting dihydropyridine calcium channel blocker. Formulated as a lipid emulsion. Fast onset (2-4 min) and rapid offset (5-15 min), making it highly titratable for hypertensive emergencies." },
            { q: "What is the significance of the <b>Sgarbossa criteria</b> in ventricular pacing?", a: "Right ventricular pacing creates a LBBB morphology on ECG. The Sgarbossa criteria are applied exactly the same way as in native LBBB to diagnose acute myocardial infarction." },
            { q: "Define <b>submassive PE</b> according to the AHA guidelines.", a: "Acute PE without systemic hypotension (SBP ≥90 mmHg) but with either: myocardial injury (elevated troponin) OR right ventricular dysfunction on echocardiography or CT (RV/LV ratio >0.9)." },
            { q: "Describe the <b>Forrester Class II</b> hemodynamic profile and its management.", a: "• <b>Profile:</b> Cardiac Index >2.2 L/min/m² (normal perfusion), PAOP >18 mmHg (congestion) - 'Warm and Wet'.<br>• <b>Management:</b> IV loop diuretics (furosemide) and IV vasodilators (nitroglycerin) to reduce preload and congestion." },
            { q: "Describe the <b>Forrester Class IV</b> hemodynamic profile and its management.", a: "• <b>Profile:</b> Cardiac Index <2.2 L/min/m² (hypoperfusion), PAOP >18 mmHg (congestion) - 'Cold and Wet' (Cardiogenic Shock).<br>• <b>Management:</b> Inotropic support (dobutamine/milrinone), vasopressors (norepinephrine) to maintain perfusion, and mechanical circulatory support (IABP/Impella/ECMO)." },
            { q: "What is the ECG appearance of a <b>Posterior STEMI</b> on standard V1-V3 leads?", a: "• Horizontal ST-segment depression.<br>• Tall, broad R waves (>0.04s).<br>• Upright T waves.<br>• Prominent dominant R wave in V2 (R/S ratio >1)." },
            { q: "What is the utility of the <b>TIMI Score</b> for NSTE-ACS?", a: "Predicts 14-day mortality, recurrent MI, or severe ischemia requiring urgent revascularization based on 7 variables: age ≥65, ≥3 CAD risk factors, prior stenosis ≥50%, ST deviation, ≥2 anginal events in 24h, aspirin use in last 7 days, and elevated cardiac markers." },
            { q: "What are the ECG diagnostic criteria for <b>Wellens Syndrome Type A</b>?", a: "Biphasic T waves in leads V2 and V3 (initial positive deflection followed by a terminal negative deflection). Suggests critical proximal LAD stenosis." },
            { q: "What are the ECG diagnostic criteria for <b>Wellens Syndrome Type B</b>?", a: "Symmetric, deeply inverted T waves (>5 mm) in leads V2 and V3, which can also extend to V1, V4, V5, and V6. Indicates critical proximal LAD stenosis." },
            { q: "Define a <b>Hypertensive Urgency</b> and its treatment.", a: "Severe elevation in blood pressure (SBP >180 mmHg or DBP >120 mmHg) <b>without</b> evidence of acute end-organ damage. Treated with oral medications (e.g., clonidine, labetalol, captopril) and close outpatient follow-up. Do not lower BP too rapidly." },
            { q: "What is <b>electrical alternans</b> on ECG and when is it seen?", a: "Alternating amplitude, direction, and duration of the QRS complex between beats. It is a sign of cardiac tamponade, caused by the heart physically swinging back and forth in a large pericardial effusion." },
            { q: "What is the hemodynamic mechanism of <b>Pulsus Paradoxus</b> in cardiac tamponade?", a: "Inspiration increases venous return to the right heart. Because the heart is compressed within a tight pericardial sac, the RV expands into the left ventricle (septal bounce/ventricular interdependence), reducing LV filling, stroke volume, and systolic BP during inspiration." },
            { q: "What is the drug of choice for rate control in a patient with <b>atrial fibrillation and asthma</b>?", a: "A non-dihydropyridine calcium channel blocker like <b>Diltiazem</b> or <b>Verapamil</b>. Beta-blockers (even cardioselective ones like metoprolol) can cause bronchospasm and are relative contraindications." },
            { q: "How does <b>Lidocaine</b> work as an antiarrhythmic, and what are signs of toxicity?", a: "• <b>Class IB antiarrhythmic:</b> Blocks open and inactivated sodium channels, shortening action potential duration in ischemic tissue.<br>• <b>Toxicity signs (Lidocaine crazies):</b> Perioral numbness, metallic taste, slurred speech, confusion, tremors, hallucinations, and seizures." },
            { q: "What are the ECG characteristics of <b>Brugada Syndrome Type 2</b>?", a: "Saddleback ST-segment elevation of <b>≥1 mm</b> in leads V1-V2, with a high take-off ST elevation followed by a trough and a positive or biphasic T wave." },
            { q: "What is the mechanism of <b>Dobutamine</b> and its primary hemodynamic effects?", a: "A synthetic catecholamine that acts as a strong <b>beta-1 receptor agonist</b> (increases heart rate and contractility) and mild <b>beta-2 agonist</b> (causes mild vasodilation/decreased afterload). Net effect is increased cardiac output." },
            { q: "What is the mechanism of <b>Milrinone</b> and its hemodynamic effects?", a: "A <b>phosphodiesterase-3 (PDE3) inhibitor</b>. Prevents cAMP breakdown, increasing intracellular calcium in myocytes (increases contractility) and causing smooth muscle relaxation in blood vessels (potent systemic and pulmonary vasodilation). An 'inodilator'." },
            { q: "Why is milrinone preferred over dobutamine in patients taking chronic <b>beta-blockers</b>?", a: "Dobutamine works through beta-1 receptors, which are blocked by chronic beta-blocker therapy. Milrinone bypasses beta-receptors entirely by directly inhibiting PDE-3, making it more effective in these patients." },
            { q: "What is <b>high-dose insulin euglycemic therapy (HIET)</b> and when is it used?", a: "Used for severe beta-blocker or calcium channel blocker toxicity. Dose: 1 unit/kg regular insulin bolus + 0.5-1.0 unit/kg/hr infusion along with dextrose. Insulin acts as a potent inotrope by promoting myocardial carbohydrate utilization." },
            { q: "What are the ultrasound findings of a <b>plethoric IVC</b> in tamponade?", a: "An inferior vena cava diameter <b>>2 cm</b> with <b><50% collapse</b> during deep inspiration, representing elevated right atrial pressure and systemic venous congestion." },
            { q: "What is the utility of the <b>HEART pathway</b>?", a: "Combines the HEART score with serial troponins (at 0 and 3 hours). Identifies patients with low scores (0-3) and negative troponins who can be safely discharged from the emergency department." },
            { q: "What is the significance of a <b>high-sensitivity troponin delta</b>?", a: "The change in hs-cTn levels between serial checks (0h and 1h or 2h). A significant delta (increase) indicates acute myocardial injury, even if the absolute values are within normal limits." },
            { q: "What are the contraindications to <b>Amiodarone</b> infusion in stable VT?", a: "Severe bradycardia, second or third-degree heart block (without a pacemaker), cardiogenic shock, and prolonged QT interval (as it can prolong the QT interval further and precipitate Torsades)." },
            { q: "What is the mechanism of <b>Esmolol</b> and why is it useful in the ED?", a: "An ultra-short-acting, cardioselective <b>beta-1 receptor antagonist</b>. Rapidly metabolized by red blood cell esterases, giving it a half-life of ~9 minutes. Easily reversible if side effects (bradycardia, hypotension) occur." },
            { q: "What is <b>Wellens Syndrome</b> a warning sign of?", a: "Imminent, large anterior wall myocardial infarction due to critical stenosis of the <b>proximal left anterior descending (LAD)</b> coronary artery." },
            { q: "Explain the significance of the <b>S1Q3T3</b> pattern on ECG.", a: "Indicates acute right ventricular strain and pressure overload (cor pulmonale), highly suggestive of a massive pulmonary embolism but not diagnostic on its own." },
            { q: "How is <b>submassive PE</b> managed in the ED?", a: "Requires close ICU monitoring and anticoagulation (heparin). Thrombolysis is generally reserved for patients who show signs of clinical deterioration or impending shock." },
            { q: "What are the echo findings of <b>RV diastolic collapse</b> in tamponade?", a: "The free wall of the right ventricle collapses inward during diastole (when RV pressure is lowest), representing external pericardial pressure exceeding internal ventricular pressure." },
            { q: "What is the mechanism of <b>Nicardipine</b> in hypertensive emergency?", a: "A dihydropyridine calcium channel blocker that causes selective coronary and systemic arterial vasodilation. Highly effective for lowering blood pressure without causing negative inotropic effects." },
            { q: "What is the mechanism of <b>Labetalol</b> and its alpha-to-beta blockade ratio?", a: "A competitive antagonist at alpha-1 and non-selective beta-receptors. The ratio of alpha-to-beta blockade is <b>1:7</b> for IV administration (and 1:3 for oral administration)." },
            { q: "What are the clinical manifestations of <b>cyanide toxicity</b> from nitroprusside?", a: "Altered mental status, seizures, lactic acidosis (due to impaired cellular respiration), and a bright red color of venous blood." },
            { q: "How is <b>cyanide toxicity</b> treated?", a: "Discontinue nitroprusside and administer <b>hydroxocobalamin</b> (Cyanokit), which binds cyanide to form cyanocobalamin (Vitamin B12), excreted by the kidneys. Alternately use sodium thiosulfate." },
            { q: "What is the drug of choice for a <b>hypertensive emergency in pregnancy</b>?", a: "IV <b>Labetalol</b> or IV <b>Hydralazine</b> or oral <b>Nifedipine</b>. Avoid ACE inhibitors, ARBs, and Nitroprusside (fetal toxicity)." },
            { q: "What are the ECG findings of <b>acute myocarditis</b>?", a: "Nonspecific ST-segment and T-wave changes, sinus tachycardia, conduction delays (AV blocks, bundle branch blocks), and ventricular arrhythmias." },
            { q: "What is <b>electrical alternans</b> on ECG?", a: "Alternating QRS axis and amplitude from beat to beat, highly specific for a large pericardial effusion/tamponade." },
            { q: "What is the role of <b>pericardial window</b> in pericardial effusion management?", a: "A surgical procedure to create a small opening in the pericardium to allow fluid to drain continuously into the pleural or peritoneal cavity, preventing recurrent tamponade." },
            { q: "What is <b>auto-PEEP</b> in obstructive shock, and how is it managed?", a: "Dynamic hyperinflation where exhalation is incomplete before the next breath begins (air trapping). Seen in severe asthma/COPD. Managed by decreasing ventilator rate, increasing expiratory time, or temporarily disconnecting the ventilator to allow exhalation." },
            { q: "How does <b>pregnancy</b> affect the risk of aortic dissection?", a: "Pregnancy (particularly the third trimester) increases the risk of aortic dissection due to hormonal changes (relaxin) that alter vessel wall elasticity and increased hemodynamic stress." },
            { q: "What is the <b>Forrester Class III</b> profile and its management?", a: "• <b>Profile:</b> Cardiac Index <2.2 L/min/m² (hypoperfusion), PAOP <18 mmHg (hypovolemia) - 'Cold and Dry'.<br>• <b>Management:</b> Careful fluid resuscitation to raise PAOP to 15-18 mmHg, improving stroke volume via the Frank-Starling mechanism." },
            { q: "What is the <b>Forrester Class I</b> profile?", a: "• <b>Profile:</b> Cardiac Index >2.2 L/min/m² (normal perfusion), PAOP <18 mmHg (normal congestion) - 'Warm and Dry'. No specific acute cardiac interventions needed." },
            { q: "What is the dose of <b>Aspirin</b> in acute coronary syndrome?", a: "<b>162 to 325 mg</b> (non-enteric coated, chewed and swallowed)." },
            { q: "What is the diagnostic utility of a <b>high-sensitivity troponin 0/1-hour protocol</b>?", a: "Enables rapid triage of chest pain patients. If troponin is below a very low threshold at 0h and has no change at 1h, the patient can be safely ruled out for acute MI." },
            { q: "What is the <b>modified Sgarbossa ratio</b> cutoff?", a: "<b>ST/S ratio ≤ -0.25</b> (meaning ST elevation is at least 25% of the preceding deep S wave amplitude). Found to be more sensitive than the absolute 5 mm cutoff." },
            { q: "What are the ECG leads for the <b>posterior wall</b> of the heart?", a: "Leads <b>V7, V8, and V9</b>." },
            { q: "What is the primary medication class used to treat <b>cocaine-induced chest pain</b>?", a: "<b>Benzodiazepines</b> (e.g., Lorazepam, Diazepam) to reduce sympathetic drive. <b>Avoid beta-blockers</b> due to the theoretical risk of unopposed alpha-stimulation causing severe coronary vasospasm." },
            { q: "What is <b>Takotsubo Cardiomyopathy</b> and how does it present?", a: "Transient apical ballooning syndrome caused by catecholamine surge (stress-induced). Presents with chest pain, ST elevations, and elevated troponin, but <b>normal coronary arteries</b> on angiography." },
            { q: "What is the utility of the <b>Geneva Score</b> in PE?", a: "An alternative clinical decision rule for predicting the probability of pulmonary embolism, based on age, prior DVT/PE, recent surgery, unilateral leg pain, hemoptysis, heart rate, and pain on deep vein palpation." },
            { q: "What is the primary diagnostic imaging test for <b>Pulmonary Embolism</b>?", a: "<b>CT Pulmonary Angiography (CTPA)</b>. Requires IV iodinated contrast. Superior for visualizing pulmonary arterial tree." },
            { q: "When is a <b>V/Q scan</b> preferred over CTPA for diagnosing PE?", a: "In patients with severe renal impairment, severe contrast allergy, or in pregnant patients (to minimize radiation exposure to the fetus, though CTA is also acceptable in pregnancy)." },
            { q: "What is <b>McConnell's Sign</b> on echocardiography?", a: "Distinctive echo finding in acute PE: **hypokinesia of the RV free wall** with **sparing of the apex** (apical hyperkinesia). Suggests acute pulmonary embolism." },
            { q: "What is the dose of <b>Alteplase</b> for massive PE?", a: "<b>100 mg IV</b> administered over 2 hours." },
            { q: "What is the mechanism of <b>Ulipristal acetate</b> as emergency contraception?", a: "A selective progesterone receptor modulator that inhibits or delays ovulation, effective up to 120 hours after unprotected intercourse." },
            { q: "What is the mechanism of <b>Levonorgestrel</b> (Plan B) as emergency contraception?", a: "A progestin that prevents pregnancy primarily by preventing or delaying ovulation. Less effective if taken >72 hours after intercourse or in women with BMI >25." },
            { q: "What is the definition of a <b>hypertensive crisis</b>?", a: "Systolic BP >180 mmHg and/or Diastolic BP >120 mmHg." },
            { q: "What is the drug of choice for hypertensive emergency with <b>acute aortic dissection</b>?", a: "IV <b>Esmolol</b> first to control heart rate, followed by IV <b>Nitroprusside</b> or <b>Nicardipine</b> to lower blood pressure." },
            { q: "What is the drug of choice for hypertensive emergency with <b>pheochromocytoma</b>?", a: "IV <b>Phentolamine</b> (non-selective alpha blocker) first to block catecholamine-induced vasoconstriction, followed by beta-blockers if needed for tachycardia. Avoid beta-blockers alone." },
            { q: "What are the diagnostic criteria for <b>acute pericarditis</b>?", a: "Requires at least 2 of 4:<br>1. Pleuritic chest pain (better sitting forward).<br>2. Pericardial friction rub.<br>3. Diffuse ST elevation and PR depression on ECG.<br>4. Pericardial effusion (new or worsening)." },
            { q: "What are the ECG findings of <b>myocarditis</b>?", a: "Nonspecific ST-T changes, sinus tachycardia, bundle branch blocks, or ventricular arrhythmias." },
            { q: "What is the primary treatment for <b>Dressler's Syndrome</b>?", a: "Post-myocardial infarction pericarditis. Treated with <b>Aspirin</b> (high dose, e.g., 650 mg qID) and <b>Colchicine</b>. Avoid other NSAIDs (ibuprofen, indomethacin) as they can interfere with myocardial healing." },
            { q: "What is the classic sign of <b>pulmonary embolism</b> on a chest X-ray?", a: "Most chest X-rays are normal or show nonspecific atelectasis. Classic rare signs:<br>• <b>Westermark sign:</b> Focal oligemia distal to the embolus.<br>• <b>Hampton's hump:</b> Wedge-shaped pleural opacity representing pulmonary infarction." },
            { q: "Describe the <b>Sgarbossa criteria</b> point system.", a: "• Concordant ST elevation ≥1 mm in any lead (5 points).<br>• Concordant ST depression ≥1 mm in V1-V3 (3 points).<br>• Discordant ST elevation ≥5 mm in any lead (2 points; replaced by modified ratio)." },
            { q: "What is the definition of a <b>Wellens equivalent</b>?", a: "ECG changes similar to Wellens syndrome (T-wave inversions in precordial leads) but involving other leads, indicating severe coronary stenosis (e.g., in the LCx or RCA)." },
            { q: "What is the clinical presentation of an <b>Abdominal Aortic Aneurysm rupture</b>?", a: "Severe tearing back or flank pain, hypotension, and a pulsatile abdominal mass. Requires immediate emergency surgical or endovascular repair." },
            { q: "What is the role of <b>nitroprusside</b> in hypertensive emergency?", a: "A potent vasodilator that acts on both venous and arterial smooth muscle, reducing both preload and afterload. Highly effective but carries a risk of cyanide toxicity." },
            { q: "What is the definition of a <b>submassive pulmonary embolism</b>?", a: "An acute PE in a patient who is hemodynamically stable but shows signs of right ventricular strain (elevated troponin/BNP or RV dilation on echocardiography)." },
            { q: "What is the role of <b>dobutamine</b> in cardiogenic shock?", a: "A beta-1 receptor agonist that increases contractility and heart rate, improving cardiac output in cardiogenic shock. Can cause vasodilation via beta-2 receptors, potentially worsening hypotension." },
            { q: "What is the role of <b>norepinephrine</b> in shock?", a: "A potent alpha-1 agonist that causes peripheral vasoconstriction, increasing blood pressure. Has mild beta-1 agonist effects, improving contractility without causing excessive tachycardia." },
            { q: "Define <b>cardiogenic shock</b>.", a: "A state of systemic hypoperfusion caused by cardiac pump failure, defined as persistent hypotension (SBP <90 mmHg) with a cardiac index <2.2 L/min/m² and an elevated PAOP (>15 mmHg)." },
            { q: "What is the drug of choice for rate control in <b>atrial fibrillation with WPW</b>?", a: "IV <b>Procainamide</b>. Do not use CCBs, beta-blockers, or adenosine, as they can lead to rapid conduction down the accessory pathway and ventricular fibrillation." },
            { q: "What is the primary treatment for <b>Brugada Syndrome</b>?", a: "Placement of an **implantable cardioverter-defibrillator (ICD)**, as there are no highly effective pharmacologic agents to prevent sudden cardiac death." },
            { q: "What are the common triggers for a <b>Brugada ECG pattern</b>?", a: "Fever, sodium channel blockers (e.g., flecainide, procainamide), tricyclic antidepressants, and alcohol." },
            { q: "What is the management of a <b>hypertensive emergency with encephalopathy</b>?", a: "Reduce blood pressure by 20-25% within the first hour using IV <b>Nicardipine</b> or <b>Labetalol</b> or <b>Clevidipine</b>. Avoid excessive reduction to prevent cerebral ischemia." },
            { q: "What is the mechanism of <b>colchicine</b> in pericarditis?", a: "Inhibits microtubule polymerization, reducing neutrophil activation and chemotaxis, which limits pericardial inflammation." },
            { q: "Define <b>myocardial hibernation</b>.", a: "A state of persistent myocardial dysfunction due to chronic coronary hypoperfusion, which is reversible upon revascularization." },
            { q: "Define <b>myocardial stunning</b>.", a: "Transient myocardial dysfunction that persists after reperfusion of an acute coronary occlusion, which resolves spontaneously over days to weeks." },
            { q: "What is the mechanism of <b>Ticagrelor</b>?", a: "A reversible antagonist at the P2Y12 adenosine diphosphate (ADP) receptor, inhibiting platelet activation and aggregation." },
            { q: "What is the mechanism of <b>Clopidogrel</b>?", a: "An irreversible inhibitor of the P2Y12 ADP receptor, requiring hepatic conversion to its active metabolite." },
            { q: "What is the mechanism of <b>Prasugrel</b>?", a: "A potent, irreversible P2Y12 ADP receptor inhibitor that is converted to its active metabolite more rapidly than clopidogrel." },
            { q: "What is the dose of <b>Labetalol</b> for hypertensive emergency?", a: "<b>10–20 mg IV bolus</b> over 2 minutes, which can be repeated or followed by an infusion of 2–8 mg/min." },
            { q: "What is the dose of <b>Nicardipine</b> for hypertensive emergency?", a: "Start at <b>5 mg/h IV infusion</b>, titrate by 2.5 mg/h every 5-15 minutes up to a maximum dose of 15 mg/h." },
            { q: "What is the dose of <b>Clevidipine</b> for hypertensive emergency?", a: "Start at <b>1–2 mg/h IV infusion</b>, double the dose every 90 seconds until the target blood pressure is reached." }
          ]
        },
        {
          section: 'Emergency Medicine',
          topic: "Procedural skills — intubation, central lines, chest tubes",
          icon: "clipboard",
          cards: [
            { q: "What are the components of the <b>LEMON</b> assessment for predicting a difficult airway?", a: "• <b>L</b>ook externally (facial trauma, beard, large tongue).<br>• <b>E</b>valuate 3-3-2 rule.<br>• <b>M</b>allampati score (I-IV).<br>• <b>O</b>bstruction (epiglottitis, abscess, tumor).<br>• <b>N</b>eck mobility (C-spine collar, arthritis)." },
            { q: "Explain the <b>3-3-2 rule</b> for airway evaluation.", a: "• <b>3:</b> Mouth opening of at least 3 fingerbreadths (indicates easy laryngoscope insertion).<br>• <b>3:</b> Hyoid-to-chin distance of 3 fingerbreadths (indicates adequate mandibular space to accommodate the tongue).<br>• <b>2:</b> Thyroid-to-hyoid distance of 2 fingerbreadths (predicts location of the larynx relative to the base of the tongue)." },
            { q: "Describe the <b>Mallampati Classification</b> classes I through IV.", a: "Patient sits upright, opens mouth, and protrudes tongue without phonating:<br>• <b>Class I:</b> Soft palate, fauces, uvula, pillars visible.<br>• <b>Class II:</b> Soft palate, fauces, portion of uvula visible.<br>• <b>Class III:</b> Soft palate, base of uvula visible.<br>• <b>Class IV:</b> Only hard palate visible." },
            { q: "What is the <b>Cannot Intubate, Cannot Oxygenate (CICO)</b> scenario and its immediate management?", a: "A critical emergency where both tracheal intubation and rescue oxygenation via bag-valve-mask or supraglottic airway have failed. Immediate management is a <b>surgical cricothyrotomy</b>." },
            { q: "What are the <b>7 P's of Rapid Sequence Intubation (RSI)</b> in order?", a: "1. <b>Preparation</b> (zero time to minus 10 min).<br>2. <b>Preoxygenation</b> (minus 5 min).<br>3. <b>Pretreatment</b> (minus 3 min).<br>4. <b>Paralysis with induction</b> (zero time).<br>5. <b>Positioning</b> (zero plus 30 sec).<br>6. <b>Placement with proof</b> (zero plus 45 sec).<br>7. <b>Post-intubation management</b> (zero plus 2 min)." },
            { q: "What is the goal of <b>Preoxygenation</b> in RSI, and how is it performed?", a: "To replace nitrogen in the patient's functional residual capacity (FRC) with oxygen ('nitrogen washout'), creating an oxygen reservoir. Performed by administering 100% O2 via non-rebreather or non-invasive ventilation for 3 minutes of tidal breathing or 8 vital capacity breaths." },
            { q: "What is <b>Apneic Oxygenation</b> and how does it work?", a: "The administration of high-flow oxygen (e.g., 15 L/min via nasal cannula) during the period of paralysis and apnea. It maintains oxygenation by passive oxygen flow down the partial pressure gradient from the upper airway to the alveoli, extending the safe apnea time." },
            { q: "Describe the induction agent <b>Etomidate</b>: dosing, onset, duration, and main concern.", a: "• <b>Dosing:</b> 0.3 mg/kg IV.<br>• <b>Onset:</b> 30–60 seconds.<br>• <b>Duration:</b> 5–15 minutes.<br>• <b>Main concern:</b> Transient <b>adrenal suppression</b> (inhibits 11-beta-hydroxylase); use with caution in septic shock." },
            { q: "Describe the induction agent <b>Ketamine</b>: dosing, onset, duration, and clinical advantages.", a: "• <b>Dosing:</b> 1–2 mg/kg IV.<br>• <b>Onset:</b> 30–60 seconds.<br>• <b>Duration:</b> 10–20 minutes.<br>• <b>Advantages:</b> Hemodynamically stimulatory (increases catecholamines, maintains blood pressure) and acts as a <b>bronchodilator</b>. Ideal for shock and status asthmaticus." },
            { q: "Describe the induction agent <b>Propofol</b>: dosing, onset, duration, and main side effects.", a: "• <b>Dosing:</b> 1.5–3 mg/kg IV.<br>• <b>Onset:</b> 15–45 seconds.<br>• <b>Duration:</b> 5–10 minutes.<br>• <b>Side effects:</b> Significant <b>hypotension</b> (venodilation & myocardial depression) and respiratory depression. Avoid in hemodynamically unstable patients." },
            { q: "What is the mechanism and dose of the paralytic <b>Succinylcholine</b>?", a: "• <b>Mechanism:</b> Depolarizing neuromuscular blocker; binds to nicotinic ACh receptors, causing muscle fasciculation followed by prolonged depolarization/paralysis.<br>• <b>Dose:</b> 1–1.5 mg/kg IV." },
            { q: "List the major absolute and relative contraindications to <b>Succinylcholine</b> due to the risk of hyperkalemia.", a: "Contraindicated in conditions with upregulated ACh receptors (susceptible to massive K+ release >0.5 mEq/L):<br>1. <b>Burns >48 hours old</b>.<br>2. <b>Crush injuries >48 hours old</b>.<br>3. Neuromuscular diseases (e.g., ALS, MS, muscular dystrophy).<br>4. Stroke/denervation injuries >72 hours old.<br>5. Pre-existing severe hyperkalemia." },
            { q: "Describe the paralytic <b>Rocuronium</b>: mechanism, dosing, onset, duration, and reversal agent.", a: "• <b>Mechanism:</b> Non-depolarizing neuromuscular blocker (competitive ACh antagonist).<br>• <b>Dosing:</b> 1.2 mg/kg IV.<br>• <b>Onset:</b> 60 seconds.<br>• <b>Duration:</b> 45–60 minutes.<br>• <b>Reversal agent:</b> Sugammadex." },
            { q: "How does <b>Sugammadex</b> work, and what are its dosing guidelines?", a: "A modified gamma-cyclodextrin that encapsulates and inactivates rocuronium (and vecuronium) in the plasma:<br>• <b>Dose:</b> 2–4 mg/kg based on depth of blockade; up to 16 mg/kg for immediate reversal after 1.2 mg/kg rocuronium administration." },
            { q: "Explain the difference in placement between the <b>Macintosh</b> and <b>Miller</b> laryngoscope blades.", a: "• <b>Macintosh (curved):</b> Placed in the <b>vallecula</b> to indirectly lift the epiglottis via the hyoepiglottic ligament.<br>• <b>Miller (straight):</b> Placed <b>directly under the epiglottis</b> to lift it physically." },
            { q: "What is the <b>intubating bougie</b>, how is it used, and what are the confirmation signs?", a: "A flexible device with a coude (curved) tip inserted into the airway first, over which the ETT is threaded. Confirmation signs:<br>• <b>Click sign:</b> Feeling the tip pass over the tracheal cartilaginous rings.<br>• <b>Hold-up sign:</b> Feeling resistance when the bougie meets the smaller bronchi (typically at ~40 cm; esophageal insertion has no hold-up)." },
            { q: "What is the gold standard method for confirming <b>endotracheal tube placement</b>?", a: "<b>Waveform capnography (ETCO2)</b>. The persistent presence of a CO2 waveform over ≥5 breaths confirms tracheal placement (excludes esophageal intubation)." },
            { q: "What is a <b>Supraglottic Airway (SGA)</b>, and what are the clinical indications for its use?", a: "A rescue airway device (e.g., Laryngeal Mask Airway [LMA], i-gel, King LT) that sits above the glottis. Indicated as a rescue device in a failed intubation scenario or in prehospital settings." },
            { q: "What are the key anatomical landmarks for performing an emergency <b>surgical cricothyrotomy</b>?", a: "The <b>cricothyroid membrane</b>, which lies between the thyroid cartilage and the cricoid cartilage." },
            { q: "Describe the steps of the <b>Bougie-assisted cricothyrotomy</b> technique.", a: "1. Identify the cricothyroid membrane.<br>2. Make a vertical skin incision, then a horizontal membrane incision.<br>3. Insert the finger to confirm tracheal location.<br>4. Pass the bougie through the incision into the trachea.<br>5. Slide a size 6.0 ETT over the bougie, inflate the cuff, and confirm placement." },
            { q: "What are the primary indications for placing a <b>Central Venous Catheter (CVC)</b>?", a: "1. Administration of vasoactive medications (vasopressors/inotropes).<br>2. Hyperosmolar infusions (e.g., TPN, 3% saline).<br>3. Lack of peripheral venous access.<br>4. Initiation of renal replacement therapy.<br>5. Central venous pressure (CVP) monitoring." },
            { q: "Compare the advantages and disadvantages of the <b>Internal Jugular (IJ)</b>, <b>Subclavian (SC)</b>, and <b>Femoral</b> central access sites.", a: "• <b>IJ:</b> Easy ultrasound visualization, low pneumothorax risk; disadvantage: uncomfortable, higher infection than SC.<br>• <b>SC:</b> Lowest infection rate, patient comfort, compressible landmarks; disadvantage: highest pneumothorax risk, non-compressible in bleeding.<br>• <b>Femoral:</b> Easy access during CPR, no pneumothorax risk; disadvantage: highest infection & thrombosis risk." },
            { q: "What is the <b>Seldinger Technique</b> in central venous access?", a: "1. Access the vessel with a needle.<br>2. Thread a flexible guidewire through the needle.<br>3. Remove the needle over the guidewire.<br>4. Pass a dilator over the guidewire to enlarge the tract.<br>5. Thread the catheter over the guidewire, remove the guidewire, and secure the catheter." },
            { q: "What is the correct anatomical positioning of the tip of an <b>Internal Jugular</b> or <b>Subclavian</b> central line on a chest X-ray?", a: "The catheter tip should lie in the <b>superior vena cava (SVC)</b> near the junction with the right atrium (cavoatrial junction), which corresponds to the level of the carina on a chest X-ray." },
            { q: "What is an <b>air embolism</b> during CVC insertion, and how is it managed?", a: "Air enters the venous circulation, leading to right ventricular outflow tract obstruction. Management: place patient in <b>left lateral decubitus Trendelenburg position</b> to trap the air bubble in the RV apex." },
            { q: "What are the borders of the <b>Triangle of Safety</b> for chest tube insertion?", a: "• <b>Anterior border:</b> Lateral border of the pectoralis major muscle.<br>• <b>Posterior border:</b> Lateral border of the latissimus dorsi muscle.<br>• <b>Inferior border:</b> A horizontal line at the level of the 5th intercostal space.<br>• <b>Apex:</b> Axilla." },
            { q: "Why is a chest tube placed <b>just superior to the lower rib</b> of the intercostal space?", a: "To avoid damaging the <b>neurovascular bundle</b> (intercostal vein, artery, and nerve), which runs along the <b>inferior border</b> of the upper rib." },
            { q: "Explain the difference between a <b>surgical (tube) thoracostomy</b> and a <b>pigtail catheter</b> insertion.", a: "• <b>Surgical thoracostomy:</b> Uses blunt dissection and a finger sweep to create a tract for a large-bore tube (28-36 Fr). Preferred in hemothorax.<br>• <b>Pigtail catheter:</b> Uses a guidewire and dilator to insert a small-bore tube (8-14 Fr). Preferred in simple pneumothorax." },
            { q: "Explain the functions of the 3 chambers in a standard <b>chest drainage system</b>.", a: "1. <b>Collection chamber:</b> Collects fluid/blood draining from the pleural space.<br>2. <b>Water seal chamber:</b> Allows air to escape the pleural space but prevents it from re-entering (acts as a one-way valve).<br>3. <b>Suction control chamber:</b> Regulates the amount of suction applied (usually set to -20 cmH2O)." },
            { q: "What does <b>tidaling</b> in the water seal chamber indicate?", a: "The fluctuation of the water level with respiration (rising during inspiration, falling during expiration). Indicates that the chest tube is patent and correctly placed in the pleural space." },
            { q: "What is the primary landmark for performing a <b>lumbar puncture (LP)</b>?", a: "The L3-L4 or L4-L5 interspaces. The L4 spinous process is located at the level of the line connecting the superior borders of the <b>posterior iliac crests (Tuffier's line)</b>." },
            { q: "What are the contraindications to performing a <b>lumbar puncture</b>?", a: "1. Signs of elevated ICP / impending herniation.<br>2. Skin infection at the puncture site.<br>3. Bleeding diathesis / thrombocytopenia.<br>4. Epidural abscess." },
            { q: "What is the clinical utility of the <b>Allen Test</b> before radial arterial line insertion?", a: "Assesses the patency of the <b>ulnar artery</b> and the adequacy of collateral circulation to the hand. Normal return of color occurs in <5-15 seconds." },
            { q: "What are the common anatomical sites for inserting an <b>intraosseous (IO) needle</b> in adults?", a: "1. <b>Proximal humerus:</b> Greater tubercle.<br>2. <b>Proximal tibia:</b> 2 cm medial to the tibial tuberosity.<br>3. <b>Distal tibia:</b> 2 cm proximal to the medial malleolus." },
            { q: "What is the **LEMON** mnemonic?", a: "A clinical tool to assess the likelihood of a difficult intubation: **L**ook externally, **E**valuate (3-3-2), **M**allampati, **O**bstruction, **N**eck mobility." },
            { q: "What is the definition of **waveform capnography**?", a: "The continuous, real-time measurement and display of carbon dioxide concentration in the exhaled breath, used to verify ETT placement and monitor CPR quality." },
            { q: "What is the **Seldinger technique**?", a: "A procedure for accessing blood vessels or cavities, where a needle is inserted, a guidewire is passed through the needle, the needle is removed, a dilator is used, and a catheter is advanced over the wire." },
            { q: "What is the **triangle of safety** for chest tube insertion?", a: "An anatomical region bounded by the lateral border of the pectoralis major, the lateral border of the latissimus dorsi, and the 5th intercostal space, minimizing risk to internal structures." },
            { q: "What is **apneic oxygenation**?", a: "The continuous delivery of high-flow oxygen (e.g., 15 L/min via nasal cannula) to an apneic patient, which delays hemoglobin desaturation during intubation attempts." },
            { q: "What is a **cricothyrotomy**?", a: "An emergency surgical procedure to establish an airway by creating an incision in the cricothyroid membrane when intubation and ventilation have failed (CICO)." },
            { q: "What is the **MR SOPA** mnemonic in neonatal resuscitation?", a: "Ventilation corrective steps for ineffective PPV: **M**ask adjustment, **R**eposition airway, **S**uction mouth/nose, **O**pen mouth, **P**ressure increase, **A**lternative airway." },
            { q: "Describe the landmark for an **internal jugular** central line.", a: "Located at the apex of the triangle formed by the two heads of the sternocleidomastoid (SCM) muscle and the clavicle. The needle is inserted at a 30-45 degree angle toward the ipsilateral nipple." },
            { q: "What is the primary complication of a **subclavian** central line?", a: "**Pneumothorax** (due to the proximity of the pleura to the subclavian vein). It is a non-compressible site, making bleeding management more difficult." },
            { q: "What is the treatment for a **suspected air embolism** during central line placement?", a: "Immediately place the patient in the **left lateral decubitus Trendelenburg position** to trap the air in the right ventricle, and administer high-flow oxygen." },
            { q: "How is the **FVC** measured in myasthenic crisis?", a: "Using a handheld spirometer. A Forced Vital Capacity (FVC) of **<20 mL/kg** indicates severe respiratory muscle weakness and the need for elective intubation." },
            { q: "What is the **NIF** threshold for intubation in Guillain-Barré syndrome?", a: "A Negative Inspiratory Force (NIF) of **>-30 cmH2O** (e.g., -20 or -10 cmH2O) indicates significant weakness of inspiratory muscles, prompting intubation." },
            { q: "Describe the landmark for a **femoral** central line.", a: "Located 1-2 cm medial to the femoral artery pulse, and 1-2 cm inferior to the inguinal ligament. The needle is directed cephalad at a 30-45 degree angle." },
            { q: "What is the **Allen test**?", a: "A test performed before radial artery cannulation to ensure adequate collateral blood flow to the hand from the ulnar artery." },
            { q: "What is the primary site for **needle cricothyrotomy** in pediatric patients?", a: "The cricothyroid membrane. Recommended over surgical cricothyrotomy in children <8-12 years due to the smaller size of the larynx and risk of subglottic stenosis." },
            { q: "What is the **Z-track technique** in paracentesis?", a: "Displacing the skin and subcutaneous tissue laterally before inserting the needle, then releasing it after needle removal to create a sealed, diagonal path that prevents ascites leakage." },
            { q: "What is the maximum volume of fluid to remove during a diagnostic **thoracentesis**?", a: "Limit fluid removal to **1.0 to 1.5 liters** in a single session to minimize the risk of re-expansion pulmonary edema." },
            { q: "What are the signs of **re-expansion pulmonary edema**?", a: "Persistent cough, dyspnea, hypoxemia, and chest tightness following the rapid removal of large volumes of pleural fluid or air." },
            { q: "What is the **Seldinger technique** in chest tube placement?", a: "Using a guidewire and dilators to place a small-bore chest tube (pigtail catheter), which is less traumatic and more comfortable for patients than blunt dissection thoracostomy." },
            { q: "How is a **pigtail catheter** secured?", a: "Secured using a suture (such as a horizontal mattress or purse-string) and locked using the built-in locking mechanism to prevent displacement." },
            { q: "What is the definition of **cannot intubate, cannot oxygenate (CICO)**?", a: "A clinical scenario where standard endotracheal intubation has failed, and oxygenation via mask ventilation or supraglottic airway is inadequate to maintain saturations." },
            { q: "What is the treatment for **CICO**?", a: "Immediate emergency **cricothyrotomy** (surgical or needle) to establish a subglottic airway." },
            { q: "What is the landmark for a **femoral arterial line**?", a: "The femoral artery pulse, located in the femoral triangle, midway between the anterior superior iliac spine (ASIS) and the pubic symphysis, just inferior to the inguinal ligament." },
            { q: "What is the risk of **radial artery cannulation**?", a: "Thrombosis, hematoma, infection, and rarely digital ischemia (especially if collateral flow from the ulnar artery is poor)." },
            { q: "How is a **joint aspiration (arthrocentesis)** performed in the knee?", a: "Insert the needle laterally or medially beneath the patella, directing it toward the center of the joint space. Avoid touching the articular cartilage." },
            { q: "What fluid studies are obtained from **arthrocentesis**?", a: "Cell count with differential, Gram stain and culture, and crystal analysis (gout vs. pseudogout)." },
            { q: "What is the <b>Cormack-Lehane Classification</b> system?", a: "Used to grade the laryngoscopic view of the glottis:<br>• <b>Grade 1:</b> Full view of glottis (vocal cords visible).<br>• <b>Grade 2:</b> Partial view of glottis (posterior commissure visible).<br>• <b>Grade 3:</b> Only epiglottis visible.<br>• <b>Grade 4:</b> Neither glottis nor epiglottis visible." },
            { q: "What are the components of the <b>physiologic difficult airway</b>?", a: "Critical physiological derangements that increase intubation risk:<br>1. <b>Hypoxemic</b> (poor oxygen reserve).<br>2. <b>Hemodynamically unstable</b> (severe shock).<br>3. <b>Severe metabolic acidosis</b> (requires high minute ventilation).<br>4. <b>Right ventricular failure</b> (sensitive to changes in preload/afterload)." },
            { q: "Why is <b>Fentanyl</b> used in RSI pretreatment and what is the dose?", a: "Dose: 1–3 mcg/kg IV over 30–60 seconds. Used to blunt the <b>sympathetic surge</b> (reflex tachycardia and hypertension) associated with laryngoscopy, particularly in patients with intracranial hemorrhage, aortic dissection, or severe CAD." },
            { q: "Why is <b>Lidocaine</b> sometimes used in RSI pretreatment?", a: "Dose: 1.5 mg/kg IV. Thought to blunt the increase in <b>intracranial pressure (ICP)</b> and bronchospastic response during laryngoscopy. Used primarily in patients with traumatic brain injury or severe reactive airway disease." },
            { q: "What is the primary contraindication to <b>Etomidate</b> in septic shock?", a: "It causes transient adrenal insufficiency by inhibiting the enzyme <b>11-beta-hydroxylase</b>. While it is hemodynamically stable, some studies suggest a single dose may increase mortality in severe sepsis." },
            { q: "Compare the duration of action of <b>Succinylcholine</b> and <b>Rocuronium</b>.", a: "• <b>Succinylcholine:</b> Short duration of action (<b>6–10 minutes</b>; clinically wears off rapidly).<br>• <b>Rocuronium:</b> Long duration of action (<b>45–60 minutes</b>; requires a reversal agent if rapid recovery is needed)." },
            { q: "What are the advantages of <b>Video Laryngoscopy (VL)</b> over Direct Laryngoscopy (DL)?", a: "• Provides a better view of the glottis (lower Cormack-Lehane grades).<br>• Does not require alignment of the oral, pharyngeal, and laryngeal axes.<br>• Allows assistants/teaching staff to see the screen and assist in real time." },
            { q: "What is the <b>cricothyroid membrane size</b> in a typical adult?", a: "Approximately 10 mm vertically and 22 mm horizontally. The vertical height represents the safety margin for making a horizontal incision during cricothyrotomy." },
            { q: "What needle size is used for a <b>needle cricothyrotomy</b> in pediatric patients?", a: "A 12 or 14-gauge over-the-needle angiocatheter connected to a syringe. It is inserted through the cricothyroid membrane and attached to a jet ventilator or 3.0 mm ETT adapter." },
            { q: "What is <b>jet ventilation</b> and what are its primary complications?", a: "High-pressure, oxygen-powered ventilation used with a needle cricothyrotomy. Complications include <b>barotrauma</b>, pneumothorax, subcutaneous emphysema, and hypoventilation (due to inadequate CO2 elimination)." },
            { q: "What is the purpose of the **finger sweep** during surgical chest tube insertion?", a: "To ensure the tract enters the pleural space, to check for **pleural adhesions**, and to verify that the needle/hemostat has not punctured abdominal organs (liver, spleen) or the lung." },
            { q: "What is the **water seal bubbling** interpretation?", a: "• **Intermittent bubbling:** Air is leaving the pleural space (normal during expiration/coughing in a patient with pneumothorax).<br>• **Continuous bubbling:** Suggests a large air leak, either from the lung (bronchopleural fistula) or from a leak in the tubing system." },
            { q: "What are the criteria for **removing a chest tube**?", a: "1. No air leak (no bubbling in the water seal chamber during coughing/valsalva).<br>2. Minimal drainage (<100–200 mL in 24 hours).<br>3. Complete lung re-expansion on chest X-ray.<br>4. Patient tolerates clamping of the chest tube without respiratory distress." },
            { q: "What are the four categories of **synovial fluid analysis**?", a: "• **Non-inflammatory:** WBC <2,000, clear, yellow (e.g., osteoarthritis).<br>• **Inflammatory:** WBC 2,000–50,000, turbid, yellow (e.g., RA, gout).<br>• **Infectious (Septic):** WBC >50,000, purulent, opaque (e.g., septic arthritis).<br>• **Hemorrhagic:** Red, bloody (e.g., trauma, hemophilia)." },
            { q: "Differentiate between **Gout** and **Pseudogout** crystals under polarized light.", a: "• **Gout:** **Monosodium urate** crystals; needle-shaped, **strongly negatively birefringent**.<br>• **Pseudogout:** **Calcium pyrophosphate** crystals; rhomboid-shaped, **weakly positively birefringent**." },
            { q: "How is the **Serum-Ascites Albumin Gradient (SAAG)** calculated and interpreted?", a: "**SAAG = Serum Albumin − Ascites Albumin**:<br>• **SAAG ≥1.1 g/dL:** Indicates **portal hypertension** (e.g., cirrhosis, heart failure).<br>• **SAAG <1.1 g/dL:** Indicates non-portal hypertension causes (e.g., peritoneal carcinomatosis, TB)." },
            { q: "What is the criteria for administering **albumin** during a large-volume paracentesis?", a: "If removing **>5 liters** of ascitic fluid, administer **6–8 grams of albumin per liter** of fluid removed. Prevents paracentesis-induced circulatory dysfunction (PCD)." },
            { q: "What are **Light's Criteria** for differentiating transudate vs. exudate pleural effusion?", a: "The fluid is an **exudate** if at least one of the following is met:<br>1. Pleural fluid protein / serum protein ratio >0.5.<br>2. Pleural fluid LDH / serum LDH ratio >0.6.<br>3. Pleural fluid LDH > two-thirds the upper limit of normal serum LDH." },
            { q: "What are the common color codes and sizes of **EZ-IO needles**?", a: "• **Pink (15 mm, 15G):** Pediatric patients (3–39 kg).<br>• **Blue (25 mm, 15G):** Adult patients (≥40 kg) for proximal tibia/distal tibia.<br>• **Yellow (45 mm, 15G):** Adult patients with excess tissue (obese) or for proximal humerus insertion." },
            { q: "What is the management of **pain during intraosseous infusion** in conscious patients?", a: "Slowly administer **20–40 mg of preservative-free 2% Lidocaine** through the IO catheter over 1-2 minutes, let it sit for 60 seconds, then flush with normal saline." },
            { q: "What is the **Durant's Maneuver** for air embolism?", a: "Place the patient in the **left lateral decubitus Trendelenburg position** to keep the air bubble in the apex of the right ventricle, allowing it to be slowly reabsorbed." },
            { q: "Why is the **subclavian vein** non-compressible, and why is this a risk?", a: "It is anatomically bound beneath the clavicle and the subclavius muscle, meaning pressure cannot be applied to control bleeding if the subclavian artery is accidentally punctured." },
            { q: "What is the **Seldinger wire entrapment** and how is it prevented?", a: "The guidewire becomes trapped or kinked within the dilator or vessel. Prevention: never force a wire against resistance, and always verify wire movement." },
            { q: "Describe the landmark for **humerus intraosseous** access.", a: "Located at the **greater tubercle** of the proximal humerus. Landmark is found by adducting the arm, placing the hand over the abdomen, and palpating the surgical neck." },
            { q: "What is the **carina** level on a chest X-ray?", a: "Corresponds to the **T4-T5** vertebral level, where the trachea splits. Used to verify correct endotracheal tube and central venous catheter tip placement." },
            { q: "What is the clinical presentation of a **post-LP headache**?", a: "A positional headache that is **worse when sitting or standing** and relieved by lying flat, caused by persistent CSF leakage." },
            { q: "How is a **post-LP headache** treated?", a: "• **Conservative:** Bed rest, hydration, caffeine.<br>• **Definitive:** An **epidural blood patch**." },
            { q: "What are the common causes of **re-expansion pulmonary edema**?", a: "Rapid re-inflation of a chronically collapsed lung (usually collapsed for >3 days) during thoracentesis or chest tube placement." },
            { q: "What is the **cricoid cartilage**'s anatomical relationship to the thyroid cartilage?", a: "Located directly inferior to the thyroid cartilage, forming a complete ring around the airway." },
            { q: "What is the **supraglottic airway rescue** indications?", a: "Used as a primary rescue device when endotracheal intubation fails in a patient who cannot be ventilated with a bag-valve-mask." },
            { q: "What is the **Cormack-Lehane Grade 3** view?", a: "Only the **epiglottis** is visible during laryngoscopy; the vocal cords and posterior commissure are completely obscured." },
            { q: "What is the **Cormack-Lehane Grade 4** view?", a: "Neither the glottis nor the epiglottis is visible; only the soft palate or tongue is visible." },
            { q: "Why is a **pediatric larynx** more prone to subglottic stenosis after cricothyrotomy?", a: "The cricoid cartilage is the narrowest part of the pediatric airway and is easily damaged, leading to scarring. Therefore, surgical cric is contraindicated in children." },
            { q: "What is the purpose of **Apneic Oxygenation**?", a: "To maintain oxygen saturation during the apneic phase of RSI by delivering oxygen at high flows (e.g., 15 L/min)." },
            { q: "Describe the **CICO** algorithm.", a: "1. Attempt face mask ventilation.<br>2. Attempt supraglottic airway insertion.<br>3. If both fail to maintain oxygenation → perform emergent cricothyrotomy." },
            { q: "What is the landmark for a **tibia intraosseous** access in children?", a: "Located 1-2 cm distal and 1 cm medial to the **tibial tuberosity** on the flat anteromedial surface of the tibia." },
            { q: "What are the signs of a **successful joint aspiration**?", a: "A sudden decrease in resistance, return of synovial fluid, and relief of joint pressure." },
            { q: "Define **SAAG**.", a: "Serum-Ascites Albumin Gradient. A value ≥1.1 g/dL indicates portal hypertension." },
            { q: "Define **Light's criteria**.", a: "A set of criteria used to determine if a pleural effusion is an exudate (inflammatory) or a transudate (hydrostatic)." },
            { q: "What is the purpose of the **Z-track technique**?", a: "To prevent ascites fluid leakage after paracentesis by creating a non-linear tract through the skin and peritoneal wall." },
            { q: "What is the preferred needle type for lumbar puncture and why?", a: "A **pencil-point needle** (e.g., Sprotte or Whitacre) rather than a cutting needle (Quincke). Pencil-point needles spread the dural fibers rather than cutting them, significantly reducing the incidence of post-LP headache." },
            { q: "What is the threshold value of SAAG that indicates portal hypertension?", a: "**SAAG ≥ 1.1 g/dL**. This suggests a transudative process driven by hydrostatic pressure (e.g., cirrhosis, heart failure, Budd-Chiari syndrome)." },
            { q: "How do you calculate the Absolute Neutrophil Count (ANC) in ascitic fluid to diagnose SBP?", a: "**ANC = Total Ascitic WBC count × % PMNs (neutrophils)**. An ANC **≥250 cells/mm³** is diagnostic of Spontaneous Bacterial Peritonitis and warrants immediate empiric antibiotic therapy." },
            { q: "What is the recommended antibiotic regimen for empiric treatment of SBP?", a: "A third-generation cephalosporin, typically **Cefotaxime 2 g IV every 8 hours** (or Ceftriaxone 2 g IV every 24 hours)." },
            { q: "What is the role of albumin infusion in large-volume paracentesis (>5L)?", a: "It prevents **paracentesis-induced circulatory dysfunction (PCD)**, which is a rapid drop in systemic vascular resistance leading to renal impairment and increased mortality. Give 6-8 g of albumin per liter of fluid removed." },
            { q: "Why is the volume of fluid removed in a single therapeutic thoracentesis typically limited to 1.5 liters?", a: "To prevent **re-expansion pulmonary edema** (RPE) and cardiovascular collapse caused by rapid shift of fluid into the lungs and pleural space." },
            { q: "Can medications given via the intraosseous (IO) route be administered at the same dose as the IV route?", a: "**Yes**. Virtually any drug or fluid that can be administered intravenously can be administered intraosseously at the same dose and rate." },
            { q: "Describe the lateral approach landmarks for knee joint arthrocentesis.", a: "Insert the needle **1 cm superior and 1 cm lateral** to the superolateral border of the patella, directing it under the patellar surface into the joint space." },
            { q: "Describe the medial approach landmarks for knee joint arthrocentesis.", a: "Insert the needle **1 cm superior and 1 cm medial** to the superomedial border of the patella, directing it under the patellar surface into the joint space." },
            { q: "What size chest tube is preferred for a simple pneumothorax vs. a hemothorax in trauma?", a: "• **Simple pneumothorax:** Small-bore (e.g., **8–14 Fr** pigtail or chest tube).<br>• **Hemothorax:** Large-bore (e.g., **28–36 Fr** surgical chest tube) to prevent obstruction by blood clots." },
            { q: "What is the first step in managing a sucking chest wound (open pneumothorax) before a chest tube is placed?", a: "Apply a **three-sided occlusive dressing**. This acts as a flutter valve, allowing air to escape the pleural space during expiration but preventing it from entering during inspiration." },
            { q: "What size surgical blade is typically used for a surgical cricothyrotomy?", a: "A **No. 10 or No. 11 scalpel blade** to make the skin and cricothyroid membrane incisions." },
            { q: "What is the recommended size of the bougie used in a cricothyrotomy?", a: "A standard **15 French** intubating bougie with a coude tip." },
            { q: "Why is Midazolam rarely used as a primary induction agent in RSI?", a: "It has a **slower onset** (up to 2 minutes) and can cause dose-dependent **myocardial depression/hypotension**, making it less predictable than etomidate or ketamine." },
            { q: "What is the optimal timing for administering pretreatment medications (e.g., Fentanyl) during RSI?", a: "**3 minutes before** administering the induction agent and paralytic (allows the pretreatment drug to reach peak effect)." },
            { q: "What inter-incisor distance indicates a potentially difficult intubation?", a: "An inter-incisor distance of **<3 cm (or <3 fingerbreadths)** at maximum mouth opening." },
            { q: "What thyromental distance indicates a potentially difficult intubation?", a: "A thyromental distance of **<6 cm (or <3-4 fingerbreadths)**, which suggests an anteriorly located larynx." },
            { q: "List two secondary methods for confirming endotracheal tube placement when capnography is unavailable.", a: "1. **Esophageal Detector Device (EDD):** A bulb or syringe syringe that fails to expand or draw air if in the esophagus due to wall collapse.<br>2. **Point-of-Care Ultrasound (POCUS):** Direct visualization of the trachea during intubation (double lumen sign indicates esophageal placement)." },
            { q: "How does the King LT supraglottic airway work?", a: "It has **two cuffs** inflated via a single port. The distal cuff seals the esophagus, and the proximal cuff seals the oropharynx. Ventilation gas exits through ports between the two cuffs." },
            { q: "What are the primary indications for a surgical tracheostomy?", a: "1. Prolonged mechanical ventilation (typically >10-14 days).<br>2. Severe upper airway obstruction (e.g., tumor, trauma) where cricothyrotomy is not feasible.<br>3. Need for pulmonary toilet/secretions clearing." },
            { q: "How do you confirm correct placement of an IJ central line using ultrasound before a chest X-ray?", a: "Perform ultrasound scanning of the neck to confirm: 1. the catheter is visible **inside the IJ lumen**, and 2. the **IJ vein is still compressible** around the catheter (rules out arterial placement)." },
            { q: "What is the primary anatomical relation of the subclavian vein to the clavicle?", a: "The subclavian vein runs **posterior and inferior to the clavicle**, passing over the first rib anterior to the insertion of the anterior scalene muscle." },
            { q: "What is the primary anatomical landmark for a femoral arterial line?", a: "The **femoral artery pulse**, located at the mid-inguinal point (midway between the anterior superior iliac spine and the pubic symphysis), just inferior to the inguinal ligament." },
            { q: "What synovial fluid leukocyte count suggests a septic joint?", a: "A synovial fluid leukocyte (WBC) count of **>50,000 cells/mm³** with >75% PMNs (neutrophils)." },
            { q: "What is the significance of the 'double lumen sign' on airway ultrasound?", a: "During intubation, seeing **two parallel fluid-filled structures** (trachea and esophagus) on ultrasound indicates **esophageal intubation**. Normal tracheal intubation shows only a single structure (trachea) with shadow." }
          ]
        },

        {
          section: 'Advanced Pediatrics',
          topic: "Pediatric emergencies & resuscitation (PALS)",
          icon: "activity",
          cards: [
            // ===== PALS ALGORITHMS: CARDIAC ARREST =====
{ q: "What are the two shockable pediatric cardiac arrest rhythms?", a: "<b>Ventricular fibrillation (VF)</b> and <b>pulseless ventricular tachycardia (pVT)</b>." },
{ q: "What are the two non-shockable pediatric cardiac arrest rhythms?", a: "<b>Asystole</b> and <b>pulseless electrical activity (PEA)</b>. These are the most common arrest rhythms in children." },
{ q: "What is the most common initial cardiac arrest rhythm in children?", a: "<b>Asystole/PEA</b> (non-shockable). Unlike adults, pediatric arrest is usually respiratory in origin, leading to bradycardia → asystole." },
{ q: "What is the first defibrillation dose for pediatric VF/pVT?", a: "<b>2 J/kg</b> (monophasic or biphasic)." },
{ q: "What is the second defibrillation dose for pediatric VF/pVT?", a: "<b>4 J/kg</b>." },
{ q: "What is the maximum defibrillation dose in pediatric VF/pVT?", a: "<b>10 J/kg or adult maximum dose</b>, whichever is less." },
{ q: "In the PALS VF/pVT algorithm, when is epinephrine first given?", a: "After the <b>2nd shock</b> (during CPR after the 2nd shock). Then every <b>3–5 minutes</b> thereafter." },
{ q: "What is the dose of epinephrine in pediatric cardiac arrest?", a: "<b>0.01 mg/kg (0.1 mL/kg of 1:10,000)</b> IV/IO. Repeat every 3–5 minutes." },
{ q: "When is amiodarone given in the PALS VF/pVT algorithm?", a: "After the <b>3rd shock</b>, dose: <b>5 mg/kg</b> IV/IO bolus (may repeat up to 2 times for refractory VF/pVT)." },
{ q: "What is the alternative antiarrhythmic to amiodarone in refractory VF/pVT?", a: "<b>Lidocaine</b> 1 mg/kg IV/IO bolus." },
{ q: "In the PALS asystole/PEA algorithm, what drug is given and at what interval?", a: "<b>Epinephrine 0.01 mg/kg IV/IO</b> as soon as possible, then every <b>3–5 minutes</b>. No shocks are delivered." },
{ q: "What is the endotracheal dose of epinephrine in pediatric arrest?", a: "<b>0.1 mg/kg (0.1 mL/kg of 1:1,000)</b> — 10× the IV dose. ET route is least preferred." },
{ q: "What does the mnemonic H's and T's stand for in reversible causes of cardiac arrest?", a: "<b>H's:</b> Hypovolemia, Hypoxia, Hydrogen ion (acidosis), Hypo/Hyperkalemia, Hypothermia, Hypoglycemia. <b>T's:</b> Tension pneumothorax, Tamponade (cardiac), Toxins, Thrombosis (pulmonary/coronary)." },
{ q: "What is the most common reversible cause of pediatric cardiac arrest?", a: "<b>Hypoxia</b>, reflecting the respiratory etiology of most pediatric arrests." },
{ q: "What is the CPR cycle structure in the PALS cardiac arrest algorithm?", a: "<b>2 minutes of CPR</b> between each rhythm check/intervention. Minimize interruptions in chest compressions." },

// ===== PALS: BRADYCARDIA WITH PULSE =====
{ q: "In PALS, when does bradycardia with a pulse require intervention?", a: "When heart rate <b><60 bpm with signs of poor perfusion</b> (altered consciousness, hypotension, poor end-organ perfusion) despite adequate oxygenation and ventilation." },
{ q: "What is the first step in managing symptomatic pediatric bradycardia?", a: "Support <b>airway, breathing, and circulation</b>. Provide supplemental oxygen and assisted ventilation — many cases resolve with this alone." },
{ q: "If bradycardia persists despite oxygenation and ventilation, what is the next step?", a: "Begin <b>CPR</b> if heart rate remains <60 bpm with poor perfusion." },
{ q: "What drug is first-line for symptomatic pediatric bradycardia unresponsive to ventilation?", a: "<b>Epinephrine 0.01 mg/kg IV/IO</b> (1:10,000). Repeat every 3–5 minutes." },
{ q: "When is atropine indicated for pediatric bradycardia?", a: "When bradycardia is caused by <b>increased vagal tone or primary AV block</b>. Dose: <b>0.02 mg/kg IV/IO</b> (minimum dose 0.1 mg, max single dose 0.5 mg)." },
{ q: "Why is there a minimum dose of atropine (0.1 mg) in children?", a: "Doses below 0.1 mg can cause <b>paradoxical bradycardia</b> due to a central stimulatory effect on the vagal nucleus." },
{ q: "When is transcutaneous pacing considered for pediatric bradycardia?", a: "For bradycardia due to <b>complete heart block or sinus node dysfunction</b> unresponsive to medications. It is NOT effective for asystole." },

// ===== PALS: TACHYCARDIA WITH PULSE =====
{ q: "How do you differentiate sinus tachycardia from SVT in an infant?", a: "<b>Sinus tachycardia:</b> HR usually <220 bpm in infants, P waves present, variable R-R. <b>SVT:</b> HR typically ≥220 in infants, no discernible P waves, fixed R-R interval." },
{ q: "What is the most common tachyarrhythmia in pediatric patients?", a: "<b>Supraventricular tachycardia (SVT)</b>." },
{ q: "What is the typical heart rate in SVT for infants vs. children?", a: "Infants: <b>≥220 bpm</b>. Children: <b>≥180 bpm</b>. Narrow QRS complex (<0.09 sec)." },
{ q: "What is the first-line treatment for stable SVT in children?", a: "<b>Vagal maneuvers</b> (ice to face in infants, Valsalva/bearing down in older children)." },
{ q: "What drug is first-line for SVT unresponsive to vagal maneuvers?", a: "<b>Adenosine</b>: 1st dose <b>0.1 mg/kg</b> (max 6 mg) rapid IV push followed by rapid saline flush. 2nd dose <b>0.2 mg/kg</b> (max 12 mg) if needed." },
{ q: "Why must adenosine be given by rapid IV push?", a: "Adenosine has an <b>ultra-short half-life (~10 seconds)</b>. Slow administration allows degradation before reaching the heart. Use a <b>two-syringe stopcock technique</b> with immediate saline flush." },
{ q: "What is the treatment for unstable SVT (with hemodynamic compromise)?", a: "<b>Synchronized cardioversion</b> at <b>0.5–1 J/kg</b>. If ineffective, increase to <b>2 J/kg</b>." },
{ q: "How do you differentiate SVT from VT on ECG?", a: "<b>SVT:</b> narrow QRS (<0.09 sec). <b>VT:</b> wide QRS (≥0.09 sec), AV dissociation, fusion/capture beats. In children, wide-complex tachycardia should be treated as VT until proven otherwise." },
{ q: "What is the treatment for stable wide-complex tachycardia (VT with pulse) in children?", a: "Consider <b>adenosine</b> if rhythm is regular and monomorphic (may be SVT with aberrancy). Otherwise, <b>amiodarone 5 mg/kg IV over 20–60 min</b> or <b>procainamide 15 mg/kg IV over 30–60 min</b>. Do NOT give both together." },
{ q: "What is the treatment for unstable VT with a pulse?", a: "<b>Synchronized cardioversion</b> starting at <b>0.5–1 J/kg</b>, increase to 2 J/kg if needed." },
{ q: "What is the difference between synchronized cardioversion and defibrillation?", a: "<b>Synchronized cardioversion</b> delivers shock timed to the R wave (for organized rhythms with a pulse). <b>Defibrillation</b> delivers unsynchronized shock (for VF/pulseless VT)." },

// ===== POST-CARDIAC ARREST CARE =====
{ q: "What are the key goals of post-cardiac arrest care in children?", a: "1) Optimize cardiopulmonary function. 2) Maintain normoxia (SpO₂ 94–99%). 3) Avoid hypotension. 4) Targeted temperature management. 5) Treat underlying cause. 6) Avoid hyperventilation." },
{ q: "What is targeted temperature management (TTM) in post-cardiac arrest pediatric patients?", a: "Maintain temperature at <b>32–34°C for 24 hours</b> (therapeutic hypothermia) OR strict normothermia (36–37.5°C). Avoid fever (>38°C) aggressively." },
{ q: "Why should hyperventilation be avoided after ROSC in children?", a: "Hyperventilation causes <b>cerebral vasoconstriction</b>, worsening brain ischemia. Aim for <b>normocapnia (PaCO₂ 35–45 mmHg)</b>." },
{ q: "What SpO₂ target should be maintained after ROSC in children?", a: "<b>94–99%</b>. Avoid both hypoxemia and hyperoxia (FiO₂ should be titrated down from 100%)." },

// ===== PEDIATRIC BLS =====
{ q: "What is the compression-to-ventilation ratio for single-rescuer infant/child CPR?", a: "<b>30:2</b> (same as adults for a single rescuer)." },
{ q: "What is the compression-to-ventilation ratio for two-rescuer infant/child CPR?", a: "<b>15:2</b>." },
{ q: "What is the recommended chest compression rate for pediatric CPR?", a: "<b>100–120 compressions per minute</b> (same as adults)." },
{ q: "What is the recommended compression depth for infants (<1 year)?", a: "<b>1.5 inches (4 cm)</b>, approximately one-third the AP diameter of the chest." },
{ q: "What is the recommended compression depth for children (1 year to puberty)?", a: "<b>2 inches (5 cm)</b>, approximately one-third the AP diameter of the chest." },
{ q: "What technique is used for infant chest compressions?", a: "<b>Two-thumb encircling technique</b> (preferred with 2 rescuers) or <b>two-finger technique</b> (single rescuer). Compress over the <b>lower third of the sternum</b>." },
{ q: "Where is the landmark for chest compressions in infants?", a: "<b>Just below the intermammary line</b> on the lower third of the sternum. Avoid compressing over the xiphoid process." },
{ q: "When should an AED be used in children?", a: "Use an AED <b>as soon as available</b>. For children <b>1–8 years</b>, use <b>pediatric dose-attenuator pads</b> if available. For children <b>>8 years</b>, use adult pads. For infants <1 year, a manual defibrillator is preferred, but an AED may be used if no alternative." },
{ q: "In pediatric BLS, what is the sequence if a child is found unresponsive?", a: "<b>Lone rescuer:</b> Provide 2 minutes of CPR before activating EMS (since arrest is likely respiratory). <b>Witnessed sudden collapse:</b> Activate EMS and get AED first (likely cardiac etiology)." },
{ q: "What is the rescue breathing rate for a child with a pulse but not breathing?", a: "<b>1 breath every 2–3 seconds</b> (20–30 breaths/min) for infants. <b>1 breath every 3–5 seconds</b> (12–20 breaths/min) for children." },

// ===== PEDIATRIC AIRWAY MANAGEMENT =====
{ q: "What is the formula for cuffed ETT size in children >2 years?", a: "$\\text{ETT size (mm)} = \\frac{\\text{age (years)}}{4} + 3.5$" },
{ q: "What is the formula for uncuffed ETT size in children >2 years?", a: "$\\text{ETT size (mm)} = \\frac{\\text{age (years)}}{4} + 4$" },
{ q: "What size ETT is used for a full-term neonate?", a: "<b>3.0 mm uncuffed</b> or <b>3.0 mm cuffed</b>. For premature infants: 2.5 mm uncuffed." },
{ q: "What is the formula for ETT depth of insertion (lip to mid-trachea)?", a: "<b>ETT internal diameter × 3</b> (e.g., 4.0 mm tube → insert to 12 cm at the lip). Alternative: <b>Age/2 + 12</b> for children >2 years." },
{ q: "Why are cuffed ETTs now preferred in pediatric patients?", a: "Cuffed tubes reduce the need for tube exchanges, decrease aspiration risk, and provide more reliable ventilation. Cuff pressure should be kept <b><20–25 cmH₂O</b>." },
{ q: "What are key anatomical differences of the pediatric airway compared to adults?", a: "1) <b>Large tongue</b> relative to oropharynx. 2) <b>Larynx is more anterior and cephalad</b> (C3-C4 vs C4-C5). 3) <b>Epiglottis is omega-shaped</b> and floppy. 4) <b>Narrowest point is subglottic</b> (at cricoid ring) in children <8 years vs glottis in adults." },
{ q: "What laryngoscope blade is preferred for infants?", a: "<b>Miller (straight) blade</b> — used to directly lift the omega-shaped epiglottis for better visualization of the anterior larynx." },
{ q: "What are the LMA sizes for pediatric patients?", a: "<b>Size 1:</b> neonates/infants up to 5 kg. <b>Size 1.5:</b> 5–10 kg. <b>Size 2:</b> 10–20 kg. <b>Size 2.5:</b> 20–30 kg. <b>Size 3:</b> 30–50 kg." },
{ q: "What are indications for bag-valve-mask (BVM) ventilation in pediatrics?", a: "Respiratory failure, apnea, inadequate respiratory effort, need for positive-pressure ventilation. BVM is the <b>first-line method</b> of providing ventilation in emergencies." },
{ q: "What is the correct BVM technique for infants?", a: "Use a <b>C-E clamp technique</b>. Jaw thrust (avoid head-tilt chin-lift if trauma suspected). Use an appropriately sized mask covering nose and mouth. Deliver <b>just enough volume to see chest rise</b>." },
{ q: "What is the indication for needle cricothyrotomy in children?", a: "<b>'Can't intubate, can't oxygenate'</b> (CICO) situation. Performed with a large-bore IV catheter (14–18 gauge) through the <b>cricothyroid membrane</b>. Provides temporary oxygenation (transtracheal jet ventilation). Surgical cricothyrotomy is generally avoided in children <10–12 years." },
{ q: "What tidal volume should be targeted during pediatric mechanical ventilation?", a: "<b>6–8 mL/kg</b> of ideal body weight (lung-protective ventilation)." },

// ===== PEDIATRIC VASCULAR ACCESS =====
{ q: "What is the first-line emergency vascular access in a child when IV access fails?", a: "<b>Intraosseous (IO) access</b>. Can be established in <60 seconds. Any IV medication, fluid, or blood product can be given IO." },
{ q: "What is the preferred IO insertion site in children?", a: "<b>Proximal tibia</b> — anteromedial surface, 1–2 cm below the tibial tuberosity. Alternative sites: distal tibia, distal femur, proximal humerus." },
{ q: "What are the landmarks for proximal tibial IO insertion?", a: "Palpate the <b>tibial tuberosity</b>. Insert needle <b>1–2 cm below and medial</b> to the tuberosity on the flat anteromedial surface. Direct the needle <b>slightly away from the growth plate</b> (angled distally)." },
{ q: "What are contraindications to IO access?", a: "1) <b>Fracture</b> in the target bone. 2) Previous IO attempt in same bone. 3) <b>Osteogenesis imperfecta</b>. 4) Overlying <b>infection/burn</b>. 5) Prosthetic joint near site." },
{ q: "How do you confirm correct IO placement?", a: "1) <b>Needle stands upright</b> without support. 2) <b>Aspiration of marrow</b> (not always obtained). 3) <b>Easy flush without extravasation</b>. 4) Fluid infuses freely." },
{ q: "What is the indication for umbilical vein catheterization (UVC)?", a: "<b>Neonatal resuscitation</b> when vascular access is needed urgently (for epinephrine, volume). The umbilical vein remains patent for <b>~7 days after birth</b>." },
{ q: "How deep should an umbilical venous catheter be inserted?", a: "Insert until <b>free flow of blood</b> is obtained, typically <b>2–4 cm</b> past the abdominal wall in a term infant (just past the point where the vein enters the liver)." },
{ q: "What are considerations for pediatric central venous access?", a: "Sites: <b>femoral, internal jugular, subclavian</b>. Femoral is often preferred in emergencies (fewer complications, does not interfere with CPR). Use <b>ultrasound guidance</b> when possible. Catheter size varies by age." },

// ===== SHOCK RECOGNITION & MANAGEMENT =====
{ q: "What defines compensated shock in pediatric patients?", a: "Signs of poor perfusion (tachycardia, delayed capillary refill, cool extremities, weak pulses) but with <b>normal blood pressure</b>. Blood pressure is maintained by compensatory mechanisms." },
{ q: "What defines decompensated shock?", a: "Signs of poor perfusion <b>PLUS hypotension</b>. Indicates failure of compensatory mechanisms. Represents a <b>pre-arrest state</b>." },
{ q: "What is the definition of hypotension in children by age?", a: "<b>Term neonate:</b> SBP <60 mmHg. <b>1–12 months:</b> SBP <70. <b>1–10 years:</b> SBP < 70 + (2 × age in years). <b>>10 years:</b> SBP <90 mmHg." },
{ q: "What are the four main types of shock in children?", a: "<b>1) Hypovolemic</b> (most common — dehydration, hemorrhage). <b>2) Distributive</b> (sepsis, anaphylaxis). <b>3) Cardiogenic</b> (myocarditis, CHD). <b>4) Obstructive</b> (tension pneumothorax, tamponade, PE)." },
{ q: "What is the initial fluid bolus for pediatric shock?", a: "<b>20 mL/kg isotonic crystalloid</b> (NS or LR) over <b>5–20 minutes</b>. Reassess after each bolus. May repeat up to <b>60 mL/kg</b> in the first hour." },
{ q: "When should you limit fluid resuscitation in pediatric shock?", a: "In <b>cardiogenic shock</b> — give <b>5–10 mL/kg boluses</b> cautiously with frequent reassessment for signs of fluid overload (hepatomegaly, rales, worsening respiratory distress)." },
{ q: "What is the first-line vasopressor for fluid-refractory septic shock in children?", a: "<b>Epinephrine</b> (0.1–1 mcg/kg/min) for <b>cold shock</b> (poor perfusion, cool extremities). <b>Norepinephrine</b> (0.1–2 mcg/kg/min) for <b>warm shock</b> (vasodilation, flash capillary refill, bounding pulses)." },
{ q: "What is 'cold shock' vs 'warm shock' in pediatric sepsis?", a: "<b>Cold shock:</b> high SVR, low cardiac output → cool extremities, prolonged cap refill, weak pulses. <b>Warm shock:</b> low SVR, high cardiac output → warm extremities, flash cap refill, bounding pulses, wide pulse pressure." },
{ q: "What is the role of dopamine in pediatric shock?", a: "<b>Second-line vasopressor</b> (5–20 mcg/kg/min) when epinephrine or norepinephrine is unavailable. It has dose-dependent effects: low dose (dopaminergic), moderate (β-adrenergic), high (α-adrenergic)." },
{ q: "When should hydrocortisone be considered in pediatric septic shock?", a: "In <b>catecholamine-resistant shock</b>, especially if there is suspected <b>adrenal insufficiency</b> (e.g., prior steroid use, purpura fulminans/Waterhouse-Friderichsen). Dose: <b>2 mg/kg bolus</b>, then 50 mg/m²/day." },
{ q: "What are clinical signs of compensated shock in a child?", a: "1) <b>Tachycardia</b> (earliest sign). 2) Cool/mottled extremities. 3) Prolonged capillary refill (>2 sec). 4) Weak peripheral pulses. 5) Normal mental status initially. 6) <b>Normal blood pressure</b>. 7) Decreased urine output." },
{ q: "What is the minimum acceptable urine output in children?", a: "<b>Infants:</b> 2 mL/kg/hr. <b>Children:</b> 1 mL/kg/hr. <b>Adolescents:</b> 0.5 mL/kg/hr." },
{ q: "What is the Surviving Sepsis Campaign's 1-hour bundle for pediatric sepsis?", a: "1) Measure <b>lactate</b>. 2) Obtain <b>blood cultures</b> before antibiotics. 3) Administer <b>broad-spectrum antibiotics</b>. 4) Begin <b>rapid fluid resuscitation</b> (20 mL/kg boluses). 5) Start <b>vasopressors</b> if hypotension persists after fluids." },

// ===== STATUS EPILEPTICUS =====
{ q: "How is status epilepticus defined in children?", a: "A seizure lasting <b>≥5 minutes</b> OR ≥2 seizures without return to baseline consciousness between them (operational definition prompting treatment)." },
{ q: "What is the first-line treatment for pediatric status epilepticus?", a: "<b>Benzodiazepines:</b> IV <b>lorazepam 0.1 mg/kg</b> (max 4 mg/dose, may repeat once) or IV <b>diazepam 0.2 mg/kg</b> (max 10 mg). If no IV: <b>IM midazolam 0.2 mg/kg</b> (max 10 mg) or intranasal/buccal midazolam." },
{ q: "What is the advantage of midazolam over lorazepam for status epilepticus?", a: "<b>IM midazolam</b> can be given when IV access is not available. Studies show IM midazolam is <b>as effective as IV lorazepam</b> and may lead to faster time-to-treatment." },
{ q: "What is the rectal diazepam dose for pediatric seizures?", a: "<b>0.5 mg/kg rectally</b> (max 20 mg). Often used in the prehospital/home setting." },
{ q: "What second-line agents are used for benzodiazepine-refractory status epilepticus?", a: "<b>Fosphenytoin:</b> 20 mg PE/kg IV (max rate 150 mg PE/min). <b>Levetiracetam:</b> 40–60 mg/kg IV (max 4500 mg). <b>Valproic acid:</b> 20–40 mg/kg IV (avoid in <2 years, hepatic disease, metabolic disorders)." },
{ q: "What is the advantage of fosphenytoin over phenytoin?", a: "<b>Fosphenytoin</b> is a prodrug of phenytoin that can be given <b>faster IV and IM</b>, with less risk of <b>purple glove syndrome</b> and tissue necrosis. Dosed in <b>phenytoin equivalents (PE)</b>." },
{ q: "When is valproic acid contraindicated for status epilepticus in children?", a: "In children <b><2 years</b> (risk of hepatotoxicity), <b>hepatic disease</b>, <b>mitochondrial disorders</b> (especially POLG mutations), <b>urea cycle disorders</b>, and <b>pancreatitis</b>." },
{ q: "What defines refractory status epilepticus?", a: "Seizures persisting after <b>adequate doses of two appropriately chosen antiseizure medications</b> (typically a benzodiazepine + a second-line agent)." },
{ q: "How is refractory status epilepticus managed in children?", a: "<b>Continuous infusion</b> of midazolam (0.1–0.4 mg/kg/hr), pentobarbital, or propofol (avoid prolonged use in children — risk of <b>propofol infusion syndrome</b>). Requires <b>ICU admission</b> with continuous EEG monitoring." },
{ q: "What is propofol infusion syndrome?", a: "A rare, potentially fatal complication of prolonged propofol infusion: <b>metabolic acidosis, rhabdomyolysis, hyperkalemia, cardiac failure, lipemic serum</b>. More common in <b>children</b>. Avoid prolonged high-dose infusions." },

// ===== ANAPHYLAXIS =====
{ q: "What is the first-line treatment for pediatric anaphylaxis?", a: "<b>Epinephrine IM</b> into the <b>anterolateral thigh</b>. Dose: <b>0.01 mg/kg of 1:1,000 (1 mg/mL)</b>, max 0.3 mg in children, 0.5 mg in adolescents. Repeat every <b>5–15 minutes</b> as needed." },
{ q: "What concentration of epinephrine is used for anaphylaxis IM vs cardiac arrest IV?", a: "<b>Anaphylaxis IM:</b> 1:1,000 (1 mg/mL). <b>Cardiac arrest IV:</b> 1:10,000 (0.1 mg/mL). Never give 1:1,000 IV push — can cause fatal arrhythmia." },
{ q: "What are the diagnostic criteria for anaphylaxis?", a: "Acute onset (minutes to hours) with involvement of <b>≥2 organ systems</b>: 1) Skin/mucosal (urticaria, flushing, angioedema). 2) Respiratory (stridor, wheeze, dyspnea). 3) Cardiovascular (hypotension, syncope). 4) GI (vomiting, cramping). OR isolated hypotension after exposure to a <b>known allergen</b>." },
{ q: "What adjunct therapies are used in pediatric anaphylaxis?", a: "1) <b>IV fluid bolus</b> (20 mL/kg NS for hypotension). 2) <b>Albuterol</b> nebulized for bronchospasm. 3) <b>H1-antihistamine</b> (diphenhydramine 1 mg/kg). 4) <b>H2-blocker</b> (ranitidine). 5) <b>Corticosteroids</b> (methylprednisolone 1–2 mg/kg) to prevent biphasic reaction." },
{ q: "What is a biphasic anaphylactic reaction?", a: "Recurrence of anaphylaxis symptoms <b>4–12 hours</b> (up to 72 hours) after initial resolution. Occurs in ~5–20% of cases. Patients should be observed for <b>4–6 hours minimum</b> after treatment." },
{ q: "What is the EpiPen Jr dose and for what weight range?", a: "<b>EpiPen Jr: 0.15 mg</b> for children <b>15–30 kg</b>. <b>EpiPen: 0.3 mg</b> for patients <b>≥30 kg</b>." },
{ q: "When should an epinephrine infusion be started in anaphylaxis?", a: "For <b>refractory anaphylaxis</b> not responding to repeated IM epinephrine doses. Infusion: <b>0.1–1 mcg/kg/min IV</b>, titrated to effect." },

// ===== DROWNING & HYPOTHERMIA =====
{ q: "What is the definition of drowning?", a: "The process of experiencing <b>respiratory impairment from submersion/immersion in liquid</b>. The terms 'near-drowning,' 'wet/dry drowning' are no longer recommended." },
{ q: "What is the primary pathophysiology of drowning?", a: "<b>Hypoxia</b> from aspiration and/or laryngospasm. Leads to surfactant washout, pulmonary edema, atelectasis, and V/Q mismatch. Neurologic injury from hypoxia is the main determinant of outcome." },
{ q: "What is the initial management priority for a drowning victim?", a: "<b>Ventilation and oxygenation</b> are the priority (unlike adult cardiac arrest where compressions come first). Begin <b>rescue breaths</b> as soon as possible, even in the water if trained." },
{ q: "What are poor prognostic factors in pediatric drowning?", a: "1) <b>Submersion >5 minutes</b>. 2) Delay in CPR >10 minutes. 3) Resuscitation >25 minutes. 4) GCS 3 on arrival to ED. 5) Fixed dilated pupils. 6) Warm water (vs cold water)." },
{ q: "Why does cold water submersion have a slightly better prognosis?", a: "Rapid <b>hypothermia</b> decreases cerebral metabolic demand, providing some neuroprotection. The <b>diving reflex</b> (bradycardia, peripheral vasoconstriction, blood shunting to brain/heart) may also play a role, especially in young children." },
{ q: "What is the classification of hypothermia by core temperature?", a: "<b>Mild:</b> 32–35°C (shivering, tachycardia). <b>Moderate:</b> 28–32°C (shivering stops, bradycardia, atrial fibrillation). <b>Severe:</b> <28°C (VF risk, asystole, coma)." },
{ q: "What is the rewarming strategy for moderate-to-severe hypothermia?", a: "<b>Active core rewarming:</b> warm IV fluids (40–42°C), warm humidified oxygen, bladder/gastric lavage, peritoneal lavage. For cardiac arrest: consider <b>ECMO/cardiopulmonary bypass</b> (most effective)." },
{ q: "What is the key resuscitation principle in hypothermic cardiac arrest?", a: "<b>'Not dead until warm and dead.'</b> Continue CPR until core temperature is ≥32°C (or rewarming efforts are exhausted). Defibrillation may be ineffective below 30°C — limit to one attempt and retry after rewarming." },
{ q: "At what core temperature does the risk of ventricular fibrillation increase?", a: "<b><28°C</b> (severe hypothermia). The myocardium becomes increasingly irritable and prone to VF." },

// ===== ENVIRONMENTAL EMERGENCIES =====
{ q: "What are the signs and symptoms of pediatric heat stroke?", a: "<b>Core temperature >40°C (104°F)</b>, altered mental status (confusion, seizures, coma), <b>hot dry skin</b> (or diaphoresis in exertional heat stroke), tachycardia, hypotension." },
{ q: "What is the immediate treatment for pediatric heat stroke?", a: "<b>Rapid cooling:</b> cold water immersion (most effective), evaporative cooling (undress, mist with water, fan). Target: reduce temperature to <b><39°C within 30 minutes</b>. IV fluids, treat seizures." },

// ===== NEONATAL RESUSCITATION (NRP) =====
{ q: "What are the initial steps of neonatal resuscitation (NRP)?", a: "1) <b>Warm</b> (radiant warmer, plastic wrap for preterms). 2) <b>Dry</b> and stimulate. 3) <b>Position</b> airway (sniffing position). 4) <b>Suction</b> if needed (mouth then nose). 5) Assess HR and respirations." },
{ q: "What is the target heart rate for assessing a newborn's response to resuscitation?", a: "<b>HR ≥100 bpm</b> indicates adequate response. If HR <100 bpm after initial steps, begin <b>positive pressure ventilation (PPV)</b>." },
{ q: "When should PPV be initiated in a newborn?", a: "If the newborn is <b>apneic, gasping, or HR <100 bpm</b> after initial steps (warm, dry, stimulate). PPV is the <b>single most effective step</b> in neonatal resuscitation." },
{ q: "What is the initial FiO₂ for PPV in term neonates?", a: "<b>21% (room air)</b>. Titrate based on preductal SpO₂. For preterm <35 weeks: start at <b>21–30%</b>." },
{ q: "What are the target preductal SpO₂ values after birth?", a: "<b>1 min:</b> 60–65%. <b>2 min:</b> 65–70%. <b>3 min:</b> 70–75%. <b>4 min:</b> 75–80%. <b>5 min:</b> 80–85%. <b>10 min:</b> 85–95%." },
{ q: "What PPV rate is used in neonatal resuscitation?", a: "<b>40–60 breaths per minute</b> (squeeze-two-three rhythm)." },
{ q: "What is the MR SOPA mnemonic for ineffective PPV?", a: "<b>M</b> — Mask adjustment (ensure seal). <b>R</b> — Reposition airway (sniffing position). <b>S</b> — Suction mouth and nose. <b>O</b> — Open mouth. <b>P</b> — Pressure increase. <b>A</b> — Alternative airway (ETT or LMA)." },
{ q: "When are chest compressions started in neonatal resuscitation?", a: "If HR remains <b><60 bpm despite 30 seconds of effective PPV</b> (with adequate chest rise)." },
{ q: "What is the compression-to-ventilation ratio in neonatal resuscitation?", a: "<b>3:1</b> (3 compressions to 1 ventilation), delivering ~<b>120 events per minute</b> (90 compressions + 30 breaths)." },
{ q: "What technique is used for neonatal chest compressions?", a: "<b>Two-thumb encircling technique</b> (preferred). Compress the <b>lower third of the sternum</b> to a depth of <b>one-third AP diameter</b> of the chest." },
{ q: "When is epinephrine indicated in neonatal resuscitation?", a: "If HR remains <b><60 bpm despite effective ventilation AND chest compressions for 60 seconds</b>." },
{ q: "What is the epinephrine dose in neonatal resuscitation?", a: "<b>IV/IO (UVC preferred):</b> 0.01–0.03 mg/kg (0.1–0.3 mL/kg of 1:10,000). <b>ET:</b> 0.05–0.1 mg/kg (0.5–1 mL/kg of 1:10,000) while IV access is being established." },
{ q: "What is the preferred route for epinephrine in neonatal resuscitation?", a: "<b>Umbilical venous catheter (UVC)</b>. It provides rapid, reliable vascular access in the delivery room. ET route is less reliable." },
{ q: "What volume expander is used in neonatal resuscitation?", a: "<b>Normal saline or O-negative blood</b> at <b>10 mL/kg IV</b> over 5–10 minutes. Indicated for suspected hypovolemia (pallor, weak pulses, poor response to resuscitation)." },
{ q: "Should meconium-stained amniotic fluid prompt routine suctioning of a vigorous newborn?", a: "<b>No.</b> Current NRP guidelines do NOT recommend routine intubation and tracheal suctioning for vigorous newborns with meconium-stained fluid. Provide standard initial steps." },
{ q: "When is intubation and tracheal suctioning considered for meconium?", a: "Only if the newborn is <b>non-vigorous</b> (apneic, limp, HR <100 bpm) AND direct laryngoscopy is performed by a skilled provider. However, PPV should not be delayed for suctioning." },

// ===== PEDIATRIC TRAUMA =====
{ q: "What does the ABCDE approach in pediatric trauma stand for?", a: "<b>A</b> — Airway (with C-spine protection). <b>B</b> — Breathing (ventilation). <b>C</b> — Circulation (hemorrhage control). <b>D</b> — Disability (neurologic status). <b>E</b> — Exposure/Environment (fully undress, prevent hypothermia)." },
{ q: "What is the weight estimation formula for children aged 1–10 years?", a: "<b>Weight (kg) = 2 × (age in years + 4)</b>. Example: 5-year-old ≈ 2 × 9 = 18 kg." },
{ q: "What is the Broselow tape?", a: "A <b>length-based resuscitation tape</b> that estimates a child's weight based on height. It provides color-coded zones with pre-calculated <b>drug doses, equipment sizes, and fluid volumes</b>." },
{ q: "What is the most common cause of death in pediatric trauma?", a: "<b>Traumatic brain injury (TBI)</b>. Head injuries are more common in children due to their proportionally larger head size." },
{ q: "What is the most commonly injured solid organ in pediatric blunt abdominal trauma?", a: "<b>Spleen</b> (most common), followed by the <b>liver</b>. Most pediatric solid organ injuries are managed <b>non-operatively</b>." },
{ q: "What is the initial fluid bolus for pediatric hemorrhagic shock?", a: "<b>20 mL/kg isotonic crystalloid</b>. May repeat ×2. If still hemodynamically unstable, transfuse <b>10 mL/kg pRBCs</b>." },
{ q: "What are signs of tension pneumothorax in a child?", a: "<b>Tracheal deviation</b> (away from affected side), <b>absent breath sounds</b> on affected side, <b>hypotension</b>, <b>JVD</b>, <b>hyperresonance to percussion</b>. Treat immediately with <b>needle decompression</b> (2nd ICS, midclavicular line) followed by chest tube." },
{ q: "What are the GCS modifications for pediatric patients?", a: "The <b>verbal component</b> is modified for preverbal children: <b>5</b> = coos/babbles, <b>4</b> = irritable cry, <b>3</b> = cries to pain, <b>2</b> = moans, <b>1</b> = none." },
{ q: "Why are children more susceptible to hypothermia during trauma resuscitation?", a: "Children have a <b>larger body surface area to weight ratio</b>, thinner skin, and less subcutaneous fat, leading to greater <b>heat loss</b>. Hypothermia worsens coagulopathy and acidosis." },
{ q: "What is the 'lethal triad' in trauma?", a: "<b>Hypothermia, acidosis, and coagulopathy</b>. Each worsens the others, creating a vicious cycle that increases mortality." },

// ===== ADDITIONAL HIGH-YIELD TOPICS =====
{ q: "What is the Pediatric Assessment Triangle (PAT)?", a: "A rapid (<30 second) visual assessment: 1) <b>Appearance</b> (tone, interactivity, consolability, look/gaze, speech/cry — TICLS). 2) <b>Work of Breathing</b> (retractions, nasal flaring, positioning). 3) <b>Circulation to Skin</b> (pallor, mottling, cyanosis)." },
{ q: "What does the TICLS mnemonic assess in the PAT?", a: "<b>T</b>one, <b>I</b>nteractiveness, <b>C</b>onsolability, <b>L</b>ook/gaze, <b>S</b>peech/cry. Abnormalities suggest altered mental status or serious illness." },
{ q: "What is the AVPU scale?", a: "A rapid neurologic assessment: <b>A</b> = Alert, <b>V</b> = responds to Voice, <b>P</b> = responds to Pain, <b>U</b> = Unresponsive. 'P' roughly correlates with GCS ≤8." },
{ q: "What are the normal heart rate ranges by pediatric age?", a: "<b>Newborn:</b> 100–180. <b>Infant:</b> 100–160. <b>Toddler:</b> 90–150. <b>Preschool:</b> 80–140. <b>School-age:</b> 70–120. <b>Adolescent:</b> 60–100 bpm." },
{ q: "What are normal respiratory rate ranges by age?", a: "<b>Newborn:</b> 30–60. <b>Infant:</b> 24–40. <b>Toddler:</b> 22–34. <b>Preschool:</b> 20–30. <b>School-age:</b> 16–22. <b>Adolescent:</b> 12–20 breaths/min." },
{ q: "What is the formula to estimate systolic BP lower limit (5th percentile) in children 1–10 years?", a: "<b>SBP = 70 + (2 × age in years)</b> mmHg. Below this value indicates hypotension." },
{ q: "What is the maintenance IV fluid rate formula (Holliday-Segar)?", a: "<b>4 mL/kg/hr</b> for first 10 kg + <b>2 mL/kg/hr</b> for next 10 kg + <b>1 mL/kg/hr</b> for each kg >20 kg." },
{ q: "What is the blood volume estimate by age?", a: "<b>Premature infant:</b> 90–100 mL/kg. <b>Term neonate:</b> 80 mL/kg. <b>Infant:</b> 75–80 mL/kg. <b>Child/Adolescent:</b> 70 mL/kg." },
{ q: "What is rapid sequence intubation (RSI) in pediatrics?", a: "Administration of a <b>sedative + neuromuscular blocking agent</b> simultaneously to facilitate emergent intubation. Typical agents: <b>etomidate</b> (or ketamine) + <b>rocuronium</b> (or succinylcholine). Preoxygenation for 3–5 minutes before." },
{ q: "When is succinylcholine contraindicated in pediatric RSI?", a: "In <b>hyperkalemia, burns >24 hrs old, crush injuries, denervation injuries, malignant hyperthermia susceptibility, and myopathies</b>. Risk of fatal hyperkalemic cardiac arrest. <b>Rocuronium</b> is preferred in children." },
{ q: "What is the dose of ketamine for pediatric RSI?", a: "<b>1–2 mg/kg IV</b>. Advantages: maintains airway reflexes, provides analgesia, does not cause hypotension (increases sympathetic tone). Avoid in suspected <b>elevated ICP</b> (controversial)." },
{ q: "What is the dose of etomidate for pediatric RSI?", a: "<b>0.3 mg/kg IV</b>. Provides hemodynamic stability. Caution: may cause <b>adrenal suppression</b> with even a single dose." },
{ q: "What glucose level defines hypoglycemia in neonates, and why is it dangerous?", a: "<b><45 mg/dL</b> (some use <40). The neonatal brain is highly dependent on glucose. Symptoms: jitteriness, seizures, lethargy, apnea. Treat with <b>D10W 2 mL/kg IV bolus</b>." },
{ q: "What concentration of dextrose should be given to neonates for hypoglycemia?", a: "<b>D10W (10% dextrose)</b> at 2 mL/kg IV. Do NOT give D25 or D50 to neonates — hyperosmolar solutions can cause <b>cerebral edema and IVH</b>." },
{ q: "What is the dose of naloxone for opioid-induced respiratory depression in children?", a: "<b>0.1 mg/kg IV/IM/IO</b> (max 2 mg) for full reversal. May need repeated doses every 2–3 minutes due to short half-life. Not recommended routinely in neonatal resuscitation." },
{ q: "What is the PALS approach to the non-breathing child with a pulse?", a: "Provide <b>rescue breathing</b>: 1 breath every <b>3–5 seconds</b> (12–20/min for children) or every <b>2–3 seconds</b> (20–30/min for infants). Check pulse every <b>2 minutes</b>. If pulse <60 with poor perfusion → start CPR." },
{ q: "What are the indications for transcutaneous pacing in children?", a: "<b>Symptomatic bradycardia due to complete AV block or sinus node dysfunction</b> unresponsive to epinephrine and atropine. NOT useful in asystole." },
{ q: "What end-tidal CO₂ (ETCO₂) value during CPR suggests adequate compressions?", a: "<b>ETCO₂ ≥10–15 mmHg</b> indicates adequate perfusion from compressions. An abrupt rise to <b>≥35–40 mmHg</b> may indicate <b>ROSC</b>." },
{ q: "What are the signs of ROSC during pediatric resuscitation?", a: "1) <b>Palpable pulse</b>. 2) Sudden sustained rise in <b>ETCO₂</b> (≥40 mmHg). 3) <b>Arterial waveform</b> on monitor. 4) Spontaneous respirations or movement." },
{ q: "What is commotio cordis?", a: "Sudden cardiac arrest (VF) caused by a <b>blunt, non-penetrating blow to the precordium</b> during the vulnerable phase of repolarization (just before T-wave peak). Common in young athletes hit by a ball. Treatment: <b>immediate defibrillation</b>." },
{ q: "What is the dose of calcium chloride in pediatric cardiac arrest due to hyperkalemia?", a: "<b>20 mg/kg (0.2 mL/kg of 10% CaCl₂)</b> IV slow push. Calcium stabilizes the myocardial membrane. Use <b>calcium gluconate</b> (60 mg/kg) via peripheral IV to reduce extravasation risk." },
{ q: "What is the dose of sodium bicarbonate in pediatric cardiac arrest?", a: "<b>1 mEq/kg IV</b>. Indicated only for documented metabolic acidosis, hyperkalemia, or sodium channel blocker overdose. Not routinely recommended in arrest." },
{ q: "What is the appropriate IV fluid for DKA resuscitation in children?", a: "<b>10–20 mL/kg NS bolus</b> (more conservative than sepsis). Avoid aggressive fluid resuscitation due to risk of <b>cerebral edema</b>. Total fluids over 24–48 hours should correct deficit gradually." },
{ q: "What is the most feared complication of fluid resuscitation in pediatric DKA?", a: "<b>Cerebral edema</b>. Signs: headache, altered mental status, bradycardia, hypertension, posturing. Treat with <b>mannitol 0.5–1 g/kg IV</b> or <b>hypertonic saline (3%) 2.5–5 mL/kg</b>." },
{ q: "What is the recommended epinephrine dose for croup (racemic)?", a: "<b>Racemic epinephrine 2.25%:</b> 0.5 mL nebulized in 3 mL NS. Or <b>L-epinephrine 1:1,000:</b> 0.5 mL/kg (max 5 mL) nebulized. Effects last ~2 hours — observe for <b>rebound stridor</b>." },
{ q: "What is the key difference between upper and lower airway obstruction on exam?", a: "<b>Upper airway:</b> inspiratory stridor, prolonged inspiration, suprasternal retractions. <b>Lower airway:</b> expiratory wheezing, prolonged expiration, intercostal/subcostal retractions." }
          ]
        },
        {
          section: 'Advanced Pediatrics',
          topic: "Congenital heart disease",
          icon: "heart",
          cards: [
            // ===== FETAL CIRCULATION =====
{ q: "Name the three fetal shunts that bypass the lungs and liver.", a: "<b>1. Ductus venosus</b> (bypasses liver), <b>2. Foramen ovale</b> (RA → LA, bypasses lungs), <b>3. Ductus arteriosus</b> (PA → aorta, bypasses lungs)." },
{ q: "What is the function of the ductus venosus in fetal circulation?", a: "Shunts oxygenated blood from the <b>umbilical vein</b> directly into the <b>IVC</b>, bypassing the hepatic sinusoids." },
{ q: "What structure does the ductus venosus become after birth?", a: "The <b>ligamentum venosum</b>." },
{ q: "What is the direction of blood flow through the foramen ovale in the fetus?", a: "From the <b>right atrium to the left atrium</b> (right-to-left shunt), bypassing the pulmonary circulation." },
{ q: "What remnant does the foramen ovale become after closure?", a: "The <b>fossa ovalis</b>." },
{ q: "What is the direction of blood flow through the ductus arteriosus?", a: "From the <b>pulmonary artery to the descending aorta</b> (right-to-left), diverting blood away from the high-resistance fetal lungs." },
{ q: "What remnant does the ductus arteriosus become after closure?", a: "The <b>ligamentum arteriosum</b>." },
{ q: "What two events trigger the transition from fetal to neonatal circulation at birth?", a: "<b>1. First breath</b> → ↓ pulmonary vascular resistance (PVR). <b>2. Clamping of umbilical cord</b> → ↑ systemic vascular resistance (SVR). This reverses the pressure gradient, closing fetal shunts." },
{ q: "What mediates functional closure of the ductus arteriosus after birth?", a: "Increased <b>PaO₂</b> and decreased <b>prostaglandin E₂ (PGE₂)</b> levels cause smooth muscle contraction and ductal closure within 24–72 hours." },
{ q: "Which drugs are used to close a hemodynamically significant PDA in preterm infants?", a: "<b>Indomethacin</b> or <b>ibuprofen</b> — both are prostaglandin synthesis inhibitors (COX inhibitors) that promote ductal closure." },
{ q: "What is the advantage of ibuprofen over indomethacin for PDA closure?", a: "Ibuprofen has <b>fewer renal side effects</b> (less reduction in renal, mesenteric, and cerebral blood flow) compared to indomethacin." },
{ q: "When is prostaglandin E₁ (alprostadil) used in neonates with CHD?", a: "To <b>maintain PDA patency</b> in duct-dependent lesions (e.g., TGA, critical coarctation, HLHS, pulmonary atresia) until surgical intervention." },
{ q: "What is a major side effect of prostaglandin E₁ infusion in neonates?", a: "<b>Apnea</b> — neonates on PGE₁ may require intubation and mechanical ventilation. Other side effects: fever, hypotension, flushing." },
{ q: "In fetal circulation, which vessel carries the most highly oxygenated blood?", a: "The <b>umbilical vein</b> (PaO₂ ~30–35 mmHg), carrying oxygenated blood from the placenta to the fetus." },

// ===== ACYANOTIC LESIONS (LEFT-TO-RIGHT SHUNTS) =====
{ q: "What is the most common congenital heart defect?", a: "<b>Ventricular septal defect (VSD)</b> — accounts for ~25–30% of all CHD." },
{ q: "What are the four anatomic types of VSD?", a: "<b>1. Perimembranous</b> (most common, ~80%), <b>2. Muscular/trabecular</b>, <b>3. Inlet (AV canal type)</b>, <b>4. Outlet/supracristal (subpulmonary)</b>." },
{ q: "What murmur is characteristic of a VSD?", a: "<b>Holosystolic (pansystolic) murmur</b> best heard at the <b>left lower sternal border</b>, often with a thrill." },
{ q: "Why does a small (restrictive) VSD produce a louder murmur than a large VSD?", a: "A small defect creates a <b>greater pressure gradient</b> and higher velocity jet across the septum, producing a louder murmur. Large VSDs equalize pressures → softer murmur." },
{ q: "What is the natural history of a small muscular VSD?", a: "Most <b>close spontaneously</b> by age 2–4 years (up to 80% of small muscular VSDs). Perimembranous VSDs may also close but less frequently." },
{ q: "When is surgical repair indicated for a VSD?", a: "Large VSD with <b>heart failure symptoms</b>, failure to thrive, <b>Qp:Qs ratio ≥ 2:1</b>, or development of pulmonary hypertension despite medical management." },
{ q: "What complications can arise from a large, unrepaired VSD?", a: "<b>CHF</b>, failure to thrive, recurrent respiratory infections, <b>pulmonary hypertension</b>, and eventual <b>Eisenmenger syndrome</b>." },
{ q: "What is the most common type of ASD?", a: "<b>Ostium secundum ASD</b> (~75% of all ASDs) — located in the central portion of the atrial septum at the fossa ovalis." },
{ q: "How does an ostium primum ASD differ from ostium secundum?", a: "Primum ASD is located in the <b>lower atrial septum</b> near the AV valves, is associated with <b>AV valve abnormalities</b> (cleft mitral valve), and is part of the spectrum of <b>endocardial cushion defects</b>." },
{ q: "What is the classic auscultatory finding in ASD?", a: "<b>Wide, fixed splitting of S2</b> — the split does not vary with respiration because the ASD equalizes filling between atria." },
{ q: "What additional murmur may be heard with an ASD?", a: "A <b>systolic ejection murmur</b> at the upper left sternal border (from increased flow across the pulmonic valve) and possibly a <b>mid-diastolic rumble</b> at the lower left sternal border (increased flow across the tricuspid valve)." },
{ q: "Why do most children with ASD remain asymptomatic for years?", a: "The left-to-right shunt is <b>low-pressure</b> (atrial level), so volume overload develops slowly. Symptoms (exercise intolerance, arrhythmias) typically appear in <b>adulthood</b> if untreated." },
{ q: "What is the classic murmur of patent ductus arteriosus (PDA)?", a: "<b>Continuous 'machinery' murmur</b> best heard at the <b>left infraclavicular area</b> (upper left sternal border), extending through systole and diastole." },
{ q: "In which patient population is PDA most common?", a: "<b>Premature infants</b> — the incidence is inversely related to gestational age. Also associated with <b>maternal rubella</b> infection and high altitude." },
{ q: "What are the clinical signs of a hemodynamically significant PDA?", a: "<b>Bounding (widened) peripheral pulses</b>, widened pulse pressure, hyperdynamic precordium, tachycardia, and signs of CHF (tachypnea, hepatomegaly)." },
{ q: "What is an atrioventricular (AV) canal defect (endocardial cushion defect)?", a: "A combination of <b>ostium primum ASD + inlet VSD + common AV valve</b>. It results from failure of endocardial cushion development." },
{ q: "What chromosomal abnormality is most strongly associated with AV canal defects?", a: "<b>Trisomy 21 (Down syndrome)</b> — approximately 40–50% of children with Down syndrome have CHD, and AV canal defect is the most common type." },
{ q: "What is coarctation of the aorta?", a: "A <b>discrete narrowing of the aorta</b>, typically at or near the <b>insertion of the ductus arteriosus</b> (juxtaductal), causing upper extremity hypertension and lower extremity hypoperfusion." },
{ q: "What classic physical exam finding is seen in coarctation of the aorta?", a: "<b>Blood pressure discrepancy</b>: higher BP in upper extremities than lower extremities, and <b>diminished/delayed femoral pulses</b> compared to brachial pulses (radio-femoral delay)." },
{ q: "What CXR finding is associated with coarctation of the aorta in older children?", a: "<b>Rib notching</b> (of the inferior aspect of ribs 3–8) due to dilated intercostal collateral arteries, and a <b>'figure 3' sign</b> of the aortic knob." },
{ q: "What genetic syndrome is most commonly associated with coarctation of the aorta?", a: "<b>Turner syndrome (45,X)</b> — coarctation is found in 10–20% of Turner syndrome patients. Also associated with <b>bicuspid aortic valve</b>." },
{ q: "What is the difference between preductal and postductal coarctation?", a: "<b>Preductal (infantile)</b>: narrowing proximal to the ductus arteriosus; duct-dependent, presents in neonates with shock. <b>Postductal (adult)</b>: narrowing distal to ductus; presents with upper extremity hypertension, collateral formation." },
{ q: "How does critical preductal coarctation present in neonates?", a: "When the PDA closes, the neonate develops <b>acute cardiovascular collapse</b>: shock, metabolic acidosis, differential cyanosis (lower body cyanotic), absent femoral pulses. Requires <b>PGE₁</b> to maintain ductal patency." },

// ===== CYANOTIC LESIONS (RIGHT-TO-LEFT SHUNTS) — THE 5 T's =====
{ q: "What are the '5 T's' of cyanotic congenital heart disease?", a: "<b>1. Tetralogy of Fallot</b>, <b>2. Transposition of the Great Arteries</b>, <b>3. Tricuspid Atresia</b>, <b>4. Total Anomalous Pulmonary Venous Return (TAPVR)</b>, <b>5. Truncus Arteriosus</b>." },
{ q: "What is the most common cyanotic congenital heart defect?", a: "<b>Tetralogy of Fallot (TOF)</b> — the most common cyanotic CHD presenting beyond the neonatal period." },
{ q: "What are the four components of Tetralogy of Fallot?", a: "<b>1. VSD</b> (large, unrestrictive), <b>2. Overriding aorta</b>, <b>3. Right ventricular outflow tract (RVOT) obstruction</b> (subvalvular, valvular, or supravalvular PS), <b>4. Right ventricular hypertrophy (RVH)</b>." },
{ q: "Which component of TOF determines the severity of cyanosis?", a: "The degree of <b>RVOT obstruction</b> — more severe obstruction causes greater right-to-left shunting through the VSD and more cyanosis." },
{ q: "What is a 'tet spell' (hypercyanotic spell)?", a: "Acute episodes of <b>severe cyanosis, hyperpnea, irritability, and syncope</b> caused by sudden increase in RVOT obstruction (infundibular spasm) → ↑ right-to-left shunt. Can be life-threatening." },
{ q: "What triggers tet spells?", a: "<b>Crying, feeding, defecation, agitation, fever, dehydration</b> — anything that ↑ heart rate, ↓ SVR, or ↑ infundibular spasm." },
{ q: "How do you manage an acute tet spell?", a: "<b>1. Knee-chest position</b> (↑ SVR), <b>2. Oxygen</b>, <b>3. IV fluid bolus</b>, <b>4. Morphine</b> (calms, ↓ hyperpnea), <b>5. Phenylephrine</b> (↑ SVR), <b>6. IV propranolol/esmolol</b> (relaxes infundibulum). Avoid digoxin and diuretics." },
{ q: "Why does squatting relieve cyanosis in TOF?", a: "Squatting <b>kinks the femoral arteries</b>, increasing systemic vascular resistance (SVR). This ↓ the right-to-left shunt and forces more blood through the RVOT into the pulmonary circulation." },
{ q: "What is the classic CXR finding in Tetralogy of Fallot?", a: "<b>Boot-shaped heart (coeur en sabot)</b> — due to RVH with an upturned apex and a concave main pulmonary artery segment, with <b>decreased pulmonary vascular markings</b>." },
{ q: "What is the definitive surgical repair for Tetralogy of Fallot?", a: "<b>Complete intracardiac repair</b>: VSD closure with a patch and relief of RVOT obstruction (resection of infundibular muscle, ± transannular patch). Usually performed at <b>3–6 months</b> of age." },
{ q: "What palliative procedure may be used before definitive TOF repair?", a: "<b>Modified Blalock-Taussig (BT) shunt</b> — a Gore-Tex graft from the <b>subclavian artery to the pulmonary artery</b>, providing temporary pulmonary blood flow." },
{ q: "What is Transposition of the Great Arteries (TGA)?", a: "The <b>aorta arises from the RV</b> and the <b>pulmonary artery arises from the LV</b>, creating two parallel circuits. Incompatible with life unless there is <b>mixing</b> (ASD, VSD, or PDA)." },
{ q: "What is the most common cyanotic heart defect presenting in the first 24 hours of life?", a: "<b>D-Transposition of the Great Arteries (d-TGA)</b> — presents with severe cyanosis at birth that is unresponsive to supplemental oxygen." },
{ q: "What is the classic CXR finding in TGA?", a: "<b>'Egg-on-a-string' (egg-shaped heart)</b> — narrow superior mediastinum (due to the anteroposterior relationship of the great arteries) with an egg-shaped cardiac silhouette." },
{ q: "What is the Rashkind balloon atrial septostomy?", a: "An emergency <b>catheter-based procedure</b> to enlarge the foramen ovale/create an ASD, allowing <b>mixing of oxygenated and deoxygenated blood</b> at the atrial level. Used as a bridge in TGA." },
{ q: "What is the definitive surgery for d-TGA?", a: "<b>Arterial switch operation (Jatene procedure)</b> — the great arteries are transected and reconnected to the correct ventricles, with coronary artery reimplantation. Performed within the <b>first 2 weeks</b> of life." },
{ q: "Why must the arterial switch operation for TGA be performed early?", a: "The <b>LV must retain its muscle mass</b> to support systemic circulation. After birth, the LV (pumping to the low-resistance pulmonary circuit) quickly deconditions and cannot be used as the systemic ventricle." },
{ q: "What is tricuspid atresia?", a: "Complete absence of the tricuspid valve → <b>no communication between the RA and RV</b>. Blood must flow through an <b>ASD (obligatory)</b> to reach the left heart. Associated with hypoplastic RV." },
{ q: "What is the classic ECG finding in tricuspid atresia?", a: "<b>Left axis deviation (LAD)</b>, RA enlargement, and <b>LV hypertrophy</b> — unusual for a cyanotic lesion (most cyanotic lesions show RVH)." },
{ q: "What is Total Anomalous Pulmonary Venous Return (TAPVR)?", a: "All four pulmonary veins drain into <b>systemic venous structures</b> (SVC, coronary sinus, or infradiaphragmatic veins) rather than the left atrium. An <b>ASD is essential</b> for survival." },
{ q: "What are the three types of TAPVR?", a: "<b>1. Supracardiac</b> (most common — drains to SVC via vertical vein), <b>2. Cardiac</b> (drains to coronary sinus or RA), <b>3. Infracardiac/infradiaphragmatic</b> (drains below diaphragm — highest risk of obstruction)." },
{ q: "What is the classic CXR finding in supracardiac TAPVR?", a: "<b>'Snowman' sign (figure-of-eight)</b> — the dilated vertical vein, innominate vein, and SVC form the 'head' of the snowman; the heart forms the 'body'. Usually seen after several months." },
{ q: "Which type of TAPVR is a surgical emergency?", a: "<b>Infradiaphragmatic (infracardiac) TAPVR</b> — the venous drainage passes through the diaphragm and is frequently <b>obstructed</b>, causing severe pulmonary edema and cyanosis in the newborn." },
{ q: "What is truncus arteriosus?", a: "A <b>single arterial trunk</b> arises from both ventricles, giving rise to the aorta, pulmonary arteries, and coronary arteries. Always associated with a <b>VSD</b>. Results from failure of the <b>truncoconal septum</b> to divide." },
{ q: "What genetic syndrome is associated with truncus arteriosus?", a: "<b>DiGeorge syndrome (22q11.2 deletion)</b> — features include truncus arteriosus or interrupted aortic arch, thymic hypoplasia, hypocalcemia, and facial dysmorphism (CATCH-22)." },
{ q: "How does truncus arteriosus present clinically?", a: "Presents in the neonatal period with <b>mild cyanosis, CHF, bounding pulses, wide pulse pressure</b>, and a systolic ejection murmur. Single loud S2 (only one semilunar valve)." },

// ===== OBSTRUCTIVE LESIONS =====
{ q: "What is the most common cause of aortic stenosis in children?", a: "<b>Bicuspid aortic valve</b> — present in ~1–2% of the population. It is the most common congenital valvular anomaly." },
{ q: "What murmur is heard in aortic stenosis?", a: "<b>Systolic ejection murmur (crescendo-decrescendo)</b> at the <b>right upper sternal border</b> radiating to the carotids, often with an <b>ejection click</b>." },
{ q: "What are the three levels of congenital aortic stenosis?", a: "<b>1. Valvular</b> (most common — bicuspid valve), <b>2. Subvalvular</b> (discrete membrane or fibromuscular ridge), <b>3. Supravalvular</b> (associated with <b>Williams syndrome</b>)." },
{ q: "What syndrome is associated with supravalvular aortic stenosis?", a: "<b>Williams syndrome</b> (7q11.23 deletion) — features include 'elfin' facies, intellectual disability, hypercalcemia, and supravalvular aortic stenosis." },
{ q: "What murmur is characteristic of pulmonic stenosis?", a: "<b>Systolic ejection murmur</b> at the <b>left upper sternal border</b> with an <b>ejection click</b> that decreases with inspiration. Wide splitting of S2." },
{ q: "What syndrome is associated with pulmonic stenosis?", a: "<b>Noonan syndrome</b> — features include short stature, webbed neck, pectus excavatum, and <b>dysplastic pulmonic valve stenosis</b>." },
{ q: "What is the treatment for significant valvular pulmonic stenosis?", a: "<b>Balloon valvuloplasty</b> (percutaneous catheter-based) — this is the preferred intervention for isolated valvular PS with a gradient >40–50 mmHg." },
{ q: "What is Hypoplastic Left Heart Syndrome (HLHS)?", a: "Underdevelopment of the <b>left side of the heart</b>: hypoplastic LV, mitral atresia or stenosis, aortic atresia or stenosis, and hypoplastic ascending aorta. The <b>RV supports both circulations</b>." },
{ q: "Why is HLHS considered a 'duct-dependent' lesion?", a: "Systemic blood flow depends entirely on a <b>PDA</b> (right-to-left shunt from PA to aorta). PDA closure leads to <b>cardiogenic shock and death</b>. PGE₁ infusion is critical." },
{ q: "What is the staged surgical palliation for HLHS?", a: "<b>Stage 1: Norwood</b> (neonatal — reconstruct aorta, BT shunt), <b>Stage 2: Glenn/hemi-Fontan</b> (~4–6 months — SVC to PA), <b>Stage 3: Fontan</b> (~2–4 years — IVC to PA, completes total cavopulmonary connection)." },
{ q: "What does the Norwood procedure accomplish?", a: "Creates a <b>neo-aorta</b> from the pulmonary artery and hypoplastic aorta, establishes pulmonary blood flow via a <b>BT shunt or Sano shunt (RV-PA conduit)</b>, and ensures unrestricted atrial communication." },
{ q: "What does the Fontan procedure accomplish?", a: "Directs <b>IVC blood to the pulmonary arteries</b> (via lateral tunnel or extracardiac conduit), completing the total cavopulmonary connection so that all systemic venous return goes directly to the lungs without passing through a ventricle." },

// ===== EISENMENGER SYNDROME =====
{ q: "What is Eisenmenger syndrome?", a: "The <b>reversal of a left-to-right shunt to a right-to-left shunt</b> due to progressive pulmonary vascular disease and irreversible pulmonary hypertension." },
{ q: "Which congenital heart defects can lead to Eisenmenger syndrome?", a: "Large, unrepaired <b>VSD, ASD, PDA, or AV canal defect</b> — any lesion causing chronic excessive pulmonary blood flow and progressive pulmonary vascular remodeling." },
{ q: "What are the clinical features of Eisenmenger syndrome?", a: "<b>Cyanosis, clubbing, polycythemia, hemoptysis, syncope, exercise intolerance</b>. Previously acyanotic patient now becomes cyanotic." },
{ q: "Why is surgical repair contraindicated in Eisenmenger syndrome?", a: "The pulmonary vascular disease is <b>irreversible</b>. Closing the shunt would cause RV failure (no 'pop-off' for the high RV pressures). The only definitive treatment is <b>heart-lung transplantation</b>." },
{ q: "How does Eisenmenger syndrome affect the S2 heart sound?", a: "The S2 becomes <b>single and loud</b> due to severe pulmonary hypertension (loud P2 component). The previously heard murmur of the shunt may diminish or disappear." },

// ===== DIAGNOSIS =====
{ q: "When is the newborn critical CHD pulse oximetry screen performed?", a: "At <b>24–48 hours of life</b> (or before discharge if <24 hours). Measured on the <b>right hand (preductal)</b> and <b>either foot (postductal)</b>." },
{ q: "What constitutes a positive (failed) pulse oximetry screen for critical CHD?", a: "Any SpO₂ <b><90%</b> in either extremity, OR SpO₂ <b>90–94%</b> in both extremities on 3 measures each separated by 1 hour, OR <b>>3% difference</b> between right hand and foot on 3 measures." },
{ q: "What is the gold standard diagnostic test for congenital heart disease?", a: "<b>Echocardiography</b> — provides anatomic detail (defects, valve abnormalities, great vessel anatomy) and hemodynamic assessment (Doppler gradients, shunt quantification)." },
{ q: "What is the role of cardiac catheterization in CHD?", a: "Provides <b>hemodynamic data</b> (pressures, saturations, Qp:Qs), assesses <b>pulmonary vascular resistance</b>, and allows <b>interventional procedures</b> (balloon valvuloplasty, septostomy, device closure)." },
{ q: "What CXR finding suggests increased pulmonary blood flow?", a: "<b>Pulmonary plethora</b> (prominent pulmonary vascular markings) — seen in left-to-right shunts (VSD, ASD, PDA) and mixing lesions (truncus arteriosus)." },
{ q: "What CXR finding suggests decreased pulmonary blood flow?", a: "<b>Oligemic (dark) lung fields</b> with decreased pulmonary vascular markings — seen in TOF, tricuspid atresia, and severe pulmonic stenosis." },
{ q: "Match the CXR appearance to the CHD: 'Boot-shaped heart'", a: "<b>Tetralogy of Fallot</b> — RVH lifts the apex upward; concave main pulmonary artery segment." },
{ q: "Match the CXR appearance to the CHD: 'Egg-on-a-string'", a: "<b>Transposition of the Great Arteries (TGA)</b> — narrow superior mediastinum with egg-shaped cardiac silhouette." },
{ q: "Match the CXR appearance to the CHD: 'Snowman sign'", a: "<b>Supracardiac Total Anomalous Pulmonary Venous Return (TAPVR)</b> — figure-of-eight appearance from dilated vertical and innominate veins." },
{ q: "What does the hyperoxia test help differentiate?", a: "Differentiates <b>cardiac cyanosis from pulmonary cyanosis</b>. In cardiac cyanosis, PaO₂ remains <b><150 mmHg</b> (often <100) despite 100% FiO₂. In pulmonary disease, PaO₂ typically rises >150 mmHg." },
{ q: "What ECG findings suggest right ventricular hypertrophy in a child?", a: "<b>Right axis deviation</b>, tall R waves in V1/V3R, deep S waves in V5/V6, upright T wave in V1 after age 7 days. May see RV strain pattern." },

// ===== MANAGEMENT =====
{ q: "What is the initial medical management of CHF in infants with left-to-right shunts?", a: "<b>Diuretics (furosemide)</b>, <b>ACE inhibitors (captopril/enalapril)</b> for afterload reduction, high-calorie feeds, and fluid restriction if needed." },
{ q: "What is the Blalock-Taussig (BT) shunt?", a: "A palliative systemic-to-pulmonary artery shunt. The <b>modified BT shunt</b> uses a Gore-Tex graft from the <b>subclavian artery to the ipsilateral pulmonary artery</b> to increase pulmonary blood flow." },
{ q: "What is the Glenn procedure (bidirectional cavopulmonary shunt)?", a: "Anastomosis of the <b>SVC to the right pulmonary artery</b>, directing upper body venous return directly to the lungs. It is Stage 2 palliation for single-ventricle physiology." },
{ q: "What is the Rashkind procedure and when is it indicated?", a: "<b>Balloon atrial septostomy</b> — creates/enlarges an ASD to allow intracardiac mixing. Indicated emergently in <b>TGA</b> and sometimes in other lesions needing atrial-level communication." },
{ q: "What devices can be used for percutaneous closure of septal defects?", a: "<b>Amplatzer device</b> (or similar occluders) can be used for transcatheter closure of <b>secundum ASD</b> and some <b>muscular VSDs</b>." },
{ q: "What antibiotic prophylaxis is currently recommended for CHD patients?", a: "Infective endocarditis (IE) prophylaxis is recommended only for <b>high-risk</b> patients: unrepaired cyanotic CHD, prosthetic valves, prior IE, repaired CHD with residual defects near prosthetic material, and cardiac transplant with valvulopathy." },
{ q: "What is the timing for surgical repair of a large VSD?", a: "Typically repaired at <b>3–6 months</b> of age if symptomatic despite medical therapy, or earlier if refractory CHF or failure to thrive." },
{ q: "What is the timing for elective ASD closure?", a: "Secundum ASDs with significant shunting (Qp:Qs ≥1.5:1) are typically closed at <b>2–5 years</b> of age, either surgically or by catheter device." },
{ q: "What is the Jatene procedure?", a: "The <b>arterial switch operation</b> for d-TGA: the aorta and pulmonary artery are transected above the valves and switched to the correct ventricles. The coronary arteries are reimplanted into the neo-aorta." },
{ q: "What long-term complication is most concerning after TOF repair?", a: "<b>Pulmonary regurgitation (PR)</b> — progressive PR can lead to RV dilation and dysfunction, exercise intolerance, arrhythmias. May eventually need <b>pulmonary valve replacement</b>." },

// ===== KAWASAKI DISEASE =====
{ q: "What is Kawasaki disease?", a: "An <b>acute febrile vasculitis</b> of medium-sized arteries, primarily affecting children <5 years. The most feared complication is <b>coronary artery aneurysm</b>." },
{ q: "What are the diagnostic criteria for Kawasaki disease?", a: "<b>Fever ≥5 days</b> PLUS ≥4 of 5: <b>1. Bilateral conjunctival injection</b> (nonexudative), <b>2. Oral mucosal changes</b> (strawberry tongue, cracked lips), <b>3. Polymorphous rash</b>, <b>4. Extremity changes</b> (edema, erythema, desquamation), <b>5. Cervical lymphadenopathy</b> (≥1.5 cm, usually unilateral)." },
{ q: "What mnemonic helps remember Kawasaki diagnostic criteria?", a: "<b>CRASH and Burn</b>: <b>C</b>onjunctivitis, <b>R</b>ash, <b>A</b>denopathy (cervical), <b>S</b>trawberry tongue (oral changes), <b>H</b>and/foot changes, and <b>Burn</b> = fever." },
{ q: "What is 'incomplete' Kawasaki disease?", a: "Fever ≥5 days with <b>fewer than 4 classic criteria</b> but with supporting lab findings (elevated ESR/CRP, anemia, thrombocytosis, hypoalbuminemia, pyuria, elevated ALT) and/or positive echocardiographic findings." },
{ q: "What is the most serious complication of Kawasaki disease?", a: "<b>Coronary artery aneurysms</b> — develop in ~25% of untreated patients. Can lead to myocardial infarction, thrombosis, and sudden death." },
{ q: "What is the treatment for Kawasaki disease?", a: "<b>IVIG (2 g/kg single infusion)</b> + <b>high-dose aspirin (80–100 mg/kg/day)</b> during the acute febrile phase. Aspirin is then reduced to <b>low-dose (3–5 mg/kg/day)</b> for 6–8 weeks (antiplatelet)." },
{ q: "When should treatment for Kawasaki disease ideally be initiated?", a: "Within the <b>first 10 days of illness</b> (ideally by day 7) to reduce the risk of coronary artery aneurysms from ~25% to <5%." },
{ q: "Why is aspirin uniquely used in Kawasaki disease despite the usual pediatric contraindication?", a: "The <b>anti-inflammatory (high-dose) and antiplatelet (low-dose)</b> properties of aspirin are critical. The risk of coronary aneurysm outweighs the risk of <b>Reye syndrome</b>, though the association with Reye syndrome is primarily with influenza and varicella." },
{ q: "What is the management if a patient with Kawasaki disease is refractory to initial IVIG?", a: "Options include a <b>second dose of IVIG</b>, <b>IV pulse methylprednisolone</b>, or <b>infliximab (anti-TNF)</b>." },
{ q: "What lab finding characteristically rises in the subacute phase of Kawasaki disease?", a: "<b>Thrombocytosis</b> (platelet count may exceed 1,000,000/μL) — peaks in the 2nd–3rd week. This, combined with endothelial damage, increases the risk of coronary thrombosis." },
{ q: "What echocardiographic finding is most concerning in Kawasaki disease?", a: "<b>Coronary artery dilation or aneurysm</b> — classified by Z-score. Giant aneurysms (>8 mm or Z-score ≥10) carry the worst prognosis." },
{ q: "What is the peeling/desquamation pattern in Kawasaki disease?", a: "<b>Periungual (around fingernails/toenails) desquamation</b> beginning 2–3 weeks after fever onset. This is a classic <b>subacute phase</b> finding." },

// ===== RHEUMATIC HEART DISEASE =====
{ q: "What organism causes acute rheumatic fever (ARF)?", a: "<b>Group A β-hemolytic Streptococcus (GAS)</b> — Streptococcus pyogenes. ARF is an autoimmune sequela of GAS <b>pharyngitis</b> (NOT skin infection)." },
{ q: "What are the Jones criteria for diagnosis of acute rheumatic fever?", a: "Evidence of preceding GAS infection PLUS <b>2 major criteria</b> OR <b>1 major + 2 minor criteria</b>." },
{ q: "What are the major Jones criteria?", a: "<b>J♥NES</b>: <b>J</b>oints (migratory polyarthritis), <b>♥</b> Carditis (pancarditis), <b>N</b>odules (subcutaneous), <b>E</b>rythema marginatum, <b>S</b>ydenham chorea." },
{ q: "What are the minor Jones criteria?", a: "<b>Fever, arthralgia</b> (cannot use if arthritis is a major criterion), <b>elevated ESR/CRP</b>, <b>prolonged PR interval</b>, and in moderate/high-risk populations: monoarthritis and low-grade fever." },
{ q: "Which valve is most commonly affected in rheumatic heart disease?", a: "The <b>mitral valve</b> — mitral regurgitation (acute) and mitral stenosis (chronic). The aortic valve is the second most commonly affected." },
{ q: "What is the classic description of the arthritis in acute rheumatic fever?", a: "<b>Migratory polyarthritis</b> — affects large joints (knees, ankles, elbows, wrists), moving from one joint to another. Each joint is inflamed for a few days. Exquisitely painful and responds rapidly to aspirin." },
{ q: "What is erythema marginatum?", a: "An <b>evanescent, non-pruritic, pink-red rash</b> with serpiginous (snake-like) borders and central clearing. Found on the <b>trunk and proximal extremities</b>, never on the face. A major Jones criterion." },
{ q: "What are subcutaneous nodules in rheumatic fever?", a: "<b>Small, firm, painless nodules</b> over bony prominences and extensor surfaces (elbows, knees, wrists, occiput). Associated with <b>severe carditis</b>." },
{ q: "What is Sydenham chorea (St. Vitus dance)?", a: "<b>Involuntary, purposeless, non-rhythmic movements</b> with emotional lability and muscle weakness. May occur months after GAS infection. May be the <b>only manifestation</b> of ARF (standalone diagnostic criterion)." },
{ q: "What laboratory tests support evidence of preceding GAS infection in ARF?", a: "<b>Elevated ASO (antistreptolysin O) titer</b>, anti-DNase B titer, positive throat culture for GAS, or positive rapid strep antigen test." },
{ q: "What is the treatment of acute rheumatic fever?", a: "<b>1. Antibiotics</b> (penicillin or amoxicillin to eradicate GAS), <b>2. Anti-inflammatory therapy</b> (aspirin for arthritis/fever; corticosteroids for severe carditis), <b>3. Supportive care</b> for chorea." },
{ q: "What is secondary prophylaxis for rheumatic fever?", a: "<b>IM benzathine penicillin G every 3–4 weeks</b> (or daily oral penicillin V or sulfadiazine if penicillin-allergic) to prevent recurrent GAS pharyngitis and recurrence of ARF. Duration depends on cardiac involvement." },
{ q: "How long is secondary prophylaxis continued in ARF with carditis and persistent valvular disease?", a: "<b>At least 10 years or until age 40</b> (whichever is longer), and sometimes lifelong if the patient has ongoing exposure risk (e.g., healthcare workers, teachers)." },
{ q: "What is the Aschoff body?", a: "The pathognomonic histologic finding of <b>rheumatic carditis</b>: a granulomatous lesion with central fibrinoid necrosis, <b>Anitschkow cells</b> (owl-eye nuclei), and multinucleated <b>Aschoff giant cells</b>." },

// ===== INNOCENT MURMURS =====
{ q: "What is Still's murmur?", a: "The <b>most common innocent murmur</b> in children (ages 2–7). A <b>low-pitched, vibratory/musical, grade I-III systolic ejection murmur</b> best heard at the <b>left lower sternal border/apex</b>. Decreases with standing/Valsalva." },
{ q: "What is a venous hum?", a: "A <b>continuous murmur</b> heard in the <b>neck/infraclavicular area</b> caused by turbulent flow in the jugular veins. It <b>disappears with neck turning, compression of the jugular vein, or lying supine</b>. Common ages 3–8." },
{ q: "What is a pulmonary flow murmur?", a: "A <b>soft systolic ejection murmur</b> at the <b>left upper sternal border</b> due to turbulent flow across the pulmonic valve. Common in <b>children, adolescents, and states of high cardiac output</b> (fever, anemia, pregnancy)." },
{ q: "What features distinguish an innocent murmur from a pathologic murmur?", a: "Innocent murmurs are: <b>systolic (never diastolic, never holosystolic)</b>, grade ≤III/VI, <b>no thrill</b>, change with position, <b>normal S1/S2 splitting</b>, and <b>no associated symptoms</b> or abnormal exam findings." },
{ q: "What is the peripheral pulmonic stenosis (PPS) murmur of the newborn?", a: "A <b>soft systolic murmur</b> heard at the <b>axillae and back</b> due to the relative narrowing of branch pulmonary arteries in newborns. It is <b>benign and typically resolves by 3–6 months</b>." },
{ q: "When should an innocent murmur prompt echocardiographic evaluation?", a: "If associated with <b>symptoms (cyanosis, poor feeding, failure to thrive, syncope)</b>, diastolic component, harsh or loud (≥grade IV) murmur, abnormal S2, clicks, or <b>abnormal CXR/ECG</b>." },

// ===== ADDITIONAL HIGH-YIELD CARDS =====
{ q: "What congenital heart defect is associated with congenital rubella syndrome?", a: "<b>PDA and peripheral pulmonic stenosis</b> — rubella causes diffuse pulmonary artery branch stenosis and PDA." },
{ q: "What congenital heart defect is associated with maternal diabetes?", a: "<b>Transposition of the Great Arteries (TGA)</b>, VSD, and <b>hypertrophic cardiomyopathy</b> (asymmetric septal hypertrophy due to fetal hyperinsulinism)." },
{ q: "What congenital heart defect is most associated with fetal alcohol syndrome?", a: "<b>VSD and ASD</b> are the most commonly reported cardiac defects." },
{ q: "What is the Qp:Qs ratio and what does it indicate?", a: "The ratio of <b>pulmonary to systemic blood flow</b>. Normal = 1:1. A ratio <b>>1.5:1</b> indicates a significant left-to-right shunt warranting intervention." },
{ q: "What cardiac lesion is associated with trisomy 18 (Edwards syndrome)?", a: "<b>VSD and polyvalvular disease</b> (dysplastic valves). ASD and PDA are also common." },
{ q: "What cardiac lesion is associated with trisomy 13 (Patau syndrome)?", a: "<b>VSD, ASD, PDA</b>, and dextrocardia." },
{ q: "What does CATCH-22 stand for in DiGeorge syndrome?", a: "<b>C</b>ardiac defects (truncus arteriosus, interrupted aortic arch, TOF), <b>A</b>bnormal facies, <b>T</b>hymic aplasia, <b>C</b>left palate, <b>H</b>ypocalcemia — due to <b>22</b>q11.2 deletion." },
{ q: "What is the difference between d-TGA and l-TGA (congenitally corrected TGA)?", a: "<b>d-TGA</b>: aorta anterior and right, parallel circuits → cyanosis. <b>l-TGA (ccTGA)</b>: aorta anterior and left, ventricles inverted → physiologically corrected (blood flows correctly), but the morphologic RV supports systemic circulation → eventual RV failure." },
{ q: "What is Ebstein anomaly?", a: "<b>Apical displacement of the tricuspid valve</b> into the RV → atrialized portion of RV, severe tricuspid regurgitation, RA enlargement. Associated with <b>maternal lithium use</b> and <b>WPW syndrome</b>." },
{ q: "What arrhythmia is associated with Ebstein anomaly?", a: "<b>Wolff-Parkinson-White (WPW) syndrome</b> — accessory pathway (Bundle of Kent) causing pre-excitation. Patients are at risk for supraventricular tachycardia." },
{ q: "What is the CXR appearance of Ebstein anomaly?", a: "<b>Massive cardiomegaly</b> ('wall-to-wall heart' or 'box-shaped heart') due to severe RA enlargement. Decreased pulmonary vascular markings." },
{ q: "What determines whether a neonate with CHD presents with cyanosis vs. CHF?", a: "<b>Cyanosis</b>: right-to-left shunts or inadequate mixing (TOF, TGA). <b>CHF</b>: volume overload from left-to-right shunts (large VSD, PDA). <b>Shock</b>: duct-dependent systemic lesions (HLHS, critical coarctation)." },
{ q: "What is the 'duct-dependent' concept in neonatal cardiology?", a: "Certain CHDs require a <b>patent ductus arteriosus</b> for survival: <b>duct-dependent pulmonary blood flow</b> (critical PS, pulmonary atresia, TOF) or <b>duct-dependent systemic blood flow</b> (HLHS, critical coarctation, interrupted aortic arch)." },
{ q: "What is the difference between pulmonary atresia with VSD and without VSD?", a: "<b>With VSD</b>: similar to severe TOF; pulmonary blood flow from PDA or aortopulmonary collaterals. <b>Without VSD (intact ventricular septum)</b>: RV is hypoplastic; blood reaches lungs only via PDA. Both are duct-dependent." },
{ q: "What is an interrupted aortic arch?", a: "Complete discontinuity of the aortic arch. Associated with <b>DiGeorge syndrome (22q11.2 deletion)</b>. Type B (between left carotid and left subclavian) is most common. Duct-dependent for lower body perfusion." },
{ q: "What are the long-term complications after Fontan procedure?", a: "<b>Protein-losing enteropathy</b>, plastic bronchitis, hepatic fibrosis/cirrhosis, arrhythmias (atrial flutter), thromboembolic events, and exercise intolerance." },
{ q: "How does chronic cyanosis lead to polycythemia, and what are its complications?", a: "Chronic hypoxemia stimulates <b>erythropoietin → ↑ RBC mass</b> (polycythemia). Complications: <b>hyperviscosity syndrome</b> (stroke, headache), iron deficiency (microcytic, hyperviscous RBCs), and <b>brain abscess</b> (loss of pulmonary capillary filter in R-to-L shunts)." },
{ q: "Why are patients with cyanotic CHD at increased risk for brain abscess?", a: "Right-to-left shunts allow <b>venous blood with bacteria to bypass the pulmonary capillary filter</b>, seeding the cerebral circulation directly." },
{ q: "What is the Sano modification in HLHS palliation?", a: "An alternative to the BT shunt in the Norwood procedure: uses an <b>RV-to-PA conduit</b> instead of a subclavian-to-PA shunt. May provide more stable hemodynamics but requires a <b>ventriculotomy</b>." }
          ]
        },
        {
          section: 'Advanced Pediatrics',
          topic: "Pediatric respiratory disorders",
          icon: "wind",
          cards: [
            // ===== UPPER AIRWAY: CROUP =====
{ q: "What is the most common cause of croup (laryngotracheobronchitis)?", a: "<b>Parainfluenza virus</b> (types 1 and 3 most common). Other causes include RSV, influenza, and adenovirus." },
{ q: "What age group is most commonly affected by croup?", a: "Children aged <b>6 months to 3 years</b>, with peak incidence at 1–2 years. More common in fall and winter." },
{ q: "What is the classic clinical triad of croup?", a: "<b>Barking (seal-like) cough</b>, inspiratory <b>stridor</b>, and <b>hoarseness</b>. Symptoms often worse at night." },
{ q: "What classic radiographic finding is seen in croup?", a: "The <b>steeple sign</b> (subglottic narrowing) on AP neck X-ray, representing subglottic edema." },
{ q: "What is the first-line pharmacological treatment for moderate-to-severe croup?", a: "<b>Dexamethasone</b> (0.6 mg/kg PO/IM, single dose) ± nebulized <b>racemic epinephrine</b> for severe stridor at rest." },
{ q: "How does racemic epinephrine work in croup, and what is an important precaution?", a: "It causes <b>mucosal vasoconstriction</b> reducing subglottic edema. Patients must be observed for <b>2–3 hours</b> after administration due to risk of <b>rebound stridor</b>." },
{ q: "What is the Westley croup score used for?", a: "To assess <b>croup severity</b> based on 5 criteria: level of consciousness, cyanosis, stridor, air entry, and chest wall retractions. Score ≥8 = severe." },
{ q: "How does spasmodic croup differ from viral croup?", a: "Spasmodic croup has <b>sudden onset at night without prodromal URI</b>, is often recurrent, may have an allergic component, and responds rapidly to cool mist or brief steroid course." },

// ===== UPPER AIRWAY: EPIGLOTTITIS =====
{ q: "What organism classically causes acute epiglottitis?", a: "<b>Haemophilus influenzae type b (Hib)</b>. Incidence has decreased dramatically since Hib vaccination. In vaccinated children, consider <b>Strep pyogenes</b>, <b>Staph aureus</b>." },
{ q: "What is the typical age and presentation of epiglottitis?", a: "Children aged <b>2–7 years</b> with abrupt onset of <b>high fever, dysphagia, drooling, muffled voice</b>, and <b>tripod positioning</b> (sitting upright, leaning forward, neck extended)." },
{ q: "What radiographic sign is characteristic of epiglottitis?", a: "The <b>thumbprint sign</b> on lateral neck X-ray, representing a swollen, edematous epiglottis." },
{ q: "Why should you NOT examine the throat of a child with suspected epiglottitis?", a: "Throat examination or tongue depressor use can precipitate <b>complete airway obstruction</b>. Airway management should occur in the <b>operating room</b> with anesthesia/ENT standby." },
{ q: "What is the definitive management of epiglottitis?", a: "<b>Securing the airway</b> (intubation or tracheostomy in OR) + IV antibiotics (<b>ceftriaxone or cefotaxime</b> to cover Hib and other pathogens)." },

// ===== UPPER AIRWAY: BACTERIAL TRACHEITIS =====
{ q: "What is bacterial tracheitis and how does it present?", a: "A <b>secondary bacterial infection of the trachea</b> following viral croup. Presents with <b>high fever, toxic appearance, brassy cough</b>, and thick <b>purulent secretions</b> causing airway obstruction." },
{ q: "What organism most commonly causes bacterial tracheitis?", a: "<b>Staphylococcus aureus</b> is the most common cause. Other pathogens include <b>Moraxella catarrhalis</b>, <b>non-typable H. influenzae</b>, and <b>Strep pyogenes</b>." },
{ q: "How is bacterial tracheitis differentiated from croup and epiglottitis?", a: "Unlike croup, the child appears <b>toxic with high fever</b> and does not respond to racemic epinephrine. Unlike epiglottitis, the child has a <b>cough</b> and the epiglottis appears <b>normal</b>." },
{ q: "What is the treatment for bacterial tracheitis?", a: "<b>IV antibiotics</b> (anti-staphylococcal coverage, e.g., nafcillin or vancomycin + ceftriaxone), <b>airway management</b>, and <b>tracheal suctioning</b> of purulent secretions." },

// ===== UPPER AIRWAY: PERITONSILLAR & RETROPHARYNGEAL ABSCESS =====
{ q: "What is the most common pathogen in peritonsillar abscess (PTA)?", a: "<b>Group A Streptococcus (Strep pyogenes)</b>, often polymicrobial with anaerobes. Most common in <b>adolescents and young adults</b>." },
{ q: "What is the classic presentation of peritonsillar abscess?", a: "<b>Severe sore throat, trismus (difficulty opening mouth), 'hot potato' (muffled) voice, drooling, uvular deviation</b> away from the affected side, and unilateral tonsillar bulging." },
{ q: "How is peritonsillar abscess managed?", a: "<b>Needle aspiration or incision & drainage</b> + antibiotics (IV ampicillin-sulbactam or clindamycin). Tonsillectomy may be considered for recurrent PTA." },
{ q: "What age group is most affected by retropharyngeal abscess?", a: "Children <b>younger than 4–6 years</b>, because retropharyngeal lymph nodes (nodes of Rouvière) atrophy after this age." },
{ q: "What imaging is best for diagnosing retropharyngeal abscess?", a: "<b>CT scan with IV contrast</b> of the neck shows rim-enhancing fluid collection. Lateral neck X-ray may show <b>widened prevertebral soft tissue</b> (>7 mm at C2 or >14 mm at C6 in children)." },
{ q: "What is the most feared complication of retropharyngeal abscess?", a: "<b>Mediastinitis</b> from inferior extension of infection into the mediastinum via the danger space. Also risk of <b>airway obstruction</b> and aspiration if abscess ruptures." },

// ===== LOWER AIRWAY: BRONCHIOLITIS =====
{ q: "What is the most common cause of bronchiolitis?", a: "<b>Respiratory syncytial virus (RSV)</b>, accounting for ~50–80% of cases. Other causes: human metapneumovirus, rhinovirus, parainfluenza, adenovirus." },
{ q: "What age group is most commonly affected by bronchiolitis?", a: "Infants <b>under 2 years of age</b>, with peak incidence at <b>2–6 months</b>. RSV season is typically <b>November through March</b>." },
{ q: "What is the pathophysiology of bronchiolitis?", a: "Viral infection causes <b>inflammation, edema, and necrosis of bronchiolar epithelium</b> with increased <b>mucus production</b> and <b>small airway obstruction</b> leading to air trapping." },
{ q: "What are the hallmark clinical findings in bronchiolitis?", a: "URI prodrome (rhinorrhea, cough) followed by <b>wheezing, tachypnea, crackles, hyperinflation</b>, nasal flaring, and subcostal retractions. Apnea may occur in young infants." },
{ q: "What is the mainstay of treatment for bronchiolitis?", a: "<b>Supportive care</b>: supplemental oxygen if SpO₂ <90%, nasal suctioning, IV fluids or NG feeds if unable to feed orally. <b>Bronchodilators, steroids, and antibiotics are NOT routinely recommended.</b>" },
{ q: "What is palivizumab and who should receive it?", a: "<b>Palivizumab</b> is a monoclonal antibody against RSV F protein for <b>passive prophylaxis</b>. Given monthly during RSV season to: premature infants (<29 weeks GA in first year), children with <b>hemodynamically significant CHD</b> or <b>chronic lung disease of prematurity</b>." },
{ q: "What CXR findings are typical in bronchiolitis?", a: "<b>Hyperinflation</b> (flattened diaphragms, increased AP diameter), <b>peribronchial thickening</b>, patchy atelectasis. CXR is not routinely needed for diagnosis." },

// ===== LOWER AIRWAY: PNEUMONIA =====
{ q: "What is the most common bacterial cause of pneumonia in neonates (0–28 days)?", a: "<b>Group B Streptococcus (GBS)</b> and <b>E. coli</b>. Also consider <b>Listeria monocytogenes</b>. Treated with <b>ampicillin + gentamicin</b>." },
{ q: "What is the most common cause of pneumonia in children aged 1–3 months?", a: "<b>Chlamydia trachomatis</b> (afebrile pneumonia with staccato cough, eosinophilia), RSV, and <b>Bordetella pertussis</b>. Treated with <b>macrolide (erythromycin or azithromycin)</b>." },
{ q: "What is the most common bacterial cause of community-acquired pneumonia in children aged 3 months to 5 years?", a: "<b>Streptococcus pneumoniae</b>. Viral pneumonia (RSV, parainfluenza, influenza) is still most common overall in this age group." },
{ q: "What organisms are most common in school-age children (5–18 years) with pneumonia?", a: "<b>Mycoplasma pneumoniae</b> (most common atypical), <b>Chlamydophila pneumoniae</b>, and <b>Strep pneumoniae</b>." },
{ q: "What is the classic presentation of Mycoplasma pneumoniae pneumonia?", a: "<b>Walking pneumonia</b>: gradual onset, low-grade fever, headache, malaise, <b>persistent dry/hacking cough</b>. CXR often shows patchy interstitial infiltrates <b>worse than clinical exam suggests</b>." },
{ q: "What extrapulmonary complications can Mycoplasma pneumoniae cause?", a: "<b>Erythema multiforme/Stevens-Johnson syndrome</b>, bullous myringitis, cold agglutinin hemolytic anemia (IgM autoantibodies), encephalitis, myocarditis, arthritis." },
{ q: "What CXR pattern suggests bacterial vs viral pneumonia?", a: "<b>Bacterial</b>: lobar consolidation, pleural effusion. <b>Viral</b>: bilateral diffuse interstitial infiltrates, peribronchial cuffing, hyperinflation." },
{ q: "What is the first-line antibiotic for outpatient community-acquired pneumonia in children >3 months?", a: "<b>High-dose amoxicillin</b> (90 mg/kg/day) for typical bacterial pneumonia. Add a <b>macrolide (azithromycin)</b> if atypical coverage needed." },
{ q: "What complication should be suspected when a child with pneumonia develops persistent fever despite appropriate antibiotics?", a: "<b>Parapneumonic effusion or empyema</b>. Diagnosed by CXR → ultrasound. May require chest tube drainage or VATS if complicated/loculated." },

// ===== LOWER AIRWAY: PERTUSSIS =====
{ q: "What organism causes pertussis (whooping cough)?", a: "<b>Bordetella pertussis</b>, a gram-negative coccobacillus. Also known as the <b>100-day cough</b> due to prolonged clinical course." },
{ q: "What are the three clinical stages of pertussis?", a: "<b>1. Catarrhal</b> (1–2 weeks): URI-like, MOST contagious. <b>2. Paroxysmal</b> (2–6 weeks): severe cough paroxysms with inspiratory 'whoop,' post-tussive emesis. <b>3. Convalescent</b> (weeks–months): gradual cough resolution." },
{ q: "How does pertussis present differently in young infants?", a: "Infants may lack the characteristic whoop and instead present with <b>apnea, cyanosis, and post-tussive emesis</b>. Pertussis is a cause of <b>apparent life-threatening events (ALTEs)</b>." },
{ q: "What lab finding is characteristic of pertussis?", a: "<b>Marked lymphocytosis</b> (WBC often >20,000 with >60% lymphocytes). This is in contrast to typical bacterial infections which show neutrophilia." },
{ q: "What is the treatment and prophylaxis for pertussis?", a: "<b>Macrolide antibiotics</b>: azithromycin (preferred in infants <1 month), erythromycin, or clarithromycin. Post-exposure prophylaxis with the same macrolides for all close contacts regardless of immunization status." },
{ q: "What is the best diagnostic test for pertussis?", a: "<b>PCR of nasopharyngeal swab</b> (most sensitive and rapid). Culture on <b>Bordet-Gengou or Regan-Lowe agar</b> is gold standard but takes 7–10 days and has lower sensitivity." },
{ q: "What vaccine prevents pertussis, and when is it given?", a: "<b>DTaP</b> vaccine at 2, 4, 6, 15–18 months, and 4–6 years. <b>Tdap</b> booster at 11–12 years. <b>Tdap is recommended for pregnant women</b> at 27–36 weeks gestation each pregnancy." },

// ===== ASTHMA =====
{ q: "What is the definition of asthma?", a: "A <b>chronic inflammatory disorder</b> of the airways characterized by <b>reversible airway obstruction</b>, <b>bronchial hyperresponsiveness</b>, and <b>airway inflammation</b> with remodeling over time." },
{ q: "What cells are central to the inflammatory response in asthma?", a: "<b>Eosinophils, mast cells, T-helper 2 (Th2) lymphocytes</b>, and <b>IgE</b>. Mast cell degranulation releases histamine and leukotrienes causing bronchoconstriction and mucus production." },
{ q: "What defines intermittent asthma?", a: "Symptoms ≤<b>2 days/week</b>, nighttime awakenings ≤<b>2×/month</b>, SABA use ≤2 days/week, <b>no interference</b> with normal activity, FEV₁ ≥80% predicted, FEV₁/FVC normal." },
{ q: "What defines mild persistent asthma?", a: "Symptoms <b>>2 days/week but not daily</b>, nighttime awakenings <b>3–4×/month</b>, minor limitation of activity, FEV₁ ≥80% predicted." },
{ q: "What defines moderate persistent asthma?", a: "Symptoms <b>daily</b>, nighttime awakenings <b>>1×/week but not nightly</b>, some limitation of activity, FEV₁ <b>60–80%</b> predicted." },
{ q: "What defines severe persistent asthma?", a: "Symptoms <b>throughout the day</b>, nighttime awakenings <b>often 7×/week</b>, extremely limited activity, FEV₁ <b><60%</b> predicted." },
{ q: "What is Step 1 therapy for asthma?", a: "<b>SABA (albuterol) PRN</b> only. No daily controller medication. Appropriate for <b>intermittent</b> asthma." },
{ q: "What is the preferred Step 2 therapy for asthma in children ≥5 years?", a: "<b>Low-dose inhaled corticosteroid (ICS)</b> as daily controller. Alternative: leukotriene receptor antagonist (LTRA, e.g., montelukast) or cromolyn." },
{ q: "What is Step 3 therapy for asthma?", a: "For ≥12 years: <b>low-dose ICS + LABA</b> (e.g., fluticasone/salmeterol) OR <b>medium-dose ICS</b>. For 5–11 years: medium-dose ICS or low-dose ICS + LABA or low-dose ICS + LTRA." },
{ q: "What is Step 4 therapy for asthma?", a: "<b>Medium-dose ICS + LABA</b>. Consider adding LTRA or theophylline as adjunct." },
{ q: "What is Step 5–6 therapy for severe refractory asthma?", a: "Step 5: <b>High-dose ICS + LABA</b>, consider <b>biologic therapy</b> (omalizumab, mepolizumab, dupilumab). Step 6: add <b>oral systemic corticosteroids</b>." },
{ q: "What is the mechanism of action of inhaled corticosteroids (ICS) in asthma?", a: "ICS <b>reduce airway inflammation</b> by inhibiting cytokine production, reducing eosinophil infiltration, and decreasing mucus secretion. They are the <b>most effective long-term controllers</b>." },
{ q: "Why should LABAs never be used as monotherapy in asthma?", a: "LABAs (salmeterol, formoterol) provide <b>bronchodilation without anti-inflammatory effect</b>. Monotherapy has been associated with <b>increased asthma-related deaths</b>. Must always be combined with ICS." },
{ q: "What is the mechanism of montelukast (Singulair)?", a: "<b>Leukotriene receptor antagonist (LTRA)</b> — blocks CysLT1 receptors, reducing bronchoconstriction, mucus production, and eosinophilic inflammation. Useful for exercise-induced and allergic asthma. FDA black box warning for neuropsychiatric events." },
{ q: "What is omalizumab and when is it used?", a: "<b>Anti-IgE monoclonal antibody</b> that binds free IgE, preventing mast cell degranulation. Used as add-on therapy for <b>moderate-to-severe persistent allergic asthma</b> (≥6 years) poorly controlled by ICS + LABA." },
{ q: "What is the first-line rescue medication for acute asthma exacerbation?", a: "<b>Inhaled short-acting beta-2 agonist (SABA)</b> — albuterol via nebulizer or MDI with spacer. Can be given every 20 minutes ×3 in the first hour." },
{ q: "When is ipratropium bromide added in acute asthma management?", a: "In <b>moderate-to-severe exacerbations</b>, ipratropium (anticholinergic) is added to albuterol in the <b>first 3 nebulizer treatments</b>. It provides additional bronchodilation via muscarinic receptor blockade." },
{ q: "When are systemic corticosteroids indicated in acute asthma?", a: "For <b>moderate-to-severe exacerbations</b> or incomplete response to initial SABA. Give <b>oral prednisone/prednisolone</b> (1–2 mg/kg/day for 3–5 days) or IV methylprednisolone if unable to tolerate oral." },
{ q: "When is IV magnesium sulfate used in asthma?", a: "In <b>severe, life-threatening exacerbations</b> not responding to initial bronchodilator + steroid therapy. MgSO₄ causes <b>smooth muscle relaxation</b>. Dose: 25–75 mg/kg IV (max 2 g) over 20 minutes." },
{ q: "What are signs of impending respiratory failure in status asthmaticus?", a: "<b>Silent chest</b> (no wheezing due to minimal air movement), altered mental status, <b>rising PaCO₂</b> (even a 'normal' PaCO₂ of 40 mmHg is concerning in acute asthma), and fatigue/paradoxical breathing." },
{ q: "What is the role of peak expiratory flow (PEF) in asthma management?", a: "PEF monitoring assesses <b>airflow limitation</b>. In exacerbations: <b>>80%</b> predicted = mild, <b>50–80%</b> = moderate, <b><50%</b> = severe. Also used for daily monitoring in the patient's asthma action plan." },

// ===== CYSTIC FIBROSIS =====
{ q: "What is the genetic basis of cystic fibrosis?", a: "<b>Autosomal recessive</b> mutations in the <b>CFTR gene</b> on chromosome 7. The most common mutation is <b>F508del (ΔF508)</b>, a class II (trafficking) mutation present in ~70% of CF alleles." },
{ q: "What does the CFTR protein do normally?", a: "CFTR is a <b>chloride and bicarbonate channel</b> on the apical surface of epithelial cells. It regulates <b>chloride secretion and sodium absorption</b>, maintaining proper hydration of secretions." },
{ q: "What is the gold standard diagnostic test for cystic fibrosis?", a: "<b>Quantitative pilocarpine iontophoresis sweat chloride test</b>. Values: <b>≥60 mEq/L = diagnostic</b>, 30–59 mEq/L = intermediate (requires further testing), <30 mEq/L = normal (CF unlikely)." },
{ q: "What newborn screening test raises suspicion for cystic fibrosis?", a: "Elevated <b>immunoreactive trypsinogen (IRT)</b> on newborn screen. If positive, confirmed with <b>sweat chloride test</b> and/or <b>CFTR genetic testing</b>." },
{ q: "What pulmonary pathogens are most important in cystic fibrosis by age?", a: "Early childhood: <b>Staphylococcus aureus</b> and <b>Haemophilus influenzae</b>. By adolescence/adulthood: <b>Pseudomonas aeruginosa</b> (mucoid strain) becomes predominant. <b>Burkholderia cepacia</b> portends poor prognosis." },
{ q: "What is the significance of mucoid Pseudomonas in CF?", a: "Mucoid Pseudomonas produces an <b>alginate biofilm</b> that is difficult to eradicate and signals <b>chronic colonization</b>. Chronic Pseudomonas infection is associated with <b>accelerated lung function decline</b>." },
{ q: "What gastrointestinal manifestations occur in cystic fibrosis?", a: "<b>Pancreatic insufficiency</b> (85–90%): fat malabsorption, steatorrhea, fat-soluble vitamin deficiency (A, D, E, K). <b>Meconium ileus</b> in neonates, <b>distal intestinal obstruction syndrome (DIOS)</b>, rectal prolapse, and <b>CF-related diabetes (CFRD)</b>." },
{ q: "What is meconium ileus and its association with CF?", a: "Meconium ileus is <b>neonatal intestinal obstruction</b> caused by thick, inspissated meconium. It occurs in ~<b>15–20%</b> of CF neonates and is <b>virtually pathognomonic</b> for CF." },
{ q: "How is meconium ileus diagnosed radiographically?", a: "Abdominal X-ray shows <b>dilated small bowel loops</b> with a <b>soap-bubble or ground-glass appearance</b> (Neuhauser sign) in the right lower quadrant. <b>Contrast enema</b> shows a microcolon." },
{ q: "What is the role of dornase alfa (Pulmozyme) in CF?", a: "<b>Recombinant human DNase</b> that cleaves extracellular DNA in purulent sputum, <b>reducing mucus viscosity</b> and improving airway clearance and FEV₁." },
{ q: "How does hypertonic saline (7%) help in CF management?", a: "Nebulized hypertonic saline <b>osmotically draws water into the airway lumen</b>, hydrating the mucus layer and improving mucociliary clearance." },
{ q: "What is ivacaftor (Kalydeco) and how does it work?", a: "A <b>CFTR potentiator</b> that increases the open probability of the CFTR channel at the cell surface. Effective for <b>gating mutations</b> (e.g., <b>G551D</b>). First CFTR modulator approved." },
{ q: "What is the combination drug elexacaftor/tezacaftor/ivacaftor (Trikafta)?", a: "A triple CFTR modulator: two <b>correctors</b> (elexacaftor + tezacaftor) improve CFTR protein folding/trafficking + one <b>potentiator</b> (ivacaftor). Effective for patients with <b>at least one F508del</b> mutation (~90% of CF patients). Dramatically improves lung function." },
{ q: "What is lumacaftor/ivacaftor (Orkambi)?", a: "A <b>corrector + potentiator</b> combination for patients <b>homozygous for F508del</b>. Lumacaftor corrects protein misfolding; ivacaftor potentiates channel function. Modest improvement in FEV₁." },
{ q: "What are the fertility implications of CF?", a: "<b>Males</b>: >95% are infertile due to <b>congenital bilateral absence of the vas deferens (CBAVD)</b> but produce sperm (IVF possible). <b>Females</b>: reduced fertility due to thick cervical mucus but can conceive." },
{ q: "What are key nutritional recommendations for CF patients?", a: "<b>High-calorie, high-fat diet</b> (120–150% of normal caloric needs), <b>pancreatic enzyme replacement therapy (PERT)</b> with meals, fat-soluble vitamin supplementation (<b>A, D, E, K</b>), and salt supplementation especially in hot weather." },

// ===== FOREIGN BODY ASPIRATION =====
{ q: "What is the most common location for an aspirated foreign body?", a: "The <b>right main bronchus</b> because it is wider, shorter, and more vertically oriented than the left." },
{ q: "What is the most common type of aspirated foreign body in children?", a: "<b>Food items</b> — especially <b>peanuts, hot dogs, grapes, popcorn, and hard candy</b>. In children <3 years, round objects and food are most common. In older children, consider non-food items." },
{ q: "What are the three phases of foreign body aspiration?", a: "<b>1. Initial</b>: choking, coughing, gagging. <b>2. Asymptomatic interval</b>: minutes to weeks of minimal symptoms (foreign body lodges). <b>3. Complications</b>: pneumonia, atelectasis, or abscess." },
{ q: "What CXR findings suggest foreign body aspiration?", a: "<b>Unilateral hyperinflation</b> (air trapping due to ball-valve obstruction), mediastinal shift <b>away</b> from the affected side on expiration. May also show atelectasis if complete obstruction. Most foreign bodies are <b>radiolucent</b>." },
{ q: "What inspiratory vs. expiratory films show in foreign body aspiration?", a: "Inspiratory film may appear <b>normal</b>. <b>Expiratory film</b> (or bilateral decubitus in young children) reveals <b>air trapping</b> on the affected side — the obstructed lung fails to deflate." },
{ q: "What is the definitive management of an aspirated foreign body?", a: "<b>Rigid bronchoscopy</b> under general anesthesia for both <b>diagnosis and removal</b>. Flexible bronchoscopy may be used for diagnosis, but rigid scope is preferred for extraction." },
{ q: "What maneuvers are recommended for choking in infants vs. children >1 year?", a: "<b>Infants (<1 year)</b>: alternating 5 <b>back blows</b> and 5 <b>chest thrusts</b>. <b>Children >1 year</b>: <b>abdominal thrusts (Heimlich maneuver)</b>. Blind finger sweeps are <b>NOT recommended</b> in infants." },

// ===== CONGENITAL ANOMALIES =====
{ q: "What is the most common type of tracheoesophageal fistula (TEF)?", a: "<b>Type C (Gross classification)</b>: proximal esophageal atresia with <b>distal TEF</b>, accounting for ~85% of cases." },
{ q: "How does tracheoesophageal fistula typically present?", a: "Neonate with <b>excessive drooling and salivation</b>, <b>choking/coughing with first feed</b>, inability to pass nasogastric tube, and recurrent aspiration. Prenatal clue: <b>polyhydramnios</b>." },
{ q: "What is the VACTERL association?", a: "<b>V</b>ertebral anomalies, <b>A</b>nal atresia, <b>C</b>ardiac defects, <b>T</b>racheo-<b>E</b>sophageal fistula, <b>R</b>enal anomalies, <b>L</b>imb defects (radial aplasia). Must evaluate for all associated anomalies after TEF diagnosis." },
{ q: "What is congenital diaphragmatic hernia (CDH)?", a: "A <b>defect in the diaphragm</b> (most commonly <b>left posterolateral — Bochdalek hernia</b>) allowing abdominal contents to herniate into the thorax, causing <b>pulmonary hypoplasia</b> and <b>pulmonary hypertension</b>." },
{ q: "What are the classic physical findings in congenital diaphragmatic hernia?", a: "<b>Scaphoid (flat/concave) abdomen</b>, <b>barrel-shaped chest</b>, absent breath sounds on the affected side, <b>bowel sounds in the chest</b>, and <b>severe respiratory distress</b> at birth." },
{ q: "What is the initial management of CDH?", a: "<b>Intubation</b> (avoid bag-mask ventilation to prevent gastric distension), <b>NG tube decompression</b>, gentle ventilation strategies, stabilize pulmonary hypertension (inhaled NO, sildenafil), then <b>surgical repair</b> once stabilized." },
{ q: "What is choanal atresia?", a: "<b>Bony or membranous obstruction</b> of the posterior nasal passages. <b>Bilateral</b> atresia presents as <b>cyanosis relieved by crying</b> (obligate nose-breathers). Unilateral may present later with chronic unilateral nasal discharge." },
{ q: "What syndrome is associated with choanal atresia?", a: "<b>CHARGE syndrome</b>: <b>C</b>oloboma, <b>H</b>eart defects, <b>A</b>tresia choanae, <b>R</b>etardation of growth, <b>G</b>enital abnormalities, <b>E</b>ar anomalies/deafness. Caused by <b>CHD7 gene mutation</b>." },
{ q: "How is bilateral choanal atresia diagnosed?", a: "Inability to pass a <b>catheter through the nose</b> into the nasopharynx. Confirmed with <b>CT scan</b> showing bony/membranous plate at the posterior choanae." },

// ===== NEONATAL RESPIRATORY: RDS =====
{ q: "What is the pathophysiology of respiratory distress syndrome (RDS) of the newborn?", a: "<b>Surfactant deficiency</b> in premature lungs leads to increased alveolar surface tension → <b>atelectasis → ventilation-perfusion mismatch → hypoxemia</b>. Surfactant is produced by <b>type II pneumocytes</b> starting at ~24 weeks, adequate by ~35 weeks." },
{ q: "What are the risk factors for neonatal RDS?", a: "<b>Prematurity</b> (most important), male sex, Caucasian race, maternal diabetes (insulin inhibits surfactant), C-section without labor, perinatal asphyxia, second born of twins." },
{ q: "What CXR finding is characteristic of RDS?", a: "<b>Bilateral ground-glass (reticulogranular) opacities</b> with <b>air bronchograms</b> and <b>low lung volumes</b>. Diffuse, symmetric pattern." },
{ q: "What is the lecithin/sphingomyelin (L/S) ratio and its significance?", a: "Amniotic fluid test for fetal lung maturity. <b>L/S ratio ≥2:1</b> indicates mature lungs. Presence of <b>phosphatidylglycerol (PG)</b> is also a marker of maturity." },
{ q: "How do antenatal corticosteroids prevent RDS?", a: "<b>Betamethasone or dexamethasone</b> given to mothers at <b>24–34 weeks gestation</b> with threatened preterm delivery. They accelerate fetal lung maturity by <b>stimulating surfactant production</b> by type II pneumocytes. Maximum benefit at 48 hours." },
{ q: "What is the treatment of established RDS?", a: "<b>Exogenous surfactant replacement</b> (beractant, poractant alfa) via endotracheal tube + <b>CPAP or mechanical ventilation</b>. Supportive care: thermoregulation, nutrition, fluid management." },
{ q: "What is a major complication of mechanical ventilation in premature infants?", a: "<b>Bronchopulmonary dysplasia (BPD)</b>: chronic lung disease defined as oxygen need at <b>36 weeks corrected gestational age</b>. Results from barotrauma, volutrauma, oxygen toxicity, and inflammation." },

// ===== NEONATAL RESPIRATORY: TTN =====
{ q: "What is transient tachypnea of the newborn (TTN)?", a: "A self-limited condition caused by <b>delayed resorption of fetal lung fluid</b>. Also called <b>'wet lung'</b>. Onset within <b>first 2–6 hours</b> of life." },
{ q: "What is the primary risk factor for TTN?", a: "<b>Cesarean section delivery without labor</b>. Labor triggers catecholamine release that activates epithelial sodium channels (ENaC) to clear fetal lung fluid." },
{ q: "What CXR findings are seen in TTN?", a: "<b>Prominent perihilar vascular markings</b>, <b>fluid in the interlobar fissures</b>, <b>hyperinflation</b>, and small pleural effusions. The hallmark is <b>wet, streaky lungs</b>." },
{ q: "How is TTN managed, and what is the expected course?", a: "<b>Supportive care</b>: supplemental oxygen (rarely >40% needed), monitoring, possible NG feeds. Resolves within <b>24–72 hours</b>. It is a diagnosis of exclusion — must rule out pneumonia and RDS." },

// ===== NEONATAL RESPIRATORY: MECONIUM ASPIRATION =====
{ q: "What is meconium aspiration syndrome (MAS)?", a: "Respiratory distress caused by <b>aspiration of meconium-stained amniotic fluid</b>, typically in <b>term or post-term</b> infants. Meconium causes <b>airway obstruction, chemical pneumonitis, surfactant inactivation</b>, and predisposes to PPHN." },
{ q: "What CXR findings are characteristic of meconium aspiration?", a: "<b>Bilateral coarse, patchy infiltrates</b> ('rope-like'), <b>hyperinflation</b> with flattened diaphragms, and possible <b>pneumothorax</b> (air-leak syndrome from ball-valve mechanism)." },
{ q: "What is the current recommendation for management of meconium-stained amniotic fluid at delivery?", a: "Current NRP guidelines: <b>Do NOT routinely suction the trachea</b> of vigorous infants. For <b>non-vigorous</b> infants (poor tone, inadequate breathing), focus on standard resuscitation steps; routine intubation for tracheal suctioning is no longer recommended." },

// ===== NEONATAL RESPIRATORY: PPHN =====
{ q: "What is persistent pulmonary hypertension of the newborn (PPHN)?", a: "Failure of the normal postnatal decrease in <b>pulmonary vascular resistance</b>, resulting in <b>right-to-left shunting</b> through the patent ductus arteriosus and/or foramen ovale, causing <b>severe hypoxemia</b>." },
{ q: "What conditions are associated with PPHN?", a: "<b>Meconium aspiration syndrome</b>, RDS, <b>congenital diaphragmatic hernia</b>, pneumonia/sepsis, and <b>idiopathic</b>. Also associated with maternal SSRI use in late pregnancy." },
{ q: "How is PPHN diagnosed?", a: "Pre- and post-ductal <b>oxygen saturation difference >5–10%</b> (higher pre-ductal). Confirmed by <b>echocardiography</b> showing elevated PA pressures, right-to-left shunting, and excluding structural heart disease." },
{ q: "What is the treatment for PPHN?", a: "Optimize oxygenation and ventilation, <b>inhaled nitric oxide (iNO)</b> — a selective pulmonary vasodilator, treat underlying cause. Refractory cases may require <b>ECMO</b>. Sildenafil or milrinone may be adjunctive." },

// ===== SLEEP-DISORDERED BREATHING =====
{ q: "What is the most common cause of obstructive sleep apnea (OSA) in children?", a: "<b>Adenotonsillar hypertrophy</b>. Peak incidence at <b>2–8 years of age</b>, coinciding with peak size of adenoids and tonsils." },
{ q: "What are the clinical features of pediatric OSA?", a: "<b>Snoring</b> (most common symptom), observed <b>apneic episodes</b>, restless sleep, mouth breathing, enuresis, <b>daytime behavioral problems</b> (hyperactivity, poor school performance), and morning headaches." },
{ q: "What complications can result from untreated OSA in children?", a: "<b>Failure to thrive</b>, <b>cor pulmonale</b> (right heart failure from chronic hypoxemia), neurocognitive deficits, systemic hypertension, and <b>behavioral/learning difficulties</b>." },
{ q: "What is the gold standard diagnostic test for pediatric OSA?", a: "<b>Overnight polysomnography (PSG)</b>. In children, OSA is diagnosed with an <b>apnea-hypopnea index (AHI) ≥1 event/hour</b> (unlike adults where AHI ≥5 is used)." },
{ q: "What is the first-line treatment for pediatric OSA due to adenotonsillar hypertrophy?", a: "<b>Adenotonsillectomy (T&A)</b>, which is curative in ~80% of otherwise healthy children. CPAP is second-line for residual OSA or when surgery is contraindicated." },

// ===== TUBERCULOSIS IN CHILDREN =====
{ q: "How is tuberculosis in children different from adult TB?", a: "Children usually have <b>paucibacillary disease</b> (fewer organisms), making <b>sputum smear often negative</b>. Children are more likely to develop <b>extrapulmonary and disseminated disease</b> (miliary TB, TB meningitis). They rarely form cavitary lesions." },
{ q: "What is the tuberculin skin test (TST/PPD) and how is it read?", a: "Intradermal injection of <b>purified protein derivative (PPD)</b>. Read as <b>induration (not erythema)</b> at <b>48–72 hours</b>." },
{ q: "What PPD induration size is positive in high-risk children?", a: "<b>≥5 mm</b>: HIV-positive, close contacts of active TB cases, immunosuppressed, CXR consistent with TB. <b>≥10 mm</b>: children <4 years, immigrants from high-prevalence areas, exposure to high-risk adults. <b>≥15 mm</b>: children ≥4 years with no risk factors." },
{ q: "What is an IGRA test and when is it used in children?", a: "<b>Interferon-gamma release assay</b> (QuantiFERON-TB Gold, T-SPOT). Measures IFN-γ release from T-cells stimulated by TB antigens. Preferred over TST in <b>BCG-vaccinated children ≥2 years</b>. Not recommended as sole test in children <2 years." },
{ q: "What is the treatment for latent TB infection (LTBI) in children?", a: "<b>Isoniazid (INH)</b> daily for <b>9 months</b> (preferred). Alternatives: INH + rifapentine weekly ×12 doses, or rifampin daily ×4 months. Pyridoxine (vitamin B6) supplementation recommended." },
{ q: "What is the standard treatment regimen for active pulmonary TB in children?", a: "<b>2-month intensive phase</b>: isoniazid + rifampin + pyrazinamide + ethambutol (RIPE). <b>4-month continuation phase</b>: isoniazid + rifampin. Total <b>6 months</b>. Extend for disseminated or meningeal TB (9–12 months)." },
{ q: "What is the most common CXR finding in primary TB in children?", a: "<b>Hilar or mediastinal lymphadenopathy</b> (hallmark of primary TB in children), often with overlying segmental atelectasis. A <b>Ghon focus</b> (parenchymal lesion) + hilar node = <b>Ghon complex</b>." },
{ q: "What is miliary TB and who is most at risk?", a: "<b>Hematogenous dissemination</b> of TB causing widespread miliary (millet-seed) lesions on CXR. Most common in <b>infants and immunocompromised children</b>. Can affect lungs, liver, spleen, bone marrow, meninges." },

// ===== ADDITIONAL CLINICAL PEARLS =====
{ q: "What scoring system is used to differentiate croup from epiglottitis clinically?", a: "No single validated scoring system; however, key differentiators: <b>Croup</b>: gradual onset, barking cough, low-grade fever, preceded by URI. <b>Epiglottitis</b>: acute onset, drooling, no cough, high fever, toxic appearance, tripod position." },
{ q: "What is the mechanism of action of albuterol?", a: "<b>Short-acting β₂-adrenergic agonist (SABA)</b> that binds β₂ receptors on airway smooth muscle, activating adenylyl cyclase → ↑cAMP → <b>bronchial smooth muscle relaxation</b>. Onset: 5–15 minutes, duration: 4–6 hours." },
{ q: "What is the most common chronic disease of childhood?", a: "<b>Asthma</b>, affecting approximately 8–10% of children in the United States. It is the leading cause of <b>school absenteeism</b> due to chronic illness." },
{ q: "What is exercise-induced bronchoconstriction (EIB) and how is it managed?", a: "Transient airway narrowing occurring during/after exercise, especially in cold, dry air. Managed with <b>SABA (albuterol) 15 minutes before exercise</b>. Daily <b>LTRA (montelukast)</b> or <b>ICS</b> if frequent." },
{ q: "What are the pulmonary function test findings in asthma?", a: "<b>Obstructive pattern</b>: decreased FEV₁, decreased FEV₁/FVC ratio, increased RV/TLC (air trapping). <b>Reversibility</b>: ≥12% improvement in FEV₁ after bronchodilator confirms diagnosis." },
{ q: "At what SpO₂ threshold should supplemental oxygen be initiated in bronchiolitis per AAP guidelines?", a: "<b>SpO₂ persistently <90%</b>. The AAP (2014, updated 2022) suggests this threshold rather than the previously used 94%, to reduce unnecessary hospitalization and interventions." },
{ q: "What is the role of chest physiotherapy in CF?", a: "<b>Airway clearance techniques</b> (CPT, high-frequency chest wall oscillation vest, positive expiratory pressure devices) are performed <b>daily</b> to mobilize thick secretions and prevent mucus plugging and infection." },
{ q: "What are the classes of CFTR mutations?", a: "<b>I</b>: no protein synthesis (nonsense). <b>II</b>: defective processing/trafficking (F508del). <b>III</b>: defective regulation/gating (G551D). <b>IV</b>: decreased conductance. <b>V</b>: reduced synthesis. <b>VI</b>: accelerated turnover. Classes I–III are more severe." },
{ q: "What congenital anomaly presents with unilateral absent breath sounds AND a scaphoid abdomen at birth?", a: "<b>Congenital diaphragmatic hernia (CDH)</b>. Left-sided Bochdalek hernia (most common) causes abdominal viscera to herniate into the left hemithorax." },
{ q: "Why is bag-mask ventilation avoided in CDH?", a: "Positive-pressure ventilation via bag-mask can cause <b>gastric and intestinal distension</b> within the thorax, <b>further compressing the hypoplastic lung</b> and worsening respiratory failure." },
{ q: "What is the difference between congenital lobar emphysema and CDH?", a: "<b>Congenital lobar emphysema (overinflation)</b>: hyperexpansion of one lobe (usually LUL) due to cartilage deficiency, causing air trapping. Presents with progressive respiratory distress. CDH shows bowel in chest on CXR." },
{ q: "What is the most serious complication of RSV bronchiolitis in high-risk infants?", a: "<b>Respiratory failure requiring mechanical ventilation</b>, particularly in premature infants, those with BPD, hemodynamically significant CHD, or immunodeficiency." },
{ q: "What is the classic radiographic appearance of pertussis?", a: "<b>'Shaggy heart' sign</b>: bilateral perihilar infiltrates that obscure the cardiac silhouette borders." },
{ q: "How does the H-type tracheoesophageal fistula (Type E) present?", a: "H-type TEF has <b>no esophageal atresia</b>. Presents <b>later</b> with recurrent pneumonia, coughing/choking with feeds, and abdominal distension. Diagnosed by <b>contrast esophagram</b> or bronchoscopy." },
{ q: "What is the difference between palivizumab and nirsevimab for RSV prophylaxis?", a: "<b>Palivizumab</b>: requires <b>monthly IM injections</b> throughout RSV season. <b>Nirsevimab</b>: a long-acting monoclonal antibody requiring <b>single dose</b> before first RSV season, approved for all infants <8 months entering their first RSV season." },
{ q: "What vitamin deficiency in CF can cause hemolytic anemia in newborns?", a: "<b>Vitamin E deficiency</b>. Vitamin E is an antioxidant protecting red cell membranes. Deficiency leads to <b>hemolytic anemia</b> and <b>neuromuscular dysfunction</b> (spinocerebellar degeneration)." },
{ q: "What is the Swyer-James syndrome?", a: "A unilateral <b>hyperlucent lung</b> resulting from <b>post-infectious bronchiolitis obliterans</b> (often after adenovirus or Mycoplasma infection in childhood). CXR shows small, hyperlucent lung with air trapping on expiration." },
{ q: "What is bronchopulmonary sequestration?", a: "A mass of <b>non-functioning lung tissue</b> that lacks communication with the tracheobronchial tree and receives <b>systemic arterial blood supply</b> (usually from the aorta). <b>Intralobar</b> (more common) vs. <b>extralobar</b> types." },
{ q: "What is congenital pulmonary airway malformation (CPAM)?", a: "Formerly called congenital cystic adenomatoid malformation (CCAM). A <b>hamartomatous</b> lesion with cystic/solid components arising from abnormal branching morphogenesis. Can cause respiratory distress or recurrent infections; treatment is <b>surgical resection</b>." }
          ]
        },
        {
          section: 'Advanced Pediatrics',
          topic: "Pediatric oncology essentials",
          icon: "activity",
          cards: [
            // ===== GENERAL PEDIATRIC ONCOLOGY =====
{ q: "What is the most common type of cancer in children?", a: "<b>Leukemia</b> — accounts for ~30% of all childhood cancers, with ALL being the most common subtype." },
{ q: "What is the most common solid tumor in children?", a: "<b>Brain tumors</b> (CNS tumors) — the most common solid tumors and second most common childhood malignancy overall after leukemia." },
{ q: "What is the peak age group for childhood cancers overall?", a: "Most childhood cancers peak in the <b>first 5 years of life</b>, particularly leukemia (peak 2–5 years) and embryonal tumors (neuroblastoma, Wilms, retinoblastoma)." },
{ q: "What environmental exposure is a known risk factor for childhood leukemia?", a: "<b>Ionizing radiation</b> and prior <b>chemotherapy</b> (alkylating agents, topoisomerase II inhibitors). Prenatal radiation exposure also increases risk." },
{ q: "Name four genetic/chromosomal syndromes that predispose to childhood cancer.", a: "1) <b>Down syndrome</b> → ALL, AML (M7)<br>2) <b>Neurofibromatosis type 1</b> → optic glioma, MPNST<br>3) <b>Li-Fraumeni syndrome</b> (TP53) → sarcomas, brain tumors, leukemia<br>4) <b>Beckwith-Wiedemann</b> → Wilms tumor, hepatoblastoma" },

// ===== ACUTE LYMPHOBLASTIC LEUKEMIA (ALL) =====
{ q: "What is the most common childhood cancer and its peak age?", a: "<b>Acute lymphoblastic leukemia (ALL)</b> — peak age <b>2–5 years</b>. Accounts for ~75–80% of childhood leukemias." },
{ q: "What is the most common immunophenotype of childhood ALL?", a: "<b>B-cell precursor ALL (pre-B ALL)</b> — accounts for ~85% of cases. Expresses CD10 (CALLA), CD19, CD22." },
{ q: "What are the typical presenting features of ALL?", a: "Bone marrow failure signs: <b>anemia</b> (pallor, fatigue), <b>thrombocytopenia</b> (bruising, petechiae), <b>neutropenia</b> (infections). Also bone pain, hepatosplenomegaly, lymphadenopathy." },
{ q: "What CBC findings suggest ALL?", a: "<b>Anemia</b>, <b>thrombocytopenia</b>, and <b>WBC</b> may be low, normal, or markedly elevated. Peripheral smear may show <b>lymphoblasts</b>. Neutropenia is common." },
{ q: "How is ALL definitively diagnosed?", a: "<b>Bone marrow biopsy</b> showing ≥25% lymphoblasts. Flow cytometry confirms immunophenotype (B-cell vs T-cell). Cytogenetics and molecular studies for risk stratification." },
{ q: "What cytogenetic finding in ALL is associated with a GOOD prognosis?", a: "<b>Hyperdiploidy</b> (>50 chromosomes) and <b>t(12;21) — ETV6-RUNX1</b> (TEL-AML1) fusion. These are the most favorable genetic subtypes." },
{ q: "What cytogenetic finding in ALL is associated with a POOR prognosis?", a: "<b>Philadelphia chromosome t(9;22) — BCR-ABL1</b>, <b>hypodiploidy</b> (<44 chromosomes), <b>MLL rearrangements</b> (especially in infants), and <b>iAMP21</b>." },
{ q: "What is the Philadelphia chromosome and its significance in ALL?", a: "<b>t(9;22)</b> translocation creating the <b>BCR-ABL1</b> fusion gene. Found in ~3–5% of childhood ALL. Associated with <b>poor prognosis</b>; treated with <b>tyrosine kinase inhibitors</b> (imatinib) added to chemotherapy." },
{ q: "List the favorable prognostic factors in childhood ALL.", a: "Age <b>1–9 years</b>, WBC <b><50,000/μL</b> at diagnosis, <b>B-cell</b> immunophenotype, <b>hyperdiploidy</b>, <b>t(12;21)</b>, rapid early response to therapy, and <b>no CNS/testicular</b> involvement." },
{ q: "List the unfavorable prognostic factors in childhood ALL.", a: "Age <b><1 or >10 years</b>, WBC <b>>50,000/μL</b>, <b>T-cell</b> phenotype, <b>t(9;22)</b>, <b>MLL rearrangements</b>, hypodiploidy, slow early response, <b>CNS involvement</b> at diagnosis." },
{ q: "What are the phases of ALL treatment?", a: "1) <b>Induction</b> (~4 weeks): achieve remission<br>2) <b>Consolidation/Intensification</b>: eliminate residual disease<br>3) <b>Maintenance</b> (2–3 years): prevent relapse<br>4) <b>CNS prophylaxis</b>: intrathecal chemotherapy throughout" },
{ q: "What drugs are typically used in ALL induction therapy?", a: "<b>Vincristine</b>, <b>corticosteroid</b> (dexamethasone or prednisone), <b>L-asparaginase</b>, and often an <b>anthracycline</b> (daunorubicin) for high-risk patients." },
{ q: "What is the goal of induction therapy in ALL?", a: "Achieve <b>complete remission</b> — defined as <5% blasts in bone marrow, recovery of normal hematopoiesis, and resolution of extramedullary disease. Achieved in ~95–98% of children." },
{ q: "What drugs are used in maintenance therapy for ALL?", a: "<b>Daily oral 6-mercaptopurine (6-MP)</b> and <b>weekly oral methotrexate</b>, with periodic pulses of vincristine and corticosteroids. Maintenance lasts 2–3 years." },
{ q: "Why is CNS prophylaxis essential in ALL treatment?", a: "The CNS is a <b>sanctuary site</b> where systemic chemotherapy has poor penetration. Without prophylaxis, CNS relapse rates are very high. Treatment: <b>intrathecal methotrexate</b> (± cytarabine, hydrocortisone)." },
{ q: "What is the overall cure rate for childhood ALL?", a: "Approximately <b>85–90%</b> long-term event-free survival with modern risk-adapted therapy." },
{ q: "What are common sites of ALL relapse?", a: "<b>Bone marrow</b> (most common), <b>CNS</b>, and <b>testes</b> (sanctuary sites). Testicular relapse presents as painless testicular enlargement." },
{ q: "How does T-cell ALL differ from B-cell ALL in presentation?", a: "T-cell ALL more common in <b>older boys</b>, often presents with a <b>mediastinal (thymic) mass</b>, higher WBC counts, and may present with <b>superior vena cava syndrome</b>. Generally worse prognosis than standard-risk B-ALL." },
{ q: "What is the role of TPMT testing in ALL treatment?", a: "<b>Thiopurine methyltransferase (TPMT)</b> metabolizes 6-MP. Patients with <b>low/absent TPMT activity</b> are at risk for severe myelosuppression and must receive <b>reduced doses</b> of 6-MP." },
{ q: "A child with Down syndrome develops leukemia. What unique considerations apply?", a: "Children with Down syndrome have a <b>10–20× increased risk</b> of leukemia. ALL in Down syndrome has good prognosis but increased <b>methotrexate toxicity</b>. They also develop <b>transient myeloproliferative disorder (TMD)</b> in the neonatal period and AML-M7." },

// ===== ACUTE MYELOID LEUKEMIA (AML) =====
{ q: "What percentage of childhood leukemias is AML?", a: "Approximately <b>15–20%</b> of childhood leukemias. More common in <b>infants</b> and <b>adolescents</b>." },
{ q: "What is the hallmark morphologic finding in AML?", a: "<b>Auer rods</b> — eosinophilic, needle-shaped cytoplasmic inclusions composed of fused azurophilic granules. Pathognomonic for AML (not seen in ALL)." },
{ q: "What is the AML subtype M3 and why is it clinically critical?", a: "<b>Acute promyelocytic leukemia (APL/APML)</b> with <b>t(15;17)</b> — PML-RARA fusion. Critical because it causes <b>DIC</b> at presentation and is treated with <b>all-trans retinoic acid (ATRA)</b>." },
{ q: "How does all-trans retinoic acid (ATRA) work in APL?", a: "ATRA induces <b>differentiation</b> of the leukemic promyelocytes into mature granulocytes by overcoming the PML-RARA block. Combined with <b>arsenic trioxide</b>, cure rates exceed <b>90%</b>." },
{ q: "Why does APL (AML-M3) cause DIC?", a: "The abnormal promyelocytes release <b>procoagulant granules</b> and tissue factor, triggering <b>disseminated intravascular coagulation (DIC)</b>. This can cause life-threatening hemorrhage at diagnosis. ATRA must be started immediately." },
{ q: "What cytogenetic abnormality is associated with AML in Down syndrome?", a: "<b>AML-M7</b> (acute megakaryoblastic leukemia) with <b>GATA1 mutations</b>. Paradoxically, these children have a <b>good prognosis</b> with chemotherapy." },
{ q: "How does AML treatment differ from ALL treatment?", a: "AML uses <b>more intensive chemotherapy</b> (cytarabine + anthracyclines), shorter duration, <b>no prolonged maintenance</b> (except for APL). <b>Hematopoietic stem cell transplant (HSCT)</b> is considered for high-risk patients in first remission." },
{ q: "What is the overall survival rate for childhood AML?", a: "Approximately <b>60–70%</b> with modern therapy, which is lower than ALL survival rates." },

// ===== HODGKIN LYMPHOMA =====
{ q: "What is the pathognomonic cell in Hodgkin lymphoma?", a: "<b>Reed-Sternberg cell</b> — a large, binucleated cell with prominent eosinophilic nucleoli giving an 'owl-eye' appearance. These are the malignant cells of Hodgkin lymphoma, derived from B lymphocytes." },
{ q: "What is the most common subtype of Hodgkin lymphoma in adolescents?", a: "<b>Nodular sclerosis</b> — accounts for ~70% of cases. Characterized by collagen bands and lacunar Reed-Sternberg cells. More common in <b>adolescents and young adults</b>." },
{ q: "What are the B symptoms in Hodgkin lymphoma?", a: "1) <b>Fever</b> (>38°C, unexplained)<br>2) Drenching <b>night sweats</b><br>3) <b>Weight loss</b> >10% body weight in 6 months.<br>Presence of B symptoms indicates <b>higher stage</b> and worse prognosis." },
{ q: "Describe the Ann Arbor staging system for Hodgkin lymphoma.", a: "<b>Stage I</b>: Single lymph node region<br><b>Stage II</b>: ≥2 regions, same side of diaphragm<br><b>Stage III</b>: Both sides of diaphragm<br><b>Stage IV</b>: Disseminated extranodal (liver, bone marrow, lung)<br>'A' = no B symptoms; 'B' = B symptoms present" },
{ q: "What is the typical presentation of Hodgkin lymphoma?", a: "<b>Painless cervical/supraclavicular lymphadenopathy</b> in an adolescent. May have <b>mediastinal mass</b> (anterior). Nodes are characteristically <b>rubbery and non-tender</b>." },
{ q: "What virus is associated with Hodgkin lymphoma?", a: "<b>Epstein-Barr virus (EBV)</b> — found in Reed-Sternberg cells in ~40% of cases. Association is stronger in younger children and the mixed cellularity subtype." },
{ q: "What is the treatment approach for Hodgkin lymphoma in children?", a: "<b>Combined chemotherapy</b> (ABVD: Adriamycin, Bleomycin, Vinblastine, Dacarbazine) ± <b>involved-field radiation</b>. Risk-adapted therapy based on stage and response. Cure rates exceed <b>90%</b>." },
{ q: "What is the Pel-Ebstein fever pattern?", a: "A cyclic fever pattern described in Hodgkin lymphoma — <b>1–2 weeks of fever alternating with 1–2 weeks of afebrile periods</b>. Classic but uncommon finding." },

// ===== NON-HODGKIN LYMPHOMA =====
{ q: "How does Non-Hodgkin Lymphoma (NHL) in children differ from adults?", a: "Childhood NHL is almost always <b>high-grade, diffuse, and aggressive</b> (vs. adults who may have indolent types). More often <b>extranodal</b> and presents at <b>advanced stages</b>. Paradoxically, high-grade NHL in children responds well to therapy." },
{ q: "What are the three major subtypes of childhood NHL?", a: "1) <b>Burkitt lymphoma</b> (mature B-cell)<br>2) <b>Lymphoblastic lymphoma</b> (precursor T-cell, mostly)<br>3) <b>Large cell lymphoma</b> (diffuse large B-cell or anaplastic large cell)" },
{ q: "What is the classic translocation in Burkitt lymphoma?", a: "<b>t(8;14)</b> — juxtaposes the <b>MYC oncogene</b> (chromosome 8) next to the immunoglobulin heavy chain promoter (chromosome 14), causing MYC overexpression and rapid proliferation." },
{ q: "What is the histologic hallmark of Burkitt lymphoma?", a: "<b>Starry-sky pattern</b> — sheets of monotonous medium-sized lymphocytes with scattered tingible body macrophages (the 'stars') phagocytizing apoptotic tumor cells." },
{ q: "What are the clinical presentations of Burkitt lymphoma?", a: "<b>Endemic (African)</b>: Jaw/facial bone mass, associated with <b>EBV</b>.<br><b>Sporadic (Western)</b>: <b>Abdominal mass</b> (ileocecal region), may present with intussusception, ascites, or bowel obstruction." },
{ q: "What is the characteristic presentation of lymphoblastic lymphoma?", a: "<b>Anterior mediastinal mass</b> in an <b>adolescent male</b> (thymic origin). May present with <b>superior vena cava syndrome</b>, pleural effusions, and respiratory distress. Most are <b>T-cell</b> phenotype." },
{ q: "How is lymphoblastic lymphoma treated?", a: "Treated with <b>ALL-type chemotherapy protocols</b> (similar to T-cell ALL), including induction, consolidation, maintenance, and CNS prophylaxis. Cure rates are ~80–90%." },
{ q: "What is anaplastic large cell lymphoma (ALCL)?", a: "A <b>T-cell or null-cell NHL</b> common in children. Often <b>ALK-positive</b> with <b>t(2;5)</b>. Presents with lymphadenopathy, skin lesions, and systemic symptoms. ALK-positive ALCL has a <b>favorable prognosis</b>." },

// ===== BRAIN TUMORS =====
{ q: "Where are most childhood brain tumors located?", a: "<b>Posterior fossa (infratentorial)</b> — approximately 60% in children, compared to adults where most are supratentorial. Posterior fossa tumors include medulloblastoma, cerebellar astrocytoma, ependymoma, and brainstem glioma." },
{ q: "What are the typical presenting symptoms of posterior fossa brain tumors?", a: "Signs of <b>increased intracranial pressure</b>: headache (worse in morning), vomiting (often projectile), papilledema, and <b>cerebellar signs</b>: ataxia, nystagmus, dysmetria. Infants may present with macrocephaly and bulging fontanelle." },
{ q: "What is medulloblastoma?", a: "The most common <b>malignant</b> brain tumor in children. A <b>primitive neuroectodermal tumor (PNET)</b> arising from the <b>cerebellar vermis</b>. Peak age 5–7 years. Tends to <b>disseminate via CSF</b> (drop metastases)." },
{ q: "How is medulloblastoma treated?", a: "<b>Surgical resection</b> + <b>craniospinal radiation</b> + <b>chemotherapy</b>. Overall survival ~70–80%. Staging includes MRI of entire spine and CSF cytology to assess for dissemination." },
{ q: "What is a cerebellar (pilocytic) astrocytoma?", a: "The most common <b>posterior fossa tumor overall</b> in children. <b>Low-grade (WHO grade I)</b>, typically cystic with a mural nodule. Arises in the <b>cerebellar hemisphere</b>. Excellent prognosis with <b>surgical resection alone</b> (>95% cure)." },
{ q: "Where does ependymoma typically arise in children?", a: "Most commonly from the <b>floor of the fourth ventricle</b> (posterior fossa). Can cause obstructive hydrocephalus. Treatment is <b>maximal surgical resection ± radiation</b>. Chemotherapy has limited role." },
{ q: "What is the prognosis and treatment of brainstem gliomas?", a: "<b>Diffuse intrinsic pontine glioma (DIPG)</b> has the <b>worst prognosis</b> of all childhood brain tumors (median survival ~9–12 months). It is diagnosed by MRI (biopsy usually not needed). Treatment is <b>radiation only</b> (palliative); chemotherapy is ineffective." },
{ q: "What is a craniopharyngioma?", a: "A benign but locally aggressive <b>supratentorial tumor</b> arising from <b>Rathke's pouch remnants</b> near the sella turcica. Characteristically <b>calcified</b> and <b>cystic</b>. Most common suprasellar tumor in children." },
{ q: "What are the classic clinical features of craniopharyngioma?", a: "<b>Bitemporal hemianopia</b> (compression of optic chiasm), <b>endocrine dysfunction</b> (growth failure, diabetes insipidus, delayed puberty, hypothyroidism), headache, and signs of increased ICP." },
{ q: "What brain tumor is associated with Neurofibromatosis type 1 (NF1)?", a: "<b>Optic pathway glioma</b> (usually pilocytic astrocytoma). Found in ~15% of NF1 patients. May cause <b>vision loss</b>, proptosis, and precocious puberty (if hypothalamic involvement). Often observed; treated only if symptomatic/progressive." },
{ q: "What is the most common supratentorial brain tumor in children?", a: "<b>Low-grade glioma</b> (pilocytic or diffuse astrocytoma). Craniopharyngioma is the most common suprasellar tumor specifically." },

// ===== NEUROBLASTOMA =====
{ q: "What is the cell of origin for neuroblastoma?", a: "<b>Neural crest cells</b> — specifically from the <b>sympathetic nervous system</b> (adrenal medulla or sympathetic ganglia). It is a tumor of the <b>sympathoadrenal lineage</b>." },
{ q: "What is the most common extracranial solid tumor in children?", a: "<b>Neuroblastoma</b> — most commonly diagnosed in children <b><2 years</b> of age. Median age at diagnosis is ~17 months." },
{ q: "Where is the most common primary site of neuroblastoma?", a: "<b>Adrenal gland</b> (~40% of cases). Other sites include paraspinal sympathetic ganglia in the abdomen, thorax, neck, and pelvis." },
{ q: "What urinary markers are elevated in neuroblastoma?", a: "<b>Vanillylmandelic acid (VMA)</b> and <b>homovanillic acid (HVA)</b> — catecholamine metabolites. Elevated in >90% of neuroblastoma cases. Used for diagnosis and monitoring." },
{ q: "What is the significance of N-MYC amplification in neuroblastoma?", a: "<b>N-MYC (MYCN) amplification</b> is the most important <b>poor prognostic factor</b> in neuroblastoma. Associated with rapid tumor progression, advanced stage, and poor survival regardless of age or stage." },
{ q: "What is stage 4S neuroblastoma?", a: "A <b>special stage</b> in infants (<12 months) with localized primary tumor and metastases limited to <b>skin, liver, and/or bone marrow (<10%)</b>. Remarkable for <b>spontaneous regression</b> with excellent prognosis (>90% survival). No bone metastases." },
{ q: "What is Pepper syndrome in neuroblastoma?", a: "<b>Massive hepatomegaly</b> from <b>liver metastases</b> in an infant with neuroblastoma (stage 4S). Can cause respiratory compromise due to abdominal distension. Named after William Pepper." },
{ q: "What is opsoclonus-myoclonus syndrome (OMS) and its association with neuroblastoma?", a: "A <b>paraneoplastic syndrome</b> with <b>rapid, chaotic eye movements (opsoclonus)</b>, <b>myoclonic jerks</b>, and <b>ataxia</b> ('dancing eyes, dancing feet'). Found in ~2% of neuroblastoma. Paradoxically associated with <b>favorable tumor biology</b> and better prognosis." },
{ q: "What imaging is used to stage neuroblastoma?", a: "<b>MIBG scan (meta-iodobenzylguanidine)</b> — taken up by sympathetic tissue. CT/MRI for primary tumor. Bone marrow biopsy (bilateral), bone scan, and urinary catecholamines complete the workup." },
{ q: "What are favorable biological features in neuroblastoma?", a: "<b>Hyperdiploidy</b> (near-triploid DNA content), <b>no MYCN amplification</b>, <b>favorable Shimada histology</b>, high TrkA expression, and <b>age <18 months</b>." },
{ q: "How does neuroblastoma differ from Wilms tumor on physical exam?", a: "Neuroblastoma: <b>irregular, fixed, crosses midline</b>, often ill-appearing child.<br>Wilms tumor: <b>smooth, well-circumscribed, does NOT cross midline</b>, generally well-appearing child." },
{ q: "What are the treatment options for neuroblastoma?", a: "<b>Low-risk</b>: observation or surgery alone.<br><b>Intermediate-risk</b>: surgery + moderate chemotherapy.<br><b>High-risk</b>: intensive multimodal therapy (chemo, surgery, radiation, stem cell transplant, immunotherapy with anti-GD2 antibody, isotretinoin)." },

// ===== WILMS TUMOR (NEPHROBLASTOMA) =====
{ q: "What is Wilms tumor?", a: "<b>Nephroblastoma</b> — the most common <b>renal malignancy</b> of childhood. Peak age <b>3–4 years</b>. Arises from embryonal renal tissue (metanephric blastema). Contains blastemal, stromal, and epithelial elements (triphasic)." },
{ q: "What is the classic presentation of Wilms tumor?", a: "A <b>large, smooth, unilateral flank/abdominal mass</b> in an otherwise <b>well-appearing child</b>. May have hypertension (renin secretion), hematuria, and abdominal pain. The mass does NOT cross the midline." },
{ q: "What genes are associated with Wilms tumor?", a: "<b>WT1</b> (chromosome 11p13) and <b>WT2</b> (chromosome 11p15). WT1 is a tumor suppressor gene involved in genitourinary development." },
{ q: "What is WAGR syndrome?", a: "<b>W</b>ilms tumor, <b>A</b>niridia, <b>G</b>enitourinary anomalies, <b>R</b>etardation (intellectual disability). Caused by <b>11p13 deletion</b> including both WT1 and PAX6 (aniridia) genes. ~33% develop Wilms tumor." },
{ q: "What is Beckwith-Wiedemann syndrome and its cancer risk?", a: "An <b>overgrowth syndrome</b>: macrosomia, <b>macroglossia</b>, <b>omphalocele</b>, hemihypertrophy, <b>organomegaly</b>, neonatal hypoglycemia, ear creases. Associated with <b>WT2 (11p15)</b>. Risk of <b>Wilms tumor</b> and <b>hepatoblastoma</b> (~5–10%)." },
{ q: "What is Denys-Drash syndrome?", a: "<b>Diffuse mesangial sclerosis</b> (early renal failure), <b>male pseudohermaphroditism</b> (46,XY DSD), and <b>Wilms tumor</b>. Caused by <b>WT1 point mutation</b>. Very high risk (~90%) of Wilms tumor." },
{ q: "What is the key initial evaluation step when a renal mass is found in a child?", a: "<b>Do NOT biopsy percutaneously</b> (risk of tumor spillage and upstaging). Obtain <b>abdominal CT/MRI</b> and <b>chest CT</b> (lungs are the most common metastatic site). Evaluate contralateral kidney for bilateral disease." },
{ q: "What are the stages of Wilms tumor?", a: "<b>I</b>: Tumor limited to kidney, completely resected<br><b>II</b>: Tumor extends beyond kidney, completely resected<br><b>III</b>: Residual non-hematogenous tumor (nodes, peritoneal spillage)<br><b>IV</b>: Hematogenous metastases (lung, liver)<br><b>V</b>: Bilateral renal involvement" },
{ q: "What is the treatment of Wilms tumor?", a: "<b>Nephrectomy</b> (upfront in North America/NWTS approach) + <b>chemotherapy</b> (vincristine + dactinomycin ± doxorubicin) ± <b>radiation</b> (for stage III–IV or unfavorable histology). Cure rate >90% for favorable histology." },
{ q: "What histologic feature of Wilms tumor indicates unfavorable prognosis?", a: "<b>Anaplasia</b> (diffuse) — characterized by enlarged, hyperchromatic nuclei with abnormal mitoses. Diffuse anaplasia confers worse prognosis. <b>Focal anaplasia</b> has a better prognosis than diffuse." },
{ q: "What is the most common site of Wilms tumor metastasis?", a: "<b>Lungs</b> — chest CT is mandatory at diagnosis. <b>Liver</b> is the second most common. Bone and brain metastases are rare." },

// ===== RETINOBLASTOMA =====
{ q: "What gene mutation causes retinoblastoma?", a: "<b>RB1 gene</b> on chromosome <b>13q14</b> — a <b>tumor suppressor gene</b>. Requires <b>two hits</b> (Knudson's two-hit hypothesis). Loss of both RB1 alleles leads to uncontrolled cell cycle progression." },
{ q: "What is the most common presenting sign of retinoblastoma?", a: "<b>Leukocoria</b> — a white pupillary reflex (absent red reflex). Second most common presentation is <b>strabismus</b>. Retinoblastoma is the most common intraocular malignancy of childhood." },
{ q: "How does hereditary retinoblastoma differ from sporadic?", a: "<b>Hereditary (~40%)</b>: Germline RB1 mutation (first hit inherited), often <b>bilateral</b>, earlier onset, increased risk of <b>second malignancies</b> (osteosarcoma).<br><b>Sporadic (~60%)</b>: Both hits somatic, always <b>unilateral</b>, later onset." },
{ q: "What second malignancy are retinoblastoma survivors at risk for?", a: "<b>Osteosarcoma</b> — highest risk in patients with <b>hereditary retinoblastoma</b>, especially if treated with radiation. Also at risk for soft tissue sarcomas, melanoma, and other cancers." },
{ q: "What is the treatment of retinoblastoma?", a: "Depends on staging. Options include <b>chemoreduction</b> (systemic or intra-arterial), <b>focal therapies</b> (cryotherapy, laser photocoagulation, brachytherapy), and <b>enucleation</b> for advanced unilateral disease. Goal is to <b>preserve vision</b> when possible." },
{ q: "How is retinoblastoma diagnosed?", a: "Clinical exam with <b>indirect ophthalmoscopy</b> under anesthesia. <b>Ocular ultrasound</b> and <b>MRI of orbits</b> (CT avoided due to radiation risk in RB1 carriers). <b>Biopsy is NOT performed</b> (risk of extraocular spread)." },

// ===== BONE TUMORS =====
{ q: "What are the two most common primary malignant bone tumors in children?", a: "<b>Osteosarcoma</b> (most common) and <b>Ewing sarcoma</b> (second most common). Both typically present in the <b>second decade of life</b>." },
{ q: "What is the typical location of osteosarcoma?", a: "<b>Metaphysis of long bones</b> — most commonly around the <b>knee</b> (distal femur > proximal tibia). Peak age <b>10–20 years</b>, coinciding with the adolescent growth spurt." },
{ q: "What is the classic radiographic appearance of osteosarcoma?", a: "<b>Sunburst pattern</b> (radiating spicules of new bone) and <b>Codman triangle</b> (periosteal elevation). Mixed lytic and scite lesion in the <b>metaphysis</b>." },
{ q: "What lab finding is characteristically elevated in osteosarcoma?", a: "<b>Alkaline phosphatase (ALP)</b> — elevated due to osteoblastic activity of the tumor. <b>LDH</b> may also be elevated and correlates with tumor burden/prognosis." },
{ q: "What conditions predispose to osteosarcoma?", a: "<b>Hereditary retinoblastoma</b> (RB1 mutation), <b>Li-Fraumeni syndrome</b> (TP53), <b>Paget disease</b> (in adults), prior <b>radiation therapy</b>, and <b>Rothmund-Thomson syndrome</b>." },
{ q: "What is the treatment of osteosarcoma?", a: "<b>Neoadjuvant chemotherapy</b> → <b>limb-salvage surgery</b> (or amputation if necessary) → <b>adjuvant chemotherapy</b>. Key drugs: <b>methotrexate, doxorubicin, cisplatin</b>. No role for radiation (osteosarcoma is radioresistant)." },
{ q: "Where does osteosarcoma most commonly metastasize?", a: "<b>Lungs</b> — pulmonary metastases are the most common. Also can metastasize to other bones. Chest CT is mandatory at diagnosis." },
{ q: "What is the typical location of Ewing sarcoma?", a: "<b>Diaphysis (shaft) of long bones</b> and <b>flat bones</b> (pelvis, ribs, scapula). Most common in <b>White males</b> aged <b>5–15 years</b>. Extremely rare in Black and Asian children." },
{ q: "What is the classic radiographic appearance of Ewing sarcoma?", a: "<b>Onion-skin (lamellated) periosteal reaction</b> — multiple layers of reactive periosteal new bone. Permeative, lytic, moth-eaten destruction of the <b>diaphysis</b>. Often has a large soft tissue mass." },
{ q: "What is the characteristic translocation in Ewing sarcoma?", a: "<b>t(11;22)</b> — creates the <b>EWSR1-FLI1</b> fusion gene in ~85% of cases. This fusion protein acts as an aberrant transcription factor driving tumor growth." },
{ q: "How does Ewing sarcoma typically present clinically?", a: "<b>Localized pain and swelling</b> over the affected bone. May have <b>fever</b>, elevated ESR, and leukocytosis — mimicking <b>osteomyelitis</b> (important differential). Weight loss and fatigue with advanced disease." },
{ q: "How is Ewing sarcoma treated?", a: "<b>Neoadjuvant chemotherapy</b> → <b>local control</b> (surgery and/or radiation — Ewing is <b>radiosensitive</b>) → <b>adjuvant chemotherapy</b>. Key drugs: vincristine, doxorubicin, cyclophosphamide, ifosfamide, etoposide." },

// ===== RHABDOMYOSARCOMA =====
{ q: "What is the most common soft tissue sarcoma in children?", a: "<b>Rhabdomyosarcoma (RMS)</b> — arises from <b>skeletal muscle precursor cells (rhabdomyoblasts)</b>. Peak age is bimodal: <b>2–6 years</b> and <b>adolescence</b>." },
{ q: "What are the two main histologic subtypes of rhabdomyosarcoma?", a: "<b>Embryonal</b> (~60–70%): More common in younger children, head/neck/GU tract, <b>better prognosis</b>.<br><b>Alveolar</b> (~20–30%): More common in adolescents, trunk/extremities, has <b>t(2;13)</b> or <b>t(1;13)</b>, <b>worse prognosis</b>." },
{ q: "What is sarcoma botryoides?", a: "A subtype of <b>embryonal rhabdomyosarcoma</b> that forms <b>grape-like (polypoid) masses</b> projecting into hollow organs — most commonly the <b>vagina</b> (young girls), <b>bladder</b>, or <b>nasopharynx</b>." },
{ q: "What are the most common primary sites of rhabdomyosarcoma?", a: "<b>Head and neck</b> (~40%): orbit (best prognosis), parameningeal, non-parameningeal.<br><b>Genitourinary</b> (~25%): bladder, prostate, vagina, paratesticular.<br><b>Extremity</b> (~20%): worse prognosis." },
{ q: "What immunohistochemical markers are positive in rhabdomyosarcoma?", a: "<b>Desmin</b>, <b>myogenin</b>, and <b>MyoD1</b> — markers of skeletal muscle differentiation. Cross-striations may be seen on light microscopy." },
{ q: "How is rhabdomyosarcoma treated?", a: "<b>Multimodal therapy</b>: surgery (if feasible) + <b>chemotherapy</b> (VAC: vincristine, actinomycin D, cyclophosphamide) + <b>radiation</b>. Treatment is risk-stratified based on stage, group, histology, and site." },

// ===== LANGERHANS CELL HISTIOCYTOSIS =====
{ q: "What is Langerhans cell histiocytosis (LCH)?", a: "A clonal proliferation of <b>Langerhans-type dendritic cells</b> that infiltrate various organs. Now considered a <b>myeloid neoplasm</b> driven by <b>BRAF V600E</b> mutations in ~50% of cases." },
{ q: "What is the pathognomonic ultrastructural finding in LCH?", a: "<b>Birbeck granules</b> — tennis-racket-shaped cytoplasmic organelles seen on <b>electron microscopy</b>. Cells also express <b>CD1a</b> and <b>CD207 (Langerin)</b> on immunohistochemistry." },
{ q: "What are common skeletal manifestations of LCH?", a: "<b>Lytic ('punched-out') skull lesions</b> are the most characteristic finding. Can also affect other flat and long bones. Presents with pain, swelling, or pathologic fractures. Bone is the most commonly involved organ." },
{ q: "What endocrine complication is associated with LCH?", a: "<b>Diabetes insipidus</b> — due to infiltration of the <b>posterior pituitary/hypothalamus</b>. Presents with polyuria and polydipsia. May be the presenting feature or develop during the disease course." },
{ q: "What skin findings are seen in LCH?", a: "A <b>seborrheic dermatitis-like rash</b> that does not respond to standard treatment — scaly, erythematous, sometimes purpuric papules on the scalp, groin, and behind the ears. Often mistaken for cradle cap in infants." },
{ q: "What was the former name for multisystem LCH?", a: "<b>Letterer-Siwe disease</b> — aggressive multisystem LCH in young children with skin, bone, liver, spleen, and bone marrow involvement. Carries a <b>poor prognosis</b> without treatment." },
{ q: "What was Eosinophilic Granuloma?", a: "The former name for <b>single-system, unifocal LCH</b> — typically a solitary lytic bone lesion. Most common and most benign form. Often self-resolving or cured with curettage ± local steroids." },
{ q: "How is LCH treated?", a: "<b>Single bone lesion</b>: curettage, local steroids, or observation.<br><b>Multisystem/risk-organ involvement</b>: systemic chemotherapy (<b>vinblastine + prednisone</b> as first-line). BRAF inhibitors (vemurafenib) for refractory cases." },

// ===== TUMOR LYSIS SYNDROME =====
{ q: "What is tumor lysis syndrome (TLS)?", a: "An <b>oncologic emergency</b> caused by massive release of intracellular contents from <b>rapidly lysing tumor cells</b>. Most common with high-grade lymphomas (Burkitt) and ALL with high tumor burden. Can occur spontaneously or after initiation of chemotherapy." },
{ q: "What are the four classic electrolyte abnormalities in TLS?", a: "1) <b>Hyperuricemia</b> (nucleic acid breakdown)<br>2) <b>Hyperkalemia</b> (cell lysis)<br>3) <b>Hyperphosphatemia</b> (cell lysis)<br>4) <b>Hypocalcemia</b> (phosphorus binds calcium)" },
{ q: "Why does hypocalcemia occur in TLS?", a: "Massive release of <b>phosphorus</b> from lysed cells causes <b>calcium-phosphate precipitation</b> in tissues, leading to <b>secondary hypocalcemia</b>. This can cause tetany, seizures, and cardiac arrhythmias." },
{ q: "What is the most dangerous consequence of TLS?", a: "<b>Acute kidney injury (AKI)</b> from uric acid crystal deposition and/or calcium-phosphate precipitation in renal tubules. <b>Hyperkalemia</b> causing fatal cardiac arrhythmias is the most immediately life-threatening." },
{ q: "How is TLS prevented?", a: "<b>Aggressive IV hydration</b> (2–3× maintenance) to maintain high urine output.<br><b>Allopurinol</b> (xanthine oxidase inhibitor — prevents new uric acid formation).<br><b>Rasburicase</b> (recombinant urate oxidase — degrades existing uric acid; used for high-risk patients)." },
{ q: "What is rasburicase and when is it used?", a: "<b>Recombinant urate oxidase</b> that converts uric acid to <b>allantoin</b> (much more soluble). Used for <b>high-risk TLS</b> (Burkitt, ALL with high WBC). Contraindicated in <b>G6PD deficiency</b> (causes hemolytic anemia due to H₂O₂ production)." },
{ q: "Why is rasburicase contraindicated in G6PD deficiency?", a: "Rasburicase produces <b>hydrogen peroxide (H₂O₂)</b> as a byproduct of uric acid metabolism. Patients with <b>G6PD deficiency</b> cannot generate adequate NADPH to neutralize H₂O₂, leading to <b>oxidative hemolysis</b>." },
{ q: "What role does urinary alkalinization play in TLS management?", a: "Previously used to <b>increase uric acid solubility</b> in urine (uric acid is more soluble at alkaline pH). However, it is <b>no longer routinely recommended</b> because alkaline urine <b>decreases</b> calcium-phosphate solubility, potentially worsening renal injury." },

// ===== ONCOLOGIC EMERGENCIES =====
{ q: "What is superior mediastinal syndrome (SMS)?", a: "Compression or obstruction of the <b>superior vena cava and/or trachea</b> by an anterior mediastinal mass. In children, most commonly caused by <b>T-cell ALL/lymphoblastic lymphoma</b> or <b>Hodgkin lymphoma</b>." },
{ q: "What are the symptoms of superior mediastinal syndrome?", a: "<b>Facial/neck swelling (plethora)</b>, <b>cough</b>, <b>orthopnea</b>, <b>dyspnea</b>, <b>wheezing</b>, <b>syncope</b>, and <b>distended neck veins</b>. Symptoms worsen when lying supine. Can progress to <b>airway compromise and cardiovascular collapse</b>." },
{ q: "Why is general anesthesia dangerous in superior mediastinal syndrome?", a: "Muscle relaxation and loss of spontaneous respiration can cause <b>complete airway obstruction</b> from the mediastinal mass. Anesthesia/sedation should be <b>avoided if possible</b>. Imaging with <b>CT</b> assesses tracheal compression before any procedure." },
{ q: "What is the management of febrile neutropenia?", a: "Febrile neutropenia (ANC <500/μL + fever ≥38.3°C single or ≥38°C sustained) is a medical emergency. Management: <b>blood cultures</b> → <b>immediate broad-spectrum IV antibiotics</b> (e.g., cefepime, piperacillin-tazobactam, or meropenem). Do NOT wait for culture results." },
{ q: "What organisms are most concerning in febrile neutropenia?", a: "<b>Gram-negative bacilli</b> (Pseudomonas aeruginosa, E. coli, Klebsiella) — high mortality. Also <b>Gram-positive</b> (Staphylococcus, Streptococcus) especially with central lines. <b>Fungal</b> infections if neutropenia is prolonged (>7 days)." },
{ q: "When should antifungal therapy be added in febrile neutropenia?", a: "If fever persists after <b>4–7 days</b> of broad-spectrum antibiotics. Empiric antifungal (e.g., <b>caspofungin</b> or <b>liposomal amphotericin B</b>) is added to cover <b>Candida</b> and <b>Aspergillus</b>." },
{ q: "What is spinal cord compression in oncologic patients and how does it present?", a: "An emergency caused by tumor (neuroblastoma, sarcoma, lymphoma) compressing the spinal cord. Presents with <b>back pain</b>, <b>motor weakness</b>, <b>sensory changes</b>, and <b>bladder/bowel dysfunction</b>. Requires <b>urgent MRI</b> and emergent treatment (steroids, radiation, or surgery)." },
{ q: "What is the initial treatment for oncologic spinal cord compression?", a: "<b>High-dose dexamethasone</b> to reduce edema, followed by urgent <b>radiation therapy</b>, <b>chemotherapy</b> (for chemo-sensitive tumors), or <b>surgical decompression</b>. Delay in treatment can result in permanent paralysis." },

// ===== MISCELLANEOUS / CLINICAL PEARLS =====
{ q: "What childhood cancer classically presents with periorbital ecchymoses (raccoon eyes)?", a: "<b>Neuroblastoma</b> — bilateral periorbital ecchymoses ('raccoon eyes') result from <b>orbital metastases</b>. Also presents with proptosis. This is a classic exam finding." },
{ q: "A child presents with a jaw mass in Africa. What is the likely diagnosis?", a: "<b>Endemic Burkitt lymphoma</b> — strongly associated with <b>EBV</b> and <b>malaria</b> co-infection. Classic presentation is a rapidly growing jaw or facial bone mass." },
{ q: "What is the most common orbital tumor in children?", a: "<b>Rhabdomyosarcoma</b> (embryonal subtype) — most common primary orbital malignancy in children. Presents with rapid <b>proptosis</b> and displacement of the eye. Orbital RMS has a <b>favorable prognosis</b>." },
{ q: "A child with neurofibromatosis presents with visual changes. What is the suspected tumor?", a: "<b>Optic pathway glioma</b> — pilocytic astrocytoma of the optic nerve/chiasm. Most common CNS tumor in NF1. Screen NF1 patients with regular ophthalmologic exams." },
{ q: "What is the triad of Denys-Drash syndrome?", a: "1) <b>Diffuse mesangial sclerosis</b> (nephropathy)<br>2) <b>Male pseudohermaphroditism</b><br>3) <b>Wilms tumor</b><br>Due to <b>WT1 mutations</b>." },
{ q: "What is Hutchinson syndrome in neuroblastoma?", a: "Metastatic neuroblastoma presenting with <b>periorbital ecchymoses</b>, <b>proptosis</b>, and <b>orbital masses</b> from bony orbital metastases. Named after Robert Hutchinson." },
{ q: "What paraneoplastic syndrome is associated with cerebellar hemangioblastoma and other tumors?", a: "<b>Secondary polycythemia</b> from ectopic erythropoietin production. In pediatric oncology, neuroblastoma can cause <b>opsoclonus-myoclonus</b>, and Wilms tumor can cause <b>hypertension</b> (renin secretion)." },
{ q: "What is the Shimada classification in neuroblastoma?", a: "A histopathologic classification that divides neuroblastoma into <b>favorable</b> and <b>unfavorable</b> histology based on the degree of <b>neuroblast differentiation</b>, Schwannian stroma content, mitosis-karyorrhexis index (MKI), and patient age." },
{ q: "What is the role of anti-GD2 antibody therapy in neuroblastoma?", a: "<b>Dinutuximab</b> (anti-GD2 monoclonal antibody) is used in <b>maintenance immunotherapy</b> for high-risk neuroblastoma after consolidation. GD2 is a disialoganglioside expressed on neuroblastoma cell surfaces. Improves event-free survival." },
{ q: "What is hepatoblastoma and its association?", a: "The most common <b>liver malignancy</b> in children (<3 years). Associated with <b>Beckwith-Wiedemann syndrome</b>, <b>familial adenomatous polyposis (FAP)</b>, and very low birth weight. Elevated <b>alpha-fetoprotein (AFP)</b>." },
{ q: "What tumor marker is elevated in hepatoblastoma and germ cell tumors?", a: "<b>Alpha-fetoprotein (AFP)</b> — markedly elevated. Used for diagnosis and monitoring treatment response. Note: AFP is normally elevated in neonates and decreases to adult levels by ~8 months." },
{ q: "What is the significance of the lactate dehydrogenase (LDH) level in pediatric oncology?", a: "<b>LDH</b> is a nonspecific marker of <b>tumor burden and cell turnover</b>. Elevated in many cancers (leukemia, lymphoma, neuroblastoma, Ewing sarcoma). Higher LDH = worse prognosis in several malignancies." },
{ q: "What are late effects of childhood cancer treatment?", a: "<b>Secondary malignancies</b> (from radiation/alkylating agents), <b>cardiomyopathy</b> (anthracyclines), <b>pulmonary fibrosis</b> (bleomycin), <b>infertility</b> (alkylating agents), <b>growth failure</b> (cranial radiation), <b>neurocognitive deficits</b>, and <b>endocrine dysfunction</b>." },
{ q: "What is the risk of cardiomyopathy from anthracycline therapy?", a: "Anthracyclines (doxorubicin, daunorubicin) cause <b>dose-dependent cardiotoxicity</b>. Risk increases with cumulative dose >300 mg/m². Can cause <b>dilated cardiomyopathy</b> years to decades later. <b>Dexrazoxane</b> may be cardioprotective." },
{ q: "What is the chemotherapy drug most associated with hemorrhagic cystitis?", a: "<b>Cyclophosphamide</b> and ifosfamide — their metabolite <b>acrolein</b> is toxic to the bladder mucosa. Prevented with <b>MESNA</b> (binds acrolein) and aggressive hydration." },
{ q: "What is the mechanism of vincristine's peripheral neuropathy?", a: "Vincristine is a <b>vinca alkaloid</b> that inhibits <b>microtubule polymerization</b>. This disrupts axonal transport, causing <b>peripheral neuropathy</b> (foot drop, loss of DTRs, constipation from autonomic neuropathy). Dose-limiting toxicity." },
{ q: "What childhood cancer is associated with hemihypertrophy?", a: "<b>Wilms tumor</b> and <b>hepatoblastoma</b>. Hemihypertrophy is a feature of <b>Beckwith-Wiedemann syndrome</b>. Children with isolated hemihypertrophy should be screened with serial abdominal ultrasounds and AFP levels." },
{ q: "What is the classic triad of increased intracranial pressure in an infant with a brain tumor?", a: "<b>Bulging fontanelle</b>, <b>split sutures</b> (diastasis), and <b>increasing head circumference</b> (macrocephaly). In older children: headache (worse in the morning), vomiting, and papilledema." },
{ q: "What is the role of PET-CT in pediatric oncology?", a: "<b>FDG-PET/CT</b> is most useful in <b>Hodgkin lymphoma</b> (staging and response assessment — Deauville scoring) and some NHLs. Less useful in brain tumors (high background uptake) and low-grade tumors." },
{ q: "Which childhood tumor can cause precocious puberty?", a: "<b>CNS germ cell tumors</b> (especially those secreting β-hCG, e.g., choriocarcinoma) and <b>hypothalamic hamartoma</b> (non-neoplastic). Craniopharyngioma more often causes <b>delayed</b> puberty." },
{ q: "What is the most common cause of death from childhood cancer?", a: "<b>Brain tumors</b> — due to local recurrence and limited treatment options for some subtypes (e.g., DIPG). Leukemia is the most common cancer, but brain tumors have the highest mortality." }
          ]
        },
        {
          section: 'Advanced Pediatrics',
          topic: "Developmental & behavioral pediatrics",
          icon: "baby",
          cards: [
            // ===== NORMAL DEVELOPMENTAL MILESTONES — GROSS MOTOR =====
{ q: "At what age does an infant achieve steady head control (no head lag when pulled to sit)?", a: "<b>4 months.</b> By 4 months the infant holds head steady in a supported sitting position and has minimal head lag on pull-to-sit." },
{ q: "At what age does a typically developing infant sit without support?", a: "<b>6 months.</b> The infant can sit in a tripod position by ~5 months and independently by 6 months." },
{ q: "When does an infant begin to pull to stand?", a: "<b>9 months.</b> The infant uses furniture or a caregiver to pull from sitting to standing." },
{ q: "At what age does a child typically walk independently?", a: "<b>12 months</b> (range 9–15 months). Walking with a wide-based gait; hands held high for balance." },
{ q: "When does a toddler begin to run?", a: "<b>18 months.</b> The gait is stiff-legged and wide-based; falls are frequent." },
{ q: "At what age can a child walk up stairs with alternating feet?", a: "<b>3 years.</b> Before this, children ascend stairs by placing both feet on each step (mark-time pattern, ~2 years)." },
{ q: "At what age does a child hop on one foot?", a: "<b>4 years.</b> Skipping (alternating hop-step) appears by 5 years." },
{ q: "At what age does a child ride a tricycle?", a: "<b>3 years.</b> This requires coordination of pedaling, steering, and balance." },
{ q: "What gross motor milestone is expected at 2 months?", a: "Lifts head and chest when prone (head up to ~45°). Also begins to bear weight briefly on forearms." },
{ q: "When does an infant begin to roll over (front to back)?", a: "<b>4 months</b> (front→back first). Back→front rolling typically follows by ~5–6 months." },
{ q: "When does cruising (walking while holding onto furniture) develop?", a: "<b>9–10 months.</b> Cruising is a precursor to independent walking." },

// ===== NORMAL DEVELOPMENTAL MILESTONES — FINE MOTOR =====
{ q: "At what age does an infant develop a raking (palmar) grasp?", a: "<b>5–6 months.</b> The infant uses the whole hand to rake objects toward themselves." },
{ q: "At what age does the pincer grasp develop?", a: "<b>9 months.</b> The thumb and index finger oppose to pick up small objects (e.g., Cheerios)." },
{ q: "When can a toddler build a tower of 2 blocks?", a: "<b>15 months.</b> Rule of thumb: tower height in blocks ≈ age in years × 3 (2 blocks at 15 mo, 6 blocks at 2 yr, 9–10 at 3 yr)." },
{ q: "When can a child build a tower of 6 blocks?", a: "<b>2 years (24 months).</b>" },
{ q: "At what age can a child copy a circle?", a: "<b>3 years.</b> Progression: vertical line (2 yr) → circle (3 yr) → cross/square (4 yr) → triangle (5 yr)." },
{ q: "When does a child begin to use a spoon to self-feed?", a: "<b>15 months.</b> Initially messy; by 18 months more coordinated." },
{ q: "What fine motor skill is expected at 12 months?", a: "Mature pincer grasp (tips of thumb and forefinger), releases objects voluntarily, and can place objects in a container." },
{ q: "At what age does a child draw a recognizable person (head, body, limbs)?", a: "<b>4–5 years.</b> By 5 years, a person with ≥6 body parts is expected." },
{ q: "What shape can a 4-year-old copy?", a: "A <b>cross (+) and a square.</b> Triangle copying comes at 5 years." },
{ q: "When does hand dominance typically become established?", a: "<b>By 18–24 months</b> but may not be firmly set until 3–4 years. Consistent hand preference before 18 months suggests contralateral motor impairment (e.g., hemiplegia)." },

// ===== NORMAL DEVELOPMENTAL MILESTONES — LANGUAGE =====
{ q: "At what age does an infant begin to coo?", a: "<b>2 months.</b> Cooing = vowel-like sounds ('ooh', 'aah')." },
{ q: "When does babbling begin?", a: "<b>6 months.</b> Babbling = consonant-vowel combinations ('ba-ba', 'da-da'), initially non-specific." },
{ q: "At what age does a child say their first specific word (e.g., 'mama' used specifically)?", a: "<b>12 months.</b> Vocabulary of 1–3 words beyond 'mama/dada.'" },
{ q: "How many words should a child have at 18 months?", a: "<b>≥10–20 words.</b> Fewer than 10 words at 18 months warrants a hearing evaluation and developmental assessment." },
{ q: "When does a child begin to use 2-word phrases?", a: "<b>24 months (2 years).</b> E.g., 'want milk,' 'go bye-bye.' This is called telegraphic speech." },
{ q: "At what age does a child speak in sentences (3+ words)?", a: "<b>3 years.</b> By 3 years, 75% of speech should be intelligible to strangers." },
{ q: "What is the expected vocabulary size at 2 years?", a: "<b>~50–200+ words.</b> A 'vocabulary explosion' occurs around 18–24 months." },
{ q: "What percentage of a 2-year-old's speech should be understandable to strangers?", a: "<b>~50%.</b> Rule: 25% at 1 yr, 50% at 2 yr, 75% at 3 yr, ~100% at 4 yr." },
{ q: "At what age can a child follow a 2-step command?", a: "<b>2 years.</b> E.g., 'Pick up the ball and bring it to me.'" },
{ q: "When does a child understand the concept of 'mine' and begin to use pronouns?", a: "<b>24 months.</b> Correct pronoun use (I, you, he/she) develops by ~3 years." },

// ===== NORMAL DEVELOPMENTAL MILESTONES — SOCIAL/EMOTIONAL =====
{ q: "At what age does the social smile appear?", a: "<b>2 months.</b> The social smile is a smile in response to a face or voice (not reflexive)." },
{ q: "When does stranger anxiety develop?", a: "<b>6–9 months</b> (peak 9–12 months). The infant becomes distressed in the presence of unfamiliar adults." },
{ q: "What is separation anxiety and when does it peak?", a: "Distress when separated from primary caregiver. Peaks at <b>9–18 months</b>; typically resolves by 2–3 years." },
{ q: "What type of play characterizes a 2-year-old?", a: "<b>Parallel play.</b> Children play alongside but not with each other." },
{ q: "When does cooperative/interactive play develop?", a: "<b>4 years.</b> Children engage in shared play with rules and assigned roles." },
{ q: "At what age does a child begin to engage in symbolic/pretend play?", a: "<b>18–24 months.</b> E.g., feeding a doll, talking on a toy phone." },
{ q: "When does a child typically know their first and last name?", a: "<b>2.5–3 years.</b>" },
{ q: "At what age can a child dress and undress independently?", a: "<b>4–5 years.</b> Buttons managed by ~4 yr; shoe-tying by ~5–6 yr." },

// ===== DEVELOPMENTAL SCREENING =====
{ q: "What is developmental surveillance?", a: "A <b>continuous, flexible process</b> performed at every well-child visit that includes eliciting parental concerns, observing the child, and identifying risk factors." },
{ q: "Name two validated developmental screening tools.", a: "<b>1) Ages & Stages Questionnaire (ASQ)</b> — parent-completed; covers communication, gross/fine motor, problem-solving, personal-social.<br><b>2) Denver Developmental Screening Test (Denver II)</b> — administered by clinician; screens 4 domains." },
{ q: "What are the four domains assessed by the Denver II?", a: "1) Gross motor, 2) Fine motor–adaptive, 3) Language, 4) Personal–social." },
{ q: "At what ages does the AAP recommend formal developmental screening with a standardized tool?", a: "<b>9, 18, and 30 months.</b>" },
{ q: "At what ages does the AAP recommend autism-specific screening?", a: "<b>18 and 24 months</b> (using the M-CHAT-R/F)." },
{ q: "What is the M-CHAT-R/F?", a: "<b>Modified Checklist for Autism in Toddlers, Revised with Follow-Up.</b> A parent-completed 20-item questionnaire for children 16–30 months to screen for ASD risk." },
{ q: "What should be done if a child fails the M-CHAT-R/F screen?", a: "Administer the <b>follow-up interview</b> (M-CHAT-R/F). If still positive → immediate referral for comprehensive ASD evaluation AND early intervention services." },
{ q: "What is the difference between developmental screening and developmental evaluation?", a: "<b>Screening</b> = brief tool to identify children at risk. <b>Evaluation</b> = comprehensive multidisciplinary assessment to establish diagnosis and guide therapy." },

// ===== AUTISM SPECTRUM DISORDER =====
{ q: "What are the two core domains of impairment in ASD per DSM-5?", a: "<b>1) Persistent deficits in social communication and social interaction</b> (across multiple contexts).<br><b>2) Restricted, repetitive patterns of behavior, interests, or activities.</b>" },
{ q: "List 3 early red flags for ASD before 12 months.", a: "1) Poor eye contact, 2) lack of response to name, 3) absence of joint attention (not following a point or showing objects)." },
{ q: "What are the 'red flag' language milestones that raise concern for ASD?", a: "No pointing/gestures by <b>12 months</b>, no single words by <b>16 months</b>, no 2-word spontaneous phrases by <b>24 months</b>, and any loss of previously acquired language at any age." },
{ q: "What is autistic regression?", a: "Loss of previously acquired language or social skills, occurring in ~<b>25–30%</b> of children with ASD, typically between <b>15–24 months</b>." },
{ q: "What is the first-line behavioral intervention for ASD?", a: "<b>Applied Behavior Analysis (ABA).</b> Early intensive behavioral intervention (25–40 hr/week) has the strongest evidence." },
{ q: "Name additional therapies used in ASD management.", a: "1) <b>Speech-language therapy</b>, 2) <b>Occupational therapy</b> (sensory integration), 3) Social skills training, 4) Special education services." },
{ q: "Are there FDA-approved medications that treat the core symptoms of ASD?", a: "<b>No.</b> Risperidone and aripiprazole are FDA-approved only for <b>irritability/aggression</b> associated with ASD in children ≥5–6 years." },
{ q: "What is the male-to-female ratio in ASD?", a: "<b>~4:1</b> (males more commonly diagnosed). Females may be under-recognized due to different phenotypic presentation (masking)." },
{ q: "What genetic conditions are associated with increased ASD risk?", a: "<b>Fragile X syndrome, tuberous sclerosis, Rett syndrome, Down syndrome, 15q11-13 duplications, 22q11.2 deletion (DiGeorge).</b>" },
{ q: "What is the DSM-5 severity classification for ASD?", a: "Based on level of support needed: <b>Level 1</b> = requiring support; <b>Level 2</b> = requiring substantial support; <b>Level 3</b> = requiring very substantial support." },

// ===== ADHD =====
{ q: "What are the DSM-5 diagnostic criteria for ADHD?", a: "≥<b>6 symptoms</b> (or ≥5 if age ≥17) of inattention and/or hyperactivity-impulsivity, present for ≥6 months, onset <b>before age 12</b>, in <b>≥2 settings</b>, with functional impairment, not better explained by another disorder." },
{ q: "Name the three ADHD presentations (subtypes) per DSM-5.", a: "1) <b>Predominantly inattentive</b>, 2) <b>Predominantly hyperactive-impulsive</b>, 3) <b>Combined</b> (most common overall)." },
{ q: "What is the first-line pharmacotherapy for ADHD in children ≥6 years?", a: "<b>Stimulant medications:</b> methylphenidate (Ritalin, Concerta) or amphetamine salts (Adderall, Vyvanse)." },
{ q: "What is the first-line treatment for ADHD in preschool children (4–5 years)?", a: "<b>Behavioral therapy alone</b> is first-line per AAP. Methylphenidate may be considered if behavioral therapy is insufficient." },
{ q: "Name three non-stimulant medications for ADHD.", a: "1) <b>Atomoxetine</b> (NE reuptake inhibitor), 2) <b>Guanfacine ER</b> (α₂-agonist), 3) <b>Clonidine ER</b> (α₂-agonist)." },
{ q: "What are common side effects of stimulant medications?", a: "<b>Decreased appetite, weight loss, insomnia, headache, abdominal pain, increased HR/BP.</b> Growth velocity should be monitored." },
{ q: "What is a 'drug holiday' in ADHD management?", a: "A <b>structured break from stimulant medication</b> (e.g., during summer) to assess baseline behavior and allow catch-up growth." },
{ q: "Which ADHD presentation is most commonly missed in girls?", a: "<b>Predominantly inattentive type.</b> Girls often present with 'daydreaming' and disorganization rather than hyperactivity." },
{ q: "What comorbidities are commonly associated with ADHD?", a: "<b>ODD (40–60%), conduct disorder, anxiety, depression, learning disabilities, tic disorders.</b>" },
{ q: "At what age can ADHD be reliably diagnosed?", a: "<b>4 years</b> is the youngest per AAP guidelines. Symptoms must be present in ≥2 settings and cause impairment." },
{ q: "What is the mechanism of action of methylphenidate?", a: "Blocks reuptake of <b>dopamine and norepinephrine</b> at the presynaptic neuron, increasing their availability in the prefrontal cortex." },
{ q: "What is the mechanism of atomoxetine?", a: "<b>Selective norepinephrine reuptake inhibitor (NRI).</b> Non-stimulant; has a black-box warning for suicidal ideation in children/adolescents." },

// ===== INTELLECTUAL DISABILITY =====
{ q: "How is intellectual disability (ID) defined?", a: "Onset during the developmental period with deficits in: 1) <b>Intellectual functioning</b> (IQ <70), AND 2) <b>Adaptive functioning</b> (conceptual, social, practical domains)." },
{ q: "What is the most common genetic cause of intellectual disability?", a: "<b>Down syndrome (trisomy 21).</b>" },
{ q: "What is the most common inherited (heritable) cause of intellectual disability?", a: "<b>Fragile X syndrome</b> (X-linked; CGG trinucleotide repeat expansion in FMR1 gene)." },
{ q: "Describe the classic phenotype of Fragile X syndrome.", a: "<b>Long face, prominent ears, macroorchidism</b> (post-pubertal), intellectual disability (mild-moderate), ADHD, anxiety, autistic features. More severe in males." },
{ q: "What is the most common preventable cause of intellectual disability?", a: "<b>Fetal alcohol spectrum disorders (FASD).</b>" },
{ q: "Describe the features of fetal alcohol syndrome (FAS).", a: "<b>1) Growth restriction</b> (pre/postnatal), <b>2) CNS dysfunction</b> (microcephaly, ID, behavioral issues), <b>3) Characteristic facies</b>: smooth philtrum, thin vermillion border, short palpebral fissures." },
{ q: "What IQ range corresponds to mild intellectual disability?", a: "<b>50–70.</b> Mild ID accounts for ~85% of all cases. These individuals can often achieve academic skills to ~6th grade level." },
{ q: "What is the classification of ID severity by IQ?", a: "<b>Mild: 50–70</b>, Moderate: 35–50, Severe: 20–35, Profound: <20." },
{ q: "What initial workup is recommended for a child with unexplained ID?", a: "<b>Chromosomal microarray (CMA)</b> is first-line genetic test. Also: Fragile X testing, metabolic screening (TFTs, lead, amino acids), brain MRI if indicated, hearing and vision testing." },

// ===== LEARNING DISABILITIES =====
{ q: "What is dyslexia?", a: "A <b>specific learning disability in reading</b> characterized by difficulties with accurate/fluent word recognition, poor decoding, and spelling. It is the most common learning disability." },
{ q: "What is dyscalculia?", a: "A <b>specific learning disability in mathematics</b> — difficulty understanding number concepts, arithmetic facts, and mathematical reasoning." },
{ q: "What is dysgraphia?", a: "A <b>specific learning disability in written expression</b> — difficulty with handwriting, spelling, and organizing written thoughts." },
{ q: "How is a specific learning disability diagnosed?", a: "A significant <b>discrepancy between intellectual ability and academic achievement</b> in a specific domain, confirmed by standardized testing. DSM-5 requires symptoms ≥6 months despite targeted intervention." },
{ q: "What is an IEP (Individualized Education Program)?", a: "A legally binding document under <b>IDEA (Individuals with Disabilities Education Act)</b> providing specialized instruction, goals, and related services for students with qualifying disabilities." },
{ q: "What is a 504 Plan?", a: "A plan under <b>Section 504 of the Rehabilitation Act</b> providing accommodations (e.g., extra time, preferential seating) for students with disabilities. Does NOT provide specialized instruction like an IEP." },
{ q: "What is the key difference between an IEP and a 504 Plan?", a: "An <b>IEP</b> provides specialized instruction and services (under IDEA). A <b>504 Plan</b> provides accommodations only (under Section 504). IEP has more legal protections and requires eligibility in specific disability categories." },

// ===== BEHAVIORAL DISORDERS =====
{ q: "What is oppositional defiant disorder (ODD)?", a: "A pattern of <b>angry/irritable mood, argumentative/defiant behavior, and vindictiveness</b> lasting ≥6 months, with ≥4 symptoms, occurring with non-sibling individuals." },
{ q: "What is conduct disorder (CD)?", a: "A repetitive, persistent pattern of behavior violating the <b>basic rights of others or societal norms</b>: aggression to people/animals, property destruction, deceitfulness/theft, serious rule violations." },
{ q: "How does ODD differ from conduct disorder?", a: "ODD involves defiance and irritability but <b>no violation of others' basic rights or major societal norms.</b> CD is more severe and includes aggression, destruction, and criminal behaviors." },
{ q: "What is the natural progression of disruptive behavior disorders?", a: "A subset of children progress: <b>ODD → Conduct Disorder → Antisocial Personality Disorder</b> (diagnosed ≥18 yr). Early onset and callous-unemotional traits are risk factors." },
{ q: "What is separation anxiety disorder?", a: "Excessive, developmentally inappropriate anxiety about separation from attachment figures, lasting ≥<b>4 weeks</b> in children. Causes significant distress or functional impairment." },
{ q: "What is selective mutism?", a: "Consistent failure to speak in specific social situations (e.g., school) despite speaking in others (e.g., home). Duration ≥<b>1 month</b> (not first month of school). Strongly associated with <b>social anxiety</b>." },
{ q: "What is primary nocturnal enuresis?", a: "<b>Involuntary urination during sleep</b> in a child ≥5 years who has <b>never</b> achieved ≥6 months of nighttime dryness." },
{ q: "What is secondary enuresis?", a: "Resumption of bedwetting after ≥<b>6 months</b> of nighttime dryness. Requires evaluation for underlying causes (UTI, diabetes, stress, abuse, constipation)." },
{ q: "What is the first-line treatment for primary nocturnal enuresis?", a: "<b>Behavioral: bedwetting alarm (enuresis alarm).</b> Highest long-term cure rate (~65–70%). Positive reinforcement for dry nights." },
{ q: "What medication is used for nocturnal enuresis?", a: "<b>Desmopressin (DDAVP)</b> — synthetic ADH analog; reduces nighttime urine production. High relapse after discontinuation. <b>TCAs (imipramine)</b> — second-line, risk of cardiotoxicity." },
{ q: "What is encopresis?", a: "Repeated passage of feces in inappropriate places (clothing, floor) in a child ≥<b>4 years</b>, at least once/month for ≥3 months. Most commonly due to <b>functional constipation with overflow incontinence</b>." },
{ q: "How is retentive encopresis managed?", a: "<b>1) Disimpaction</b> (PEG 3350, enemas), <b>2) Maintenance laxatives</b> (PEG 3350 daily), <b>3) Behavioral: scheduled toileting</b> after meals, positive reinforcement. Education that child is not doing it purposefully." },

// ===== CHILD DEVELOPMENT THEORIES — PIAGET =====
{ q: "Name the 4 stages of Piaget's cognitive development theory.", a: "1) <b>Sensorimotor</b> (0–2 yr), 2) <b>Preoperational</b> (2–7 yr), 3) <b>Concrete operational</b> (7–11 yr), 4) <b>Formal operational</b> (≥12 yr)." },
{ q: "What is the key achievement of the sensorimotor stage (Piaget)?", a: "<b>Object permanence</b> — understanding that objects continue to exist even when out of sight. Develops around <b>8–9 months</b>." },
{ q: "What characterizes the preoperational stage (Piaget)?", a: "<b>Symbolic thinking, egocentrism, animism, centration, lack of conservation.</b> The child cannot take another's perspective and believes inanimate objects have feelings." },
{ q: "What is 'conservation' in Piaget's theory?", a: "Understanding that quantity remains the same despite changes in shape/appearance (e.g., same volume of water in a tall vs wide glass). Mastered in the <b>concrete operational stage (7–11 yr)</b>." },
{ q: "What defines the concrete operational stage (Piaget)?", a: "Logical thinking about <b>concrete events</b>; understanding of conservation, reversibility, seriation, and classification. Cannot yet think abstractly." },
{ q: "What is the hallmark of Piaget's formal operational stage?", a: "<b>Abstract and hypothetical thinking.</b> The adolescent can reason about hypothetical situations, use deductive logic, and think about possibilities." },

// ===== CHILD DEVELOPMENT THEORIES — ERIKSON =====
{ q: "What is Erikson's psychosocial conflict for infancy (0–1 yr)?", a: "<b>Trust vs. Mistrust.</b> Consistent, responsive caregiving → basic trust. Failure → mistrust and insecurity." },
{ q: "What is Erikson's psychosocial conflict for toddlerhood (1–3 yr)?", a: "<b>Autonomy vs. Shame and Doubt.</b> The toddler asserts independence ('No!'). Over-control → shame and doubt." },
{ q: "What is Erikson's psychosocial conflict for the preschool years (3–6 yr)?", a: "<b>Initiative vs. Guilt.</b> The child begins to initiate activities and assert control. Excessive restriction → guilt." },
{ q: "What is Erikson's psychosocial conflict for school age (6–12 yr)?", a: "<b>Industry vs. Inferiority.</b> The child develops competence through school and peer interactions. Failure → feelings of inferiority." },
{ q: "What is Erikson's psychosocial conflict for adolescence (12–18 yr)?", a: "<b>Identity vs. Role Confusion.</b> The adolescent explores personal identity, values, and goals." },

// ===== SPEECH AND LANGUAGE DELAY =====
{ q: "What is the difference between expressive and receptive language delay?", a: "<b>Expressive</b> = difficulty producing speech/language. <b>Receptive</b> = difficulty understanding language. Receptive delay generally carries a worse prognosis." },
{ q: "What is the first step in evaluating a child with speech delay?", a: "<b>Audiologic (hearing) evaluation.</b> Hearing loss is the most common treatable cause of language delay." },
{ q: "Name risk factors for speech and language delay.", a: "Family history, prematurity, chronic otitis media with effusion, male sex, low socioeconomic status, bilingual environment (transient), neglect, neurologic disorders, craniofacial anomalies (cleft palate)." },
{ q: "What is a 'late talker'?", a: "A child 18–35 months with <b>limited expressive vocabulary</b> but normal receptive language, cognition, and motor skills. ~50–70% catch up by age 3; the rest may have a language disorder." },
{ q: "When should a child be referred for speech-language evaluation?", a: "No babbling by 12 months, no words by 18 months, no 2-word phrases by 24 months, regression of language at any age, or speech unintelligible to strangers >50% at 3 years." },
{ q: "What is the role of chronic otitis media with effusion (OME) in language delay?", a: "OME causes <b>intermittent conductive hearing loss</b> during a critical period for language acquisition. Persistent bilateral OME ≥3 months with hearing loss may warrant <b>tympanostomy tubes</b>." },

// ===== FAILURE TO THRIVE =====
{ q: "How is failure to thrive (FTT) defined?", a: "Weight <b><3rd percentile</b> for age, or weight <b>crossing ≥2 major percentile lines</b> downward, or weight-for-length <5th percentile." },
{ q: "What is the difference between organic and non-organic FTT?", a: "<b>Organic FTT</b>: due to a medical condition (GERD, celiac, CF, CHD, metabolic). <b>Non-organic FTT</b>: due to inadequate caloric intake from psychosocial factors (poverty, neglect, improper feeding). Most FTT is non-organic or mixed." },
{ q: "What pattern of growth parameter changes is classic for non-organic FTT?", a: "<b>Weight affected first</b>, then length/height, then head circumference last. (If head circumference affected first → consider primary CNS pathology.)" },
{ q: "What is the caloric requirement for catch-up growth in FTT?", a: "Approximately <b>150% of the recommended caloric intake</b> for the child's expected (not actual) weight: $\\\\text{Cal} = \\\\frac{\\\\text{RDA for age} \\times \\text{ideal weight (kg)}}{\\\\text{actual weight (kg)}}$" },
{ q: "What initial workup is recommended for FTT?", a: "<b>Thorough dietary history, feeding observation, CBC, BMP, urinalysis, lead level.</b> Further testing guided by history/exam (celiac panel, sweat chloride, TFTs). Social work referral if neglect suspected." },
{ q: "What is the most important intervention for most cases of FTT?", a: "<b>Nutritional counseling and adequate caloric intake.</b> Correcting feeding practices, increasing caloric density, and addressing psychosocial factors." },
{ q: "At what age does the normal physiologic nadir of weight-for-age percentile occur in breastfed infants?", a: "Breastfed infants may <b>cross percentile lines downward between 6–12 months</b> on CDC charts. WHO growth charts (which are based on breastfed infants) are recommended for children <2 years." },

// ===== PALATAL AND DENTAL DEVELOPMENT =====
{ q: "When do primary (deciduous) teeth begin to erupt?", a: "<b>~6 months</b> (range 4–10 months). The lower central incisors erupt first." },
{ q: "What is the expected number of teeth by age 1 year?", a: "<b>6–8 teeth</b> (typically the 4 upper and 2–4 lower incisors). Rule of thumb: # teeth = age in months − 6 (up to ~24 months)." },
{ q: "When is the primary dentition complete?", a: "By <b>~2.5–3 years</b>, all 20 primary teeth are typically present." },
{ q: "When do the first permanent teeth erupt?", a: "<b>~6 years.</b> The first permanent molars ('6-year molars') and lower central incisors erupt first." },
{ q: "What is natal vs neonatal teeth?", a: "<b>Natal teeth</b>: present at birth. <b>Neonatal teeth</b>: erupt within the first 30 days of life. May need extraction if loose (aspiration risk) or causing feeding difficulty." },
{ q: "What is the recommended age for first dental visit?", a: "<b>By age 1 year</b> (or within 6 months of eruption of the first tooth), per AAP and AAPD." },
{ q: "When does palatal closure occur during fetal development?", a: "The palatal shelves fuse by <b>~10–12 weeks' gestation.</b> Failure of fusion → cleft palate." },

// ===== ADDITIONAL HIGH-YIELD TOPICS =====
{ q: "What is the Moro reflex and when does it disappear?", a: "Symmetric abduction and extension of arms followed by adduction ('embrace'). Present at birth; disappears by <b>4–6 months.</b> Asymmetry → brachial plexus injury or fracture." },
{ q: "When does the palmar grasp reflex disappear?", a: "<b>4–6 months.</b> Persistence beyond 6 months may indicate upper motor neuron lesion." },
{ q: "When does the Babinski reflex become abnormal?", a: "Upgoing toes (extensor plantar response) is <b>normal in infants until ~12–24 months.</b> After age 2 years, a positive Babinski = upper motor neuron lesion." },
{ q: "What is the tonic neck reflex (fencing posture) and when does it resolve?", a: "Turning the head to one side → extension of ipsilateral arm + flexion of contralateral arm. Present ~1 month; disappears by <b>4–6 months.</b> Persistence → CNS pathology." },
{ q: "What reflex must disappear before an infant can roll over?", a: "<b>Asymmetric tonic neck reflex (ATNR).</b> Its persistence prevents the rotational body movements needed for rolling." },
{ q: "What is the parachute reflex and when does it appear?", a: "Extension of arms when infant is held prone and tilted toward the ground. Appears by <b>8–9 months</b> and persists for life. Absence → motor abnormality." },
{ q: "At what ages are Erikson's first four stages, and how do they map to Freud's psychosexual stages?", a: "Trust vs Mistrust (0–1 yr) = <b>Oral</b>; Autonomy vs Shame (1–3 yr) = <b>Anal</b>; Initiative vs Guilt (3–6 yr) = <b>Phallic/Oedipal</b>; Industry vs Inferiority (6–12 yr) = <b>Latency</b>." },
{ q: "What is Vygotsky's 'Zone of Proximal Development'?", a: "The gap between what a child can do <b>independently</b> and what they can do with <b>guidance</b> from a skilled partner (scaffolding). Learning occurs most effectively within this zone." },
{ q: "What is 'temperament' and who described the three classic types?", a: "Innate behavioral style. <b>Thomas & Chess</b> described: 1) Easy (40%), 2) Difficult (10%), 3) Slow-to-warm-up (15%). ~35% are mixed." },
{ q: "What is the critical difference between global developmental delay and intellectual disability?", a: "<b>Global developmental delay (GDD)</b>: used for children <b><5 years</b> with significant delays in ≥2 domains. <b>Intellectual disability</b>: diagnosed ≥5 years when IQ can be reliably measured." },
{ q: "What is Rett syndrome?", a: "An X-linked dominant neurodevelopmental disorder (MECP2 mutation), almost exclusively in <b>girls</b>. Normal development until 6–18 months → regression: loss of hand skills, hand-wringing stereotypies, deceleration of head growth, gait abnormalities, seizures." },
{ q: "What metabolic condition must be ruled out in all children with global developmental delay?", a: "<b>Hypothyroidism.</b> Detected on newborn screen (TSH). Untreated congenital hypothyroidism → irreversible intellectual disability (cretinism)." },
{ q: "What is the Denver II scoring: what does 'caution' mean?", a: "A <b>Caution</b> = failure on an item that 75–90% of children the same age can pass. An <b>Abnormal</b> screen = ≥2 Delays (failure on items passed by >90% of same-age peers)." },
{ q: "What percentage of children with ADHD continue to have symptoms into adulthood?", a: "<b>~50–60%</b> continue to have at least some impairing symptoms into adulthood." },
{ q: "Name the FDA-approved medications for irritability in ASD and their age approvals.", a: "<b>Risperidone</b> — approved for children ≥5 years. <b>Aripiprazole</b> — approved for children ≥6 years." },
{ q: "What should be monitored in a child on risperidone or aripiprazole?", a: "<b>Weight, BMI, fasting glucose, lipids, prolactin level.</b> Risk of metabolic syndrome, tardive dyskinesia, and hyperprolactinemia (especially risperidone)." },
{ q: "What is the Ages & Stages Questionnaire (ASQ)?", a: "A <b>parent-completed</b> screening tool for children 1–66 months. Covers 5 domains: communication, gross motor, fine motor, problem-solving, and personal-social. Available as ASQ-3 and ASQ:SE (social-emotional)." },
{ q: "When should a child with suspected developmental delay be referred to Early Intervention (EI)?", a: "<b>Immediately</b>, even before a definitive diagnosis. EI services are federally mandated under <b>IDEA Part C</b> for children birth to 3 years." },
{ q: "What services transition replaces Early Intervention after age 3?", a: "<b>IDEA Part B</b> (school-based special education services, including IEP). Transition planning should begin at age 2.5 years." },
{ q: "What is the estimated prevalence of ASD?", a: "<b>~1 in 36 children</b> (CDC, 2023 data). Prevalence has been increasing due to broader diagnostic criteria and improved screening." },
{ q: "What is pica and when is it considered pathological?", a: "Persistent eating of non-nutritive, non-food substances for ≥<b>1 month</b>, at an age when it is developmentally inappropriate (≥2 years). Associated with iron deficiency, lead poisoning, ID, and ASD." },
{ q: "What is the caloric requirement for infants 0–6 months?", a: "<b>~100–120 kcal/kg/day</b> (range depending on age and activity). Breast milk/formula provides ~20 kcal/oz." },
{ q: "What anticipatory guidance should be given at the 2-month well-child visit regarding development?", a: "Expect: social smile, cooing, head lifting in prone. Encourage: tummy time, face-to-face interaction, reading aloud, responding to infant's cues." },
{ q: "What is the significance of a head circumference crossing percentile lines upward?", a: "May indicate <b>hydrocephalus, subdural hematoma/effusion, or megalencephaly.</b> Evaluate with head ultrasound (if fontanelle open) or brain MRI." },
{ q: "What is the anterior fontanelle and when does it close?", a: "Diamond-shaped soft spot at the junction of frontal and parietal bones. Closes by <b>12–18 months</b> (range 9–24 months). Premature closure → craniosynostosis." },
{ q: "When should a child achieve daytime bladder continence?", a: "<b>By 4 years</b> in most children (girls earlier than boys). Nighttime dryness typically follows by 5–7 years." },
{ q: "What are the Tanner stages of pubertal development?", a: "Tanner I = prepubertal. Tanner II–IV = progressive development. Tanner V = adult. <b>First sign of puberty:</b> thelarche (breast buds) in girls (~8–13 yr); testicular enlargement (>4 mL) in boys (~9–14 yr)." },
{ q: "At what age does birth weight double? Triple?", a: "Birth weight <b>doubles by ~4–5 months</b> and <b>triples by ~12 months.</b>" },
{ q: "What is the expected rate of weight gain from birth to 6 months?", a: "<b>~20–30 g/day</b> (roughly 1 oz/day). From 6–12 months, it slows to ~15 g/day." }
          ]
        },
        {
          section: 'Advanced Pediatrics',
          topic: "Pediatric nephrology & endocrinology",
          icon: "filter",
          cards: [
            // ===== NEPHROLOGY: UTI IN CHILDREN (Cards 1-12) =====
{ q: "What is the most common bacterial cause of UTI in children?", a: "<b>Escherichia coli</b> — accounts for ~80% of pediatric UTIs. Other organisms include Klebsiella, Proteus (common in boys, produces urease → alkaline urine & struvite stones), and Enterococcus." },
{ q: "How does UTI typically present in neonates and infants (<2 years)?", a: "<b>Non-specific symptoms</b>: fever without a source, irritability, poor feeding, vomiting, failure to thrive, jaundice (especially in neonates). Classic dysuria/frequency/urgency are NOT reliably reported at this age." },
{ q: "How does UTI present in older children (>2 years)?", a: "More <b>localizing symptoms</b>: dysuria, urinary frequency, urgency, suprapubic pain (cystitis), or flank pain, high fever, and costovertebral angle tenderness (pyelonephritis). Enuresis in a previously toilet-trained child can also signal UTI." },
{ q: "What is the gold-standard urine collection method for diagnosing UTI in infants <2 years?", a: "<b>Urethral catheterization</b> or <b>suprapubic aspiration (SPA)</b>. Bag specimens have a high false-positive rate (~85%) and should only be used for screening; a positive bag specimen must be confirmed by catheterization." },
{ q: "What urinalysis findings suggest UTI?", a: "<b>Positive leukocyte esterase</b> (WBCs), <b>positive nitrites</b> (Gram-negative bacteria convert nitrate → nitrite), pyuria (≥5 WBC/hpf), and bacteriuria on microscopy. Nitrites may be negative in young infants (frequent voiding limits conversion time)." },
{ q: "What culture threshold confirms UTI from a catheterized specimen vs. a clean-catch specimen?", a: "Catheterized: <b>≥50,000 CFU/mL</b> of a single organism. Clean-catch (midstream): <b>≥100,000 CFU/mL</b>. Suprapubic aspiration: any growth of Gram-negative rods is significant." },
{ q: "What imaging is recommended after a first febrile UTI in a child aged 2–24 months (AAP guidelines)?", a: "<b>Renal and bladder ultrasound (RBUS)</b> to assess for hydronephrosis, renal size, and structural anomalies. <b>VCUG</b> is reserved for recurrent febrile UTIs, abnormal RBUS, or atypical clinical course." },
{ q: "What does a voiding cystourethrogram (VCUG) evaluate?", a: "VCUG evaluates for <b>vesicoureteral reflux (VUR)</b> and anatomic abnormalities of the lower urinary tract (e.g., posterior urethral valves in boys). Contrast is instilled into the bladder via catheter and fluoroscopic images are taken during filling and voiding." },
{ q: "Describe the grading system for vesicoureteral reflux (VUR).", a: "<b>Grade I</b>: reflux into non-dilated ureter only. <b>Grade II</b>: reflux into renal pelvis without dilation. <b>Grade III</b>: mild dilation of ureter/pelvis. <b>Grade IV</b>: moderate dilation with blunting of fornices. <b>Grade V</b>: gross dilation and tortuosity with loss of papillary impressions." },
{ q: "How is low-grade VUR (I–III) typically managed?", a: "<b>Observation ± antibiotic prophylaxis</b> (e.g., TMP-SMX or nitrofurantoin). Low-grade reflux has a high rate of spontaneous resolution (~80% for Grade I–II) as the child grows and the intravesical ureter lengthens." },
{ q: "When is surgical correction considered for VUR?", a: "For <b>high-grade VUR (IV–V)</b>, recurrent breakthrough UTIs despite prophylaxis, renal scarring on DMSA scan, or failure of reflux to resolve with observation. Options include ureteral reimplantation or endoscopic injection (Deflux)." },
{ q: "What is the most common long-term complication of recurrent UTIs with VUR?", a: "<b>Reflux nephropathy</b> — chronic pyelonephritis leading to renal scarring, which can cause hypertension, proteinuria, and eventually chronic kidney disease (CKD) / end-stage renal disease." },

// ===== NEPHROLOGY: NEPHROTIC SYNDROME (Cards 13-22) =====
{ q: "What defines nephrotic syndrome?", a: "The classic <b>tetrad</b>: (1) Heavy proteinuria (>40 mg/m²/hr or urine protein:creatinine >2), (2) Hypoalbuminemia (<2.5 g/dL), (3) Generalized edema, (4) Hyperlipidemia. Complement levels are <b>normal</b>." },
{ q: "What is the most common cause of nephrotic syndrome in children?", a: "<b>Minimal change disease (MCD)</b> — accounts for ~80% of cases in children aged 1–8 years. Also called 'nil disease' because light microscopy appears normal; electron microscopy shows <b>diffuse podocyte foot process effacement</b>." },
{ q: "What type of proteinuria is seen in minimal change disease?", a: "<b>Selective proteinuria</b> — predominantly albumin is lost (smaller proteins), while larger proteins like immunoglobulins are retained. This is in contrast to non-selective proteinuria seen in FSGS." },
{ q: "How is minimal change disease treated?", a: "<b>Corticosteroids</b> (prednisone/prednisolone) — ~90% of children respond within 4–8 weeks. Relapses are common (~60–70%). Steroid-dependent or frequently relapsing cases may require cyclophosphamide, calcineurin inhibitors, or rituximab." },
{ q: "What complement abnormality is expected in minimal change disease?", a: "<b>Normal complement levels (C3, C4)</b>. This helps distinguish it from nephritic causes like post-streptococcal GN (low C3) and membranoproliferative GN (low C3 ± low C4)." },
{ q: "What is the second most common cause of nephrotic syndrome in children?", a: "<b>Focal segmental glomerulosclerosis (FSGS)</b> — more common in African American children and adolescents. It is the most common cause of <b>steroid-resistant</b> nephrotic syndrome in children." },
{ q: "How does FSGS differ from MCD on biopsy and clinical course?", a: "FSGS shows <b>segmental sclerosis of some glomeruli</b> on light microscopy (focal = some glomeruli, segmental = part of the glomerulus). It causes <b>non-selective proteinuria</b>, is often steroid-resistant, and can progress to ESRD." },
{ q: "What is membranous nephropathy and how common is it in children?", a: "Membranous nephropathy features <b>subepithelial immune complex deposits</b> and thickened GBM ('spike and dome' pattern on silver stain). It is <b>rare in children</b> (more common in adults) and may be secondary to SLE, hepatitis B, or medications." },
{ q: "What serious complications can occur in nephrotic syndrome?", a: "<b>Thromboembolism</b> (loss of antithrombin III, proteins C & S), <b>infection</b> (loss of immunoglobulins, especially IgG → spontaneous bacterial peritonitis with S. pneumoniae), <b>hyperlipidemia/atherosclerosis</b>, and <b>acute kidney injury</b> from hypovolemia." },
{ q: "Why are children with nephrotic syndrome at increased risk of infection with encapsulated organisms?", a: "Urinary loss of <b>immunoglobulins (especially IgG)</b> and <b>complement factors</b> impairs opsonization. The most feared infection is <b>spontaneous bacterial peritonitis</b> caused by <b>Streptococcus pneumoniae</b>. Pneumococcal vaccine is recommended." },

// ===== NEPHROLOGY: NEPHRITIC SYNDROME (Cards 23-40) =====
{ q: "What defines nephritic syndrome?", a: "<b>Hematuria</b> (often gross, cola/tea-colored), <b>hypertension</b>, <b>oliguria</b>, mild-to-moderate proteinuria (sub-nephrotic range), <b>edema</b>, and <b>elevated creatinine/BUN</b>. It reflects glomerular inflammation." },
{ q: "What is the most common cause of acute nephritic syndrome in children?", a: "<b>Post-streptococcal glomerulonephritis (PSGN)</b> — typically follows Group A Streptococcus (GAS) pharyngitis (1–3 weeks later) or skin infection/impetigo (3–6 weeks later). Peak age: 5–12 years." },
{ q: "What laboratory findings are characteristic of PSGN?", a: "<b>Low C3</b> (with normal C4), elevated <b>ASO titers</b> (pharyngitis) or <b>anti-DNase B</b> (skin infection), cola-colored urine, RBC casts on urinalysis, and evidence of recent streptococcal infection." },
{ q: "What is seen on renal biopsy in PSGN?", a: "Light microscopy: <b>diffuse proliferative GN</b> with hypercellular glomeruli. Immunofluorescence: <b>'starry sky' pattern</b> (granular IgG and C3 deposits). Electron microscopy: <b>subepithelial 'humps'</b> (immune complex deposits)." },
{ q: "What is the prognosis and management of PSGN in children?", a: "<b>Excellent prognosis</b> — >95% of children recover completely. Management is <b>supportive</b>: salt/fluid restriction, antihypertensives (loop diuretics), and antibiotics to eradicate residual streptococcal infection. C3 normalizes within 6–8 weeks." },
{ q: "What is IgA nephropathy (Berger disease)?", a: "The <b>most common glomerulonephritis worldwide</b>. IgA immune complexes deposit in the mesangium. Presents with <b>episodic gross hematuria</b> occurring <b>within 1–2 days</b> of an upper respiratory infection ('synpharyngitic'). <b>Complement levels are normal</b>." },
{ q: "How does the timing of hematuria differentiate IgA nephropathy from PSGN?", a: "IgA nephropathy: hematuria occurs <b>simultaneously with or within 1–2 days of URI</b> (synpharyngitic). PSGN: hematuria occurs <b>1–3 weeks after pharyngitis</b> (latent period required for immune complex formation)." },
{ q: "What is Henoch-Schönlein purpura (IgA vasculitis)?", a: "A <b>small-vessel IgA vasculitis</b>, most common in children aged 3–10 years. Classic tetrad: (1) <b>Palpable purpura</b> (buttocks/lower extremities), (2) <b>Arthritis/arthralgias</b>, (3) <b>Abdominal pain</b> (colicky, may cause intussusception), (4) <b>Renal involvement</b> (IgA nephropathy)." },
{ q: "How does renal involvement in HSP relate to IgA nephropathy?", a: "HSP nephritis is <b>histologically identical to IgA nephropathy</b> — mesangial IgA deposits on biopsy. Renal involvement occurs in ~30–50% of HSP cases and is the major determinant of <b>long-term prognosis</b>. Complement levels remain normal." },
{ q: "What is Alport syndrome?", a: "A hereditary nephritis caused by mutations in <b>type IV collagen</b> genes (most commonly <b>COL4A5, X-linked</b>). Classic triad: (1) <b>Persistent hematuria → progressive renal failure</b>, (2) <b>Sensorineural hearing loss</b>, (3) <b>Ocular abnormalities</b> (anterior lenticonus, perimacular flecks)." },
{ q: "What is the characteristic electron microscopy finding in Alport syndrome?", a: "<b>Irregular thickening, thinning, and splitting ('basket-weave' pattern) of the glomerular basement membrane</b>. This reflects the defective type IV collagen in the GBM." },
{ q: "What organism causes typical hemolytic uremic syndrome (HUS)?", a: "<b>Shiga toxin-producing E. coli O157:H7</b> (STEC-HUS). Transmission is via undercooked ground beef, contaminated water, or unpasteurized milk. Bloody diarrhea precedes HUS by ~5–7 days." },
{ q: "What is the classic triad of HUS?", a: "(1) <b>Microangiopathic hemolytic anemia</b> (MAHA — schistocytes on smear, elevated LDH, low haptoglobin), (2) <b>Thrombocytopenia</b> (consumptive), (3) <b>Acute kidney injury</b> (oliguria, elevated creatinine, hematuria)." },
{ q: "Why should antibiotics be avoided in STEC infection associated with HUS?", a: "Antibiotics may <b>increase Shiga toxin release</b> from lysed bacteria, potentially worsening or precipitating HUS. Anti-motility agents are also contraindicated. Management is <b>supportive</b>: IV fluids, transfusions, dialysis if needed." },
{ q: "What differentiates typical HUS from atypical HUS?", a: "<b>Typical HUS</b>: preceded by diarrhea (usually STEC), self-limited, good prognosis. <b>Atypical HUS (aHUS)</b>: caused by complement dysregulation (mutations in complement factor H, I, etc.), no diarrheal prodrome, worse prognosis, may respond to <b>eculizumab</b> (anti-C5 antibody)." },
{ q: "What glomerulonephritis has LOW complement C3?", a: "Low C3: <b>Post-streptococcal GN</b>, <b>membranoproliferative GN (MPGN)</b>, <b>lupus nephritis</b>, <b>endocarditis-associated GN</b>, <b>cryoglobulinemia</b>. Normal C3: <b>IgA nephropathy</b>, <b>HSP</b>, <b>Alport syndrome</b>, <b>anti-GBM disease</b>." },
{ q: "A child presents with nephrotic-range proteinuria AND nephritic features (hematuria, HTN). What diagnosis should you consider?", a: "<b>Membranoproliferative glomerulonephritis (MPGN)</b> — a 'nephritic-nephrotic overlap' syndrome. Features include low C3 (persistently low, unlike PSGN where it normalizes in 6-8 weeks), tram-track appearance on biopsy (GBM splitting)." },
{ q: "What is the classic presentation of Goodpasture syndrome (anti-GBM disease) and is it common in children?", a: "Pulmonary hemorrhage + rapidly progressive GN. It is <b>very rare in children</b>. Linear IgG deposits along GBM on immunofluorescence. Anti-GBM antibodies target the α3 chain of type IV collagen." },

// ===== NEPHROLOGY: CONGENITAL ANOMALIES (Cards 41-48) =====
{ q: "What is the most common cause of bilateral hydronephrosis in male neonates?", a: "<b>Posterior urethral valves (PUV)</b> — obstructing membrane folds in the prostatic urethra. Prenatal ultrasound shows bilateral hydronephrosis, distended bladder ('keyhole sign'), and oligohydramnios. Diagnosed by VCUG; treated by valve ablation." },
{ q: "What are the consequences of severe posterior urethral valves?", a: "Severe obstruction → oligohydramnios → <b>pulmonary hypoplasia</b> (Potter sequence), bilateral renal dysplasia, and renal insufficiency. Even after surgical correction, many children develop <b>CKD</b> due to renal dysplasia from chronic obstruction." },
{ q: "What is a horseshoe kidney?", a: "Fusion of the lower poles of both kidneys across the midline, forming a U-shape. The fused kidney is trapped below the <b>inferior mesenteric artery (IMA)</b> and fails to ascend normally. Associated with <b>Turner syndrome (45,X)</b>. Usually asymptomatic but at increased risk for UPJ obstruction and Wilms tumor." },
{ q: "What is multicystic dysplastic kidney (MCDK)?", a: "A non-functioning kidney replaced by <b>non-communicating cysts</b> of varying sizes with no normal renal parenchyma. It is the most common cystic renal disease in neonates. Usually <b>unilateral</b> and involutes over time. The contralateral kidney should be evaluated for compensatory hypertrophy and VUR." },
{ q: "Compare autosomal recessive polycystic kidney disease (ARPKD) with autosomal dominant PKD (ADPKD).", a: "<b>ARPKD</b>: presents in neonates/infants, bilateral enlarged echogenic kidneys, associated with congenital hepatic fibrosis, PKHD1 gene. <b>ADPKD</b>: presents in adults (30s–40s), PKD1/PKD2 genes, associated with berry aneurysms, liver cysts, mitral valve prolapse." },
{ q: "What is the most common congenital anomaly of the kidney and urinary tract (CAKUT)?", a: "<b>Vesicoureteral reflux (VUR)</b> is the most common CAKUT. Other common anomalies include UPJ obstruction (most common cause of neonatal hydronephrosis), duplicated collecting system, and renal agenesis." },
{ q: "What is the most common cause of unilateral hydronephrosis detected prenatally?", a: "<b>Ureteropelvic junction (UPJ) obstruction</b>. Most cases are due to intrinsic stenosis. The majority resolve spontaneously. Severe cases require <b>pyeloplasty</b>. A MAG3 diuretic renogram helps assess obstruction severity and differential renal function." },
{ q: "What is Potter sequence and what causes it?", a: "Potter sequence results from severe <b>oligohydramnios</b> (any cause: bilateral renal agenesis, PUV, bilateral MCDK). Features: <b>pulmonary hypoplasia</b> (lethal), flattened facies, limb deformities, and growth restriction due to compression in utero." },

// ===== NEPHROLOGY: ELECTROLYTE DISORDERS (Cards 49-60) =====
{ q: "How do you differentiate SIADH from cerebral salt wasting (CSW)?", a: "Both cause hyponatremia. <b>SIADH</b>: euvolemic or mildly hypervolemic, concentrated urine, low serum osmolality, fluid restriction is key treatment. <b>CSW</b>: hypovolemic (dehydrated), renal salt wasting, requires <b>normal saline replacement</b>. CSW is associated with CNS pathology." },
{ q: "What are the key ECG findings in hyperkalemia?", a: "Progressive changes: <b>Peaked T waves</b> (earliest) → prolonged PR interval → widened QRS → sine wave pattern → cardiac arrest (V-fib/asystole). Life-threatening arrhythmias occur at K⁺ >6.5–7.0 mEq/L." },
{ q: "Outline the acute management of hyperkalemia in children.", a: "(1) <b>Calcium gluconate</b> (cardioprotection, stabilizes myocardium), (2) <b>Insulin + glucose</b> (shifts K⁺ intracellularly), (3) <b>Sodium bicarbonate</b> (shifts K⁺ in), (4) <b>Albuterol nebulizer</b> (shifts K⁺ in), (5) <b>Kayexalate/patiromer</b> (removes K⁺ from body), (6) <b>Dialysis</b> for refractory cases." },
{ q: "What is Bartter syndrome?", a: "A group of autosomal recessive <b>salt-wasting tubulopathies</b> affecting the thick ascending limb of Henle. Mimics <b>chronic loop diuretic use</b>. Features: hypokalemia, metabolic alkalosis, hypercalciuria, normal-to-low BP, elevated renin and aldosterone. Presents in infancy with polyuria and failure to thrive." },
{ q: "What is Gitelman syndrome and how does it differ from Bartter?", a: "Gitelman affects the <b>distal convoluted tubule</b> (NaCl cotransporter), mimicking <b>thiazide diuretic use</b>. Compared to Bartter: Gitelman has <b>hypocalciuria</b> (vs. hypercalciuria in Bartter) and <b>hypomagnesemia</b>. Gitelman typically presents later in childhood/adolescence with milder symptoms." },
{ q: "What is Type 1 (distal) renal tubular acidosis?", a: "Inability to secrete H⁺ in the <b>collecting duct</b> → urine pH >5.5 despite systemic acidosis. Features: <b>non-anion-gap metabolic acidosis</b>, hypokalemia, nephrocalcinosis/kidney stones, failure to thrive in children. Causes: genetic, autoimmune, sickle cell." },
{ q: "What is Type 2 (proximal) renal tubular acidosis?", a: "Impaired HCO₃⁻ reabsorption in the <b>proximal tubule</b>. Urine pH may be <5.5 once serum HCO₃⁻ drops below the lowered threshold. Features: non-anion-gap metabolic acidosis, hypokalemia, may have associated Fanconi syndrome (glycosuria, aminoaciduria, phosphaturia)." },
{ q: "What is Type 4 renal tubular acidosis?", a: "Caused by <b>aldosterone deficiency or resistance</b> → impaired Na⁺ reabsorption and K⁺/H⁺ secretion in the collecting duct. Features: <b>hyperkalemia</b> (distinguishing feature from Types 1 & 2), non-anion-gap metabolic acidosis. Common in obstructive uropathy and diabetic nephropathy." },
{ q: "How do you distinguish the types of RTA by potassium levels?", a: "Types 1 and 2: <b>Hypokalemia</b> (due to compensatory K⁺ secretion or loss). Type 4: <b>Hyperkalemia</b> (due to aldosterone deficiency/resistance reducing K⁺ excretion). All have non-anion-gap metabolic acidosis." },
{ q: "What is Fanconi syndrome?", a: "A generalized dysfunction of the <b>proximal tubule</b> causing impaired reabsorption of glucose, amino acids, phosphate, uric acid, and bicarbonate. Causes: cystinosis (most common inherited cause in children), galactosemia, Wilson disease, heavy metals, ifosfamide." },
{ q: "What is the most common cause of Fanconi syndrome in children?", a: "<b>Cystinosis</b> — an autosomal recessive lysosomal storage disease causing cystine crystal accumulation in cells. Presents with failure to thrive, polyuria, polydipsia, rickets (phosphate wasting), and photophobia. Treatment: <b>cysteamine</b>." },
{ q: "What is the normal serum sodium range in children, and what defines hyponatremia?", a: "Normal serum Na⁺: <b>135–145 mEq/L</b>. Hyponatremia: <b><135 mEq/L</b>. Symptoms (seizures, altered mental status) typically occur when Na⁺ drops <b>rapidly</b> or falls below ~120 mEq/L. Correction rate should not exceed 10–12 mEq/L/day to avoid osmotic demyelination syndrome." },

// ===== ENDOCRINOLOGY: TYPE 1 DIABETES (Cards 61-73) =====
{ q: "What is the pathophysiology of Type 1 diabetes mellitus (T1DM)?", a: "<b>Autoimmune destruction of pancreatic beta cells</b> by T-lymphocytes → absolute insulin deficiency. Associated with HLA-DR3 and HLA-DR4. Autoantibodies: anti-GAD65, anti-insulin (IAA), anti-islet cell (ICA), anti-IA-2, anti-ZnT8." },
{ q: "What is the classic presentation of new-onset T1DM in children?", a: "The <b>3 P's</b>: Polyuria, polydipsia, polyphagia — plus weight loss. ~30% of children present in <b>diabetic ketoacidosis (DKA)</b> at initial diagnosis. Peak age of onset: 5–7 years and around puberty." },
{ q: "What defines diabetic ketoacidosis (DKA)?", a: "(1) <b>Hyperglycemia</b> (blood glucose >200 mg/dL), (2) <b>Metabolic acidosis</b> (pH <7.3 or serum HCO₃⁻ <15 mEq/L), (3) <b>Ketonemia/ketonuria</b>. Severity: mild (pH 7.2–7.3), moderate (pH 7.1–7.2), severe (pH <7.1)." },
{ q: "Outline the management of DKA in children.", a: "(1) <b>IV fluid resuscitation</b> (initial NS bolus 10–20 mL/kg, then maintenance), (2) <b>Continuous insulin drip</b> (0.1 U/kg/hr — start AFTER initial fluid bolus), (3) <b>Potassium replacement</b> (K⁺ shifts intracellularly with insulin; replace when K⁺ <5.5), (4) Monitor glucose hourly, electrolytes q2–4h." },
{ q: "What is the most dangerous complication of DKA treatment in children?", a: "<b>Cerebral edema</b> — occurs in ~1% of pediatric DKA cases but has ~25% mortality. Risk factors: young age, new-onset DM, excessive fluid resuscitation, rapid osmolality changes, bicarbonate use. Signs: headache, altered mental status, bradycardia, hypertension (Cushing response)." },
{ q: "How is cerebral edema in DKA treated?", a: "<b>IV mannitol</b> (0.5–1 g/kg) or <b>hypertonic saline (3%)</b>. Elevate the head of bed, reduce IV fluid rate, and avoid hypotonic fluids. Intubation if needed (avoid hyperventilation). Neuroimaging after stabilization." },
{ q: "When should IV dextrose be added during DKA management?", a: "When blood glucose falls to <b>250–300 mg/dL</b>, add dextrose (D5 or D10) to IV fluids. The goal is to keep glucose at 150–250 mg/dL while continuing insulin to correct the acidosis/ketosis. Do NOT stop insulin just because glucose has normalized." },
{ q: "What is the 'honeymoon period' in T1DM?", a: "A phase of <b>partial remission</b> occurring weeks to months after diagnosis where residual beta cells recover some function, leading to <b>decreased insulin requirements</b> and easier glucose control. It typically lasts weeks to months (rarely >1 year) before beta cell destruction progresses." },
{ q: "What is the target HbA1c for children with T1DM (ADA/ISPAD)?", a: "<b><7.0%</b> for most children and adolescents (individualized). Higher targets may be appropriate for young children at risk of hypoglycemia. HbA1c reflects average blood glucose over the preceding <b>2–3 months</b>." },
{ q: "What are the common insulin regimens for pediatric T1DM?", a: "<b>Basal-bolus</b>: long-acting insulin (glargine/detemir) for basal + rapid-acting (lispro/aspart) before meals. <b>Insulin pump therapy (CSII)</b>: continuous subcutaneous rapid-acting insulin. Both aim to mimic physiologic insulin secretion. Pumps reduce hypoglycemia risk." },
{ q: "What are the symptoms and management of hypoglycemia in T1DM?", a: "Symptoms: tremor, sweating, tachycardia, hunger (adrenergic) → confusion, seizures, LOC (neuroglycopenic). Mild: <b>fast-acting glucose (juice, glucose tabs)</b>. Severe (unconscious): <b>IV dextrose (D10 in children)</b> or <b>IM/IN glucagon</b>." },
{ q: "What long-term microvascular complications should be screened for in T1DM?", a: "<b>Retinopathy</b> (annual eye exam starting age 11 or 3–5 years after diagnosis), <b>nephropathy</b> (annual urine albumin:creatinine ratio), <b>neuropathy</b> (annual foot exam). Screening typically begins at puberty or after 5 years of disease duration." },
{ q: "What associated autoimmune conditions should be screened for in T1DM?", a: "<b>Thyroid disease</b> (Hashimoto thyroiditis — screen TSH at diagnosis, then every 1–2 years), <b>celiac disease</b> (anti-tTG IgA at diagnosis and periodically), and <b>Addison disease</b> (less common). These are linked by shared HLA susceptibility." },

// ===== ENDOCRINOLOGY: TYPE 2 DIABETES (Cards 74-77) =====
{ q: "What are the risk factors for Type 2 diabetes in children?", a: "<b>Obesity</b> (BMI ≥95th percentile), <b>family history</b> of T2DM (1st or 2nd degree relative), <b>high-risk ethnicity</b> (Native American, African American, Hispanic, Asian), <b>acanthosis nigricans</b>, PCOS, maternal gestational diabetes." },
{ q: "How does T2DM differ from T1DM on presentation?", a: "T2DM: <b>older children/adolescents</b>, obese, gradual onset, may have acanthosis nigricans, often asymptomatic. <b>C-peptide is normal or elevated</b> (insulin resistance, not deficiency). Autoantibodies are <b>negative</b>. However, ~5-25% may present with DKA." },
{ q: "What is the first-line pharmacologic therapy for T2DM in children?", a: "<b>Metformin</b> — FDA-approved for children ≥10 years. It decreases hepatic glucose production and increases insulin sensitivity. Lifestyle modifications (diet, exercise, weight loss) are essential adjuncts. <b>Insulin</b> is added if HbA1c ≥8.5% or if presenting with DKA." },
{ q: "What is acanthosis nigricans and what does it signify?", a: "<b>Velvety, hyperpigmented, thickened skin</b> typically found in skin folds (posterior neck, axillae, groin). It is a marker of <b>insulin resistance</b> and hyperinsulinemia, commonly associated with obesity and T2DM." },

// ===== ENDOCRINOLOGY: THYROID DISORDERS (Cards 78-87) =====
{ q: "What is congenital hypothyroidism and why is newborn screening critical?", a: "Thyroid hormone deficiency present at birth. Without treatment, it causes <b>irreversible intellectual disability (cretinism)</b>. Newborn screening (heel prick TSH ± T4 at 24–48 hours of life) allows early detection and treatment before clinical signs appear." },
{ q: "What is the most common cause of congenital hypothyroidism?", a: "<b>Thyroid dysgenesis</b> (ectopic, hypoplastic, or absent thyroid gland) — accounts for ~85% of cases. Other causes: dyshormonogenesis (inborn errors of thyroid hormone synthesis), TSH receptor defects, iodine deficiency (worldwide)." },
{ q: "What are the clinical features of untreated congenital hypothyroidism?", a: "Prolonged neonatal jaundice, large fontanelles, macroglossia, umbilical hernia, hypotonia, constipation, feeding difficulties, hoarse cry, dry/mottled skin, poor growth, <b>intellectual disability</b> if untreated. Most newborns appear normal at birth due to maternal thyroid hormone transfer." },
{ q: "How is congenital hypothyroidism treated?", a: "<b>Levothyroxine (L-T4)</b> started as soon as possible (ideally within 2 weeks of life) at a dose of 10–15 mcg/kg/day. TSH and free T4 are monitored regularly. Normal neurodevelopment is expected with early, adequate treatment." },
{ q: "What causes Graves disease in children?", a: "<b>TSH receptor-stimulating antibodies (TRAb/TSI)</b> — an autoimmune condition causing hyperthyroidism. Most common cause of hyperthyroidism in children. Associated with HLA-DR3. Features: goiter, exophthalmos, tachycardia, weight loss, heat intolerance, tremor, hyperactivity." },
{ q: "How is Graves disease treated in children?", a: "First-line: <b>Antithyroid drugs</b> — methimazole (preferred; PTU is avoided due to hepatotoxicity risk except in thyroid storm or 1st trimester pregnancy). Definitive therapy: <b>radioactive iodine (RAI)</b> ablation or <b>thyroidectomy</b> for relapsed/refractory cases." },
{ q: "What is neonatal Graves disease?", a: "Transient hyperthyroidism in the neonate caused by transplacental passage of maternal <b>TSH receptor-stimulating antibodies (TSI)</b> from a mother with Graves disease. Presents with tachycardia, irritability, poor weight gain, goiter, exophthalmos. Self-resolves as maternal antibodies clear (~2–3 months)." },
{ q: "What is Hashimoto thyroiditis?", a: "The <b>most common cause of acquired hypothyroidism</b> in children and adolescents (in iodine-sufficient areas). Autoimmune: anti-thyroid peroxidase (anti-TPO) and anti-thyroglobulin antibodies. Painless goiter, elevated TSH, low free T4. Treatment: levothyroxine." },
{ q: "How does Hashimoto thyroiditis present initially?", a: "Often presents with a <b>painless, firm, non-tender goiter</b>. May initially have a brief <b>hashitoxicosis</b> phase (transient hyperthyroidism from thyroid cell destruction releasing stored hormone), followed by progressive hypothyroidism." },
{ q: "Which thyroid conditions are associated with Down syndrome and Turner syndrome?", a: "Both are at increased risk for <b>Hashimoto thyroiditis</b> and hypothyroidism. Children with Down syndrome (trisomy 21) and Turner syndrome (45,X) should have <b>annual thyroid function screening</b> (TSH)." },

// ===== ENDOCRINOLOGY: GROWTH DISORDERS (Cards 88-100) =====
{ q: "What is the approach to evaluating short stature in a child?", a: "History (growth velocity, nutrition, family heights, puberty), physical exam, <b>bone age X-ray</b> (left hand/wrist), labs (TSH, free T4, IGF-1, IGFBP-3, CBC, BMP, celiac screen). Bone age interpretation helps differentiate constitutional delay from GH deficiency and familial short stature." },
{ q: "How does constitutional growth delay differ from familial short stature?", a: "<b>Constitutional delay</b>: delayed bone age, delayed puberty, normal growth velocity, ultimate adult height is normal (late bloomers). Family history of delayed puberty. <b>Familial short stature</b>: normal bone age (matches chronologic age), normal growth velocity, short parents, predicted adult height is short." },
{ q: "What is the bone age in GH deficiency?", a: "<b>Significantly delayed</b> bone age. Children with GH deficiency have short stature with <b>decreased growth velocity</b> (<4–5 cm/year after age 2), increased subcutaneous fat, and delayed skeletal maturation. GH stimulation testing confirms the diagnosis." },
{ q: "How is GH deficiency diagnosed?", a: "<b>GH stimulation test</b>: GH levels are measured after pharmacologic stimulation (arginine, clonidine, glucagon, or insulin). Peak GH <b><10 ng/mL</b> on two separate stimulation tests confirms GH deficiency. Also check IGF-1 and IGFBP-3 (low in GH deficiency), and brain MRI for pituitary pathology." },
{ q: "What are the features of Turner syndrome (45,X)?", a: "<b>Short stature</b> (most consistent feature), <b>gonadal dysgenesis</b> (streak ovaries → primary amenorrhea, absent puberty), webbed neck, shield chest with widely spaced nipples, lymphedema (hands/feet at birth), coarctation of aorta, horseshoe kidney, low posterior hairline." },
{ q: "How is short stature managed in Turner syndrome?", a: "<b>Recombinant GH therapy</b> — started early to maximize adult height (can add ~5–8 cm). <b>Estrogen replacement</b> at ~12 years to induce puberty. Lifelong monitoring for cardiac (aortic dilation), renal, thyroid, and hearing problems." },
{ q: "What defines precocious puberty?", a: "Onset of secondary sexual characteristics before age <b>8 in girls</b> and <b>9 in boys</b>. Classified as <b>central (GnRH-dependent)</b> — activation of the HPG axis, or <b>peripheral (GnRH-independent)</b> — autonomous sex steroid production." },
{ q: "What is the most common cause of central precocious puberty?", a: "In <b>girls: idiopathic</b> (~90% of cases). In <b>boys: more likely pathologic</b> (CNS tumors such as hypothalamic hamartoma, glioma, or other CNS lesions). Boys with precocious puberty always warrant a brain MRI." },
{ q: "How is central precocious puberty diagnosed?", a: "<b>GnRH (or GnRH agonist) stimulation test</b>: a pubertal LH response (LH >5 IU/L) confirms central activation of the HPG axis. Also check advanced bone age, elevated sex steroids, and brain MRI to rule out CNS pathology." },
{ q: "How is central precocious puberty treated?", a: "<b>GnRH agonists</b> (leuprolide) — continuous GnRH agonist administration desensitizes and downregulates pituitary GnRH receptors, suppressing LH/FSH secretion and halting pubertal progression. This preserves adult height by slowing bone age advancement." },
{ q: "What are causes of peripheral precocious puberty?", a: "<b>GnRH-independent</b>: ovarian cysts or tumors (girls), testicular tumors or Leydig cell tumors (boys), <b>congenital adrenal hyperplasia</b>, McCune-Albright syndrome (café-au-lait spots, polyostotic fibrous dysplasia, autonomous endocrine hyperfunction), exogenous sex steroids, HCG-secreting tumors." },
{ q: "How does McCune-Albright syndrome cause precocious puberty?", a: "A <b>gain-of-function mutation in the Gsα protein (GNAS gene)</b> causes constitutive activation of cAMP signaling in endocrine tissues. This leads to <b>GnRH-independent precocious puberty</b>, along with polyostotic fibrous dysplasia and café-au-lait macules with 'coast of Maine' (irregular) borders." },
{ q: "What growth pattern is seen in a child with obesity vs. GH deficiency?", a: "<b>Obesity</b>: tall for age (or normal height) with advanced bone age. <b>GH deficiency</b>: short stature with decreased growth velocity and delayed bone age. Obesity accelerates linear growth and skeletal maturation; GH deficiency slows both." },

// ===== ENDOCRINOLOGY: ADRENAL DISORDERS (Cards 101-109) =====
{ q: "What is the most common form of congenital adrenal hyperplasia (CAH)?", a: "<b>21-hydroxylase deficiency</b> — accounts for >90% of CAH cases. This enzyme converts 17-OH progesterone → 11-deoxycortisol (cortisol pathway) and progesterone → deoxycorticosterone (aldosterone pathway). Deficiency causes <b>cortisol and aldosterone deficiency</b> with <b>androgen excess</b>." },
{ q: "What is the key biochemical marker for 21-hydroxylase deficiency?", a: "<b>Elevated 17-hydroxyprogesterone (17-OHP)</b> — the substrate that accumulates proximal to the enzymatic block. Newborn screening measures 17-OHP. Shunting of precursors to the androgen pathway causes elevated DHEA and androstenedione." },
{ q: "How does classic salt-wasting CAH present in neonates?", a: "<b>Female neonates</b>: ambiguous genitalia (clitoromegaly, labial fusion) due to androgen excess — 46,XX karyotype with virilized external genitalia. <b>Male neonates</b>: appear normal at birth. Both sexes develop a <b>salt-wasting crisis</b> at 1–3 weeks (hyponatremia, hyperkalemia, dehydration, shock) due to aldosterone deficiency." },
{ q: "How is CAH treated?", a: "<b>Glucocorticoid replacement</b> (hydrocortisone in children) — replaces cortisol and suppresses ACTH, reducing adrenal androgen production. <b>Mineralocorticoid replacement</b> (fludrocortisone) for salt-wasting forms. <b>Stress-dose steroids</b> during illness/surgery. Surgical correction of ambiguous genitalia as appropriate." },
{ q: "What is simple virilizing CAH?", a: "A milder form of 21-hydroxylase deficiency where enough aldosterone is produced to prevent salt wasting, but androgen excess persists. Presents with <b>virilization</b>: ambiguous genitalia in girls, precocious pseudopuberty in boys (early pubic hair, penile enlargement, advanced bone age, but <b>small testes</b> — distinguishes from central precocious puberty)." },
{ q: "What is 11β-hydroxylase deficiency and how does it differ from 21-hydroxylase deficiency?", a: "Second most common CAH. Blocks 11-deoxycortisol → cortisol AND deoxycorticosterone (DOC) → corticosterone. DOC accumulates — DOC has <b>mineralocorticoid activity</b> → <b>hypertension and hypokalemia</b> (unlike 21-hydroxylase which causes salt wasting). Still has androgen excess and virilization." },
{ q: "What is Addison disease (primary adrenal insufficiency) in children?", a: "Destruction of the adrenal cortex → deficiency of cortisol, aldosterone, and adrenal androgens. Causes in children: <b>autoimmune adrenalitis</b> (most common acquired cause), CAH, adrenal hemorrhage (Waterhouse-Friderichsen in meningococcemia), adrenoleukodystrophy (X-linked, in boys). Features: fatigue, hypotension, hyperpigmentation, salt craving." },
{ q: "What laboratory findings are seen in Addison disease?", a: "<b>Hyponatremia, hyperkalemia</b> (aldosterone deficiency), <b>hypoglycemia</b> (cortisol deficiency), <b>elevated ACTH</b> (primary adrenal failure). Diagnosed by <b>ACTH stimulation test</b>: cortisol fails to rise adequately after cosyntropin injection." },
{ q: "What causes Cushing syndrome in children?", a: "Most common cause in children: <b>exogenous glucocorticoid administration</b> (iatrogenic). Endogenous causes: <b>ACTH-secreting pituitary adenoma (Cushing disease)</b> in older children, <b>adrenal tumors</b> in younger children. Features: central obesity, moon facies, striae, buffalo hump, growth deceleration (growth failure distinguishes it from simple obesity)." },

// ===== ENDOCRINOLOGY: DISORDERS OF SEXUAL DIFFERENTIATION (Cards 110-114) =====
{ q: "What determines gonadal sex vs. phenotypic sex?", a: "<b>Gonadal sex</b>: determined by the presence of the <b>SRY gene</b> on the Y chromosome → testes develop. <b>Phenotypic sex</b>: determined by hormonal environment — testosterone/DHT (Wolffian duct development, external virilization) and anti-Müllerian hormone (AMH — regression of Müllerian structures)." },
{ q: "What is 46,XX DSD (formerly female pseudohermaphroditism)?", a: "46,XX karyotype with virilized external genitalia but normal internal female structures (ovaries, uterus). Most common cause: <b>congenital adrenal hyperplasia (21-hydroxylase deficiency)</b>. Excess adrenal androgens virilize the external genitalia in utero." },
{ q: "What is 46,XY DSD (formerly male pseudohermaphroditism)?", a: "46,XY karyotype with undervirilized or female-appearing external genitalia despite having testes. Causes include: <b>androgen insensitivity syndrome</b>, 5α-reductase deficiency, disorders of testosterone synthesis, and gonadal dysgenesis." },
{ q: "What is complete androgen insensitivity syndrome (CAIS)?", a: "46,XY individual with <b>non-functional androgen receptors</b>. Testes are present (often intra-abdominal or inguinal) but external phenotype is <b>female</b>. No Wolffian duct structures. No Müllerian structures (AMH still produced by testes). Presents as phenotypic female with <b>primary amenorrhea</b>, absent uterus, blind-ending vagina, and inguinal hernias containing testes." },
{ q: "What is 5α-reductase deficiency?", a: "46,XY disorder where testosterone cannot be converted to <b>dihydrotestosterone (DHT)</b>. DHT is needed for development of external male genitalia. Phenotype: ambiguous genitalia at birth, but <b>virilization occurs at puberty</b> (due to testosterone surge). Normal Wolffian duct structures (testosterone-dependent). Also known as 'guevedoces'." },

// ===== ENDOCRINOLOGY: CALCIUM/PHOSPHORUS DISORDERS (Cards 115-122) =====
{ q: "What are the clinical features of rickets?", a: "Skeletal deformities from impaired mineralization of growing bone: <b>widened wrists and ankles</b> (metaphyseal widening), <b>rachitic rosary</b> (costochondral junction beading), <b>craniotabes</b> (soft skull bones), frontal bossing, bowing of legs, <b>delayed closure of fontanelles</b>, Harrison groove, and pathologic fractures." },
{ q: "What are the radiographic findings in rickets?", a: "<b>Cupping, fraying, and widening of the metaphyses</b> (especially distal radius/ulna), generalized osteopenia, and delayed appearance of epiphyseal centers. These reflect defective mineralization at the growth plate." },
{ q: "What are the lab findings in vitamin D deficiency rickets?", a: "<b>Low 25-OH vitamin D</b>, <b>low calcium</b>, <b>low phosphorus</b>, <b>elevated alkaline phosphatase (ALP)</b>, <b>elevated PTH</b> (secondary hyperparathyroidism). Treatment: vitamin D supplementation (cholecalciferol) and calcium." },
{ q: "What causes hypophosphatemic rickets (X-linked)?", a: "Most common hereditary form of rickets. Mutation in the <b>PHEX gene</b> → elevated FGF23 → renal phosphate wasting. Features: <b>low phosphorus, normal calcium, normal PTH</b>, elevated ALP. Does NOT respond to vitamin D alone; requires <b>phosphorus supplementation + calcitriol</b>." },
{ q: "What is DiGeorge syndrome and how does it affect calcium?", a: "<b>22q11.2 microdeletion</b> causing abnormal development of the 3rd and 4th pharyngeal pouches. Features: <b>hypoparathyroidism</b> (hypocalcemia, tetany, seizures), <b>thymic aplasia/hypoplasia</b> (T-cell immunodeficiency), congenital heart defects (truncus arteriosus, tetralogy of Fallot), and facial abnormalities. Mnemonic: <b>CATCH-22</b>." },
{ q: "What does CATCH-22 stand for in DiGeorge syndrome?", a: "<b>C</b>ardiac defects, <b>A</b>bnormal facies, <b>T</b>hymic aplasia, <b>C</b>left palate, <b>H</b>ypocalcemia/hypoparathyroidism — all due to chromosome <b>22</b>q11.2 deletion. Diagnosed by <b>FISH or chromosomal microarray</b>." },
{ q: "What are the signs of hypocalcemia in children?", a: "<b>Neuromuscular irritability</b>: tetany, carpopedal spasm, seizures, laryngospasm, paresthesias. <b>Chvostek sign</b> (facial twitch when tapping facial nerve). <b>Trousseau sign</b> (carpal spasm with BP cuff inflation). ECG: <b>prolonged QTc interval</b>." },
{ q: "How does pseudohypoparathyroidism present?", a: "End-organ resistance to PTH (PTH is <b>elevated</b> but kidneys/bones do not respond). <b>Type 1a (Albright hereditary osteodystrophy)</b>: short stature, round facies, obesity, brachydactyly (short 4th/5th metacarpals), subcutaneous calcifications, intellectual disability. Labs: hypocalcemia, hyperphosphatemia, elevated PTH." },
          ]
        },
        {
          section: 'Advanced Pediatrics',
          topic: "Child abuse recognition & reporting",
          icon: "shield-alert",
          cards: [
            // ===== TYPES OF CHILD MALTREATMENT (Cards 1–12) =====
{ q: "What is the most common form of child maltreatment?", a: "<b>Neglect</b> — accounts for ~75% of all reported cases of child maltreatment." },
{ q: "Name the four major categories of child maltreatment.", a: "1. Physical abuse<br>2. Sexual abuse<br>3. Emotional/psychological abuse<br>4. Neglect (including medical neglect)" },
{ q: "What is Medical Child Abuse (formerly Munchausen Syndrome by Proxy)?", a: "A form of abuse in which a caregiver <b>fabricates or induces illness</b> in a child to assume the sick role by proxy. Now termed <b>Factitious Disorder Imposed on Another (FDIA)</b>." },
{ q: "What distinguishes emotional abuse from other forms of maltreatment?", a: "Emotional abuse involves persistent patterns of <b>rejecting, terrorizing, isolating, corrupting, or ignoring</b> a child. It is the hardest form to substantiate legally." },
{ q: "What is the legal definition of child abuse in most jurisdictions?", a: "Any act or failure to act by a parent/caregiver that results in <b>death, serious physical or emotional harm, sexual abuse, or exploitation</b> of a child, or presents an imminent risk of serious harm." },
{ q: "Which age group is at highest risk for fatal child abuse?", a: "Children <b>&lt;1 year of age</b> have the highest fatality rate from abuse. Most fatalities occur in children <b>&lt;4 years old</b>." },
{ q: "What percentage of child abuse fatalities involve prior contact with CPS?", a: "Approximately <b>30–40%</b> of fatal abuse cases had prior CPS involvement, highlighting the importance of thorough investigation." },
{ q: "What is the most common perpetrator profile in child maltreatment?", a: "The biological <b>parent</b> is the most common perpetrator in all forms of maltreatment (~80% of cases). Mothers are more often implicated in neglect; fathers/male partners in physical and sexual abuse." },
{ q: "What is supervisory neglect?", a: "Failure to provide <b>adequate supervision</b> appropriate to the child's developmental level, resulting in preventable injury or harm (e.g., leaving a toddler unattended near water)." },
{ q: "What is medical neglect?", a: "Failure to provide <b>necessary medical, dental, or mental health treatment</b> for a child's condition, potentially resulting in worsening illness, disability, or death." },
{ q: "How does educational neglect present?", a: "Chronic <b>truancy</b> permitted by caregivers, failure to enroll a child in school, or failure to attend to <b>special educational needs</b> despite available resources." },
{ q: "What is the difference between physical discipline and physical abuse?", a: "Physical abuse causes <b>injury</b> (bruises, fractures, burns). The distinction depends on whether the discipline results in <b>observable harm</b>; any mark or injury from discipline may constitute abuse." },

// ===== PHYSICAL ABUSE INDICATORS (Cards 13–35) =====
{ q: "What bruise locations are most suspicious for non-accidental trauma?", a: "Bruises on the <b>ears, neck, buttocks, trunk, genitalia, and cheeks</b> — areas rarely injured in accidental falls. The mnemonic: <b>TEN-4</b>." },
{ q: "What is the TEN-4 rule for bruising?", a: "<b>T</b>orso, <b>E</b>ars, <b>N</b>eck bruising in a child of <b>any age</b>, OR <b>any</b> bruise in a child <b>&lt;4 months old</b>. These are highly suspicious for abuse." },
{ q: "Why is any bruise in a pre-mobile infant concerning for abuse?", a: "Infants who are <b>not yet cruising or walking</b> rarely sustain accidental bruises. The saying: <b>'Those who don't cruise rarely bruise.'</b>" },
{ q: "What bruise pattern is suggestive of being struck with an object?", a: "<b>Patterned bruises</b> that outline the shape of an object — loop marks (cords/belts), linear marks (sticks), or hand prints. These are virtually diagnostic of abuse." },
{ q: "What is the significance of bruises in multiple stages of healing?", a: "Bruises of <b>different colors/ages</b> suggest <b>repeated episodes of trauma</b> over time, a hallmark of ongoing physical abuse." },
{ q: "Can the age of a bruise be determined precisely by its color?", a: "<b>No.</b> Research shows that bruise color is unreliable for precise aging. The only reliable statement is that a <b>yellow bruise is at least 18–24 hours old</b>." },
{ q: "Describe the classic immersion burn pattern.", a: "Symmetric, sharply demarcated <b>'stocking' or 'glove' pattern</b> burns on the extremities or <b>'doughnut pattern'</b> sparing of the buttocks (pressed against cool tub bottom), with uniform depth and clear tide lines." },
{ q: "Why do immersion burns have sharp lines of demarcation?", a: "Because the child is <b>forcibly held</b> in hot water, creating a uniform depth of injury with a clear <b>'waterline'</b> — unlike accidental splash burns which have irregular, scattered margins." },
{ q: "What burn pattern does a cigarette produce?", a: "Circular, deep, <b>well-circumscribed burns ~8–10 mm</b> in diameter, often on the hands, feet, or buttocks. Multiple healed circular scars suggest repeated abuse." },
{ q: "How do accidental contact burns differ from inflicted contact burns?", a: "Accidental burns are usually <b>unilateral, glancing, and irregular</b>. Inflicted burns are <b>deep, clearly shaped</b> like the object (iron, curling iron, radiator), and often on areas the child would not touch voluntarily." },
{ q: "What fracture type is virtually pathognomonic of child abuse?", a: "<b>Classic metaphyseal lesions (CMLs)</b> — also called corner fractures or bucket-handle fractures. They result from violent shaking/pulling forces on the extremity." },
{ q: "What is the mechanism of a metaphyseal corner fracture?", a: "Caused by <b>shearing forces</b> through the immature metaphysis when an extremity is violently grabbed, twisted, or pulled — as in shaking or yanking a limb." },
{ q: "Why are posterior rib fractures highly suspicious for abuse in infants?", a: "They result from <b>anteroposterior compression</b> of the chest (squeezing during shaking). They are rarely caused by CPR or accidental injury in infants." },
{ q: "What is the significance of multiple fractures in different stages of healing?", a: "Strongly suggests <b>repeated episodes of non-accidental trauma</b> over time, especially if no metabolic bone disease is identified." },
{ q: "Which fracture types are considered high specificity for abuse?", a: "1. <b>Metaphyseal corner/bucket-handle fractures</b><br>2. <b>Posterior rib fractures</b><br>3. Scapular fractures<br>4. Spinous process fractures<br>5. Sternal fractures" },
{ q: "Are spiral fractures always indicative of abuse?", a: "<b>No.</b> Spiral fractures of the tibia ('toddler's fracture') are common accidental injuries in ambulatory children. However, spiral fractures of the <b>femur or humerus in non-ambulatory infants</b> are highly suspicious." },
{ q: "What is the significance of a spiral femur fracture in a 4-month-old?", a: "Highly suspicious for <b>non-accidental trauma</b>. Non-ambulatory infants cannot generate the torsional forces needed for this injury. Requires full abuse evaluation." },
{ q: "What is a 'toddler's fracture' and how does it differ from abuse?", a: "A <b>spiral fracture of the tibial shaft</b> in a 1–3-year-old caused by a twisting fall. It is typically an <b>accidental injury</b> consistent with the child's developmental stage." },
{ q: "What are the common features of abusive head trauma (shaken baby syndrome)?", a: "The classic triad: <b>subdural hematomas</b> (often bilateral), <b>retinal hemorrhages</b> (especially multilayered), and <b>encephalopathy</b> (diffuse axonal injury)." },
{ q: "What is the mechanism of injury in abusive head trauma?", a: "<b>Rapid acceleration-deceleration</b> forces from violent shaking (±impact) cause bridging vein rupture (subdural hematoma), retinal hemorrhage, and diffuse axonal injury." },
{ q: "What external findings may be absent in abusive head trauma?", a: "There may be <b>no external signs of trauma</b> — no bruises or scalp swelling. The injury is caused by internal shearing forces, making high clinical suspicion essential." },
{ q: "What is a subgaleal hematoma and its relevance to abuse?", a: "Blood collection in the <b>subgaleal (subaponeurotic) space</b> that can cross suture lines. In infants, it may indicate significant <b>blunt force head trauma</b> from abuse." },
{ q: "What abdominal injuries should raise suspicion for abuse?", a: "<b>Duodenal hematoma, pancreatic injury (elevated lipase), hepatic laceration, hollow viscus perforation</b>. Abdominal trauma is the <b>second leading cause of death</b> from child abuse." },

// ===== SEXUAL ABUSE (Cards 36–48) =====
{ q: "What is the most common presentation of child sexual abuse?", a: "<b>Disclosure by the child.</b> Physical findings are often absent or nonspecific. Most sexually abused children have a <b>normal physical exam</b>." },
{ q: "What behavioral indicators suggest possible sexual abuse?", a: "Age-inappropriate <b>sexual knowledge or behavior</b>, regression (enuresis, encopresis), sleep disturbances, depression, school problems, sexualized play, and self-harm." },
{ q: "What is the time window for a forensic sexual abuse examination?", a: "Evidence collection (rape kit) should ideally occur within <b>&lt;72 hours</b> of the last episode of abuse. Some protocols extend to <b>96 hours</b> for prepubertal children." },
{ q: "What STIs should be screened for in sexual abuse evaluations?", a: "<b>Gonorrhea, chlamydia, syphilis (RPR/VDRL), HIV, hepatitis B/C, trichomoniasis, HPV, and HSV</b> if lesions are present." },
{ q: "Which STI found in a prepubertal child is virtually diagnostic of sexual abuse?", a: "<b>Neisseria gonorrhoeae</b> (beyond neonatal period) and <b>Treponema pallidum (syphilis)</b> when perinatal transmission is excluded. These are confirmed by culture, not rapid tests." },
{ q: "What is the significance of a normal hymenal exam in sexual abuse?", a: "A <b>normal exam does NOT exclude sexual abuse</b>. Mucosal injuries heal rapidly and completely. The exam is normal in the majority of confirmed sexual abuse cases." },
{ q: "What hymenal findings are concerning for penetrating trauma?", a: "<b>Acute lacerations, deep notches extending to the base of the hymen (especially posterior/inferior), and complete transections</b> of the hymen are concerning." },
{ q: "What is the Adams classification of sexual abuse findings?", a: "Classifies findings as:<br>1. <b>Normal/variant</b> (no abuse indicators)<br>2. <b>Non-specific</b> (may be caused by abuse or other conditions)<br>3. <b>Concerning for abuse/trauma</b><br>4. <b>Diagnostic of abuse/trauma</b>" },
{ q: "Who is the most common perpetrator in child sexual abuse?", a: "A <b>known, trusted individual</b> — most often a family member or family acquaintance. Stranger abuse accounts for only ~10% of cases." },
{ q: "What is the 'grooming' process in child sexual abuse?", a: "A deliberate process where the perpetrator <b>builds trust and emotional connection</b> with the child, gradually desensitizes them to sexual contact, and ensures secrecy through manipulation or threats." },
{ q: "What prophylaxis should be offered after acute sexual assault in adolescents?", a: "<b>Emergency contraception</b> (levonorgestrel), <b>STI prophylaxis</b> (ceftriaxone + azithromycin + metronidazole), <b>hepatitis B vaccine</b>, and <b>HIV PEP</b> considered based on risk." },
{ q: "When should a child's disclosure of sexual abuse be considered reliable?", a: "When the child provides <b>spontaneous, developmentally appropriate language</b>, with <b>sensory details</b>, and the account is <b>consistent over time</b>. Children rarely fabricate sexual abuse." },
{ q: "What is the role of colposcopy in sexual abuse evaluation?", a: "A <b>magnified photographic examination</b> of the anogenital area. It enhances visualization and <b>documentation</b> of subtle findings but does not improve diagnostic accuracy alone." },

// ===== NEGLECT (Cards 49–56) =====
{ q: "What is non-organic failure to thrive (NOFTT)?", a: "Growth failure due to <b>inadequate caloric intake</b> from psychosocial or environmental causes (neglect), rather than underlying organic disease. Weight is affected first, then height, then head circumference." },
{ q: "How is failure to thrive typically defined?", a: "Weight <b>&lt;3rd percentile</b> for age, weight <b>&lt;80% of ideal weight for height</b>, or <b>crossing downward across 2 or more major percentile lines</b> on the growth chart." },
{ q: "What is the diagnostic approach to NOFTT?", a: "Observation of <b>catch-up growth</b> when adequate calories are provided (in hospital or supervised feeding). Rapid weight gain with adequate nutrition confirms inadequate caloric intake at home." },
{ q: "What are signs of dental neglect?", a: "<b>Rampant untreated caries, dental abscess, pain with eating</b>, and failure to obtain needed dental care despite access — especially when it interferes with nutrition or development." },
{ q: "How does emotional neglect present?", a: "Signs include <b>withdrawal, flat affect, developmental delays (especially language), poor attachment, low self-esteem</b>, and lack of age-appropriate social skills." },
{ q: "What features distinguish neglect-related FTT from organic FTT?", a: "In neglect: child is often <b>withdrawn or hypervigilant</b>, shows <b>food-seeking behavior</b>, has poor hygiene, and demonstrates <b>rapid catch-up growth</b> when fed adequately. Organic FTT has underlying disease." },
{ q: "What is the most common cause of death from child maltreatment?", a: "<b>Neglect</b> — often from supervisory neglect (drowning, fire, ingestion) rather than active physical abuse. Neglect also causes the most overall morbidity." },
{ q: "What are the physical signs of general neglect?", a: "<b>Poor hygiene, inappropriate clothing for weather, untreated medical conditions, severe diaper rash, malnutrition</b>, and frequent unsupervised injuries." },

// ===== RISK FACTORS (Cards 57–64) =====
{ q: "What are the major parent/caregiver risk factors for child abuse?", a: "Young parental age, <b>substance abuse</b>, domestic violence, <b>history of being abused</b> as a child, social isolation, mental illness, unrealistic developmental expectations, and poverty/stress." },
{ q: "What child characteristics increase the risk of maltreatment?", a: "<b>Prematurity, disability (physical or intellectual), chronic illness, difficult temperament, colic</b>, and being a product of unwanted pregnancy." },
{ q: "How does domestic violence relate to child abuse?", a: "There is a <b>30–60% overlap</b> between domestic violence and child abuse in the same household. Children who witness domestic violence also suffer psychological harm." },
{ q: "What environmental/social risk factors contribute to child maltreatment?", a: "<b>Poverty, unemployment, homelessness, social isolation, lack of social support</b>, community violence, and substance-abusing neighborhood environment." },
{ q: "What is the intergenerational cycle of abuse?", a: "Parents who were <b>abused as children</b> are at increased risk of abusing their own children, though the majority do <b>NOT</b> go on to become abusers. It is a risk factor, not destiny." },
{ q: "Which parental expectations are associated with increased abuse risk?", a: "<b>Unrealistic developmental expectations</b> — e.g., expecting a 6-month-old to be toilet trained or a toddler to sit still. Frustration from unmet expectations triggers abuse." },
{ q: "What is the role of substance abuse in child maltreatment?", a: "Substance abuse <b>impairs judgment, increases impulsivity and aggression</b>, depletes financial resources, and disrupts parental bonding — it is present in <b>~40–80%</b> of substantiated abuse cases." },
{ q: "What is the significance of a child's cry in triggering abuse?", a: "Inconsolable crying (especially in colicky infants) is a <b>common trigger for abusive head trauma</b>. Education about normal infant crying (e.g., <b>PURPLE crying program</b>) is preventive." },

// ===== DIFFERENTIAL DIAGNOSIS (Cards 65–76) =====
{ q: "What is osteogenesis imperfecta (OI) and how does it mimic abuse?", a: "A <b>collagen disorder</b> causing brittle bones with easy fractures. Features: <b>blue sclerae, dentinogenesis imperfecta, hearing loss, family history</b>. Type I is most common." },
{ q: "How do you differentiate OI from non-accidental fractures?", a: "OI has <b>blue sclerae, wormian bones on skull X-ray, osteopenia, family history, dentinogenesis imperfecta</b>, and no unexplained soft tissue injuries (bruises, burns)." },
{ q: "What is Ehlers-Danlos syndrome and how does it mimic abuse?", a: "A connective tissue disorder causing <b>easy bruising, hyperextensible skin, and joint hypermobility</b>. Bruising pattern is diffuse rather than patterned; no fractures in typical forms." },
{ q: "How do Mongolian spots differ from bruises?", a: "<b>Mongolian spots</b> are flat, blue-gray, <b>non-tender</b> congenital dermal melanocytosis commonly on the sacrum/buttocks. They do NOT change color over days, unlike bruises, and are <b>documented at birth</b>." },
{ q: "What is ITP and how can it mimic abuse?", a: "<b>Immune thrombocytopenic purpura</b> — isolated thrombocytopenia causing petechiae, purpura, and easy bruising. Distinguished by <b>very low platelet count</b> and normal coagulation studies." },
{ q: "How does hemophilia present and mimic abuse?", a: "Hemophilia (A or B) causes <b>deep tissue bleeding, hemarthrosis</b>, and excessive bruising. Diagnosed by <b>prolonged PTT</b> with normal PT and low factor VIII or IX levels." },
{ q: "What is Von Willebrand disease and its relevance to abuse workup?", a: "Most common inherited <b>bleeding disorder</b>. Causes mucosal bleeding and easy bruising. Screen with <b>VWF antigen, VWF activity (ristocetin cofactor), factor VIII level</b>, and bleeding time." },
{ q: "What cultural practices may be confused with child abuse?", a: "<b>Cupping (circular bruises), coining/cao gio (linear bruises on back), moxibustion (burns)</b>. These must be evaluated in cultural context but still require clinical assessment." },
{ q: "What are the distinguishing features of cupping marks vs. abuse?", a: "Cupping produces <b>symmetric, circular, non-tender marks</b> on the back/trunk. They are consistent with cultural context, occur in predictable patterns, and parents readily explain them." },
{ q: "What skin findings in Henoch-Schönlein purpura (IgA vasculitis) can mimic abuse?", a: "<b>Palpable purpura</b> predominantly on the buttocks and lower extremities. Distinguished by associated <b>arthritis, abdominal pain, nephritis</b>, and normal platelet count." },
{ q: "What is rickets and how can it be confused with abuse?", a: "<b>Vitamin D deficiency</b> causing osteopenia and fractures. Distinguished by <b>rachitic rosary, widened wrists, craniotabes, low vitamin D, elevated alkaline phosphatase</b>, and characteristic metaphyseal changes." },
{ q: "What is the role of genetic testing in suspected abuse with fractures?", a: "Genetic testing for <b>collagen disorders (OI)</b> should be considered when clinical features (blue sclerae, family history, osteopenia) raise suspicion, but should <b>not delay reporting</b> if abuse is suspected." },

// ===== EVALUATION & WORKUP (Cards 77–88) =====
{ q: "When is a skeletal survey mandatory in suspected abuse?", a: "A skeletal survey is <b>mandatory for all children &lt;2 years old</b> when physical abuse is suspected. It should be considered up to age 5. A <b>follow-up skeletal survey</b> at 2 weeks improves detection." },
{ q: "What does a skeletal survey include?", a: "AP views of <b>all long bones (individually), chest (including oblique rib views), pelvis, spine (AP + lateral), hands, feet, and skull (AP + lateral)</b>. A 'babygram' single-view is NOT acceptable." },
{ q: "Why is a follow-up skeletal survey performed 2 weeks later?", a: "Healing fractures become visible as <b>periosteal new bone formation</b> and callus develops, revealing fractures that may have been occult on the initial survey — increases sensitivity by <b>~25%</b>." },
{ q: "When should a head CT be obtained in suspected abuse?", a: "A <b>non-contrast head CT</b> should be obtained in all children <b>&lt;6 months old</b> with suspected abuse, and in any child with neurological symptoms, facial bruising, or unexplained change in mental status." },
{ q: "What is the role of brain MRI in abusive head trauma?", a: "MRI is more sensitive for <b>diffuse axonal injury (DAI), parenchymal injury, and dating of subdural hemorrhages</b>. It should follow head CT when intracranial injury is identified." },
{ q: "What laboratory studies should be ordered in suspected physical abuse?", a: "<b>CBC with differential, PT/PTT/INR, fibrinogen, von Willebrand studies, LFTs (AST/ALT), lipase/amylase, urinalysis</b> (for hematuria from renal trauma)." },
{ q: "Why are LFTs and lipase checked in abuse evaluations?", a: "To screen for <b>occult abdominal trauma</b> — elevated AST/ALT suggests hepatic injury; elevated lipase suggests pancreatic injury. Abdominal trauma may have <b>no external signs</b>." },
{ q: "What is the importance of coagulation studies in the abuse workup?", a: "To rule out <b>bleeding disorders</b> (hemophilia, VWD, DIC) that may explain bruising or hemorrhage — essential for differential diagnosis and medicolegal thoroughness." },
{ q: "How should injuries be documented in suspected abuse?", a: "Use <b>body diagrams, color photographs with a ruler/scale, detailed written descriptions</b> (size, shape, color, location, pattern) in the medical record. Documentation should be objective and thorough." },
{ q: "What is the role of a retinal examination in suspected abuse?", a: "Performed by an <b>ophthalmologist</b> to detect retinal hemorrhages — <b>multilayered, extensive retinal hemorrhages</b> extending to the ora serrata are highly specific for abusive head trauma." },
{ q: "What retinal findings are most specific for abusive head trauma?", a: "<b>Bilateral, multilayered (pre-retinal, intraretinal, sub-retinal) hemorrhages</b> that extend to the <b>periphery (ora serrata)</b>. Few other conditions produce this pattern in infants." },
{ q: "What imaging is recommended for suspected abdominal abuse?", a: "If screening labs are abnormal: <b>CT abdomen/pelvis with IV contrast</b> to evaluate for hepatic, splenic, pancreatic, renal, or hollow viscus injuries." },

// ===== LEGAL & ETHICAL OBLIGATIONS (Cards 89–97) =====
{ q: "Who is a mandated reporter of child abuse?", a: "<b>ALL healthcare providers</b> (physicians, nurses, social workers, dentists, EMTs) are mandated reporters in all U.S. states. Many states also mandate reporting by teachers, clergy, and coaches." },
{ q: "What standard of evidence is required to report suspected child abuse?", a: "<b>Reasonable suspicion</b> — NOT proof, certainty, or even a preponderance of evidence. If abuse is suspected, it <b>must</b> be reported. Investigation is CPS's responsibility, not the reporter's." },
{ q: "To whom should suspected child abuse be reported?", a: "Reports are made to <b>Child Protective Services (CPS)</b> and/or <b>law enforcement</b>, depending on state law. Most states have 24-hour reporting hotlines." },
{ q: "What legal protections exist for mandated reporters?", a: "<b>Good faith immunity</b> — reporters who report in good faith are protected from <b>civil and criminal liability</b>, even if the report is not substantiated." },
{ q: "What are the consequences of failure to report suspected abuse?", a: "Mandated reporters who fail to report face <b>criminal penalties</b> (misdemeanor or felony depending on jurisdiction), <b>civil liability</b>, professional disciplinary action, and <b>loss of licensure</b>." },
{ q: "Does physician-patient confidentiality apply when reporting abuse?", a: "<b>No.</b> Child abuse reporting is a <b>statutory exception</b> to confidentiality. The child's safety takes precedence. Parental consent is <b>not required</b> to file a report." },
{ q: "Can a physician refuse to report suspected abuse if the family objects?", a: "<b>No.</b> Reporting is a <b>legal obligation</b> regardless of family wishes. The physician should explain the reporting requirement professionally but must report regardless." },
{ q: "What should a physician do if unsure whether findings constitute abuse?", a: "<b>Report.</b> The threshold is <b>reasonable suspicion</b>, not diagnostic certainty. When in doubt, consult a child abuse specialist and/or report to CPS, who will investigate." },
{ q: "What is the physician's role after filing a CPS report?", a: "Continue <b>medical care and documentation</b>, cooperate with CPS investigation, ensure the child's <b>immediate safety</b> (consider hospital admission), and provide follow-up as needed." },

// ===== ABUSIVE HEAD TRAUMA (Cards 98–105) =====
{ q: "What is the classic triad of abusive head trauma?", a: "1. <b>Subdural hematoma</b> (often bilateral)<br>2. <b>Retinal hemorrhages</b> (multilayered, bilateral)<br>3. <b>Encephalopathy</b> (diffuse axonal injury/cerebral edema)" },
{ q: "What are the clinical presentations of abusive head trauma?", a: "<b>Altered mental status, seizures, apnea, vomiting, irritability, lethargy, bulging fontanelle, poor feeding</b>, and in severe cases, coma or death." },
{ q: "What type of subdural hematoma is most common in abusive head trauma?", a: "<b>Thin, bilateral subdural hematomas</b> over the cerebral convexities and within the interhemispheric fissure, caused by <b>rupture of bridging veins</b>." },
{ q: "What is diffuse axonal injury (DAI)?", a: "<b>Widespread shearing of axons</b> caused by rotational acceleration-deceleration forces. It is the primary mechanism of brain damage in abusive head trauma and is best visualized on <b>MRI (diffusion-weighted imaging)</b>." },
{ q: "What conditions can rarely mimic the triad of abusive head trauma?", a: "Very few: <b>severe accidental trauma (MVA, witnessed high fall), glutaric aciduria type I, meningitis, coagulopathy</b>. Short household falls (<3 feet) do NOT cause subdural hematomas + retinal hemorrhages." },
{ q: "What is the significance of a short household fall in an infant?", a: "Falls from <b>&lt;3–4 feet</b> very rarely cause significant intracranial injury. An infant with subdural hemorrhage and retinal hemorrhages attributed to a short fall should be <b>evaluated for abuse</b>." },
{ q: "What are the long-term outcomes of abusive head trauma?", a: "<b>~25% mortality</b>. Among survivors: <b>cognitive impairment, cerebral palsy, epilepsy, visual impairment, learning disabilities</b>. It is the leading cause of death from child abuse." },
{ q: "What is the PURPLE crying program?", a: "An educational program for new parents about <b>normal infant crying patterns</b> (Peak, Unexpected, Resists soothing, Pain-like face, Long-lasting, Evening). Aims to <b>prevent abusive head trauma</b> triggered by crying." },

// ===== MUNCHAUSEN BY PROXY / FDIA (Cards 106–111) =====
{ q: "What is the typical perpetrator profile in Factitious Disorder Imposed on Another (FDIA)?", a: "Most commonly the <b>biological mother</b> (~90%). She may have medical knowledge, appear extremely involved and concerned, and may have a history of <b>factitious disorder herself</b>." },
{ q: "What are common methods of illness fabrication in FDIA?", a: "<b>Falsifying lab specimens</b> (adding blood/sugar to urine), <b>poisoning</b> (ipecac, insulin, salt), <b>suffocation</b> (causing apnea), <b>exaggerating/fabricating symptoms</b>, and contaminating IV lines." },
{ q: "What is the 'separation test' in FDIA?", a: "Monitoring the child when the suspected caregiver is <b>removed/separated</b>. If the child's symptoms <b>resolve</b> during separation and recur when the caregiver returns, it strongly supports FDIA." },
{ q: "What clue in the medical history should raise suspicion for FDIA?", a: "<b>Unexplained, recurrent, or unusual illnesses</b> that occur only when the caregiver is present, symptoms unresponsive to treatment, multiple hospitalizations, and <b>doctor/hospital shopping</b>." },
{ q: "What is covert video surveillance in FDIA?", a: "Hidden video monitoring of the caregiver-child interaction in the hospital to <b>document abusive behaviors</b> (e.g., suffocation, poisoning). It is controversial but used in some institutions with ethical/legal review." },
{ q: "What is the mortality rate of FDIA?", a: "Estimated at <b>6–10%</b>, making it one of the more lethal forms of child abuse. Siblings of victims should also be evaluated as they may be current or past victims." },

// ===== LONG-TERM CONSEQUENCES & ACEs (Cards 112–120) =====
{ q: "What are Adverse Childhood Experiences (ACEs)?", a: "A set of <b>10 categories of childhood trauma</b> (abuse, neglect, household dysfunction) whose cumulative score correlates with increased risk of <b>chronic disease, mental illness, and early death</b> in adulthood." },
{ q: "What are the 10 categories in the ACE score?", a: "<b>Abuse:</b> physical, emotional, sexual<br><b>Neglect:</b> physical, emotional<br><b>Household dysfunction:</b> domestic violence, substance abuse, mental illness, parental separation/divorce, incarcerated household member" },
{ q: "How does ACE score correlate with adult health outcomes?", a: "Higher ACE scores are associated with increased risk of <b>heart disease, diabetes, cancer, depression, suicide, substance abuse, obesity, STIs</b>, and <b>reduced life expectancy</b> in a dose-response relationship." },
{ q: "What mental health consequences are associated with child abuse?", a: "<b>PTSD, depression, anxiety disorders, attachment disorders, conduct disorder, substance abuse, self-harm, suicidality</b>, and personality disorders (especially borderline)." },
{ q: "What is the relationship between child abuse and substance abuse?", a: "Child abuse survivors have <b>significantly increased rates of alcohol and drug abuse</b> in adolescence and adulthood, often used as maladaptive coping mechanisms." },
{ q: "What is the impact of child abuse on brain development?", a: "Chronic stress from abuse causes <b>elevated cortisol, altered HPA axis, reduced hippocampal volume, impaired prefrontal cortex development</b>, and epigenetic changes affecting stress response." },
{ q: "What is reactive attachment disorder (RAD)?", a: "A disorder in children <b>&lt;5 years old</b> resulting from severe neglect/abuse, characterized by <b>inhibited, emotionally withdrawn behavior</b> and failure to seek comfort from attachment figures." },
{ q: "What is the difference between RAD and Disinhibited Social Engagement Disorder (DSED)?", a: "<b>RAD</b>: child is withdrawn, does not seek comfort. <br><b>DSED</b>: child approaches <b>unfamiliar adults</b> without appropriate wariness — both result from pathogenic care/neglect." },
{ q: "What is the estimated annual cost of child maltreatment in the United States?", a: "Over <b>$120 billion annually</b> when accounting for healthcare, criminal justice, child welfare, education, and lost productivity — highlighting the enormous public health impact." }
          ]
        },
        {
          section: 'Orthopedics',
          topic: "Fractures & dislocations — classification & management",
          icon: "bone",
          cards: [
            // ===== BONE HEALING =====
  { q: "What are the three main phases of secondary bone healing?", a: "1. <b>Inflammatory phase</b> (hematoma formation, weeks 0–2).<br>2. <b>Reparative phase</b> (soft/hard callus formation, weeks 2–8).<br>3. <b>Remodeling phase</b> (woven bone to lamellar bone, months to years)." },
  { q: "Differentiate between primary and secondary bone healing.", a: "<b>Primary healing:</b> Occurs with absolute stability (no motion, e.g., compression plating); requires direct osteonal bridging (no callus).<br><b>Secondary healing:</b> Occurs with relative stability (some motion, e.g., casting, intramedullary nailing); heals via callus formation." },
  { q: "What is the key histological difference between primary and secondary bone healing?", a: "Primary bone healing does <b>not</b> form a callus, whereas secondary bone healing relies on a <b>callus</b> to bridge the gap." },
  { q: "Define delayed union, nonunion, and malunion.", a: "• <b>Delayed union:</b> Fracture healing taking longer than expected but eventually progressing.<br>• <b>Nonunion:</b> Cessation of all reparative processes without bone union.<br>• <b>Malunion:</b> Healing of bone in an anatomically incorrect position." },
  { q: "What is the difference between hypertrophic and atrophic nonunion?", a: "• <b>Hypertrophic:</b> Adequate blood supply but inadequate stability (presents with 'elephant foot' callus; treat with stabilization).<br>• <b>Atrophic:</b> Inadequate blood supply and biology (no callus; treat with bone graft/biology + stability)." },
  { q: "What are risk factors for atrophic nonunion?", a: "Smoking, diabetes, NSAID use (inhibits prostaglandins needed for bone healing), corticosteroids, malnutrition, and local vascular disease." },

  // ===== FRACTURE DESCRIPTION & CLASSIFICATION =====
  { q: "How are fractures classified based on direction of the fracture line?", a: "• <b>Transverse:</b> Perpendicular to long axis.<br>• <b>Oblique:</b> At an angle.<br>• <b>Spiral:</b> Torsional force (rotational).<br>• <b>Comminuted:</b> >2 fragments.<br>• <b>Segmental:</b> Two separate fractures in one bone." },
  { q: "Define displacement, translation, angulation, and shortening in fractures.", a: "• <b>Displacement/Translation:</b> Shift of the distal fragment relative to proximal.<br>• <b>Angulation:</b> Deviation from straight axis (described by direction of distal fragment or apex).<br>• <b>Shortening:</b> Overlapping of fragments (expressed in cm)." },
  { q: "What is the Gustilo-Anderson classification used for, and what are its categories?", a: "Classifies <b>open fractures</b>:<br>• <b>Type I:</b> Clean wound <1 cm.<br>• <b>Type II:</b> Wound 1–10 cm without extensive soft tissue damage.<br>• <b>Type III:</b> >10 cm or high-energy injury (IIIa: adequate soft tissue coverage; IIIb: soft tissue stripping requiring flap; IIIc: arterial injury requiring repair)." },
  { q: "What are the immediate management steps for an open fracture?", a: "1. <b>Intravenous antibiotics</b> (Type I/II: 1st gen cephalosporin; Type III: add aminoglycoside; soil contamination: add penicillin).<br>2. <b>Tetanus prophylaxis</b>.<br>3. Urgent bedside irrigation and sterile dressing.<br>4. Emergent <b>surgical debridement</b> (within 24 hours)." },
  { q: "What antibiotic is added to a Gustilo-Anderson Type III open fracture regimen?", a: "An <b>aminoglycoside</b> (e.g., Gentamicin) is added to a 1st generation cephalosporin (e.g., Ancef). Add <b>Penicillin G</b> for farm/soil injuries (anaerobes/Clostridium)." },

  // ===== PEDIATRIC FRACTURES =====
  { q: "What is the Salter-Harris classification used for?", a: "Classifies pediatric fractures involving the <b>physeal (growth) plate</b>." },
  { q: "Detail the Salter-Harris types I through V using the SALTR mnemonic.", a: "• <b>Type I (S - Same):</b> Straight across physis.<br>• <b>Type II (A - Above):</b> Physis into metaphysis.<br>• <b>Type III (L - Lower):</b> Physis into epiphysis.<br>• <b>Type IV (T - Through):</b> Through metaphysis, physis, and epiphysis.<br>• <b>Type V (R - Ruined):</b> Compression/crush of physis." },
  { q: "Which Salter-Harris fracture type is the most common?", a: "<b>Salter-Harris Type II</b> (fracture travels through the physis and exits through the metaphysis)." },
  { q: "Which Salter-Harris fracture types have the highest risk of growth arrest?", a: "<b>Types IV and V</b>, as they cross the proliferative layer of the physis or crush the growth plate, potentially forming a bony bridge." },
  { q: "What are three unique features of pediatric bones compared to adults?", a: "1. <b>Thicker, stronger periosteum</b> (stabilizes fractures and aids healing).<br>2. <b>More plastic/ductile bone</b> (leads to greenstick/torus fractures).<br>3. <b>Presence of active growth plates</b> (physes)." },
  { q: "Define greenstick, torus (buckle), and plastic deformation fractures.", a: "• <b>Greenstick:</b> Incomplete fracture where one cortex breaks and the other remains intact/bent.<br>• <b>Torus/Buckle:</b> Compression of cortex causing a bulge (stable, treat with splint/boot).<br>• <b>Plastic deformation:</b> Bone bends without a visible fracture line." },

  // ===== COMPARTMENT SYNDROME =====
  { q: "What is the pathophysiology of compartment syndrome?", a: "Increased pressure within a closed osteofascial compartment exceeds capillary perfusion pressure, leading to muscle and nerve ischemia." },
  { q: "What is the most common cause of compartment syndrome?", a: "Fractures, most commonly of the <b>tibial shaft</b> (lower extremity) and <b>forearm</b> (upper extremity)." },
  { q: "What are the 6 P's of compartment syndrome, and which is the earliest sign?", a: "1. <b>Pain out of proportion</b> to clinical findings (earliest, most reliable sign).<br>2. Paresthesia.<br>3. Pallor.<br>4. Paralysis.<br>5. Pulselessness (very late).<br>6. Poikilothermia." },
  { q: "What physical exam maneuver worsens pain in compartment syndrome?", a: "<b>Passive stretch</b> of the muscles in the affected compartment." },
  { q: "How is compartment syndrome diagnosed objectively?", a: "By measuring compartment pressure. A <b>delta pressure (diastolic BP − compartment pressure) $\\le 30\\text{ mmHg}$</b> is diagnostic." },
  { q: "What is the definitive treatment for compartment syndrome?", a: "Emergent surgical <b>fasciotomy</b> of all affected compartments to relieve pressure (wounds are left open and closed delayed)." },
  { q: "What are the long-term complications of untreated compartment syndrome?", a: "Muscle necrosis, rhabdomyolysis (leading to acute kidney injury), and <b>Volkmann ischemic contracture</b> (permanent claw-like hand flexion)." },

  // ===== FAT EMBOLISM SENSITIVITY =====
  { q: "What is the classic triad of fat embolism syndrome?", a: "1. <b>Respiratory distress/hypoxia</b>.<br>2. <b>Neurological changes</b> (confusion, lethargy, coma).<br>3. <b>Petechial rash</b> (found on chest, axillae, neck, and conjunctiva; pathognomonic but present in only ~30% of cases)." },
  { q: "With what type of fractures is fat embolism syndrome most commonly associated?", a: "Closed fractures of <b>long bones</b> (femur, tibia) and pelvic fractures." },
  { q: "How is fat embolism syndrome managed?", a: "Primarily <b>supportive care</b>: oxygenation (mechanical ventilation if needed), hydration, and early stabilization of the fracture to prevent further fat release." },

  // ===== ORTHOPEDIC EMERGENCIES =====
  { q: "What is the clinical concern for a knee dislocation?", a: "High risk of injury to the <b>popliteal artery</b> and the <b>common peroneal nerve</b>. Requires immediate reduction and ABI assessment." },
  { q: "How do you evaluate for popliteal artery injury in a knee dislocation?", a: "Check distal pulses and calculate the <b>Ankle-Brachial Index (ABI)</b>. If ABI <0.9 or hard signs of vascular injury are present, obtain a CT angiogram." },
  { q: "What is a 'warm ischemia time' threshold for traumatic amputations?", a: "<b>6 hours</b>. Amputated parts should be wrapped in saline-moistened gauze, placed in a plastic bag, and kept on ice (do not freeze directly) to maximize viability." },
  { q: "What is the primary management of a suspected septic joint?", a: "Urgent joint aspiration (arthrocentesis) followed by <b>emergent surgical drainage/debridement</b> and IV antibiotics. Do not wait for cultures to arrange drainage." },

  // ===== UPPER EXTREMITY INJURIES =====
  { q: "What is the most common site of clavicle fractures and its treatment?", a: "The <b>middle third (midshaft)</b> (~80%). Most are treated non-operatively with a sling. Surgery is considered for significant displacement or shortening (>2 cm)." },
  { q: "What nerve is at risk in a proximal humerus fracture?", a: "The <b>axillary nerve</b> (check sensation over the lateral deltoid; innervates deltoid and teres minor)." },
  { q: "What nerve is at risk in a humeral shaft fracture?", a: "The <b>radial nerve</b>. Look for <b>wrist drop</b> (loss of wrist and finger extension) and sensory loss on the dorsum of the hand." },
  { q: "What are the classic complications of pediatric supracondylar humerus fractures?", a: "1. <b>Vascular injury</b> (brachial artery).<br>2. <b>Nerve injury</b> (anterior interosseous nerve/median nerve most common).<br>3. <b>Volkmann ischemic contracture</b>." },
  { q: "Explain the anterior humeral line and fat pad sign in pediatric elbow X-rays.", a: "• <b>Anterior humeral line:</b> Line down anterior cortex of humerus should bisect middle third of capitellum; displacement indicates supracondylar fracture.<br>• <b>Fat pad sign:</b> Posterior fat pad is always pathologic (anterior fat pad can be normal, 'sail sign' indicates joint effusion)." },
  { q: "What is the difference between Monteggia and Galeazzi fractures?", a: "• <b>Monteggia:</b> Proximal <b>U</b>lna fracture with radial head dislocation (<b>M</b>onteggia = <b>M</b>u).<br>• <b>Galeazzi:</b> Distal <b>R</b>adius fracture with distal radioulnar joint (DRUJ) dislocation (<b>G</b>aleazzi = <b>G</b>r)." },
  { q: "What is a 'nightstick fracture'?", a: "An isolated fracture of the <b>ulnar shaft</b>, typically caused by a direct blow to the forearm while shielding the face from an impact." },
  { q: "Differentiate between Colles and Smith fractures.", a: "• <b>Colles:</b> Distal radius fracture with <b>dorsal displacement</b> (dinner fork deformity; from fall on outstretched hand [FOOSH]).<br>• <b>Smith:</b> Distal radius fracture with <b>volar/ventral displacement</b> (garden spade deformity; from fall on flexed wrist)." },
  { q: "What is a Barton fracture?", a: "An intra-articular distal radius fracture-dislocation with displacement of the carpus along with the fracture fragment (can be dorsal or volar)." },
  { q: "What is the most commonly fractured carpal bone and its classic physical exam sign?", a: "The <b>scaphoid</b>. Presents with tenderness in the <b>anatomical snuffbox</b>." },
  { q: "What is the primary risk associated with scaphoid fractures?", a: "<b>Avascular necrosis (AVN)</b> of the proximal pole due to its retrograde blood supply (supplied by branches of the radial artery entering distally)." },
  { q: "How is a suspected scaphoid fracture managed if initial X-rays are negative?", a: "Place in a <b>thumb spica splint</b> and repeat X-rays in 10–14 days, or obtain an MRI (most sensitive early diagnostic tool)." },
  { q: "What is a boxer's fracture?", a: "A fracture of the <b>fifth metacarpal neck</b>, usually caused by striking a hard object with a closed fist." },
  { q: "What is a Bennett fracture?", a: "An intra-articular fracture-subluxation at the base of the <b>first metacarpal</b> (thumb), requiring surgical stabilization due to deforming pull of the abductor pollicis longus." },

  // ===== LOWER EXTREMITY & PELVIC INJURIES =====
  { q: "What is the major acute risk of pelvic ring fractures?", a: "Massive <b>retroperitoneal hemorrhage</b> from venous plexus or internal iliac artery lacerations. Managed with a pelvic binder placed at the level of the greater trochanters." },
  { q: "What is the correct anatomical placement of a pelvic binder?", a: "At the level of the <b>greater trochanters</b> (not the iliac crests) to properly close the pelvic volume and stabilize the pelvic ring." },
  { q: "Compare the typical leg position of a hip dislocation vs. a hip fracture.", a: "• <b>Posterior Hip Dislocation:</b> Leg is <b>shortened, adducted, and internally rotated</b>.<br>• <b>Hip Fracture:</b> Leg is <b>shortened, abducted, and externally rotated</b>." },
  { q: "Which type of hip dislocation is most common, and what nerve is at risk?", a: "<b>Posterior hip dislocation</b> (~90%; often from dashboard injury). The <b>sciatic nerve</b> is at risk." },
  { q: "Differentiate between femoral neck and intertrochanteric fractures regarding AVN risk.", a: "• <b>Femoral neck (intracapsular):</b> High risk of AVN due to disruption of the medial femoral circumflex artery.<br>• <b>Intertrochanteric (extracapsular):</b> Low risk of AVN because of rich blood supply; heals well but requires internal fixation." },
  { q: "Why do femoral shaft fractures often require blood transfusion?", a: "They can result in significant internal blood loss (up to <b>1.0–1.5 liters of blood</b> per femur) into the thigh compartment." },
  { q: "What is the Schatzker classification used for?", a: "Classifies <b>tibial plateau fractures</b> (Types I-VI based on cleavage and depression of lateral/medial plateau)." },
  { q: "What nerve is at risk in a fibular head fracture?", a: "The <b>common peroneal nerve</b> (results in foot drop and loss of sensation on the dorsum of the foot)." },
  { q: "What is a Maisonneuve fracture?", a: "A spiral fracture of the <b>proximal fibula</b> associated with an ankle injury (disruption of distal tibiofibular syndesmosis and medial malleolus fracture/deltoid ligament tear)." },
  { q: "What are the Ottawa Ankle and Foot Rules?", a: "X-rays are required only if patient is unable to bear weight immediately and in the ED, OR has bone tenderness at:<br>• Posterior edge/tip of medial/lateral malleolus (ankle).<br>• Base of the 5th metacarpal/navicular bone (foot)." },
  { q: "What is the Weber classification for ankle fractures?", a: "Based on the level of the fibular fracture relative to the syndesmosis:<br>• <b>Weber A:</b> Below syndesmosis (stable).<br>• <b>Weber B:</b> At the level of syndesmosis (variable stability).<br>• <b>Weber C:</b> Above syndesmosis (unstable, requires ORIF)." },
  { q: "What is a Lisfranc injury?", a: "Disruption of the tarsometatarsal joint complex, specifically the ligament connecting the medial cuneiform to the base of the second metatarsal (frequently presenting with plantar ecchymosis)." },

  // ===== DISLOCATIONS & OTHER HIGHLIGHTS =====
  { q: "What is the most common joint dislocation in the body?", a: "The <b>glenohumeral (shoulder) joint</b> (anterior dislocation is most common)." },
  { q: "What is a Hill-Sachs lesion and a Bankart lesion?", a: "Complications of anterior shoulder dislocation:<br>• <b>Hill-Sachs:</b> Compression fracture of the posterolateral femoral head/humeral head.<br>• <b>Bankart:</b> Avulsion of the anteroinferior glenoid labrum." },
  { q: "What is a nursemaid's elbow and how is it reduced?", a: "Subluxation of the <b>radial head</b> through the <b>annular ligament</b> in children. Reduced by <b>hyperpronation</b> or <b>supination with flexion</b> while applying pressure over the radial head." },
  { q: "What is the most common patellar dislocation direction?", a: "<b>Lateral</b>. Commonly caused by a twisting injury on a flexed knee in young female athletes." },
  { q: "What is a Segond fracture?", a: "An avulsion fracture of the lateral tibial plateau, highly associated with **ACL tears** (~90%)." },
  { q: "What is a pilon fracture?", a: "An intra-articular fracture of the distal tibia caused by axial loading, resulting in talus impaction into the tibial plafond." },
  { q: "What is the first-line treatment for a stable pediatric buckle fracture?", a: "A simple removable **splint or velcro boot** rather than a rigid cast, for 3–4 weeks." },
  { q: "What is a Toddler's fracture?", a: "A non-displaced spiral fracture of the **distal tibia** in children <3 years, presenting as sudden refusal to bear weight after minor or no recalled trauma." },
  { q: "Describe the Salter-Harris Type I fracture on X-ray.", a: "Often appears normal on X-ray; diagnosed clinically by localized tenderness over the growth plate." },
  { q: "Why is a Gustilo-Anderson Type IIIc open fracture an emergency?", a: "Type IIIc includes a **vascular injury** that requires surgical repair, typically within 6 hours to prevent limb loss." },
  { q: "Which muscle compartment in the lower leg is most commonly affected by compartment syndrome?", a: "The **anterior compartment** (contains tibialis anterior, deep peroneal nerve, and anterior tibial artery)." },
  { q: "What is a Volkmann's ischemic contracture?", a: "End-stage necrosis of the flexor digitorum profundus and flexor pollicis longus muscles due to untreated compartment syndrome, leading to a permanent claw-like deformity." },
  { q: "What is the most common cause of atrophic nonunion?", a: "Inadequate **blood supply** at the fracture site, often due to soft tissue stripping or poor vascularity." },
  { q: "How does smoking impair bone healing?", a: "Nicotine causes **vasoconstriction**, decreases oxygen delivery, and inhibits osteoblast function." },
  { q: "Define a pathologic fracture.", a: "A fracture occurring through bone weakened by pre-existing disease (e.g., osteoporosis, bone cyst, tumor)." },
  { q: "What is the mechanism of a Colles fracture?", a: "Fall on an **outstretched hand** (FOOSH) with the wrist in extension." },
  { q: "What is the mechanism of a Smith fracture?", a: "Fall on the **dorsum of the hand** with the wrist in flexion." },
  { q: "What is the primary deformity seen in a Colles fracture?", a: "A **'dinner fork'** deformity due to dorsal displacement of the distal radius fragment." },
  { q: "What is the primary deformity seen in a Smith fracture?", a: "A **'garden spade'** deformity due to volar/palmar displacement of the distal radius fragment." },
  { q: "What is a Chauffeur's fracture?", a: "An intra-articular avulsion fracture of the **radial styloid**, historically caused by a starting crank backfiring." },
  { q: "Why do we check radial nerve function after a humeral shaft fracture?", a: "The radial nerve runs in the **spiral groove** directly against the humerus and is easily stretched or torn." },
  { q: "What is a Hangman's fracture?", a: "A bilateral fracture through the pars interarticularis of **C2** (axis), typically caused by hyperextension." },
  { q: "What is a Jefferson fracture?", a: "A burst fracture of the anterior and posterior arches of **C1** (atlas) caused by axial loading." },
  { q: "What is a Clay Shoveler's fracture?", a: "A spinous process fracture, most commonly of **C7 or T1**, caused by heavy lifting or direct trauma." },
  { q: "What is a Rolando fracture?", a: "A comminuted intra-articular fracture at the base of the **first metacarpal** (Y or T-shaped configuration)." },
  { q: "What is a Gamekeeper's (or Skier's) thumb?", a: "Rupture of the **ulnar collateral ligament** (UCL) of the thumb MCP joint." },
  { q: "What is a Stener lesion?", a: "Interposition of the adductor aponeurosis between the ruptured thumb UCL and its insertion site, preventing healing without surgery." },
  { q: "What is the most common mechanism for a lateral ankle sprain?", a: "Inversion and plantarflexion of the foot." },
  { q: "What is the first ligament injured in a typical lateral ankle sprain?", a: "The **anterior talofibular ligament** (ATFL)." },
  { q: "What is the second ligament injured in a severe lateral ankle sprain?", a: "The **calcaneofibular ligament** (CFL)." },
  { q: "What is a high ankle sprain?", a: "Injury to the **distal tibiofibular syndesmosis** (anterior and posterior inferior tibiofibular ligaments)." },
  { q: "What test is used to evaluate a syndesmotic ankle injury?", a: "The **Squeeze test** (pain at the ankle when squeezing the mid-shaft calf)." },
  { q: "What is a Turf toe?", a: "Hyperextension injury of the **first metatarsophalangeal** (MTP) joint plantar plate." },
  { q: "What is a Jersey finger?", a: "Avulsion of the **flexor digitorum profundus** (FDP) tendon insertion at the distal phalanx (inability to flex the DIP joint)." },
  { q: "What is a Mallet finger?", a: "Avulsion of the **extensor tendon** at the distal phalanx (inability to extend the DIP joint)." },
  { q: "What is a Boutonniere deformity?", a: "Rupture of the **central slip** of the extensor tendon, leading to PIP flexion and DIP hyperextension." },
  { q: "What is a Swan neck deformity?", a: "Hyperextension of the PIP joint and flexion of the DIP joint." },
  { q: "What is a Dupuytren's contracture?", a: "Fibrous nodule and cord formation in the **palmar fascia**, leading to progressive flexion contractures (most commonly 4th and 5th digits)." },
  { q: "What is a trigger finger?", a: "Stenosing tenosynovitis at the **A1 pulley**, causing the finger to catch or lock in flexion." },
  { q: "What is a claw toe?", a: "Hyperextension of the MTP joint and flexion of the PIP and DIP joints." },
  { q: "What is a hammer toe?", a: "Hyperextension of the MTP, flexion of the PIP, and neutral/hyperextension of the DIP joint." },
  { q: "What is a mallet toe?", a: "Flexion of the DIP joint with neutral MTP and PIP joints." },
  { q: "What is a Morton's neuroma?", a: "Perineural fibrosis of the common digital nerve, most commonly between the **third and fourth metatarsal heads**." },
  { q: "What test is used to diagnose Morton's neuroma?", a: "The **Mulder click** test (squeezing the forefoot while applying dorsal-plantar pressure)." },
  { q: "What is a Charcot joint (neuropathic arthropathy)?", a: "Progressive bone destruction and joint deformity due to loss of sensation (most commonly in the foot/ankle of diabetic patients)." },
  { q: "What is a stress fracture?", a: "A microfracture caused by repetitive submaximal loading, common in runners and military recruits." },
  { q: "What is the most common site for a stress fracture?", a: "The **tibia**, followed by the metatarsals (especially the second metatarsal shaft)." },
  { q: "Why are stress fractures of the anterior tibial cortex high risk?", a: "They are on the tension side of the bone and have a **high rate of nonunion** (often require prolonged immobilization or surgery)." },
  { q: "What is a Jones fracture?", a: "A fracture through the junction of the diaphysis and metaphysis (Zone 2) of the **fifth metatarsal**." },
  { q: "Why is a Jones fracture prone to nonunion?", a: "It occurs in a **watershed vascular zone** with poor blood supply." },
  { q: "What is the difference between a Jones fracture and a pseudo-Jones (dancer's) fracture?", a: "• **Jones:** Zone 2 fracture of the 5th metatarsal base.<br>• **Pseudo-Jones:** Zone 1 avulsion fracture of the 5th metatarsal styloid (inserion of peroneus brevis; treated conservatively)." },
  { q: "What is a greenstick fracture's management?", a: "Reduction (often requiring breaking the intact opposite cortex to prevent recoil deformity) followed by casting." },
  { q: "What is a Salter-Harris Type V fracture mechanism?", a: "Axial crushing force applied through the physis." },
  { q: "Why is Salter-Harris Type V difficult to diagnose initially?", a: "The physis appears normal (non-displaced) on initial X-rays; it is often diagnosed retrospectively after growth arrest occurs." },
  { q: "Define nonunion timing.", a: "A fracture that has not healed after **6 months** and shows no progression on sequential X-rays." },
  { q: "What is the treatment for a symptomatic clavicle fracture with >2 cm shortening?", a: "Open reduction and internal fixation (ORIF) with plate and screws." },
  { q: "What is the primary risk of an anterior shoulder dislocation?", a: "Recurrence (especially in patients <20 years old, who have a ~90% recurrence rate)." },
  { q: "What is a Bankart lesion?", a: "Tear of the anteroinferior labrum of the glenoid." },
  { q: "What is a Hill-Sachs lesion?", a: "A posterolateral humeral head compression fracture caused by impact against the anterior glenoid." },
  { q: "What is the treatment for a pediatric supracondylar humerus fracture with absent distal pulses?", a: "Emergent closed reduction and percutaneous pinning (CRPP) in the operating room." },
  { q: "What is the Garth view on shoulder X-ray?", a: "An apical oblique projection useful for detecting subtle glenohumeral instability and humeral head fractures." },
  { q: "What is the role of a temporary external fixator in open fractures?", a: "Provides rapid skeleton stabilization, controls pain, and allows soft tissue monitoring/access before definitive fixation." }
          ]
        },
        {
          section: 'Orthopedics',
          topic: "Spine disorders — disc herniation, stenosis, scoliosis",
          icon: "activity",
          cards: [
            // ===== ANATOMY, NEUROLOGY & DERMATOMES =====
  { q: "What is the key motor function, sensation, and reflex associated with the L4 nerve root?", a: "• <b>Motor:</b> Tibialis anterior (foot dorsiflexion/inversion).<br>• <b>Sensation:</b> Medial leg and medial foot.<br>• <b>Reflex:</b> Patellar tendon (knee jerk)." },
  { q: "What is the key motor function, sensation, and reflex associated with the L5 nerve root?", a: "• <b>Motor:</b> Extensor hallucis longus (great toe extension) and extensor digitorum brevis.<br>• <b>Sensation:</b> Lateral leg and dorsum of the foot.<br>• <b>Reflex:</b> None (no reliable reflex)." },
  { q: "What is the key motor function, sensation, and reflex associated with the S1 nerve root?", a: "• <b>Motor:</b> Peroneus longus/brevis (foot eversion) and Gastrocnemius/Soleus (plantarflexion).<br>• <b>Sensation:</b> Lateral foot and plantar surface.<br>• <b>Reflex:</b> Achilles tendon (ankle jerk)." },
  { q: "What nerve root is responsible for hip flexion?", a: "<b>L2</b> (Ilio-psoas muscle)." },
  { q: "What nerve root is responsible for knee extension?", a: "<b>L3</b> (Quadriceps femoris muscle)." },
  { q: "Describe the Straight Leg Raise (SLR) test and its significance.", a: "Passive elevation of the patient's straight leg between <b>30° and 70°</b>. Reproduction of radicular pain (sciatica) below the knee suggests <b>L4-S1 nerve root compression</b> (herniated disc)." },
  { q: "What is the Crossed (Contralateral) Straight Leg Raise test, and what does it indicate?", a: "Passive elevation of the unaffected leg reproduces radicular pain in the affected leg. Highly specific (~90%) for a <b>herniated disc</b>, though less sensitive than the standard SLR." },
  { q: "At what vertebral level does the adult spinal cord end (conus medullaris)?", a: "At the <b>L1–L2</b> vertebral level. Below this, the spinal canal contains the cauda equina (nerve roots)." },
  { q: "Which cervical nerve root is tested by biceps flexion and the biceps reflex?", a: "<b>C5</b> (and C6). C5 primarily controls shoulder abduction (deltoid) and elbow flexion (biceps)." },
  { q: "Which cervical nerve root controls wrist extension and the brachioradialis reflex?", a: "<b>C6</b> (controls wrist extension and supplies sensation to the thumb/index finger)." },
  { q: "Which cervical nerve root controls triceps extension, wrist flexion, and the triceps reflex?", a: "<b>C7</b> (controls elbow extension and supplies sensation to the middle finger)." },
  { q: "Which cervical nerve root controls finger flexion (grip strength)?", a: "<b>C8</b> (supplies sensation to the ring and small fingers)." },
  { q: "Which cervical nerve root controls finger abduction/adduction (interossei)?", a: "<b>T1</b>." },

  // ===== HERNIATED DISC =====
  { q: "What is the pathophysiology of a herniated disc?", a: "Tear of the outer <b>annulus fibrosus</b> allows the gelatinous <b>nucleus pulposus</b> to herniate, compressing adjacent nerve roots." },
  { q: "What is the most common direction for a disc herniation, and why?", a: "<b>Posterolateral</b>, because the posterior longitudinal ligament (PLL) is thin in the midline and acts as a barrier, forcing the disc laterally." },
  { q: "A patient has posterolateral herniation at L4-L5. Which nerve root is typically compressed?", a: "The <b>L5 nerve root</b> (the traversing nerve root; in the lumbar spine, posterolateral herniations compress the traversing root, not the exiting root)." },
  { q: "A patient has posterolateral herniation at L5-S1. Which nerve root is compressed?", a: "The <b>S1 nerve root</b>." },
  { q: "What is the difference between a traversing and an exiting nerve root in lumbar herniations?", a: "• <b>Traversing root:</b> The root crossing the disc level to exit at the next lower level (compressed in posterolateral/paracentral herniations).<br>• <b>Exiting root:</b> The root exiting through the neural foramen at that level (compressed in far lateral herniations)." },
  { q: "What is the first-line treatment for an uncomplicated herniated lumbar disc?", a: "<b>Conservative therapy</b>: NSAIDs, physical therapy, activity modification, and reassurance. ~90% of cases resolve spontaneously within 6–8 weeks." },
  { q: "What are the indications for surgery (microdiscectomy) in a herniated disc?", a: "1. <b>Progressive motor deficit</b>.<br>2. <b>Cauda equina syndrome</b> (absolute indication).<br>3. Severe, debilitating pain refractory to at least 6 weeks of conservative therapy." },
  { q: "What is the most common level for a cervical disc herniation?", a: "<b>C5-C6</b> (compressing the C6 nerve root) and <b>C6-C7</b> (compressing the C7 nerve root)." },

  // ===== SPINAL STENOSIS =====
  { q: "What is the pathophysiology of spinal stenosis?", a: "Narrowing of the central spinal canal or neural foramina, most commonly caused by <b>ligamentum flavum hypertrophy</b>, facet joint osteophytes, and disc bulging." },
  { q: "What is the classic clinical presentation of lumbar spinal stenosis?", a: "<b>Neurogenic claudication</b>: bilateral buttock, thigh, or leg pain/heaviness precipitated by standing or walking and relieved by sitting or bending forward." },
  { q: "Explain the 'shopping cart sign' in lumbar spinal stenosis.", a: "Patients experience relief of symptoms when leaning forward (e.g., over a shopping cart) because flexion of the spine increases the cross-sectional area of the spinal canal." },
  { q: "Differentiate between neurogenic and vascular claudication.", a: "• <b>Neurogenic:</b> Relieved by sitting/spinal flexion; pulses present; shopping cart sign positive; pain is dermatomal.<br>• <b>Vascular:</b> Relieved by stopping walking (standing still); pulses diminished/absent; skin changes (atrophy, hair loss); pain is muscle-group specific." },
  { q: "What is the gold standard diagnostic imaging for spinal stenosis?", a: "<b>MRI of the lumbar spine</b> (shows narrowing of the central canal and sagittal diameter)." },
  { q: "What is the definitive surgical treatment for severe spinal stenosis?", a: "<b>Decompressive lumbar laminectomy</b> (removal of the lamina and ligamentum flavum to relieve pressure on the cauda equina)." },

  // ===== CAUDA EQUINA SYNDROME =====
  { q: "What is cauda equina syndrome?", a: "A surgical emergency caused by <b>massive central compression</b> of the lumbosacral nerve roots within the spinal canal." },
  { q: "What is the most common cause of cauda equina syndrome?", a: "A massive central <b>disc herniation</b> (typically at L4-L5 or L5-S1)." },
  { q: "List the classic signs and symptoms of cauda equina syndrome.", a: "1. <b>Saddle anesthesia</b> (sensory loss in perineum/perianal area).<br>2. <b>Bowel/bladder dysfunction</b> (urinary retention with overflow incontinence, fecal incontinence).<br>3. Bilateral sciatica.<br>4. Progressive lower extremity motor weakness (e.g., foot drop).<br>5. Loss of anal sphincter tone." },
  { q: "What is the most sensitive screening sign for cauda equina syndrome?", a: "<b>Urinary retention</b> (post-void residual volume >200 mL indicates neurogenic bladder)." },
  { q: "How is cauda equina syndrome diagnosed and managed?", a: "• <b>Diagnosis:</b> Emergent <b>MRI of the lumbar spine</b>.<br>• <b>Management:</b> Emergent surgical <b>decompression (laminectomy/discectomy)</b>, ideally within 24–48 hours of symptom onset to prevent permanent paralysis and incontinence." },

  // ===== SCOLIOSIS =====
  { q: "How is scoliosis defined on a standing full-length spine X-ray?", a: "A lateral curvature of the spine with a <b>Cobb angle $\\ge 10^\\circ$</b>." },
  { q: "How do you measure the Cobb angle?", a: "Identify the most tilted vertebrae at the top and bottom of the curve; draw lines parallel to their endplates; the angle of intersection of perpendiculars to these lines is the Cobb angle." },
  { q: "What is the Adam's forward bend test?", a: "A screening physical exam for scoliosis: the patient bends forward at the waist; the examiner looks for a <b>rib hump</b> (indicates rotational deformity of the thoracic spine)." },
  { q: "What device is used to measure trunk rotation during scoliosis screening?", a: "A <b>scoliometer</b>. A reading of <b>$\\ge 7^\\circ$</b> warrants referral for radiographic evaluation." },
  { q: "What is the Risser classification and why is it used in scoliosis?", a: "Grades the ossification of the <b>iliac apophysis</b> (Scale 0–5). Indicates skeletal maturity: Risser 0-2 indicates significant remaining growth (high risk of curve progression); Risser 4-5 indicates skeletal maturity." },
  { q: "State the treatment guidelines for adolescent idiopathic scoliosis (AIS) based on Cobb angle.", a: "• <b>Cobb angle <25°:</b> Observation (serial X-rays every 6 months).<br>• <b>Cobb angle 25–45°:</b> Bracing (in a growing child with Risser 0-2).<br>• <b>Cobb angle >45–50°:</b> Surgical evaluation (posterior spinal fusion)." },
  { q: "Does bracing correct the spinal curvature in scoliosis?", a: "No. Bracing only <b>stops the progression</b> of the curve; it does not correct the existing deformity." },

  // ===== SPONDYLOLYSIS & SPONDYLOLISTHESIS =====
  { q: "What is spondylolysis?", a: "A defect/stress fracture in the <b>pars interarticularis</b> of the vertebral arch (most commonly at <b>L5</b>)." },
  { q: "In what population is spondylolysis most commonly seen?", a: "Young athletes engaged in repetitive hyperextension of the spine (gymnasts, dancers, football linemen)." },
  { q: "What is the classic radiographic finding of spondylolysis on oblique X-rays?", a: "The <b>'Scotty dog' with a collar</b> sign (the collar represents the fracture/defect in the pars interarticularis)." },
  { q: "What is spondylolisthesis?", a: "The anterior slippage of one vertebra over the vertebra below it (most commonly L5 sliding over S1)." },
  { q: "How is spondylolisthesis classified?", a: "• <b>Isthmic:</b> Secondary to spondylolysis (pars defect).<br>• <b>Dysplastic:</b> Congenital malformation of facet joints.<br>• <b>Degenerative:</b> Due to facet arthropathy and disc degeneration (older patients)." },
  { q: "How is the severity of spondylolisthesis graded (Meyerding grading)?", a: "Based on percentage of slippage:<br>• <b>Grade I:</b> <25% slippage.<br>• <b>Grade II:</b> 25–50% slippage.<br>• <b>Grade III:</b> 50–75% slippage.<br>• <b>Grade IV:</b> 75–100% slippage.<br>• <b>Grade V:</b> >100% (Spondyloptosis)." },
  { q: "What is the first-line management for low-grade spondylolisthesis?", a: "Conservative treatment: core stabilization exercises (avoid hyporextension), NSAIDs, and temporary activity modification." },

  // ===== SPINAL INFECTIONS & PATHOLOGY =====
  { q: "What is the most common causative organism in hematogenous osteomyelitis of the spine?", a: "<b>Staphylococcus aureus</b>." },
  { q: "What is the classic presentation of spinal epidural abscess?", a: "A triad of: <b>fever, localized spinal back pain, and rapid progressive neurological deficits</b>. Most common in IV drug users and diabetics." },
  { q: "How is a suspected spinal epidural abscess diagnosed and treated?", a: "• <b>Diagnosis:</b> Emergent MRI of the spine with gadolinium.<br>• <b>Treatment:</b> Emergent surgical decompression/drainage and long-term IV antibiotics." },
  { q: "What is Pott's disease?", a: "Tuberculosis of the spine, typically presenting with hematogenous spread to the vertebral body leading to destruction, kyphosis (gibbus deformity), and cold abscess." },
  { q: "A patient with a history of prostate cancer presents with severe back pain. What is the immediate concern?", a: "<b>Metastatic spinal cord compression</b>. Requires emergent <b>intravenous corticosteroids (Dexamethasone)</b> to reduce cord edema, followed by urgent MRI and oncology/surgical consult." },
  { q: "What is the difference between spinal shock and neurogenic shock?", a: "• <b>Spinal shock:</b> Temporary loss of all spinal cord reflex activity below injury level (flaccid paralysis, areflexia). Resolves when bulbocavernosus reflex returns.<br>• <b>Neurogenic shock:</b> Hemodynamic collapse (hypotension + bradycardia) due to loss of sympathetic tone (occurs in T6 or higher injuries)." },
  { q: "Describe the three classic incomplete spinal cord injury syndromes.", a: "1. <b>Central Cord Syndrome:</b> Upper extremity weakness > lower extremity (typically from hyporextension in older patients with stenosis).<br>2. <b>Anterior Cord Syndrome:</b> Loss of motor, pain, and temperature; preservation of proprioception/vibration.<br>3. <b>Brown-Séquard Syndrome:</b> Ipsilateral motor and proprioception loss; contralateral pain and temperature loss." },
  { q: "What is the bulbocavernosus reflex, and why is it important?", a: "Squeezing the glans penis or pulling on a Foley catheter causes contraction of the anal sphincter (S2-S4). Its return marks the **end of spinal shock**." },
  { q: "What is neurogenic shock's hemodynamic profile?", a: "Loss of sympathetic tone leads to **vasodilation and bradycardia** (hypotension + bradycardia, skin is warm and dry)." },
  { q: "What is autonomic dysreflexia?", a: "A life-threatening condition in patients with spinal cord injuries at **T6 or above**, triggered by a noxious stimulus below the injury (e.g., distended bladder). Presents with severe hypertension, bradycardia, and flushing above the lesion." },
  { q: "How do you manage autonomic dysreflexia?", a: "1. Sit the patient upright (lowers BP).<br>2. Remove the offending stimulus (catheterize bladder, disimpact bowel).<br>3. Administer rapid-acting antihypertensives if BP remains critically high." },
  { q: "What is a cervical myelopathy?", a: "Spinal cord compression in the neck, presenting with upper extremity clumsiness, gait instability (Lhermitte's sign), hyperreflexia, and Hoffman's sign." },
  { q: "Explain the Lhermitte's sign.", a: "An electric shock-like sensation radiating down the spine or limbs upon flexion of the neck, indicating cervical spinal cord pathology/demyelination." },
  { q: "Explain the Hoffman's sign.", a: "Flicking the nail of the middle finger results in flexion of the thumb and index finger, indicating upper motor neuron disease (cervical myelopathy)." },
  { q: "What is the most common cause of cervical myelopathy?", a: "Cervical spondylotic myelopathy (degenerative narrowing of the cervical canal)." },
  { q: "Define spondylosis.", a: "Degenerative osteoarthritis of the spinal joints (facet arthropathy and osteophyte formation)." },
  { q: "Define spondylitis.", a: "Inflammation of the vertebrae (e.g., ankylosing spondylitis)." },
  { q: "What is Ankylosing Spondylitis (AS)?", a: "A chronic inflammatory seronegative arthropathy strongly associated with **HLA-B27**, presenting as morning back pain that improves with exercise, and **bamboo spine** on X-ray." },
  { q: "What is the primary risk of spine fractures in patients with Ankylosing Spondylitis?", a: "The spine is fused and brittle ('chalk stick' spine), making it highly susceptible to unstable fractures from even minor trauma." },
  { q: "What is the Schober test?", a: "A test used to measure lumbar spine flexion; a restriction in expansion (<5 cm increase when bending forward from a 10 cm marked interval) suggests **Ankylosing Spondylitis**." },
  { q: "What is a 'cold abscess' in tuberculosis of the spine?", a: "An abscess that lacks active signs of inflammation (warmth, erythema), typically tracking down the psoas muscle sheath." },
  { q: "What are the indications for surgical fusion in scoliosis?", a: "AIS with a Cobb angle **>45-50 degrees** in a skeletally immature or mature patient." },
  { q: "What is the most common level of the spine for spondylolisthesis?", a: "The **L5-S1** level (L5 slides forward on S1)." },
  { q: "Why is a far lateral disc herniation unique in the lumbar spine?", a: "It compresses the **exiting** nerve root at that level rather than the traversing root (e.g., L4-L5 far lateral herniation compresses L4, not L5)." },
  { q: "Describe the clinical presentation of an L3-L4 disc herniation.", a: "Compresses the **L4** nerve root: weakness in knee extension, sensory loss over the medial leg, and a diminished patellar reflex." },
  { q: "Describe the clinical presentation of an L4-L5 disc herniation.", a: "Compresses the **L5** nerve root: weakness in great toe extension (EHL) and sensory loss on the dorsum of the foot." },
  { q: "Describe the clinical presentation of an L5-S1 disc herniation.", a: "Compresses the **S1** nerve root: weakness in plantarflexion (gastrocnemius), sensory loss on the lateral foot, and a diminished Achilles reflex." },
  { q: "Which incomplete spinal cord injury syndrome has the best prognosis for recovery?", a: "**Brown-Séquard syndrome**." },
  { q: "Which incomplete spinal cord injury syndrome has the poorest prognosis?", a: "**Anterior cord syndrome** (due to vascular necrosis of the anterior spinal artery supply)." },
  { q: "What is the mechanism of injury for Central Cord Syndrome?", a: "Hyperextension of the neck in patients with pre-existing cervical spinal stenosis." },
  { q: "Why does Central Cord Syndrome affect the upper extremities more than the lower extremities?", a: "The somatotopic arrangement of the corticospinal tract has **cervical fibers located centrally** and sacral/lumbar fibers located peripherally." },
  { q: "What is the definitive diagnostic test for spondylolysis?", a: "A **CT scan** of the lumbar spine (shows the bony defect in the pars interarticularis most clearly)." },
  { q: "What is the most common cause of lumbar disc herniation?", a: "Repetitive flexion and rotational loading of the spine leading to degeneration of the annulus fibrosus." },
  { q: "What is the role of epidural steroid injections (ESI) in disc herniation?", a: "Provides temporary symptomatic relief of radicular pain (sciatica) by reducing inflammation around the compressed nerve root; does not cure the herniation." },
  { q: "How long does a typical lumbar microdiscectomy procedure take?", a: "Approximately 1–2 hours, performed as an outpatient procedure." },
  { q: "What is the most common complication of a lumbar laminectomy?", a: "Dural tear (CSF leak), nerve root injury, or post-laminectomy instability." },
  { q: "What is Scheuermann's disease?", a: "Juvenile kyphosis caused by wedge-shaped vertebral bodies, defined by **$\\ge 5^\\circ$ of anterior wedging** in 3 or more consecutive vertebrae." },
  { q: "What is the threshold for bracing in Scheuermann's kyphosis?", a: "Kyphosis between **$60^\\circ$ and $80^\\circ$** in a growing adolescent." },
  { q: "What is the definition of flatback syndrome?", a: "Loss of normal lumbar lordosis, often due to historical scoliosis instrumentation (Harrington rods), leading to a forward-leaning posture." },
  { q: "What is the role of the ligamentum flavum in spinal stenosis?", a: "Hypertrophy and buckling of the ligamentum flavum directly compress the posterior aspect of the dural sac." },
  { q: "What is the sensory distribution of the C5 nerve root?", a: "The lateral shoulder/arm." },
  { q: "What is the sensory distribution of the C6 nerve root?", a: "The lateral forearm, thumb, and index finger." },
  { q: "What is the sensory distribution of the C7 nerve root?", a: "The middle finger." },
  { q: "What is the sensory distribution of the C8 nerve root?", a: "The medial forearm, ring, and small fingers." },
  { q: "What is the sensory distribution of the T1 nerve root?", a: "The medial arm." },
  { q: "What muscle is tested to evaluate C5 motor function?", a: "The **deltoid** (shoulder abduction) and **biceps** (elbow flexion)." },
  { q: "What muscle is tested to evaluate C6 motor function?", a: "The **wrist extensors** (extensor carpi radialis longus/brevis)." },
  { q: "What muscle is tested to evaluate C7 motor function?", a: "The **triceps** (elbow extension) and wrist flexors." },
  { q: "What muscle is tested to evaluate C8 motor function?", a: "The **flexor digitorum profundus** (finger flexion/grip strength)." },
  { q: "What muscle is tested to evaluate T1 motor function?", a: "The **first dorsal interosseous** (finger abduction)." },
  { q: "What is the normal thoracic kyphosis range?", a: "**20° to 45°**." },
  { q: "What is the normal lumbar lordosis range?", a: "**40° to 60°**." },
  { q: "What is discitis?", a: "Infection of the intervertebral disc space, often presenting with severe back pain and elevated ESR/CRP in children." },
  { q: "How is discitis treated?", a: "Intravenous antibiotics targeted to the causative organism (usually S. aureus) and spinal immobilization." },
  { q: "What is the primary risk of spinal osteomyelitis?", a: "Vertebral collapse leading to kyphosis and spinal cord compression." }
          ]
        },
        {
          section: 'Orthopedics',
          topic: "Sports medicine & soft tissue injuries",
          icon: "activity",
          cards: [
            // ===== KNEE: ACL & PCL INJURIES =====
  { q: "What is the classic mechanism of injury for an anterior cruciate ligament (ACL) tear?", a: "A <b>non-contact pivoting</b> or deceleration injury on a planted foot, often associated with a 'pop' and rapid onset hemarthrosis." },
  { q: "What are the three physical exam tests used to diagnose an ACL tear, and which is the most sensitive?", a: "1. <b>Lachman test</b> (most sensitive and reliable; tests anterior translation of tibia at 20-30° flexion).<br>2. <b>Anterior Drawer test</b> (at 90° flexion).<br>3. <b>Pivot Shift test</b> (most specific; evaluates rotational instability)." },
  { q: "What is the gold standard imaging study to confirm an ACL tear?", a: "<b>MRI of the knee</b> (highly sensitive and specific; shows fiber discontinuity or bone bruising of lateral femoral condyle/tibial plateau)." },
  { q: "Differentiate between surgical and non-surgical candidates for ACL tears.", a: "• <b>Surgical (Reconstruction):</b> Young, active patients; those with rotational instability; or concurrent meniscus/ligament injuries.<br>• <b>Non-surgical:</b> Older, sedentary patients with stable knees and no lifestyle limitations (managed with physical therapy/bracing)." },
  { q: "What graft types are commonly used for ACL reconstruction?", a: "Autografts (patellar tendon/bone-patellar tendon-bone, hamstring tendon, quadriceps tendon) and allografts (cadaveric tissue)." },
  { q: "What is the classic mechanism of injury for a posterior cruciate ligament (PCL) tear?", a: "A direct blow to the anterior tibia of a flexed knee (<b>'dashboard injury'</b> in MVAs) or falling on a hyperflexed knee with the foot plantarflexed." },
  { q: "What physical exam signs indicate a PCL tear?", a: "1. <b>Posterior Drawer test</b> (increased posterior translation at 90° flexion).<br>2. <b>Posterior Sag sign (Godfrey's test)</b> (tibia sags posteriorly relative to femur when knees are flexed)." },
  { q: "What is the primary role of the PCL?", a: "It is the primary constraint to <b>posterior translation</b> of the tibia relative to the femur." },

  // ===== KNEE: COLLATERALS & MENISCUS =====
  { q: "What mechanism of injury causes a medial collateral ligament (MCL) tear, and what test is used to evaluate it?", a: "A <b>valgus stress</b> (blow to the lateral side of the knee). Evaluated using the <b>valgus stress test at 30° flexion</b> (isolates MCL) and 0° (checks for cruciate involvement)." },
  { q: "What mechanism of injury causes a lateral collateral ligament (LCL) tear, and what test is used to evaluate it?", a: "A <b>varus stress</b> (blow to the medial side of the knee). Evaluated using the <b>varus stress test at 30° flexion</b>." },
  { q: "How are MCL/LCL tears graded and managed?", a: "• <b>Grade I (mild):</b> Tender, no instability. Treat with RICE/hinged brace.<br>• <b>Grade II (moderate):</b> Partial tear with endpoint laxity. Treat with hinged brace.<br>• <b>Grade III (complete):</b> Laxity without endpoint. MCL is treated non-operatively; LCL often requires surgical repair due to association with posterolateral corner (PLC) injuries." },
  { q: "What is the typical presentation of a meniscus tear?", a: "Twisting injury on a weight-bearing knee followed by gradual swelling, joint line tenderness, and mechanical symptoms (<b>locking, catching, or giving way</b>)." },
  { q: "Name two physical exam maneuvers for meniscus tears.", a: "1. <b>McMurray test</b> (pain or click elicited during knee extension with internal/external rotation).<br>2. <b>Thessaly test</b> (patient stands on one leg flexed to 20° and twists; reproduces pain)." },
  { q: "Differentiate between the red zone and white zone of the meniscus regarding healing potential.", a: "• <b>Red zone (outer 1/3):</b> Vascularized; high healing potential (amenable to surgical repair).<br>• <b>White zone (inner 2/3):</b> Avascular; relies on synovial fluid; low healing potential (treated with partial meniscectomy)." },
  { q: "What is the 'O'Donoghue's Unhappy Triad'?", a: "A severe knee injury involving concurrent tears of the: 1. <b>ACL</b>, 2. <b>MCL</b>, and 3. <b>Medial Meniscus</b> (though lateral meniscus is actually more commonly torn acutely)." },

  // ===== SHOULDER: ROTATOR CUFF & IMPINGEMENT =====
  { q: "Name the four rotator cuff muscles and their primary functions.", a: "<b>SITS:</b><br>• <b>S</b>upraspinatus: Abduction (first 15°).<br>• <b>I</b>nfraspinatus: External rotation.<br>• <b>T</b>eres minor: External rotation.<br>• <b>S</b>ubscapularis: Internal rotation." },
  { q: "What test is used to isolate the supraspinatus muscle?", a: "The <b>Empty Can test (Jobe test)</b>: arms abducted to 90°, forward-flexed 30°, thumbs pointing down; resistance applied downward." },
  { q: "What test is used to isolate the subscapularis muscle?", a: "The <b>Lift-Off test</b> (patient places dorsum of hand on lower back and lifts it away against resistance)." },
  { q: "What is rotator cuff impingement syndrome?", a: "Compression of the rotator cuff tendons (primarily supraspinatus) and subacromial bursa beneath the acromion, causing pain with overhead activities." },
  { q: "Name two clinical tests for shoulder impingement.", a: "1. <b>Neer test</b> (passive forward flexion with forearm pronated reproduces pain).<br>2. <b>Hawkins-Kennedy test</b> (passive internal rotation of shoulder flexed to 90° reproduces pain)." },
  { q: "How do you clinically differentiate a rotator cuff tear from impingement?", a: "• <b>Impingement:</b> Pain with overhead activity, but strength is preserved.<br>• <b>Tear:</b> Weakness in abduction (supraspinatus) or external rotation; positive <b>Drop Arm test</b>." },
  { q: "What is the Drop Arm test?", a: "The patient's arm is passively abducted to 90°, and they are asked to lower it slowly; sudden dropping of the arm due to pain/weakness indicates a large <b>supraspinatus tear</b>." },

  // ===== SHOULDER INSTABILITY & FROZEN SHOULDER =====
  { q: "In what direction does the shoulder joint most commonly dislocate?", a: "<b>Anterior</b> (~95% of cases; caused by forced abduction, extension, and external rotation)." },
  { q: "What nerve is most commonly injured during an anterior shoulder dislocation?", a: "The <b>axillary nerve</b> (causes weakness in shoulder abduction and sensory loss over the lateral shoulder, 'regimental badge area')." },
  { q: "What test is used to evaluate anterior shoulder instability?", a: "The <b>Apprehension and Relocation test</b>: placing the arm in 90° abduction and external rotation causes apprehension (fear of dislocation); posterior force on the humerus relieves the apprehension." },
  { q: "What is adhesive capsulitis (frozen shoulder)?", a: "Progressive inflammatory fibrosing of the glenohumeral joint capsule, leading to severe pain and global loss of <b>active and passive range of motion</b>." },
  { q: "What are major risk factors for adhesive capsulitis?", a: "<b>Diabetes mellitus</b> (highest association, often bilateral/refractory) and <b>thyroid disorders</b> (hypothyroidism)." },
  { q: "What are the three phases of adhesive capsulitis, and what is the typical treatment?", a: "• <b>Phases:</b> Freezing (painful), Frozen (stiff), Thawing (gradual improvement).<br>• <b>Treatment:</b> Self-limiting; managed with physical therapy, NSAIDs, and intra-articular steroid injections. Manipulation under anesthesia is reserved for refractory cases." },

  // ===== ANKLE & FOOT INJURIES =====
  { q: "Which ligaments are most commonly injured in a lateral ankle sprain?", a: "1. <b>Anterior talofibular ligament (ATFL)</b> (most common; injured in inversion/plantarflexion).<br>2. <b>Calcaneofibular ligament (CFL)</b> (injured in severe inversion)." },
  { q: "What is a 'high ankle sprain' and how is it tested?", a: "An injury to the <b>distal tibiofibular syndesmosis</b>. Tested using the <b>Squeeze test</b> (squeezing calf reproduces pain at syndesmosis) and the External Rotation test." },
  { q: "What are the Ottawa Ankle Rules for obtaining radiographs?", a: "Ankle X-rays are indicated if there is pain in the malleolar zone AND:<br>1. Bone tenderness at the posterior edge/tip of the <b>lateral malleolus</b>.<br>2. Bone tenderness at the posterior edge/tip of the <b>medial malleolus</b>.<br>3. <b>Inability to bear weight</b> immediately and in the emergency department." },
  { q: "What are the Ottawa Foot Rules for obtaining radiographs?", a: "Foot X-rays are indicated if there is pain in the midfoot zone AND:<br>1. Bone tenderness at the <b>base of the 5th metatarsal</b>.<br>2. Bone tenderness at the <b>navicular bone</b>.<br>3. <b>Inability to bear weight</b> immediately and in the emergency department." },
  { q: "What is the classic clinical presentation of an Achilles tendon rupture?", a: "Sudden pain in the back of the ankle described as a 'pop' or feeling like being <b>kicked in the calf</b>, with inability to plantarflex." },
  { q: "What physical exam test confirms an Achilles tendon rupture?", a: "The <b>Thompson test</b>: squeezing the calf muscle fails to produce passive plantarflexion of the foot." },
  { q: "What is plantar fasciitis?", a: "Microtearing and degeneration of the plantar fascia insertion, presenting as heel pain that is <b>worst with the first steps in the morning</b> or after periods of rest." },

  // ===== ELBOW & WRIST SOFT TISSUE =====
  { q: "What is lateral epicondylitis (tennis elbow)?", a: "Overuse tendinopathy of the <b>common extensor tendon</b>, primarily the <b>extensor carpi radialis brevis (ECRB)</b>, presenting as pain over the lateral epicondyle." },
  { q: "What is medial epicondylitis (golfer's elbow)?", a: "Overuse tendinopathy of the <b>common flexor-pronator tendon</b> (pronator teres, flexor carpi radialis), presenting as pain over the medial epicondyle." },
  { q: "What is De Quervain's tenosynovitis?", a: "Stenosing tenosynovitis of the <b>first dorsal compartment</b> of the wrist, involving the <b>extensor pollicis brevis (EPB)</b> and <b>abductor pollicis longus (APL)</b>." },
  { q: "What physical exam test is used for De Quervain's tenosynovitis?", a: "The <b>Finkelstein test</b>: patient makes a fist with the thumb tucked inside the fingers; passive ulnar deviation of the wrist reproduces sharp pain along the radial styloid." },
  { q: "What is carpal tunnel syndrome?", a: "Compression of the <b>median nerve</b> as it passes through the carpal tunnel beneath the transverse carpal ligament." },
  { q: "What are the clinical signs of carpal tunnel syndrome?", a: "Paresthesias/numbness in the median nerve distribution (thumb, index, middle, and radial half of ring finger), worse at night; <b>thenar atrophy</b> in severe chronic cases." },
  { q: "Name two physical exam tests for carpal tunnel syndrome.", a: "1. <b>Tinel sign</b> (tapping over the median nerve at the wrist reproduces paresthesias).<br>2. <b>Phalen test</b> (flexing the wrists to 90° for 60 seconds reproduces paresthesias)." },
  { q: "What is the gold standard diagnostic test for carpal tunnel syndrome?", a: "<b>Electromyography (EMG) and Nerve Conduction Velocity (NCV)</b> studies (show prolonged sensory/motor latency across the wrist)." },

  // ===== ADDITIONAL SPORTS & SOFT TISSUE =====
  { q: "What is a 'turf toe'?", a: "Hyperextension injury of the <b>first metatarsophalangeal (MTP) joint</b>, damaging the plantar plate." },
  { q: "What is a SLAP tear in the shoulder?", a: "<b>S</b>uperior <b>L</b>abrum <b>A</b>nterior to <b>P</b>osterior tear, occurring at the attachment site of the long head of the biceps tendon." },
  { q: "What is the Apprehension test for patellar subluxation?", a: "Lateral force applied to the patella with the knee slightly flexed causes apprehension or muscle guarding, suggesting previous patellar dislocation." },
  { q: "What is the difference between a sprain and a strain?", a: "• <b>Sprain:</b> Stretching or tearing of <b>ligaments</b> (connects bone to bone).<br>• <b>Strain:</b> Stretching or tearing of <b>muscles/tendons</b> (connects muscle to bone)." },
  { q: "What is a ganglion cyst?", a: "A benign mucin-filled fluid sac adjacent to a joint capsule or tendon sheath, most commonly located on the dorsum of the wrist." },
  { q: "What is a Baker's cyst?", a: "A fluid-filled distension of the gastrocnemius-semimembranosus bursa in the popliteal fossa, often secondary to intra-articular knee pathology (e.g., meniscus tear, OA)." },
  { q: "What is the clinical significance of a ruptured Baker's cyst?", a: "It can mimic a **deep vein thrombosis (DVT)**, presenting with acute calf pain, swelling, and erythema (pseudothrombophlebitis)." },
  { q: "What is the treatment for a symptomatic ganglion cyst?", a: "Observation (many resolve spontaneously), aspiration, or surgical excision if causing pain or nerve compression." },
  { q: "What is the most common site of a clavicular osteolysis?", a: "The distal clavicle, often seen in weightlifters due to repetitive stress at the AC joint." },
  { q: "What is the mechanism of injury for a posterior shoulder dislocation?", a: "Forced internal rotation and adduction, commonly associated with **seizures** or **electrical shocks**." },
  { q: "What is a Bankart lesion?", a: "An avulsion of the anteroinferior glenoid labrum, highly associated with recurrent anterior shoulder dislocations." },
  { q: "What is a Hill-Sachs lesion?", a: "A compression fracture of the posterolateral humeral head caused by impaction against the anterior glenoid rim during dislocation." },
  { q: "What is the 'empty can' test evaluating?", a: "The integrity and strength of the **supraspinatus** tendon." },
  { q: "What is Lhermitte's sign?", a: "An electric shock-like sensation radiating down the spine or limbs upon flexion of the neck, indicating cervical cord pathology." },
  { q: "What is a Finkelstein test positive for?", a: "De Quervain's tenosynovitis." },
  { q: "What is a Thompson test positive for?", a: "Achilles tendon rupture." },
  { q: "What is a Lachman test positive for?", a: "ACL tear." },
  { q: "What is a McMurray test positive for?", a: "Meniscus tear." },
  { q: "What is a Phalen test positive for?", a: "Carpal tunnel syndrome." },
  { q: "What is the first-line treatment for mild lateral ankle sprain?", a: "RICE protocol (Rest, Ice, Compression, Elevation) and early weight-bearing in a support brace." },
  { q: "What are the tendons involved in De Quervain's tenosynovitis?", a: "The **abductor pollicis longus** (APL) and **extensor pollicis brevis** (EPB)." },
  { q: "What nerve is compressed in carpal tunnel syndrome?", a: "The **median nerve**." },
  { q: "What is a skier's thumb?", a: "An acute rupture of the ulnar collateral ligament of the thumb MCP joint, often caused by falling on an outstretched hand while holding a ski pole." },
  { q: "What is a Gamekeeper's thumb?", a: "A chronic stretching or insufficiency of the ulnar collateral ligament of the thumb MCP joint." },
  { q: "What is a Stener lesion?", a: "Interposition of the adductor aponeurosis between the ruptured ulnar collateral ligament and its insertion site, preventing healing and requiring surgery." },
  { q: "What is patellofemoral pain syndrome?", a: "Diffuse anterior knee pain, worst when climbing stairs or sitting for long periods ('theater sign'), common in young female runners." },
  { q: "What is osteochondritis dissecans?", a: "A localized joint injury where a segment of subchondral bone and articular cartilage separates from the underlying bone (most common in the medial femoral condyle)." },
  { q: "What is a shin splint (medial tibial stress syndrome)?", a: "Pain along the posteromedial border of the tibia, caused by repetitive traction of the tibialis posterior/soleus muscles." },
  { q: "What is the difference between shin splints and a tibial stress fracture?", a: "• **Shin splints:** Diffuse tenderness along the posteromedial border of the tibia.<br>• **Stress fracture:** Point tenderness on the anterior or medial tibial shaft." },
  { q: "What is a Lisfranc injury?", a: "Disruption of the tarsometatarsal joint complex, specifically the ligament connecting the medial cuneiform to the second metatarsal base." },

  // ===== NEW EXPANSION CARDS FOR SPORTS MEDICINE (100+ target) =====
  { q: "What is a 'jumper's knee'?", a: "Patellar tendinitis: inflammation of the patellar tendon due to repetitive eccentric loading (common in basketball/volleyball players)." },
  { q: "Compare patellar tendon rupture vs. quadriceps tendon rupture regarding patellar height.", a: "• **Patellar tendon rupture:** Patella is pulled superiorly by quadriceps (**patella alta**).<br>• **Quadriceps tendon rupture:** Patella is positioned inferiorly (**patella baja**)." },
  { q: "What is plica syndrome?", a: "Inflammation of the synovial plica (most commonly medial), causing catching, clicking, and pain with knee flexion, often mimicking a meniscus tear." },
  { q: "What is Iliotibial (IT) Band Syndrome?", a: "Friction of the IT band over the lateral femoral epicondyle, causing lateral knee pain in runners and cyclists; worse when the knee is flexed at ~30°." },
  { q: "What nerve is compressed in cubital tunnel syndrome?", a: "The **ulnar nerve** at the medial elbow (inside the cubital tunnel; causes paresthesias in the small/ring fingers)." },
  { q: "What is the main diagnostic test for ulnar nerve compression at the elbow?", a: "The **Elbow Flexion Test** (flexing the elbow fully with wrist extension for 3 minutes reproduces ulnar paresthesias)." },
  { q: "What is pronator syndrome?", a: "Compression of the median nerve in the proximal forearm between the two heads of the pronator teres muscle, presenting as forearm pain and paresthesias." },
  { q: "How do you clinically differentiate pronator syndrome from carpal tunnel syndrome?", a: "• **Pronator syndrome:** Pain over proximal forearm; sensory loss over the **thenar eminence** (spared in CTS because the palmar cutaneous branch passes superficial to the carpal tunnel); no nocturnal symptoms.<br>• **Carpal tunnel syndrome:** Nocturnal paresthesias; thenar muscle weakness/atrophy." },
  { q: "What nerve is compressed in radial tunnel syndrome?", a: "The **posterior interosseous nerve** (PIN) or deep branch of the radial nerve, presenting as lateral forearm pain that mimics lateral epicondylitis but without motor weakness." },
  { q: "What is a Triangular Fibrocartilage Complex (TFCC) tear?", a: "Injury to the primary stabilizer of the distal radioulnar joint (DRUJ), presenting as ulnar-sided wrist pain, clicking, and weakness with forearm rotation." },
  { q: "What test is used to evaluate TFCC pathology?", a: "The **TFCC Grind test** (axially loading and ulnarly deviating the wrist while rotating the forearm reproduces pain)." },
  { q: "What is a SLAP lesion Class I vs. Class II?", a: "• **Class I:** Fraying of the superior labrum with intact biceps anchor.<br>• **Class II:** Detachment of the superior labrum and the long head of the biceps anchor from the glenoid (most common type)." },
  { q: "What test is most sensitive for detecting a SLAP lesion?", a: "The **O'Brien active compression test** (deep shoulder pain with internal rotation/pronation that improves with external rotation/supination)." },
  { q: "What is the Speed test used for?", a: "To evaluate **biceps tendonitis** or labral pathology (shoulder flexed to 90° with forearm supinated; patient resists downward pressure)." },
  { q: "What is the Yergason test used for?", a: "To evaluate **biceps tendonitis** or instability of the long head of the biceps in the bicipital groove (resisted supination and external rotation of the shoulder)." },
  { q: "What is a 'Popeye deformity' of the arm?", a: "Rupture of the **long head of the biceps** tendon, causing the muscle belly to retract distally into a prominent bulge." },
  { q: "What is the first-line treatment for a rupture of the long head of the biceps?", a: "Conservative treatment (NSAIDs, PT) in most patients, as it causes minimal functional deficit. Tenodesis/surgery is reserved for young/athletic patients." },
  { q: "What is suprascapular nerve entrapment?", a: "Compression of the suprascapular nerve at the suprascapular notch (causes weakness/atrophy of supraspinatus and infraspinatus) or spinoglenoid notch (affects only infraspinatus)." },
  { q: "Differentiate between the causes of long thoracic and spinal accessory nerve injury in scapular winging.", a: "• **Long thoracic nerve:** Innervates **serratus anterior** (causes medial scapular winging; patient cannot push against wall).<br>• **Spinal accessory nerve:** Innervates **trapezius** (causes lateral scapular winging; shoulder droop)." },
  { q: "What is the Sulcus sign?", a: "A depression below the acromion when downward traction is applied to the arm, indicating **multidirectional shoulder instability**." },
  { q: "What is the Rockwood classification for AC joint separation?", a: "Grades I–VI based on the degree of clavicle displacement and injury to the acromioclavicular (AC) and coracoclavicular (CC) ligaments." },
  { q: "Which grades of AC joint separation are managed non-operatively?", a: "**Grades I and II** (treated with a sling for comfort and early rehab). Grade III is controversial; Grades IV–VI require surgery." },
  { q: "What is tarsal tunnel syndrome?", a: "Compression of the **tibial nerve** as it passes behind the medial malleolus beneath the flexor retinaculum." },
  { q: "What are symptoms of tarsal tunnel syndrome?", a: "Burning pain and paresthesias on the plantar surface of the foot, worse with walking; positive Tinel's sign behind the medial malleolus." },
  { q: "What is a Haglund deformity ('pump bump')?", a: "A bony enlargement on the back of the heel that irritates the Achilles tendon and retrocalcaneal bursa, often aggravated by stiff-backed shoes." },
  { q: "What is hallux valgus?", a: "A lateral deviation of the great toe at the MTP joint, leading to a prominent medial prominence (**bunion**)." },
  { q: "What is the normal hallux valgus angle (HVA)?", a: "**<15°**. An angle >15° indicates hallux valgus pathology." },
  { q: "What is the first-line treatment for hallux valgus?", a: "Wide-toebox shoes, orthotics, and bunion pads. Surgery is indicated only for persistent pain, not cosmetic reasons." },
  { q: "What is a 'claw hand' deformity and what nerve causes it?", a: "Compression/injury of the **ulnar nerve** (leads to hyperextension of MCP joints and flexion of PIP/DIP joints in the 4th/5th digits)." },
  { q: "What is a 'hand of benediction'?", a: "Active attempt to make a fist results in inability to flex the thumb, index, and middle fingers due to a proximal **median nerve** injury." },
  { q: "What is the mechanism of a radial nerve injury causing wrist drop?", a: "Midshaft humerus fracture or prolonged compression ('Saturday night palsy')." }
          ]
        },
        {
          section: 'Orthopedics',
          topic: "Joint replacements — indications & complications",
          icon: "bone",
          cards: [
            // ===== OSTEOARTHRITIS PATHOPHYSIOLOGY & DIAGNOSIS =====
  { q: "What are the four classic radiographic features of joint osteoarthritis?", a: "1. <b>Joint space narrowing</b> (asymmetrical).<br>2. <b>Subchondral sclerosis</b> (increased bone density under cartilage).<br>3. <b>Osteophytes</b> (bone spurs).<br>4. <b>Subchondral cysts</b>." },
  { q: "What is the primary pathological defect in osteoarthritis?", a: "Progressive loss and degeneration of <b>articular (hyaline) cartilage</b>, accompanied by subchondral bone remodeling and mild synovitis." },
  { q: "What are the first-line non-surgical treatments for hip or knee osteoarthritis?", a: "Weight loss, physical therapy (low-impact exercise, quadriceps strengthening), NSAIDs (oral or topical), and activity modification." },
  { q: "What is the role of intra-articular corticosteroid injections in osteoarthritis?", a: "Provides short-term (weeks to months) pain relief and inflammation reduction; does not alter disease progression or regenerate cartilage." },
  { q: "What is viscosupplementation in joint osteoarthritis?", a: "Intra-articular injection of <b>hyaluronic acid</b>, aimed at restoring joint lubrication. Clinical efficacy remains controversial." },
  { q: "What is the Kellgren-Lawrence (KL) grading system for osteoarthritis?", a: "Grades knee OA severity (Scale 0-4):<br>• <b>Grade 1:</b> Doubtful joint space narrowing, possible osteophytes.<br>• <b>Grade 2:</b> Definite osteophytes, possible narrowing.<br>• <b>Grade 3:</b> Moderate osteophytes, definite narrowing, sclerosis.<br>• <b>Grade 4:</b> Large osteophytes, severe narrowing, severe sclerosis, bone deformity." },
  { q: "Define Heberden and Bouchard nodes.", a: "• <b>Heberden nodes:</b> Osteophytes at the <b>DIP joints</b>.<br>• <b>Bouchard nodes:</b> Osteophytes at the <b>PIP joints</b> (associated with osteoarthritis)." },

  // ===== TOTAL HIP ARTHROPLASTY (THA) =====
  { q: "What are the primary indications for Total Hip Arthroplasty (THA)?", a: "1. End-stage <b>osteoarthritis</b> refractory to conservative treatment.<br>2. Severe <b>avascular necrosis</b> (AVN) of the femoral head.<br>3. Inflammatory arthropathies (rheumatoid arthritis).<br>4. Displaced femoral neck fractures in elderly patients." },
  { q: "What are the main components of a standard THA implant?", a: "• <b>Acetabular shell</b> (outer cup, fits in pelvis).<br>• <b>Acetabular liner</b> (polyethylene, ceramic, or metal).<br>• <b>Femoral stem</b> (fits into femoral canal).<br>• <b>Femoral head</b> (ceramic or metal sphere articulates with liner)." },
  { q: "Compare the anterior and posterior surgical approaches for THA regarding dislocation risk.", a: "• <b>Posterior approach:</b> Most common; cuts posterior capsule/piriformis; has a <b>higher dislocation risk</b> (requires posterior precautions).<br>• <b>Anterior approach:</b> Internervous plane (tensor fasciae latae and sartorius); preserves posterior soft tissues; has a <b>lower dislocation risk</b>." },
  { q: "What are the posterior hip precautions after a posterior-approach THA?", a: "Avoid: 1. <b>flexion >90°</b>, 2. <b>adduction</b> past midline, and 3. <b>internal rotation</b>. These precautions are typically maintained for 6–12 weeks." },
  { q: "What is the most common direction of dislocation after a posterior-approach THA?", a: "<b>Posterior dislocation</b> (occurs when the hip is flexed, adducted, and internally rotated)." },
  { q: "Describe the lateral (Hardinge) approach to the hip and its primary risk.", a: "• **Approach:** Splits the gluteus medius and minimus muscles.<br>• **Risk:** Damage to the **superior gluteal nerve**, leading to gluteus medius weakness and a postoperative **Trendelenburg gait** (limping)." },
  { q: "What nerve is at risk in the direct anterior approach to the hip?", a: "The **lateral femoral cutaneous nerve** (LFCN; leads to numbness or paresthesias over the anterolateral thigh, known as meralgia paresthetica)." },
  { q: "Compare cemented vs. press-fit (cementless) fixation in THA.", a: "• **Cementless:** Relies on initial tight fit (press-fit) and long-term **bony ingrowth** into a porous titanium surface (preferred in young, active patients).<br>• **Cemented:** Uses PMMA bone cement for immediate fixation (preferred in elderly patients with poor bone quality/osteoporosis)." },
  { q: "What are the advantages and disadvantages of ceramic-on-ceramic bearings in THA?", a: "• **Advantages:** Lowest wear rate of all bearing surfaces; highly scratch-resistant.<br>• **Disadvantages:** Brittle (risk of catastrophic ceramic fracture) and can cause an audible **squeaking** sound." },
  { q: "What is 'metal-on-metal' THA and why has its use declined?", a: "Uses a metal head and metal liner. Declined due to high wear rates causing **metallosis** (cobalt/chromium toxicity) and Adverse Local Tissue Reactions (ALTR/pseudotumors)." },

  // ===== TOTAL KNEE ARTHROPLASTY (TKA) =====
  { q: "What are the primary indications for Total Knee Arthroplasty (TKA)?", a: "Severe, debilitating pain from knee osteoarthritis, rheumatoid arthritis, or post-traumatic arthritis that has failed exhaustive non-surgical therapy." },
  { q: "What are the four components of a standard TKA implant?", a: "1. <b>Femoral component</b> (cobalt-chrome, covers distal femur).<br>2. <b>Tibial tray</b> (titanium, fits proximal tibia).<br>3. <b>Polyethylene insert</b> (acts as knee cartilage).<br>4. <b>Patellar button</b> (resurfaces the patella)." },
  { q: "Differentiate between Cruciate-Retaining (CR) and Cruciate-Substituting (CS) TKA designs.", a: "• <b>Cruciate-Retaining (CR):</b> Preserves the patient's posterior cruciate ligament (PCL).<br>• <b>Cruciate-Substituting (CS):</b> Sacrifices the PCL and uses a polyethylene post-and-cam mechanism ('posterior-stabilized') to prevent posterior subluxation." },
  { q: "What is the alignment goal in a standard TKA?", a: "To restore a neutral mechanical axis of the lower limb (a straight line from the center of the femoral head to the center of the ankle joint, passing through the center of the knee)." },
  { q: "What is the difference between a varus and valgus knee deformity?", a: "• **Varus (bow-legged):** Medial joint compartment wear (axis shifts medially).<br>• **Valgus (knock-kneed):** Lateral joint compartment wear (axis shifts laterally)." },
  { q: "What is arthrofibrosis after TKA and how is it managed?", a: "Severe postoperative stiffness/scarring restricting knee range of motion. Treated with **Manipulation Under Anesthesia (MUA)** if it occurs within 6–12 weeks of surgery." },
  { q: "What is patellar maltracking in TKA?", a: "The patella shifts laterally out of the femoral trochlear groove during knee flexion, causing pain and polyethylene wear. Often prevented by checking the 'no-thumb test' intraoperatively." },

  // ===== PERIPROSTHETIC JOINT INFECTION (PJI) =====
  { q: "Define acute/early vs. chronic/late Periprosthetic Joint Infection (PJI) based on timing.", a: "• <b>Acute/Early:</b> Occurs within <b>3 weeks</b> of surgery (or within 3 weeks of hematogenous symptoms).<br>• <b>Chronic/Late:</b> Occurs <b>>3 weeks</b> after surgery." },
  { q: "What are the most common causative organisms in PJI?", a: "• <b>Staphylococcus aureus</b> (common in acute infections).<br>• <b>Staphylococcus epidermidis</b> (coagulase-negative Staph; common in indolent, chronic infections).<br>• <b>Cutibacterium acnes</b> (common in shoulder arthroplasty)." },
  { q: "What synovial fluid thresholds are used to diagnose a chronic TKA/THA infection?", a: "Synovial fluid <b>WBC count >3,000 cells/mm³</b> (or >3,000) and <b>polymorphonuclear (PMN) percentage >70-80%</b>. (These limits are much lower than the 50,000 threshold for native joint septic arthritis)." },
  { q: "Name two serum inflammatory markers used in the workup of a suspected PJI.", a: "<b>Erythrocyte Sedimentation Rate (ESR)</b> and <b>C-reactive protein (CRP)</b>. High sensitivity makes them excellent initial screening tests." },
  { q: "Explain the 'DAIR' procedure for PJI and when it is indicated.", a: "<b>D</b>ebridement, <b>A</b>ntibiotics, and <b>I</b>mplant <b>R</b>etention. Indicated in <b>acute/early infections (<3 weeks)</b> with a stable implant, patent soft tissues, and susceptible organisms." },
  { q: "What is the difference between one-stage and two-stage exchange arthroplasty for chronic PJI?", a: "• <b>One-stage:</b> Implant removed, aggressive debridement, and new implant placed in same surgery (more common in Europe).<br>• <b>Two-stage (gold standard in US):</b> Implant removed, antibiotic-laden cement spacer placed, 6 weeks of IV antibiotics, then revision arthroplasty once markers normalize." },
  { q: "What are the Musculoskeletal Infection Society (MSIS) major criteria for PJI?", a: "1. Two positive periprosthetic cultures of the same organism.<br>2. A sinus tract communicating with the joint." },
  { q: "What is the role of an antibiotic-loaded cement spacer in a two-stage revision?", a: "Elutes high concentrations of local antibiotics (vancomycin/tobramycin) into the joint space, maintains leg length, and preserves joint motion." },

  // ===== MECHANICAL COMPLICATIONS =====
  { q: "What is aseptic loosening in joint replacements?", a: "Failure of implant fixation to the host bone in the <b>absence of infection</b>, typically driven by osteolysis." },
  { q: "What is the pathophysiology of osteolysis around joint replacements?", a: "Repetitive motion creates microscopic <b>polyethylene wear particles</b>. Macrophages phagocytose these particles, triggering an inflammatory cascade that recruits osteoclasts, leading to bone resorption." },
  { q: "How is a periprosthetic femur fracture classified around a THA?", a: "Using the <b>Vancouver classification</b>:<br>• <b>Type A:</b> Trochanteric region (stable).<br>• <b>Type B:</b> Around or just distal to the stem (B1: stem stable, ORIF; B2: stem loose, revision; B3: poor bone stock, revision + graft).<br>• <b>Type C:</b> Well distal to the stem (treat with ORIF)." },
  { q: "How do you treat a Vancouver Type B2 fracture?", a: "Requires <b>revision arthroplasty</b> using a longer, distal-fixing femoral stem, because the primary femoral stem has loosened." },
  { q: "What is polyethylene wear and its radiographic sign?", a: "Degradation of the plastic liner over time. Elicited as **eccentric positioning** of the femoral head in the acetabular cup on X-ray." },

  // ===== SYSTEMIC & MEDICAL COMPLICATIONS =====
  { q: "Why are joint replacements high risk for venous thromboembolism (VTE)?", a: "Orthopedic surgery activates all parts of Virchow's triad: endothelial damage (bone preparation), venous stasis (tourniquet/immobility), and hypercoagulability (systemic trauma response)." },
  { q: "What is the AAOS recommended VTE prophylaxis after TKA/THA?", a: "Options include **low-dose Aspirin** (81–325 mg twice daily) for low-risk patients, or **LMWH (Lovenox)** or **DOACs (Xarelto)** for high-risk patients, typically for 14–35 days." },
  { q: "What nerve is most commonly at risk during a standard THA?", a: "The **sciatic nerve** (especially during posterior retraction or limb lengthening). Presents with foot drop." },
  { q: "What nerve is most commonly at risk during a TKA?", a: "The **common peroneal nerve** (often secondary to correcting a severe valgus deformity, which stretches the nerve). Presents with foot drop." },
  { q: "What is a 'metal-on-metal' THA complication?", a: "Adverse Local Tissue Reaction (ALTR) or **pseudotumor** formation caused by cobalt and chromium wear debris, leading to tissue necrosis." },
  { q: "What is the primary indicator that a patient needs TKA/THA revision surgery?", a: "Progressive osteolysis, implant loosening, instability, or chronic pain." },
  { q: "What is the most common reason for early (<2 years) TKA revision?", a: "**Infection** or **instability/malalignment**." },
  { q: "What is the most common reason for late (>2 years) THA revision?", a: "**Aseptic loosening** due to polyethylene wear and osteolysis." },
  { q: "How is aseptic loosening identified on X-ray?", a: "Progressive **radiolucent lines** (>2 mm wide) at the bone-cement or bone-implant interface, or implant migration." },
  { q: "What is osteonecrosis (avascular necrosis) of the femoral head?", a: "Death of bone marrow and trabeculae due to interrupted blood supply, leading to subchondral fracture and **crescent sign** on X-ray." },
  { q: "What is the crescent sign on a hip X-ray?", a: "A radiolucent subchondral line indicating a subchondral fracture in **avascular necrosis** of the femoral head." },
  { q: "What is the Ficat classification used for?", a: "Classifies stages of **avascular necrosis** of the femoral head (Stages I-IV from normal X-ray to secondary osteoarthritis)." },
  { q: "What is the treatment for early-stage (Ficat I-II) avascular necrosis of the hip?", a: "**Core decompression** (drilling a hole in the femoral neck/head to decrease pressure and stimulate revascularization)." },
  { q: "What is the treatment for late-stage (Ficat III-IV) avascular necrosis of the hip?", a: "**Total Hip Arthroplasty**." },
  { q: "What are the risk factors for avascular necrosis?", a: "Chronic corticosteroid use, alcohol abuse, trauma, sickle cell disease, lupus, and radiation." },
  { q: "Define the Vancouver Type B1 fracture.", a: "A periprosthetic femur fracture around a stable stem. Treated with **ORIF** (open reduction internal fixation)." },
  { q: "Define the Vancouver Type B3 fracture.", a: "A periprosthetic femur fracture around a loose stem with poor bone stock. Treated with **revision arthroplasty** using a tumor prosthesis or proximal femoral replacement." },
  { q: "What is patellar clunk syndrome?", a: "A complication after posterior-stabilized TKA where a fibrous nodule forms on the posterior patellar tendon, catching in the femoral box during extension." },
  { q: "How is patellar clunk syndrome treated?", a: "Arthroscopic debridement of the fibrous nodule." },
  { q: "Why is a femoral component cementless THA preferred in young patients?", a: "It allows for **bony ingrowth** into a porous titanium surface, providing more durable, lifelong biological fixation." },

  // ===== ADDITIONAL EXPANSION CARDS (100+ target) =====
  { q: "What is the bone cement implantation syndrome (BCIS)?", a: "A rare but life-threatening complication during cemented arthroplasty (most commonly THA) characterized by hypoxia, hypotension, and cardiac arrest immediately after bone cement injection." },
  { q: "What is the cause of BCIS?", a: "High intramedullary pressure during cement insertion forces monomer, fat, and air emboli into the venous circulation, leading to pulmonary microembolization." },
  { q: "How is BCIS prevented or managed?", a: "• **Prevention:** Thorough canal lavage, retrograde cement injection, and avoiding cement in high-risk patients.<br>• **Management:** 100% oxygen, IV fluids, and vasopressors." },
  { q: "What is synovial fluid alpha-defensin testing?", a: "A highly sensitive and specific biomarker test for **PJI**; detects a peptide released by neutrophils in response to intra-articular pathogens." },
  { q: "What is the leukocyte esterase colorimetric strip test in PJI?", a: "A rapid, low-cost bedside test that uses urine dipstick strips to detect **leukocyte esterase** in synovial fluid, indicating joint infection." },
  { q: "What is the definition of a 'holiday period' in two-stage revision for PJI?", a: "A **6-week period** after finishing a course of IV antibiotics, during which the patient is off all antibiotics before joint fluid aspiration and ESR/CRP checks to ensure the infection is completely cleared." },
  { q: "What are the criteria to proceed with reimplantation in a two-stage revision?", a: "1. Normal clinical exam (no erythema, drainage, or pain).<br>2. Normalized or down-trending ESR and CRP.<br>3. Negative synovial fluid culture after the antibiotic holiday." },
  { q: "What is the 'no-thumb test' in TKA?", a: "A test used to check **patellar tracking**: the knee is flexed and extended without holding the patella; if it tracks centrally in the trochlea without subluxing, tracking is acceptable." },
  { q: "How does a regional Adductor Canal Block (ACB) help after TKA?", a: "It blocks the **saphenous nerve** (sensory only), providing excellent pain relief to the anterior knee while sparing quadriceps motor function, allowing for early ambulation." },
  { q: "What is the difference between a total hip arthroplasty (THA) and a hemiarthroplasty?", a: "• **THA:** Replaces both the acetabulum (pelvic cup) and the femoral head.<br>• **Hemiarthroplasty:** Replaces only the femoral head (commonly done for displaced femoral neck fractures in elderly patients with low baseline mobility)." },
  { q: "What is a bipolar hemiarthroplasty?", a: "A hemiarthroplasty where the femoral head component has two joints of motion: one between the prosthetic head and the native acetabulum, and one within the prosthesis itself, to reduce acetabular wear." },
  { q: "What is a unicompartmental knee arthroplasty (UKA)?", a: "A partial knee replacement that resurfaces only one compartment of the knee (usually the medial compartment), preserving the ACL, PCL, and lateral/patellofemoral compartments." },
  { q: "What are the indications for UKA?", a: "Uncompartmental osteoarthritis, intact ACL and PCL, stable collateral ligaments, no fixed varus/valgus deformity, and age >50-60." },
  { q: "What is a Charcot arthropathy of the knee?", a: "A neuropathic joint characterized by rapid bone destruction, joint laxity, and deformity due to sensory loss (e.g., from syphilis or diabetes); a contraindication to standard TKA." },
  { q: "What is the primary vascular risk during posterior capsule incision in THA?", a: "Laceration of the **sciatic nerve** or branches of the medial femoral circumflex artery." },
  { q: "What is the primary indicator of a patellar tendon rupture post-TKA?", a: "Inability to actively extend the knee (loss of the extensor mechanism) and a superiorly displaced patella on X-ray." },
  { q: "How is a post-TKA extensor mechanism rupture treated?", a: "Surgical repair, often requiring tendon reconstruction with allograft or synthetic mesh." },
  { q: "Why is a femoral nerve block less preferred than an adductor canal block for post-TKA analgesia?", a: "Because a femoral nerve block causes **quadriceps motor weakness**, increasing the risk of postoperative falls and delaying physical therapy." },
  { q: "What is a fascia iliaca block?", a: "A regional nerve block targeting the femoral and lateral femoral cutaneous nerves, commonly used for preoperative pain control in hip/femur fractures." },
  { q: "What is the clinical presentation of aseptic loosening of a TKA tibial component?", a: "Pain with weight-bearing, startup pain (worse with first steps), and progressive varus or valgus deformity." },
  { q: "How do you diagnose aseptic loosening of a cemented tibial component?", a: "X-ray showing a **radiolucent line >2 mm** at the cement-bone interface, or tilt/subsidence of the tibial tray." },
  { q: "What is the role of polymethylmethacrylate (PMMA) in cemented joints?", a: "It acts as a **grout** (not an adhesive) to fill the space between the implant and bone, distributing load evenly." },
  { q: "What is the primary antibiotic loaded into bone cement for PJI prophylaxis?", a: "**Tobramycin** or **Vancomycin** (thermostable powder antibiotics)." },
  { q: "Why must antibiotics loaded into bone cement be thermostable?", a: "Because the polymerization reaction of PMMA is highly **exothermic** (reaches temperatures >70-80°C), which would denature non-thermostable drugs." },
  { q: "What is a custom-made tumor prosthesis?", a: "A large segmental joint replacement used to rebuild a joint and bone shaft after a massive resection for a malignant bone tumor." },
  { q: "What is the definition of implant 'subsidence'?", a: "The sinking or settling of a femoral stem or tibial component into the host bone over time, indicating mechanical failure." },
  { q: "What is the difference between a primary and a revision arthroplasty?", a: "• **Primary:** The first joint replacement surgery.<br>• **Revision:** A repeat surgery to replace a failed, loose, or infected joint prosthesis." },
  { q: "What is the average lifespan of a modern TKA/THA?", a: "Approximately **15 to 20 years** in >90% of patients." },
  { q: "Define joint arthrodesis.", a: "Surgical fusion of a joint, rendering it immobile; occasionally used as a salvage procedure for failed, chronically infected joint replacements." },
  { q: "What is a synovial biopsy used for in PJI workup?", a: "Histological analysis of the synovium; finding **>5 PMNs per high-power field** in multiple fields is highly indicative of active infection." },
  { q: "What is the role of CRP in monitoring post-joint replacement healing?", a: "CRP peaks around day 2–3 postop and should return to normal (<10 mg/L) by **3 weeks**; persistent elevation suggests infection." },
  { q: "What is the role of ESR in monitoring post-joint replacement healing?", a: "ESR peaks around day 5–6 postop and can take **3–6 months** to return to baseline; less useful for acute PJI monitoring than CRP." },
  { q: "What is the definition of a 'dry joint' during PJI workup?", a: "An unsuccessful joint aspiration where no fluid is obtained; requires saline injection and re-aspiration (saline lavage) or repeat attempt." },
  { q: "What is the primary symptom of a peroneal nerve injury post-TKA?", a: "**Foot drop** and numbness over the dorsum of the foot and first web space." },
  { q: "What is the primary treatment for a postoperative peroneal nerve palsy?", a: "Remove any tight dressings, place the knee in slight flexion, apply an **ankle-foot orthosis (AFO)**, and obtain an EMG if no recovery at 6 weeks." },
  { q: "What is the definition of meralgia paresthetica?", a: "Entrapment of the lateral femoral cutaneous nerve, presenting as burning pain/numbness on the anterolateral thigh." },
  { q: "What is the primary risk of a metal-on-polyethylene bearing couple?", a: "**Polyethylene wear** leading to osteolysis and aseptic loosening." },
  { q: "What is the primary benefit of highly cross-linked polyethylene (HXLPE)?", a: "Significantly reduces the rate of polyethylene wear and subsequent osteolysis compared to standard ultra-high molecular weight polyethylene." },
  { q: "What is the primary risk of a ceramic-on-polyethylene bearing couple?", a: "Very low wear rates, but slightly higher cost than metal-on-polyethylene." },
  { q: "What is the primary risk of a ceramic-on-ceramic bearing couple?", a: "Catastrophic fracture of the ceramic components (rare with modern materials) and audible squeaking." },
  { q: "Define joint subluxation.", a: "Partial dislocation of a joint, where the articular surfaces remain in contact but are malaligned." },
  { q: "Define joint dislocation.", a: "Complete separation of the articular surfaces of a joint." },
  { q: "What is a 'cold' joint replacement?", a: "A term occasionally used to refer to a joint replacement that is **not infected** (sterile)." },
  { q: "What is the role of preoperative chlorhexidine wipes before joint replacement?", a: "To reduce skin colonization of Staph species and lower the risk of surgical site infections." },
  { q: "What is the primary benefit of a cementless press-fit TKA?", a: "Avoids cement degradation over time, but requires excellent bone quality for initial stability." },
  { q: "What is the primary indicator of aseptic loosening of a THA femoral stem?", a: "Pain in the mid-thigh during weight-bearing or startup." },
  { q: "What is the treatment for a symptomatic Vancouver Type C femur fracture?", a: "**ORIF** with a plate and screws, leaving the stable THA stem untouched." },
  { q: "What is the treatment for a symptomatic Vancouver Type A femur fracture?", a: "Usually non-operative (protected weight-bearing) unless the trochanteric fragment is highly displaced." },
  { q: "What is the role of joint mobilization on post-op day 1?", a: "To prevent VTE, reduce stiffness, decrease length of hospital stay, and improve long-term range of motion." },
  { q: "What is the primary symptom of an infected joint replacement?", a: "Persistent, progressive pain (both at rest and with activity), joint swelling, warmth, and erythema." },
  { q: "What is the definition of 'startup' pain?", a: "Pain that is worst when first standing up or starting to walk, which improves after a few steps; classic for aseptic loosening." }
          ]
        },
        {
          section: 'Orthopedics',
          topic: "Bone & soft tissue tumors",
          icon: "activity",
          cards: [
            // ===== EVALUATION OF BONE LESIONS =====
  { q: "What is the most important clinical variable when evaluating a suspected bone tumor?", a: "The <b>age of the patient</b>. Most bone tumors have very specific age ranges of occurrence (e.g., Ewing sarcoma in children; osteosarcoma in teens; metastasis/myeloma in adults >50)." },
  { q: "Describe geographic, moth-eaten, and permeative patterns of bone destruction.", a: "• <b>Geographic:</b> Well-defined border, slow-growing (benign).<br>• <b>Moth-eaten:</b> Multiple intermediate-sized holes (aggressive/malignant).<br>• <b>Permeative:</b> Ill-defined, tiny, widespread holes (highly aggressive/malignant)." },
  { q: "What are periosteal reactions, and what do they indicate?", a: "The periosteum's response to an underlying process. Benign processes show thick, solid reactions. Aggressive/malignant processes show: 1. <b>Codman's triangle</b> (elevation of periosteum), 2. <b>Sunburst pattern</b>, or 3. <b>Onion-skinning</b>." },
  { q: "What is Codman's triangle?", a: "A triangular area of new subperiosteal bone created when a rapidly growing tumor lifts the periosteum away from the bone cortex." },
  { q: "What is the primary biopsy rule for a suspected extremity sarcoma?", a: "Biopsy must be **longitudinal** (in line with the final incision) and planned in consultation with the surgeon who will perform the resection. Transverse biopsies are contraindicated because they contaminate adjacent compartments, preventing limb salvage." },
  { q: "Why must the biopsy tract be excised during definitive sarcoma surgery?", a: "Because tumor cells contaminate the biopsy tract; failure to excise the tract leads to a high rate of **local recurrence**." },

  // ===== BENIGN BONE TUMORS =====
  { q: "What is the classic clinical presentation of an osteoid osteoma?", a: "Dull, aching bone pain that is **worse at night** and **exquisitely relieved by aspirin or NSAIDs**." },
  { q: "Describe the classic radiographic appearance of an osteoid osteoma.", a: "A radiolucent **nidus <2 cm** in diameter, surrounded by a dense zone of reactive sclerotic bone (most commonly in the cortex of the femur or tibia)." },
  { q: "How does osteoblastoma differ from osteoid osteoma?", a: "• **Size:** Nidus is **>2 cm**.<br>• **Location:** Predilection for the posterior elements of the spine.<br>• **Pain:** Not worse at night, not relieved by aspirin." },
  { q: "What is the most common benign bone tumor, and what is its structure?", a: "An **osteochondroma**. A bony projection (stalk) arising from the cortex of a long bone (near the physis), capped with cartilage." },
  { q: "What is the risk of malignant transformation of an osteochondroma?", a: "Very low (<1% in solitary lesions; up to 5–10% in patients with Hereditary Multiple Exostoses). Converts to chondrosarcoma." },
  { q: "What is the classic age and location for Giant Cell Tumor (GCT) of bone?", a: "• **Age:** 20–40 years old (skeletally mature).<br>• **Location:** **Epiphysis** of long bones (distal femur/proximal tibia, crosses the growth plate)." },
  { q: "Describe the radiographic appearance of a Giant Cell Tumor of bone.", a: "A lytic, eccentric, expansile **'soap-bubble' lesion** extending directly to the subchondral bone plate." },
  { q: "What is the histology and treatment of Giant Cell Tumor?", a: "• **Histology:** Abundant multinucleated giant cells in a mononuclear stromal background.<br>• **Treatment:** Thorough curettage and filling the cavity with bone cement (polymethylmethacrylate; locally aggressive with high recurrence)." },
  { q: "Differentiate between a Unicameral Bone Cyst (UBC) and an Aneurysmal Bone Cyst (ABC).", a: "• **UBC:** Simple fluid-filled cyst; central location in metaphysis; 'fallen leaf' sign on fracture.<br>• **ABC:** Expansile, eccentric, blood-filled cyst; **fluid-fluid levels on MRI**; translocation t(16;17)." },
  { q: "What is a Non-Ossifying Fibroma (NOF)?", a: "A common, benign fibrous lesion in children, presenting as an eccentric, lobulated lytic lesion with a sclerotic border in the metaphysis; usually asymptomatic and resolves spontaneously." },

  // ===== MALIGNANT BONE TUMORS =====
  { q: "What is the most common primary malignant bone tumor in children and adolescents?", a: "An **osteosarcoma**." },
  { q: "What is the age distribution of osteosarcoma?", a: "Bimodal: First peak in **teens/adolescence** (during growth spurts); second peak in **adults >60** (associated with Paget's disease, prior radiation, or bone infarcts)." },
  { q: "Where does osteosarcoma most commonly arise?", a: "In the **metaphysis** of long bones, most commonly around the knee (~50%: distal femur or proximal tibia)." },
  { q: "What are the key radiographic features of an osteosarcoma?", a: "A destructive, mixed lytic and blastic lesion in the metaphysis, producing osteoid, with **sunburst periosteal reaction** and/or **Codman's triangle**." },
  { q: "What is the standard treatment protocol for osteosarcoma?", a: "**Neoadjuvant chemotherapy** (before surgery) followed by **wide local resection (limb salvage)**, and then **adjuvant chemotherapy**." },
  { q: "What translocation is diagnostic for Ewing sarcoma?", a: "**t(11;22)**, which fuses the EWS gene on chromosome 22 to the FLI1 gene on chromosome 11." },
  { q: "What is the classic age, location, and radiographic appearance of Ewing sarcoma?", a: "• **Age:** 5–20 years old.<br>• **Location:** **Diaphysis** of long bones (femur) or pelvis.<br>• **Radiographs:** **'Onion-skinning'** (multilaminated periosteal reaction)." },
  { q: "Describe the histology of Ewing sarcoma.", a: "Sheets of **small, round, blue cells** that stain positive for PAS (contains glycogen) and CD99." },
  { q: "Why is Ewing sarcoma often misdiagnosed as osteomyelitis?", a: "It presents with systemic symptoms (fever, weight loss, leukocytosis, elevated ESR) and a local painful bone lesion, mimicking a bone infection." },
  { q: "What is a chondrosarcoma and its classic radiographic finding?", a: "A malignant tumor producing cartilage, occurring in adults >40. Radiographs show a lobulated lesion with **'rings-and-arcs' or 'popcorn' calcifications**." },
  { q: "Why is surgical resection the primary treatment for chondrosarcoma?", a: "Because chondrosarcomas are **resistant to chemotherapy and radiation**." },

  // ===== METASTATIC BONE DISEASE =====
  { q: "What are the most common malignant bone tumors overall?", a: "<b>Bone metastases</b> (metastatic disease is far more common than primary bone sarcomas)." },
  { q: "Which primary cancers are most likely to metastasize to bone (mnemonic PB-KTL)?", a: "• <b>Prostate</b>.<br>• <b>Breast</b>.<br>• <b>Kidney</b> (Renal).<br>• <b>Thyroid</b>.<br>• <b>Lung</b>." },
  { q: "Differentiate between osteolytic and osteoblastic metastases.", a: "• <b>Osteoblastic (bone-forming):</b> Most common in <b>prostate cancer</b> (appears sclerotic/white).<br>• <b>Osteolytic (bone-destroying):</b> Common in <b>renal cell, thyroid, and lung cancer</b> (appears radiolucent/dark).<br>• <b>Mixed:</b> Common in <b>breast cancer</b>." },
  { q: "What is the Mirels' scoring system used for?", a: "To predict the risk of a <b>pathologic fracture</b> in a bone lesion and determine if prophylactic stabilization/surgery is needed (score $\\ge 9$ indicates high fracture risk and warrants surgery)." },
  { q: "What are the components of the Mirels' score?", a: "Based on four parameters (scored 1–3 each): 1. Location (upper vs lower limb vs trochanteric), 2. Pain (mild vs moderate vs functional), 3. Lesion type (blastic vs mixed vs lytic), and 4. Size of lesion (<1/3 vs 1/3-2/3 vs >2/3 cortical width)." },
  { q: "What is hypercalcemia of malignancy?", a: "A medical emergency caused by tumor secretion of **PTHrP** (parathyroid hormone-related peptide) or direct osteolysis, causing bone resorption. Treat with IV fluids (normal saline) and bisphosphonates (zoledronic acid)." },

  // ===== SOFT TISSUE TUMORS =====
  { q: "What is the most common benign soft tissue tumor?", a: "A **lipoma** (composed of mature adipocytes, appears bright on T1 and dark on fat-suppression MRI)." },
  { q: "What is a liposarcoma, and what is its histological hallmark?", a: "A malignant soft tissue tumor composed of lipoblasts. The hallmark is the **lipoblast** (shows a vacuolated cytoplasm indenting the nucleus)." },
  { q: "What is the classic translocation of synovial sarcoma?", a: "**t(X;18)** (fuses SYT to SSX1 or SSX2). Most commonly occurs in the lower extremity near joints of young adults." },
  { q: "What is Undifferentiated Pleomorphic Sarcoma (UPS)?", a: "The most common soft tissue sarcoma in older adults, characterized by highly atypical, pleomorphic cells without a specific line of differentiation." },
  { q: "Define a 'skip metastasis' in musculoskeletal oncology.", a: "A second, separate tumor focus within the same bone or muscle compartment as the primary tumor, which must be excised with the primary lesion." },

  // ===== NEW EXPANSION CARDS (100+ target) =====
  { q: "What is fibrous dysplasia of bone?", a: "A benign bone condition where normal bone is replaced by fibrous connective tissue, showing a **'ground-glass'** appearance on X-ray." },
  { q: "What is a Shepherd's crook deformity?", a: "A severe varus deformity of the proximal femur, classic for **fibrous dysplasia**." },
  { q: "What syndrome combines fibrous dysplasia, café-au-lait skin spots, and precocious puberty?", a: "**McCune-Albright syndrome** (caused by a mosaic mutation in the GNAS1 gene)." },
  { q: "What is Mazabraud syndrome?", a: "The rare association of **fibrous dysplasia** (often polyostotic) with **intramuscular myxomas**." },
  { q: "What is an enchondroma?", a: "A benign cartilage-forming tumor that arises in the medullary cavity of bone, most commonly in the **short tubular bones of the hand**." },
  { q: "What is Ollier's disease?", a: "A rare non-hereditary disorder characterized by **multiple enchondromas** (enchondromatosis)." },
  { q: "What is Maffucci's syndrome?", a: "The association of **multiple enchondromas** with **soft tissue hemangiomas** (high risk of malignant transformation to chondrosarcoma, ~30-50%)." },
  { q: "What is the radiographic sign of an enchondroma in the hand?", a: "A well-defined lytic lesion with **stippled or punctate calcifications** (popcorn calcification) and cortical thinning." },
  { q: "What is an osteoma?", a: "A benign, slow-growing bone tumor composed of mature compact bone, most commonly located in the **skull or facial bones**." },
  { q: "What genetic syndrome is associated with multiple osteomas, colonic polyps, and soft tissue desmoid tumors?", a: "**Gardner's syndrome** (a variant of Familial Adenomatous Polyposis [FAP] due to APC gene mutation)." },
  { q: "What is a chondroblastoma?", a: "A rare benign cartilage-producing tumor located in the **epiphysis of long bones** in skeletally immature patients (10-20 years old)." },
  { q: "What is the classic radiographic appearance of a chondroblastoma?", a: "A well-defined epiphyseal lytic lesion with a thin sclerotic rim and **'chicken-wire' calcifications** on histology." },
  { q: "What is a chondromyxoid fibroma?", a: "A rare benign bone tumor characterized by lobules of myxoid and chondroid cells separated by fibrous tissue." },
  { q: "What is a unicameral bone cyst's (UBC) pathogenesis?", a: "Fluid accumulation within the bone due to venous obstruction or lymphatic dysfunction at the growth plate." },
  { q: "Explain the 'fallen leaf sign' on X-ray.", a: "A pathologic fracture through a unicameral bone cyst where a cortical bone fragment falls to the bottom of the fluid-filled cyst, diagnostic of UBC." },
  { q: "What is the treatment for a unicameral bone cyst at high risk for pathologic fracture?", a: "Aspiration and **injection of methylprednisolone** (corticosteroid) or bone marrow, or curettage and grafting." },
  { q: "What is the translocation seen in aneurysmal bone cysts (ABC)?", a: "**t(16;17)**, which fuses the USP6 gene to the CDH11 gene." },
  { q: "Why do aneurysmal bone cysts show fluid-fluid levels on MRI?", a: "Because they are composed of blood-filled spaces where **hemosiderin-laden fluid** sediment separates by gravity." },
  { q: "What is a non-ossifying fibroma (NOF) larger than 3 cm called?", a: "A **fibrous cortical defect** (if <3 cm) or **non-ossifying fibroma** (if >3 cm)." },
  { q: "What syndrome is characterized by multiple non-ossifying fibromas, café-au-lait spots, mental retardation, and cardiac anomalies?", a: "**Jaffe-Campanacci syndrome**." },
  { q: "What is the primary site of origin of osteosarcoma metastasis?", a: "The **lungs** (hematogenous spread; chest CT is always required in initial staging)." },
  { q: "What genetic mutations are strongly associated with osteosarcoma?", a: "Mutations in **Rb** (retinoblastoma gene; 1000x increased risk) and **TP53** (Li-Fraumeni syndrome)." },
  { q: "What is Paget's osteosarcoma?", a: "Osteosarcoma arising in Paget's disease of bone in patients >60 years old; has an extremely poor prognosis (<10% 5-year survival)." },
  { q: "What are the common locations of osteoid osteoma?", a: "The femoral neck, tibial diaphysis, and posterior spine." },
  { q: "What is the biochemical cause of pain in osteoid osteoma?", a: "The nidus produces high levels of **prostaglandins** (PG-E2), which sensitizes local pain fibers (explaining relief with NSAIDs)." },
  { q: "How is osteoid osteoma definitively treated if conservative management fails?", a: "CT-guided **radiofrequency ablation (RFA)** of the nidus." },
  { q: "What is the primary diagnostic marker for Ewing's sarcoma on immunohistochemistry?", a: "**CD99** (membranous staining)." },
  { q: "What are the other names for Undifferentiated Pleomorphic Sarcoma (UPS)?", a: "Historically called **Malignant Fibrous Histiocytoma (MFH)**." },
  { q: "What is a chordoma?", a: "A rare, slow-growing malignant tumor that arises from remnants of the **notochord**." },
  { q: "Where do chordomas most commonly occur?", a: "At the ends of the axial skeleton: the **sacrum** (most common) and the **clivus** (base of skull)." },
  { q: "What is the histologic hallmark of chordoma?", a: "**Physaliphorous cells** (large, vacuolated cells resembling bubbles)." },
  { q: "What is a rhabdomyosarcoma?", a: "A highly malignant soft tissue sarcoma of **skeletal muscle** origin, most common in children." },
  { q: "What are the histological markers for rhabdomyosarcoma?", a: "**Desmin** and **myogenin** (positive on immunohistochemistry)." },
  { q: "What is a synovial sarcoma's typical location?", a: "In the deep soft tissues of the lower extremity, most commonly **near the knee or ankle** (despite its name, it rarely arises within the joint cavity)." },
  { q: "What translocation is diagnostic for synovial sarcoma?", a: "**t(X;18)**, which fuses the SYT gene on chromosome 18 to the SSX gene on the X chromosome." },
  { q: "What is a myxoid liposarcoma's classic translocation?", a: "**t(12;16)**, which fuses the FUS and DDIT3 genes." },
  { q: "How is a soft tissue sarcoma staged?", a: "Based on **grade** (histological differentiation), **size** (<5 cm vs >5 cm), **depth** (superficial vs deep to fascia), and lymph node/distant metastasis." },
  { q: "What is the primary treatment for localized soft tissue sarcomas?", a: "**Surgical resection with wide margins**, often combined with **radiation therapy** (pre- or post-operative) to reduce local recurrence." },
  { q: "Why is chemotherapy less effective in soft tissue sarcomas than in bone sarcomas?", a: "Soft tissue sarcomas are highly heterogeneous and generally have lower chemosensitivity (except for specific subtypes like rhabdomyosarcoma or Ewing's)." },
  { q: "What is the significance of Mirels' score of 7?", a: "A score of 7-8 represents an intermediate risk; clinical judgment is required, but bracing, radiation, or observation is often pursued rather than immediate prophylactic surgery." },
  { q: "What is the significance of Mirels' score of 9?", a: "A score of $\\ge 9$ indicates a **high risk of pathologic fracture** (~33% risk), making prophylactic surgical stabilization indicated." },
  { q: "What is a Gitelman-like syndrome in hypercalcemia of malignancy?", a: "Hypokalemia and metabolic alkalosis caused by PTHrP-induced calcium excretion in the kidneys." },
  { q: "What is the first-line pharmacotherapy for hypercalcemia of malignancy?", a: "**Intravenous fluids (normal saline)** to restore glomerular filtration and promote calcium excretion, followed by IV **Bisphosphonates** (e.g., Zoledronic acid)." },
  { q: "Why are loop diuretics (e.g., Furosemide) only used in hypercalcemia after volume resuscitation?", a: "Because giving diuretics to a dehydrated patient will worsen renal perfusion and exacerbate hypercalcemia." },
  { q: "What is a denosumab injection's role in Giant Cell Tumor of bone?", a: "It is a **RANKL inhibitor** that targets osteoclast-like giant cells, reducing tumor size and bone destruction (used for unresectable GCT)." },
  { q: "What is a desmoid tumor (aggressive fibromatosis)?", a: "A locally aggressive, non-metastasizing soft tissue tumor that arises from fascial planes, strongly associated with **Wnt/beta-catenin mutations** and Gardner's syndrome." },
  { q: "What is a dermatofibrosarcoma protuberans (DFSP)?", a: "A locally aggressive cutaneous sarcoma showing a **storiform** (cartwheel) histological pattern, associated with **t(17;22)** fusing COL1A1 to PDGFB." },
  { q: "What is the targeted therapy for metastatic or unresectable DFSP?", a: "**Imatinib** (tyrosine kinase inhibitor targeting PDGFB)." },
  { q: "What is the most common site of metastasis for osteosarcoma after the lungs?", a: "Other bones (metachronous bone lesions)." },
  { q: "What is the 5-year survival rate for localized osteosarcoma with modern multi-agent chemotherapy?", a: "Approximately **65–70%**." },
  { q: "What is the 5-year survival rate for metastatic osteosarcoma?", a: "Less than **30%**." },

  // ===== ADDITIONAL AUGMENTED BONE TUMORS CARDS (110+ target) =====
  { q: "How do you clinically differentiate an enchondroma from a chondrosarcoma?", a: "• **Enchondroma:** Usually asymptomatic; no cortical destruction or soft tissue mass.<br>• **Chondrosarcoma:** Pain at rest/night; cortical destruction, endosteal scalloping >2/3 cortical thickness, and soft tissue mass on MRI." },
  { q: "What is Multiple Myeloma?", a: "A neoplastic proliferation of a single clone of plasma cells producing monoclonal immunoglobulins, presenting as the most common primary malignant bone lesion in adults." },
  { q: "What is the classic radiographic appearance of Multiple Myeloma?", a: "Multiple **punched-out osteolytic lesions** (especially in the skull, spine, and pelvis) without reactive osteoblocking." },
  { q: "Why is a radionuclide bone scan often negative (cold) in Multiple Myeloma?", a: "Because bone scans rely on **osteoblastic activity** to deposit radiotracer; Multiple Myeloma lesions are purely osteolytic (osteoclast-mediated) with suppressed osteoblasts." },
  { q: "What diagnostic tests are preferred over a bone scan for staging Multiple Myeloma?", a: "A **skeletal survey (plain X-rays)**, low-dose whole-body CT, or MRI." },
  { q: "What is a solitary plasmacytoma?", a: "A single localized plasma cell tumor in bone or soft tissue, without systemic features of Multiple Myeloma (normal bone marrow, no CRAB features)." },
  { q: "What is the most important prognostic factor in localized Ewing's sarcoma?", a: "**Chemotherapy response** (percentage of tumor necrosis in the resected specimen; >90% necrosis indicates a favorable prognosis)." },
  { q: "How does an osteoid osteoma in the spine cause scoliosis?", a: "The localized inflammatory pain causes reactive muscle spasm on the side of the lesion, resulting in a scoliosis curve with its **concavity on the side of the tumor**." },
  { q: "Can a benign Giant Cell Tumor of bone metastasize?", a: "Yes, in ~2–6% of cases, GCT can cause **benign pulmonary implants/metastases**. While histologically benign, they require surgical resection but have a relatively good prognosis." },
  { q: "What is synovial chondromatosis?", a: "A benign neoplastic condition where the synovium undergoes cartilaginous metaplasia, producing **multiple loose bodies** in the joint that may ossify ('cobblestone' appearance)." },
  { q: "What is Pigmented Villonodular Synovitis (PVNS)?", a: "A benign proliferative synovial disease characterized by hemosiderin deposition. On MRI, it shows a classic **T2 dark signal** due to hemosiderin ('blooming artifact' on gradient echo)." },
  { q: "What is the gross visual appearance of the synovium in PVNS?", a: "Exuberant, villonodular, and **chocolate-brown** in color due to hemosiderin staining." },
  { q: "What is the classic radiographic appearance of a vertebral hemangioma?", a: "A **'corduroy cloth'** or **'jail-bar'** appearance due to thickening of vertical trabeculae in the vertebral body." },
  { q: "What is myositis ossificans?", a: "A benign, localized bone-forming process inside a muscle compartment, typically occurring after trauma (heterotopic ossification)." },
  { q: "How do you radiographically distinguish myositis ossificans from osteosarcoma?", a: "• **Myositis ossificans:** Shows **zonal maturation** with mature bone at the periphery and a radiolucent center.<br>• **Osteosarcoma:** Shows immature bone/sclerosis centrally with a more destructive periphery." },
  { q: "Why is a biopsy of early myositis ossificans (<3 weeks) high risk?", a: "Because the active myofibroblastic proliferation can look highly atypical and cellular, easily leading to a **false diagnosis of osteosarcoma**." },
  { q: "What is the translocation and gene fusion seen in myxoid liposarcoma?", a: "**t(12;16)(q13;p11)**, resulting in the **FUS-DDIT3** (also known as FUS-CHOP) fusion gene." },
  { q: "What is a desmoid tumor's management strategy?", a: "Historically treated with wide resection, but due to high recurrence rates, modern management focuses on **active surveillance** (observation), systemic therapy (sorafenib), or anti-estrogens." }
          ]
        },
        {
          section: 'Orthopedics',
          topic: "Pediatric orthopedics — DDH, clubfoot, Perthes",
          icon: "baby",
          cards: [
            // ===== DEVELOPMENTAL DYSPLASIA OF THE HIP (DDH) =====
  { q: "What are the key risk factors for Developmental Dysplasia of the Hip (DDH)?", a: "Female sex (~80%), **breech presentation** (most significant risk factor), firstborn child, oligohydramnios, and a family history of DDH." },
  { q: "Describe the Barlow and Ortolani maneuvers used to screen for DDH.", a: "• **Barlow test (Dislocates):** Adduction and posterior pressure on the flexed hip dislocates an unstable hip (<b>B</b>arlow = <b>B</b>ad/dislocates).<br>• **Ortolani test (Reduces):** Abduction and anterior pressure on the flexed hip reduces a dislocated hip (<b>O</b>rtolani = <b>O</b>utstanding/reduces, accompanied by a 'clunk')." },
  { q: "What is the Galeazzi sign in DDH?", a: "Apparent shortening of the femur when the child lies supine with hips and knees flexed, causing the knee heights to be unequal." },
  { q: "What are asymmetric skin folds in DDH?", a: "Asymmetric thigh or gluteal creases, indicating unilateral hip dislocation." },
  { q: "What is the preferred imaging modality for DDH in infants <6 months vs. >6 months, and why?", a: "• **<6 months:** **Ultrasound of the hips** (femoral head is cartilaginous and not visible on X-ray).<br>• **>6 months:** **Plain X-rays** (femoral head ossification center has appeared; look for disruption of Shenton's line)." },
  { q: "What is Shenton's line?", a: "A continuous smooth arc drawn along the medial border of the femoral neck and the superior border of the obturator foramen; disruption indicates hip subluxation/dislocation." },
  { q: "What is the first-line treatment for DDH in an infant <6 months old?", a: "A **Pavlik harness** (keeps the hips flexed and abducted to promote correct acetabular development)." },
  { q: "How is DDH managed in children >6 months old?", a: "**Closed reduction** and application of a **spica cast**. Open reduction is indicated if closed reduction fails." },
  { q: "What is the most severe complication of untreated DDH or improper Pavlik harness use?", a: "**Avascular necrosis (AVN)** of the femoral head (often due to hyperabduction compressing the medial femoral circumflex artery)." },

  // ===== CONGENITAL TALIPES EQUINOVARUS (CLUBFOOT) =====
  { q: "What are the four deformities of clubfoot represented by the CAVE mnemonic?", a: "• <b>C</b>avus (high medial arch).<br>• <b>A</b>dduction of the forefoot.<br>• <b>V</b>arus of the hindfoot (calcaneus tilted inward).<br>• <b>E</b>quinus of the ankle (plantarflexion)." },
  { q: "What is the gold standard treatment for congenital clubfoot?", a: "The **Ponseti method**: weekly serial manipulation and casting, starting shortly after birth, to gradually correct the deformities." },
  { q: "What is the sequence of deformity correction in the Ponseti method?", a: "Correct: 1. **Cavus** (first, by aligning forefoot with hindfoot), 2. **Adduction and Varus** (by abducting the foot around the talar head), and 3. **Equinus** (last)." },
  { q: "What is the primary indicator of a successful Ponseti casting phase?", a: "The foot can be abducted to 60–70° without stretching the heel cord." },
  { q: "What minor surgical procedure is required in ~90% of clubfoot cases treated with Ponseti casting?", a: "A **percutaneous Achilles tenotomy** to correct the residual equinus deformity before the final cast is applied." },
  { q: "What is required after completion of Ponseti casting to prevent clubfoot recurrence?", a: "Use of a **foot abduction brace** (boots and bar; worn 23 hours/day for 3 months, then at nap/nighttime until age 4–5 years)." },

  // ===== LEGG-CALVÉ-PERTHES DISEASE (LCPD) =====
  { q: "What is Legg-Calvé-Perthes Disease (LCPD)?", a: "Idiopathic **avascular necrosis of the femoral head** in children, followed by resorption and eventual reossification." },
  { q: "What is the typical age and presentation of a child with Legg-Calvé-Perthes?", a: "• **Age:** 4–8 years old (more common in boys).<br>• **Presentation:** Insidious onset of a **painless limp**, or hip/groin/knee pain, with **limited internal rotation and abduction**." },
  { q: "What are the radiographic stages of Legg-Calvé-Perthes?", a: "1. **Initial/Synovitis:** Joint space widening, small femoral head.<br>2. **Fragmentation:** Femoral head breaks up/flattens (crescent sign).<br>3. **Reossification:** New bone formation.<br>4. **Healing/Remodeling:** Final shape of femoral head is determined." },
  { q: "What is the primary goal of management in Legg-Calvé-Perthes?", a: "To maintain **containment** of the femoral head within the acetabulum (using bracing, physical therapy, or containment osteotomies) to ensure it heals in a spherical shape." },
  { q: "What is the prognosis of Legg-Calvé-Perthes based on age?", a: "Children **<6 years old** have a **better prognosis** because they have more time for bone remodeling before skeletal maturity." },

  // ===== SLIPPED CAPITAL FEMORAL EPIPHYSIS (SCFE) =====
  { q: "What is Slipped Capital Femoral Epiphysis (SCFE)?", a: "Displacement of the femoral neck anteriorly and superiorly relative to the femoral head epiphysis, which slips posteriorly and inferiorly through the hypertrophic zone of the physis." },
  { q: "What is the typical patient profile for SCFE?", a: "An **obese adolescent male** aged 10–16 years. (Can also occur in atypical patients with underlying endocrine disorders like hypothyroidism or growth hormone deficiency)." },
  { q: "How does a patient with SCFE present clinically?", a: "Dull pain in the hip, groin, or **referred knee/thigh pain**, and a **limp**. The leg is held in **external rotation**, and passive flexion of the hip results in **obligate external rotation**." },
  { q: "What radiographic line is used to detect SCFE, and what is the classic sign?", a: "• **Klein's line:** A line drawn along the superior border of the femoral neck; in SCFE, it fails to intersect the femoral head epiphysis.<br>• **Classic sign:** 'Ice cream slipping off a cone'." },
  { q: "Differentiate between stable and unstable SCFE.", a: "• **Stable:** Patient can bear weight (low risk of AVN).<br>• **Unstable:** Patient cannot bear weight even with crutches (high risk of AVN, ~50%)." },
  { q: "What is the definitive management of SCFE?", a: "Urgent **in situ percutaneous screw fixation** (single cannulated screw across the physis) to prevent further slippage, avascular necrosis, and chondrolysis." },
  { q: "Why is a contralateral hip X-ray important in a patient diagnosed with unilateral SCFE?", a: "Because up to **20–50% of cases are bilateral**, and the contralateral hip may have a silent or impending slip." },

  // ===== TRANSIENT SYNOVITIS VS. SEPTIC ARTHRITIS =====
  { q: "What is transient synovitis (toxic synovitis)?", a: "A benign, self-limiting inflammatory arthritis of the hip, commonly occurring in children aged 3–10 **following a viral upper respiratory infection**." },
  { q: "What are the four Kocher criteria used to differentiate septic arthritis from transient synovitis?", a: "1. **Inability to bear weight** on the affected limb.<br>2. **ESR >40 mm/hr**.<br>3. **WBC count >12,000 cells/µL**.<br>4. **Fever >38.5°C** (oral/rectal)." },
  { q: "How is the Kocher criteria interpreted?", a: "• **1/4 criteria:** ~3% probability of septic arthritis.<br>• **2/4 criteria:** ~40% probability.<br>• **3/4 criteria:** ~93% probability.<br>• **4/4 criteria:** **>99% probability** (warrants immediate joint aspiration under ultrasound/fluoroscopy)." },
  { q: "Why is septic arthritis of the hip in a child a surgical emergency?", a: "Increased joint pressure can compress the blood vessels supplying the femoral head, leading to **ischemic necrosis of the femoral head** and cartilage destruction within 24 hours." },
  { q: "What is the management of a confirmed septic arthritis of the hip?", a: "Immediate **surgical incision, irrigation, and drainage (arthrotomy)**, followed by targeted intravenous antibiotics." },

  // ===== OTHER PEDIATRIC ORTHO PATHOLOGIES =====
  { q: "What is Osgood-Schlatter disease?", a: "Traction apophysitis of the **tibial tubercle** due to repetitive strain from the patellar tendon, common in active adolescents; presents with localized pain and swelling at the tibial tuberosity." },
  { q: "What is Sever's disease?", a: "Traction apophysitis of the **calcaneus** (heel) insertion of the Achilles tendon, presenting as heel pain in active children." },
  { q: "What is scoliosis screening Adam's test?", a: "Bending forward at the waist to look for asymmetry/rib hump, indicating spinal rotation." },

  // ===== NEW EXPANSION CARDS (100+ target) =====
  { q: "What is Blount's disease?", a: "Infantile or adolescent **tibia vara**: an abnormal growth deceleration of the posteromedial proximal tibial physis, leading to progressive bowlegs." },
  { q: "How do you radiographically differentiate physiologic genu varum (bowlegs) from Blount's disease?", a: "By measuring the **metaphyseal-diaphyseal angle** on X-ray; an angle **$>16^\\circ$** is diagnostic of Blount's disease." },
  { q: "What is the treatment for infantile Blount's disease?", a: "KAFO (knee-ankle-foot) bracing if diagnosed before age 3; surgical osteotomy is required if bracing fails or if diagnosed after age 4." },
  { q: "What is the pathophysiology of hematogenous osteomyelitis in children?", a: "Bacteria settle in the **metaphysis** of long bones because of sluggish blood flow in the hairpin vascular loops adjacent to the growth plate." },
  { q: "What is the most common causative organism of osteomyelitis in children of all ages?", a: "**Staphylococcus aureus**." },
  { q: "What causative organism of osteomyelitis/septic arthritis is classically associated with puncture wounds through a rubber-soled shoe?", a: "**Pseudomonas aeruginosa**." },
  { q: "What causative organism of osteomyelitis/septic arthritis is unique to patients with Sickle Cell Disease?", a: "**Salmonella** species (though S. aureus remains highly common as well)." },
  { q: "What is the primary diagnostic imaging study for pediatric osteomyelitis?", a: "• **Initial:** Plain X-rays (often normal for the first 10–14 days).<br>• **Most sensitive early test:** **MRI of the affected bone** (shows marrow edema)." },
  { q: "What is a Brodie's abscess?", a: "A chronic, localized form of osteomyelitis presenting as a radiolucent lesion with a sclerotic rim in the metaphysis of long bones." },
  { q: "What is a 'nursemaid's elbow'?", a: "Subluxation of the **radial head** through the **annular ligament**, commonly occurring in children aged 1–4 years when pulled by the arm." },
  { q: "How is a nursemaid's elbow reduced?", a: "1. **Hyperpronation** of the forearm while applying pressure to the radial head (most successful).<br>2. **Supination and flexion** of the elbow." },
  { q: "What is Osteogenesis Imperfecta (OI)?", a: "A genetic disorder of collagen synthesis characterized by bone fragility, blue sclerae, hearing loss, and multiple fractures." },
  { q: "What genetic defect causes Osteogenesis Imperfecta?", a: "Autosomal dominant mutations in the **COL1A1 or COL1A2** genes, affecting Type I collagen synthesis." },
  { q: "What is dentinogenesis imperfecta?", a: "A hereditary condition seen in OI characterized by translucent, discolored (blue-gray or brown) teeth that wear down rapidly." },
  { q: "What is Achondroplasia?", a: "The most common form of short-limbed dwarfism, characterized by rhizomelic (proximal) shortening, trident hands, and macrocephaly." },
  { q: "What is the genetic cause of Achondroplasia?", a: "A gain-of-function mutation in the **FGFR3** (fibroblast growth factor receptor 3) gene, which constitutively inhibits cartilage proliferation at the physis." },
  { q: "What is the primary orthopedic complication of Achondroplasia in adulthood?", a: "**Spinal stenosis** (especially lumbar), due to abnormally short pedicles and spinal canal narrowing." },
  { q: "What is Rickets?", a: "A systemic disease of growing bone caused by **Vitamin D deficiency** or abnormal calcium/phosphate metabolism, leading to failure of osteoid osteoid mineralization." },
  { q: "What are the classic radiographic features of Rickets?", a: "**Cupping and fraying** of the metaphyses, widening of the physis, and bowing of the long bones." },
  { q: "What is the 'rachitic rosary'?", a: "Prominent nodules at the costochondral junctions due to overgrowth of cartilage and osteoid, classic for Rickets." },
  { q: "What is the Gowers' sign?", a: "The patient uses their hands to 'climb up' their own thighs to stand up from a supine position, indicating **proximal muscle weakness** (classic for Duchenne muscular dystrophy)." },
  { q: "What is the inheritance pattern of Duchenne Muscular Dystrophy?", a: "**X-linked recessive** (mutations in the dystrophin gene)." },
  { q: "What is the primary screening test for Duchenne Muscular Dystrophy?", a: "Serum **Creatine Kinase (CK)** level (exceedingly high, >10–100x normal)." },
  { q: "What is Blount's disease's main complication if left untreated?", a: "Permanent growth arrest of the medial tibial physis, leading to severe limb deformity and premature osteoarthritis." },
  { q: "What is a 'bucket handle' fracture?", a: "A metaphyseal corner fracture caused by shearing forces (tugging/shaking) in an infant, highly specific for **child abuse**." },
  { q: "What is a posterior rib fracture's significance in an infant?", a: "Highly specific for **child abuse** (caused by squeezing the infant's chest)." },
  { q: "What is the significance of a spiral fracture of a long bone in a non-ambulatory infant?", a: "Highly suspicious for **non-accidental trauma (child abuse)**, as infants cannot generate the torsional forces required for this injury." },
  { q: "What is the Ponseti cast brace time?", a: "Boot and bar bracing is required **until age 4-5 years** (worn at night and naptime) to prevent clubfoot recurrence." },
  { q: "Describe the Galeazzi sign test.", a: "With child supine on a flat surface, flex hips to 45° and knees to 90°, placing feet flat; look for difference in height of the knees." },
  { q: "At what age is the Pavlik harness no longer effective for DDH?", a: "After **6 months of age**, as the infant becomes too strong, active, and heavy for the harness to maintain stable reduction." },
  { q: "What is the primary risk of closed reduction and spica casting in DDH?", a: "Avascular necrosis of the femoral head due to excessive abduction in the cast." },
  { q: "What is the classic presentation of transient synovitis on physical exam?", a: "Hip held in **flexion, abduction, and external rotation** (the position of maximum joint volume/minimum pressure) with refusal to bear weight." },
  { q: "How is transient synovitis treated?", a: "Rest, weight-bearing as tolerated, and oral NSAIDs (resolves within 7–10 days)." },
  { q: "What are the common skeletal manifestations of osteogenesis imperfecta?", a: "Scoliosis, bowing of long bones, pectus deformity, and multiple vertebral compression fractures." },
  { q: "What are the indications for surgical intervention in Osgood-Schlatter disease?", a: "Almost none acutely (self-limiting, resolves when growth plate fuses). Rarely, excision of a symptomatic ossicle is done in adulthood." },
  { q: "What is the treatment for a mild physiologic bowleg in a 15-month-old child?", a: "Reassurance and observation, as physiologic bowing is normal until age 2 and resolves spontaneously." },
  { q: "What is the normal progression of knee alignment in children?", a: "• **0–2 years:** Genu varum (bowlegs).<br>• **2–4 years:** Genu valgum (knock-knees).<br>• **4–7 years:** Gradually straightens to normal adult alignment (~5–7° valgus)." },
  { q: "What is a 'coxa vara' deformity in pediatric hips?", a: "An abnormally decreased femoral neck-shaft angle ($<120^\\circ$)." },
  { q: "What is a 'coxa valga' deformity?", a: "An abnormally increased femoral neck-shaft angle ($>135^\\circ$)." },
  { q: "What is the average femoral neck-shaft angle in a neonate?", a: "Approximately **$150^\circ$** (decreases to $\sim 125-130^\circ$ in adulthood)." },
  { q: "What is the treatment for a stable SCFE?", a: "In situ single screw fixation to prevent further displacement." },
  { q: "What is the treatment for an unstable SCFE?", a: "Urgent decompression of the joint hematoma and stabilizing screw fixation (high risk of AVN)." },
  { q: "What is the primary target of joint destruction in rheumatoid arthritis?", a: "The **synovium** (synovitis leading to pannus formation), whereas osteoarthritis targets the articular cartilage." },
  { q: "What is a 'gibbus deformity'?", a: "A sharp angulation of the spine (severe localized kyphosis) caused by the collapse of one or more vertebral bodies, classic for tuberculous spondylitis (Pott's disease)." },
  { q: "Why is a posterior rib fracture in an infant highly specific for abuse?", a: "Because accidental falls or traumas do not apply the lateral chest compression force required to fracture the posterior ribs near the spine." },
  { q: "What is the definition of a Risser Stage 5?", a: "Complete ossification and fusion of the iliac apophysis, indicating completion of spinal growth." },
  { q: "Why is the Risser stage critical in scoliosis bracing decisions?", a: "Bracing is only indicated in patients with significant growth potential (Risser 0-2). A patient with Risser 4 or 5 will not benefit from bracing." },
  { q: "What is the primary motor reflex of the C8 nerve root?", a: "There is no primary tendon reflex for C8 (it controls finger flexor strength)." },
  { q: "What is a 'greenstick' fracture's definition?", a: "An incomplete fracture where the bone is bent, with a fracture line on the tension side (convex cortex) but an intact compression side (concave cortex)." },
  { q: "What is the Ponseti cast change interval?", a: "Every **5 to 7 days** (weekly serial casting)." },

  // ===== ADDITIONAL AUGMENTED PEDIATRIC ORTHO CARDS (110+ target) =====
  { q: "What are the common causes of pathological genu valgum (knock-knees) in children?", a: "Renal osteodystrophy, skeletal dysplasias, and **Cozen's phenomenon** (post-traumatic tibia valga after proximal metaphyseal fracture)." },
  { q: "What are the three classifications of Blount's disease based on age of onset?", a: "• **Infantile:** 1–3 years old (bilateral in 80%, painless).<br>• **Juvenile:** 4–10 years old.<br>• **Adolescent:** >10 years old (unilateral in 80%, painful)." },
  { q: "What is the normal developmental age range for a child to start walking independently?", a: "**12 to 15 months**. A developmental workup for delayed walking is indicated if the child is not walking by **18 months**." },
  { q: "Differentiate between flexible and rigid flatfoot (pes planus) in children.", a: "• **Flexible:** Normal arch is present when non-weight bearing or standing on toes; asymptomatic, no treatment needed.<br>• **Rigid:** Arch is absent in all positions; indicates underlying pathology (e.g., tarsal coalition)." },
  { q: "What is tarsal coalition?", a: "An abnormal fibrous, cartilaginous, or bony connection between two or more tarsal bones, causing rigid flatfoot and peroneal spasticity." },
  { q: "What are the two most common tarsal coalitions, and their classic age of presentation?", a: "• **Calcaneonavicular coalition:** Presents at **8–12 years** old.<br>• **Talocalcaneal coalition:** Presents at **12–16 years** old (corresponds to age of ossification of the coalition)." },
  { q: "Describe the classic X-ray sign of a talocalcaneal coalition.", a: "The **'C-sign'** on a lateral foot X-ray (a bony bridge forming a C-shape between the talus and sustentaculum tali)." },
  { q: "What is Kohler's disease?", a: "Osteochondrosis/avascular necrosis of the tarsal **navicular bone** in children aged 2–10 years, presenting as pain over the medial midfoot." },
  { q: "What is Freiberg's disease?", a: "Osteochondrosis/avascular necrosis of the **second metatarsal head**, most common in adolescent female dancers/athletes." },
  { q: "What is Panner's disease?", a: "Osteochondrosis of the **capitellum of the humerus** in children aged 5–10 years, presenting as lateral elbow pain in throwing athletes." },
  { q: "What is 'Little League Elbow'?", a: "Traction apophysitis of the **medial epicondyle** of the humerus in young baseball pitchers due to repetitive valgus overload." },
  { q: "What medical therapy is used in children with severe Osteogenesis Imperfecta to reduce fracture rates?", a: "Intravenous **Bisphosphonate (Pamidronate/Zoledronic acid) infusions**, which inhibit osteoclast activity and increase cortical thickness." },
  { q: "What is the acetabular index (AI) on a pediatric pelvis X-ray?", a: "The angle between Hilgenreiner's line and a line along the acetabular roof. Normal is **<30°** in newborns; an angle **>30°** suggests acetabular dysplasia (DDH)." },
  { q: "What is the Herring Lateral Pillar classification in Legg-Calvé-Perthes disease?", a: "Classifies severity based on the height of the lateral pillar of the femoral head during fragmentation:<br>• **Group A:** No height loss (good prognosis).<br>• **Group B:** <50% height loss.<br>• **Group C:** >50% height loss (poor prognosis, high risk of osteoarthritis)." },
  { q: "What is chondrolysis, and when does it occur in SCFE?", a: "Rapid, progressive loss of articular cartilage in the hip joint, leading to pain and stiffening; a major complication of untreated SCFE or screw penetration into the joint space." },
  { q: "What are the two most common joints affected by pediatric septic arthritis?", a: "The **hip** (most common in infants) and the **knee**." },
  { q: "What is the modified Kocher criteria with CRP?", a: "Adding **CRP >20 mg/L** as a fifth parameter. Finding $\\ge 4/5$ positive markers yields a **>98% probability** of septic arthritis." }
          ]
        },
        {
          section: 'Ophthalmology',
          topic: "Red eye — conjunctivitis, uveitis, keratitis",
          icon: "eye",
          cards: [
            { q: "Name the two types of conjunctiva and their locations.", a: "<b>Bulbar conjunctiva</b> — covers the anterior sclera (white of the eye)<br><b>Palpebral (tarsal) conjunctiva</b> — lines the inner surface of the eyelids<br>They are continuous at the <b>fornix</b> (conjunctival cul-de-sac)." },
{ q: "List the 5 layers of the cornea from anterior to posterior.", a: "1. <b>Epithelium</b> (stratified squamous, rapid regeneration)<br>2. <b>Bowman's layer</b> (acellular collagen, does NOT regenerate)<br>3. <b>Stroma</b> (90% of corneal thickness, type I collagen lamellae)<br>4. <b>Descemet's membrane</b> (basement membrane of endothelium, regenerates)<br>5. <b>Endothelium</b> (single layer, maintains corneal dehydration via Na⁺/K⁺-ATPase pump, does NOT regenerate)" },
{ q: "What are the three structures of the uveal tract?", a: "<b>Iris</b> — controls pupil size (sphincter = parasympathetic, dilator = sympathetic)<br><b>Ciliary body</b> — produces aqueous humor, controls accommodation<br><b>Choroid</b> — vascular layer that supplies outer retina (RPE & photoreceptors)" },
{ q: "What is the limbus and why is it clinically important?", a: "The <b>limbus</b> is the junction between the cornea and sclera.<br>It contains <b>limbal stem cells</b> that regenerate corneal epithelium.<br>It also houses the <b>trabecular meshwork</b> and <b>Schlemm's canal</b> for aqueous drainage.<br><i>Limbal stem cell deficiency → corneal opacification and vascularization.</i>" },
{ q: "What is the anterior chamber and what does it contain?", a: "The <b>anterior chamber</b> is the space between the cornea (anterior) and the iris/pupil (posterior).<br>It is filled with <b>aqueous humor</b> produced by the ciliary body.<br>The <b>iridocorneal angle</b> at its periphery contains the trabecular meshwork for aqueous outflow." },
{ q: "What is a ciliary flush (circumcorneal/limbal flush) and what does it indicate?", a: "A <b>ciliary flush</b> is a ring of deep, violaceous injection surrounding the limbus.<br>It indicates <b>deep ocular inflammation</b>:<br>• <b>Anterior uveitis</b><br>• <b>Keratitis</b><br>• <b>Acute angle-closure glaucoma</b><br>It is supplied by the <b>anterior ciliary arteries</b> (deep episcleral vessels)." },
{ q: "Differentiate conjunctival injection from ciliary flush.", a: "<b>Conjunctival injection</b>: superficial, bright red, <i>most prominent in fornices</i>, fades toward limbus, blanches with phenylephrine — seen in <b>conjunctivitis</b><br><b>Ciliary flush</b>: deep, violaceous, <i>most prominent at limbus</i>, does NOT blanch with topical phenylephrine — seen in <b>uveitis, keratitis, acute glaucoma</b>" },
{ q: "Give a systematic approach to the red eye differential using 5 key features.", a: "Assess: <b>Pain, Vision, Pupil, Discharge, Injection pattern</b><br>• <b>Conjunctivitis</b>: no/mild pain, normal vision, normal pupil, discharge present, diffuse injection<br>• <b>Keratitis</b>: pain, ↓ vision, normal pupil, watery/purulent, ciliary flush<br>• <b>Anterior uveitis</b>: pain + photophobia, ↓ vision, miotic pupil, no discharge, ciliary flush<br>• <b>Acute glaucoma</b>: severe pain + N/V, ↓↓ vision, fixed mid-dilated pupil, no discharge, diffuse + ciliary flush<br>• <b>Scleritis</b>: severe boring pain, ↓ vision possible, normal pupil, no discharge, deep injection" },
{ q: "Which red eye conditions cause vision loss?", a: "<b>Vision-threatening</b>:<br>• Keratitis (corneal ulcer)<br>• Anterior uveitis<br>• Acute angle-closure glaucoma<br>• Scleritis<br>• Endophthalmitis<br><b>Vision-sparing</b>:<br>• Conjunctivitis<br>• Episcleritis<br>• Subconjunctival hemorrhage" },
{ q: "What pupil abnormalities are seen in red eye conditions?", a: "<b>Miotic (small) pupil</b> → anterior uveitis (reflex spasm of sphincter from inflammation)<br><b>Mid-dilated, fixed pupil</b> → acute angle-closure glaucoma<br><b>Normal pupil</b> → conjunctivitis, episcleritis, scleritis, subconjunctival hemorrhage" },
{ q: "What are the most common organisms causing bacterial conjunctivitis?", a: "<b>Adults</b>:<br>• <b>Staphylococcus aureus</b> (most common in adults)<br>• Streptococcus pneumoniae<br>• Moraxella catarrhalis<br><b>Children</b>:<br>• <b>Haemophilus influenzae</b> (most common in children, can cause otitis media-conjunctivitis syndrome)<br>• Streptococcus pneumoniae" },
{ q: "Describe the clinical features of bacterial conjunctivitis.", a: "<b>Mucopurulent discharge</b> (yellow-green, crusting of lids in morning)<br>Conjunctival injection (diffuse, more in fornices)<br><b>Papillary reaction</b> on tarsal conjunctiva<br>Usually <b>unilateral initially</b>, spreads to other eye in 1–2 days<br>No preauricular lymphadenopathy (unlike viral)<br>Usually <b>self-limiting</b> in 5–7 days" },
{ q: "What is the treatment for routine bacterial conjunctivitis?", a: "Often <b>self-limiting</b>, but topical antibiotics shorten course:<br>• <b>Erythromycin 0.5% ointment</b> — first-line, especially in children<br>• <b>Fluoroquinolone drops</b> (moxifloxacin, ofloxacin)<br>• Trimethoprim-polymyxin B drops<br>Apply QID for 5–7 days.<br><b>Hand hygiene</b> to prevent spread." },
{ q: "What defines hyperacute bacterial conjunctivitis and what is the most common causative organism?", a: "<b>Hyperacute conjunctivitis</b>: onset within 12–24 hours with <b>copious purulent discharge</b> that reaccumulates rapidly after wiping.<br>Most common cause: <b>Neisseria gonorrhoeae</b><br>It is an <b>ophthalmologic emergency</b> due to risk of <b>corneal perforation</b>." },
{ q: "How is gonococcal conjunctivitis treated?", a: "<b>Systemic</b>: <b>Ceftriaxone 1g IM × 1 dose</b> (plus treat for concurrent chlamydia with azithromycin 1g PO)<br><b>Topical</b>: Erythromycin ointment or fluoroquinolone drops<br><b>Saline irrigation</b> of discharge<br><b>Urgent ophthalmology referral</b><br><i>Corneal perforation can occur within 24–48 hours if untreated!</i>" },
{ q: "Why is gonococcal conjunctivitis considered an ophthalmologic emergency?", a: "<b>N. gonorrhoeae</b> can penetrate <b>intact corneal epithelium</b> (unlike most bacteria), leading to:<br>• Rapid <b>corneal ulceration</b><br>• <b>Corneal perforation</b><br>• <b>Endophthalmitis</b><br>• Permanent <b>vision loss</b><br>Requires immediate treatment with systemic ceftriaxone." },
{ q: "What is the most common cause of viral conjunctivitis?", a: "<b>Adenovirus</b> (serotypes 3, 4, 7, 8, 19, 37)<br>It is the <b>most common overall cause of conjunctivitis</b>.<br>Highly contagious — spreads via direct contact, fomites, contaminated swimming pools.<br>Virus can survive on surfaces for weeks." },
{ q: "What are the clinical features of adenoviral conjunctivitis?", a: "• <b>Watery (serous) discharge</b><br>• <b>Preauricular lymphadenopathy</b> (hallmark of viral)<br>• <b>Follicular reaction</b> on palpebral conjunctiva<br>• Often preceded by URI or pharyngitis<br>• Bilateral (second eye affected 1–2 days later, usually milder)<br>• <b>Subconjunctival hemorrhage</b> may occur<br>Self-limiting in 1–3 weeks." },
{ q: "What is epidemic keratoconjunctivitis (EKC) and what complication can follow?", a: "<b>EKC</b> is a severe form of adenoviral conjunctivitis (serotypes 8, 19, 37).<br>Features: intense tearing, pseudomembranes, keratitis<br>Late complication: <b>subepithelial infiltrates (SEIs)</b> — focal immune deposits in corneal stroma appearing 1–3 weeks after infection.<br>SEIs can cause <b>glare and decreased vision</b> lasting months to years.<br>Treatment of SEIs: topical steroids if vision-impairing." },
{ q: "How is viral conjunctivitis managed?", a: "<b>Supportive care</b> — self-limiting in 1–3 weeks:<br>• Cold compresses<br>• Artificial tears<br>• Hand hygiene (highly contagious for 10–14 days)<br>• Avoid sharing towels/pillows<br><b>No antibiotics</b> (ineffective against viruses)<br>Pseudomembranes → peel with forceps, consider topical steroids" },
{ q: "How do you differentiate follicles from papillae on the conjunctiva?", a: "<b>Follicles</b>: small, pale, avascular lymphoid aggregates with vessels coursing <i>around</i> them<br>→ Seen in: <b>viral and chlamydial</b> conjunctivitis<br><br><b>Papillae</b>: red, vascular mounds with a central vessel core<br>→ Seen in: <b>bacterial and allergic</b> conjunctivitis<br>Giant papillae (>1 mm) → vernal keratoconjunctivitis, contact lens-related GPC" },
{ q: "What is the hallmark symptom of allergic conjunctivitis?", a: "<b>Itching</b> — the hallmark symptom (pruritis)<br>Other features: <b>bilateral</b>, chemosis (conjunctival edema), watery discharge with stringy/mucoid component, <b>papillary reaction</b>, lid edema<br>History of atopy (allergic rhinitis, asthma, eczema) is common." },
{ q: "What is found on conjunctival scraping in allergic conjunctivitis?", a: "<b>Eosinophils</b> on conjunctival cytology<br>This distinguishes allergic from infectious causes.<br>Mast cell degranulation → release of histamine, tryptase, prostaglandins → itching and chemosis." },
{ q: "What is the treatment for allergic conjunctivitis?", a: "<b>First-line</b>: <b>Dual-action antihistamine/mast cell stabilizers</b> — <b>olopatadine</b> (Patanol), ketotifen<br><b>Mast cell stabilizers</b>: cromolyn sodium, nedocromil (prophylactic, take 2 weeks to work)<br><b>Antihistamine drops</b>: azelastine, emedastine<br><b>Supportive</b>: cold compresses, artificial tears, avoid rubbing eyes<br><b>Oral antihistamines</b> if severe systemic symptoms<br>Topical steroids for severe flares only (short course, monitor IOP)" },
{ q: "What is vernal keratoconjunctivitis and how does it differ from seasonal allergic conjunctivitis?", a: "<b>Vernal keratoconjunctivitis</b>: chronic, bilateral, affects <b>young boys in warm climates</b><br>Features: <b>giant cobblestone papillae</b> on upper tarsal conjunctiva, thick ropy mucus discharge, Horner-Trantas dots (limbal gelatinous nodules = degenerated eosinophils)<br><b>Shield ulcer</b> — sterile corneal ulcer from mechanical trauma of papillae<br>More severe than seasonal allergic conjunctivitis, may require topical cyclosporine or steroids." },
{ q: "What causes inclusion conjunctivitis and what serotypes are responsible?", a: "<b>Chlamydia trachomatis serotypes D–K</b><br>Sexually transmitted — occurs in sexually active young adults<br>Often associated with concurrent <b>chlamydial urethritis/cervicitis</b><br>Features: <b>chronic follicular conjunctivitis</b>, mucopurulent discharge, preauricular lymphadenopathy<br>Superior tarsal <b>follicular reaction</b>" },
{ q: "How is chlamydial conjunctivitis diagnosed?", a: "• <b>Giemsa stain</b> of conjunctival scrapings → <b>basophilic intracytoplasmic inclusion bodies</b> (Halberstaedter-Prowazek bodies) within epithelial cells<br>• <b>NAAT (nucleic acid amplification test)</b> — most sensitive and specific<br>• Direct fluorescent antibody (DFA) staining<br>• Chlamydial culture (McCoy cells)" },
{ q: "What is the treatment for chlamydial inclusion conjunctivitis?", a: "<b>Systemic antibiotics</b> (topical alone is insufficient):<br>• <b>Azithromycin 1g PO × 1 dose</b> (preferred)<br>• OR <b>Doxycycline 100mg PO BID × 7 days</b><br>Must <b>treat sexual partners</b><br>Test for co-infection with gonorrhea, syphilis, HIV<br>Topical erythromycin may be added but is adjunctive only." },
{ q: "What is trachoma and which serotypes cause it?", a: "<b>Trachoma</b> is caused by <b>Chlamydia trachomatis serotypes A, B, Ba, C</b>.<br>It is the <b>leading infectious cause of preventable blindness worldwide</b>.<br>Endemic in sub-Saharan Africa, South Asia, Middle East.<br>Spread by direct contact, flies, fomites (shared towels/cloths).<br>Repeated reinfection → progressive scarring → blindness." },
{ q: "Describe the stages and clinical features of trachoma.", a: "WHO classification:<br><b>TF</b> — Trachomatous inflammation, Follicular (≥5 follicles on upper tarsal conjunctiva)<br><b>TI</b> — Trachomatous inflammation, Intense (papillary hypertrophy obscuring tarsal vessels)<br><b>TS</b> — Trachomatous Scarring (<b>Arlt's line</b> = horizontal white scar lines on tarsal conjunctiva)<br><b>TT</b> — Trachomatous Trichiasis (in-turned lashes abrading cornea)<br><b>CO</b> — Corneal Opacity (leading to blindness)<br>Also: <b>Herbert's pits</b> (limbal scarring), <b>pannus</b> (superior corneal vascularization)" },
{ q: "What is the SAFE strategy for trachoma?", a: "<b>S</b> — Surgery for trichiasis (eyelid rotation)<br><b>A</b> — Antibiotics (azithromycin mass distribution)<br><b>F</b> — Facial cleanliness<br><b>E</b> — Environmental improvement (sanitation, water supply)<br>WHO-endorsed community-based intervention strategy." },
{ q: "What are Herbert's pits and Arlt's line?", a: "<b>Herbert's pits</b>: small depressions at the <b>superior limbus</b> — scarred-out follicles, pathognomonic of trachoma<br><b>Arlt's line</b>: linear horizontal <b>fibrous scars</b> on the <b>upper tarsal conjunctiva</b> — result of chronic trachomatous inflammation<br>Both are late findings of trachoma (C. trachomatis A–C)." },
{ q: "What is a pannus?", a: "A <b>pannus</b> is a fibrovascular membrane extending from the limbus onto the cornea.<br>In <b>trachoma</b>: typically <b>superior pannus</b><br>Causes: trachoma, contact lens overwear, rosacea keratitis<br>It consists of blood vessels + inflammatory infiltrate growing between Bowman's layer and epithelium.<br>Can lead to corneal opacification and vision loss." },
{ q: "What is ophthalmia neonatorum?", a: "<b>Ophthalmia neonatorum</b> = conjunctivitis occurring in the <b>first 28 days of life</b>.<br>It is a <b>notifiable condition</b>.<br>Acquired during passage through an infected birth canal (except chemical).<br>Key to differential: <b>timing of onset</b>." },
{ q: "Differentiate causes of ophthalmia neonatorum by timeline.", a: "<b>Day 1 (within 24h)</b>: Chemical — silver nitrate prophylaxis (rarely used now)<br><b>Days 2–5</b>: <b>N. gonorrhoeae</b> — purulent, ophthalmologic emergency, risk of perforation<br><b>Days 5–14</b>: <b>C. trachomatis</b> — most common infectious cause, mucopurulent<br><b>Days 6–14</b>: <b>HSV</b> — vesicular lid lesions, may cause keratitis/systemic disease<br><b>Days 5–28</b>: Other bacteria (S. aureus, E. coli)" },
{ q: "How is gonococcal ophthalmia neonatorum treated?", a: "<b>Systemic</b>: <b>Ceftriaxone 25–50 mg/kg IV/IM × 1 dose</b> (or cefotaxime if hyperbilirubinemia)<br><b>Topical</b>: saline irrigation + erythromycin ointment<br><b>Urgent ophthalmology evaluation</b><br>Both parents need evaluation and treatment for STI<br><i>Admission for systemic antibiotics — untreated can cause corneal perforation and blindness within 24 hours.</i>" },
{ q: "How is chlamydial ophthalmia neonatorum treated?", a: "<b>Oral erythromycin 50 mg/kg/day divided QID × 14 days</b><br>(Risk of <b>infantile hypertrophic pyloric stenosis</b> — counsel parents on warning signs)<br>Topical therapy alone is <b>insufficient</b> and does not prevent chlamydial pneumonia<br>Evaluate and treat parents for chlamydia." },
{ q: "What is the current standard prophylaxis for ophthalmia neonatorum?", a: "<b>Erythromycin 0.5% ophthalmic ointment</b> applied to both eyes within 1 hour of birth.<br>Effective against <b>gonococcal</b> ophthalmia (less reliable for chlamydial).<br>Replaced silver nitrate (which caused chemical conjunctivitis and was not effective against chlamydia).<br>Required by law in most US states." },
{ q: "What is the #1 risk factor for bacterial keratitis?", a: "<b>Contact lens wear</b> — especially extended/overnight wear, poor hygiene, sleeping in lenses<br>Other risk factors:<br>• Corneal trauma/surgery<br>• Dry eye<br>• Immunosuppression<br>• Topical corticosteroid use<br>• Lid abnormalities (lagophthalmos, entropion)" },
{ q: "What organism is most commonly associated with contact lens–related bacterial keratitis?", a: "<b>Pseudomonas aeruginosa</b><br>Features:<br>• Rapidly progressive corneal ulcer<br>• <b>Green or blue-green mucopurulent discharge</b><br>• Risk of <b>corneal perforation within 24–48 hours</b><br>• Hypopyon (layered WBCs in anterior chamber)<br>Requires immediate aggressive topical antibiotics." },
{ q: "What are the clinical features of a bacterial corneal ulcer?", a: "• <b>Pain, photophobia, tearing, decreased vision</b><br>• <b>White/yellow corneal infiltrate</b> (stromal opacity)<br>• <b>Epithelial defect</b> — stains with fluorescein<br>• <b>Hypopyon</b> — layer of WBCs in anterior chamber<br>• Mucopurulent discharge<br>• Lid edema, conjunctival injection<br>• <b>Ciliary flush</b>" },
{ q: "How is a corneal ulcer diagnosed?", a: "• <b>Slit-lamp examination</b> — assess size, depth, location of infiltrate<br>• <b>Fluorescein staining</b> — highlights epithelial defect (green under cobalt blue light)<br>• <b>Corneal scraping</b> for Gram stain, culture (blood agar, chocolate agar, Sabouraud agar for fungi, thioglycolate broth)<br>Culture before starting antibiotics for <b>central, large, or sight-threatening ulcers</b>." },
{ q: "What is the initial empiric treatment for bacterial corneal ulcer?", a: "Empiric <b>broad-spectrum topical therapy</b>:<br>• <b>Fortified vancomycin (25–50 mg/mL)</b> + <b>fortified tobramycin (14 mg/mL)</b> — alternating Q30min–1h<br>OR<br>• <b>Fluoroquinolone monotherapy</b> (moxifloxacin 0.5%, gatifloxacin) — Q30min–1h for small-moderate ulcers<br><b>Never patch</b> a potentially infected corneal ulcer (creates warm moist environment → worsens infection).<br>No topical steroids initially." },
{ q: "Why should you never patch an eye with a suspected corneal infection?", a: "Patching creates a <b>warm, dark, moist environment</b> that promotes bacterial proliferation, especially <b>Pseudomonas</b>.<br>It also prevents instillation of topical antibiotics.<br>Rule: <b>Never patch a contact lens–related or potentially infected corneal ulcer.</b>" },
{ q: "What causes HSV keratitis and what is the pathognomonic finding?", a: "Caused by <b>HSV-1</b> (most common) or HSV-2.<br>Pathognomonic finding: <b>Dendritic ulcer</b> — branching, tree-like epithelial lesion with terminal bulbs, best seen with <b>fluorescein staining</b> under cobalt blue light.<br>Rose bengal stains devitalized cells at ulcer margins." },
{ q: "What are the clinical features of HSV keratitis?", a: "• <b>Unilateral</b> red eye with pain, photophobia, tearing<br>• <b>Dendritic ulcer</b> on fluorescein staining<br>• <b>Decreased corneal sensation</b> (pathognomonic — test with wisp of cotton)<br>• History of recurrent episodes, triggered by stress, UV, fever<br>• May have skin vesicles on eyelid<br>• Recurrences can lead to <b>stromal keratitis</b> (immune-mediated → scarring → vision loss)" },
{ q: "What is the treatment for HSV epithelial keratitis?", a: "<b>Topical antivirals</b>:<br>• <b>Ganciclovir 0.15% gel</b> (Zirgan) — 5×/day<br>• <b>Trifluridine 1% drops</b> — Q2h (9×/day), taper over 2–3 weeks<br><b>Oral</b>: <b>Acyclovir 400mg 5×/day</b> or <b>valacyclovir 500mg TID</b> — especially for recurrence or stromal disease<br><b>Debridement</b> of dendritic epithelium may be performed." },
{ q: "Why should topical steroids NEVER be used alone in HSV epithelial keratitis?", a: "Steroids <b>suppress the immune response</b>, allowing <b>unchecked viral replication</b>.<br>This causes:<br>• Dendritic → <b>geographic ulcer</b> (enlarged, amoeboid-shaped)<br>• Deeper corneal involvement<br>• Corneal perforation<br>• Vision loss<br><b>Rule</b>: Never use steroids without concurrent antiviral coverage in HSV keratitis.<br><i>Steroids + antiviral can be used together for HSV stromal keratitis (immune-mediated).</i>" },
{ q: "Differentiate HSV dendritic ulcer from HZV pseudodendrite.", a: "<b>HSV dendrite</b>: true branching with <b>terminal bulbs</b>, central ulceration stains with fluorescein, borders stain with rose bengal<br><b>HZV pseudodendrite</b>: elevated mucous plaque <b>without terminal bulbs</b>, does not have true ulceration, stains poorly with fluorescein<br>HSV → <b>topical antivirals essential</b><br>HZV → treated with <b>oral antivirals (valacyclovir)</b>" },
{ q: "What is the Hutchinson sign and why is it important?", a: "<b>Hutchinson sign</b>: vesicular lesions on the <b>tip, side, or root of the nose</b>.<br>Indicates involvement of the <b>nasociliary branch of V1 (ophthalmic division of trigeminal nerve)</b>.<br>This branch also supplies the eye → strong predictor of <b>ocular involvement</b> in herpes zoster ophthalmicus (HZO).<br><b>50–72% of patients with Hutchinson sign develop ocular complications</b> (keratitis, uveitis, glaucoma)." },
{ q: "How is herpes zoster ophthalmicus (HZO) treated?", a: "<b>Oral antivirals</b> (within 72h of rash onset):<br>• <b>Valacyclovir 1g PO TID × 7 days</b> (preferred)<br>• OR Acyclovir 800mg PO 5×/day × 7–10 days<br>• OR Famciclovir 500mg PO TID × 7 days<br><b>Pain management</b>: analgesics, gabapentin for postherpetic neuralgia<br>If ocular involvement: <b>ophthalmology referral</b> + topical steroids (with antiviral cover) for keratitis/uveitis." },
{ q: "What organisms cause fungal keratitis and what is the classic risk factor?", a: "<b>Filamentous fungi</b>: <b>Aspergillus, Fusarium</b> — classic risk factor: <b>trauma with vegetable/organic matter</b> (tree branch, thorn) in tropical/agricultural settings<br><b>Yeast</b>: <b>Candida</b> — associated with chronic ocular surface disease, immunosuppression, topical steroid use<br>Also: contact lens wear (especially with Fusarium)" },
{ q: "What are the characteristic features of a fungal corneal ulcer?", a: "• <b>Satellite lesions</b> (small infiltrates surrounding main ulcer) — hallmark<br>• <b>Feathery, irregular borders</b> with elevated edges<br>• Gray-white, dry-looking infiltrate<br>• <b>Endothelial plaque</b><br>• Hypopyon (often thick, immobile)<br>• Indolent, slow progression<br>• <b>Worsening despite antibacterial therapy</b>" },
{ q: "How is fungal keratitis treated?", a: "<b>Filamentous fungi</b>: <b>Natamycin 5% topical</b> — first-line<br><b>Yeast (Candida)</b>: <b>Amphotericin B 0.15% topical</b><br><b>Alternative</b>: <b>Voriconazole</b> (topical 1% or oral) — broad-spectrum, good penetration<br>Treatment is prolonged (weeks to months)<br>Corneal scraping/culture essential for diagnosis (Sabouraud agar, calcofluor white stain).<br>Consider <b>therapeutic keratoplasty</b> if perforation threatens." },
{ q: "What is Acanthamoeba keratitis and what is the classic risk factor?", a: "<b>Acanthamoeba keratitis</b> is a rare, severe parasitic keratitis caused by the free-living amoeba <b>Acanthamoeba</b>.<br>Classic risk: <b>contact lens use + exposure to tap/pool/hot tub water</b><br>Also: homemade saline solutions, showering/swimming with lenses<br>Organism exists as trophozoites and resistant <b>cysts</b> (difficult to eradicate)." },
{ q: "What are the clinical features of Acanthamoeba keratitis?", a: "• <b>Severe pain out of proportion to clinical findings</b> — hallmark<br>• <b>Ring-shaped stromal infiltrate</b> (ring infiltrate/abscess) — pathognomonic<br>• <b>Perineural infiltrates</b> (radial keratoneuritis) — early sign<br>• Epithelial irregularity/pseudodendrite (may mimic HSV)<br>• Waxing and waning course<br>• Resistant to standard antibiotics and antivirals" },
{ q: "How is Acanthamoeba keratitis treated?", a: "Prolonged topical combination therapy (months):<br>• <b>PHMB (polyhexamethylene biguanide) 0.02%</b> or <b>chlorhexidine 0.02%</b><br>• PLUS <b>propamidine 0.1% (Brolene)</b> or hexamidine<br>Initially Q1h around the clock, then slowly taper<br>Duration: <b>3–6+ months minimum</b> (to kill cysts)<br>Oral voriconazole may be added in severe cases<br>May eventually need <b>corneal transplant</b> for scarring." },
{ q: "What is anterior uveitis (iritis) and what are its key symptoms?", a: "<b>Anterior uveitis</b> = inflammation of the iris (iritis) ± ciliary body (iridocyclitis).<br>Key symptoms:<br>• <b>Unilateral eye pain</b> (deep, aching)<br>• <b>Photophobia</b><br>• <b>Consensual photophobia</b> (pain when light shone in the OTHER eye — pathognomonic)<br>• <b>Blurred vision</b><br>• <b>Tearing</b> (no discharge)<br>• <b>Ciliary flush</b>" },
{ q: "Why does consensual photophobia occur in anterior uveitis?", a: "Light shone in the <b>unaffected eye</b> causes a <b>consensual pupillary constriction</b> in the <b>inflamed eye</b>.<br>Constriction of the inflamed iris → <b>movement of the inflamed iris tissue</b> → pain.<br>This is <b>pathognomonic for anterior uveitis</b> and distinguishes it from other causes of red eye." },
{ q: "What findings are seen on slit-lamp examination in anterior uveitis?", a: "• <b>Cells</b> — WBCs floating in aqueous humor (Tyndall effect)<br>• <b>Flare</b> — protein-rich exudate making the aqueous beam visible (like a shaft of light in a dusty room)<br>• <b>Keratic precipitates (KPs)</b> — WBC deposits on corneal endothelium<br>• <b>Posterior synechiae</b> — adhesions of iris to anterior lens capsule<br>• Miotic pupil<br>• ± <b>Hypopyon</b> (layered WBCs in AC)" },
{ q: "Differentiate fine (non-granulomatous) from mutton-fat (granulomatous) keratic precipitates.", a: "<b>Fine KPs (non-granulomatous)</b>:<br>• Small, dust-like deposits<br>• Lymphocytes/PMNs<br>• Seen in: HLA-B27 uveitis, idiopathic<br><br><b>Mutton-fat KPs (granulomatous)</b>:<br>• Large, greasy, yellowish deposits<br>• Macrophages/epithelioid cells<br>• Seen in: <b>sarcoidosis, TB, syphilis, VKH syndrome, sympathetic ophthalmia</b>" },
{ q: "What are posterior synechiae and why are they dangerous?", a: "<b>Posterior synechiae</b> = adhesions between the <b>iris and anterior lens capsule</b>.<br>Dangers:<br>• <b>Irregular (festooned) pupil</b> — won't dilate fully<br>• If 360° (seclusio pupillae) → blocks aqueous flow → <b>iris bombé</b> → <b>secondary angle-closure glaucoma</b><br>Prevention: early use of <b>cycloplegics (atropine)</b> to dilate pupil and break/prevent synechiae." },
{ q: "What is the treatment of anterior uveitis?", a: "<b>Cycloplegics</b>: <b>Atropine 1%</b> or cyclopentolate 1% drops — paralyze ciliary body (↓ pain), dilate pupil (prevent/break posterior synechiae)<br><b>Topical corticosteroids</b>: <b>Prednisolone acetate 1%</b> — aggressive initial dosing (Q1–2h), slow taper<br>Treat underlying cause if identified<br><b>Never stop steroids abruptly</b> — rebound inflammation<br>Monitor IOP (steroids can cause glaucoma)" },
{ q: "What is the most common systemic association with anterior uveitis?", a: "<b>HLA-B27</b>–associated diseases:<br>• <b>Ankylosing spondylitis</b> (most common systemic association)<br>• <b>Reactive arthritis</b> (formerly Reiter syndrome: \"can't see, can't pee, can't climb a tree\")<br>• <b>Inflammatory bowel disease</b> (Crohn, UC)<br>• <b>Psoriatic arthritis</b><br>Uveitis is typically <b>acute, recurrent, unilateral</b> (alternating), <b>non-granulomatous</b>." },
{ q: "Describe the classic triad of reactive arthritis and its ocular manifestation.", a: "Classic triad: <b>Conjunctivitis</b> (most common ocular), <b>urethritis</b>, <b>arthritis</b><br>Mnemonic: \"Can't see, can't pee, can't climb a tree\"<br>May also develop <b>anterior uveitis</b> (more specific than conjunctivitis)<br>HLA-B27 positive<br>Triggered by GI (Shigella, Salmonella, Yersinia, Campylobacter) or GU (Chlamydia) infection." },
{ q: "How does sarcoidosis present in the eye?", a: "<b>Bilateral granulomatous uveitis</b> — most common ocular manifestation<br>Features: <b>mutton-fat KPs</b>, iris nodules (<b>Koeppe</b> = pupillary margin, <b>Busacca</b> = iris stroma), posterior synechiae<br>May also have <b>lacrimal gland enlargement</b>, <b>band keratopathy</b> (calcium deposits in Bowman's layer)<br>Can affect any part of the uvea (anterior > posterior > panuveitis)<br>Labs: elevated <b>ACE</b>, bilateral hilar lymphadenopathy on CXR, non-caseating granulomas on biopsy." },
{ q: "What are Koeppe and Busacca nodules?", a: "<b>Koeppe nodules</b>: small white nodules at the <b>pupillary margin</b> of the iris<br><b>Busacca nodules</b>: larger nodules within the <b>iris stroma</b> (not at pupillary margin)<br>Both are <b>granulomatous</b> collections (epithelioid cells + giant cells).<br>Classic finding in <b>sarcoidosis</b>-associated uveitis.<br>Also seen in TB, syphilitic, and VKH uveitis." },
{ q: "How does juvenile idiopathic arthritis (JIA)-associated uveitis present?", a: "Most common in: <b>oligoarticular (pauciarticular) JIA</b>, <b>ANA-positive</b>, <b>young girls</b><br>Uveitis is <b>CHRONIC, BILATERAL, ASYMPTOMATIC</b> (white eye!) — often detected only by screening<br><b>Non-granulomatous</b> anterior uveitis<br>Complications: band keratopathy, posterior synechiae, cataracts, glaucoma, amblyopia<br><b>Regular slit-lamp screening every 3 months</b> is essential." },
{ q: "Why is JIA-associated uveitis dangerous despite being asymptomatic?", a: "Because it is <b>chronic and painless</b>, it can progress silently to:<br>• <b>Band keratopathy</b> (calcium deposits)<br>• <b>Posterior synechiae → secondary glaucoma</b><br>• <b>Cataract</b><br>• <b>Cystoid macular edema</b><br>• <b>Amblyopia</b> (in young children)<br>Without screening, children may present with <b>irreversible vision loss</b>.<br>All JIA patients (especially ANA+ pauciarticular girls) need <b>routine slit-lamp exams</b>." },
{ q: "What is the ocular hallmark of Behçet disease?", a: "<b>Hypopyon uveitis</b> — a shifting hypopyon (WBC layering in AC) that moves with changes in head position.<br>Behçet disease: recurrent oral ulcers + genital ulcers + uveitis<br>Also causes: retinal vasculitis (occlusive), optic neuritis<br>Most common in young men along the Silk Road (Turkey, Middle East, Japan).<br>Associated with <b>HLA-B51</b><br>Treatment: colchicine, azathioprine, anti-TNF agents" },
{ q: "What is band keratopathy?", a: "<b>Band keratopathy</b> = horizontal band-shaped <b>calcium deposition</b> in <b>Bowman's layer</b> and superficial stroma, typically in the interpalpebral fissure.<br>Associations:<br>• <b>Chronic uveitis</b> (especially JIA)<br>• Sarcoidosis<br>• Hypercalcemia/hyperphosphatemia<br>• Chronic ocular disease<br>Treatment: chelation with <b>EDTA</b> or excimer laser." },
{ q: "What infections can cause uveitis?", a: "<b>Anterior</b>: HSV, HZV, syphilis, TB, Lyme disease<br><b>Posterior</b>: <b>Toxoplasmosis</b> (#1 worldwide), CMV, toxocara, TB, syphilis, candida<br><b>Panuveitis</b>: Syphilis (\"the great mimicker\"), TB, endophthalmitis<br>Key rule: <b>Syphilis can cause ANY form of uveitis</b> → always check RPR/VDRL + FTA-ABS in uveitis workup." },
{ q: "What is the 'headlight in the fog' sign?", a: "Classic fundoscopic finding in <b>toxoplasmic retinochoroiditis</b>:<br>An active <b>white/yellow retinal lesion</b> (necrotizing retinitis) seen through <b>overlying vitreous haze</b> (vitritis).<br>Looks like a headlight shining through fog.<br><b>Toxoplasmosis</b> is the #1 cause of posterior uveitis worldwide.<br>Often adjacent to an old <b>pigmented chorioretinal scar</b> (reactivation of congenital infection)." },
{ q: "How is ocular toxoplasmosis treated?", a: "Indicated for sight-threatening lesions (near macula/optic disc), severe vitritis, immunocompromised patients:<br>Classic triple therapy:<br>• <b>Pyrimethamine</b> + <b>sulfadiazine</b> + <b>folinic acid</b> (leucovorin)<br>Alternative: <b>TMP-SMX</b> or clindamycin + pyrimethamine<br>Add <b>systemic corticosteroids</b> (after 24–48h of antimicrobials) for severe inflammation.<br>Duration: 4–6 weeks." },
{ q: "What is the characteristic fundus appearance in CMV retinitis?", a: "<b>Pizza-pie or cottage cheese and ketchup fundus</b>:<br>• <b>Yellow-white fluffy retinal lesions</b> (cottage cheese = areas of retinal necrosis)<br>• <b>Retinal hemorrhages</b> (ketchup)<br>• Perivascular distribution, advancing brush-fire border<br>Seen in <b>severely immunocompromised</b> patients (CD4 < 50 in HIV/AIDS)<br>Can cause retinal detachment" },
{ q: "How is CMV retinitis treated?", a: "<b>First-line</b>: <b>Valganciclovir</b> (oral) or <b>ganciclovir</b> (IV) — induction then maintenance<br><b>Alternatives</b>: foscarnet (for ganciclovir-resistant, nephrotoxic), cidofovir<br><b>Intravitreal ganciclovir</b> injections or implant for severe/refractory cases<br>Most important: <b>Immune reconstitution with ART</b> (HAART) — allows eventual discontinuation of anti-CMV therapy when CD4 > 100 for 3–6 months." },
{ q: "What is intermediate uveitis?", a: "<b>Intermediate uveitis</b> = inflammation primarily of the <b>vitreous</b> and peripheral retina (pars plana).<br>Subtypes: <b>Pars planitis</b> (idiopathic, most common), vitritis<br>Features: <b>floaters</b>, blurred vision, <b>snowbanking</b> (exudate over pars plana), <b>snowballs</b> (vitreous opacities)<br>Associated with <b>multiple sclerosis</b> (especially in young adults)<br>Treatment: periocular/intravitreal steroids, systemic immunosuppression if bilateral/severe." },
{ q: "What is snowbanking and what does it indicate?", a: "<b>Snowbanking</b> = a white-yellow exudate/fibrovascular tissue deposited over the <b>inferior pars plana</b> and peripheral retina.<br>It is the hallmark finding of <b>pars planitis</b> (a form of intermediate uveitis).<br>Best seen with <b>indirect ophthalmoscopy</b> with scleral depression.<br>Associated with <b>multiple sclerosis</b> — consider MRI brain in young adults with pars planitis." },
{ q: "What is the difference between scleritis and episcleritis?", a: "<b>Episcleritis</b>:<br>• Mild discomfort, not severe pain<br>• <b>Sectoral injection</b>, bright red, blanches with phenylephrine 2.5%<br>• Self-limiting (1–2 weeks)<br>• Rarely associated with systemic disease<br>• Treatment: artificial tears, topical NSAIDs<br><br><b>Scleritis</b>:<br>• <b>Severe, boring pain</b> (wakes from sleep, radiates to jaw/temple)<br>• Deep violaceous injection, does NOT blanch with phenylephrine<br>• <b>Scleral edema/thinning</b><br>• Associated with <b>serious systemic disease</b> (50%)<br>• Sight-threatening<br>• Treatment: systemic NSAIDs/steroids/immunosuppressants" },
{ q: "What systemic diseases are associated with scleritis?", a: "• <b>Rheumatoid arthritis</b> (most common association)<br>• <b>Granulomatosis with polyangiitis (Wegener's)</b><br>• <b>Relapsing polychondritis</b><br>• Systemic lupus erythematosus<br>• Polyarteritis nodosa<br>• Inflammatory bowel disease<br>• Ankylosing spondylitis<br>About <b>50% of scleritis patients have an underlying systemic autoimmune disease</b>." },
{ q: "What is the most severe form of scleritis?", a: "<b>Necrotizing scleritis</b> — the most severe and destructive form.<br>Types:<br>• <b>With inflammation</b> — intense pain, scleral necrosis, high risk of perforation<br>• <b>Without inflammation (scleromalacia perforans)</b> — painless scleral thinning, seen in <b>long-standing RA</b>, uveal tissue visible through thin sclera<br>Both require aggressive systemic immunosuppression (cyclophosphamide, rituximab)." },
{ q: "How is episcleritis treated?", a: "<b>Usually self-limiting</b> (1–2 weeks):<br>• <b>Artificial tears/cold compresses</b><br>• <b>Topical NSAIDs</b> (ketorolac) if symptomatic<br>• Oral NSAIDs for more persistent cases<br>Rarely requires topical steroids.<br>No systemic workup typically needed unless recurrent." },
{ q: "What is the phenylephrine blanching test?", a: "Topical <b>phenylephrine 2.5–10%</b> is applied to the eye:<br>• <b>Conjunctival vessels</b> → blanch (superficial)<br>• <b>Episcleral vessels</b> → blanch with higher concentration<br>• <b>Scleral vessels</b> → do NOT blanch<br>Used to differentiate:<br>• <b>Episcleritis</b> (vessels blanch) from <b>scleritis</b> (deep vessels do not blanch)<br>• Conjunctivitis from deeper inflammation" },
{ q: "What is a subconjunctival hemorrhage?", a: "A <b>bright red, well-demarcated, painless</b> area of hemorrhage beneath the conjunctiva.<br>Features: <b>no pain, no discharge, no vision changes</b><br>Causes: spontaneous (Valsalva — cough, sneeze, straining), minor trauma, anticoagulant use, hypertension<br>Treatment: <b>None — self-resolves in 2–3 weeks</b><br>If recurrent: <b>check blood pressure</b>, bleeding disorders, coagulation studies" },
{ q: "When should you be concerned about a subconjunctival hemorrhage?", a: "• <b>Recurrent episodes</b> — check BP, coagulation studies<br>• <b>Bilateral</b> — consider bleeding disorder<br>• <b>Associated with trauma</b> — rule out globe rupture (scleral laceration may be hidden underneath)<br>• <b>360° (circumferential)</b> in trauma — high suspicion for <b>occult globe rupture</b><br>• Post-surgical — may indicate wound leak" },
{ q: "What is a corneal abrasion and how does it present?", a: "A <b>traumatic defect of the corneal epithelium</b>.<br>Symptoms: sudden onset <b>pain, foreign body sensation</b>, tearing, photophobia, blurred vision<br>Diagnosis: <b>fluorescein staining</b> — defect glows bright green under cobalt blue light<br>Always <b>evert the eyelid</b> to look for a foreign body under the upper lid." },
{ q: "How is a corneal abrasion treated?", a: "• <b>Topical antibiotics</b> prophylaxis: erythromycin ointment or fluoroquinolone drops QID<br>• <b>Cycloplegic drops</b> (cyclopentolate) for pain relief (reduces ciliary spasm)<br>• Oral analgesics (NSAIDs, acetaminophen)<br>• Topical NSAIDs (ketorolac) for pain<br>• <b>NO patching for contact lens wearers</b> (risk of Pseudomonas)<br>• Follow up in 24–48 hours<br>• Most heal in <b>24–72 hours</b>" },
{ q: "What is a pterygium and what causes it?", a: "A <b>wing-shaped fibrovascular growth</b> of conjunctival tissue extending onto the <b>cornea</b>.<br>Typically on the <b>nasal side</b>.<br>Risk factors: <b>UV light exposure</b>, wind, dust (outdoor workers, near equator)<br>Symptoms: irritation, foreign body sensation, cosmetic concern<br>Can cause <b>astigmatism</b> and visual impairment if it encroaches on the visual axis." },
{ q: "How is a pterygium treated?", a: "<b>Conservative</b>: artificial tears, sunglasses (UV protection)<br><b>Surgical excision</b> is indicated if:<br>• Encroaching on <b>visual axis</b><br>• Causing significant <b>astigmatism</b><br>• Cosmetically bothersome<br>• Restricting ocular motility<br>Recurrence is common (~30–40%) with bare sclera technique.<br><b>Conjunctival autograft</b> or <b>mitomycin C</b> reduces recurrence." },
{ q: "How does a pterygium differ from a pinguecula?", a: "<b>Pterygium</b>: fibrovascular growth that <b>crosses the limbus</b> onto the cornea, wing-shaped, nasal > temporal<br><b>Pinguecula</b>: yellowish, slightly elevated deposit on the <b>conjunctiva only</b> — does NOT cross the limbus<br>Both associated with UV exposure.<br>Pinguecula: observation, artificial tears<br>Pterygium: surgery if encroaching on visual axis" },
{ q: "What is a pinguecula composed of?", a: "A pinguecula consists of <b>elastotic degeneration</b> of conjunctival collagen:<br>• Hyaline and elastic tissue deposits<br>• <b>Actinic (UV) damage</b> to subepithelial collagen<br>Located on the bulbar conjunctiva in the <b>interpalpebral fissure</b> (nasal > temporal).<br>It can become inflamed (<b>pingueculitis</b>) — treat with topical NSAIDs or mild steroids." },
{ q: "What is the differential diagnosis for a hypopyon?", a: "<b>Hypopyon</b> = layered WBCs in the anterior chamber.<br>Differential:<br>• <b>Severe bacterial keratitis</b> (corneal ulcer)<br>• <b>Endophthalmitis</b> (postoperative or endogenous)<br>• <b>Behçet disease</b> (shifting, sterile hypopyon)<br>• <b>HLA-B27 anterior uveitis</b> (severe cases)<br>• <b>Masquerade syndromes</b>: retinoblastoma (children), leukemia, lymphoma (pseudohypopyon — tumor cells)" },
{ q: "What is the workup for a first episode of anterior uveitis?", a: "Minimal workup for a first episode in a young, healthy patient (most are idiopathic).<br>For recurrent, bilateral, or granulomatous uveitis:<br>• <b>HLA-B27</b><br>• <b>CBC, ESR, CRP</b><br>• <b>CXR</b> (sarcoidosis, TB)<br>• <b>RPR/VDRL + FTA-ABS</b> (syphilis — always rule out)<br>• <b>ACE level</b> (sarcoidosis)<br>• <b>PPD or QuantiFERON-Gold</b> (TB)<br>• <b>ANA</b> (JIA in children, lupus)" },
{ q: "A patient presents with acute red eye, severe pain, halos around lights, nausea/vomiting, and a mid-dilated fixed pupil. What is the diagnosis?", a: "<b>Acute angle-closure glaucoma</b><br>Features: severely elevated IOP (>40 mmHg), corneal edema (hazy), <b>mid-dilated, fixed pupil</b>, shallow anterior chamber<br>Treatment: <b>topical timolol + pilocarpine + apraclonidine + IV acetazolamide + IV mannitol</b><br>Definitive: <b>laser peripheral iridotomy</b> (both eyes — fellow eye is prophylactic)" },
{ q: "Compare the pupil findings in acute glaucoma vs anterior uveitis.", a: "<b>Acute angle-closure glaucoma</b>: <b>mid-dilated, fixed, unreactive</b> pupil<br><b>Anterior uveitis</b>: <b>miotic (constricted)</b> pupil due to inflammatory spasm of sphincter<br>This is a key differentiating feature on physical exam." },
{ q: "What type of discharge suggests each category of conjunctivitis?", a: "<b>Mucopurulent (thick yellow-green)</b> → Bacterial<br><b>Copious purulent (overflowing pus)</b> → Gonococcal (hyperacute)<br><b>Watery (serous)</b> → Viral<br><b>Stringy/mucoid + watery</b> → Allergic<br><b>Mucopurulent + chronic</b> → Chlamydial" },
{ q: "What is chemosis?", a: "<b>Chemosis</b> = edema (swelling) of the <b>conjunctiva</b>, creating a watery, gelatinous, balloon-like appearance.<br>The conjunctiva may even prolapse over the lid margin.<br>Causes:<br>• <b>Allergic conjunctivitis</b> (most common)<br>• Anaphylaxis<br>• Orbital cellulitis<br>• Cavernous sinus thrombosis<br>• Thyroid eye disease" },
{ q: "What is endophthalmitis and how does it present?", a: "<b>Endophthalmitis</b> = infection of the intraocular fluids (vitreous and/or aqueous).<br><b>Exogenous</b> (most common): post-cataract surgery (S. epidermidis #1), post-intravitreal injection, post-trauma<br><b>Endogenous</b>: hematogenous spread (Candida, S. aureus — IV drug use, immunocompromised)<br>Presents: <b>pain, ↓↓ vision, hypopyon, lid edema, absent red reflex</b><br>Treatment: <b>intravitreal antibiotics (vancomycin + ceftazidime)</b> ± vitrectomy" },
{ q: "What organisms are most common in post-surgical endophthalmitis?", a: "<b>Acute</b> (within days): <b>Staphylococcus epidermidis</b> (#1), S. aureus, Streptococcus spp.<br><b>Delayed/chronic</b> (weeks-months): <b>Propionibacterium acnes</b> (now Cutibacterium), fungal<br>Post-trauma: <b>Bacillus cereus</b> (fulminant, poor prognosis)<br>Treatment: intravitreal vancomycin + ceftazidime ± pars plana vitrectomy (per EVS guidelines if vision is LP or worse)." },
{ q: "What is the Endophthalmitis Vitrectomy Study (EVS) key finding?", a: "The <b>EVS</b> (1995) studied post-cataract surgery endophthalmitis:<br>Key finding: <b>Immediate vitrectomy</b> improved outcomes only when presenting vision was <b>light perception (LP) or worse</b>.<br>For patients with <b>better than LP vision</b>: vitreous tap/biopsy + intravitreal antibiotics was equally effective.<br>Systemic antibiotics (IV) did <b>NOT</b> improve outcomes." },
{ q: "What is sympathetic ophthalmia?", a: "<b>Sympathetic ophthalmia</b> = bilateral <b>granulomatous panuveitis</b> occurring after <b>penetrating trauma or surgery</b> to one eye.<br>The injured eye = <b>exciting eye</b>; the fellow eye = <b>sympathizing eye</b>.<br>Mechanism: autoimmune response to <b>uveal/retinal antigens</b> exposed by trauma.<br>Onset: 2 weeks to years after injury (most within 3 months).<br>Treatment: aggressive immunosuppression (steroids + steroid-sparing agents). Enucleation of exciting eye considered if done <b>within 2 weeks</b> of injury." },
{ q: "What is Vogt-Koyanagi-Harada (VKH) disease?", a: "<b>VKH</b> = bilateral granulomatous panuveitis with <b>exudative retinal detachments</b>.<br>Associated with: <b>poliosis</b> (whitening of eyelashes/hair), <b>vitiligo</b>, <b>alopecia</b>, <b>dysacusis</b> (hearing loss), meningeal signs<br>Autoimmune against <b>melanocytes</b><br>More common in: Asians, Hispanics, Native Americans<br>Histology: granulomatous inflammation similar to sympathetic ophthalmia but <b>no prior trauma</b><br>Treatment: high-dose systemic corticosteroids + immunosuppressive agents" },
{ q: "What is Fuchs heterochromic iridocyclitis?", a: "<b>Fuchs heterochromic iridocyclitis</b>: chronic, low-grade, <b>unilateral</b> anterior uveitis.<br>Features:<br>• <b>Heterochromia</b> — affected iris is <b>lighter</b> (stromal atrophy)<br>• Fine, diffuse, stellate KPs<br>• Minimal cells/flare, no posterior synechiae<br>• Complications: <b>cataract</b> (most common), secondary glaucoma<br>• Does NOT respond to steroids (steroids not recommended)<br>• Usually does not require treatment unless complications arise" },
{ q: "What is the most common cause of unilateral red eye with dendritic corneal ulcer and decreased corneal sensation?", a: "<b>HSV keratitis</b><br>Dendritic ulcer with terminal bulbs = pathognomonic<br>Decreased corneal sensation due to damage to corneal nerves by HSV<br>Test: cotton wisp test — compare both eyes<br>Treatment: topical ganciclovir or trifluridine + oral acyclovir/valacyclovir" },
{ q: "A contact lens wearer presents with severe pain out of proportion to exam, ring-shaped corneal infiltrate. Diagnosis?", a: "<b>Acanthamoeba keratitis</b><br>Key features: contact lens + tap water exposure, pain out of proportion, ring infiltrate, perineural infiltrates<br>Treatment: PHMB + propamidine (prolonged course, months)" },
{ q: "A farmer is hit in the eye by a tree branch and develops a corneal ulcer with satellite lesions and feathery borders. Diagnosis and treatment?", a: "<b>Fungal keratitis</b> (likely <b>Aspergillus or Fusarium</b>)<br>Key clues: organic/vegetable matter trauma, satellite lesions, feathery borders, slow progression<br>Treatment: <b>Natamycin 5% topical</b> (first-line for filamentous fungi)<br>Culture on Sabouraud dextrose agar" },
{ q: "What is the most common infectious cause of blindness worldwide?", a: "<b>Trachoma</b> — caused by <b>Chlamydia trachomatis serotypes A, B, Ba, C</b>.<br>Repeated infection → scarring (Arlt's line) → trichiasis → corneal opacification → blindness.<br>Prevention: <b>SAFE strategy</b> (Surgery, Antibiotics, Facial cleanliness, Environmental improvement)." },
{ q: "What organisms cause neonatal conjunctivitis at days 2–5 of life?", a: "<b>Neisseria gonorrhoeae</b> — onset at <b>2–5 days</b><br>Copious purulent discharge, lid swelling<br>Can rapidly perforate the cornea<br>Treatment: systemic ceftriaxone + topical erythromycin + saline irrigation<br>This is earlier than chlamydial (5–14 days) because gonococci have a shorter incubation period." },
{ q: "A newborn develops conjunctivitis at 10 days of life. Most likely cause?", a: "<b>Chlamydia trachomatis</b> (serotypes D–K)<br>Onset: <b>5–14 days of life</b> — most common infectious cause of ophthalmia neonatorum<br>Features: mucopurulent discharge, lid swelling, follicles are absent in neonates (immature lymphoid tissue)<br>Treatment: <b>oral erythromycin × 14 days</b> (prevents chlamydial pneumonia)" },
{ q: "Why is silver nitrate prophylaxis no longer preferred for ophthalmia neonatorum?", a: "Silver nitrate:<br>• Causes <b>chemical conjunctivitis</b> within 24 hours (most common cause of Day 1 neonatal conjunctivitis)<br>• <b>NOT effective against Chlamydia</b> trachomatis<br>Replaced by <b>erythromycin 0.5% ointment</b> — effective against both gonococcal and partially against chlamydial ophthalmia neonatorum." },
{ q: "What is the most common cause of conjunctivitis overall?", a: "<b>Adenovirus</b> — viral conjunctivitis is the most common cause of conjunctivitis in adults.<br>Features: watery discharge, follicular reaction, preauricular lymphadenopathy, highly contagious.<br>Self-limiting, supportive care only." },
{ q: "What finding on slit lamp confirms an anterior chamber reaction?", a: "<b>Cells and flare</b>:<br>• <b>Cells</b> = WBCs suspended in aqueous, visible as tiny white particles in a narrow slit beam<br>• <b>Flare</b> = protein leakage into aqueous, making the beam itself visible (Tyndall effect)<br>Graded 0 to 4+ based on density<br>Confirms <b>anterior uveitis/iritis</b>." },
{ q: "What is the role of fluorescein staining in red eye evaluation?", a: "<b>Fluorescein</b> is an orange dye that highlights <b>epithelial defects</b> on the cornea and conjunctiva.<br>Under <b>cobalt blue light</b>, dye pools in areas of missing epithelium → glows bright green.<br>Detects:<br>• Corneal abrasion<br>• Corneal ulcer<br>• HSV dendritic ulcer<br>• Contact lens-related erosion<br>• Seidel test positive = aqueous leak (penetrating injury)" },
{ q: "What is the Seidel test?", a: "The <b>Seidel test</b> detects <b>aqueous humor leakage</b> from a corneal/scleral wound (full-thickness perforation).<br>Technique: apply concentrated fluorescein to wound → observe under cobalt blue light.<br><b>Positive</b>: aqueous dilutes/washes away the fluorescein in a streaming pattern → <b>indicates open globe injury</b>.<br>Requires emergent ophthalmology consultation and surgical repair." },
{ q: "What is a corneal foreign body and how is it managed?", a: "Metallic, glass, or organic material embedded in the cornea.<br>Diagnosis: slit-lamp exam, evert upper eyelid to check for subtarsal foreign body<br>Management:<br>• Topical anesthesia (proparacaine)<br>• <b>Remove under slit lamp with needle or spud</b><br>• If metallic: remove <b>rust ring</b> with burr (can be deferred 24h)<br>• <b>Topical antibiotic</b> (fluoroquinolone) after removal<br>• Tetanus prophylaxis if not current" },
{ q: "What ocular condition is associated with rheumatoid arthritis?", a: "RA is associated with multiple ocular conditions:<br>• <b>Keratoconjunctivitis sicca (dry eyes)</b> — most common (Sjögren syndrome overlap)<br>• <b>Scleritis</b> (especially necrotizing → scleromalacia perforans)<br>• <b>Episcleritis</b><br>• Peripheral ulcerative keratitis (PUK) — corneal melt<br>RA is the <b>#1 systemic disease associated with scleritis</b>." },
{ q: "What is peripheral ulcerative keratitis (PUK)?", a: "<b>PUK</b> = progressive peripheral corneal thinning/ulceration at the limbus, often with overlying epithelial defect.<br>Associated with systemic autoimmune diseases:<br>• <b>Rheumatoid arthritis</b> (most common)<br>• Granulomatosis with polyangiitis (Wegener's)<br>• SLE, PAN<br>Can progress to <b>corneal perforation</b> (corneal melt).<br>Treatment: systemic immunosuppression (not just topical)." },
{ q: "A patient with ankylosing spondylitis presents with acute unilateral eye pain, photophobia, and ciliary flush. Most likely diagnosis?", a: "<b>Acute anterior uveitis (iritis)</b><br>Most common extra-articular manifestation of <b>ankylosing spondylitis</b><br>HLA-B27 associated, non-granulomatous, recurrent, alternates between eyes<br>Treatment: topical steroids + cycloplegics" },
{ q: "What is the difference between iritis, iridocyclitis, and panuveitis?", a: "<b>Iritis</b>: inflammation of the <b>iris only</b> (anterior chamber cells/flare)<br><b>Iridocyclitis</b>: inflammation of <b>iris + ciliary body</b> (anterior chamber + anterior vitreous cells)<br><b>Panuveitis</b>: inflammation of <b>entire uveal tract</b> (anterior chamber + vitreous + retina/choroid)<br>Anatomic classification: anterior, intermediate, posterior, panuveitis" },
{ q: "What drugs can cause uveitis as a side effect?", a: "Drug-induced uveitis:<br>• <b>Rifabutin</b> (used in MAC prophylaxis — bilateral, hypopyon)<br>• <b>Cidofovir</b> (used for CMV)<br>• <b>Bisphosphonates</b> (pamidronate, alendronate)<br>• <b>Sulfonamides</b><br>• <b>Checkpoint inhibitors</b> (ipilimumab, nivolumab)<br>• Fluoroquinolones (rare)<br>• TNF-alpha inhibitors (paradoxical)" },
{ q: "What is the role of cycloplegics in anterior uveitis treatment?", a: "<b>Cycloplegics</b> (atropine, cyclopentolate, homatropine) serve 2 purposes:<br>1. <b>Pain relief</b> — paralyze the ciliary muscle → reduce ciliary spasm<br>2. <b>Prevent/break posterior synechiae</b> — dilate the pupil to keep iris from adhering to lens capsule<br>Atropine (long-acting, 1–2 weeks) is preferred for significant inflammation." },
{ q: "What is iris bombé?", a: "<b>Iris bombé</b> = forward bowing of the entire iris due to <b>360° posterior synechiae (seclusio pupillae)</b>.<br>Aqueous cannot pass from posterior to anterior chamber → builds up behind iris → pushes iris forward.<br>Causes <b>secondary angle-closure glaucoma</b>.<br>Treatment: <b>laser iridotomy</b> (create alternate pathway for aqueous), intensive topical steroids + cycloplegics, IOP-lowering agents." },
{ q: "What is rose bengal staining used for?", a: "<b>Rose bengal</b> stains <b>devitalized and dead epithelial cells</b> and mucus.<br>Clinical uses:<br>• <b>HSV keratitis</b> — stains the edges of dendritic ulcer (dead cells around ulcer margins)<br>• <b>Dry eye (keratoconjunctivitis sicca)</b> — stains interpalpebral conjunctiva/cornea<br>Differs from fluorescein which stains areas of <b>epithelial defect</b> (missing cells)." },
{ q: "What is the most common complication of topical corticosteroid use in the eye?", a: "• <b>Steroid-induced glaucoma</b> (elevated IOP) — occurs in ~30% of the general population, more common in \"steroid responders\"<br>• <b>Posterior subcapsular cataract</b> — with prolonged use<br>• <b>Increased susceptibility to infections</b> (HSV reactivation, fungal keratitis)<br>• Delayed wound healing<br>Always <b>monitor IOP</b> in patients on chronic topical steroids." },
{ q: "What type of cataract is associated with chronic steroid use?", a: "<b>Posterior subcapsular cataract (PSC)</b><br>Develops with <b>chronic systemic or topical corticosteroid</b> use.<br>Symptoms: <b>glare</b> (especially in bright light/driving at night), reading difficulty<br>Location: posterior lens surface, central axis<br>Also associated with: diabetes, uveitis, retinitis pigmentosa, radiation." },
{ q: "What is the most common cause of posterior uveitis worldwide?", a: "<b>Toxoplasma gondii</b> — retinochoroiditis<br>Usually reactivation of <b>congenital infection</b><br>Classic findings: focal necrotizing retinitis adjacent to an old pigmented scar (\"satellite lesion\"), vitritis (headlight in fog)<br>Treatment: pyrimethamine + sulfadiazine + folinic acid<br>Alternative: TMP-SMX" },
{ q: "What is toxocara and how does it affect the eye?", a: "<b>Toxocara canis/cati</b> — roundworm infection acquired from <b>dog/cat feces (contaminated soil)</b><br>Ocular toxocariasis: presents in children as <b>unilateral</b> posterior uveitis<br>Findings: <b>peripheral granuloma</b>, posterior pole granuloma, endophthalmitis<br>Can mimic <b>retinoblastoma</b> (leukocoria)<br>Diagnose with <b>ELISA for Toxocara antibodies</b><br>Treatment: periocular/systemic steroids ± albendazole" },
{ q: "How do you differentiate ocular toxocariasis from retinoblastoma?", a: "Both present with <b>leukocoria</b> (white pupillary reflex) in children.<br><b>Retinoblastoma</b>: <b>calcification</b> on CT/ultrasound, bilateral in 30%, mean age 18 months<br><b>Toxocariasis</b>: <b>no calcification</b>, always unilateral, positive Toxocara ELISA, history of pica/exposure to puppies<br><b>DO NOT biopsy</b> — risk of tumor seeding if retinoblastoma, risk of severe inflammation if toxocara." },
{ q: "What is preseptal vs orbital cellulitis and how are they distinguished?", a: "<b>Preseptal</b>: infection anterior to orbital septum — lid swelling, warmth, no proptosis, <b>normal eye movements/vision</b><br><b>Orbital</b>: infection posterior to septum — proptosis, <b>ophthalmoplegia (painful EOM restriction)</b>, decreased vision, afferent pupillary defect, <b>MEDICAL EMERGENCY</b><br>Orbital cellulitis: CT orbits + IV antibiotics (vancomycin + ceftriaxone or ampicillin-sulbactam), possible surgical drainage<br>Most common cause: <b>ethmoid sinusitis</b> extension" },
{ q: "What is a marginal keratitis and how does it differ from an infectious ulcer?", a: "<b>Marginal keratitis</b>: sterile, peripheral corneal infiltrates due to <b>hypersensitivity reaction to staphylococcal exotoxins</b> from chronic blepharitis.<br>Key differences from infectious ulcer:<br>• Located <b>peripherally</b> (near limbus) with a <b>clear zone</b> between infiltrate and limbus<br>• <b>Less pain, smaller, no hypopyon</b><br>• Culture-negative<br>Treatment: topical steroids (after ruling out infection) + treat underlying blepharitis" },
{ q: "What is interstitial keratitis and what causes it?", a: "<b>Interstitial keratitis (IK)</b> = non-ulcerative inflammation of the corneal <b>stroma</b> without primary epithelial or endothelial involvement.<br>Classic cause: <b>congenital syphilis</b> (bilateral, occurs in late childhood/adolescence) — part of Hutchinson's triad (IK + Hutchinson teeth + CN VIII deafness)<br>Also: TB, Cogan syndrome (IK + vestibulo-auditory dysfunction), HSV, EBV, Lyme<br>Treatment: topical steroids + treat underlying cause" },
{ q: "What is Hutchinson's triad in congenital syphilis?", a: "<b>Hutchinson's triad</b> (late congenital syphilis):<br>1. <b>Interstitial keratitis</b> (bilateral, corneal clouding + vascularization)<br>2. <b>Hutchinson teeth</b> (notched, peg-shaped upper central incisors)<br>3. <b>Eighth nerve deafness</b> (sensorineural hearing loss)<br>Caused by <b>Treponema pallidum</b>, transmitted transplacentally." },
{ q: "What is Cogan syndrome?", a: "<b>Cogan syndrome</b>: rare inflammatory disorder featuring:<br>1. <b>Interstitial keratitis</b> (nonsyphilitic)<br>2. <b>Vestibuloauditory dysfunction</b> (vertigo, tinnitus, sensorineural hearing loss — resembles Ménière disease)<br>May be associated with <b>systemic vasculitis</b> (aortitis, coronary arteritis)<br>Affects young adults<br>Treatment: topical steroids for keratitis, systemic steroids/immunosuppressants for systemic disease" },
{ q: "What is the difference between a corneal ulcer and a corneal infiltrate?", a: "<b>Corneal infiltrate</b>: collection of inflammatory cells in stroma <b>without overlying epithelial defect</b> → does NOT stain with fluorescein (or minimal staining)<br><b>Corneal ulcer</b>: stromal infiltrate <b>with overlying epithelial defect</b> → stains with fluorescein<br>Ulcers are more likely infectious and require culture + aggressive treatment.<br>Sterile infiltrates (contact lens-related) may be observed with close follow-up." },
{ q: "What is Thygeson's superficial punctate keratitis?", a: "<b>Thygeson's SPK</b>: bilateral, chronic, relapsing corneal disease of unknown etiology.<br>Features: multiple, coarse, <b>stellate (star-shaped) epithelial opacities</b> with minimal to no conjunctival injection or anterior chamber reaction<br>Symptoms: foreign body sensation, tearing, photophobia<br>Treatment: <b>soft contact lens</b> (therapeutic) or low-dose topical steroids or cyclosporine<br>Benign course, does not cause permanent vision loss" },
{ q: "What is exposure keratopathy?", a: "<b>Exposure keratopathy</b>: corneal damage from <b>inadequate eyelid closure</b> (incomplete blink or lagophthalmos).<br>Causes: Bell's palsy (CN VII), thyroid eye disease, post-surgical, severe proptosis<br>Inferior cornea dries out → punctate epithelial erosions → ulceration → perforation if untreated<br>Treatment: artificial tears, lubricating ointment, moisture chambers, taping lids shut at night, tarsorrhaphy in severe cases" },
{ q: "What is neurotrophic keratitis?", a: "<b>Neurotrophic keratitis</b>: corneal epithelial breakdown due to <b>loss of corneal innervation</b> (CN V/trigeminal nerve damage).<br>Causes: HSV/HZV keratitis (most common), acoustic neuroma surgery, trigeminal ablation, diabetes<br>Features: <b>absent corneal reflex</b>, persistent epithelial defects, smooth-bordered ulcers, quiet/white eye<br>Treatment: preservative-free artificial tears, bandage contact lens, autologous serum drops, tarsorrhaphy, cenegermin (recombinant nerve growth factor)." },
{ q: "What is recurrent corneal erosion syndrome?", a: "<b>Recurrent corneal erosion</b>: episodic spontaneous breakdown of corneal epithelium, typically upon waking.<br>History: prior corneal abrasion (especially fingernail/paper cut) or <b>epithelial basement membrane dystrophy (EBMD)</b><br>Symptoms: sudden <b>sharp pain upon awakening</b>, tearing, photophobia<br>Mechanism: poor adhesion of regenerated epithelium to basement membrane<br>Treatment: nighttime lubricating ointment, hypertonic saline (5% NaCl), bandage contact lens, anterior stromal micropuncture, phototherapeutic keratectomy (PTK)" },
{ q: "What is a geographic ulcer and when does it occur?", a: "A <b>geographic ulcer</b> is an enlarged, amoeboid-shaped corneal epithelial defect that results from <b>coalescence of HSV dendritic ulcers</b>.<br>Typically occurs when:<br>• HSV keratitis is <b>mistreated with topical steroids without antiviral cover</b><br>• Immunosuppression<br>• Inadequate antiviral therapy<br>It indicates <b>active viral replication</b> with a wider area of epithelial destruction.<br>Treatment: aggressive topical + oral antivirals, debridement." },
{ q: "What is the HEDS (Herpetic Eye Disease Study) key takeaway?", a: "The <b>HEDS</b> demonstrated:<br>• <b>Oral acyclovir 400mg BID</b> as long-term prophylaxis <b>reduces recurrence</b> of HSV keratitis and stromal keratitis by ~50%.<br>• Topical steroids are beneficial for HSV <b>stromal keratitis</b> (immune-mediated) when combined with antiviral cover.<br>• Oral acyclovir does not benefit acute epithelial keratitis but prevents recurrence." },
{ q: "What is HSV stromal keratitis and how is it treated?", a: "<b>HSV stromal keratitis</b> = immune-mediated inflammation of the corneal stroma (not active viral replication).<br>Features: corneal edema/haze, neovascularization, ring infiltrate, lipid keratopathy, intact epithelium<br>Treatment:<br>• <b>Topical steroids (prednisolone)</b> — to reduce immune-mediated damage<br>• <b>WITH concurrent topical/oral antiviral coverage</b> (to prevent viral reactivation from steroids)<br>This is the <b>one scenario where steroids are used in HSV keratitis</b>." },
{ q: "What is the most common cause of infectious corneal ulcer in contact lens wearers?", a: "<b>Pseudomonas aeruginosa</b><br>Risk factors: extended wear, sleeping in lenses, poor hygiene, swimming/showering with lenses<br>Can progress to corneal perforation within 24–48 hours<br>Treatment: topical fluoroquinolone or fortified aminoglycoside, NO patching." },
{ q: "What systemic condition should be screened for in a child with chronic, asymptomatic bilateral anterior uveitis?", a: "<b>Juvenile idiopathic arthritis (JIA)</b><br>Specifically: <b>oligoarticular (pauciarticular), ANA-positive, young girls</b><br>Uveitis is chronic, bilateral, and WHITE (no redness) — often only detected on routine slit-lamp screening<br>Can lead to band keratopathy, cataracts, glaucoma, amblyopia if missed<br>Screen with slit lamp every 3 months" },
{ q: "What is a Mooren ulcer?", a: "<b>Mooren ulcer</b>: idiopathic, progressive <b>peripheral corneal ulceration</b> that is NOT associated with systemic disease (unlike PUK).<br>Features:<br>• Starts peripherally, progresses centrally and circumferentially<br>• Undermined, overhanging central edge<br>• Painful, with significant conjunctival injection<br>• <b>Diagnosis of exclusion</b> (rule out infectious and autoimmune causes)<br>Treatment: topical steroids, conjunctival resection, systemic immunosuppression, limbal stem cell transplant" },
{ q: "What are the components of the aqueous humor outflow pathway?", a: "<b>Aqueous humor</b> (produced by ciliary body) flows:<br>Posterior chamber → through pupil → anterior chamber →<br><b>Conventional (trabecular) pathway (85–90%)</b>: trabecular meshwork → Schlemm's canal → collector channels → episcleral veins<br><b>Uveoscleral (unconventional) pathway (10–15%)</b>: through ciliary muscle interstitial spaces → suprachoroidal space<br>Obstruction → elevated IOP → glaucoma" },
{ q: "What is the significance of preauricular lymphadenopathy in red eye?", a: "<b>Preauricular lymphadenopathy</b> = tender, enlarged lymph node anterior to the ear (parotid region).<br>Indicates <b>viral or chlamydial</b> conjunctivitis:<br>• <b>Adenoviral conjunctivitis</b> (most common cause)<br>• Chlamydial inclusion conjunctivitis<br>• HSV keratitis/conjunctivitis<br>• Parinaud oculoglandular syndrome (cat-scratch disease)<br>Typically <b>absent</b> in bacterial and allergic conjunctivitis." },
{ q: "What is Parinaud oculoglandular syndrome?", a: "<b>Parinaud oculoglandular syndrome</b>: unilateral conjunctivitis with <b>ipsilateral, markedly enlarged preauricular and submandibular lymphadenopathy</b>.<br>Causes:<br>• <b>Cat-scratch disease (Bartonella henselae)</b> — most common<br>• Tularemia (Francisella tularensis)<br>• Sporotrichosis<br>• TB, syphilis<br>Treatment depends on cause; Bartonella: azithromycin" },
{ q: "What is the significance of a hyphema in the context of red eye?", a: "<b>Hyphema</b> = blood in the anterior chamber, usually from <b>trauma</b> (blunt injury tearing iris vessels).<br>Graded by amount: Grade 1 (<1/3 AC) to Grade 4 (total — \"8-ball\" hyphema)<br>Complications: <b>rebleed</b> (days 3–5), elevated IOP, corneal blood staining<br>Treatment: upright position (30°), bed rest, topical steroids + cycloplegic, <b>avoid aspirin/NSAIDs</b>, shield eye<br>Screen for <b>sickle cell</b> trait/disease in African American patients (sickling in AC → elevated IOP)" },
{ q: "What is giant papillary conjunctivitis (GPC)?", a: "<b>GPC</b>: large papillae (>1 mm) on the <b>upper tarsal conjunctiva</b>, resembling cobblestones.<br>Causes: <b>contact lens wear</b> (most common), ocular prosthesis, exposed sutures, scleral buckle<br>Mechanism: <b>mechanical irritation + Type IV hypersensitivity</b> to deposits on lens surface<br>Symptoms: itching, mucoid discharge, lens intolerance<br>Treatment: discontinue/change lens type, mast cell stabilizers, frequent lens replacement, preservative-free care solutions" },
{ q: "What is the difference between a papillary and follicular response?", a: "<b>Papillary</b>: flat-topped elevations with <b>central vascular core</b>, red → <b>allergic and bacterial</b><br><b>Follicular</b>: rounded, avascular, pale/white lymphoid aggregates with vessels <b>around</b> them → <b>viral and chlamydial</b><br><br>Mnemonics:<br>• <b>Papillae</b> = <b>P</b>urulent (bacteria) and allergic<br>• <b>Follicles</b> = viral and chlamydial (<b>F</b>ollicles = like <b>F</b>ollicles of lymphoid tissue)" },
{ q: "What is Lissamine green staining and when is it used?", a: "<b>Lissamine green</b> stains <b>devitalized/dead epithelial cells</b> (similar to rose bengal but less irritating).<br>Used for:<br>• <b>Dry eye disease</b> — stains conjunctival and corneal epithelial damage<br>• Evaluating ocular surface disease<br>• Better tolerated than rose bengal<br>Unlike fluorescein (which stains areas of epithelial loss), lissamine green stains cells that are <b>present but damaged</b>." },
{ q: "What percentage of acute anterior uveitis cases are idiopathic?", a: "Approximately <b>50%</b> of acute anterior uveitis cases are <b>idiopathic</b> (no identifiable systemic cause).<br>This is why a first episode in a young, healthy patient may require <b>limited workup</b>.<br>Full systemic workup is reserved for: <b>recurrent, bilateral, granulomatous, posterior, pediatric, or refractory</b> uveitis." },
{ q: "What is the triad of findings in herpes zoster ophthalmicus?", a: "1. <b>Vesicular dermatomal rash</b> in V1 distribution (does NOT cross midline)<br>2. <b>Hutchinson sign</b> (nasociliary involvement → tip of nose lesion)<br>3. <b>Ocular complications</b>: keratitis (pseudodendrites), uveitis, elevated IOP, cranial nerve palsies (III, IV, VI), postherpetic neuralgia<br>Treatment: oral antivirals (valacyclovir) within 72h + ophthalmology referral" },
{ q: "What is an afferent pupillary defect (APD/RAPD) and is it seen in red eye conditions?", a: "<b>Relative afferent pupillary defect (RAPD/Marcus Gunn pupil)</b>: detected by swinging flashlight test — affected pupil <b>dilates</b> when light is swung to it from the normal eye.<br>Indicates optic nerve or extensive retinal disease on the affected side.<br>In red eye: generally <b>absent</b> in conjunctivitis, keratitis, anterior uveitis<br><b>Present</b> in: severe optic neuritis, central retinal artery/vein occlusion, orbital cellulitis compressing optic nerve, severe posterior uveitis" },
{ q: "What is the otitis-conjunctivitis syndrome?", a: "<b>Otitis-conjunctivitis syndrome</b>: concurrent <b>acute otitis media + purulent conjunctivitis</b>, typically in children.<br>Most common organism: <b>nontypeable Haemophilus influenzae</b><br>Treatment: <b>oral amoxicillin-clavulanate</b> (covers H. influenzae including β-lactamase producers) + topical antibiotic drops<br>A systemic antibiotic is needed because of the concurrent AOM." },
{ q: "What stains are used to identify specific organisms in corneal scrapings?", a: "<b>Gram stain</b>: bacteria (Gram-positive vs Gram-negative)<br><b>Giemsa stain</b>: Chlamydia (basophilic intracytoplasmic inclusions), Acanthamoeba<br><b>KOH preparation</b>: fungal hyphae<br><b>Calcofluor white</b>: fungi (fluorescence under UV) and Acanthamoeba cysts<br><b>Acid-fast stain (Ziehl-Neelsen)</b>: Mycobacteria, Nocardia<br><b>Acridine orange</b>: bacteria, fungi, Acanthamoeba" },
{ q: "What is the significance of nummular/coin-shaped subepithelial infiltrates?", a: "<b>Subepithelial infiltrates (SEIs)</b>: round, coin-shaped, whitish deposits beneath the corneal epithelium.<br>Classic association: <b>adenoviral keratoconjunctivitis (EKC)</b><br>Represent <b>immune complexes</b> (antigen-antibody deposits) — appear 1–3 weeks after acute infection<br>Can persist for <b>months to years</b><br>Cause: glare, halos, mild decreased vision<br>Treatment: topical steroids if visually significant (but may recur on discontinuation)" },
{ q: "What is the mainstay treatment for severe/sight-threatening scleritis?", a: "<b>Systemic NSAIDs</b> (indomethacin, ibuprofen) — first-line for non-necrotizing scleritis<br><b>Systemic corticosteroids</b> — if NSAIDs fail<br><b>Immunosuppressants</b> — for necrotizing scleritis or steroid-dependent cases:<br>• Methotrexate, mycophenolate mofetil<br>• Cyclophosphamide (for GPA-associated necrotizing scleritis)<br>• <b>Rituximab</b> (refractory cases)<br>Topical therapy alone is <b>insufficient</b> for scleritis." },
{ q: "How does contact lens overwear cause corneal problems?", a: "Prolonged contact lens wear leads to:<br>• <b>Corneal hypoxia</b> → epithelial edema, neovascularization, microcystic changes<br>• <b>Mechanical abrasion</b> → erosions, giant papillary conjunctivitis<br>• <b>Biofilm formation</b> → increases risk of <b>Pseudomonas and Acanthamoeba</b> keratitis<br>• <b>Altered corneal flora</b> → susceptibility to infection<br>Prevention: proper hygiene, avoid overnight wear, replace as recommended, never use tap water" },
{ q: "What is the most important initial step when evaluating a patient with a red eye?", a: "1. <b>Check visual acuity</b> — the vital sign of ophthalmology<br>2. Assess pain severity and character<br>3. Determine pattern of injection (diffuse vs ciliary flush)<br>4. Examine pupils (size, reactivity, APD)<br>5. Evaluate discharge (type and amount)<br>6. Slit-lamp examination (AC cells/flare, corneal staining)<br>7. Measure IOP (tonometry)<br>Decreased visual acuity = urgent referral to ophthalmology" },
{ q: "When should a patient with a red eye be referred urgently to ophthalmology?", a: "Urgent referral indicated for:<br>• <b>Decreased visual acuity</b><br>• <b>Severe pain</b><br>• <b>Corneal opacity/ulcer</b><br>• <b>Hypopyon</b><br>• <b>Pupil abnormality</b> (fixed, irregular, APD)<br>• <b>Suspected penetrating injury</b> (positive Seidel test)<br>• <b>Suspected acute glaucoma</b><br>• <b>Cells and flare</b> on slit lamp (uveitis)<br>• <b>Hyperacute purulent conjunctivitis</b> (gonococcal)<br>• <b>Herpetic eye disease</b>" },
{ q: "What is disciform keratitis?", a: "<b>Disciform (endotheliitis) keratitis</b>: a disc-shaped area of <b>corneal edema</b> with underlying <b>keratic precipitates</b> on the endothelium.<br>Represents <b>immune-mediated endothelial dysfunction</b>.<br>Most commonly caused by <b>HSV</b> (also HZV, CMV).<br>Treatment: <b>topical steroids + antiviral cover</b><br>Untreated → permanent endothelial damage → corneal decompensation." },
{ q: "What ocular finding is strongly associated with Lyme disease?", a: "<b>Lyme disease</b> (Borrelia burgdorferi) ocular manifestations:<br>• <b>Cranial nerve palsies</b> (CN VII bilateral = Bell's palsy; CN III, IV, VI)<br>• <b>Follicular conjunctivitis</b> (early disease)<br>• <b>Intermediate uveitis</b> (vitritis)<br>• Keratitis (stromal/interstitial)<br>• Optic neuritis, papilledema<br>Treatment: doxycycline (early), IV ceftriaxone (neuro-ophthalmic involvement)" },
{ q: "A 25-year-old male with painful oral ulcers and genital ulcers develops a red eye with hypopyon. Diagnosis?", a: "<b>Behçet disease</b><br>Classic triad: recurrent oral aphthous ulcers + genital ulcers + uveitis<br>Hypopyon uveitis (shifting, sterile) is characteristic<br>Also: retinal vasculitis, pathergy (skin hyperreactivity)<br>HLA-B51 associated<br>Treatment: colchicine, azathioprine, cyclosporine, anti-TNF agents<br>Common along the Silk Road" },
{ q: "What is the Munson sign?", a: "<b>Munson sign</b>: a V-shaped indentation of the lower eyelid when the patient looks downward, caused by <b>keratoconus</b> — progressive corneal thinning and ectasia (cone-shaped cornea).<br>Other signs of keratoconus: <b>Vogt striae</b> (fine vertical lines in deep stroma), <b>Fleischer ring</b> (iron deposition at base of cone), <b>scissoring reflex</b> on retinoscopy, <b>hydrops</b> (acute corneal edema from Descemet's rupture)." },
{ q: "What is the difference between granulomatous and non-granulomatous uveitis?", a: "<b>Non-granulomatous</b>:<br>• Fine, dust-like KPs<br>• No iris nodules<br>• Acute onset, unilateral<br>• Causes: HLA-B27, idiopathic, Fuchs<br><br><b>Granulomatous</b>:<br>• <b>Mutton-fat KPs</b> (large, greasy)<br>• <b>Iris nodules</b> (Koeppe, Busacca)<br>• Often chronic, bilateral<br>• Causes: <b>Sarcoidosis, TB, syphilis, VKH, sympathetic ophthalmia</b><br>Mnemonic for granulomatous: <b>S</b>arcoid, <b>S</b>yphilis, <b>T</b>B, <b>V</b>KH, <b>S</b>ympathetic ophthalmia" },
          ]
        },
        {
          section: 'Ophthalmology',
          topic: "Glaucoma — types & management",
          icon: "eye",
          cards: [
            // ===== AQUEOUS HUMOR DYNAMICS =====
{ q: "Where is aqueous humor produced and at what rate?", a: "<b>Ciliary body epithelium</b> (non-pigmented layer) produces aqueous humor at approximately <b>2.5 μL/min</b> (~2.0–2.5 μL/min)." },
{ q: "What are the two mechanisms of aqueous humor production?", a: "1. <b>Active secretion</b> (major) — Na⁺/K⁺-ATPase & carbonic anhydrase–dependent<br>2. <b>Ultrafiltration & diffusion</b> (minor) — pressure-dependent" },
{ q: "Describe the conventional outflow pathway of aqueous humor.", a: "<b>Posterior chamber</b> → through <b>pupil</b> → <b>anterior chamber</b> → <b>trabecular meshwork</b> → <b>Schlemm canal</b> → collector channels → <b>episcleral veins</b><br>Accounts for <b>80–90%</b> of total outflow." },
{ q: "What is the uveoscleral (unconventional) outflow pathway?", a: "Aqueous flows through the <b>ciliary muscle interstitial spaces</b> → <b>suprachoroidal space</b> → absorbed by choroidal vasculature or through sclera.<br>Accounts for <b>10–20%</b> of outflow. <b>Prostaglandin analogs</b> enhance this pathway." },
{ q: "What is the composition of aqueous humor?", a: "Similar to plasma but with <b>lower protein</b> (~1/500th of plasma), <b>lower glucose</b>, <b>higher ascorbate</b>, and <b>higher lactate</b>. Maintains <b>transparency</b> of the lens and cornea and provides <b>nutrients</b> to avascular structures." },
{ q: "What enzyme in the ciliary epithelium is targeted by carbonic anhydrase inhibitors?", a: "<b>Carbonic anhydrase</b> — catalyzes: CO₂ + H₂O → HCO₃⁻ + H⁺<br>Inhibition reduces <b>bicarbonate and sodium transport</b> into the posterior chamber, thereby <b>decreasing aqueous humor production</b>." },

// ===== INTRAOCULAR PRESSURE =====
{ q: "What is the normal range of intraocular pressure (IOP)?", a: "<b>10–21 mmHg</b><br>Mean ~15.5 mmHg. IOP >21 mmHg is considered statistically elevated but does <b>not</b> define glaucoma by itself." },
{ q: "When is IOP typically highest during the day?", a: "IOP is highest in the <b>early morning</b> (often around 6–8 AM) due to <b>diurnal variation</b>.<br>Variation of <b>2–6 mmHg</b> is normal; >10 mmHg fluctuation is suspicious for glaucoma." },
{ q: "What is the gold standard method for measuring IOP?", a: "<b>Goldmann applanation tonometry (GAT)</b><br>Based on the <b>Imbert-Fick principle</b>: pressure inside a sphere = force needed to flatten (applanate) a known area (3.06 mm diameter)." },
{ q: "How does central corneal thickness (CCT) affect IOP measurement?", a: "<b>Thin cornea</b> (<555 μm) → <b>underestimates</b> true IOP<br><b>Thick cornea</b> (>588 μm) → <b>overestimates</b> true IOP<br>Every 10 μm change ≈ 0.5 mmHg correction. Thin CCT is an <b>independent risk factor</b> for POAG." },
{ q: "Name alternative IOP measurement methods besides Goldmann tonometry.", a: "1. <b>Tono-Pen</b> — portable, handheld<br>2. <b>Non-contact tonometry</b> (air puff) — screening tool<br>3. <b>iCare</b> (rebound tonometry) — no anesthesia needed, good for children<br>4. <b>Pneumatonometry</b><br>5. <b>Perkins tonometer</b> — portable Goldmann" },

// ===== OPTIC NERVE ANATOMY =====
{ q: "What is a normal cup-to-disc (C/D) ratio?", a: "Normal C/D ratio is <b><0.5</b><br>A C/D ratio ≥0.5, <b>asymmetry >0.2</b> between eyes, or <b>progressive enlargement</b> of the cup are concerning for glaucoma." },
{ q: "What is the ISNT rule for the neuroretinal rim?", a: "The normal neuroretinal rim is thickest to thinnest: <b>I</b>nferior (thickest) > <b>S</b>uperior > <b>N</b>asal > <b>T</b>emporal (thinnest).<br>Violation of ISNT rule suggests <b>glaucomatous damage</b>." },
{ q: "What is the lamina cribrosa and its role in glaucoma?", a: "The <b>lamina cribrosa</b> is a sieve-like structure of connective tissue through which <b>retinal ganglion cell axons</b> pass as they exit the eye.<br>In glaucoma, elevated IOP causes <b>posterior bowing</b> of the lamina, leading to <b>axonal compression and ischemia</b>." },
{ q: "What is the retinal nerve fiber layer (RNFL) and how is it assessed?", a: "The <b>RNFL</b> consists of <b>retinal ganglion cell axons</b> coursing toward the optic disc.<br>Assessed by <b>OCT</b> (optical coherence tomography) — thinning of RNFL is an <b>early sign</b> of glaucomatous damage, often preceding visual field loss." },
{ q: "What structural changes occur at the optic disc in glaucoma?", a: "1. <b>Increased cupping</b> (↑ C/D ratio)<br>2. <b>Neuroretinal rim thinning/notching</b> (especially inferotemporal)<br>3. <b>Disc hemorrhage</b> (Drance hemorrhage)<br>4. <b>RNFL defects</b><br>5. <b>Bayoneting</b> of blood vessels<br>6. <b>Laminar dot sign</b><br>7. <b>Peripapillary atrophy</b> (beta zone)" },

// ===== POAG =====
{ q: "What is the most common type of glaucoma worldwide?", a: "<b>Primary open-angle glaucoma (POAG)</b><br>Accounts for ~70% of all glaucoma cases in Western countries. It is <b>chronic, bilateral, and painless</b>." },
{ q: "What are the key clinical features of POAG?", a: "1. <b>Open angle</b> on gonioscopy (grade III–IV)<br>2. <b>Elevated IOP</b> (usually >21 mmHg, but not always)<br>3. <b>Optic disc cupping</b> (↑ C/D ratio)<br>4. <b>Progressive visual field loss</b> (peripheral first)<br>5. <b>Painless</b> and <b>insidious onset</b><br>6. Central vision preserved until <b>late disease</b>" },
{ q: "What are the major risk factors for POAG?", a: "1. <b>Age >40</b> (prevalence increases with age)<br>2. <b>African American race</b> (4–5× higher risk)<br>3. <b>Family history</b> (first-degree relative)<br>4. <b>Elevated IOP</b><br>5. <b>Myopia</b><br>6. <b>Thin CCT</b> (<555 μm)<br>7. <b>Diabetes mellitus</b><br>8. <b>Disc hemorrhage</b>" },
{ q: "What is normal-tension glaucoma (NTG)?", a: "A subtype of POAG where <b>IOP is consistently <21 mmHg</b> but there is progressive <b>optic nerve damage</b> and <b>visual field loss</b>.<br>Associated with: <b>vasospasm, Raynaud phenomenon, migraine, nocturnal hypotension, sleep apnea</b>.<br>Treatment: <b>IOP lowering still beneficial</b> (CNTGS trial)." },
{ q: "Why is POAG often diagnosed late?", a: "Because it is <b>painless</b> and <b>peripheral vision</b> is lost first while <b>central vision is preserved until late</b>. Patients may not notice symptoms until <b>significant irreversible damage</b> has occurred. Hence routine screening is important." },

// ===== VISUAL FIELD DEFECTS =====
{ q: "What is the characteristic pattern of visual field loss in glaucoma?", a: "Glaucoma typically causes <b>peripheral (arcuate) field loss</b> first, progressing centrally:<br>1. <b>Paracentral scotoma</b> (earliest)<br>2. <b>Arcuate (Bjerrum) scotoma</b><br>3. <b>Nasal step</b> (Roenne)<br>4. <b>Ring scotoma</b><br>5. <b>Generalized constriction</b> → tunnel vision<br>Central island and temporal island are <b>last to go</b>." },
{ q: "What is an arcuate (Bjerrum) scotoma?", a: "An <b>arc-shaped visual field defect</b> following the distribution of the <b>arcuate nerve fiber bundle</b>, arching from the <b>blind spot</b> to the nasal horizontal meridian.<br>It is a <b>hallmark</b> of glaucomatous visual field loss." },
{ q: "What is a nasal step (Roenne nasal step)?", a: "A <b>visual field defect</b> at the <b>nasal horizontal meridian</b> where the upper and lower arcuate defects do not meet symmetrically, creating a <b>step</b>.<br>It is <b>highly specific</b> for glaucoma." },
{ q: "What visual field test is standard for glaucoma monitoring?", a: "<b>Humphrey visual field (HVF)</b> using the <b>24-2</b> or <b>30-2</b> SITA strategy.<br>Key parameters:<br>- <b>Mean deviation (MD)</b>: overall field sensitivity loss<br>- <b>Pattern standard deviation (PSD)</b>: localized field defects<br>- <b>Glaucoma Hemifield Test (GHT)</b>: compares superior and inferior hemifields" },
{ q: "What do mean deviation (MD) and pattern standard deviation (PSD) indicate on HVF?", a: "<b>MD (Mean Deviation)</b>: overall reduction in sensitivity across the entire visual field; more negative = worse<br><b>PSD (Pattern Standard Deviation)</b>: measures <b>localized</b> (focal) defects; elevated PSD with normal MD suggests <b>early glaucoma</b>" },

// ===== DIAGNOSTIC WORKUP =====
{ q: "What is gonioscopy and what does it assess?", a: "<b>Gonioscopy</b> uses a contact lens with mirrors to visualize the <b>iridocorneal angle</b> (drainage angle).<br>Determines if the angle is <b>open or closed</b> and identifies pathology (neovascularization, synechiae, recession, pigment)." },
{ q: "Describe the Shaffer grading system for gonioscopy.", a: "<b>Grade IV</b> (35–45°): wide open — all structures visible<br><b>Grade III</b> (25–35°): open — scleral spur visible<br><b>Grade II</b> (20°): moderately narrow — trabecular meshwork visible<br><b>Grade I</b> (10°): very narrow — only Schwalbe line visible<br><b>Grade 0</b> (0°): closed — no structures visible, <b>closure risk</b>" },
{ q: "What structures are seen on gonioscopy from anterior to posterior?", a: "Mnemonic: <b>'She Took Sam's Car'</b><br>1. <b>S</b>chwalbe line<br>2. <b>T</b>rabecular meshwork (pigmented & non-pigmented)<br>3. <b>S</b>cleral spur<br>4. <b>C</b>iliary body band" },
{ q: "What is the role of OCT in glaucoma evaluation?", a: "<b>OCT (Optical Coherence Tomography)</b> measures <b>RNFL thickness</b>, <b>ganglion cell complex (GCC)</b>, and <b>optic disc parameters</b>.<br>Detects <b>structural damage before functional loss</b> on visual fields. Used for <b>diagnosis and progression monitoring</b>." },
{ q: "What is pachymetry and why is it important in glaucoma?", a: "<b>Pachymetry</b> measures <b>central corneal thickness (CCT)</b>.<br>Normal CCT ≈ <b>540–560 μm</b>.<br>Thin CCT (<555 μm) is an independent risk factor for POAG and <b>underestimates IOP</b> on GAT. Critical for risk stratification." },

// ===== MEDICAL MANAGEMENT OF POAG =====
{ q: "What is the target IOP in treating POAG?", a: "Typically a <b>20–30% reduction from baseline IOP</b>.<br>Target is individualized based on: <b>severity of damage, rate of progression, life expectancy, baseline IOP</b>.<br>Lower targets (e.g., <12 mmHg) for advanced disease or NTG." },
{ q: "What is the first-line medical treatment for POAG?", a: "<b>Prostaglandin analogs (PGAs)</b>: latanoprost, travoprost, bimatoprost, tafluprost<br>Mechanism: <b>increase uveoscleral outflow</b><br>Dosing: <b>once daily</b> (evening)<br>Most effective single agents, reducing IOP by <b>25–33%</b>." },
{ q: "What are the side effects of prostaglandin analogs?", a: "1. <b>Iris darkening</b> (↑ melanin, irreversible)<br>2. <b>Eyelash growth</b> (hypertrichosis) — used cosmetically as bimatoprost (Latisse)<br>3. <b>Periorbital fat atrophy</b> (prostaglandin-associated periorbitopathy, PAP)<br>4. <b>Conjunctival hyperemia</b><br>5. <b>Cystoid macular edema</b> (caution in uveitis/pseudophakia)<br>6. <b>Darkening of periocular skin</b>" },
{ q: "How do beta-blockers work in glaucoma and what are key contraindications?", a: "<b>Timolol (non-selective β-blocker)</b> — <b>decreases aqueous production</b> by blocking β2 receptors on ciliary epithelium.<br>IOP reduction: <b>20–25%</b>. Given BID.<br><b>Contraindications</b>: asthma/COPD, bradycardia, heart block, decompensated CHF. Can cause <b>bronchospasm, bradycardia, hypotension, depression</b>." },
{ q: "What is the mechanism and key side effect concern with brimonidine?", a: "<b>Brimonidine</b> (alpha-2 agonist):<br>Mechanism: <b>decreases aqueous production</b> + <b>increases uveoscleral outflow</b><br>IOP reduction: ~20%<br><b>Avoid in children <2 years old</b> — risk of <b>CNS depression</b> (apnea, lethargy, bradycardia, hypotension).<br>Other SE: allergic conjunctivitis, dry mouth, fatigue." },
{ q: "Compare topical vs oral carbonic anhydrase inhibitors (CAIs).", a: "<b>Topical CAIs</b>: dorzolamide, brinzolamide — fewer systemic SE, BID-TID dosing<br><b>Oral CAIs</b>: acetazolamide, methazolamide — more potent but significant SE:<br>- <b>Metabolic acidosis</b> (non-anion gap)<br>- <b>Paresthesias</b> (tingling fingers/lips)<br>- <b>Hypokalemia</b><br>- <b>Kidney stones</b><br>- <b>Aplastic anemia</b> (rare, idiosyncratic)<br>- <b>Metallic taste</b><br><b>Avoid in sulfa allergy</b>" },
{ q: "What is the mechanism of Rho kinase inhibitors in glaucoma?", a: "<b>Netarsudil</b> (Rhopressa) — <b>Rho kinase (ROCK) inhibitor</b><br>Mechanism: <b>increases trabecular meshwork outflow</b> by relaxing TM cells + decreases episcleral venous pressure + decreases aqueous production.<br>Dosed <b>once daily</b>. SE: conjunctival hyperemia, corneal verticillata." },
{ q: "How do miotics (pilocarpine) work and what are their side effects?", a: "<b>Pilocarpine</b> — <b>direct-acting muscarinic agonist (miotic)</b><br>Mechanism: contracts <b>ciliary muscle</b> → pulls open trabecular meshwork → <b>increases trabecular outflow</b><br>SE: <b>miosis</b>, brow ache, accommodative myopia, dim vision, <b>increased risk of retinal detachment</b> (due to vitreal traction)." },
{ q: "Which glaucoma medication class reduces IOP by increasing trabecular outflow?", a: "1. <b>Miotics (pilocarpine)</b> — ciliary muscle contraction opens TM<br>2. <b>Rho kinase inhibitors (netarsudil)</b> — relax TM cells<br>(Prostaglandin analogs increase <b>uveoscleral</b> outflow, not trabecular)" },
{ q: "Which glaucoma medications decrease aqueous humor production?", a: "1. <b>Beta-blockers</b> (timolol, betaxolol)<br>2. <b>Alpha-2 agonists</b> (brimonidine, apraclonidine)<br>3. <b>Carbonic anhydrase inhibitors</b> (dorzolamide, acetazolamide)<br>All three classes act on the <b>ciliary body epithelium</b> to reduce secretion." },
{ q: "What is the role of betaxolol in glaucoma?", a: "<b>Betaxolol</b> is a <b>selective β1-blocker</b> (cardioselective).<br>Less effective than timolol (non-selective) for IOP reduction but <b>safer in patients with pulmonary disease</b> (asthma/COPD) because it has minimal β2 blockade. Still use with caution." },
{ q: "What fixed-combination glaucoma drops are commonly used?", a: "1. <b>Cosopt</b> = dorzolamide + timolol<br>2. <b>Combigan</b> = brimonidine + timolol<br>3. <b>Simbrinza</b> = brimonidine + brinzolamide<br>4. <b>Rocklatan</b> = netarsudil + latanoprost<br>Fixed combinations improve <b>compliance</b> and reduce <b>preservative exposure</b>." },

// ===== LASER TREATMENT =====
{ q: "What is selective laser trabeculoplasty (SLT)?", a: "<b>SLT</b> uses a <b>frequency-doubled Nd:YAG laser (532 nm)</b> to selectively target <b>pigmented trabecular meshwork cells</b>.<br>Stimulates <b>macrophage recruitment</b> → remodels TM → improves outflow.<br>IOP reduction: <b>20–30%</b>. <b>Repeatable</b> (minimal tissue destruction). Can be used as <b>first-line therapy</b> (LiGHT trial)." },
{ q: "How does SLT differ from ALT?", a: "<b>SLT</b>: selective, minimal thermal damage, <b>repeatable</b>, targets pigmented cells only<br><b>ALT (Argon Laser Trabeculoplasty)</b>: causes <b>coagulative damage</b> to TM, <b>not easily repeatable</b>, risk of PAS formation<br>SLT has largely <b>replaced ALT</b> in clinical practice." },
{ q: "What is laser peripheral iridotomy (LPI) and when is it used?", a: "<b>LPI</b> creates a small <b>full-thickness hole in the peripheral iris</b> using Nd:YAG laser.<br>Indication: <b>angle closure</b> (acute or chronic) due to <b>pupillary block</b>.<br>Equalizes pressure between posterior and anterior chambers → relieves pupillary block → opens the angle.<br>Perform in <b>both eyes</b> (fellow eye prophylaxis)." },

// ===== SURGICAL MANAGEMENT =====
{ q: "What is a trabeculectomy?", a: "A <b>filtering surgery</b> that creates a <b>fistula</b> from the anterior chamber to the <b>subconjunctival space</b>.<br>Aqueous drains under the conjunctiva forming a <b>bleb</b>.<br><b>Antimetabolites</b> (5-FU, mitomycin C) applied to prevent <b>fibrosis/scarring</b> of the bleb." },
{ q: "What are the complications of trabeculectomy?", a: "Early: <b>hypotony, shallow AC, choroidal effusion, hyphema, bleb leak</b> (Seidel test positive)<br>Late: <b>bleb infection (blebitis), endophthalmitis, bleb encapsulation/failure, cataract formation</b><br>Antimetabolites increase risk of <b>thin avascular blebs</b> and late-onset bleb leaks." },
{ q: "What are glaucoma tube shunt (drainage) devices?", a: "Tubes that shunt aqueous from the <b>AC to a plate</b> in the subconjunctival/sub-Tenon space.<br><b>Ahmed valve</b>: has a flow restrictor (valved) — less early hypotony<br><b>Baerveldt implant</b>: non-valved, larger plate — may achieve lower IOP<br>Used for <b>refractory or complicated glaucoma</b> (failed trabeculectomy, neovascular glaucoma)." },
{ q: "What is MIGS (minimally invasive glaucoma surgery)?", a: "<b>MIGS</b> = Minimally Invasive Glaucoma Surgery<br>Examples: <b>iStent</b> (TM bypass to Schlemm canal), <b>Kahook dual blade</b> (goniotomy), <b>XEN gel stent</b> (subconjunctival drainage), <b>Hydrus microstent</b>, <b>GATT</b><br>Advantages: <b>less invasive, faster recovery, fewer complications</b> than trabeculectomy. Best for <b>mild-moderate glaucoma</b>, often combined with cataract surgery." },
{ q: "What are cyclodestructive procedures and when are they used?", a: "<b>Cyclophotocoagulation (CPC)</b> — destroys <b>ciliary body epithelium</b> to <b>reduce aqueous production</b>.<br>Types: <b>transscleral CPC</b>, <b>endoscopic CPC (ECP)</b>, <b>micropulse CPC</b><br>Reserved as <b>last resort</b> for refractory glaucoma or eyes with <b>poor visual potential</b>. Risk of <b>phthisis bulbi</b>." },

// ===== PRIMARY ANGLE-CLOSURE GLAUCOMA =====
{ q: "What is the pathophysiology of primary angle-closure glaucoma (PACG)?", a: "<b>Pupillary block</b> is the most common mechanism: the iris bows forward against the lens → blocks aqueous flow through the pupil → iris bombé → peripheral iris occludes the <b>trabecular meshwork</b> → acute IOP elevation." },
{ q: "What anatomic factors predispose to angle closure?", a: "1. <b>Shallow anterior chamber</b><br>2. <b>Short axial length</b> (hyperopia)<br>3. <b>Thick lens</b> (increases with age)<br>4. <b>Anteriorly positioned lens</b><br>5. <b>Small corneal diameter</b><br>Demographics: <b>Asian descent, female, age >50</b>" },
{ q: "What precipitates an acute angle-closure attack?", a: "1. <b>Dim illumination</b> (mid-dilated pupil = maximum pupillary block)<br>2. <b>Mydriatic drops</b> (phenylephrine, tropicamide, atropine)<br>3. <b>Emotional stress/excitement</b><br>4. <b>Prone positioning</b><br>5. <b>Anticholinergic/sympathomimetic medications</b><br>The pupil reaches <b>mid-dilation</b>, maximizing iris-lens contact." },
{ q: "What are the symptoms of acute angle-closure glaucoma?", a: "1. <b>Severe eye pain</b> (unilateral)<br>2. <b>Headache</b> (often frontal)<br>3. <b>Nausea and vomiting</b> (vagal response — can mimic acute abdomen)<br>4. <b>Halos around lights</b> (corneal edema)<br>5. <b>Decreased/blurred vision</b><br>6. <b>Red eye</b>" },
{ q: "What are the signs of acute angle-closure glaucoma on examination?", a: "1. <b>Mid-dilated, fixed (non-reactive) pupil</b><br>2. <b>Corneal edema</b> (hazy/steamy cornea)<br>3. <b>Shallow anterior chamber</b><br>4. <b>IOP 40–80 mmHg</b><br>5. <b>Ciliary injection</b> (circumcorneal flush)<br>6. <b>Closed angle on gonioscopy</b><br>7. <b>Glaukomflecken</b> (anterior subcapsular lens opacities from prior attacks)" },
{ q: "What is the emergency medical treatment for acute angle closure?", a: "1. <b>Timolol 0.5%</b> — ↓ aqueous production<br>2. <b>Brimonidine 0.2%</b> — ↓ aqueous production<br>3. <b>Pilocarpine 2%</b> — constricts pupil, pulls iris from angle (give <b>after IOP begins to drop</b>; iris sphincter ischemic at very high IOP)<br>4. <b>Topical steroid</b> (prednisolone) — ↓ inflammation<br>5. <b>Oral/IV acetazolamide 500 mg</b><br>6. <b>IV mannitol</b> (osmotic) if refractory" },
{ q: "What is the definitive treatment for acute angle closure?", a: "<b>Laser peripheral iridotomy (LPI)</b> — performed in <b>BOTH eyes</b> (affected + fellow eye prophylaxis).<br>Creates a bypass channel through the iris, relieving <b>pupillary block</b>.<br>The fellow eye has a <b>40–80% risk</b> of an acute attack if untreated." },
{ q: "Why is pilocarpine initially ineffective in very high IOP during acute angle closure?", a: "At IOP >40–50 mmHg, the <b>iris sphincter muscle is ischemic</b> and paralyzed, making pilocarpine <b>ineffective</b>.<br>IOP must first be lowered with other agents (timolol, brimonidine, acetazolamide, mannitol) before pilocarpine can <b>constrict the pupil</b>." },
{ q: "What is plateau iris syndrome?", a: "<b>Plateau iris</b>: anteriorly positioned <b>ciliary processes</b> push the peripheral iris forward, causing angle closure <b>despite a patent iridotomy</b>.<br>Diagnosis: <b>ultrasound biomicroscopy (UBM)</b> or anterior segment OCT.<br>Treatment: <b>argon laser peripheral iridoplasty (ALPI)</b> — contracts peripheral iris stroma away from angle." },
{ q: "What is iris bombé?", a: "<b>Iris bombé</b> = forward bowing of the entire iris due to <b>360° posterior synechiae</b> (iris adhered to lens) blocking aqueous flow from posterior to anterior chamber.<br>Causes <b>secondary angle closure</b>.<br>Treatment: <b>LPI</b> to create an alternate aqueous pathway + treat underlying cause (usually <b>uveitis</b>)." },
{ q: "What are glaukomflecken?", a: "<b>Glaukomflecken</b> = small, white <b>anterior subcapsular lens opacities</b> seen after a previous episode of <b>acute angle-closure glaucoma</b>.<br>Caused by <b>ischemic necrosis of the lens epithelium</b> during the acute IOP spike. They are a <b>hallmark sign</b> of prior acute angle closure." },

// ===== SECONDARY GLAUCOMAS =====
{ q: "What is neovascular glaucoma (NVG) and what causes it?", a: "<b>NVG</b> = secondary glaucoma caused by <b>neovascularization of the iris (rubeosis iridis)</b> and angle.<br>Causes: <b>proliferative diabetic retinopathy, CRVO</b> (100-day glaucoma), <b>ocular ischemic syndrome, CRAO</b><br>Mechanism: retinal ischemia → <b>VEGF</b> release → new vessels obstruct TM → <b>PAS and angle closure</b>." },
{ q: "Why is CRVO-associated NVG called '100-day glaucoma'?", a: "Neovascular glaucoma typically develops approximately <b>3 months (100 days)</b> after an <b>ischemic CRVO</b>.<br>Ischemic retina releases <b>VEGF</b> → rubeosis iridis → fibrovascular membrane covers angle → <b>synechial angle closure</b>." },
{ q: "How is neovascular glaucoma treated?", a: "1. <b>Anti-VEGF injection</b> (bevacizumab) — causes <b>rapid regression</b> of new vessels<br>2. <b>Panretinal photocoagulation (PRP)</b> — treats underlying ischemia (definitive for retinal cause)<br>3. <b>IOP-lowering medications</b><br>4. <b>Glaucoma surgery</b> (tube shunt preferred over trabeculectomy — high failure rate with trab)<br>5. <b>Cyclophotocoagulation</b> if poor visual prognosis" },
{ q: "What is pseudoexfoliation (PXF) glaucoma?", a: "<b>PXF glaucoma</b> = secondary open-angle glaucoma associated with deposition of <b>white, dandruff-like fibrillar material</b> on the <b>anterior lens capsule, pupillary margin, and trabecular meshwork</b>.<br>Associated with <b>zonular weakness</b> (risk during cataract surgery), higher IOP, and <b>poorer response to medical therapy</b>.<br>Most common identifiable cause of OAG worldwide." },
{ q: "What is the classic pattern of pseudoexfoliation material on the lens?", a: "A <b>three-ring (bull's-eye) pattern</b> on the anterior lens capsule:<br>1. <b>Central disc</b> of exfoliative material<br>2. <b>Clear intermediate zone</b> (scraped clean by pupillary movement)<br>3. <b>Peripheral granular zone</b><br>Best seen with <b>dilated exam</b> at the slit lamp." },
{ q: "What is pigmentary glaucoma?", a: "<b>Pigmentary glaucoma</b> = secondary OAG due to <b>pigment liberation</b> from the posterior iris surface.<br>Classic findings:<br>- <b>Krukenberg spindle</b> (vertical pigment deposition on corneal endothelium)<br>- <b>Concave (posteriorly bowed) iris</b> — rubs against lens zonules<br>- <b>Mid-peripheral iris transillumination defects</b><br>- Heavy TM pigmentation<br>Typical patient: <b>young, myopic male</b>." },
{ q: "Why can exercise trigger IOP spikes in pigmentary glaucoma?", a: "Exercise causes <b>pupillary dilation and accommodation changes</b> → increased <b>iridozonular contact</b> → <b>pigment shower</b> from posterior iris surface → acute TM obstruction → <b>IOP spike</b>.<br>Patients may report <b>halos and blurred vision</b> after vigorous exercise." },
{ q: "What is steroid-induced glaucoma?", a: "<b>Steroid-induced glaucoma</b> = secondary <b>open-angle glaucoma</b> caused by corticosteroid use.<br>Route risk: <b>topical > periocular > systemic > inhaled</b><br>Mechanism: <b>glycosaminoglycan accumulation</b> and <b>myocilin deposition</b> in TM → decreased outflow<br>Usually <b>reversible</b> upon discontinuation. <b>Steroid responders</b> (~30% of population) are at risk." },
{ q: "What lens-related (phacogenic) glaucomas exist?", a: "1. <b>Phacomorphic</b>: <b>swollen/intumescent lens</b> → pushes iris forward → angle closure<br>2. <b>Phacolytic</b>: <b>high-molecular-weight lens proteins</b> leak through intact capsule of a mature cataract → macrophage-laden proteins clog TM → open-angle glaucoma<br>3. <b>Lens particle</b>: retained lens material after surgery/trauma clogs TM<br>4. <b>Phacoantigenic (phacoanaphylactic)</b>: granulomatous inflammation from lens protein exposure" },
{ q: "How do you differentiate phacomorphic from phacolytic glaucoma?", a: "<b>Phacomorphic</b>: <b>closed angle</b>, intumescent (swollen) cataract, shallow AC<br>Treatment: IOP control → <b>cataract extraction</b> ± LPI<br><br><b>Phacolytic</b>: <b>open angle</b>, mature/hypermature cataract, <b>heavy flare</b> without keratic precipitates, macrophages in AC<br>Treatment: IOP control → <b>cataract extraction</b>" },
{ q: "How does trauma cause glaucoma?", a: "1. <b>Angle recession</b> — tear of ciliary body face; presents months-years later as OAG; bilateral gonioscopy important<br>2. <b>Hyphema</b> — blood in AC clogs TM (especially <b>sickle cell</b> patients — avoid CAIs and epinephrine)<br>3. <b>Lens dislocation</b> → pupillary block<br>4. <b>Ghost cell glaucoma</b> — denatured RBCs from old vitreous hemorrhage" },
{ q: "What is the significance of angle recession on gonioscopy?", a: "<b>Angle recession</b> = widened <b>ciliary body band</b> on gonioscopy due to a <b>tear between the longitudinal and circular muscles</b> of the ciliary body.<br><b>Unilateral</b> widening of the CB band compared to the fellow eye is diagnostic.<br>≥180° of recession → <b>higher risk</b> of late-onset OAG. Requires <b>lifelong monitoring</b>." },
{ q: "What is inflammatory glaucoma?", a: "Glaucoma secondary to <b>uveitis</b>. Mechanisms:<br>1. <b>Trabeculitis</b> — inflammation of TM → decreased outflow (open angle)<br>2. <b>Peripheral anterior synechiae (PAS)</b> → angle closure<br>3. <b>Posterior synechiae → iris bombé</b> → angle closure<br>4. <b>Steroid-induced</b> (from treatment of uveitis)<br>Treatment: control inflammation + IOP-lowering drops ± surgery." },

// ===== CONGENITAL/DEVELOPMENTAL GLAUCOMA =====
{ q: "What is primary congenital glaucoma and when does it present?", a: "<b>Primary congenital glaucoma</b> = developmental anomaly of the <b>trabecular meshwork (trabeculodysgenesis)</b>.<br>Presents in the <b>first year of life</b> (65% by 6 months).<br>More common in <b>males</b>. Often <b>bilateral</b> (75%).<br>Inheritance: usually <b>sporadic</b>, some autosomal recessive (CYP1B1 gene)." },
{ q: "What is buphthalmos?", a: "<b>Buphthalmos</b> ('ox eye') = <b>enlarged globe</b> in congenital glaucoma.<br>Occurs because the infant sclera is <b>distensible</b> — elevated IOP causes stretching of the entire globe.<br>Results in <b>increased corneal diameter</b> (>12 mm at birth), <b>increased axial length</b>, and <b>myopia</b>." },
{ q: "What are Haab striae?", a: "<b>Haab striae</b> = <b>horizontal breaks (tears) in Descemet membrane</b> caused by stretching of the cornea due to elevated IOP in congenital glaucoma.<br>They are <b>horizontal or curvilinear</b> (vs. vertical in forceps injury).<br>Lead to <b>corneal edema</b> and can cause <b>amblyopia</b>." },
{ q: "What is the classic triad of congenital glaucoma?", a: "1. <b>Epiphora</b> (tearing)<br>2. <b>Photophobia</b> (light sensitivity)<br>3. <b>Blepharospasm</b> (eyelid squeezing)<br>All due to <b>corneal edema</b> from elevated IOP. Parents often notice the child is <b>light-averse</b> and has <b>large, cloudy eyes</b>." },
{ q: "What is the primary treatment for congenital glaucoma?", a: "Treatment is <b>surgical</b> (medical therapy alone is insufficient):<br>1. <b>Goniotomy</b> — incision into TM under direct gonioscopic view (requires clear cornea)<br>2. <b>Trabeculotomy</b> — ab externo approach, doesn't require clear cornea<br>Success rate: <b>80–90%</b> with one or two procedures. Medical therapy is <b>adjunctive only</b>." },
{ q: "What systemic conditions are associated with congenital/developmental glaucoma?", a: "1. <b>Sturge-Weber syndrome</b> — port-wine stain (V1), ipsilateral glaucoma, leptomeningeal angioma<br>2. <b>Aniridia</b> — absent iris, associated with <b>Wilms tumor</b> (WAGR syndrome)<br>3. <b>Axenfeld-Rieger syndrome</b> — posterior embryotoxon, iris abnormalities, dental/facial anomalies<br>4. <b>Peters anomaly</b> — central corneal opacity, iridocorneal adhesions<br>5. <b>Neurofibromatosis type 1</b>" },
{ q: "What is Axenfeld-Rieger syndrome and its association with glaucoma?", a: "<b>Axenfeld-Rieger syndrome</b> — spectrum of anterior segment dysgenesis:<br>- <b>Posterior embryotoxon</b> (prominent Schwalbe line)<br>- <b>Iris strands</b> bridging to Schwalbe line<br>- <b>Iris abnormalities</b> (corectopia, polycoria, iris hypoplasia)<br>- <b>Systemic</b>: dental hypoplasia, maxillary hypoplasia, periumbilical skin redundancy<br>Glaucoma develops in <b>~50%</b>." },
{ q: "How does Sturge-Weber syndrome cause glaucoma?", a: "Mechanisms:<br>1. <b>Elevated episcleral venous pressure</b> (from episcleral hemangioma) → decreased aqueous outflow → <b>open-angle glaucoma</b> (most common in older children/adults)<br>2. <b>Angle anomaly</b> (trabeculodysgenesis) → <b>congenital-type glaucoma</b> (infants)<br>Occurs in <b>~30–70%</b> of Sturge-Weber patients with V1 involvement." },

// ===== GLAUCOMA SUSPECT & OHT =====
{ q: "What defines ocular hypertension (OHT)?", a: "<b>OHT</b> = <b>IOP >21 mmHg</b> on multiple occasions with:<br>- <b>Normal optic nerves</b> (no cupping)<br>- <b>Normal visual fields</b><br>- <b>Open angles</b> on gonioscopy<br>Not all OHT patients develop glaucoma — <b>~10% at 5 years</b> if untreated (OHTS study)." },
{ q: "What is a glaucoma suspect?", a: "A patient with one or more findings suggesting possible glaucoma but <b>no definitive diagnosis</b>:<br>- <b>Elevated IOP</b> (OHT)<br>- <b>Suspicious optic disc</b> (large cup, asymmetry)<br>- <b>Family history</b><br>- <b>Thin CCT</b><br>- <b>Borderline visual fields</b><br>Requires <b>serial monitoring</b> with VF, OCT, and IOP to detect progression." },
{ q: "According to the OHTS study, what factors increase the risk of OHT converting to POAG?", a: "<b>OHTS risk factors for conversion</b>:<br>1. <b>Higher baseline IOP</b><br>2. <b>Older age</b><br>3. <b>Larger C/D ratio</b><br>4. <b>Thinner CCT</b> (<555 μm)<br>5. <b>Higher PSD</b> on visual field<br>Treatment with topical IOP-lowering reduced conversion risk by <b>~50%</b> over 5 years." },

// ===== KEY CLINICAL TRIALS =====
{ q: "What did the Ocular Hypertension Treatment Study (OHTS) demonstrate?", a: "<b>OHTS</b>: topical IOP-lowering medication in OHT patients reduced the risk of developing POAG by <b>~50%</b> over 5 years (from 9.5% to 4.4%).<br>Identified <b>5 risk factors</b>: older age, higher IOP, thinner CCT, larger vertical C/D ratio, higher PSD." },
{ q: "What was the main finding of the Early Manifest Glaucoma Trial (EMGT)?", a: "<b>EMGT</b>: treatment (betaxolol + ALT) reduced risk of glaucoma <b>progression by ~50%</b> in early OAG.<br>Every <b>1 mmHg of IOP reduction</b> decreased progression risk by <b>~10%</b>.<br>Showed that <b>higher baseline IOP, exfoliation, bilateral disease, and disc hemorrhage</b> were risk factors for progression." },
{ q: "What did the Collaborative Normal-Tension Glaucoma Study (CNTGS) show?", a: "<b>CNTGS</b>: <b>IOP lowering is beneficial even in NTG</b>.<br>A <b>30% IOP reduction</b> from baseline significantly reduced the rate of visual field progression.<br>Confirmed IOP as a modifiable risk factor <b>regardless of whether baseline IOP is normal</b>." },
{ q: "What were the AGIS and CIGTS trials?", a: "<b>AGIS (Advanced Glaucoma Intervention Study)</b>: compared ALT → trabeculectomy vs trabeculectomy → ALT sequences. Found <b>lower IOP = better field preservation</b>. Eyes with IOP consistently <18 had <b>no VF progression</b>.<br><b>CIGTS (Collaborative Initial Glaucoma Treatment Study)</b>: compared initial medicine vs surgery. Both effective; surgery achieved <b>lower IOP</b> but more cataracts." },
{ q: "What was the LiGHT trial's contribution to glaucoma management?", a: "<b>LiGHT (Laser in Glaucoma and Ocular Hypertension)</b> trial: demonstrated that <b>initial SLT</b> was at least as effective as <b>initial eye drops</b> for newly diagnosed OAG/OHT over 3 years.<br>Supported SLT as a viable <b>first-line treatment</b> — better IOP control, fewer drops needed, cost-effective." },

// ===== ADDITIONAL HIGH-YIELD CARDS =====
{ q: "What is the difference between open-angle and angle-closure glaucoma on gonioscopy?", a: "<b>Open-angle</b>: TM and other angle structures are <b>visible</b> (Shaffer grade III–IV). Outflow resistance is within the TM itself.<br><b>Angle-closure</b>: peripheral iris <b>apposes/occludes the TM</b> (Shaffer grade 0–I). TM is not accessible for aqueous drainage." },
{ q: "What are peripheral anterior synechiae (PAS) and why are they important?", a: "<b>PAS</b> = adhesions of the <b>peripheral iris to the trabecular meshwork/cornea</b>.<br>Cause <b>permanent angle closure</b> even after the underlying cause is treated.<br>Seen in: chronic angle closure, NVG, inflammatory glaucoma, ICE syndrome.<br>Detected on <b>gonioscopy</b>." },
{ q: "What is the iridocorneal endothelial (ICE) syndrome?", a: "<b>ICE syndrome</b>: a group of unilateral conditions with <b>abnormal corneal endothelium</b> that proliferates across the angle and iris.<br>Subtypes: <b>Chandler syndrome, progressive iris atrophy, Cogan-Reese (iris nevus)</b><br>Causes secondary angle-closure glaucoma from PAS. Typically <b>young women</b>." },
{ q: "What is Posner-Schlossman syndrome (glaucomatocyclitic crisis)?", a: "<b>Posner-Schlossman</b> = recurrent episodes of <b>mild anterior uveitis</b> with <b>markedly elevated IOP</b> (40–60 mmHg).<br>Features: <b>unilateral, few fine KPs, minimal flare, open angle, mild symptoms</b> despite high IOP.<br>Self-limited, treated with <b>topical steroids + IOP-lowering drops</b>. Associated with <b>CMV infection</b>." },
{ q: "Which medications should be avoided in patients at risk for angle closure?", a: "Avoid drugs that cause <b>pupil dilation (mydriasis)</b>:<br>- <b>Anticholinergics</b>: atropine, scopolamine, ipratropium<br>- <b>Sympathomimetics</b>: phenylephrine, pseudoephedrine<br>- <b>Antihistamines, TCAs, SSRIs, topiramate</b><br>Key: these are <b>safe</b> in open-angle glaucoma. Only angle-closure is at risk." },
{ q: "How does topiramate cause acute angle-closure glaucoma?", a: "<b>Topiramate</b> causes <b>ciliary body swelling</b> and <b>forward rotation of the lens-iris diaphragm</b> → <b>non-pupillary block mechanism</b>.<br>Bilateral, occurs within <b>first 1–2 weeks</b> of starting the drug.<br>Treatment: <b>stop topiramate</b> + cycloplegics (to push lens back) + IOP-lowering agents. <b>LPI is NOT effective</b> (no pupillary block)." },
{ q: "What is malignant glaucoma (aqueous misdirection)?", a: "<b>Malignant glaucoma</b> = aqueous humor is misdirected <b>posteriorly into the vitreous</b> instead of anteriorly → ciliolenticular block → shallow/flat AC with high IOP.<br>Occurs after <b>intraocular surgery</b> (especially filtering surgery) in eyes with narrow angles.<br>Treatment: <b>cycloplegics (atropine) + aqueous suppressants ± vitrectomy</b>. <b>Miotics are contraindicated</b>." },
{ q: "What is the Seidel test?", a: "The <b>Seidel test</b> detects <b>wound leaks or bleb leaks</b>.<br>Apply <b>fluorescein strip</b> to the suspected leak site. Under <b>cobalt blue light</b>, aqueous humor streaming through will <b>dilute the fluorescein</b>, creating a <b>green rivulet</b> (positive Seidel test).<br>Important post-trabeculectomy and post-trauma." },
{ q: "What role do antimetabolites play in glaucoma surgery?", a: "<b>Mitomycin C (MMC)</b> and <b>5-fluorouracil (5-FU)</b> are antimetabolites applied during/after <b>trabeculectomy</b> to prevent <b>subconjunctival fibrosis</b> and bleb failure.<br><b>MMC</b>: more potent, single intraoperative application<br><b>5-FU</b>: can be given as subconjunctival injections postop<br>Risk: thin, avascular blebs → late-onset leaks and infection." },
{ q: "How is ghost cell glaucoma treated?", a: "<b>Ghost cell glaucoma</b>: caused by <b>denatured (khaki-colored) RBCs</b> from an old vitreous hemorrhage that migrate to the AC and clog the TM.<br>Occurs <b>weeks to months</b> after vitreous hemorrhage.<br>Treatment: <b>anterior chamber washout</b> if medical therapy fails; <b>vitrectomy</b> to remove the source." },
{ q: "What is the van Herick technique?", a: "<b>Van Herick technique</b> = slit-lamp method to <b>estimate the AC depth</b> (peripheral anterior chamber depth) by comparing the <b>ratio of AC depth to corneal thickness</b> at the limbus.<br>Grade 4: AC ≥ corneal thickness (wide open)<br>Grade 1: AC < ¼ corneal thickness → <b>dangerously narrow</b>, gonioscopy needed." },
{ q: "What is the mechanism of action of epinephrine/dipivefrin in glaucoma?", a: "<b>Dipivefrin</b> (prodrug of epinephrine) — <b>rarely used now</b>.<br>Mechanism: stimulates <b>α and β receptors</b> → <b>decreases aqueous production</b> (β2) + <b>increases trabecular & uveoscleral outflow</b><br>Avoid in: <b>angle-closure glaucoma</b> (mydriasis) and <b>aphakia</b> (CME risk)." },
{ q: "Which glaucoma medication is known to cause a cosmetic effect used commercially?", a: "<b>Bimatoprost (Lumigan)</b> — a prostaglandin analog.<br>Side effects of <b>eyelash growth</b> (longer, thicker, darker lashes) led to its cosmetic formulation: <b>Latisse</b> (bimatoprost 0.03%).<br>Other PGA-related cosmetic concern: <b>periorbital fat atrophy</b> (prostaglandin-associated periorbitopathy)." },
{ q: "What is apraclonidine used for in ophthalmology?", a: "<b>Apraclonidine</b> (alpha-2 agonist, less selective than brimonidine):<br>Used for <b>short-term IOP control</b> and <b>prevention of post-laser IOP spikes</b> (given before SLT, LPI, etc.).<br>Not for long-term use due to high rate of <b>tachyphylaxis</b> and <b>allergic blepharoconjunctivitis</b>.<br>Also used in <b>Horner syndrome diagnosis</b> (reversal of miosis/ptosis in postganglionic Horner)." },
{ q: "What is the significance of disc hemorrhage in glaucoma?", a: "<b>Drance hemorrhage</b> (disc/splinter hemorrhage) = small flame-shaped hemorrhage at the <b>optic disc margin</b>.<br>Indicates <b>active glaucomatous damage</b> and predicts <b>future progression</b>.<br>More common in <b>NTG</b>. Often at the <b>inferotemporal or superotemporal</b> disc margin.<br>Requires <b>intensification of treatment</b>." },
{ q: "How is glaucoma classified into open-angle and closed-angle types?", a: "<b>Open-angle glaucoma</b>:<br>- POAG, NTG, steroid-induced, pseudoexfoliation, pigmentary, phacolytic, ghost cell<br><b>Angle-closure glaucoma</b>:<br>- Primary angle closure (acute/chronic), phacomorphic, NVG (late), iris bombé, ICE syndrome, plateau iris<br>Classification is based on <b>gonioscopy</b> findings." },
{ q: "What visual field defect respects the horizontal meridian?", a: "<b>Glaucomatous visual field defects</b> respect the <b>horizontal meridian</b> (nasal step, arcuate scotoma) because the <b>nerve fiber layer</b> is divided along the horizontal raphe in the temporal retina.<br>This distinguishes glaucoma from <b>neurologic causes</b>, which respect the <b>vertical meridian</b>." },
{ q: "What is the role of latanoprostene bunod in glaucoma?", a: "<b>Latanoprostene bunod (Vyzulta)</b> — a <b>prostaglandin analog that also releases nitric oxide (NO)</b>.<br>Dual mechanism: <b>increases uveoscleral outflow</b> (PGA component) + <b>increases trabecular outflow</b> (NO relaxes TM/Schlemm canal).<br>May provide greater IOP reduction than latanoprost alone." },
{ q: "What systemic medication can cause IOP elevation mimicking glaucoma?", a: "<b>Corticosteroids</b> (most common cause of drug-induced IOP elevation):<br>- Topical ophthalmic steroids (highest risk)<br>- Periocular injections<br>- Systemic (oral/IV) steroids<br>- Inhaled steroids (lower risk)<br><b>~30% of the population</b> are steroid responders. IOP usually <b>normalizes within weeks</b> of discontinuation." },
{ q: "What is Schwartz-Matsuo syndrome?", a: "<b>Schwartz-Matsuo syndrome</b> = elevated IOP + <b>rhegmatogenous retinal detachment</b>.<br>Mechanism: photoreceptor outer segments released from detached retina → migrate anteriorly → <b>clog the trabecular meshwork</b> → open-angle glaucoma.<br>IOP normalizes after <b>retinal detachment repair</b>." },
{ q: "What medications can be used to lower IOP in hyphema, and which should be avoided in sickle cell patients?", a: "<b>For hyphema</b>: timolol, brimonidine, topical steroids, cycloplegics<br><b>Avoid in sickle cell patients</b>:<br>- <b>CAIs (acetazolamide)</b> — worsens sickling (acidosis, concentrated aqueous)<br>- <b>Epinephrine/dipivefrin</b> — may worsen sickling<br>- <b>Miotics</b> — may worsen inflammation<br>Sickled RBCs clog the TM and may cause <b>optic nerve damage at lower IOPs</b>." },
{ q: "What is the role of ultrasound biomicroscopy (UBM) in glaucoma?", a: "<b>UBM</b> uses <b>high-frequency ultrasound (50 MHz)</b> to image <b>anterior segment structures</b> including the angle, ciliary body, and lens position.<br>Useful for: <b>plateau iris, ciliary body tumors, cyclodialysis cleft, phacomorphic glaucoma, angle assessment</b> when gonioscopy is limited (e.g., corneal edema)." },
{ q: "What are the stages of primary angle closure disease?", a: "Spectrum from narrow to closed:<br>1. <b>Primary angle closure suspect (PACS)</b>: narrow angle, ≥2 quadrants of iridotrabecular contact, no PAS, normal IOP<br>2. <b>Primary angle closure (PAC)</b>: ≥2 quadrants iridotrabecular contact + ↑IOP or PAS, but <b>no optic nerve damage</b><br>3. <b>PACG</b>: PAC + <b>glaucomatous optic neuropathy</b> and/or VF loss" },
{ q: "What is a cyclodialysis cleft?", a: "<b>Cyclodialysis cleft</b> = separation of the <b>ciliary body from the scleral spur</b>, usually after <b>trauma</b>.<br>Creates a direct communication between AC and <b>suprachoroidal space</b> → <b>hypotony</b> (low IOP).<br>However, when the cleft <b>closes spontaneously</b>, IOP can <b>spike dramatically</b>." },
{ q: "How does the ISNT rule help differentiate glaucoma from physiologic cupping?", a: "<b>Physiologic cupping</b>: large cup but rim follows <b>ISNT rule</b> (I>S>N>T), symmetrical, no notching<br><b>Glaucomatous cupping</b>: <b>violation of ISNT rule</b>, especially inferior or inferotemporal rim thinning/notching, asymmetric C/D between eyes, disc hemorrhage, RNFL defects" },
{ q: "What is the significance of the Sampaolesi line on gonioscopy?", a: "The <b>Sampaolesi line</b> = <b>pigment anterior to Schwalbe line</b> on gonioscopy.<br>It is a hallmark of <b>pseudoexfoliation syndrome</b>.<br>(In pigmentary glaucoma, heavy homogeneous pigmentation is seen <b>at the TM level</b>, not anterior to Schwalbe line.)" },
{ q: "What is the typical visual field progression pattern in end-stage glaucoma?", a: "End-stage glaucoma has:<br>1. <b>Severe generalized constriction</b> ('tunnel vision')<br>2. Only a <b>central island</b> and/or <b>temporal island</b> of vision remaining<br>3. Eventually total <b>visual field loss</b> and <b>blindness</b><br>Central acuity may be preserved even with only <b>5–10° of central field</b> remaining." },
{ q: "What is the 'wipe-out' phenomenon in glaucoma surgery?", a: "<b>Wipe-out</b> = sudden, unexplained loss of <b>central vision</b> after glaucoma surgery (especially trabeculectomy) in patients with <b>advanced glaucoma</b> and a small central island of vision.<br>Etiology unclear — possibly related to <b>hypotony</b>, <b>choroidal effusion</b>, or <b>optic nerve ischemia</b>. Rare but devastating." },
{ q: "What is the pathophysiology of POAG at the cellular level?", a: "In POAG, increased <b>outflow resistance in the juxtacanalicular tissue</b> of the trabecular meshwork leads to elevated IOP.<br>Elevated IOP → <b>mechanical compression of axons at the lamina cribrosa</b> → <b>axoplasmic flow disruption</b> → reduced neurotrophic factor delivery → <b>retinal ganglion cell apoptosis</b>." },
{ q: "What is the relationship between myopia and glaucoma?", a: "<b>Myopia</b> is an independent risk factor for POAG because:<br>1. <b>Larger, thinner lamina cribrosa</b> → more susceptible to IOP-induced damage<br>2. <b>Tilted disc</b> may mimic or mask glaucomatous changes<br>3. <b>Larger optic disc</b> — harder to detect early cupping<br>4. <b>Thinner RNFL</b> at baseline" },
{ q: "What is the significance of an afferent pupillary defect (APD) in glaucoma?", a: "A <b>relative APD (Marcus Gunn pupil)</b> indicates <b>asymmetric optic nerve damage</b> between the two eyes.<br>In glaucoma, an APD suggests <b>significant unilateral or asymmetric</b> optic nerve damage.<br>Tested with the <b>swinging flashlight test</b>. A new or worsening APD warrants <b>closer monitoring and possible treatment intensification</b>." },
{ q: "Why should timolol be used with caution in neonates?", a: "<b>Timolol</b> (non-selective β-blocker) can cause <b>systemic β-blockade</b> in neonates even with topical application due to:<br>1. <b>Low body weight</b> (higher relative dose)<br>2. <b>Immature drug metabolism</b><br>Risks: <b>apnea, bradycardia, hypotension, bronchospasm, hypoglycemia</b>.<br>Use <b>low concentrations</b> (0.25%) and <b>punctal occlusion</b> to minimize absorption." },
{ q: "What is the difference between goniotomy and trabeculotomy?", a: "<b>Goniotomy</b>: <b>ab interno</b> approach — incision into TM under <b>direct gonioscopic visualization</b> through a clear cornea<br><b>Trabeculotomy</b>: <b>ab externo</b> approach — cannulate <b>Schlemm canal</b> from outside, then rotate probe to break through TM<br>Both are used for <b>congenital glaucoma</b>. Trabeculotomy preferred when <b>cornea is cloudy</b>." },
{ q: "What are the differences between Ahmed valve and Baerveldt implant?", a: "<b>Ahmed valve</b>:<br>- <b>Valved</b> (flow-restricted) → less early hypotony<br>- Can function <b>immediately</b><br>- Smaller plate (184 mm²)<br><br><b>Baerveldt implant</b>:<br>- <b>Non-valved</b> → needs suture ligation initially<br>- Larger plate (250–350 mm²) → potentially <b>lower long-term IOP</b><br>- Higher rate of early complications but better long-term IOP control (ABC/AVB studies)" },
{ q: "What medications should be avoided in a patient with sulfa allergy and glaucoma?", a: "<b>Carbonic anhydrase inhibitors</b> should be avoided:<br>- Topical: <b>dorzolamide, brinzolamide</b><br>- Oral: <b>acetazolamide, methazolamide</b><br>These are <b>sulfonamide derivatives</b>. Cross-reactivity risk exists, though it may be low. Use alternative agents (PGAs, beta-blockers, alpha agonists)." },
{ q: "What is the OHTS calculator used for?", a: "The <b>OHTS calculator</b> estimates a patient's <b>5-year risk of developing POAG</b> from OHT.<br>Inputs: <b>age, IOP, CCT, vertical C/D ratio, PSD</b>.<br>Helps guide treatment decisions: patients with <b>>20% 5-year risk</b> benefit from treatment; <b><10%</b> may be observed." },
{ q: "What is the pathophysiology behind steroid responders?", a: "<b>Steroid responders</b> (~30% of the general population, higher in POAG patients):<br>Corticosteroids induce <b>increased glycosaminoglycan deposition</b> and <b>myocilin accumulation</b> in the TM → decreased phagocytic activity → <b>increased outflow resistance</b> → elevated IOP.<br>Response is <b>dose- and duration-dependent</b>. Usually reversible upon stopping the steroid." },
{ q: "What is the role of neuroprotection in glaucoma research?", a: "<b>Neuroprotection</b> aims to protect <b>retinal ganglion cells</b> from apoptosis independent of IOP lowering.<br>Agents studied: <b>brimonidine</b> (Low-Pressure Glaucoma Treatment Study suggested possible neuroprotective effect), <b>memantine</b> (failed in clinical trials), <b>BDNF, citicoline</b>.<br>Currently, <b>IOP lowering remains the only proven strategy</b>." },
{ q: "A young myopic male presents with blurred vision and halos after exercise, elevated IOP, and a Krukenberg spindle. Diagnosis?", a: "<b>Pigmentary glaucoma</b><br>Key features: <b>young, myopic, male</b> + post-exercise symptoms (pigment release) + <b>Krukenberg spindle</b> (vertical endothelial pigment) + <b>concave iris</b> + mid-peripheral iris transillumination defects + heavy TM pigmentation.<br>Exercise liberates pigment from the posterior iris, acutely clogging the TM." },
{ q: "A patient on long-term topical dexamethasone for uveitis develops elevated IOP with open angles and no synechiae. Diagnosis?", a: "<b>Steroid-induced glaucoma</b><br>Open angle with no structural angle abnormality. IOP elevation is due to <b>increased TM resistance</b> from steroid-induced changes.<br>Management: <b>switch to a lower-potency steroid</b> (fluorometholone, loteprednol), add <b>IOP-lowering drops</b>, consider stopping steroids if possible. IOP usually <b>normalizes within weeks</b>." },
{ q: "An elderly patient presents with a white, flaky material on the pupillary margin and anterior lens capsule, elevated IOP, and poor mydriasis. Diagnosis?", a: "<b>Pseudoexfoliation (PXF) syndrome with secondary glaucoma</b><br>Hallmark: <b>white, dandruff-like fibrillar material</b> on lens, pupillary margin, and TM.<br>Associated with <b>zonular weakness</b> (risk of lens subluxation during cataract surgery), <b>poor dilation</b>, and <b>higher IOP levels</b>.<br>Sampaolesi line on gonioscopy." },
{ q: "A 2-month-old infant presents with tearing, photophobia, and a large, cloudy cornea. What is the most likely diagnosis?", a: "<b>Primary congenital glaucoma</b><br>Classic triad: <b>epiphora, photophobia, blepharospasm</b> from corneal edema.<br>Signs: <b>buphthalmos</b> (large eye), <b>Haab striae</b> (Descemet breaks), <b>corneal edema/clouding</b>, elevated IOP.<br>Treatment: <b>surgical</b> — goniotomy or trabeculotomy." },
{ q: "A patient with a history of ischemic CRVO 3 months ago presents with a red, painful eye and IOP of 55 mmHg. Exam shows iris neovascularization. Diagnosis?", a: "<b>Neovascular glaucoma (100-day glaucoma)</b><br>Ischemic CRVO → retinal ischemia → <b>VEGF release</b> → <b>rubeosis iridis</b> → fibrovascular membrane over TM → angle closure.<br>Treatment: <b>anti-VEGF injection + PRP + IOP-lowering agents ± tube shunt surgery</b>." },
{ q: "A patient presents with acute eye pain, nausea, halos, and a fixed mid-dilated pupil after watching a movie in a dark theater. IOP is 60 mmHg. Diagnosis and management?", a: "Diagnosis: <b>Acute primary angle-closure glaucoma</b><br>Precipitant: dim illumination → mid-dilation → pupillary block<br>Management:<br>1. <b>Timolol + brimonidine + pilocarpine 2%</b> (after IOP starts dropping)<br>2. <b>Topical steroid</b><br>3. <b>Oral/IV acetazolamide</b><br>4. <b>IV mannitol if refractory</b><br>5. Definitive: <b>LPI to BOTH eyes</b>" },
{ q: "What is the difference between a filtering bleb and an encapsulated bleb?", a: "<b>Filtering (functioning) bleb</b>: <b>diffuse, thin-walled, cystic</b> elevation of conjunctiva over the trabeculectomy site → good IOP control<br><b>Encapsulated (Tenon's cyst) bleb</b>: <b>dome-shaped, thick-walled</b>, forms 2–8 weeks postop, high IOP due to limited filtration → may respond to <b>aqueous suppressants, massage, or needling</b>" },
{ q: "What does the Glaucoma Hemifield Test (GHT) assess?", a: "The <b>GHT</b> is part of the Humphrey visual field printout. It compares corresponding regions in the <b>superior and inferior hemifields</b>.<br>Results: <b>'Outside normal limits'</b> = significant asymmetry → highly suggestive of glaucoma<br><b>'Borderline'</b>, <b>'Within normal limits'</b>, or <b>'Abnormally high sensitivity'</b><br>Useful for <b>early detection</b> of glaucomatous VF loss." },
{ q: "What are the reliability indices on a Humphrey visual field and what do they mean?", a: "<b>Fixation losses</b>: >20% = unreliable (patient not fixating)<br><b>False positives</b>: >15% = trigger-happy patient (responses without stimulus)<br><b>False negatives</b>: >33% = unreliable (no response to suprathreshold stimulus in previously seen area — can also indicate advanced disease)<br>Always check reliability before interpreting the VF." },
{ q: "What is peripapillary atrophy and its significance in glaucoma?", a: "<b>Peripapillary atrophy (PPA)</b>:<br><b>Zone beta</b> (inner): visible sclera and large choroidal vessels, associated with <b>glaucomatous damage</b> — enlarges with progression<br><b>Zone alpha</b> (outer): irregular pigmentation, less specific<br>Progressive zone beta PPA correlates with <b>RNFL loss</b> and is a risk factor for <b>glaucoma progression</b>." },
{ q: "What is the mechanism of mannitol in acute angle-closure treatment?", a: "<b>Mannitol</b> = <b>osmotic agent</b> given IV (1–2 g/kg).<br>Creates an <b>osmotic gradient</b> → draws water from the vitreous humor into the bloodstream → <b>reduces vitreous volume</b> → <b>lowers IOP</b>.<br>Used in <b>emergencies</b> when topical/oral agents are insufficient.<br>Contraindicated in <b>renal failure and CHF</b>." },
{ q: "Why is gonioscopy performed on BOTH eyes in glaucoma evaluation?", a: "1. In <b>angle closure</b>: fellow eye has <b>similar anatomy</b> and high risk of attack → prophylactic LPI<br>2. In <b>angle recession</b>: comparison needed — the <b>fellow eye serves as the normal reference</b> for angle width<br>3. Baseline documentation for <b>progression monitoring</b><br>4. Detect <b>asymmetric disease</b> (e.g., unilateral PXF, NVG)." },
          ]
        },
        {
          section: 'Ophthalmology',
          topic: "Retinal emergencies — detachment, CRAO, CRVO",
          icon: "eye",
          cards: [
            { q: "List the <b>10 layers of the retina</b> from outermost (closest to choroid) to innermost.", a: "<b>1.</b> Retinal pigment epithelium (RPE)<br><b>2.</b> Photoreceptor layer (rods & cones)<br><b>3.</b> External limiting membrane (ELM)<br><b>4.</b> Outer nuclear layer (ONL)<br><b>5.</b> Outer plexiform layer (OPL)<br><b>6.</b> Inner nuclear layer (INL)<br><b>7.</b> Inner plexiform layer (IPL)<br><b>8.</b> Ganglion cell layer (GCL)<br><b>9.</b> Nerve fiber layer (NFL)<br><b>10.</b> Internal limiting membrane (ILM)" },
{ q: "What is the <b>blood supply</b> to the outer retina vs the inner retina?", a: "<b>Outer retina</b> (RPE, photoreceptors, outer nuclear layer) → supplied by the <b>choroidal circulation</b> (short posterior ciliary arteries)<br><b>Inner retina</b> (ganglion cell layer, NFL, inner nuclear layer) → supplied by the <b>central retinal artery</b> (branch of ophthalmic artery from ICA)" },
{ q: "Why does the <b>fovea</b> appear as a <b>cherry-red spot</b> in CRAO?", a: "The fovea has <b>no inner retinal layers</b> — only photoreceptors — so it is supplied exclusively by the <b>choroidal circulation</b>, which remains perfused.<br>The surrounding pale retina reflects <b>ischemic edema of the inner retina</b> (supplied by the occluded central retinal artery), making the fovea appear red by contrast." },
{ q: "Define <b>macula</b>, <b>fovea</b>, <b>foveola</b>, and <b>umbo</b>.", a: "<b>Macula</b>: Central 5.5 mm area with xanthophyll pigment, responsible for central vision<br><b>Fovea</b>: Central depression within macula (~1.5 mm), highest cone density<br><b>Foveola</b>: Center of fovea (~0.35 mm), contains only cones, avascular<br><b>Umbo</b>: Light reflex at the very center of the foveola" },
{ q: "What constitutes the <b>blood-retinal barrier</b>?", a: "<b>Outer blood-retinal barrier</b>: Tight junctions of the <b>RPE</b> (separates retina from choroidal circulation)<br><b>Inner blood-retinal barrier</b>: Tight junctions of <b>retinal capillary endothelial cells</b> (non-fenestrated, similar to blood-brain barrier)" },
{ q: "Which retinal layers are contained in the <b>neurosensory retina</b> that detaches in an RD?", a: "All 9 layers from the <b>photoreceptor layer through the ILM</b>.<br>In a retinal detachment, the neurosensory retina separates from the underlying <b>RPE</b> at the level of the <b>subretinal space</b> (potential space between photoreceptors and RPE)." },
{ q: "Name the <b>three types</b> of retinal detachment.", a: "<b>1. Rhegmatogenous</b> (most common) — retinal break/tear allows liquefied vitreous into subretinal space<br><b>2. Tractional</b> — fibrovascular membranes pull retina away from RPE<br><b>3. Exudative (serous)</b> — fluid accumulates under retina without a break" },
{ q: "What is the <b>pathophysiology</b> of a <b>rhegmatogenous retinal detachment</b> (RRD)?", a: "A <b>full-thickness retinal break</b> (tear or hole) allows <b>liquefied vitreous humor</b> to pass through the break and accumulate in the <b>subretinal space</b>, separating the neurosensory retina from the RPE.<br>This is the <b>most common</b> type of retinal detachment." },
{ q: "List <b>risk factors</b> for rhegmatogenous retinal detachment.", a: "<b>• Myopia</b> (axial elongation thins retina)<br><b>• Prior cataract surgery / aphakia / pseudophakia</b><br><b>• Trauma</b><br><b>• Lattice degeneration</b><br><b>• Family history of RD</b><br><b>• Fellow eye RD</b> (risk ~10%)<br><b>• Age</b> (PVD more common with age)<br>• Marfan syndrome, Stickler syndrome" },
{ q: "What are the <b>classic symptoms</b> of rhegmatogenous retinal detachment?", a: "<b>1. Flashes</b> (photopsia) — vitreoretinal traction stimulating photoreceptors<br><b>2. Floaters</b> — pigment cells or blood in vitreous<br><b>3. Curtain / shadow / veil</b> spreading across visual field — progressing detachment<br><b>4. Painless</b> progressive visual field loss → central vision loss if macula detaches" },
{ q: "What is <b>Shafer sign</b> (tobacco dust)?", a: "<b>Pigmented cells</b> (from the RPE) seen floating in the <b>anterior vitreous</b> on slit lamp exam.<br>Highly suggestive of a <b>retinal tear or detachment</b>.<br>Also called <b>tobacco dust</b> due to the brown, granular appearance." },
{ q: "Differentiate <b>macula-on</b> vs <b>macula-off</b> retinal detachment in terms of urgency.", a: "<b>Macula-on RD</b>: Macula still attached → <b>surgical emergency within 24 hours</b> to preserve central vision<br><b>Macula-off RD</b>: Macula already detached → <b>urgent but not emergent</b>; surgery within days (visual prognosis already compromised)<br>Key: Duration of macular detachment correlates with final visual outcome." },
{ q: "Describe the <b>three surgical options</b> for rhegmatogenous retinal detachment.", a: "<b>1. Pneumatic retinopexy</b>: Intravitreal gas bubble + cryopexy/laser → for superior, single-break RD<br><b>2. Scleral buckle</b>: Silicone band sutured to sclera indents wall inward → closes break (good for inferior RD, young patients)<br><b>3. Pars plana vitrectomy (PPV)</b>: Remove vitreous, drain subretinal fluid, laser/cryo, gas/silicone oil tamponade → complex or posterior breaks" },
{ q: "In <b>pneumatic retinopexy</b>, what must the patient do postoperatively and why?", a: "The patient must maintain <b>specific head positioning</b> so the <b>gas bubble</b> (which rises) tamponades the retinal break.<br>Works best for <b>superior retinal breaks</b>.<br>Patient must <b>avoid air travel</b> until gas resorbs (gas expands at altitude → dangerous IOP rise)." },
{ q: "What is a <b>tractional retinal detachment</b>? Name causes.", a: "<b>Fibrovascular proliferation</b> creates membranes on the retinal surface that <b>contract and pull</b> the retina away from the RPE <b>without a retinal break</b>.<br><b>Causes:</b><br>• <b>Proliferative diabetic retinopathy</b> (most common)<br>• Sickle cell retinopathy<br>• Retinopathy of prematurity (ROP)<br>• Proliferative vitreoretinopathy (PVR)<br>• Penetrating trauma" },
{ q: "What is an <b>exudative (serous) retinal detachment</b>? List causes.", a: "Fluid accumulates in the subretinal space <b>without a retinal break or traction</b>.<br><b>Causes:</b><br>• <b>Vogt-Koyanagi-Harada (VKH)</b> syndrome<br>• <b>Preeclampsia / eclampsia</b><br>• Choroidal tumors (melanoma, metastases)<br>• Posterior scleritis<br>• Severe hypertension<br>• Central serous chorioretinopathy<br>• Coat disease<br>• Inflammatory conditions (sarcoid, sympathetic ophthalmia)" },
{ q: "How does a <b>tractional RD</b> appear differently from a rhegmatogenous RD on exam?", a: "<b>Tractional RD</b>: Retina has a <b>concave, taut, tent-like</b> configuration; does not extend to ora serrata; <b>no retinal break</b> visible<br><b>Rhegmatogenous RD</b>: Retina is <b>convex, corrugated, mobile</b>; <b>break/tear visible</b>; extends to ora serrata; subretinal fluid shifts with eye movement" },
{ q: "What is <b>posterior vitreous detachment</b> (PVD)?", a: "Age-related <b>liquefaction (syneresis)</b> of the vitreous gel causes it to <b>collapse and separate</b> from the retina (specifically from the ILM).<br>Usually begins posteriorly around the <b>optic disc and macula</b>.<br>Common after age <b>50–70</b>, earlier in myopes." },
{ q: "What is a <b>Weiss ring</b>?", a: "A <b>circular or oval ring of glial tissue</b> seen floating in the vitreous, representing the detached <b>peripapillary vitreous</b> (vitreous that was adherent to the optic disc margin).<br>It is <b>pathognomonic of a complete PVD</b>." },
{ q: "A patient presents with sudden <b>floaters and flashes</b>. What is the most important diagnosis to rule out?", a: "<b>Retinal tear</b> — present in ~<b>15%</b> of acute symptomatic PVDs.<br>All patients with new-onset flashes and floaters need a <b>dilated fundus exam</b> to rule out retinal tear/detachment.<br>If retinal tear found → prophylactic <b>laser photocoagulation</b> or <b>cryopexy</b> to prevent progression to RD." },
{ q: "How do <b>photopsias</b> (flashes) differ between PVD and migraine?", a: "<b>PVD flashes</b>: Brief, arc-like, <b>unilateral</b>, in temporal visual field, provoked by eye movement, due to vitreoretinal traction on photoreceptors<br><b>Migraine flashes</b>: Scintillating scotoma, <b>bilateral</b>, expanding zigzag lines (fortification spectra), last 15–30 min, may be followed by headache" },
{ q: "What is a <b>horseshoe (flap) tear</b> and why is it dangerous?", a: "A <b>U-shaped retinal tear</b> with a flap of retina pulled anteriorly by persistent vitreous traction.<br><b>Highest risk for progression to RRD</b> because:<br>• Ongoing vitreous traction keeps the flap open<br>• Liquefied vitreous easily enters the subretinal space<br><b>Treatment</b>: Prophylactic <b>laser photocoagulation</b> or <b>cryopexy</b> around the tear." },
{ q: "What is <b>lattice degeneration</b>?", a: "<b>Peripheral retinal thinning</b> with <b>crosshatched (lattice-like) white lines</b> representing sclerosed retinal vessels.<br>Found in <b>~8%</b> of the general population, <b>more common in myopes</b>.<br>Associated with atrophic holes and retinal tears → <b>risk factor for RRD</b>.<br>Usually no treatment unless symptomatic tears develop." },
{ q: "Differentiate <b>atrophic holes</b> from <b>horseshoe tears</b> in risk of retinal detachment.", a: "<b>Atrophic holes</b>: Round, no vitreous traction, <b>lower risk</b> for RD → usually <b>observed</b><br><b>Horseshoe tears</b>: Caused by vitreous traction, <b>higher risk</b> for RD → <b>require treatment</b> (laser or cryo)<br>Key: Traction = higher risk" },
{ q: "A patient presents with <b>sudden painless monocular vision loss</b>, counting-fingers vision, <b>APD</b>, and a <b>pale retina with a cherry-red spot</b>. Diagnosis?", a: "<b>Central retinal artery occlusion (CRAO)</b><br>This is an <b>ophthalmic emergency</b> — retinal ischemia causes irreversible damage within <b>~90 minutes</b>." },
{ q: "What is the <b>pathophysiology</b> of CRAO?", a: "<b>Occlusion of the central retinal artery</b> (branch of ophthalmic artery from ICA) → ischemia of the <b>inner retina</b>.<br><b>Causes:</b><br>• <b>Thromboembolism</b> from carotid atherosclerosis (most common)<br>• Cardiac emboli (valvular disease, AF)<br>• Giant cell arteritis (GCA)<br>• Hypercoagulable states<br>• Vasculitis, dissection" },
{ q: "Describe the <b>fundoscopic findings</b> in CRAO.", a: "<b>1. Pale/whitened retina</b> — ischemic edema of inner retinal layers<br><b>2. Cherry-red spot</b> at the macula (thin fovea lets choroidal red show through)<br><b>3. Box-car segmentation</b> — segmented blood column in retinal arterioles<br><b>4. Attenuated (narrowed) arterioles</b><br><b>5. Emboli may be visible</b> (Hollenhorst plaques)" },
{ q: "What are <b>Hollenhorst plaques</b>?", a: "<b>Cholesterol emboli</b> seen as <b>bright, refractile, yellow-orange</b> plaques at retinal arteriolar bifurcations.<br>Origin: <b>Carotid artery atherosclerosis</b> (usually ipsilateral ICA).<br>May be asymptomatic or cause transient/permanent visual loss." },
{ q: "Name the <b>types of retinal emboli</b> and their sources.", a: "<b>1. Cholesterol (Hollenhorst plaques)</b>: Bright yellow, refractile → <b>carotid atherosclerosis</b><br><b>2. Fibrin-platelet</b>: Dull white, elongated → <b>carotid or cardiac thrombus</b><br><b>3. Calcific</b>: White, non-refractile, often at disc → <b>cardiac valves</b> (aortic valve calcification)<br><b>4. Septic</b>: White, associated with Roth spots → <b>endocarditis</b>" },
{ q: "What is the <b>time window</b> for irreversible retinal damage in CRAO?", a: "<b>~90 minutes</b> of complete ischemia → irreversible retinal damage.<br>However, most patients present later.<br>Interventions may be attempted within <b>4.5–6 hours</b> of symptom onset (similar to stroke window)." },
{ q: "List the <b>acute treatments</b> for CRAO.", a: "<b>1. Ocular massage</b> — intermittent pressure to dislodge embolus<br><b>2. Anterior chamber paracentesis</b> — acute IOP reduction<br><b>3. IV acetazolamide</b> — reduce IOP<br><b>4. Carbogen inhalation</b> (95% O₂ + 5% CO₂) — vasodilate retinal vessels<br><b>5. Intra-arterial tPA</b> (within 4.5–6 h) — thrombolysis<br><b>6. Topical timolol</b> — reduce IOP<br>Note: Evidence for most treatments is limited." },
{ q: "Why must you <b>rule out GCA</b> in a patient >50 with CRAO?", a: "<b>GCA causes ~5% of CRAO</b> and can cause <b>bilateral blindness</b> if untreated.<br>Workup in all patients >50 with CRAO:<br>• <b>ESR</b> (often >50, sometimes >100)<br>• <b>CRP</b><br>• <b>CBC</b> (thrombocytosis, anemia)<br>If GCA suspected → <b>immediate high-dose IV methylprednisolone</b> → temporal artery biopsy (do NOT delay steroids for biopsy)." },
{ q: "What systemic <b>workup</b> is needed after CRAO?", a: "<b>1. Carotid Doppler ultrasound</b> — ipsilateral carotid stenosis<br><b>2. Echocardiogram</b> (TTE ± TEE) — cardiac emboli source<br><b>3. ECG / telemetry</b> — atrial fibrillation<br><b>4. ESR + CRP</b> — rule out GCA (age >50)<br><b>5. CBC, lipid panel, glucose, HbA1c</b> — vascular risk factors<br><b>6. Hypercoagulability workup</b> (young patients)" },
{ q: "What is a <b>branch retinal artery occlusion</b> (BRAO)?", a: "Occlusion of a <b>branch of the central retinal artery</b> → ischemia affecting only a <b>sector of the retina</b>.<br><b>Findings:</b> Sectoral pale retinal whitening corresponding to the affected branch; embolus often visible at bifurcation.<br><b>Visual field</b>: Corresponding altitudinal or sectoral defect.<br>Prognosis better than CRAO; same embolic workup required." },
{ q: "What is <b>cilioretinal artery sparing</b> in CRAO?", a: "~15–30% of people have a <b>cilioretinal artery</b> (from the choroidal/ciliary circulation, NOT the CRA).<br>In CRAO, this artery <b>remains patent</b>, preserving a small area of <b>papillomacular bundle perfusion</b> → relatively preserved central vision.<br>Seen as a <b>tongue of normal-colored retina</b> along the papillomacular bundle amid the pale ischemic retina." },
{ q: "What is <b>giant cell arteritis</b> (GCA / temporal arteritis)?", a: "A <b>granulomatous vasculitis</b> of <b>medium and large arteries</b>, especially branches of the <b>external carotid artery</b> (superficial temporal, ophthalmic arteries).<br>Affects patients <b>>50 years old</b> (mean age ~70).<br><b>Most common systemic vasculitis</b> in adults in the Western world." },
{ q: "List the <b>classic symptoms</b> of GCA.", a: "<b>• New-onset headache</b> (temporal, severe)<br><b>• Jaw claudication</b> (most specific symptom — pain with chewing)<br><b>• Scalp tenderness</b> (pain when combing hair)<br><b>• Constitutional symptoms</b> — fever, weight loss, malaise, fatigue<br><b>• Visual symptoms</b> — transient visual loss (amaurosis fugax), diplopia → permanent loss<br><b>• Polymyalgia rheumatica</b> (PMR) — in ~50% (proximal muscle pain/stiffness)" },
{ q: "What lab findings support a diagnosis of <b>GCA</b>?", a: "<b>ESR markedly elevated</b> — typically >50 mm/hr, often >100<br><b>CRP elevated</b> — more sensitive than ESR<br><b>Thrombocytosis</b> (reactive)<br><b>Normocytic anemia</b><br><b>Elevated alkaline phosphatase</b><br>Note: A <b>normal ESR does not rule out GCA</b> — CRP adds sensitivity." },
{ q: "What is the <b>gold standard</b> for diagnosing GCA?", a: "<b>Temporal artery biopsy</b><br>Shows: <b>Granulomatous inflammation</b> of the vessel wall with giant cells, intimal thickening, and fragmentation of the internal elastic lamina.<br><b>Skip lesions</b> are common → biopsy must be <b>≥2 cm in length</b>; if negative, contralateral biopsy may be needed.<br><b>Critical: Do NOT delay steroid treatment</b> while awaiting biopsy — biopsy remains positive for <b>up to 2 weeks</b> after starting steroids." },
{ q: "What is the <b>treatment</b> for GCA with visual symptoms?", a: "<b>Immediate high-dose IV methylprednisolone</b> (1 g/day × 3 days) → transition to <b>oral prednisone</b> (1 mg/kg/day) with slow taper over months.<br><b>Do NOT wait for biopsy results</b> before starting steroids.<br>Goal: Prevent <b>bilateral blindness</b> from anterior ischemic optic neuropathy (AION) or CRAO.<br>Tocilizumab (IL-6 inhibitor) as steroid-sparing agent." },
{ q: "What is the most feared <b>ophthalmic complication</b> of GCA?", a: "<b>Arteritic anterior ischemic optic neuropathy (A-AION)</b><br>Ischemia of the optic nerve head from occlusion of the <b>posterior ciliary arteries</b>.<br>Presents with <b>severe, sudden vision loss</b>, <b>disc edema</b> (pallid/chalky white), <b>APD</b>.<br>Without treatment, <b>fellow eye involvement occurs in ~50%</b> within days to weeks." },
{ q: "What is <b>central retinal vein occlusion</b> (CRVO)?", a: "Occlusion of the <b>central retinal vein</b> at or near the <b>lamina cribrosa</b> → impaired venous drainage → retinal congestion, hemorrhage, and edema.<br>Presents with <b>painless monocular vision loss</b> (less sudden than CRAO)." },
{ q: "Describe the <b>fundoscopic appearance</b> of CRVO.", a: "<b>'Blood and thunder' fundus:</b><br>• <b>Diffuse retinal hemorrhages</b> in all 4 quadrants (flame-shaped and dot-blot)<br>• <b>Cotton-wool spots</b> (nerve fiber layer infarcts)<br>• <b>Disc edema / hyperemia</b><br>• <b>Dilated, tortuous retinal veins</b><br>• <b>Macular edema</b> (most common cause of vision loss)" },
{ q: "List the <b>risk factors</b> for CRVO.", a: "<b>• Hypertension</b> (#1 risk factor)<br>• Diabetes mellitus<br>• Open-angle glaucoma / elevated IOP<br>• Hyperviscosity syndromes (polycythemia vera, Waldenström)<br>• Hypercoagulable states (Factor V Leiden, antiphospholipid syndrome)<br>• Oral contraceptives<br>• Vasculitis / inflammatory conditions<br>• Age >50" },
{ q: "Differentiate <b>non-ischemic (perfused)</b> vs <b>ischemic (non-perfused)</b> CRVO.", a: "<b>Non-ischemic (75%):</b><br>• Milder hemorrhages, better VA (often 20/200 or better)<br>• No APD, less cotton-wool spots<br>• <10 disc areas of capillary non-perfusion on FA<br>• Better prognosis; ~⅓ resolve spontaneously<br><br><b>Ischemic (25%):</b><br>• Severe hemorrhages, VA ≤20/200<br>• <b>APD present</b><br>• >10 disc areas of capillary non-perfusion on FA<br>• High risk of neovascularization → <b>neovascular glaucoma</b>" },
{ q: "What is <b>'100-day glaucoma'</b>?", a: "<b>Neovascular glaucoma (NVG)</b> developing ~<b>3 months (100 days)</b> after <b>ischemic CRVO</b>.<br>Mechanism: Retinal ischemia → VEGF release → <b>neovascularization of the iris (rubeosis iridis)</b> and angle → fibrovascular membrane blocks trabecular meshwork → secondary angle-closure glaucoma.<br>Occurs in ~<b>60%</b> of ischemic CRVO." },
{ q: "What is <b>rubeosis iridis</b>?", a: "<b>Neovascularization of the iris</b> — abnormal new blood vessels growing on the iris surface and into the anterior chamber angle.<br>Caused by <b>ischemia-driven VEGF</b> release (ischemic CRVO, proliferative DR, OIS, CRAO).<br>Leads to <b>neovascular glaucoma</b> (NVG) as fibrovascular tissue obstructs the trabecular meshwork." },
{ q: "What is the <b>treatment</b> for CRVO?", a: "<b>For macular edema:</b><br>• <b>Anti-VEGF injections</b> (ranibizumab, aflibercept, bevacizumab) — first-line<br>• Intravitreal dexamethasone implant (Ozurdex)<br><br><b>For neovascularization:</b><br>• <b>Panretinal photocoagulation (PRP)</b><br>• Anti-VEGF injections<br><br><b>Systemic:</b><br>• Treat underlying risk factors (HTN, DM, glaucoma)<br>• Hypercoagulability workup in young patients" },
{ q: "What is a <b>branch retinal vein occlusion</b> (BRVO)?", a: "Occlusion of a <b>branch of the retinal vein</b>, usually at an <b>arteriovenous (AV) crossing</b> where the artery compresses the vein.<br><b>Findings:</b> <b>Sectoral</b> (wedge-shaped) retinal hemorrhages, cotton-wool spots, and edema in the distribution of the affected branch.<br><b>Superotemporal branch</b> is most commonly affected." },
{ q: "Why does BRVO occur specifically at <b>AV crossings</b>?", a: "At AV crossings, the artery and vein share a common <b>adventitial sheath</b>.<br>Arteriosclerotic thickening of the artery <b>compresses the underlying vein</b> → turbulent flow → thrombus formation → venous occlusion.<br>This explains the strong association with <b>HTN</b> and <b>atherosclerosis</b>." },
{ q: "What key study demonstrated benefit of <b>anti-VEGF</b> for CRVO macular edema?", a: "The <b>CRUISE trial</b> (ranibizumab) and <b>COPERNICUS/GALILEO trials</b> (aflibercept) showed significant visual improvement with monthly anti-VEGF injections for macular edema secondary to CRVO.<br>Anti-VEGF is now <b>first-line therapy</b> for CRVO-associated macular edema." },
{ q: "What is a <b>vitreous hemorrhage</b>? How does it present?", a: "<b>Blood in the vitreous cavity</b>.<br><b>Symptoms:</b> Sudden onset of <b>floaters</b> (mild) or <b>profound vision loss</b> (dense), painless<br><b>Signs:</b><br>• <b>Loss of red reflex</b><br>• <b>Cannot visualize the fundus</b> (if dense)<br>• Blood may layer inferiorly" },
{ q: "List the <b>causes</b> of vitreous hemorrhage.", a: "<b>1. Proliferative diabetic retinopathy</b> (#1 cause overall)<br><b>2. PVD with retinal tear</b> (#1 cause in non-diabetics)<br><b>3. Retinal vein occlusion</b><br><b>4. Trauma</b><br><b>5. Terson syndrome</b> (vitreous hemorrhage from subarachnoid hemorrhage)<br><b>6. Sickle cell retinopathy</b><br><b>7. Retinal macroaneurysm</b><br><b>8. Age-related macular degeneration</b> (wet)<br><b>9. Valsalva retinopathy</b>" },
{ q: "What imaging is essential when the <b>fundus cannot be visualized</b> due to vitreous hemorrhage?", a: "<b>B-scan ultrasonography</b><br>Used to evaluate the posterior segment for:<br>• <b>Retinal detachment</b><br>• Retinal tear<br>• Posterior vitreous detachment<br>• Intraocular mass / tumor<br>Must rule out <b>RD</b>, which would require urgent surgical intervention." },
{ q: "What is the <b>treatment</b> for vitreous hemorrhage?", a: "<b>Mild/moderate (can see fundus):</b><br>• Observation — blood often clears spontaneously (weeks to months)<br>• Upright sleeping position (blood settles inferiorly)<br>• Treat underlying cause<br><br><b>Dense/non-clearing:</b><br>• <b>Pars plana vitrectomy (PPV)</b><br>• Also indicated if <b>associated retinal detachment</b><br>• Urgent PPV if RD suspected on B-scan" },
{ q: "What is <b>Terson syndrome</b>?", a: "<b>Vitreous hemorrhage</b> (or subhyaloid/preretinal hemorrhage) occurring in association with <b>subarachnoid hemorrhage (SAH)</b>.<br>Mechanism: Sudden rise in intracranial pressure → transmitted to optic nerve sheath → rupture of peripapillary retinal vessels.<br>Found in ~<b>10–20%</b> of SAH patients; associated with <b>worse neurological prognosis</b>." },
{ q: "What is <b>amaurosis fugax</b>?", a: "<b>Transient monocular vision loss</b> lasting <b>seconds to minutes</b>, described as a <b>curtain descending</b> over the eye, then lifting.<br>Caused by <b>transient retinal ischemia</b>, most commonly from <b>emboli</b> (carotid atherosclerosis).<br>Considered a <b>TIA equivalent</b> — high risk for future stroke." },
{ q: "What <b>workup</b> is indicated for amaurosis fugax?", a: "<b>1. Carotid Doppler ultrasound</b> — assess for ipsilateral carotid stenosis<br><b>2. Echocardiogram</b> (TTE ± TEE) — cardiac embolic source<br><b>3. ECG / Holter monitor</b> — atrial fibrillation<br><b>4. MRI brain / MRA</b> — stroke evaluation<br><b>5. CBC, lipid panel, glucose, ESR/CRP</b> (age >50 → rule out GCA)<br><b>6. Dilated fundoscopy</b> — Hollenhorst plaques, retinal findings" },
{ q: "How is <b>carotid stenosis</b> managed when found in amaurosis fugax?", a: "<b>Symptomatic carotid stenosis ≥70%:</b> <b>Carotid endarterectomy (CEA)</b> or carotid artery stenting<br><b>Symptomatic stenosis 50–69%:</b> CEA may benefit select patients<br><b><50%:</b> Medical management (antiplatelet, statin, risk factor control)<br>Also: <b>Aspirin or antiplatelet therapy</b> for all patients + statin + BP control" },
{ q: "Define <b>anterior ischemic optic neuropathy</b> (AION).", a: "Ischemia of the <b>optic nerve head</b> due to occlusion of the <b>short posterior ciliary arteries</b>.<br>Two types:<br><b>1. Arteritic (A-AION)</b> → caused by <b>GCA</b><br><b>2. Non-arteritic (NA-AION)</b> → caused by vasculopathic risk factors<br>Presents with <b>acute painless monocular vision loss</b> + <b>disc edema</b> + <b>altitudinal visual field defect</b>." },
{ q: "Compare <b>arteritic AION</b> (A-AION) vs <b>non-arteritic AION</b> (NA-AION).", a: "<b>A-AION (GCA):</b><br>• Age >70, severe vision loss (often CF or worse)<br>• Pallid/chalky disc edema<br>• ESR/CRP markedly elevated<br>• <b>Treat emergently with IV steroids</b><br>• High risk of fellow eye involvement<br><br><b>NA-AION:</b><br>• Age 40–60, moderate vision loss<br>• Hyperemic (not pallid) disc edema<br>• Vasculopathic risk factors (HTN, DM, hyperlipidemia)<br>• <b>'Disc at risk'</b> — small cup-to-disc ratio<br>• <b>No proven treatment</b>; manage risk factors" },
{ q: "What is the <b>'disc at risk'</b> in NA-AION?", a: "A <b>small, crowded optic disc</b> with a <b>small or absent physiologic cup</b> (cup-to-disc ratio <0.3).<br>The crowded optic nerve head predisposes to <b>compartment syndrome</b> — when axonal edema occurs, the tight disc cannot accommodate swelling → compression of capillaries → ischemia → NA-AION." },
{ q: "What visual field defect is characteristic of <b>AION</b>?", a: "<b>Altitudinal visual field defect</b> — typically <b>inferior altitudinal</b> (loss of the lower visual field), corresponding to ischemia of the <b>superior portion of the optic nerve head</b>.<br>May also be arcuate, central, or generalized." },
{ q: "What happens to the optic disc over time after AION?", a: "<b>Acutely:</b> <b>Disc edema</b> (pallid in A-AION, hyperemic in NA-AION)<br><b>4–6 weeks later:</b> Edema resolves → <b>optic disc pallor (atrophy)</b><br>The disc becomes pale and atrophic as damaged ganglion cell axons degenerate." },
{ q: "What is a <b>retinal artery macroaneurysm</b>?", a: "A <b>fusiform or saccular dilation</b> of a retinal arteriole (usually within the first 3 orders of bifurcation).<br><b>Demographics:</b> <b>Elderly hypertensive women</b><br><b>Location:</b> Superotemporal artery most common<br><b>Complications:</b> Hemorrhage (subretinal, intraretinal, preretinal, vitreous) or exudation (lipid deposition, macular edema)" },
{ q: "How is <b>retinal artery macroaneurysm</b> managed?", a: "<b>Observation</b> — many thrombose and involute spontaneously<br><b>Laser photocoagulation</b> — if associated with:<br>• Chronic macular edema threatening vision<br>• Circinate (ring) exudates encroaching on the fovea<br><b>Anti-VEGF</b> — for associated macular edema<br><b>Treat underlying HTN</b>" },
{ q: "What is <b>ocular ischemic syndrome</b> (OIS)?", a: "Chronic ocular hypoperfusion due to severe <b>ipsilateral carotid artery stenosis (>90%)</b> or occlusion.<br>Results from decreased flow through the <b>ophthalmic artery</b> → ischemia of all ocular structures." },
{ q: "List the <b>clinical features</b> of ocular ischemic syndrome.", a: "<b>Symptoms:</b> <b>Dull, aching periorbital pain</b>, gradual vision loss<br><b>Anterior segment:</b> Anterior chamber flare, rubeosis iridis, asymmetric cataract, <b>low IOP</b> (decreased aqueous production from ciliary body ischemia)<br><b>Posterior segment:</b><br>• <b>Dilated but non-tortuous veins</b> (key difference from CRVO)<br>• <b>Dot-blot hemorrhages in mid-periphery</b><br>• Microaneurysms<br>• Cotton-wool spots<br>• Spontaneous arterial pulsations on disc" },
{ q: "How do you differentiate <b>OIS</b> from <b>CRVO</b> on fundoscopy?", a: "<b>OIS:</b><br>• Veins <b>dilated but NOT tortuous</b><br>• Hemorrhages predominantly <b>mid-peripheral, dot-blot</b><br>• <b>Low IOP</b><br>• Spontaneous arterial pulsations<br><br><b>CRVO:</b><br>• Veins <b>dilated AND tortuous</b><br>• Hemorrhages <b>diffuse, all 4 quadrants</b> (flame + dot-blot)<br>• <b>Normal or elevated IOP</b><br>• No spontaneous arterial pulsations" },
{ q: "What finding helps distinguish OIS from diabetic retinopathy?", a: "<b>Asymmetric diabetic retinopathy</b> — more severe retinopathy on the side <b>contralateral</b> to the carotid stenosis (the ischemic eye has <b>less</b> perfusion pressure → fewer hemorrhages).<br>Also: <b>Low IOP</b> on the affected side and <b>neovascularization of the disc (NVD)</b> more common than NVE in OIS." },
{ q: "What is the <b>management</b> of ocular ischemic syndrome?", a: "<b>1. Carotid endarterectomy or stenting</b> — restore blood flow (if >70% stenosis)<br><b>2. PRP</b> — for neovascularization<br><b>3. Anti-VEGF</b> — for neovascularization/macular edema<br><b>4. Topical steroids + cycloplegics</b> — for anterior segment inflammation<br><b>5. IOP management</b> — if neovascular glaucoma develops<br><b>6. Systemic vascular risk factor control</b>" },
{ q: "What is a <b>Marcus Gunn pupil</b> (relative APD)?", a: "A <b>relative afferent pupillary defect</b> — the affected eye has <b>reduced direct pupillary response</b> compared to the consensual response.<br>Detected by the <b>swinging flashlight test</b>: When light swings to the affected eye, <b>both pupils dilate</b> (paradoxical dilation).<br>Indicates unilateral or asymmetric <b>optic nerve or extensive retinal disease</b>." },
{ q: "In which retinal conditions do you expect an <b>APD</b>?", a: "<b>CRAO</b> — present (extensive retinal ischemia)<br><b>Ischemic CRVO</b> — present (extensive retinal ischemia)<br><b>Non-ischemic CRVO</b> — usually absent<br><b>AION</b> — present (optic nerve ischemia)<br><b>Retinal detachment</b> — may be present (if extensive)<br><b>Optic neuritis</b> — present<br>Key: APD in CRVO suggests <b>ischemic type</b> → higher risk for NVG." },
{ q: "An elderly patient with CRVO develops <b>eye pain, red eye, and high IOP</b> 3 months later. What happened?", a: "<b>Neovascular glaucoma (NVG)</b> — '100-day glaucoma'<br>Retinal ischemia → VEGF → rubeosis iridis → fibrovascular membrane covers angle → <b>secondary angle-closure glaucoma</b><br>Treatment: Anti-VEGF + PRP + IOP-lowering (medical, then surgical if needed)" },
{ q: "What is <b>central serous chorioretinopathy</b> (CSCR)?", a: "Idiopathic serous detachment of the neurosensory retina at the <b>macula</b> due to leakage through the <b>RPE</b>.<br><b>Demographics:</b> Young men (30–50), type A personality, stress<br><b>Association:</b> Corticosteroid use, Cushing syndrome, pregnancy<br><b>Symptoms:</b> Central scotoma, metamorphopsia, micropsia, hyperopia shift<br><b>FA:</b> Classic <b>'smokestack'</b> or <b>'inkblot'</b> leakage pattern" },
{ q: "How does <b>CSCR</b> differ from exudative retinal detachment?", a: "<b>CSCR:</b> Small, dome-shaped, localized serous detachment at macula; no retinal break; young male; self-limited in most cases; associated with steroids<br><b>Exudative RD:</b> Larger, shifting fluid, associated with systemic disease (VKH, tumors, HTN, preeclampsia); no break; requires treatment of underlying cause" },
{ q: "What is <b>Vogt-Koyanagi-Harada</b> (VKH) disease?", a: "A <b>bilateral granulomatous panuveitis</b> with <b>exudative retinal detachments</b>, targeting <b>melanocyte-containing tissues</b>.<br><b>Features:</b><br>• <b>Bilateral exudative RD</b><br>• <b>Poliosis</b> (whitening of eyelashes/hair)<br>• <b>Vitiligo</b><br>• <b>Alopecia</b><br>• <b>Tinnitus / hearing loss</b><br>• <b>Meningismus</b> (CSF pleocytosis)<br>More common in darkly pigmented individuals (Asian, Hispanic, Native American)." },
{ q: "What retinal finding is associated with <b>preeclampsia/eclampsia</b>?", a: "<b>Bilateral exudative (serous) retinal detachments</b> — due to choroidal ischemia from arteriolar vasospasm.<br>Also: Arteriolar narrowing, retinal edema, cotton-wool spots, serous macular detachment.<br>Usually <b>resolves after delivery</b>.<br>Retinal detachment in pregnancy + HTN → think preeclampsia." },
{ q: "What is <b>proliferative vitreoretinopathy</b> (PVR)?", a: "The <b>most common cause of failure</b> of retinal detachment surgery.<br>RPE cells and glial cells proliferate and form <b>contractile membranes</b> on the retinal surface and in the vitreous → <b>tractional re-detachment</b> of the retina.<br>Risk factors: Multiple surgeries, large/chronic RD, vitreous hemorrhage, inflammation." },
{ q: "What are <b>cotton-wool spots</b>?", a: "<b>Nerve fiber layer infarcts</b> — ischemia causes <b>axoplasmic flow stasis</b> in retinal ganglion cell axons, forming fluffy white superficial lesions.<br><b>Seen in:</b><br>• CRVO, BRVO<br>• Hypertensive retinopathy<br>• Diabetic retinopathy<br>• HIV retinopathy<br>• Systemic lupus erythematosus<br>• OIS, CRAO (acutely — before diffuse whitening)" },
{ q: "What are <b>Roth spots</b>?", a: "<b>Retinal hemorrhages with white/pale centers</b>.<br>The white center represents <b>fibrin-platelet aggregates</b>.<br><b>Classically associated with:</b><br>• <b>Bacterial endocarditis</b> (most classic association)<br>• Leukemia<br>• Severe anemia<br>• Septic emboli<br>• Collagen vascular diseases" },
{ q: "What is <b>fluorescein angiography (FA)</b> and its role in retinal vascular disease?", a: "<b>IV fluorescein dye</b> → serial fundus photographs to evaluate retinal vasculature.<br><b>Uses:</b><br>• CRVO/BRVO: Quantify capillary non-perfusion areas (ischemic vs non-ischemic)<br>• Identify macular edema (leakage)<br>• Detect neovascularization (leakage from new vessels)<br>• CSCR: Smokestack/inkblot leakage pattern<br>• Diabetic retinopathy: Map ischemia and guide PRP" },
{ q: "What is <b>OCT</b> and how is it used in retinal emergencies?", a: "<b>Optical coherence tomography</b> — non-invasive cross-sectional imaging of the retina.<br><b>Uses:</b><br>• Detect and quantify <b>macular edema</b> (CRVO, BRVO, diabetic)<br>• Confirm <b>subretinal fluid</b> in RD, CSCR<br>• Monitor treatment response (anti-VEGF)<br>• Identify <b>epiretinal membranes</b>, <b>vitreomacular traction</b><br>• Evaluate <b>retinal layers</b> for ischemic damage" },
{ q: "What is the mechanism of <b>anti-VEGF therapy</b> in retinal vein occlusion?", a: "Retinal ischemia → release of <b>vascular endothelial growth factor (VEGF)</b> → <b>vascular permeability</b> (→ macular edema) + <b>neovascularization</b>.<br>Anti-VEGF agents (ranibizumab, aflibercept, bevacizumab) <b>bind and neutralize VEGF</b> → reduce macular edema and inhibit neovascularization.<br>Administered as <b>intravitreal injections</b>." },
{ q: "Name the commonly used <b>anti-VEGF agents</b>.", a: "<b>1. Ranibizumab (Lucentis)</b> — monoclonal antibody fragment against VEGF-A<br><b>2. Bevacizumab (Avastin)</b> — full monoclonal antibody (off-label, cost-effective)<br><b>3. Aflibercept (Eylea)</b> — VEGF-trap (binds VEGF-A, VEGF-B, PlGF)<br><b>4. Brolucizumab (Beovu)</b> — single-chain antibody fragment<br><b>5. Faricimab (Vabysmo)</b> — bispecific (anti-VEGF + anti-Ang-2)" },
{ q: "What is <b>panretinal photocoagulation (PRP)</b> and when is it used?", a: "<b>Laser burns applied to the peripheral retina</b> → destroys ischemic retina → <b>reduces VEGF production</b> → regresses/prevents neovascularization.<br><b>Indications:</b><br>• <b>Proliferative diabetic retinopathy</b><br>• <b>Ischemic CRVO</b> with neovascularization<br>• <b>Ocular ischemic syndrome</b> with NV<br>• <b>Neovascular glaucoma</b><br>Side effects: Peripheral visual field loss, decreased night vision" },
{ q: "A patient with diabetes has <b>sudden painless vision loss</b> and you cannot see the fundus. What is the most likely diagnosis and next step?", a: "<b>Most likely:</b> <b>Vitreous hemorrhage</b> from proliferative diabetic retinopathy<br><b>Next step:</b> <b>B-scan ultrasound</b> to:<br>• Rule out <b>retinal detachment</b> (tractional or combined tractional-rhegmatogenous)<br>• Assess extent of hemorrhage<br>If RD present → urgent PPV; if no RD → may observe, but most diabetic vitreous hemorrhages eventually need PPV." },
{ q: "What causes <b>flashes of light</b> (photopsia) in retinal disease?", a: "Flashes occur when the <b>retina is mechanically stimulated</b> — most commonly by <b>vitreoretinal traction</b>.<br><b>Causes:</b><br>• <b>PVD</b> (vitreous pulling on retina)<br>• <b>Retinal tear</b> (active traction)<br>• <b>Retinal detachment</b> (ongoing traction)<br>Photoreceptors cannot distinguish between light and mechanical stimulation → perceive traction as <b>flashes</b>." },
{ q: "What is the significance of <b>new-onset floaters</b> in an elderly patient?", a: "Most commonly due to <b>PVD</b> (benign), but must <b>rule out retinal tear</b> (~15% risk with acute PVD) and <b>vitreous hemorrhage</b>.<br><b>Floaters</b> in PVD are caused by vitreous opacities, condensation, or Weiss ring casting shadows on the retina.<br><b>Pigmented floaters (Shafer sign)</b> → suggests retinal tear/RD.<br><b>All patients need dilated fundoscopy within 24 hours.</b>" },
{ q: "What retinal conditions cause <b>painless</b> monocular vision loss?", a: "<b>1. CRAO</b> — sudden, severe<br><b>2. CRVO</b> — less sudden<br><b>3. Retinal detachment</b> — progressive curtain/shadow<br><b>4. Vitreous hemorrhage</b> — sudden floaters/haze<br><b>5. AION</b> — sudden, altitudinal field loss<br><b>6. Wet AMD</b> — subacute metamorphopsia<br><b>7. CSCR</b> — central scotoma, metamorphopsia<br><b>8. BRAO/BRVO</b> — sectoral field loss<br><b>Key:</b> Painful loss → think <b>acute angle-closure glaucoma, optic neuritis, endophthalmitis</b>" },
{ q: "How quickly must a <b>macula-on RRD</b> be repaired?", a: "<b>Within 24 hours</b> (ideally same day).<br>Once the macula detaches, central vision prognosis worsens significantly.<br>A <b>macula-off RD</b> is still urgent but can be repaired within <b>a few days</b> — the visual prognosis depends on duration of macular detachment." },
{ q: "What is the <b>prognosis for vision</b> after CRAO?", a: "<b>Poor</b> — most patients have final VA of <b>counting fingers or worse</b>.<br>Only ~<b>1–8%</b> achieve significant visual recovery.<br>Patients with a <b>cilioretinal artery</b> have better prognosis (central vision may be partially preserved).<br>Prognosis worse with: GCA-related CRAO, complete occlusion, delayed presentation." },
{ q: "What percentage of patients with PVD develop a <b>retinal tear</b>?", a: "Approximately <b>10–15%</b> of patients with acute symptomatic PVD develop a retinal tear.<br>Of those with retinal tears, ~<b>30–50%</b> will progress to retinal detachment if untreated.<br>This is why all patients with acute PVD symptoms need <b>dilated fundus examination</b>." },
{ q: "A patient presents with sudden vision loss. Fundus shows <b>pale retina, cherry-red spot, and box-car segmentation</b>. ESR is 95. Next step?", a: "<b>Immediately start high-dose IV methylprednisolone</b> (1 g/day) — this is <b>GCA-related CRAO</b> until proven otherwise.<br>Then: <b>Temporal artery biopsy</b> (but do NOT delay steroids).<br>Also: Urgent ophthalmology consultation for acute CRAO management.<br>Without treatment → risk of <b>fellow eye involvement</b> (CRAO or AION) within days." },
{ q: "In CRVO, what <b>fluorescein angiography finding</b> defines ischemic type?", a: "<b>>10 disc areas of capillary non-perfusion</b> on fluorescein angiography defines <b>ischemic CRVO</b>.<br>Other indicators of ischemic CRVO:<br>• VA ≤20/200<br>• APD present<br>• Dense hemorrhages<br>• Multiple cotton-wool spots<br>These patients need <b>close monitoring</b> for neovascularization." },
{ q: "What medications should be <b>avoided</b> in CSCR?", a: "<b>Corticosteroids</b> (all forms — systemic, topical, inhaled, intranasal, intra-articular)<br>Steroids <b>worsen</b> CSCR by increasing choroidal vascular permeability and RPE dysfunction.<br>Treatment: <b>Discontinue steroids</b> if possible → most cases resolve spontaneously in 1–3 months.<br>If persistent: <b>PDT (photodynamic therapy)</b> with verteporfin, or mineralocorticoid receptor antagonists (eplerenone/spironolactone)." },
{ q: "What retinal finding is <b>pathognomonic</b> for hypertensive emergency (malignant HTN)?", a: "<b>Bilateral disc edema (papilledema)</b> with:<br>• Flame-shaped hemorrhages<br>• Cotton-wool spots<br>• Hard exudates (macular star)<br>• Arteriolar narrowing / AV nicking<br>• Exudative retinal detachments (in severe cases)<br>This is <b>grade IV hypertensive retinopathy</b> (Keith-Wagener-Barker classification)." },
{ q: "What retinal finding occurs with <b>sickle cell retinopathy</b>?", a: "<b>Proliferative sickle retinopathy</b> → <b>sea fan neovascularization</b> (fan-shaped NV at junction of perfused and non-perfused peripheral retina).<br>Stages (Goldberg): I. Peripheral arteriolar occlusion → II. AV anastomoses → III. Sea fan NV → IV. Vitreous hemorrhage → V. Tractional RD.<br><b>SC disease and S-Thal</b> have worse retinopathy than SS (better perfusion → more ischemia-reperfusion injury)." },
{ q: "How does <b>retinopathy of prematurity (ROP)</b> cause retinal detachment?", a: "In ROP, <b>abnormal neovascularization</b> at the junction of vascularized and avascular peripheral retina → <b>fibrovascular proliferation</b> → contraction of fibrovascular tissue → <b>tractional retinal detachment</b>.<br><b>Risk factors:</b> Prematurity (<32 wk, <1500 g), supplemental oxygen<br><b>Screening:</b> All infants ≤30 wk GA or ≤1500 g birth weight<br><b>Treatment:</b> Laser to avascular retina, anti-VEGF, vitrectomy if RD" },
{ q: "What is the <b>Valsalva retinopathy</b>?", a: "Sudden <b>premacular (subhyaloid) hemorrhage</b> caused by a sharp increase in intravenous pressure during <b>Valsalva maneuver</b> (straining, coughing, vomiting, heavy lifting).<br>Blood trapped between retina and posterior hyaloid → <b>dome-shaped, boat-shaped</b> hemorrhage at the macula.<br><b>Treatment:</b> Usually self-limited; Nd:YAG laser membranotomy if threatening macula long-term." },
{ q: "What is an <b>Amsler grid</b> and its clinical significance?", a: "A grid of <b>evenly spaced horizontal and vertical lines</b> used to detect <b>central visual field abnormalities</b>.<br>Patient fixes on center dot and reports any:<br>• <b>Metamorphopsia</b> (wavy lines) → macular disease (AMD, ERM, CSCR)<br>• <b>Scotomas</b> (missing areas) → macular pathology<br>Used for <b>home monitoring</b> in patients with AMD (detect conversion to wet AMD)." },
{ q: "A patient with a history of <b>lattice degeneration</b> presents with a <b>horseshoe tear</b> found on exam but no RD. What is the treatment?", a: "<b>Prophylactic laser photocoagulation (barricade laser)</b> or <b>cryopexy</b> around the tear.<br>Creates a <b>chorioretinal adhesion</b> (scar) that walls off the tear and prevents subretinal fluid from entering.<br>Horseshoe tears have <b>high risk of progressing to RRD</b> due to ongoing vitreous traction.<br>Patient should return <b>immediately</b> if new symptoms (floaters, flashes, curtain) develop." },
{ q: "What is the role of <b>cryopexy</b> in retinal tear management?", a: "<b>Transcleral cryotherapy</b> applied externally to freeze and destroy tissue around the retinal break → creates a <b>chorioretinal adhesion</b> (scar) sealing the break.<br>Used as alternative to laser when:<br>• Media opacities prevent laser (e.g., vitreous hemorrhage, cataract)<br>• Break is very anterior (ora serrata)<br>• During scleral buckle surgery<br>Takes ~1–2 weeks for full adhesion to form." },
{ q: "What is <b>scleral buckle surgery</b> and how does it work?", a: "A <b>silicone band or sponge</b> is sutured to the <b>external sclera</b>, creating an inward <b>indentation (buckle)</b> that:<br>1. Brings the RPE closer to the detached retina<br>2. Relieves vitreoretinal traction<br>3. Supports the retinal break closure<br>Combined with cryopexy or laser to seal the break.<br><b>Best for:</b> Young patients, inferior RDs, single breaks, phakic patients." },
{ q: "What are the <b>complications</b> of scleral buckle surgery?", a: "<b>• Myopic shift</b> (increased axial length from indentation)<br><b>• Diplopia</b> (extraocular muscle dysfunction)<br><b>• Infection / extrusion</b> of buckle material<br><b>• Anterior segment ischemia</b><br><b>• Choroidal detachment</b><br><b>• Cystoid macular edema</b><br><b>• Proliferative vitreoretinopathy (PVR)</b>" },
{ q: "What is <b>pars plana vitrectomy</b> (PPV)?", a: "Surgical removal of the <b>vitreous gel</b> through small-gauge instruments inserted through the <b>pars plana</b> (3.5–4 mm posterior to the limbus).<br>Allows:<br>• Removal of vitreous traction<br>• Drainage of subretinal fluid<br>• Endolaser / cryopexy to seal breaks<br>• Gas or silicone oil tamponade<br><b>Indications:</b> Complex RD, GRT, vitreous hemorrhage, macular hole, ERM, tractional RD" },
{ q: "After PPV with <b>gas tamponade</b>, what must patients avoid?", a: "<b>1. Air travel</b> — gas expands at altitude → dangerous IOP elevation → can cause CRAO<br><b>2. Nitrous oxide anesthesia</b> — N₂O diffuses into gas bubble → rapid expansion → IOP spike<br><b>3. Must maintain specific head positioning</b> (face-down for macular holes)<br>Gas types:<br>• SF₆ (sulfur hexafluoride) — lasts ~2 weeks<br>• C₃F₈ (perfluoropropane) — lasts ~8 weeks" },
{ q: "What is <b>silicone oil tamponade</b> and when is it preferred over gas?", a: "<b>Silicone oil</b> injected into the vitreous cavity as a long-term tamponade agent.<br><b>Preferred over gas when:</b><br>• Patient requires <b>air travel</b><br>• <b>Inferior retinal detachments</b> (gas floats superiorly)<br>• Complex cases with <b>PVR</b><br>• Pediatric patients (unable to position)<br><b>Disadvantage:</b> Requires a <b>second surgery</b> for removal; can cause cataract, glaucoma, keratopathy." },
{ q: "What are the <b>indications for urgent/emergent dilated fundus exam</b>?", a: "<b>1. New-onset floaters and/or flashes</b> (rule out tear/RD)<br><b>2. Sudden painless vision loss</b> (CRAO, CRVO, VH, RD, AION)<br><b>3. Curtain/shadow over visual field</b> (RD)<br><b>4. Trauma with decreased vision</b><br><b>5. Shafer sign on slit lamp</b> (pigmented vitreous cells)<br><b>6. New APD</b><br>Time-critical: <b>Macula-on RD</b> (24h), <b>CRAO</b> (90 min)" },
{ q: "What <b>systemic conditions</b> can cause <b>exudative retinal detachment</b>?", a: "<b>1. Preeclampsia / eclampsia</b><br><b>2. Malignant hypertension</b><br><b>3. VKH disease</b><br><b>4. Posterior scleritis</b><br><b>5. Choroidal tumors</b> (melanoma, metastases, hemangioma)<br><b>6. Coats disease</b> (children)<br><b>7. Sympathetic ophthalmia</b><br><b>8. Leukemia</b><br><b>9. Organ transplant rejection</b> (choroidal)<br>Key: <b>No retinal break</b>, fluid shifts with gravity" },
{ q: "What is <b>sympathetic ophthalmia</b>?", a: "A <b>bilateral granulomatous panuveitis</b> that occurs after <b>penetrating trauma or surgery</b> to one eye.<br><b>Mechanism:</b> Autoimmune T-cell response against uveal melanocyte antigens exposed by the injury.<br><b>Exciting eye</b> = injured eye; <b>sympathizing eye</b> = uninjured fellow eye (develops uveitis).<br>Can cause <b>bilateral exudative RD</b>.<br><b>Treatment:</b> Systemic immunosuppression; consider enucleation of exciting eye <b>within 2 weeks</b> of injury." },
{ q: "What is the difference between <b>optic neuritis</b> and <b>AION</b>?", a: "<b>Optic neuritis:</b><br>• <b>Painful</b> vision loss (pain with eye movement)<br>• Young women (20–40)<br>• Associated with <b>MS</b><br>• Disc may be normal (retrobulbar) or edematous<br>• Good visual recovery<br><br><b>AION:</b><br>• <b>Painless</b> vision loss<br>• Older patients (>50)<br>• Altitudinal field defect<br>• Disc edema (pallid or hyperemic)<br>• Variable recovery (worse with arteritic)" },
{ q: "What is <b>papilledema</b> vs <b>papillitis</b>?", a: "<b>Papilledema:</b> Bilateral disc edema from <b>raised intracranial pressure</b>; usually <b>preserved VA</b> initially; enlarged blind spot<br><b>Papillitis:</b> Disc edema from <b>inflammation</b> (optic neuritis); usually <b>decreased VA</b> with APD; typically unilateral; painful eye movements<br>Both show disc edema but have different etiologies and presentations." },
{ q: "What is <b>Coat disease</b>?", a: "A <b>unilateral, non-hereditary</b> retinal vascular disorder of <b>young boys</b> (average age 5–10).<br>Features: <b>Telangiectatic retinal vessels</b> → lipid exudation → exudative retinal detachment.<br>Presents with <b>leukocoria</b> (white pupil) → must differentiate from <b>retinoblastoma</b>.<br>No systemic associations.<br>Treatment: Laser or cryotherapy to abnormal vessels." },
{ q: "List the <b>differential diagnosis of leukocoria</b> in a child.", a: "<b>1. Retinoblastoma</b> (#1 concern — rule out first)<br><b>2. Coats disease</b><br><b>3. Retinopathy of prematurity (ROP)</b><br><b>4. Persistent fetal vasculature (PFV)</b><br><b>5. Toxocara canis</b><br><b>6. Familial exudative vitreoretinopathy (FEVR)</b><br><b>7. Cataract (congenital)</b><br><b>8. Retinal detachment</b><br><b>9. Coloboma</b><br><b>10. Norrie disease</b>" },
{ q: "What is a <b>giant retinal tear</b> (GRT)?", a: "A retinal tear extending <b>≥90° (3 clock hours)</b> of the circumference.<br><b>Associations:</b> Marfan syndrome, Stickler syndrome, high myopia, trauma<br>The retinal flap can fold over on itself → difficult to repair.<br><b>Treatment:</b> PPV with perfluorocarbon liquid (to unfold retina) → endolaser → silicone oil or gas tamponade." },
{ q: "What visual field pattern is expected in a <b>superior RD</b>?", a: "<b>Inferior visual field defect</b> — the visual field loss is <b>opposite</b> to the location of the detachment (inverted image on retina).<br>A patient with superior RD reports a <b>curtain rising from below</b>.<br>Superior RDs are more <b>concerning</b> because they progress toward the macula faster (gravity assists subretinal fluid tracking downward along the retina)." },
{ q: "Why is a <b>superior retinal tear</b> more dangerous than an inferior one?", a: "Gravity causes <b>subretinal fluid to track downward</b> from a superior tear, rapidly progressing toward the <b>macula</b>.<br>An <b>inferior tear</b> has fluid that tends to stay inferior, and progression toward the macula is slower.<br>This is why <b>superior RDs threaten the macula faster</b> and may need more urgent repair." },
{ q: "What is <b>proliferative diabetic retinopathy</b> (PDR) and how does it relate to retinal emergencies?", a: "PDR features <b>neovascularization</b> (NVD — disc; NVE — elsewhere) from severe retinal ischemia/VEGF release.<br><b>Emergencies from PDR:</b><br>• <b>Vitreous hemorrhage</b> (from NV bleed)<br>• <b>Tractional retinal detachment</b> (fibrovascular contraction)<br>• <b>Combined tractional-rhegmatogenous RD</b><br>• <b>Neovascular glaucoma</b> (rubeosis iridis)<br><b>Treatment:</b> PRP, anti-VEGF, PPV" },
{ q: "A patient with known <b>ischemic CRVO</b> returns with a <b>red, painful eye and IOP of 55 mmHg</b>. What do you see on slit lamp?", a: "<b>Rubeosis iridis</b> — neovascularization of the iris → <b>neovascular glaucoma</b>.<br><b>Slit lamp findings:</b><br>• Fine, irregular blood vessels on the <b>iris surface and pupillary margin</b><br>• <b>Ectropion uveae</b> (pupillary margin everted by fibrovascular membrane)<br>• <b>Synechiae</b> — angle closure from fibrovascular membrane<br>• <b>Corneal edema</b> from elevated IOP<br>• Conjunctival injection, flare/cells" },
{ q: "What is the <b>Cherry Red Spot Myoclonus</b> syndrome?", a: "A cherry-red spot can also be seen in <b>lysosomal storage diseases</b> (not just CRAO):<br>• <b>Tay-Sachs disease</b> (GM2 gangliosidosis, type I) — most classic<br>• <b>Niemann-Pick disease</b> (type A)<br>• <b>Sandhoff disease</b><br>• <b>GM1 gangliosidosis</b><br>• <b>Sialidosis</b> (cherry-red spot myoclonus)<br>In these, <b>lipid accumulation in ganglion cells</b> turns the retina pale, with the foveola (no ganglion cells) appearing red." },
{ q: "How does <b>acute CRAO presentation</b> differ from <b>acute CRVO presentation</b>?", a: "<b>CRAO:</b><br>• <b>Sudden, severe</b> (seconds to minutes)<br>• VA usually CF or worse<br>• <b>Pale retina, cherry-red spot</b><br>• Attenuated arterioles, box-car segmentation<br>• APD present<br><br><b>CRVO:</b><br>• <b>Less sudden</b> (hours to days)<br>• VA variable (20/40 to CF)<br>• <b>Blood and thunder</b> — hemorrhages in all quadrants<br>• Dilated, tortuous veins, disc edema<br>• APD only in ischemic type" },
{ q: "What happens if a patient with a <b>gas bubble</b> in the eye receives <b>nitrous oxide</b> anesthesia?", a: "<b>Nitrous oxide (N₂O)</b> is <b>34× more soluble</b> than SF₆ in blood → rapidly <b>diffuses into the gas bubble</b> → <b>dramatic expansion</b> of the bubble → <b>acute IOP elevation</b> → can cause <b>CRAO and permanent vision loss</b>.<br><b>N₂O must be stopped ≥15 minutes before</b> and <b>avoided for 2 weeks (SF₆) to 8 weeks (C₃F₈)</b> after surgery.<br>Patients should carry a <b>medical alert</b> bracelet." },
{ q: "What is the <b>most common cause</b> of painless monocular vision loss in patients <b>over 50</b>?", a: "In terms of retinal emergencies:<br>• <b>Retinal vein occlusion</b> (CRVO/BRVO) — most common retinal vascular cause<br>• <b>Age-related macular degeneration</b> (wet) — most common overall cause of permanent vision loss in elderly<br>In terms of transient loss: <b>Amaurosis fugax</b> from carotid disease" },
{ q: "What is the <b>prognosis</b> of non-ischemic vs ischemic CRVO?", a: "<b>Non-ischemic CRVO:</b><br>• ~⅓ improve spontaneously<br>• ~⅓ remain stable<br>• ~⅓ convert to ischemic type<br>• Good visual outcome with anti-VEGF for macular edema<br><br><b>Ischemic CRVO:</b><br>• Poor visual prognosis<br>• ~60% develop NVG within 3 months<br>• Need close follow-up (monthly) for first 6 months<br>• May need PRP if NV develops" },
{ q: "What is the role of <b>intravitreal steroid implants</b> in CRVO?", a: "<b>Dexamethasone intravitreal implant (Ozurdex)</b>:<br>• Sustained-release biodegradable implant<br>• FDA-approved for macular edema from CRVO/BRVO<br>• Alternative to anti-VEGF, especially in <b>pseudophakic</b> patients<br>• Lasts ~3–6 months per injection<br><b>Side effects:</b> Cataract progression, IOP elevation<br>Generally <b>second-line</b> after anti-VEGF." },
{ q: "What is <b>Eales disease</b>?", a: "An <b>idiopathic perivasculitis</b> of the <b>peripheral retinal veins</b>, predominantly in <b>young adult males</b> (20–30) from the Indian subcontinent.<br><b>Stages:</b><br>1. Inflammatory (periphlebitis)<br>2. Ischemic (peripheral capillary non-perfusion)<br>3. Proliferative (neovascularization → vitreous hemorrhage)<br><b>Treatment:</b> Steroids (inflammation), laser PRP (ischemia/NV), PPV (vitreous hemorrhage)" },
{ q: "What is the <b>Irvine-Gass syndrome</b>?", a: "<b>Pseudophakic cystoid macular edema (CME)</b> — developing <b>4–12 weeks after cataract surgery</b>.<br>Most common cause of decreased vision after uncomplicated cataract surgery.<br><b>Mechanism:</b> Surgical inflammation → prostaglandin release → breakdown of blood-retinal barrier → macular edema.<br><b>Treatment:</b> Topical NSAIDs ± topical steroids; anti-VEGF or intravitreal steroids for refractory cases." },
{ q: "What is <b>macular hole</b> and how does it relate to PVD?", a: "<b>Full-thickness defect in the foveal neurosensory retina</b>.<br><b>Mechanism:</b> <b>Vitreomacular traction</b> (incomplete PVD with persistent foveal adhesion) → tangential traction → hole formation.<br><b>Symptoms:</b> Central scotoma, metamorphopsia, decreased VA<br><b>OCT:</b> Full-thickness foveal defect<br><b>Treatment:</b> PPV + ILM peeling + gas tamponade + face-down positioning" },
{ q: "What is <b>epiretinal membrane</b> (ERM / macular pucker)?", a: "A <b>thin fibrocellular membrane</b> on the surface of the <b>ILM</b> at the macula.<br><b>Cause:</b> Often idiopathic (after PVD), also from surgery, trauma, inflammation, RVO.<br><b>Symptoms:</b> Metamorphopsia (distortion), blurred central vision<br><b>OCT:</b> Hyperreflective line on retinal surface ± macular wrinkling/thickening<br><b>Treatment:</b> PPV + membrane peel (if visually significant)" },
{ q: "What <b>pupil findings</b> differentiate a <b>complete vs incomplete CRAO</b>?", a: "<b>Complete CRAO:</b><br>• <b>APD (Marcus Gunn pupil)</b> — fixed, dilated pupil with poor direct response<br>• Near-complete loss of retinal function<br><br><b>Incomplete / BRAO:</b><br>• APD may be <b>subtle or absent</b> (depends on extent)<br>• Some retinal function preserved<br><br>A <b>sluggish but reactive pupil</b> suggests <b>incomplete</b> occlusion or cilioretinal artery sparing." },
{ q: "What is <b>photodynamic therapy (PDT)</b> with verteporfin?", a: "<b>Verteporfin</b> (IV photosensitizing dye) accumulates in abnormal vasculature → activated by <b>non-thermal laser (689 nm)</b> → generates reactive oxygen species → selective <b>thrombosis of abnormal vessels</b>.<br><b>Uses:</b><br>• <b>Wet AMD</b> (subfoveal choroidal NV — largely replaced by anti-VEGF)<br>• <b>Chronic CSCR</b> (reduces choroidal hyperpermeability)<br>• Choroidal hemangioma<br>• Polypoidal choroidal vasculopathy" },
{ q: "What is <b>VEGF</b> and why is it central to retinal vascular disease?", a: "<b>Vascular endothelial growth factor</b> — a signal protein that promotes:<br>• <b>Angiogenesis</b> (new vessel formation)<br>• <b>Vascular permeability</b> (edema)<br>Released by <b>ischemic retinal cells</b> in response to hypoxia.<br><b>Drives:</b> Neovascularization (PDR, RVO, ROP), macular edema (DME, RVO), neovascular glaucoma.<br>Targeted by anti-VEGF therapy (ranibizumab, aflibercept, bevacizumab)." },
{ q: "How do you differentiate <b>retinal hemorrhages</b> by shape?", a: "<b>Flame-shaped (splinter):</b> In the <b>nerve fiber layer</b> (superficial) → spread along nerve fibers → seen in HTN, CRVO, papilledema<br><b>Dot-blot:</b> In the <b>inner nuclear / outer plexiform layer</b> (deep) → round → seen in DM, CRVO, OIS<br><b>Subhyaloid (preretinal):</b> Between retina and vitreous → boat/dome-shaped, gravity-dependent → PDR, Terson, Valsalva<br><b>Sub-RPE / subretinal:</b> Dark, well-demarcated → wet AMD, macroaneurysm" },
{ q: "What is <b>optic disc neovascularization (NVD)</b> vs <b>neovascularization elsewhere (NVE)</b>?", a: "<b>NVD:</b> New vessels at or within <b>1 disc diameter of the optic disc</b> → <b>higher risk</b> of vitreous hemorrhage; more aggressive treatment indicated<br><b>NVE:</b> New vessels <b>elsewhere on the retina</b> → lower risk but still requires treatment<br><b>High-risk characteristics (DRS):</b> NVD ≥¼ disc area, any NVD with VH, NVE ≥½ disc area with VH → <b>PRP indicated</b>" },
{ q: "What <b>medications</b> can cause retinal toxicity?", a: "<b>1. Hydroxychloroquine (Plaquenil)</b> → bull's eye maculopathy (RPE damage)<br><b>2. Tamoxifen</b> → crystalline maculopathy, macular edema<br><b>3. Thioridazine</b> → pigmentary retinopathy<br><b>4. Chloroquine</b> → bull's eye maculopathy<br><b>5. Ethambutol</b> → optic neuritis (not retinal per se)<br><b>6. Vigabatrin</b> → irreversible peripheral field constriction<br><b>7. Interferon</b> → cotton-wool spots, retinal hemorrhages<br><b>8. Topiramate</b> → angle-closure (not retinal)" },
{ q: "What is the <b>difference between endophthalmitis and retinal emergency</b> in terms of presentation?", a: "<b>Endophthalmitis:</b><br>• <b>Painful</b> vision loss<br>• Red eye, hypopyon, vitritis<br>• Usually post-surgical or post-traumatic<br>• Infection inside the eye<br><br><b>Retinal emergencies (CRAO, CRVO, RD):</b><br>• <b>Painless</b> vision loss (except OIS — dull ache)<br>• White/quiet eye externally<br>• Specific fundoscopic findings<br>Key: <b>Pain + vision loss + red eye = consider endophthalmitis</b>" },
{ q: "In the context of retinal detachment, what is a <b>demarcation line</b>?", a: "A <b>pigmented line</b> at the border of a <b>chronic, stable retinal detachment</b>, representing <b>RPE hyperplasia</b> at the junction of attached and detached retina.<br>Indicates the RD has been present for <b>weeks to months</b> and is <b>not actively progressing</b>.<br>May be observed if macula is not threatened, but most RDs still warrant repair." },
{ q: "What is a <b>dialysis</b> in the context of retinal detachment?", a: "A <b>retinal tear at the ora serrata</b> (junction of retina and pars plana), running <b>circumferentially</b>.<br><b>Causes:</b> Blunt <b>trauma</b> (especially inferotemporal), idiopathic (especially superonasal in young adults)<br><b>Significance:</b> Common cause of RRD in <b>young patients</b> after trauma.<br><b>Treatment:</b> Scleral buckle (preferred) or PPV." },
{ q: "What is the <b>ora serrata</b>?", a: "The <b>serrated anterior border</b> of the retina, where the sensory retina ends and transitions into the <b>pars plana</b> of the ciliary body.<br>Important landmark for:<br>• Retinal detachment (RD extends to ora serrata in RRD)<br>• Retinal dialysis (tear at ora serrata)<br>• Pars plana vitrectomy approach (instruments inserted posterior to ora serrata)" },
{ q: "What is <b>hemi-retinal vein occlusion</b> (HRVO)?", a: "Occlusion involving <b>either the superior or inferior trunk</b> of the central retinal vein (which bifurcates within the optic nerve).<br>Features are <b>intermediate</b> between CRVO and BRVO — hemorrhages involving <b>2 quadrants</b> (superior or inferior half).<br>Same risk factors as CRVO; managed similarly with anti-VEGF for macular edema and PRP if NV develops." },
{ q: "What <b>fundus finding</b> differentiates <b>papilledema</b> from <b>optic disc drusen</b>?", a: "<b>Papilledema:</b><br>• Blurred disc margins, hyperemic disc<br>• <b>Obscured peripapillary vessels</b><br>• Flame hemorrhages, cotton-wool spots<br>• <b>Absent spontaneous venous pulsations</b><br>• Enlarged blind spot on VF<br><br><b>Optic disc drusen:</b><br>• Lumpy, irregular disc elevation<br>• <b>No vessel obscuration</b><br>• <b>Autofluorescence</b> on FAF<br>• Normal spontaneous venous pulsations usually present<br>• B-scan: calcification" },
{ q: "How does <b>myopia</b> predispose to retinal detachment?", a: "<b>Axial elongation</b> in myopia causes:<br>1. <b>Retinal thinning</b> (stretched over larger globe)<br>2. <b>Lattice degeneration</b> more common<br>3. <b>Earlier PVD</b> (vitreous liquefaction)<br>4. <b>Weaker vitreoretinal adhesion</b> in some areas<br>5. <b>Peripheral retinal degenerations</b><br>Risk increases with degree of myopia: >6 diopters = <b>high risk</b>." },
{ q: "What is <b>Stickler syndrome</b> and its retinal significance?", a: "<b>Autosomal dominant connective tissue disorder</b> (type II collagen defect).<br><b>Features:</b> Midface hypoplasia, cleft palate, sensorineural hearing loss, joint hypermobility, high myopia.<br><b>Ocular:</b><br>• <b>Optically empty vitreous</b> (membranous or beaded vitreous)<br>• <b>High risk of retinal detachment</b> (giant retinal tears)<br>• <b>Early-onset lattice degeneration</b><br>• Cataracts (often early)<br>Prophylactic retinal laser may be considered." },
{ q: "A 25-year-old with <b>sickle cell disease</b> (HbSC) has <b>sudden floaters and decreased vision</b>. Most likely cause?", a: "<b>Vitreous hemorrhage</b> from <b>proliferative sickle cell retinopathy</b>.<br><b>HbSC disease</b> has <b>worse retinopathy</b> than HbSS because better-oxygenated blood allows more perfusion → more <b>ischemia-reperfusion injury</b> at the periphery → sea fan NV → hemorrhage.<br><b>Management:</b> B-scan US (rule out RD), observation if mild, PPV if dense/non-clearing or RD present. Avoid scleral buckle (risk of anterior segment ischemia in SCD)." },
{ q: "What is <b>Purtscher retinopathy</b>?", a: "A retinopathy characterized by <b>multiple cotton-wool spots and retinal hemorrhages</b> surrounding the disc, occurring after <b>severe trauma</b> (especially chest compression, long bone fractures, head injury).<br><b>Mechanism:</b> Complement-mediated arteriolar occlusion or fat embolism → retinal ischemia.<br><b>Purtscher-like retinopathy:</b> Similar findings in <b>acute pancreatitis, SLE, TTP, renal failure</b>.<br>Usually self-limited; no specific treatment." },
{ q: "What is an <b>operculated hole</b> in the retina?", a: "A <b>round retinal hole</b> with a free-floating <b>operculum</b> (plug of retinal tissue) in the vitreous above it.<br>The vitreous traction has <b>completely avulsed</b> the retinal fragment → <b>no residual traction</b> on the hole.<br>Therefore, <b>lower risk of RD</b> than horseshoe tears (which have ongoing traction).<br>Usually <b>observed</b>; treatment only if symptomatic or high-risk features." },
{ q: "What conditions are associated with <b>bilateral simultaneous CRAO</b>?", a: "<b>1. Giant cell arteritis (GCA)</b> — can affect bilateral posterior ciliary and retinal arteries<br><b>2. Cardiac emboli</b> (bilateral shower of emboli)<br><b>3. Hypercoagulable states</b> (antiphospholipid syndrome, DIC)<br><b>4. Vasculitis</b> (SLE, PAN)<br><b>5. Sickle cell crisis</b><br>Bilateral CRAO is rare and should prompt <b>aggressive systemic workup</b>, especially for GCA in patients >50." },
{ q: "What is the <b>RAPD</b> grading relevance in predicting CRVO outcome?", a: "The <b>severity of the RAPD (relative afferent pupillary defect)</b> in CRVO correlates with the <b>degree of retinal ischemia</b>.<br>• <b>Absent RAPD</b> → likely <b>non-ischemic</b> CRVO (better prognosis)<br>• <b>Present RAPD</b> (especially ≥0.9 log units) → likely <b>ischemic</b> CRVO (60% risk of NVG)<br>RAPD is the <b>single best clinical predictor</b> of ischemic vs non-ischemic CRVO at presentation." },
{ q: "What is <b>commotio retinae</b> (Berlin edema)?", a: "<b>Retinal whitening</b> (outer retinal disruption) following <b>blunt ocular trauma</b>.<br>Mechanism: Mechanical disruption of photoreceptor outer segments.<br><b>If involving the macula</b> → decreased VA (commotio retinae of the macula).<br><b>Peripheral commotio:</b> Often asymptomatic, resolves spontaneously.<br><b>OCT:</b> Hyperreflectivity and disruption of the photoreceptor layer.<br>No specific treatment; prognosis depends on severity of foveal involvement." },
{ q: "Summarize the <b>emergency management algorithm</b> for acute painless monocular vision loss.", a: "<b>1. Check VA, pupils (APD?), IOP</b><br><b>2. Dilated fundus exam:</b><br>→ <b>Pale retina + cherry-red spot</b> → CRAO → ocular massage, anterior chamber paracentesis, rule out GCA<br>→ <b>Blood & thunder</b> → CRVO → anti-VEGF, classify ischemic vs non-ischemic<br>→ <b>Elevated retina + break</b> → RRD → assess macula-on/off → surgery<br>→ <b>Cannot see fundus</b> → VH → B-scan US → PPV if RD<br>→ <b>Disc edema</b> → AION → check ESR/CRP → steroids if arteritic<br><b>3. Systemic workup</b> as indicated (carotid, cardiac, labs)" },
          ]
        },
        {
          section: 'Ophthalmology',
          topic: "Diabetic & hypertensive retinopathy",
          icon: "eye",
          cards: [
            // ===== DIABETIC RETINOPATHY — PATHOPHYSIOLOGY =====
{ q: "What is the stepwise pathophysiology of <b>diabetic retinopathy</b> (DR)?", a: "Chronic hyperglycemia → <b>pericyte loss</b> → basement membrane thickening → capillary occlusion → retinal <b>ischemia</b> → <b>VEGF</b> release → <b>neovascularization</b>" },
{ q: "What is the role of the <b>polyol pathway</b> in diabetic retinopathy?", a: "Excess glucose is converted to <b>sorbitol</b> by aldose reductase → sorbitol accumulation causes <b>osmotic damage</b> to pericytes and retinal capillary endothelial cells" },
{ q: "How do <b>advanced glycation end products (AGEs)</b> contribute to DR?", a: "Non-enzymatic glycosylation of proteins → AGEs cross-link collagen in basement membranes → increased <b>vascular permeability</b>, endothelial dysfunction, and pro-inflammatory signaling via <b>RAGE receptors</b>" },
{ q: "What is the role of <b>protein kinase C (PKC) activation</b> in DR?", a: "Hyperglycemia → ↑ diacylglycerol (DAG) → PKC activation → ↑ VEGF expression, altered retinal blood flow, increased vascular permeability, and <b>basement membrane thickening</b>" },
{ q: "Which retinal cell is lost <b>earliest</b> in diabetic retinopathy?", a: "<b>Pericytes</b> — they normally provide structural support and regulate capillary tone; their loss leads to <b>microaneurysm</b> formation (the earliest clinical sign)" },
{ q: "What is the key angiogenic factor driving proliferative diabetic retinopathy?", a: "<b>VEGF (vascular endothelial growth factor)</b> — released by ischemic retina, drives <b>neovascularization</b> and increases vascular permeability causing macular edema" },
// ===== DR — EPIDEMIOLOGY =====
{ q: "What is the <b>leading cause of blindness</b> in working-age adults (20–74 years)?", a: "<b>Diabetic retinopathy</b>" },
{ q: "What is the <b>single most important risk factor</b> for developing diabetic retinopathy?", a: "<b>Duration of diabetes</b> — most important predictor of DR development and severity" },
{ q: "What percentage of <b>Type 1 diabetics</b> develop DR after 20 years?", a: "Nearly <b>100%</b> will have some degree of retinopathy after 20 years" },
{ q: "What percentage of <b>Type 2 diabetics</b> develop DR after 20 years?", a: "Approximately <b>60%</b>" },
{ q: "List the major <b>risk factors</b> for diabetic retinopathy beyond diabetes duration.", a: "• Poor glycemic control (<b>↑ HbA1c</b>)<br>• <b>Hypertension</b><br>• <b>Hyperlipidemia</b><br>• <b>Pregnancy</b> (can accelerate DR)<br>• <b>Nephropathy</b> (proteinuria)<br>• <b>Smoking</b>" },
{ q: "Why does <b>pregnancy</b> worsen diabetic retinopathy?", a: "Hemodynamic changes, hormonal shifts, and rapid tightening of glycemic control can paradoxically <b>accelerate DR progression</b> — screen before conception or in 1st trimester, then <b>each trimester</b>" },
// ===== KEY LANDMARK TRIALS =====
{ q: "What did the <b>DCCT</b> (Diabetes Control and Complications Trial) demonstrate?", a: "<b>Intensive glycemic control</b> in Type 1 diabetes significantly <b>reduces the risk</b> of developing and progressing diabetic retinopathy (76% reduction in new DR, 54% reduction in progression)" },
{ q: "What did the <b>UKPDS</b> (United Kingdom Prospective Diabetes Study) show?", a: "<b>Intensive glycemic control</b> in <b>Type 2</b> diabetes reduces microvascular complications including DR; also showed <b>tight BP control</b> reduces DR progression" },
{ q: "What was the key contribution of the <b>ETDRS</b> (Early Treatment Diabetic Retinopathy Study)?", a: "• Defined <b>clinically significant macular edema (CSME)</b> criteria<br>• Showed <b>focal/grid laser</b> reduces vision loss from CSME by ~50%<br>• Confirmed <b>aspirin</b> does NOT increase risk of vitreous hemorrhage (safe to use)" },
{ q: "What did the <b>DRS</b> (Diabetic Retinopathy Study) demonstrate?", a: "<b>Panretinal photocoagulation (PRP)</b> reduces the risk of <b>severe vision loss</b> by >50% in eyes with <b>high-risk proliferative DR</b>" },
{ q: "What was the main finding of <b>DRCR.net Protocol T</b>?", a: "Compared anti-VEGF agents for center-involving DME: <b>Aflibercept</b> was superior to bevacizumab and ranibizumab for eyes with baseline VA <b>worse than 20/50</b> at 1 year; at 2 years, aflibercept and ranibizumab were equivalent" },
{ q: "Which trial proved that <b>aspirin is safe</b> in patients with diabetic retinopathy?", a: "<b>ETDRS</b> — aspirin did NOT increase the risk of vitreous hemorrhage and can be used safely for cardiovascular indications" },
// ===== NPDR — MILD =====
{ q: "What is the <b>earliest clinical sign</b> of diabetic retinopathy?", a: "<b>Microaneurysms</b> — appear as tiny <b>dot hemorrhages</b> on fundoscopy" },
{ q: "What defines <b>mild NPDR</b>?", a: "<b>Microaneurysms only</b> — no other findings" },
{ q: "How do microaneurysms appear on <b>fluorescein angiography</b> (FA)?", a: "<b>Hyperfluorescent dots</b> — they fill with dye and leak in later phases" },
{ q: "What is the pathological basis of <b>microaneurysms</b>?", a: "Focal outpouchings of weakened capillary walls due to <b>pericyte loss</b> — represent the earliest visible vascular change" },
// ===== NPDR — MODERATE =====
{ q: "What findings characterize <b>moderate NPDR</b>?", a: "Microaneurysms PLUS any of:<br>• <b>Dot-blot hemorrhages</b><br>• <b>Hard exudates</b> (lipid deposits)<br>• <b>Cotton-wool spots</b> (RNFL infarcts)<br>in 1–3 quadrants, but NOT meeting severe NPDR criteria" },
{ q: "What are <b>hard exudates</b> in diabetic retinopathy?", a: "Yellow, waxy, well-defined deposits of <b>lipid and protein</b> leaked from damaged capillaries — often arranged in a <b>circinate</b> (ring) pattern around leaking microaneurysms" },
{ q: "What are <b>cotton-wool spots</b> and what layer are they in?", a: "Fluffy white lesions representing <b>microinfarcts of the retinal nerve fiber layer (RNFL)</b> — caused by arteriolar occlusion leading to axoplasmic flow stasis" },
{ q: "Distinguish <b>dot-blot hemorrhages</b> vs. <b>flame-shaped hemorrhages</b> by retinal layer.", a: "• <b>Dot-blot</b>: deep retinal layers (inner nuclear/outer plexiform) — seen in DR<br>• <b>Flame-shaped</b>: superficial RNFL — seen in <b>hypertensive retinopathy</b>" },
// ===== NPDR — SEVERE (4-2-1 RULE) =====
{ q: "What is the <b>4-2-1 rule</b> for severe NPDR?", a: "ANY ONE of:<br>• <b>≥20 hemorrhages</b> in <b>each of 4</b> quadrants<br>• <b>Venous beading</b> in <b>≥2</b> quadrants<br>• <b>IRMA</b> in <b>≥1</b> quadrant" },
{ q: "What is <b>venous beading</b> and what does it signify?", a: "Focal dilation and constriction of retinal veins giving a <b>sausage-link</b> appearance — indicates severe retinal <b>ischemia</b> and is the strongest predictor of progression to PDR" },
{ q: "What are <b>IRMAs</b> (intraretinal microvascular abnormalities)?", a: "Dilated, tortuous <b>intraretinal</b> capillary channels that represent either remodeled capillaries or early intraretinal neovascularization — they do NOT leak on FA (unlike true NV) and do NOT cross major vessels" },
{ q: "How do you differentiate <b>IRMA</b> from true <b>neovascularization</b> on fluorescein angiography?", a: "• <b>IRMA</b>: does NOT leak profusely on FA, stays within the retina<br>• <b>Neovascularization</b>: <b>profuse leakage</b> on FA, grows on retinal surface or into vitreous" },
{ q: "What is the risk of progression from <b>severe NPDR to PDR</b> within 1 year?", a: "Approximately <b>50%</b> will progress to PDR within 1 year" },
{ q: "What mnemonic can help remember the <b>4-2-1 rule</b>?", a: "Think: <b>\"HE VENted his IRe\"</b><br>• <b>H</b>emorrhages ≥20 in all <b>4</b> quadrants<br>• <b>VEN</b>ous beading in ≥<b>2</b> quadrants<br>• <b>IR</b>MA in ≥<b>1</b> quadrant" },
// ===== PDR =====
{ q: "What defines <b>proliferative diabetic retinopathy (PDR)</b>?", a: "Presence of <b>neovascularization</b> — new blood vessels growing on the retinal surface (NVE) or optic disc (NVD), arising from retinal ischemia and VEGF release" },
{ q: "What is the difference between <b>NVD</b> and <b>NVE</b>?", a: "• <b>NVD</b>: neovascularization <b>at the disc</b> (within 1 disc diameter of optic nerve head)<br>• <b>NVE</b>: neovascularization <b>elsewhere</b> on the retina" },
{ q: "What are the <b>high-risk characteristics (HRC)</b> for severe vision loss defined by the DRS?", a: "ANY of:<br>• <b>NVD ≥ 1/4–1/3 disc area</b><br>• <b>Any NVD + vitreous/preretinal hemorrhage</b><br>• <b>NVE ≥ 1/2 disc area + vitreous/preretinal hemorrhage</b>" },
{ q: "List the major <b>complications of PDR</b>.", a: "• <b>Vitreous hemorrhage</b> (from fragile new vessels)<br>• <b>Preretinal hemorrhage</b><br>• <b>Tractional retinal detachment</b> (fibrovascular contraction)<br>• <b>Neovascular glaucoma</b> (rubeosis iridis → angle closure)" },
{ q: "What is <b>rubeosis iridis</b> and its consequence?", a: "Neovascularization of the <b>iris</b> (NVI) due to VEGF from ischemic retina → new vessels grow over the <b>trabecular meshwork</b> → <b>neovascular glaucoma</b> (NVG) with severely elevated IOP" },
{ q: "How does <b>tractional retinal detachment</b> occur in PDR?", a: "Fibrovascular proliferation on the retinal surface contracts and <b>pulls the retina</b> away from the RPE — vision-threatening when it involves or threatens the <b>macula</b>" },
{ q: "What is the clinical presentation of a <b>vitreous hemorrhage</b> in PDR?", a: "Sudden painless <b>decrease in vision</b>, floaters, and loss of red reflex; fundus may be obscured; B-scan ultrasound needed to assess retina if view is blocked" },
// ===== DME =====
{ q: "At what stage(s) of DR can <b>diabetic macular edema (DME)</b> occur?", a: "<b>Any stage</b> — from mild NPDR to PDR; it is NOT limited to advanced disease" },
{ q: "What is the <b>leading cause of vision loss</b> in diabetic patients?", a: "<b>Diabetic macular edema (DME)</b> — not PDR" },
{ q: "What are the <b>ETDRS criteria for CSME</b> (clinically significant macular edema)?", a: "ANY of:<br>1. Retinal thickening within <b>500 μm</b> of foveal center<br>2. Hard exudates within <b>500 μm</b> of fovea with <b>adjacent retinal thickening</b><br>3. Retinal thickening ≥<b>1 disc area</b> in size, any part within <b>1 disc diameter</b> of foveal center" },
{ q: "What imaging modality is used to <b>quantify DME</b>?", a: "<b>OCT (optical coherence tomography)</b> — measures central subfield thickness, identifies cystoid spaces, subretinal fluid, and vitreomacular traction" },
{ q: "What is <b>center-involving DME</b> and why does it matter?", a: "DME with thickening involving the <b>foveal center</b> on OCT — treated with <b>anti-VEGF injections</b> (first-line); non-center-involving DME may be observed or treated with <b>focal laser</b>" },
// ===== DR SCREENING =====
{ q: "When should <b>Type 1 diabetic</b> patients first be screened for DR?", a: "<b>5 years after diagnosis</b>, then <b>annually</b>" },
{ q: "When should <b>Type 2 diabetic</b> patients first be screened for DR?", a: "<b>At the time of diagnosis</b> (may have had undetected diabetes for years), then <b>annually</b>" },
{ q: "What is the screening schedule for DR in <b>pregnant diabetic patients</b>?", a: "Exam <b>before conception or in the first trimester</b>, then <b>each trimester</b>; more frequent follow-up if retinopathy is present" },
{ q: "Why is screening for Type 2 diabetes done <b>at diagnosis</b> rather than 5 years later?", a: "Type 2 diabetes often goes <b>undiagnosed for years</b>, so retinopathy may already be present at the time of clinical diagnosis" },
// ===== DR TREATMENT =====
{ q: "What are the <b>systemic targets</b> for diabetic retinopathy prevention?", a: "• <b>HbA1c < 7%</b><br>• <b>BP < 130/80 mmHg</b><br>• <b>Lipid control</b> (statins/fenofibrate)" },
{ q: "What is the <b>first-line treatment</b> for center-involving DME?", a: "<b>Intravitreal anti-VEGF injections</b>: aflibercept (Eylea), ranibizumab (Lucentis), or bevacizumab (Avastin — off-label)" },
{ q: "Name the three main <b>anti-VEGF agents</b> used for DME.", a: "1. <b>Ranibizumab</b> (Lucentis) — Fab fragment<br>2. <b>Aflibercept</b> (Eylea) — VEGF trap/decoy receptor<br>3. <b>Bevacizumab</b> (Avastin) — full antibody, <b>off-label</b> but widely used" },
{ q: "What is <b>panretinal photocoagulation (PRP)</b> and when is it used?", a: "Laser burns applied to the <b>peripheral retina</b> (sparing macula) → destroys ischemic retina → ↓ VEGF production; used for <b>PDR</b> (especially high-risk characteristics)" },
{ q: "What are the <b>side effects of PRP</b>?", a: "• <b>Peripheral visual field loss</b><br>• <b>Decreased night vision</b> (nyctalopia)<br>• <b>Worsening of macular edema</b><br>• Decreased color vision<br>• Reduced accommodation" },
{ q: "When is <b>focal/grid laser</b> used in DR?", a: "For <b>non-center-involving DME</b> (CSME not involving the foveal center) — focal laser targets leaking microaneurysms; grid laser treats diffuse capillary leakage" },
{ q: "When are <b>intravitreal steroids</b> used in DME?", a: "For <b>refractory DME</b> not responding to anti-VEGF, or in <b>pseudophakic</b> patients:<br>• <b>Triamcinolone acetonide</b><br>• <b>Dexamethasone implant</b> (Ozurdex)<br>• <b>Fluocinolone acetonide implant</b> (Iluvien)" },
{ q: "What are the <b>indications for vitrectomy</b> in DR?", a: "• <b>Non-clearing vitreous hemorrhage</b> (>1–3 months)<br>• <b>Tractional retinal detachment</b> involving or threatening the macula<br>• Combined tractional-rhegmatogenous RD<br>• Dense premacular hemorrhage" },
{ q: "Is <b>anti-VEGF or PRP</b> now preferred as initial treatment for PDR?", a: "<b>Anti-VEGF</b> (e.g., ranibizumab) is increasingly used as primary treatment for PDR (DRCR.net Protocol S showed non-inferiority to PRP with fewer side effects); however, <b>PRP remains standard</b> especially when follow-up compliance is uncertain" },
// ===== FLUORESCEIN ANGIOGRAPHY =====
{ q: "What are the key <b>fluorescein angiography findings</b> in diabetic retinopathy?", a: "• <b>Microaneurysms</b>: hyperfluorescent dots<br>• <b>Capillary nonperfusion</b>: dark/hypofluorescent areas (ischemia)<br>• <b>Neovascularization</b>: profuse leakage<br>• <b>DME</b>: petaloid/flower-petal pattern of cystoid macular edema (CME)" },
{ q: "What pattern does <b>cystoid macular edema</b> (CME) show on late-phase FA?", a: "A <b>petaloid (flower-petal) pattern</b> of hyperfluorescence centered on the fovea — dye accumulates in cystoid spaces in the outer plexiform layer (Henle's layer)" },
{ q: "What does <b>capillary nonperfusion</b> on FA indicate?", a: "<b>Retinal ischemia</b> — areas of absent capillary filling appear as dark, hypofluorescent zones; extensive nonperfusion indicates high risk for neovascularization" },
// ===== HYPERTENSIVE RETINOPATHY — PATHOPHYSIOLOGY =====
{ q: "What is the stepwise pathophysiology of <b>hypertensive retinopathy</b>?", a: "Chronic HTN → <b>arteriolar vasoconstriction</b> (autoregulatory) → <b>intimal thickening</b> → <b>hyaline arteriosclerosis</b> → increased vascular permeability → <b>breakdown of blood-retinal barrier</b>" },
{ q: "What is <b>hyaline arteriosclerosis</b> in hypertensive retinopathy?", a: "Deposition of plasma proteins and lipids in the arteriolar wall → vessel wall <b>thickening and hardening</b> → leads to the clinical appearance of <b>copper and silver wiring</b>" },
// ===== KEITH-WAGENER-BARKER CLASSIFICATION =====
{ q: "What is the <b>Keith-Wagener-Barker (KWB) classification</b> for hypertensive retinopathy?", a: "• <b>Grade I</b>: Mild arteriolar narrowing (copper wiring)<br>• <b>Grade II</b>: AV nicking + more pronounced narrowing<br>• <b>Grade III</b>: Hemorrhages + CWS + hard exudates + edema<br>• <b>Grade IV</b>: All of Grade III + <b>papilledema</b>" },
{ q: "What characterizes <b>Grade I</b> hypertensive retinopathy?", a: "<b>Mild generalized arteriolar narrowing</b> — arterioles show increased light reflex (<b>copper wiring</b>); no hemorrhages or exudates" },
{ q: "What characterizes <b>Grade II</b> hypertensive retinopathy?", a: "<b>AV nicking</b> (arteriovenous crossing changes) with <b>more pronounced arteriolar narrowing</b> — includes Gunn sign, Salus sign, Bonnet sign" },
{ q: "What characterizes <b>Grade III</b> hypertensive retinopathy?", a: "• <b>Flame-shaped hemorrhages</b><br>• <b>Cotton-wool spots</b><br>• <b>Hard exudates</b> (often in <b>macular star</b> pattern)<br>• <b>Retinal edema</b><br>Indicates <b>severe/accelerated</b> hypertension" },
{ q: "What characterizes <b>Grade IV</b> hypertensive retinopathy?", a: "<b>ALL Grade III findings PLUS papilledema</b> (optic disc swelling) — indicates <b>malignant/accelerated hypertensive emergency</b>" },
{ q: "Which KWB grades constitute a <b>hypertensive emergency</b>?", a: "<b>Grade III and IV</b> — associated with end-organ damage (encephalopathy, renal failure, cardiac failure); Grade IV with papilledema = malignant HTN" },
// ===== ARTERIOLAR CHANGES =====
{ q: "What is <b>copper wiring</b> of retinal arterioles?", a: "<b>Moderate</b> thickening of the arteriolar wall → increased light reflex gives a <b>reddish-orange</b> (copper) appearance — seen in chronic HTN (Grade I-II)" },
{ q: "What is <b>silver wiring</b> of retinal arterioles?", a: "<b>Severe</b> wall thickening with <b>complete opacification</b> of the vessel wall → arteriole appears as a <b>white/silver line</b> with no visible blood column — indicates advanced arteriosclerosis" },
{ q: "What is the normal <b>arteriovenous (AV) ratio</b> and what is abnormal?", a: "Normal: <b>2:3</b> (arteriole:venule diameter)<br>Abnormal: <b>< 2:3</b> (e.g., 1:2 or 1:3) — indicates generalized arteriolar narrowing from chronic HTN" },
{ q: "What is the progression of arteriolar wall changes in chronic HTN?", a: "Normal → <b>increased light reflex</b> → <b>copper wiring</b> (moderate) → <b>silver wiring</b> (severe/complete wall opacification)" },
// ===== AV CROSSING CHANGES =====
{ q: "Why do <b>AV crossing changes</b> occur in hypertensive retinopathy?", a: "Retinal arteries and veins share a common <b>adventitial sheath</b> at crossing points; thickened, arteriosclerotic arteries <b>compress the underlying vein</b>" },
{ q: "What is <b>Gunn sign</b>?", a: "<b>Tapering (nipping)</b> of the vein on <b>either side</b> of an arteriovenous crossing — the vein appears pinched where the artery crosses over it" },
{ q: "What is <b>Salus sign</b>?", a: "<b>Deflection (displacement)</b> of the vein at an AV crossing — the vein is pushed to form a <b>Z- or S-shaped curve</b> as it passes under the artery" },
{ q: "What is <b>Bonnet sign</b>?", a: "<b>Banking (dilation)</b> of the vein <b>distal</b> to the AV crossing — venous blood pools upstream due to compression by the overlying artery" },
{ q: "AV crossing changes predispose to which retinal vascular occlusion?", a: "<b>Branch retinal vein occlusion (BRVO)</b> — the artery compresses the vein at the crossing, leading to turbulent flow, endothelial damage, and <b>thrombus formation</b>" },
// ===== HYPERTENSIVE EMERGENCIES =====
{ q: "What retinal findings indicate a <b>hypertensive emergency</b>?", a: "• <b>Flame-shaped hemorrhages</b> (RNFL)<br>• <b>Cotton-wool spots</b> (arteriolar occlusion)<br>• <b>Hard exudates</b> (macular star)<br>• <b>Papilledema</b> (Grade IV)<br>• Retinal edema" },
{ q: "What is a <b>macular star</b> in hypertensive retinopathy?", a: "<b>Hard exudates</b> (lipid deposits) arranged in a <b>star/stellate pattern</b> radiating from the fovea — deposited along Henle's fiber layer; seen in <b>Grade III–IV</b> HTN retinopathy" },
{ q: "What systemic complications are associated with <b>Grade III-IV</b> hypertensive retinopathy?", a: "• <b>Hypertensive encephalopathy</b><br>• <b>Renal failure</b><br>• <b>Cardiac failure/MI</b><br>• <b>Stroke</b><br>These findings indicate <b>end-organ damage</b>" },
{ q: "What is the <b>target BP reduction</b> in a hypertensive emergency?", a: "Reduce MAP by <b>~25% in the first hour</b> — avoid rapid drops that may cause ischemic stroke or worsen end-organ perfusion" },
// ===== HYPERTENSIVE CHOROIDOPATHY =====
{ q: "What are <b>Elschnig spots</b>?", a: "<b>Focal choroidal infarcts</b> — initially appear as <b>yellow spots</b> (acute), then become <b>hyperpigmented</b> with a pale halo (chronic); seen in <b>severe/acute hypertension</b>" },
{ q: "What are <b>Siegrist streaks</b>?", a: "<b>Linear hyperpigmentation</b> along <b>choroidal vessels</b> — represent chain-like areas of fibrinoid necrosis in choroidal arterioles; seen in <b>severe/acute HTN</b>" },
{ q: "What is <b>hypertensive choroidopathy</b>?", a: "Choroidal vascular damage from <b>severe or acute HTN</b> → fibrinoid necrosis of choroidal arterioles → <b>Elschnig spots</b> and <b>Siegrist streaks</b>; may also cause <b>serous retinal detachment</b>" },
// ===== PRE-ECLAMPSIA/ECLAMPSIA =====
{ q: "What ocular findings are seen in <b>pre-eclampsia/eclampsia</b>?", a: "• <b>Bilateral serous (exudative) retinal detachment</b><br>• Arteriolar <b>spasm</b> and narrowing<br>• <b>Choroidal ischemia</b><br>• <b>Cortical blindness</b> (posterior reversible encephalopathy — PRES)<br>• Cotton-wool spots and hemorrhages" },
{ q: "What is unique about retinal detachment in <b>pre-eclampsia</b>?", a: "It is <b>serous (exudative)</b>, often <b>bilateral</b>, caused by choroidal ischemia and RPE dysfunction — NOT rhegmatogenous; typically <b>resolves spontaneously after delivery</b>" },
{ q: "How is <b>cortical blindness</b> in eclampsia explained?", a: "Due to <b>posterior reversible encephalopathy syndrome (PRES)</b> — vasogenic edema in the <b>occipital lobes</b> from severe HTN; usually <b>reversible</b> with BP control and delivery" },
{ q: "What is the definitive treatment for <b>pre-eclamptic retinopathy</b>?", a: "<b>Delivery of the baby</b> — retinal findings typically resolve postpartum" },
// ===== RETINOPATHY OF PREMATURITY (ROP) =====
{ q: "What is <b>retinopathy of prematurity (ROP)</b>?", a: "A vasoproliferative retinal disorder of <b>premature infants</b> — retinal vessel growth is arrested by premature birth, leading to <b>ischemia → VEGF release → pathological neovascularization</b>" },
{ q: "What are the main <b>risk factors for ROP</b>?", a: "• <b>Prematurity</b> (<32 weeks gestational age)<br>• <b>Low birth weight</b> (<1500 g)<br>• <b>Supplemental oxygen</b> therapy<br>• Other: sepsis, blood transfusions, IVH" },
{ q: "How does <b>supplemental oxygen</b> contribute to ROP?", a: "High O₂ → <b>vasoconstriction/obliteration</b> of immature retinal vessels (Phase 1: vaso-obliterative) → when O₂ is withdrawn, relative hypoxia → massive <b>VEGF release → neovascularization</b> (Phase 2: vasoproliferative)" },
{ q: "Describe the <b>zone classification</b> of ROP.", a: "• <b>Zone I</b>: Circle centered on disc, radius = 2× disc-to-macula distance (most posterior, worst prognosis)<br>• <b>Zone II</b>: From Zone I edge to nasal ora serrata<br>• <b>Zone III</b>: Remaining temporal crescent" },
{ q: "Describe the <b>stages of ROP</b> (1–5).", a: "• <b>Stage 1</b>: Demarcation line (flat, white line)<br>• <b>Stage 2</b>: Ridge (elevated demarcation line)<br>• <b>Stage 3</b>: Ridge + <b>extraretinal fibrovascular proliferation</b><br>• <b>Stage 4</b>: Partial retinal detachment (4A: extrafoveal, 4B: foveal)<br>• <b>Stage 5</b>: <b>Total retinal detachment</b> (funnel)" },
{ q: "What is <b>plus disease</b> in ROP?", a: "<b>Venous dilation and arteriolar tortuosity</b> of the posterior pole vessels — indicates <b>active, aggressive disease</b> requiring treatment; may also include iris vascular engorgement, vitreous haze, pupillary rigidity" },
{ q: "When should <b>ROP screening</b> be performed?", a: "First exam at <b>31 weeks postmenstrual age (PMA)</b> or <b>4 weeks chronological age</b>, whichever is <b>later</b>" },
{ q: "What is the treatment for <b>threshold ROP</b>?", a: "• <b>Laser photocoagulation</b> to avascular retina (standard)<br>• <b>Intravitreal anti-VEGF</b> (bevacizumab) — especially for Zone I disease<br>• Severe cases (Stage 4-5): <b>vitrectomy/scleral buckle</b>" },
{ q: "What is <b>aggressive posterior ROP (AP-ROP)</b>?", a: "A severe, rapidly progressive form of ROP in <b>Zone I or posterior Zone II</b> — characterized by <b>plus disease</b> disproportionate to the stage, with flat neovascularization; requires <b>urgent treatment</b>" },
// ===== OTHER VASCULAR RETINOPATHIES =====
{ q: "What is the characteristic retinal finding in <b>sickle cell retinopathy</b>?", a: "<b>Sea fan neovascularization</b> — peripheral neovascularization resembling a sea fan (Gorgonia); most common in <b>SC disease</b> and <b>S-Thal</b> (more common than SS)" },
{ q: "Which sickle cell genotypes have the <b>highest risk</b> of proliferative retinopathy?", a: "<b>SC disease (HbSC)</b> and <b>S-beta thalassemia</b> — paradoxically MORE retinopathy than SS disease (SS has lower hematocrit → less sludging in retinal vessels)" },
{ q: "What are the findings in <b>radiation retinopathy</b>?", a: "Resembles <b>diabetic retinopathy</b> — microaneurysms, hemorrhages, cotton-wool spots, macular edema, capillary nonperfusion; occurs <b>months to years</b> after radiation to the eye/orbit" },
{ q: "What is <b>Purtscher retinopathy</b>?", a: "Retinopathy associated with <b>severe head/chest trauma</b> or <b>acute pancreatitis</b> (Purtscher-like) — features bilateral <b>cotton-wool spots</b>, <b>retinal hemorrhages</b>, and <b>Purtscher flecken</b> (white retinal patches between disc and macula)" },
{ q: "What are <b>Purtscher flecken</b>?", a: "Distinctive <b>white/yellow polygonal patches</b> of retinal whitening between the optic disc and macula — represent areas of <b>retinal infarction</b> from complement-mediated leukoembolization or fat embolism" },
{ q: "What is <b>Valsalva retinopathy</b>?", a: "Sudden <b>preretinal (subhyaloid) hemorrhage</b> from a ruptured perifoveal capillary following sudden increase in intrathoracic/intra-abdominal pressure (straining, coughing, vomiting); typically <b>dome-shaped</b> hemorrhage in the premacular area" },
{ q: "What retinal findings can occur in <b>severe anemia</b>?", a: "• <b>Flame-shaped hemorrhages</b> (often with white centers — Roth spots)<br>• Cotton-wool spots<br>• Dilated veins<br>• Optic disc edema<br>More common when Hb < 8 g/dL and with concurrent thrombocytopenia" },
{ q: "What are <b>Roth spots</b> and what conditions cause them?", a: "Retinal hemorrhages with a <b>white/pale center</b> (fibrin-platelet plug); classically associated with <b>bacterial endocarditis</b>, but also seen in leukemia, severe anemia, DIC, collagen vascular diseases" },
// ===== HIGH-YIELD DIFFERENTIALS & COMPARISONS =====
{ q: "Compare the <b>hemorrhage types</b> in diabetic vs. hypertensive retinopathy.", a: "• <b>Diabetic</b>: <b>Dot-blot hemorrhages</b> (deep retinal layers — INL/OPL)<br>• <b>Hypertensive</b>: <b>Flame-shaped hemorrhages</b> (superficial RNFL)<br>Both can have cotton-wool spots" },
{ q: "What <b>hard exudate pattern</b> is characteristic of hypertensive vs. diabetic retinopathy?", a: "• <b>Hypertensive</b>: <b>Macular star</b> (stellate pattern radiating from fovea along Henle's fiber layer)<br>• <b>Diabetic</b>: <b>Circinate ring</b> pattern around leaking microaneurysms" },
{ q: "A patient with diabetes AND hypertension has retinopathy — how do you determine which is contributing?", a: "Look for <b>disease-specific</b> findings:<br>• <b>Microaneurysms, IRMA, NV</b> → diabetic<br>• <b>AV nicking, copper/silver wiring, macular star</b> → hypertensive<br>Both often coexist and worsen each other" },
{ q: "What is the key difference between <b>IRMA and neovascularization</b> in determining NPDR vs. PDR?", a: "<b>IRMA</b> = intraretinal (NPDR) — does NOT cross major vessels, minimal FA leakage<br><b>Neovascularization</b> = on retinal surface/into vitreous (PDR) — profuse leakage on FA, crosses major vessels" },
// ===== MANAGEMENT PEARLS =====
{ q: "What is the <b>early worsening phenomenon</b> in diabetic retinopathy?", a: "Rapid tightening of glycemic control (e.g., starting insulin) can <b>paradoxically worsen DR</b> in the short term — due to autoregulatory changes; does NOT mean glycemic control should be avoided (long-term benefit proven by DCCT)" },
{ q: "Should a patient with <b>PDR</b> undergoing cataract surgery receive pre-operative anti-VEGF?", a: "<b>Yes</b> — consider pre-operative <b>anti-VEGF injection</b> and/or PRP before cataract surgery to reduce the risk of <b>post-operative NV progression</b> and macular edema" },
{ q: "What is the role of <b>fenofibrate</b> in diabetic retinopathy?", a: "FIELD and ACCORD-Eye trials showed <b>fenofibrate</b> reduces DR progression independent of lipid levels — possibly via <b>anti-inflammatory and anti-apoptotic effects</b> on retinal capillaries" },
{ q: "Why is <b>bevacizumab</b> widely used despite being off-label for DME?", a: "It is <b>significantly cheaper</b> than ranibizumab and aflibercept with similar efficacy for most eyes with DME (VA ≥20/50); approved for cancer, repurposed for ocular use by compounding" },
{ q: "When should PRP be performed <b>urgently</b>?", a: "• <b>High-risk PDR</b> (DRS criteria)<br>• <b>Neovascular glaucoma</b> (rubeosis iridis with ↑ IOP)<br>• <b>Poor follow-up compliance</b> expected<br>• <b>Fellow eye</b> already lost to PDR complications" },
// ===== ADDITIONAL CLINICAL SCENARIOS =====
{ q: "A 55-year-old diabetic presents with sudden painless vision loss in one eye. Fundus exam shows a <b>boat-shaped preretinal hemorrhage</b>. Diagnosis?", a: "<b>Vitreous/preretinal hemorrhage</b> from proliferative diabetic retinopathy — the boat-shaped (keel-shaped) hemorrhage is subhyaloid, between the retina and posterior hyaloid face; needs <b>B-scan US</b> if view is obscured" },
{ q: "A diabetic patient has 4-2-1 findings but NO neovascularization. What is the stage and next step?", a: "<b>Severe NPDR</b> — close follow-up (every 2–4 months); consider <b>early PRP</b> in high-risk patients (Type 2 DM, poor follow-up compliance, rapid progression, fellow eye with PDR)" },
{ q: "A patient with long-standing HTN has <b>AV nicking</b> and <b>copper wiring</b> but no hemorrhages. What KWB grade?", a: "<b>Grade II</b> — AV nicking with pronounced arteriolar narrowing; represents chronic hypertensive damage without acute decompensation" },
{ q: "A 30-year-old with sudden severe headache, BP 240/140, and fundus showing <b>disc edema, flame hemorrhages, and CWS</b>. Diagnosis and treatment?", a: "<b>Malignant hypertension (Grade IV hypertensive retinopathy)</b><br>Treatment: <b>IV antihypertensives</b> (labetalol, nicardipine, nitroprusside) — reduce MAP by <b>~25% in the first hour</b>; avoid precipitous drops" },
{ q: "What is the significance of <b>neovascularization of the disc (NVD)</b> vs. <b>elsewhere (NVE)</b> in terms of prognosis?", a: "<b>NVD</b> carries a <b>worse prognosis</b> than NVE — associated with higher risk of vitreous hemorrhage and severe vision loss; NVD ≥ 1/4–1/3 disc area alone qualifies as high-risk PDR" },
{ q: "A diabetic patient has <b>macular edema</b> seen on OCT but the foveal center is NOT involved. Treatment?", a: "<b>Non-center-involving DME</b> — options include <b>observation</b> (if mild and VA good) or <b>focal/grid laser</b>; anti-VEGF is reserved for center-involving DME" },
// ===== FA & IMAGING DETAILS =====
{ q: "What phases of FA are most useful for evaluating DR?", a: "• <b>Arterial/AV phase</b>: identifies capillary nonperfusion<br>• <b>Mid phase</b>: microaneurysm filling, IRMA<br>• <b>Late phase</b>: leakage from NV, petaloid CME pattern, disc leakage" },
{ q: "How does <b>OCT angiography (OCTA)</b> differ from traditional FA in DR evaluation?", a: "<b>OCTA</b> is <b>non-invasive</b> (no dye), provides depth-resolved images of retinal vasculature, can visualize <b>foveal avascular zone</b> enlargement, capillary dropout, and microaneurysms; however, limited field of view and cannot show <b>leakage</b>" },
{ q: "What is the <b>foveal avascular zone (FAZ)</b> and its significance in DR?", a: "A capillary-free zone centered on the fovea (~0.5 mm); in DR, the FAZ becomes <b>enlarged and irregular</b> due to perifoveal capillary dropout → correlates with <b>macular ischemia</b> and poor visual prognosis" },
// ===== PHARMACOLOGY DETAILS =====
{ q: "What is the <b>mechanism of action</b> of ranibizumab (Lucentis)?", a: "A humanized monoclonal antibody <b>Fab fragment</b> that binds and inhibits <b>all isoforms of VEGF-A</b> → reduces neovascularization and vascular permeability" },
{ q: "What is the <b>mechanism of action</b> of aflibercept (Eylea)?", a: "A <b>recombinant fusion protein (VEGF trap)</b> — acts as a decoy receptor binding <b>VEGF-A, VEGF-B, and PlGF</b> with higher affinity than native VEGF receptors" },
{ q: "What are the risks of <b>intravitreal injections</b>?", a: "• <b>Endophthalmitis</b> (most feared — ~0.05%)<br>• Retinal detachment<br>• Vitreous hemorrhage<br>• Elevated IOP (transient)<br>• Lens damage/traumatic cataract<br>• Floaters<br>• Systemic thromboembolic events (rare)" },
{ q: "What are the ocular side effects of <b>intravitreal steroids</b>?", a: "• <b>Cataract formation</b> (posterior subcapsular)<br>• <b>Elevated IOP/steroid-induced glaucoma</b><br>These limit their first-line use in phakic patients" },
// ===== CLASSIFICATION & STAGING DETAILS =====
{ q: "How is the <b>International Clinical Disease Severity Scale</b> for DR organized?", a: "1. <b>No apparent DR</b><br>2. <b>Mild NPDR</b> — microaneurysms only<br>3. <b>Moderate NPDR</b> — more than mild but less than severe<br>4. <b>Severe NPDR</b> — 4-2-1 rule<br>5. <b>PDR</b> — neovascularization or vitreous/preretinal hemorrhage" },
{ q: "What is <b>very severe NPDR</b>?", a: "Meets <b>TWO or more</b> of the 4-2-1 criteria — carries even higher (~75%) risk of progression to PDR within 1 year compared to 50% for severe NPDR" },
// ===== INTEGRATIVE / HIGH-YIELD REVIEW =====
{ q: "In which retinal layer are <b>hard exudates</b> deposited?", a: "<b>Outer plexiform layer (OPL)</b> — lipoproteins leak from damaged capillaries and deposit between photoreceptor and bipolar cell synapses; in the macula, they follow <b>Henle's fiber layer</b> (oblique OPL)" },
{ q: "Why does DR screening differ between <b>Type 1 and Type 2</b> diabetes?", a: "• <b>Type 1</b>: onset known, retinopathy rare before puberty, screen at <b>5 years</b><br>• <b>Type 2</b>: onset often unknown (years of undiagnosed hyperglycemia), screen <b>at diagnosis</b>" },
{ q: "What is <b>neovascular glaucoma (NVG)</b> and how is it treated?", a: "NVG: ischemic retina → VEGF → iris/angle neovascularization → fibrovascular membrane occludes trabecular meshwork → <b>severe IOP elevation</b><br>Treatment: <b>anti-VEGF + PRP</b> to treat the underlying cause, <b>topical IOP-lowering agents</b>, possible <b>glaucoma drainage device</b>" },
{ q: "What role does <b>OCT</b> play in managing diabetic retinopathy?", a: "• Quantify <b>central macular thickness</b> in DME<br>• Identify <b>cystoid spaces, subretinal fluid</b><br>• Detect <b>vitreomacular traction</b><br>• Monitor <b>treatment response</b> to anti-VEGF/laser<br>• Detect subclinical edema before visual loss" },
{ q: "What is the significance of <b>lipid deposits (hard exudates)</b> near the fovea?", a: "Hard exudates within <b>500 μm of the foveal center</b> with adjacent retinal thickening meet <b>CSME criteria</b> (ETDRS) — require treatment even if visual acuity is preserved" },
{ q: "How does <b>pregnancy</b> affect pre-existing diabetic retinopathy screening and management?", a: "• DR can <b>progress rapidly</b> during pregnancy<br>• Screen <b>before conception or 1st trimester</b>, then <b>each trimester</b><br>• Laser treatment safe during pregnancy if needed<br>• DR may <b>regress postpartum</b> in some cases<br>• <b>Gestational diabetes</b> does NOT require DR screening" },
{ q: "A premature infant born at 28 weeks is found to have Stage 3 ROP with <b>plus disease</b> in Zone I. Next step?", a: "<b>Urgent treatment</b> — either <b>intravitreal anti-VEGF</b> (preferred for Zone I disease) or <b>laser photocoagulation</b> to avascular retina; Zone I disease with plus disease is classified as Type 1 ROP requiring treatment within <b>72 hours</b>" },
{ q: "What is the difference between <b>Type 1 and Type 2 ROP</b> in terms of management?", a: "• <b>Type 1 ROP</b>: Treat within 72 hours (Zone I any stage with plus, Zone I Stage 3, Zone II Stage 2-3 with plus)<br>• <b>Type 2 ROP</b>: Observe with serial exams (Zone I Stage 1-2 without plus, Zone II Stage 3 without plus)" },
{ q: "What is the mechanism of <b>PRP</b> in reducing neovascularization?", a: "Laser <b>destroys ischemic peripheral retina</b> → reduces the total retinal oxygen demand → ↓ <b>VEGF production</b> → regression of neovascularization; the remaining retina receives more oxygen from choroidal circulation" },
{ q: "Why can PRP <b>worsen macular edema</b>?", a: "PRP causes <b>inflammation</b> and disruption of the blood-retinal barrier → increased vascular permeability → macular edema; this is why <b>anti-VEGF or focal laser for DME</b> should be addressed before or concurrently with PRP" },
{ q: "What is the <b>typical dosing schedule</b> for anti-VEGF in center-involving DME?", a: "Initial <b>monthly injections for 3-6 months</b> (loading phase), then <b>treat-and-extend</b> or <b>PRN (as needed)</b> based on OCT and visual acuity response" },
{ q: "Compare <b>serous vs. tractional vs. rhegmatogenous</b> retinal detachment in the context of retinopathy.", a: "• <b>Serous</b> (exudative): fluid leaks under retina — pre-eclampsia, choroidopathy (no break/traction)<br>• <b>Tractional</b>: fibrovascular pulling — PDR<br>• <b>Rhegmatogenous</b>: retinal tear — not directly from DR/HTN (but can occur combined with tractional)" },
{ q: "What is the clinical significance of <b>capillary nonperfusion</b> exceeding 10 disc areas on FA?", a: "Extensive capillary nonperfusion (&gt;10 disc areas) = <b>ischemic retina</b> → very high risk of <b>neovascularization</b> and progression to PDR; may warrant <b>prophylactic PRP</b> or very close monitoring" },
{ q: "A hypertensive patient presents with <b>sudden unilateral vision loss</b> and a swollen disc with flame hemorrhages and dilated tortuous veins. Diagnosis?", a: "<b>Central retinal vein occlusion (CRVO)</b> — <b>\"blood and thunder\"</b> fundus; chronic HTN is a major risk factor; ischemic type may develop NVG" },
          ]
        },
        {
          section: 'Ophthalmology',
          topic: "Cataract & lens disorders",
          icon: "eye",
          cards: [
            // ===== LENS ANATOMY =====
{ q: "What is the <b>lens capsule</b> and what is its distinction among basement membranes?", a: "The lens capsule is the <b>thickest basement membrane in the body</b>.<br>It is composed of type IV collagen and is thicker <b>anteriorly</b> than posteriorly." },
{ q: "Where is the <b>germinative zone</b> of the lens located and what is its significance?", a: "Located at the <b>equator of the anterior epithelium</b>.<br>This is where lens epithelial cells actively divide and differentiate into new lens fibers <b>throughout life</b>." },
{ q: "List the layers of the lens from <b>outermost to innermost</b>.", a: "<b>Capsule → Anterior epithelium → Cortex → Nucleus</b><br>Note: The posterior surface has <b>no epithelium</b> — only capsule directly overlying cortex." },
{ q: "What are <b>zonular fibers</b> (zonules of Zinn)?", a: "Suspensory ligaments composed of <b>fibrillin</b> that extend from the <b>ciliary body</b> to the lens equator.<br>They hold the lens in position and transmit ciliary muscle forces for accommodation." },
{ q: "How does the lens receive <b>nutrition</b> and why is this clinically relevant?", a: "The lens is <b>avascular</b> and derives nutrition from the <b>aqueous humor</b> (and to a lesser extent vitreous).<br>This avascular nature means metabolic disturbances (e.g., diabetes, galactosemia) readily cause cataracts." },
{ q: "What are the major <b>structural proteins</b> of the lens?", a: "<b>Crystallins</b> — α, β, and γ types.<br>• <b>α-crystallin</b> — acts as a molecular chaperone<br>• <b>β- and γ-crystallins</b> — structural proteins responsible for lens transparency<br>The lens is ~<b>65% water</b> and 35% protein (highest protein concentration of any tissue)." },
// ===== LENS EMBRYOLOGY =====
{ q: "Describe the <b>embryological origin</b> of the lens.", a: "<b>Surface ectoderm</b> → lens placode → lens pit → <b>lens vesicle</b> (forms by day 33 of gestation).<br>The lens vesicle detaches from the surface ectoderm and is induced by the optic vesicle." },
{ q: "How do <b>primary and secondary lens fibers</b> form?", a: "• <b>Primary lens fibers</b> — posterior epithelial cells elongate and fill the lens vesicle lumen → form the <b>embryonic nucleus</b><br>• <b>Secondary lens fibers</b> — arise from <b>equatorial epithelium</b> throughout life → form cortex and adult nucleus" },
{ q: "What are the <b>Y sutures</b> of the lens?", a: "Formed where secondary lens fibers meet.<br>• <b>Anterior Y suture</b> — upright Y<br>• <b>Posterior Y suture</b> — inverted Y (λ shape)<br>These are visible on slit lamp and are clinically significant landmarks." },
// ===== ACCOMMODATION =====
{ q: "What is the <b>near response triad</b>?", a: "<b>1. Accommodation</b> (lens thickens)<br><b>2. Convergence</b> (medial recti contract)<br><b>3. Miosis</b> (pupil constricts — increases depth of focus)<br>Mediated by the <b>parasympathetic (Edinger-Westphal) pathway</b>." },
{ q: "Explain <b>Helmholtz's theory</b> of accommodation.", a: "For <b>near vision</b>: ciliary muscle <b>contracts</b> → zonules <b>relax</b> → lens becomes <b>more convex</b> (rounder) → <b>increased refractive power</b>.<br>For <b>distance vision</b>: ciliary muscle relaxes → zonules taut → lens flattened → decreased refractive power." },
{ q: "What is <b>presbyopia</b>?", a: "<b>Age-related loss of accommodation</b>, typically beginning around age <b>40</b>.<br>Caused by <b>hardening (sclerosis) of the lens nucleus</b> and loss of lens elasticity.<br>Treatment: reading glasses, bifocals, or multifocal IOLs." },
// ===== CATARACT DEFINITION & EPIDEMIOLOGY =====
{ q: "Define <b>cataract</b>.", a: "<b>Any opacity of the crystalline lens</b>, regardless of whether it affects vision.<br>It is the <b>leading cause of reversible blindness worldwide</b> and the most common cause of treatable vision loss in the elderly." },
{ q: "What is the most common <b>type of cataract</b> worldwide?", a: "<b>Age-related (senile) cataract</b> — accounts for ~90% of all cataracts.<br>Subtypes: nuclear sclerotic, cortical, and posterior subcapsular (PSC)." },
// ===== AGE-RELATED (SENILE) CATARACTS =====
{ q: "Describe the features of a <b>nuclear sclerotic cataract</b>.", a: "• <b>Gradual yellowing and browning</b> of the lens nucleus<br>• Causes a <b>myopic shift</b> (increased refractive index of nucleus)<br>• Best visualized on <b>slit-lamp</b> (direct focal illumination)<br>• Progresses slowly; affects <b>distance vision</b> more than near" },
{ q: "What is the <b>'second sight of the elderly'</b>?", a: "A phenomenon in <b>nuclear sclerotic cataract</b> where the myopic shift allows an elderly patient to <b>temporarily read without glasses</b>.<br>This is a transient improvement in near vision due to the increased refractive index of the sclerotic nucleus — it eventually worsens as the cataract progresses." },
{ q: "Describe <b>cortical cataracts</b> and their associations.", a: "• <b>Spoke-like (cuneiform/wedge-shaped)</b> opacities radiating from the periphery toward the center<br>• Affect <b>peripheral vision first</b> and cause <b>glare</b><br>• Strongly associated with <b>diabetes mellitus</b><br>• Best seen with <b>retroillumination</b> on slit lamp" },
{ q: "Describe <b>posterior subcapsular cataracts (PSC)</b>.", a: "• <b>Granular, plaque-like opacity</b> on the posterior lens capsule<br>• <b>Near vision</b> affected first (reading difficulty, glare in bright light)<br>• Found in <b>younger patients</b> compared to other senile cataracts<br>• Associations: <b>steroids, diabetes, radiation, myotonic dystrophy</b>" },
{ q: "Why does a <b>PSC cataract</b> cause disproportionate visual symptoms despite its small size?", a: "Because it sits at the <b>posterior nodal point of the lens</b>, directly in the path of the axial light rays.<br>When the pupil constricts (reading/bright light), light is focused through the opacity, causing <b>significant glare and near vision difficulty</b>." },
{ q: "What is the association of <b>anterior subcapsular cataracts</b>?", a: "Associated with:<br>• <b>Atopic dermatitis</b> (shield-like plaque, often bilateral)<br>• <b>Trauma</b><br>• <b>Wilson disease</b> (sunflower cataract — technically involves anterior subcapsular region)" },
// ===== CONGENITAL/INFANTILE CATARACTS =====
{ q: "What is the <b>most common infectious cause</b> of congenital cataract?", a: "<b>Rubella</b> (congenital rubella syndrome).<br>Produces a <b>nuclear, bilateral</b> cataract.<br>Other TORCH infections can also cause congenital cataracts but rubella is the #1 cause." },
{ q: "What type of cataract is seen in <b>galactosemia</b>?", a: "<b>Oil droplet (central) cataract</b>.<br>Due to accumulation of <b>galactitol</b> (via aldose reductase) in the lens, causing osmotic swelling.<br><b>Reversible early</b> if galactose is eliminated from the diet." },
{ q: "What is the <b>critical window</b> for treating congenital cataracts and why?", a: "Must treat within <b>6–8 weeks</b> of life to prevent <b>deprivation amblyopia</b>.<br>The visual system is highly plastic during the critical period; a dense cataract deprives the visual cortex of patterned input, leading to permanent vision loss if untreated." },
{ q: "List the major <b>differential diagnoses of leukocoria</b> in an infant.", a: "<b>1. Retinoblastoma</b> (most important to rule out)<br><b>2. Congenital cataract</b><br>3. Retinopathy of prematurity (ROP)<br>4. Coats disease<br>5. PHPV / PFV (persistent fetal vasculature)<br>6. Toxocariasis" },
{ q: "Name <b>systemic syndromes</b> associated with congenital cataracts.", a: "• <b>Down syndrome</b> (trisomy 21)<br>• <b>Lowe syndrome</b> (oculocerebrorenal — X-linked)<br>• <b>Marfan syndrome</b><br>• <b>Homocystinuria</b><br>• <b>Galactosemia</b><br>• <b>Familial / autosomal dominant</b> (most common non-syndromic hereditary form)" },
{ q: "What is <b>Lowe syndrome</b> (oculocerebrorenal syndrome)?", a: "An <b>X-linked recessive</b> disorder featuring:<br>• <b>Congenital cataracts</b> (bilateral, dense)<br>• <b>Renal tubular dysfunction</b> (Fanconi syndrome)<br>• <b>Intellectual disability</b><br>• Caused by mutations in the <b>OCRL1 gene</b>" },
// ===== METABOLIC CATARACTS =====
{ q: "Explain the <b>sorbitol pathway</b> in diabetic cataracts.", a: "Hyperglycemia → <b>aldose reductase</b> converts glucose to <b>sorbitol</b> → sorbitol cannot cross cell membranes → <b>osmotic swelling</b> of lens fibers → cataract formation.<br>This mechanism primarily causes <b>cortical and snowflake cataracts</b>." },
{ q: "What is a <b>'true diabetic cataract'</b> and who gets it?", a: "A <b>bilateral snowflake cataract</b> occurring in <b>young type 1 diabetics</b> with poorly controlled blood sugar.<br>Appears as diffuse, white, subcapsular fleck-like opacities throughout the lens.<br>Can develop and mature <b>rapidly</b> (days to weeks)." },
{ q: "What type of cataract is caused by <b>hypoparathyroidism / hypocalcemia</b>?", a: "<b>Posterior subcapsular (PSC) cataract</b>, often bilateral.<br>Low calcium levels disrupt lens metabolism.<br>May also see <b>punctate cortical opacities</b> (iridescent crystals)." },
{ q: "What is a <b>sunflower cataract</b> and what condition is it associated with?", a: "A <b>green-brown, petal-shaped</b> anterior/posterior subcapsular opacity resembling a sunflower.<br>Associated with <b>Wilson disease</b> (hepatolenticular degeneration — copper deposition in lens).<br>Also seen with <b>chalcosis</b> (intraocular copper foreign body)." },
{ q: "What cataract is associated with <b>myotonic dystrophy</b>?", a: "<b>Christmas tree cataract</b> (polychromatic / iridescent multicolored crystalline opacities in the lens cortex).<br>Also associated with <b>PSC cataracts</b>.<br>Myotonic dystrophy is the most common adult-onset muscular dystrophy (AD, CTG trinucleotide repeat)." },
{ q: "What cataract is associated with <b>atopic dermatitis</b>?", a: "<b>Anterior subcapsular cataract</b> — often called a <b>shield cataract</b> due to its dense, plaque-like morphology.<br>Usually bilateral; occurs in <b>young patients</b> with longstanding atopy." },
// ===== TRAUMATIC CATARACTS =====
{ q: "What is a <b>Vossius ring</b>?", a: "A ring of <b>iris pigment imprinted on the anterior lens capsule</b> after <b>blunt ocular trauma</b>.<br>Results from the pupillary margin of the iris being slammed against the lens by the force of impact." },
{ q: "What is a <b>rosette cataract</b>?", a: "A <b>flower-shaped (petal-like)</b> cataract occurring after <b>blunt trauma</b>.<br>Can involve the <b>anterior or posterior cortex</b> (or both).<br>The anterior rosette may resolve; the posterior rosette tends to be <b>permanent</b>." },
{ q: "How does an <b>intraocular iron foreign body</b> affect the lens?", a: "<b>Siderosis bulbi</b> — iron deposits cause <b>brown discoloration</b> of the lens and other intraocular structures.<br>Also causes <b>heterochromia</b> (darker iris), retinal degeneration, and secondary glaucoma." },
{ q: "How does an <b>intraocular copper foreign body</b> affect the lens?", a: "<b>Chalcosis</b> — causes a <b>sunflower cataract</b> (similar to Wilson disease).<br>Copper deposits in Descemet membrane cause a <b>Kayser-Fleischer–like ring</b>.<br>Pure copper (>85%) causes <b>severe endophthalmitis-like reaction</b>." },
{ q: "What is <b>glassblower's cataract</b>?", a: "Caused by chronic <b>infrared (IR) radiation</b> exposure.<br>Produces <b>true exfoliation of the anterior lens capsule</b> (lamellar peeling of the capsule).<br>Distinct from <b>pseudoexfoliation syndrome</b> (which involves the basement membrane)." },
{ q: "What cataract is caused by <b>electric shock</b>?", a: "<b>Anterior subcapsular vacuoles</b> that may progress to a full cataract.<br>Typically occurs after <b>high-voltage electrical injury</b>.<br>Can appear weeks to years after the injury." },
// ===== DRUG-INDUCED CATARACTS =====
{ q: "What type of cataract do <b>corticosteroids</b> cause?", a: "<b>Posterior subcapsular (PSC) cataract</b>.<br>Risk is <b>dose- and duration-dependent</b>.<br>Systemic steroids carry more risk than topical, but topical ophthalmic steroids can also cause PSC.<br>Partially reversible if steroid is stopped early." },
{ q: "What type of cataract does <b>chlorpromazine</b> cause?", a: "<b>Anterior subcapsular cataract</b> — fine, <b>brown granular deposits</b> on the anterior lens surface.<br>Also causes brownish discoloration of the conjunctiva and cornea.<br>Usually dose-related and occurs with chronic use." },
{ q: "What type of cataract does <b>amiodarone</b> cause?", a: "<b>Anterior subcapsular deposits</b> (fine, stellate opacities).<br>Amiodarone more commonly causes <b>corneal verticillata</b> (whorl-like corneal deposits) — seen in nearly 100% of patients on chronic therapy." },
{ q: "What ocular side effect of <b>pilocarpine</b> (miotic) involves the lens?", a: "Chronic pilocarpine use can cause <b>posterior subcapsular cataract</b>.<br>Additionally, strong miotics can cause <b>accommodative spasm</b> and induced myopia." },
{ q: "Name <b>other drugs</b> associated with cataract formation.", a: "• <b>Busulfan</b> — PSC cataract<br>• <b>Gold</b> (chrysiasis) — anterior subcapsular deposits<br>• <b>Tamoxifen</b> — refractile anterior subcapsular/cortical opacities<br>• <b>Allopurinol</b> — reported association with PSC" },
// ===== CATARACT SURGERY INDICATIONS =====
{ q: "What are the <b>indications for cataract surgery</b>?", a: "1. <b>Visual impairment</b> affecting daily activities (driving, reading)<br>2. Best-corrected VA not meeting patient needs<br>3. <b>Lens-induced pathology</b> — phacomorphic/phacolytic glaucoma, phacoantigenic uveitis<br>4. <b>Need for fundus visualization</b> (e.g., diabetic retinopathy management/laser)" },
{ q: "What is <b>phacoantigenic (phacoanaphylactic) uveitis</b>?", a: "A <b>granulomatous inflammatory reaction</b> to lens proteins exposed after capsular rupture (trauma or surgery).<br>It is an <b>immune-mediated</b> response with formation of <b>zonal granulomas</b> around lens material.<br>Treatment: <b>steroids + cataract extraction</b>." },
// ===== SURGICAL TECHNIQUES =====
{ q: "What is <b>phacoemulsification</b>?", a: "The <b>most common modern cataract surgery technique</b>.<br>• <b>Small incision</b> (2–3 mm, self-sealing)<br>• Ultrasonic probe <b>fragments and aspirates</b> the nucleus<br>• <b>Foldable IOL</b> inserted through small incision<br>• <b>Sutureless</b>, faster recovery<br>• Continuous curvilinear capsulorhexis (CCC) performed first" },
{ q: "What is <b>extracapsular cataract extraction (ECCE)</b>?", a: "• <b>Larger incision</b> (~10–12 mm)<br>• Nucleus expressed <b>whole</b> through the incision<br>• Cortex removed by irrigation/aspiration<br>• <b>Posterior capsule left intact</b> → IOL placed in bag<br>• Requires <b>sutures</b>; higher induced astigmatism" },
{ q: "What is <b>intracapsular cataract extraction (ICCE)</b>?", a: "• <b>Entire lens + capsule removed</b> en bloc (using <b>cryoprobe</b>)<br>• <b>Rarely performed</b> today (historical significance)<br>• <b>No capsular support</b> → ACIOL or scleral-fixated IOL needed<br>• Risk of <b>vitreous prolapse</b> into anterior chamber" },
{ q: "What is <b>manual small-incision cataract surgery (MSICS)</b>?", a: "A technique combining a <b>scleral tunnel incision</b> (~6–7 mm) with manual nucleus expression.<br>Does <b>not require phaco machine</b> → widely used in <b>developing countries</b>.<br>Self-sealing incision, comparable outcomes to phaco for dense cataracts." },
// ===== INTRAOCULAR LENSES =====
{ q: "Where is the <b>standard IOL placement</b> in modern cataract surgery?", a: "<b>Posterior chamber IOL in the capsular bag</b> — placed within the intact posterior capsule after phacoemulsification.<br>If no capsular support: <b>sulcus-fixated PCIOL, ACIOL, or scleral-fixated IOL</b>." },
{ q: "What is the <b>SRK formula</b> for IOL power calculation?", a: "$\\\\text{P} = A - 2.5L - 0.9K$<br>Where:<br>• <b>P</b> = IOL power (diopters)<br>• <b>A</b> = A-constant (lens-specific)<br>• <b>L</b> = axial length (mm)<br>• <b>K</b> = average keratometry (diopters)" },
{ q: "What are the main <b>types of IOLs</b> available?", a: "• <b>Monofocal</b> — single focal point (most common; patient may need reading glasses)<br>• <b>Multifocal</b> — multiple focal zones for near and distance (may cause halos/glare)<br>• <b>Toric</b> — corrects pre-existing <b>astigmatism</b><br>• <b>Accommodating</b> — designed to shift position with ciliary muscle contraction" },
{ q: "What determines <b>IOL power</b> in a patient with a long axial length (high myopia)?", a: "Longer axial length requires <b>lower IOL power</b> (may even be negative).<br>Per the SRK formula: $\\\\text{P} = A - 2.5L - 0.9K$, increasing L reduces P.<br>Special formulas (SRK/T, Holladay, Haigis) are more accurate for extreme axial lengths." },
// ===== COMPLICATIONS OF CATARACT SURGERY =====
{ q: "What is the <b>most common late complication</b> of cataract surgery?", a: "<b>Posterior capsule opacification (PCO)</b> — also called <b>secondary cataract</b> or <b>after-cataract</b>.<br>Caused by proliferation of residual <b>lens epithelial cells</b> on the posterior capsule.<br>Treated with <b>Nd:YAG laser posterior capsulotomy</b>." },
{ q: "What are <b>Elschnig pearls</b>?", a: "<b>Clusters of proliferating lens epithelial cells</b> on the posterior capsule after cataract surgery.<br>They represent the <b>regenerative type</b> of posterior capsule opacification (PCO).<br>Appear as translucent, pearl-like vesicles." },
{ q: "What is a <b>Soemmering ring</b>?", a: "A ring of <b>residual lens cortex (equatorial remnants)</b> that remains between the anterior and posterior capsule after cataract surgery.<br>It is the source of cells that cause <b>PCO</b>." },
{ q: "How is <b>PCO treated</b>?", a: "<b>Nd:YAG laser posterior capsulotomy</b>.<br>• Outpatient, painless procedure<br>• Creates an opening in the opacified posterior capsule<br>• Immediate improvement in vision<br>• Complications: IOL pitting, retinal detachment, CME, IOP spike" },
{ q: "What is the <b>most dreaded complication</b> of cataract surgery?", a: "<b>Postoperative endophthalmitis</b>.<br>• Most common organism: <b><i>Staphylococcus epidermidis</i></b> (coagulase-negative staph)<br>• Presents <b>2–7 days</b> post-op with <b>pain, hypopyon, decreased vision</b><br>• Requires emergency treatment" },
{ q: "What is the <b>treatment for post-cataract endophthalmitis</b>?", a: "Based on the <b>Endophthalmitis Vitrectomy Study (EVS)</b>:<br>1. <b>Vitreous tap and culture</b><br>2. <b>Intravitreal antibiotics</b>: <b>vancomycin</b> + <b>ceftazidime</b><br>3. Pars plana vitrectomy (PPV) if VA is <b>light perception or worse</b><br>4. Intravitreal dexamethasone often added" },
{ q: "Summarize the <b>EVS (Endophthalmitis Vitrectomy Study)</b> findings.", a: "• For VA of <b>hand motion or better</b>: vitreous tap/biopsy + intravitreal antibiotics = same outcome as immediate vitrectomy<br>• For VA of <b>light perception only</b>: <b>immediate vitrectomy</b> had significantly better outcomes<br>• <b>IV antibiotics</b> showed no benefit<br>• <b>Intravitreal vancomycin + ceftazidime</b> is the standard" },
{ q: "What is <b>Irvine-Gass syndrome</b>?", a: "<b>Cystoid macular edema (CME)</b> after cataract surgery.<br>• <b>Peak incidence 6–10 weeks</b> post-op<br>• Caused by inflammatory mediators (prostaglandins) → breakdown of blood-retinal barrier<br>• Treatment: <b>topical NSAIDs</b> (ketorolac/nepafenac) ± topical steroids<br>• Diagnosis: <b>OCT</b> (cystic spaces in macula) and <b>FA</b> (petaloid leakage pattern)" },
{ q: "What is the <b>Seidel test</b> and when is it used after cataract surgery?", a: "Tests for <b>wound leak</b> — fluorescein is applied to the conjunctiva.<br>A <b>positive Seidel test</b> shows a stream of aqueous humor diluting the fluorescein at the wound site (dark stream in a green pool).<br>Indicates <b>wound dehiscence or perforation</b>." },
{ q: "What is a <b>suprachoroidal hemorrhage</b> during cataract surgery?", a: "Also called <b>expulsive hemorrhage</b> — bleeding into the suprachoroidal space during or after surgery.<br>Risk factors: <b>high myopia, glaucoma, hypertension, atherosclerosis</b>.<br>Devastating complication — can cause extrusion of intraocular contents.<br>Management: close the wound immediately." },
{ q: "What is a <b>dropped nucleus</b> during cataract surgery?", a: "Posterior dislocation of <b>lens nuclear fragments into the vitreous</b> through a <b>posterior capsule tear</b>.<br>Requires <b>pars plana vitrectomy (PPV)</b> by a retina specialist to retrieve the fragments.<br>Can cause chronic inflammation, glaucoma, and retinal detachment if untreated." },
{ q: "What are <b>risk factors for posterior capsule rupture</b> during phacoemulsification?", a: "• <b>Dense/mature cataract</b><br>• <b>Pseudoexfoliation syndrome</b> (weak zonules)<br>• <b>Small pupil</b> (poor dilation)<br>• <b>Posterior polar cataract</b> (inherent capsule weakness)<br>• Surgeon inexperience" },
// ===== ECTOPIA LENTIS (SUBLUXATION/DISLOCATION) =====
{ q: "What is the <b>most common overall cause</b> of lens subluxation/dislocation?", a: "<b>Trauma</b> — the #1 cause of ectopia lentis overall.<br>Blunt trauma disrupts the <b>zonular fibers</b> causing lens displacement." },
{ q: "In which direction does the lens subluxate in <b>Marfan syndrome</b>?", a: "<b>Upward and temporal (superotemporal)</b>.<br>Marfan syndrome is the <b>most common systemic cause</b> of ectopia lentis.<br>Due to <b>FBN1 (fibrillin-1) gene mutation</b> → defective zonules." },
{ q: "In which direction does the lens subluxate in <b>homocystinuria</b>?", a: "<b>Downward and nasal (inferonasal)</b>.<br>Due to <b>cystathionine β-synthase (CBS) deficiency</b>.<br>Important: patients have <b>increased thrombotic risk</b> with general anesthesia — must take precautions." },
{ q: "Compare lens subluxation in <b>Marfan syndrome vs. homocystinuria</b>.", a: "<table><tr><th>Feature</th><th>Marfan</th><th>Homocystinuria</th></tr><tr><td>Direction</td><td><b>Up & temporal</b></td><td><b>Down & nasal</b></td></tr><tr><td>Inheritance</td><td>AD</td><td>AR</td></tr><tr><td>Gene</td><td>FBN1</td><td>CBS</td></tr><tr><td>Habitus</td><td>Tall, arachnodactyly</td><td>Marfanoid</td></tr><tr><td>Anesthesia risk</td><td>Aortic dissection</td><td><b>Thromboembolism</b></td></tr></table>" },
{ q: "What is <b>Weill-Marchesani syndrome</b>?", a: "A connective tissue disorder featuring:<br>• <b>Microspherophakia</b> (small, spherical lens)<br>• <b>Ectopia lentis</b><br>• <b>Short stature</b>, brachydactyly (opposite of Marfan)<br>• High risk of <b>pupillary block glaucoma</b> due to small round lens<br>• Both AD and AR forms exist" },
{ q: "What are the <b>complications of ectopia lentis</b>?", a: "• <b>Monocular diplopia</b> (edge of lens bisects pupil → two focal points)<br>• <b>Lens-induced glaucoma</b> (pupillary block from dislocated lens)<br>• <b>Iridodonesis</b> (tremulous iris due to lack of lens support)<br>• <b>Phacodonesis</b> (tremulous lens)" },
{ q: "What is <b>iridodonesis</b>?", a: "<b>Tremulous iris</b> — seen when the lens is subluxated or absent (aphakia).<br>The iris, lacking its posterior support from the lens, <b>trembles with eye movement</b>.<br>An important clinical sign of ectopia lentis." },
{ q: "Name causes of <b>ectopia lentis</b> other than Marfan and homocystinuria.", a: "• <b>Ehlers-Danlos syndrome</b><br>• <b>Weill-Marchesani syndrome</b><br>• <b>Sulfite oxidase deficiency</b><br>• <b>Hyperlysinemia</b><br>• <b>Syphilis</b> (congenital)<br>• <b>Trauma</b> (most common overall)" },
// ===== PHACOMORPHIC GLAUCOMA =====
{ q: "What is <b>phacomorphic glaucoma</b>?", a: "An <b>intumescent (swollen) cataractous lens</b> pushes the iris forward → <b>pupillary block</b> → acute <b>angle-closure glaucoma</b>.<br>The anterior chamber becomes shallow.<br>Treatment: <b>reduce IOP medically</b> → then <b>cataract extraction</b>." },
{ q: "How does phacomorphic glaucoma differ from <b>phacolytic glaucoma</b>?", a: "<table><tr><th>Feature</th><th>Phacomorphic</th><th>Phacolytic</th></tr><tr><td>Mechanism</td><td>Swollen lens → pupillary block</td><td>Lens protein leaks through intact capsule</td></tr><tr><td>Angle</td><td><b>Closed</b></td><td><b>Open</b></td></tr><tr><td>Cataract stage</td><td>Intumescent</td><td>Mature / hypermature</td></tr><tr><td>Inflammation</td><td>Minimal</td><td>Macrophage-mediated</td></tr><tr><td>Treatment</td><td>IOP control + cataract extraction</td><td>IOP control + cataract extraction</td></tr></table>" },
// ===== PHACOLYTIC GLAUCOMA =====
{ q: "What is <b>phacolytic glaucoma</b>?", a: "A <b>mature or hypermature cataract</b> → high-molecular-weight <b>lens proteins leak</b> through an <b>intact capsule</b> → engulfed by <b>macrophages</b> → macrophages clog the <b>trabecular meshwork</b> → <b>open-angle glaucoma</b>.<br>AC shows heavy <b>flare</b> with macrophage-laden aqueous." },
{ q: "What is seen in the anterior chamber in <b>phacolytic glaucoma</b>?", a: "• <b>Heavy flare</b> (protein-rich aqueous)<br>• <b>Swollen macrophages</b> filled with lens material<br>• <b>No hypopyon</b> (unlike endophthalmitis)<br>• <b>Iridescent / refractile particles</b> (cholesterol crystals in hypermature cataracts — morgagnian cataract)" },
// ===== ADDITIONAL HIGH-YIELD CARDS =====
{ q: "What is a <b>morgagnian cataract</b>?", a: "A <b>hypermature cataract</b> in which the lens cortex has completely <b>liquefied</b>, allowing the dense nucleus to <b>sink inferiorly</b> within the capsular bag.<br>Can cause <b>phacolytic glaucoma</b> as liquefied protein leaks through the capsule." },
{ q: "What is the difference between <b>mature and immature cataracts</b>?", a: "• <b>Immature</b>: lens partially opacified, iris shadow <b>present</b>, some red reflex visible<br>• <b>Mature</b>: lens completely opacified, <b>no iris shadow</b>, no red reflex<br>• <b>Hypermature</b>: cortex liquefied (morgagnian), capsule may wrinkle" },
{ q: "What is the <b>iris shadow test</b>?", a: "A clinical test using oblique illumination of the lens.<br>• <b>Positive iris shadow</b> — seen in <b>immature cataract</b> (clear cortex between iris and opacity casts a shadow)<br>• <b>No iris shadow</b> — seen in <b>mature cataract</b> (entire lens opaque, no gap between iris and opacity)" },
{ q: "What is <b>pseudoexfoliation syndrome</b> and how does it relate to cataract surgery?", a: "Deposition of <b>gray-white, dandruff-like fibrillar material</b> on the anterior lens capsule, zonules, ciliary body, iris, and TM.<br>Associated with <b>weak zonules</b> → increases risk of <b>lens subluxation and capsular rupture</b> during cataract surgery.<br>Also causes <b>pseudoexfoliation glaucoma</b>." },
{ q: "How does <b>pseudoexfoliation</b> differ from <b>true exfoliation</b>?", a: "• <b>True exfoliation</b>: lamellar peeling of the anterior lens capsule due to <b>infrared radiation</b> (glassblower's cataract)<br>• <b>Pseudoexfoliation</b>: deposition of abnormal <b>fibrillar basement membrane material</b> — age-related, associated with glaucoma and weak zonules" },
{ q: "What is the <b>red reflex test</b> and its importance in cataract evaluation?", a: "Performed with a <b>direct ophthalmoscope at arm's length</b>.<br>A <b>normal red reflex</b> is uniform, bright orange-red.<br>A <b>dark spot or absent reflex</b> indicates lens opacity (cataract) or other media opacity.<br>Essential for <b>neonatal screening</b> (leukocoria)." },
{ q: "What is the <b>Brückner test</b>?", a: "A <b>simultaneous bilateral red reflex test</b> comparing both eyes at once.<br>An <b>abnormal (brighter/whiter)</b> reflex in one eye may indicate cataract, strabismus, or anisometropia.<br>Important newborn screening tool." },
{ q: "What preoperative workup is done before <b>cataract surgery</b>?", a: "1. <b>Biometry</b> — axial length measurement (A-scan ultrasound or IOLMaster)<br>2. <b>Keratometry</b> — corneal curvature for IOL calculation<br>3. <b>IOL power calculation</b> (SRK, SRK/T, Holladay, Haigis formulas)<br>4. Assessment of <b>macular function</b> (potential acuity meter, OCT)<br>5. Evaluation for <b>coexisting ocular disease</b>" },
{ q: "What is the role of <b>intracameral antibiotics</b> in cataract surgery?", a: "<b>Intracameral cefuroxime</b> (or moxifloxacin) at the end of surgery has been shown to significantly <b>reduce endophthalmitis rates</b>.<br>Supported by the <b>ESCRS study</b>.<br>Increasingly adopted as standard prophylaxis." },
{ q: "What anesthesia is typically used for <b>phacoemulsification</b>?", a: "• <b>Topical anesthesia</b> (proparacaine/tetracaine drops) — most common for routine phaco<br>• <b>Peribulbar or retrobulbar block</b> — for complex cases or anxious patients<br>• <b>General anesthesia</b> — pediatric cataracts, uncooperative patients" },
{ q: "What is a <b>continuous curvilinear capsulorhexis (CCC)</b>?", a: "A smooth, circular tear in the <b>anterior lens capsule</b> created at the start of phacoemulsification.<br>Provides a strong, elastic opening that <b>resists radial tearing</b>.<br>Critical for <b>safe IOL implantation</b> and long-term IOL centration within the bag." },
{ q: "What is <b>hydrodissection</b> in cataract surgery?", a: "Injection of <b>BSS (balanced salt solution)</b> between the lens capsule and cortex to <b>separate the cortex from the capsule</b>.<br>Facilitates free rotation and manipulation of the nucleus during phacoemulsification." },
{ q: "What are the <b>steps of phacoemulsification</b> in order?", a: "1. <b>Incision</b> (clear corneal or scleral tunnel, 2–3 mm)<br>2. <b>Viscoelastic injection</b><br>3. <b>Capsulorhexis (CCC)</b><br>4. <b>Hydrodissection</b><br>5. <b>Phaco fragmentation & aspiration</b> of nucleus<br>6. <b>Irrigation/aspiration (I/A)</b> of cortex<br>7. <b>IOL implantation</b> in capsular bag<br>8. <b>Viscoelastic removal</b>, wound hydration" },
{ q: "What is the significance of <b>posterior polar cataract</b> during surgery?", a: "A <b>posterior polar cataract</b> has an inherent <b>weakness or defect in the posterior capsule</b> at the site of the opacity.<br>High risk of <b>posterior capsule rupture</b> during hydrodissection or nuclear manipulation.<br>Requires modified surgical technique (e.g., avoid hydrodissection, gentle viscodissection instead)." },
{ q: "What is <b>IFIS (Intraoperative Floppy Iris Syndrome)</b>?", a: "A triad of:<br>1. <b>Fluttering/billowing iris</b><br>2. <b>Iris prolapse</b> toward incisions<br>3. <b>Progressive intraoperative miosis</b><br>Associated with <b>tamsulosin</b> (alpha-1 blocker for BPH).<br>Management: iris hooks, Malyugin ring, intracameral phenylephrine." },
{ q: "What systemic medication increases risk of complications during <b>cataract surgery</b> via IFIS?", a: "<b>Tamsulosin</b> (Flomax) — an α1A-adrenergic antagonist used for BPH.<br>Causes <b>irreversible smooth muscle atrophy</b> of the iris dilator muscle.<br>Risk persists <b>even after stopping</b> the medication.<br>Other α-blockers (prazosin, doxazosin) carry lesser risk." },
{ q: "A patient complains of <b>halos and glare at night</b> after cataract surgery with a multifocal IOL. What is the cause?", a: "<b>Dysphotopsia</b> — an optical phenomenon related to the <b>multifocal IOL design</b>.<br>Multiple focal zones create superimposed images → <b>halos, glare, and reduced contrast sensitivity</b>.<br>Usually improves with neural adaptation over weeks to months." },
{ q: "Differentiate <b>positive and negative dysphotopsia</b> after IOL implantation.", a: "• <b>Positive dysphotopsia</b>: unwanted light — <b>glare, halos, streaks</b> (light reflecting off IOL edge)<br>• <b>Negative dysphotopsia</b>: <b>temporal crescent-shaped dark shadow</b> in peripheral vision (light gap between iris and IOL edge)<br>Both are more common with <b>square-edge IOL designs</b>." },
{ q: "What is <b>corneal decompensation</b> after cataract surgery?", a: "<b>Pseudophakic bullous keratopathy (PBK)</b> — irreversible <b>corneal endothelial cell loss</b> from surgical trauma → <b>stromal edema</b> with epithelial bullae → pain, decreased vision.<br>More common with <b>ACIOLs</b>.<br>Treatment: <b>corneal transplant (DSAEK or DMEK)</b>." },
{ q: "A 3-month-old presents with <b>bilateral leukocoria</b>. What is the <b>most important diagnosis to rule out</b>?", a: "<b>Retinoblastoma</b> — a potentially <b>life-threatening</b> malignant ocular tumor.<br>All cases of leukocoria require <b>urgent ophthalmologic evaluation</b> including dilated fundus exam and <b>B-scan ultrasound</b>.<br>Retinoblastoma shows <b>calcification</b> on imaging (CT/ultrasound)." },
{ q: "What is a <b>rubella cataract</b> and why is the aspirated lens material handled with caution?", a: "Rubella causes a <b>bilateral nuclear (pearly white) cataract</b> in congenital rubella syndrome.<br>The lens may <b>harbor live rubella virus</b> for up to <b>3 years</b>.<br>Aspirated lens material is <b>potentially infectious</b> and must be handled with appropriate precautions." },
{ q: "Why is <b>general anesthesia risky</b> in patients with homocystinuria undergoing cataract surgery?", a: "Patients with homocystinuria have <b>elevated homocysteine</b> → <b>endothelial damage</b> → hypercoagulable state.<br>General anesthesia increases the risk of <b>thromboembolism</b> (DVT, PE, stroke).<br>Prophylaxis: <b>hydration, aspirin, avoid immobilization</b>." },
{ q: "What enzyme is deficient in <b>galactosemia</b> causing the 'oil droplet' cataract?", a: "<b>Galactose-1-phosphate uridylyltransferase (GALT)</b> — classic galactosemia.<br>Accumulation of galactose → <b>aldose reductase</b> converts it to <b>galactitol</b> → osmotic lens swelling.<br>Also: <b>galactokinase deficiency</b> causes cataracts without systemic disease." },
{ q: "What is the difference between <b>galactosemia</b> and <b>galactokinase deficiency</b> regarding cataracts?", a: "• <b>Classic galactosemia (GALT deficiency)</b>: cataracts + hepatomegaly + intellectual disability + E. coli sepsis<br>• <b>Galactokinase deficiency</b>: cataracts <b>only</b> (no systemic disease)<br>Both produce cataracts via <b>galactitol accumulation</b> (aldose reductase pathway)." },
{ q: "What is the <b>aldose reductase pathway</b> and its role in cataracts?", a: "In hyperglycemia or galactosemia:<br>Excess sugar → <b>aldose reductase</b> converts glucose to <b>sorbitol</b> (or galactose to <b>galactitol</b>)<br>→ these sugar alcohols <b>cannot cross cell membranes</b><br>→ <b>osmotic influx of water</b> into lens fibers<br>→ lens fiber swelling and cataract formation" },
{ q: "What is the classic cataract morphology seen in <b>Down syndrome</b>?", a: "<b>Brushfield spots</b> are iris findings (not cataracts).<br>Down syndrome cataracts are often <b>punctate (dot-like)</b> opacities, sometimes <b>blue dot (cerulean)</b> cataracts.<br>May also develop <b>early-onset senile cataracts</b>." },
{ q: "What <b>visual rehabilitation</b> is needed after congenital cataract surgery?", a: "• <b>Optical correction</b> — contact lens (preferred in infants), spectacles, or IOL (if age-appropriate)<br>• <b>Amblyopia treatment</b> — patching/penalization of the better eye<br>• <b>Close follow-up</b> for glaucoma, strabismus, and PCO (very common in children)" },
{ q: "Why is <b>PCO more common in children</b> than adults after cataract surgery?", a: "Children have a <b>more robust proliferative response</b> of residual lens epithelial cells.<br>PCO rates approach <b>100% in children</b> without prophylactic posterior capsulotomy.<br>Therefore, <b>primary posterior capsulotomy + anterior vitrectomy</b> is performed at time of surgery in young children." },
{ q: "What is the most common cause of <b>secondary glaucoma</b> after congenital cataract surgery?", a: "<b>Aphakic/pseudophakic glaucoma</b> — develops in up to <b>15–25%</b> of children after congenital cataract surgery.<br>Mechanism is unclear; may involve angle abnormalities from early surgery.<br>Requires lifelong monitoring of IOP." },
{ q: "What is the <b>significance of the lens</b> in acute angle-closure glaucoma?", a: "In a predisposed eye (short axial length, thick lens), the <b>lens pushes against the iris</b> → <b>pupillary block</b> → aqueous trapped behind iris → iris bows forward → <b>angle closure</b>.<br>Treatment: <b>laser peripheral iridotomy (LPI)</b> and eventually <b>cataract extraction</b> (definitive)." },
{ q: "What is a <b>phakic IOL</b>?", a: "An IOL implanted <b>without removing the natural lens</b> — used for <b>refractive correction</b> in high myopia/hyperopia.<br>Types: anterior chamber (iris-fixated) or posterior chamber (ICL — Implantable Collamer Lens).<br>Not the same as a cataract surgery IOL (pseudophakic)." },
{ q: "What does <b>LOCS III</b> stand for and what is it used for?", a: "<b>Lens Opacities Classification System III</b>.<br>A standardized grading system for cataracts comparing the patient's lens to <b>reference photographs</b>.<br>Grades nuclear opalescence, nuclear color, cortical changes, and PSC on a numeric scale." },
{ q: "What is the effect of <b>radiation</b> on the lens?", a: "Both <b>ionizing radiation</b> (X-rays, gamma rays) and <b>UV-B radiation</b> increase cataract risk.<br>Ionizing radiation causes <b>PSC cataracts</b> (dose-dependent, ≥2 Gy threshold).<br>UV-B exposure is a risk factor for <b>cortical cataracts</b>.<br><b>Infrared</b> causes true exfoliation (glassblower's cataract)." },
{ q: "Which <b>systemic medications</b> should be reviewed before cataract surgery?", a: "• <b>Tamsulosin / α-blockers</b> — IFIS risk<br>• <b>Anticoagulants/antiplatelets</b> — usually continued for topical/peribulbar cases<br>• <b>Corticosteroids</b> — IOP spike risk post-op<br>• <b>Immunosuppressants</b> — infection risk<br>Notify the surgeon of all medications." },
{ q: "What is <b>negative staining</b> of the anterior capsule and when is it used?", a: "Application of <b>trypan blue dye</b> to stain the anterior capsule in cases with <b>absent or poor red reflex</b> (e.g., white mature cataracts).<br>Allows <b>visualization of the capsule</b> during capsulorhexis when the red reflex cannot guide the surgeon." },
{ q: "What is the <b>femtosecond laser-assisted cataract surgery (FLACS)</b>?", a: "A laser performs key steps: <b>corneal incision, capsulorhexis, and lens fragmentation</b> before phacoemulsification.<br>Advantages: more precise capsulotomy, less ultrasound energy.<br>Currently <b>not proven superior</b> to standard phaco in outcomes." },
{ q: "What visual symptom is particularly prominent with <b>cortical cataracts</b> in oncoming headlights?", a: "<b>Monocular glare and light scatter</b>.<br>The spoke-like cortical opacities scatter incoming light irregularly, causing significant <b>glare disability</b> — especially bothersome with <b>oncoming headlights while driving at night</b>." },
{ q: "What is the relationship between <b>smoking</b> and cataracts?", a: "Smoking is a significant <b>modifiable risk factor</b> for cataracts, particularly <b>nuclear sclerotic</b> and <b>PSC</b> types.<br>Mechanism: <b>oxidative damage</b> to lens proteins from free radicals in cigarette smoke.<br>Risk is dose-dependent and partially <b>reversible with cessation</b>." },
{ q: "What lens changes occur with <b>aging</b> even before cataract formation?", a: "• <b>Increased lens weight and thickness</b><br>• <b>Loss of accommodation</b> (presbyopia) from nuclear sclerosis<br>• <b>Yellowing</b> of the lens (absorbs more blue light)<br>• <b>Increased protein insolubility</b> — aggregation and light scatter<br>• <b>Decreased glutathione</b> (antioxidant depletion)" },
{ q: "A patient on chronic <b>systemic steroids</b> has a cataract. What type is expected and what characteristic location?", a: "<b>Posterior subcapsular (PSC) cataract</b>.<br>Located on the <b>posterior capsule</b>, just anterior to the posterior capsule surface.<br>Mechanism: steroids may inhibit lens epithelial cell Na⁺/K⁺-ATPase → osmotic changes, or direct protein aggregation." },
{ q: "What is a <b>lamellar (zonular) cataract</b>?", a: "A common type of <b>developmental/congenital cataract</b> affecting a <b>specific zone (lamella)</b> of the lens.<br>Appears as a <b>shell-like opacity</b> between the nucleus and cortex.<br>Often <b>bilateral and symmetric</b>. Frequently <b>autosomal dominant</b>." },
{ q: "What is a <b>blue dot (cerulean) cataract</b>?", a: "A benign, usually <b>non-progressive</b> congenital cataract with <b>small blue-white punctate opacities</b> in the lens cortex.<br>Typically inherited as <b>autosomal dominant</b>.<br>Usually <b>does not affect vision</b>." },
{ q: "Describe the <b>Christmas tree cataract</b> appearance.", a: "<b>Polychromatic (multicolored), needle-like crystalline deposits</b> within the lens cortex.<br>Named for their <b>iridescent, sparkling appearance</b> resembling tinsel on a Christmas tree.<br>Classic association: <b>myotonic dystrophy</b>." },
{ q: "What is the role of <b>antioxidants</b> in cataract prevention?", a: "The <b>AREDS/AREDS2</b> studies showed <b>no significant benefit</b> of antioxidant supplements (vitamins C, E, beta-carotene) for cataract prevention.<br>However, a <b>diet rich in fruits and vegetables</b> and <b>UV protection</b> (sunglasses) may have a modest protective effect." },
{ q: "What is the <b>IOL material</b> used in modern foldable lenses?", a: "• <b>Acrylic (hydrophobic or hydrophilic)</b> — most common currently<br>• <b>Silicone</b><br>• <b>PMMA</b> (polymethyl methacrylate) — rigid, non-foldable (historical)<br>Hydrophobic acrylic has <b>lower PCO rates</b> due to firm capsular adhesion and square-edge design." },
{ q: "A 55-year-old diabetic has bilateral <b>spoke-like lens opacities</b>. What is the diagnosis?", a: "<b>Cortical cataracts</b> — strongly associated with <b>diabetes mellitus</b>.<br>The spoke-like (cuneiform) pattern radiates from the periphery.<br>Due to osmotic stress from <b>sorbitol accumulation</b> (aldose reductase pathway) in the lens cortex." },
{ q: "A 25-year-old with <b>type 1 diabetes</b> develops rapidly progressive bilateral white lens opacities. Diagnosis?", a: "<b>True diabetic (snowflake) cataract</b>.<br>Bilateral, rapidly maturing, diffuse <b>white subcapsular fleck-like</b> opacities.<br>Occurs in <b>young type 1 diabetics</b> with poorly controlled blood sugar.<br>Different from the more gradual cortical changes of older diabetics." },
{ q: "What is the management of <b>phacomorphic glaucoma</b>?", a: "1. <b>Reduce IOP urgently</b> — topical timolol, brimonidine, systemic acetazolamide, IV mannitol<br>2. <b>Topical steroids</b> (reduce inflammation)<br>3. <b>Miotics contraindicated</b> (worsen pupillary block)<br>4. <b>Definitive treatment: cataract extraction</b> (lens removal relieves the pupillary block)" },
{ q: "In a <b>mature cataract</b> leaking lens proteins, what cells are found in the TM causing glaucoma?", a: "<b>Macrophages</b> laden with phagocytosed lens material (HMW proteins).<br>This is <b>phacolytic glaucoma</b> — an open-angle mechanism.<br>Aqueous shows macrophages and protein; <b>no capsular rupture</b> (differentiates from phacoantigenic uveitis)." },
{ q: "What distinguishes <b>phacolytic</b> from <b>phacoantigenic</b> uveitis?", a: "• <b>Phacolytic</b>: lens proteins leak through <b>intact capsule</b> → macrophage response → open-angle glaucoma<br>• <b>Phacoantigenic</b>: lens proteins exposed through <b>ruptured capsule</b> (trauma/surgery) → <b>granulomatous</b> immune response → zonal granulomas<br>Both treated with cataract extraction." },
{ q: "What is the <b>brunescent cataract</b>?", a: "An advanced form of <b>nuclear sclerotic cataract</b> where the nucleus has become <b>very hard and dark brown (brunescent)</b>.<br>Requires more <b>phaco energy</b> for fragmentation → higher risk of <b>corneal endothelial damage</b>.<br>May require ECCE or MSICS if too dense." },
{ q: "What is the significance of <b>zonular weakness</b> during cataract surgery?", a: "Weak zonules → <b>lens instability</b> → difficult capsulorhexis, phaco, and IOL centration.<br>Causes: <b>pseudoexfoliation</b> (#1), trauma, Marfan, homocystinuria, advanced age.<br>Management: <b>capsular tension ring (CTR)</b> to stabilize the bag, iris hooks." },
{ q: "What is a <b>capsular tension ring (CTR)</b>?", a: "An <b>open PMMA ring</b> placed inside the capsular bag to <b>distribute zonular tension evenly</b> and support the bag in cases of <b>zonular weakness or dialysis</b>.<br>Helps maintain capsular bag shape for proper IOL centration." },
{ q: "What prophylaxis reduces the risk of <b>endophthalmitis</b> after cataract surgery?", a: "1. <b>Povidone-iodine 5%</b> applied to conjunctival sac (most important single measure)<br>2. <b>Intracameral antibiotics</b> — cefuroxime or moxifloxacin (ESCRS study support)<br>3. <b>Sterile technique</b> and draping<br>4. <b>Topical antibiotics</b> — postoperative fluoroquinolone drops" },
          ]
        },
        {
          section: 'Ophthalmology',
          topic: "Ocular trauma",
          icon: "eye",
          cards: [
            { q: "What does the BETT classification stand for and what are its two main categories?", a: "<b>Birmingham Eye Trauma Terminology</b>.<br>Two main categories:<br>1. <b>Open globe</b> — full-thickness wound of the eye wall (sclera and/or cornea)<br>2. <b>Closed globe</b> — no full-thickness wound of the eye wall" },
{ q: "Under BETT, how is open globe injury subdivided?", a: "<b>Open globe</b> subdivisions:<br>1. <b>Rupture</b> — caused by <i>blunt</i> force (inside-out mechanism, globe bursts at weakest point)<br>2. <b>Laceration</b> — caused by <i>sharp</i> object, subdivided into:<br>&nbsp;&nbsp;• <b>Penetrating</b> — single full-thickness entry wound<br>&nbsp;&nbsp;• <b>Perforating</b> — entry <i>and</i> exit wound (through-and-through)<br>&nbsp;&nbsp;• <b>IOFB</b> — intraocular foreign body retained inside the globe" },
{ q: "Under BETT, how is closed globe injury subdivided?", a: "<b>Closed globe</b> subdivisions:<br>1. <b>Contusion</b> — blunt force, no full-thickness wound (e.g., hyphema, angle recession)<br>2. <b>Lamellar laceration</b> — partial-thickness wound of the eye wall (sharp object does <i>not</i> penetrate fully)" },
{ q: "Distinguish penetrating vs perforating eye injury.", a: "<b>Penetrating</b> = single full-thickness entry wound only (object enters but does not exit).<br><b>Perforating</b> = entry wound <i>plus</i> exit wound (through-and-through injury).<br>Both are subtypes of open globe laceration (BETT)." },
{ q: "What is the single most important prognostic indicator in ocular trauma and when should it be documented?", a: "<b>Visual acuity</b> is the most important prognostic indicator.<br>It must be documented <b>FIRST</b>, before any examination or manipulation of the globe." },
{ q: "What does an APD (afferent pupillary defect) indicate in ocular trauma?", a: "An <b>APD (Marcus Gunn pupil)</b> indicates <b>significant posterior segment damage</b> — optic nerve injury, extensive retinal damage, or vitreous hemorrhage.<br>Tested with the <b>swinging flashlight test</b>." },
{ q: "Why should Goldmann tonometry and forced duction testing be avoided when open globe is suspected?", a: "Both apply <b>pressure to the globe</b>, which can cause further <b>extrusion of intraocular contents</b> through the wound.<br>• No Goldmann tonometry (use Tono-Pen gently if needed, or defer)<br>• No forced duction testing" },
{ q: "What is the proper eye protection for a suspected open globe?", a: "A <b>rigid Fox shield</b> (metal or plastic) taped over the brow and cheek.<br>• Do <b>NOT</b> use a pressure patch — this can push intraocular contents out through the wound.<br>• The shield must not contact the globe." },
{ q: "Why is MRI contraindicated in suspected metallic intraocular foreign body?", a: "MRI uses strong magnetic fields that can cause a <b>metallic foreign body to move</b> within the eye, resulting in further tissue damage.<br>The imaging modality of choice is <b>CT orbit</b> (non-contrast, axial and coronal thin cuts)." },
{ q: "What is the Ocular Trauma Score (OTS)?", a: "The <b>OTS</b> is a prognostic scoring system that predicts <b>visual outcome</b> after ocular trauma.<br>Variables include:<br>• Initial visual acuity (most heavily weighted)<br>• Globe rupture<br>• Endophthalmitis<br>• Perforating injury<br>• Retinal detachment<br>• Relative afferent pupillary defect<br>Higher score = better visual prognosis." },
{ q: "List the classic signs of open globe injury.", a: "1. <b>Irregular/peaked pupil</b> (pointing toward wound site)<br>2. <b>Shallow or deep AC</b> (depending on wound location)<br>3. <b>Positive Seidel test</b> (fluorescein streaming = aqueous leak)<br>4. <b>Exposed uveal tissue</b> (dark brown tissue in wound)<br>5. <b>360° subconjunctival hemorrhage</b><br>6. <b>Lens opacity or subluxation</b><br>7. <b>Vitreous hemorrhage</b><br>8. <b>Hypotony</b> (low IOP)" },
{ q: "What is the Seidel test and what does a positive result mean?", a: "A concentrated <b>fluorescein strip</b> is applied over the suspected wound site, observed with cobalt blue light.<br><b>Positive Seidel test</b> = a <i>stream of bright green aqueous humor</i> dilutes the dark fluorescein → indicates <b>full-thickness wound with aqueous leak</b> (open globe)." },
{ q: "Why does the pupil become peaked/irregular in an open globe injury?", a: "The pupil becomes <b>peaked and points toward the wound</b> because:<br>• <b>Iris tissue is drawn toward the site of corneal/scleral laceration</b> by the flow of aqueous humor out of the wound (iris plugs the wound).<br>• This creates an irregular, teardrop-shaped pupil." },
{ q: "What is the emergency management of open globe injury?", a: "1. <b>Rigid Fox shield</b> (no pressure patch)<br>2. <b>NPO</b> (nothing by mouth — anticipate surgery under GA)<br>3. <b>IV antibiotics</b>: vancomycin + fluoroquinolone or ceftazidime<br>4. <b>Tetanus prophylaxis</b><br>5. <b>NO topical medications/ointments</b> (can be toxic intraocularly)<br>6. <b>Emergent surgical repair</b><br>7. <b>Avoid Valsalva</b> (no coughing, straining, bending)<br>8. Antiemetics if needed" },
{ q: "Why are topical ointments avoided in open globe injury?", a: "Topical ointments can <b>enter the eye through the wound</b> and are <b>toxic to intraocular structures</b> (especially the retina).<br>Systemic (IV) antibiotics are used instead." },
{ q: "What is the most common eye injury overall?", a: "<b>Corneal abrasion</b> — a defect in the corneal epithelium, usually from trauma (fingernail, paper edge, contact lens)." },
{ q: "What are the symptoms and signs of corneal abrasion?", a: "<b>Symptoms</b>: foreign body sensation, tearing, photophobia, pain, blurred vision.<br><b>Signs</b>: <b>fluorescein staining</b> reveals the epithelial defect (bright green under cobalt blue light), conjunctival injection." },
{ q: "How is corneal abrasion treated?", a: "1. <b>Topical antibiotics</b>: erythromycin ointment or fluoroquinolone drops<br>2. <b>Cycloplegic</b> for pain relief (e.g., cyclopentolate 1%) — reduces ciliary spasm<br>3. Oral analgesics if needed<br>4. Healing expected in <b>24–48 hours</b><br>5. <b>NO patching</b> for contact lens wearers (risk of <i>Pseudomonas</i> infection)" },
{ q: "Why should the eye NOT be patched in a contact lens wearer with corneal abrasion?", a: "Contact lens wearers are at increased risk of <b><i>Pseudomonas aeruginosa</i></b> infection.<br>A pressure patch creates a <b>warm, dark, moist environment</b> that promotes bacterial growth. Instead, use <b>fluoroquinolone drops</b> with anti-pseudomonal coverage." },
{ q: "What is recurrent corneal erosion syndrome and its classic association?", a: "<b>Recurrent corneal erosion syndrome</b> = repeated spontaneous breakdown of corneal epithelium, typically <b>upon waking</b> (lids stick to loose epithelium during sleep).<br>Classic association: <b>Epithelial basement membrane dystrophy (map-dot-fingerprint dystrophy)</b>.<br>Also occurs after prior corneal abrasion." },
{ q: "How is a corneal foreign body managed?", a: "1. <b>Slit-lamp removal</b> with needle tip or spud under topical anesthesia<br>2. If iron FB → remove <b>rust ring with rotary burr</b> within 24 hours<br>3. Perform <b>Seidel test</b> to ensure no penetration (must be negative)<br>4. <b>Topical antibiotics</b> post-removal<br>5. Follow up in 24 hours" },
{ q: "What is a rust ring and why must it be removed?", a: "A <b>rust ring</b> forms around an iron/steel corneal foreign body from oxidation.<br>It must be removed (typically with a <b>sterile burr</b>) because:<br>• It acts as a <b>nidus for inflammation and infection</b><br>• It impairs epithelial healing<br>• Can cause permanent corneal scarring if left in place" },
{ q: "What characterizes a spontaneous subconjunctival hemorrhage?", a: "<b>Bright red, painless, well-demarcated</b> area of blood under conjunctiva.<br>• No vision change, no discharge<br>• <b>Self-resolving in 2–3 weeks</b><br>• Common causes: Valsalva, coughing, sneezing, anticoagulants, HTN<br>• Check <b>BP and bleeding diathesis</b> if recurrent" },
{ q: "When should subconjunctival hemorrhage raise concern for open globe?", a: "If the hemorrhage is <b>360°</b> (circumferential) or if you <b>cannot see its posterior limit</b>, suspect an underlying <b>open globe injury</b> or scleral rupture.<br>These patients need further evaluation (CT orbit, careful exam)." },
{ q: "What is a hyphema and what is its most common cause?", a: "<b>Hyphema</b> = blood in the <b>anterior chamber</b>.<br>Most common cause: <b>blunt trauma</b> → tears of the <b>iris root or ciliary body vessels</b>.<br>Seen as a layered red blood collection in the lower AC when patient is upright." },
{ q: "How is hyphema graded?", a: "<b>Hyphema grading</b>:<br>• <b>Grade I</b>: < 1/3 of AC filled with blood<br>• <b>Grade II</b>: 1/3 to 1/2 of AC<br>• <b>Grade III</b>: > 1/2 of AC<br>• <b>Grade IV</b>: Total hyphema (<b>8-ball hyphema</b>) — entire AC filled, appears <b>black/dark red</b>" },
{ q: "What is the management of traumatic hyphema?", a: "1. <b>Rigid eye shield</b><br>2. <b>Bed rest with head elevated 30–45°</b> (allows blood to settle inferiorly)<br>3. <b>Topical cycloplegic</b> (atropine) — reduces pain and prevents posterior synechiae<br>4. <b>Topical steroid</b> — reduces inflammation<br>5. <b>Topical timolol</b> — controls IOP<br>6. <b>NO aspirin/NSAIDs</b> (increases bleeding risk)<br>7. Daily IOP checks" },
{ q: "When does rebleeding typically occur after traumatic hyphema?", a: "Rebleeding peaks at <b>day 3–5</b> after injury.<br>Rebleeding is often <b>worse than the initial bleed</b> and is associated with increased complications (glaucoma, corneal blood staining)." },
{ q: "What are the major complications of hyphema?", a: "1. <b>Rebleeding</b> (peaks day 3–5)<br>2. <b>Secondary glaucoma</b> (from RBCs clogging trabecular meshwork)<br>3. <b>Corneal blood staining</b> (hemoglobin-stained cornea — may take years to clear)<br>4. <b>Optic atrophy</b> from sustained elevated IOP<br>5. <b>Posterior synechiae</b>" },
{ q: "Why are sickle cell patients at special risk with hyphema?", a: "In sickle cell disease (including trait):<br>• <b>Sickled RBCs obstruct trabecular meshwork more readily</b> → IOP rises faster<br>• The <b>low-oxygen, acidotic AC environment</b> promotes further sickling<br>• Even mildly elevated IOP can cause <b>optic nerve damage</b> (compromised optic nerve blood supply)" },
{ q: "Which medications must be AVOIDED in sickle cell patients with hyphema?", a: "1. <b>Carbonic anhydrase inhibitors</b> (acetazolamide) — lowers AC pH, <b>worsens sickling</b> in the anterior chamber<br>2. <b>Epinephrine</b> — can cause vasoconstriction and worsen sickling<br>These patients have a <b>lower threshold for surgical evacuation</b> of the hyphema." },
{ q: "What is the typical presentation of traumatic iritis?", a: "<b>Traumatic iritis</b>:<br>• <b>Photophobia</b> and pain<br>• <b>Ciliary flush</b> (perilimbal injection)<br>• <b>Cells and flare</b> in the anterior chamber (on slit lamp)<br>• <b>Miotic pupil</b> (from iris sphincter spasm)<br>• History of blunt eye trauma" },
{ q: "How is traumatic iritis treated?", a: "1. <b>Topical cycloplegic</b> (e.g., cyclopentolate or homatropine) — relieves ciliary spasm and prevents posterior synechiae<br>2. <b>Topical corticosteroid</b> (e.g., prednisolone acetate) — reduces inflammation" },
{ q: "What is traumatic mydriasis and why may it be permanent?", a: "<b>Traumatic mydriasis</b> = dilated pupil after blunt trauma due to <b>tears in the iris sphincter muscle</b>.<br>It may be <b>permanent</b> because the sphincter muscle fibers are physically disrupted and do not regenerate.<br>The pupil is often <b>irregularly dilated</b> with visible sphincter tears on slit-lamp exam." },
{ q: "What is angle recession glaucoma and what causes it?", a: "<b>Angle recession glaucoma</b> results from blunt trauma causing a <b>tear in the ciliary body</b> — specifically between the <b>longitudinal and circular muscle fibers</b>.<br>On gonioscopy: <b>widened ciliary body band</b> (abnormally wide angle).<br>Mechanism: <b>open-angle glaucoma</b> from damaged trabecular meshwork." },
{ q: "What is the timeline for angle recession glaucoma and how should it be monitored?", a: "Can present <b>months to years after the initial trauma</b>.<br>Patients require <b>lifelong IOP monitoring</b> — at least annual checks with gonioscopy.<br>Rule: Any patient with history of significant blunt eye trauma should be monitored for angle recession glaucoma indefinitely." },
{ q: "What is a Vossius ring?", a: "A <b>Vossius ring</b> is a <b>ring of iris pigment on the anterior lens capsule</b>, caused by blunt trauma.<br>It results from the <b>pupillary margin of the iris being imprinted onto the lens</b> by the concussive force.<br>It is a sign of <b>significant blunt trauma</b> but does not impair vision." },
{ q: "What is the characteristic pattern of a traumatic cataract?", a: "A <b>rosette-shaped (flower-petal) cataract</b> — feathery opacities radiating from the center of the lens, often seen in the posterior subcapsular region.<br>Can develop <b>acutely or years after trauma</b>." },
{ q: "What signs suggest lens subluxation or dislocation after trauma?", a: "1. <b>Iridodonesis</b> — trembling/quivering of the iris (loss of lens support)<br>2. <b>Phacodonesis</b> — trembling of the lens<br>3. <b>Monocular diplopia</b> (edge of subluxated lens in visual axis)<br>4. <b>Unequal AC depth</b><br>5. <b>Visible lens equator</b> on dilated exam" },
{ q: "What secondary glaucoma types can occur from lens injury?", a: "1. <b>Phacomorphic glaucoma</b> — swollen/intumescent lens pushes iris forward → <b>angle closure</b> (pupillary block)<br>2. <b>Phacolytic glaucoma</b> — leakage of <b>lens proteins through intact capsule</b> of a hypermature cataract → macrophages clog trabecular meshwork → <b>open-angle glaucoma</b>" },
{ q: "What is the mechanism of an orbital floor blowout fracture?", a: "Blunt trauma to the orbit → sudden increase in <b>intraorbital pressure</b> (hydraulic mechanism) → fracture at the <b>weakest wall</b> of the orbit.<br>Most common: <b>orbital floor</b> (maxillary bone) > <b>medial wall</b> (lamina papyracea)." },
{ q: "What are the classic clinical findings of orbital floor blowout fracture?", a: "1. <b>Restricted upgaze</b> (entrapment of inferior rectus/orbital tissue)<br>2. <b>Enophthalmos</b> (sunken eye — from increased orbital volume)<br>3. <b>Infraorbital hypoesthesia</b> (V2 — numbness of cheek/upper lip/upper teeth)<br>4. <b>Diplopia</b> (especially in upgaze)<br>5. <b>Subcutaneous emphysema</b> (crepitus — air from maxillary sinus)<br>6. Periorbital ecchymosis and edema" },
{ q: "What is the teardrop sign on CT in orbital floor fracture?", a: "The <b>teardrop sign</b> = a <b>teardrop-shaped soft tissue density</b> hanging into the maxillary sinus on coronal CT.<br>It represents <b>herniated orbital fat and/or inferior rectus muscle</b> through the floor fracture." },
{ q: "What is a white-eyed blowout fracture and why is it an emergency?", a: "A <b>white-eyed blowout fracture</b> occurs in <b>children</b> — minimal external bruising (\"white eye\") but <b>tight entrapment of inferior rectus</b> in a greenstick fracture.<br>It is an <b>emergency</b> because:<br>• Causes <b>oculocardiac reflex</b> → <b>bradycardia, nausea, vomiting</b><br>• Can lead to <b>muscle ischemia and permanent diplopia</b><br>• Requires <b>emergency surgical release</b>" },
{ q: "What are the indications for surgical repair of orbital blowout fracture?", a: "1. <b>Persistent diplopia in primary gaze</b> after 2 weeks (not resolving with swelling reduction)<br>2. <b>Enophthalmos > 2 mm</b><br>3. <b>Large floor defect (> 50%)</b> of orbital floor<br>4. <b>Muscle entrapment</b> (especially in children — emergent)<br>Otherwise, wait <b>1–2 weeks</b> for swelling to resolve before deciding." },
{ q: "What is orbital compartment syndrome?", a: "<b>Orbital compartment syndrome</b> = rapidly rising orbital pressure (usually from <b>retrobulbar hemorrhage</b>) that compresses the <b>optic nerve and central retinal artery</b>, causing <b>acute vision loss</b>.<br>This is an <b>ophthalmic emergency</b>." },
{ q: "What are the signs of orbital compartment syndrome?", a: "1. <b>Proptosis</b> (eye pushed forward)<br>2. <b>Decreased vision</b> (rapid onset)<br>3. <b>APD</b> (afferent pupillary defect)<br>4. <b>Elevated IOP</b> (rock-hard globe)<br>5. <b>Restricted/frozen extraocular motility</b><br>6. <b>Tense, firm orbit</b> on palpation<br>7. Periorbital swelling and ecchymosis" },
{ q: "What is the emergency treatment for orbital compartment syndrome?", a: "<b>Lateral canthotomy and inferior cantholysis</b>:<br>1. Clamp the lateral canthus with a hemostat<br>2. Cut the lateral canthal tendon<br>3. <b>Release the inferior crus</b> of the lateral canthal tendon (cantholysis)<br>This decompresses the orbit by allowing the globe to move forward.<br><b>Must be done within minutes</b> — can be performed at the bedside by any trained physician." },
{ q: "What are the two types of traumatic optic neuropathy?", a: "1. <b>Direct</b> — bone fragment or foreign body directly <b>lacerates</b> the optic nerve<br>2. <b>Indirect</b> (most common) — <b>contrecoup/transmitted force</b> damages the optic nerve without direct penetration (e.g., deceleration injury, forehead blow)" },
{ q: "What are the clinical findings in traumatic optic neuropathy?", a: "1. <b>Decreased visual acuity</b> (can range from mild to NLP)<br>2. <b>APD</b> (afferent pupillary defect — hallmark)<br>3. <b>Normal fundus initially</b> — disc pallor develops <b>weeks later</b> as optic atrophy ensues<br>4. Visual field defects<br>5. Decreased color vision" },
{ q: "What is the current treatment approach for traumatic optic neuropathy?", a: "Treatment is <b>controversial</b>. Options include:<br>1. <b>Observation</b> alone<br>2. <b>High-dose IV methylprednisolone</b> (previously used, but <b>CRASH trial</b> raised concerns about increased mortality with high-dose steroids in trauma)<br>3. <b>Optic canal decompression surgery</b> (if CT shows bone impinging on optic canal)<br>Currently, no treatment has strong evidence of superiority." },
{ q: "Where are the most common sites of globe rupture in adults?", a: "1. <b>Limbus</b> (thinnest area in adults — junction of cornea and sclera)<br>2. At the <b>insertion of rectus muscles</b> (thin sclera at muscle attachment)<br>3. At <b>previous surgical incision/wound sites</b> (e.g., old cataract or glaucoma surgery sites)" },
{ q: "Distinguish the mechanism of rupture vs laceration in open globe injury.", a: "<b>Rupture</b> (blunt force):<br>• Inside-out mechanism — IOP spike bursts the globe at the <b>weakest point</b><br>• Wound is usually <b>away from impact site</b><br><br><b>Laceration</b> (sharp force):<br>• Outside-in mechanism — sharp object cuts through<br>• Wound is <b>at the impact site</b>" },
{ q: "What are the signs of globe rupture?", a: "1. <b>Extrusion of intraocular contents</b> (uveal tissue, vitreous, lens)<br>2. <b>Flat anterior chamber</b> (collapsed)<br>3. <b>Hypotony</b> (very low IOP)<br>4. <b>Irregular/peaked pupil</b><br>5. <b>360° subconjunctival hemorrhage</b><br>6. <b>Decreased vision</b> (often severe)<br>7. <b>Positive Seidel test</b>" },
{ q: "What is siderosis bulbi?", a: "<b>Siderosis bulbi</b> = toxicity from a retained <b>iron intraocular foreign body</b>.<br>Iron dissociates and deposits in ocular tissues causing:<br>• <b>Brown discoloration</b> of iris (heterochromia)<br>• <b>Cataract</b><br>• <b>Retinal degeneration</b><br>• <b>Decreased ERG amplitudes</b> (b-wave reduction — early sign)<br>• Secondary glaucoma" },
{ q: "What is chalcosis?", a: "<b>Chalcosis</b> = toxicity from a retained <b>copper intraocular foreign body</b>.<br>Features:<br>• <b>Sunflower cataract</b> (green-brown petal-shaped deposits on anterior lens capsule)<br>• <b>Kayser-Fleischer–like ring</b> (copper in Descemet's membrane)<br>• Retinal toxicity<br>If copper content is <b>> 85% pure</b> → <b>suppurative endophthalmitis</b> (severe inflammation, sterile)." },
{ q: "Which intraocular foreign body materials are generally well-tolerated?", a: "<b>Inert materials</b> that are generally tolerated:<br>• <b>Glass</b><br>• <b>Stone</b><br>• <b>Plastic</b><br>• <b>Gold, silver, platinum</b><br>These may sometimes be observed if small and in a non-critical location, but most IOFBs are surgically removed to prevent endophthalmitis." },
{ q: "How is IOFB managed surgically?", a: "<b>IOFB management</b>:<br>1. <b>CT orbit</b> to locate and characterize FB (NOT MRI if metallic)<br>2. <b>IV antibiotics</b> (high risk of endophthalmitis)<br>3. <b>Pars plana vitrectomy</b> + foreign body extraction (with forceps or magnet for ferrous FB)<br>4. <b>Endolaser</b> (prophylactic retinal treatment around entry site)<br>5. ± Lensectomy if lens damaged<br>6. Tetanus prophylaxis" },
{ q: "Why is alkali chemical burn worse than acid?", a: "<b>Alkali</b> causes <b>liquefactive necrosis</b> — it saponifies cell membranes and <b>penetrates rapidly and deeply</b> into ocular tissues, reaching the anterior chamber.<br><b>Acid</b> causes <b>coagulative necrosis</b> — protein denaturation creates a <b>barrier that limits further penetration</b>.<br>Exception: <b>hydrofluoric (HF) acid</b> penetrates like alkali." },
{ q: "Name common alkali and acid agents in chemical eye burns.", a: "<b>Alkali agents</b> (worse prognosis):<br>• <b>Lye</b> (NaOH — drain cleaners)<br>• <b>Ammonia</b> (cleaning products)<br>• <b>Lime/calcium hydroxide</b> (cement, plaster)<br><br><b>Acid agents</b>:<br>• Sulfuric acid (car batteries)<br>• Hydrochloric acid<br>• Acetic acid<br>• <b>Hydrofluoric acid</b> (penetrates like alkali — exception)" },
{ q: "What is the FIRST and most critical step in chemical eye burn management?", a: "<b>IMMEDIATE copious irrigation</b> — this takes priority over <i>everything</i> (even visual acuity).<br>• Use <b>saline, Ringer's lactate, or water</b> — whatever is immediately available<br>• Irrigate for at least <b>30 minutes</b><br>• <b>Check pH</b> — target <b>7.0–7.4</b><br>• Continue irrigation until pH is neutral<br>• Remove any particulate matter (especially lime particles in fornices)" },
{ q: "Describe the Roper-Hall classification for chemical burns.", a: "<b>Roper-Hall classification</b> (based on corneal clarity and limbal ischemia):<br>• <b>Grade I</b>: Clear cornea, no limbal ischemia → excellent prognosis<br>• <b>Grade II</b>: Hazy cornea (iris details visible), < 1/3 limbal ischemia → good prognosis<br>• <b>Grade III</b>: Total corneal epithelial loss, stromal haze (iris details obscured), 1/3–1/2 limbal ischemia → guarded prognosis<br>• <b>Grade IV</b>: Opaque cornea (no iris view), > 1/2 limbal ischemia → poor prognosis" },
{ q: "What is the medical treatment for chemical eye burns after irrigation?", a: "1. <b>Topical antibiotics</b> (prevent secondary infection)<br>2. <b>Cycloplegic</b> (pain relief, prevent synechiae)<br>3. <b>Topical steroids</b> — <i>first 7–10 days only</i> (after that, steroids inhibit collagen repair → increased perforation risk)<br>4. <b>Ascorbic acid</b> (oral and topical — promotes collagen synthesis)<br>5. <b>Citric acid/citrate drops</b> (inhibits PMN-mediated collagen breakdown)<br>6. <b>Amniotic membrane transplant</b> for severe burns" },
{ q: "What are the long-term complications of severe chemical eye burns?", a: "1. <b>Corneal scarring and opacification</b><br>2. <b>Corneal perforation</b> (from collagenolysis)<br>3. <b>Limbal stem cell deficiency</b> (conjunctivalization of cornea)<br>4. <b>Symblepharon</b> (adhesion of palpebral and bulbar conjunctiva)<br>5. <b>Secondary glaucoma</b><br>6. <b>Dry eye</b> (goblet cell destruction)<br>7. <b>Eyelid cicatricial changes</b>" },
{ q: "What is UV keratitis (welding flash/snow blindness)?", a: "<b>UV keratitis</b> = corneal epithelial damage from ultraviolet radiation.<br>Causes: welding without eye protection, tanning beds, snow reflection, high-altitude sun.<br>Features:<br>• <b>Delayed onset 6–12 hours</b> after exposure<br>• <b>Bilateral</b> punctate epithelial erosions<br>• <b>Severe pain</b>, foreign body sensation, tearing, photophobia<br>• <b>Self-resolving in 24–48 hours</b>" },
{ q: "How is UV keratitis treated?", a: "1. <b>Topical antibiotics</b> (prevent secondary infection)<br>2. <b>Cycloplegic</b> (pain relief)<br>3. <b>Oral analgesics</b><br>4. Cool compresses<br>5. <b>Self-resolving in 24–48 hours</b> — reassurance<br>No patching necessary." },
{ q: "What is solar retinopathy?", a: "<b>Solar retinopathy</b> = photic injury to the foveal retina from directly viewing a solar eclipse without adequate protection.<br>• Causes <b>RPE disruption and photoreceptor damage</b> at the fovea<br>• Central scotoma, metamorphopsia<br>• OCT: disruption of the outer retinal layers at fovea<br>• Usually <b>self-limited</b> with partial visual recovery" },
{ q: "What is the first priority when evaluating an eyelid laceration?", a: "<b>Rule out open globe injury first</b> — before any eyelid repair.<br>Any full-thickness eyelid laceration, especially from sharp trauma, has a significant association with underlying globe injury." },
{ q: "How are marginal (full-thickness) eyelid lacerations managed?", a: "<b>Marginal lacerations</b> (through the lid margin) require <b>meticulous layered repair by an ophthalmologist/oculoplastic surgeon</b>.<br>Layers to repair:<br>1. Posterior lamella (tarsus + conjunctiva)<br>2. Lid margin (precise alignment of gray line/lash line)<br>3. Anterior lamella (skin + orbicularis muscle)<br>Poor alignment → <b>lid notching, trichiasis, and corneal exposure</b>." },
{ q: "Why must medial eyelid lacerations be carefully evaluated?", a: "Medial eyelid lacerations may involve the <b>canalicular system</b> (lacrimal drainage).<br>If canalicular injury is suspected → repair with <b>silicone stent placement</b> to maintain the drainage pathway.<br>Failure to repair → chronic <b>epiphora</b> (tearing)." },
{ q: "Why must levator muscle involvement be identified in upper eyelid lacerations?", a: "The <b>levator palpebrae superioris</b> elevates the upper lid.<br>If lacerated and not repaired → <b>traumatic ptosis</b> (drooping of the upper eyelid).<br>Must identify and repair the levator aponeurosis during wound closure." },
{ q: "What is commotio retinae (Berlin edema)?", a: "<b>Commotio retinae</b> = whitening of the outer retina from <b>photoreceptor disruption</b> after blunt trauma (contrecoup injury).<br>• <b>Grayish-white retinal opacification</b>, often in the posterior pole<br>• If involving the macula → decreased central vision<br>• Usually <b>self-resolving</b> over weeks, but can leave permanent RPE changes if severe" },
{ q: "What is a traumatic choroidal rupture?", a: "<b>Choroidal rupture</b> = a <b>crescent-shaped pale streak</b> in the fundus, typically <b>concentric to the optic disc</b>.<br>• Caused by blunt trauma (contrecoup mechanism)<br>• Associated with <b>subretinal hemorrhage</b> acutely<br>• If through the macula → permanent <b>central vision loss</b><br>• Late complication: <b>choroidal neovascular membrane (CNVM)</b>" },
{ q: "What is retinal dialysis and who is most commonly affected?", a: "<b>Retinal dialysis</b> = a <b>tear at the ora serrata</b> (junction of retina and pars plana).<br>• Most common in <b>young males after blunt trauma</b><br>• Most common location: <b>inferotemporal quadrant</b> (superonasal in non-traumatic)<br>• Can lead to <b>rhegmatogenous retinal detachment</b><br>• Often slowly progressive — may present weeks-months after trauma" },
{ q: "What is sympathetic ophthalmia?", a: "<b>Sympathetic ophthalmia</b> = <b>bilateral granulomatous panuveitis</b> occurring <b>weeks to months</b> after penetrating trauma or intraocular surgery to one eye.<br>• <b>Exciting eye</b> = injured eye<br>• <b>Sympathizing eye</b> = fellow (uninvolved) eye<br>• Autoimmune reaction against sequestered uveal antigens<br>• <b>Rare but devastating</b>" },
{ q: "What histological finding is characteristic of sympathetic ophthalmia?", a: "<b>Dalen-Fuchs nodules</b> = collections of <b>epithelioid cells between Bruch's membrane and the RPE</b>.<br>Histology shows <b>diffuse granulomatous inflammation</b> with lymphocytes, epithelioid cells, and giant cells, sparing the choriocapillaris." },
{ q: "How is sympathetic ophthalmia treated and prevented?", a: "<b>Treatment</b>:<br>• <b>High-dose systemic corticosteroids</b><br>• <b>Immunosuppressive agents</b> (methotrexate, azathioprine, mycophenolate, cyclosporine) for steroid-sparing<br><br><b>Prevention</b> (controversial):<br>• <b>Enucleation of the exciting eye within 10–14 days</b> of injury (before sympathetic ophthalmia develops)<br>• Once sympathetic ophthalmia is established, enucleation is of <b>no benefit</b>" },
{ q: "What grading system uses AC blood level relative to total AC volume?", a: "The <b>hyphema grading system</b>:<br>• Grade I: < 1/3 AC<br>• Grade II: 1/3–1/2 AC<br>• Grade III: > 1/2 AC<br>• Grade IV: 100% (total / 8-ball hyphema)" },
{ q: "Why is head elevation at 30–45° important in hyphema management?", a: "Head elevation allows <b>blood to settle inferiorly</b> by gravity, which:<br>1. Keeps blood <b>away from the visual axis</b><br>2. Facilitates <b>absorption through the trabecular meshwork</b><br>3. Reduces risk of <b>corneal blood staining</b><br>4. Helps monitor for rebleeding" },
{ q: "What is an 8-ball hyphema and why is it significant?", a: "An <b>8-ball hyphema</b> = <b>Grade IV total hyphema</b> where the entire AC is filled with <b>dark, deoxygenated blood</b> (appears black).<br>It is significant because:<br>• Highest risk of <b>corneal blood staining</b><br>• Greatest risk of <b>secondary glaucoma</b><br>• Most likely to require <b>surgical evacuation</b> (AC washout)" },
{ q: "What is corneal blood staining and when does it occur?", a: "<b>Corneal blood staining</b> = deposition of <b>hemoglobin and hemosiderin in the corneal stroma</b>, giving a yellowish-brown discoloration.<br>Occurs with:<br>• <b>Prolonged/large hyphema</b> (especially total hyphema)<br>• <b>Elevated IOP</b><br>• <b>Compromised endothelium</b><br>May take <b>months to years to clear</b>, or may be permanent." },
{ q: "A patient with sickle cell trait presents with hyphema and elevated IOP. Why is acetazolamide contraindicated?", a: "<b>Acetazolamide</b> (a carbonic anhydrase inhibitor) is contraindicated because it:<br>1. <b>Decreases aqueous humor pH</b> (more acidic AC)<br>2. <b>Increases ascorbic acid concentration</b> in AC<br>3. Both promote <b>sickling of red blood cells</b> in the anterior chamber<br>4. Sickled cells further obstruct outflow → <b>worsening IOP elevation</b><br>Use <b>topical timolol</b> or surgical evacuation instead." },
{ q: "What gonioscopic finding is seen in angle recession?", a: "On gonioscopy: an <b>abnormally widened ciliary body band</b> (the space between the scleral spur and the iris root is broader than normal).<br>This represents a <b>tear between the longitudinal and circular fibers of the ciliary muscle</b>.<br>Compare with the <b>fellow eye</b> — asymmetry is diagnostic." },
{ q: "A patient presents with a peaked pupil, shallow AC, and positive Seidel test. What is the diagnosis?", a: "<b>Open globe injury</b> (likely corneal laceration).<br>Key findings:<br>• <b>Peaked pupil</b> — iris drawn toward wound<br>• <b>Shallow AC</b> — aqueous leak from anterior wound<br>• <b>Positive Seidel test</b> — confirming aqueous leak<br>Management: shield, NPO, IV antibiotics, emergent surgical repair." },
{ q: "What is the oculocardiac reflex and when is it clinically important in trauma?", a: "The <b>oculocardiac reflex</b> is a <b>trigemino-vagal reflex</b>:<br>• Afferent: <b>trigeminal nerve (V1)</b> — triggered by pressure/traction on extraocular muscles or globe<br>• Efferent: <b>vagus nerve (X)</b> → <b>bradycardia</b>, nausea, vomiting<br>Clinically important in <b>white-eyed blowout fractures</b> (children) where tight muscle entrapment triggers reflex → <b>emergency surgical release</b>." },
{ q: "What is the most common site of retinal dialysis after blunt trauma?", a: "The <b>inferotemporal quadrant</b> is the most common location for traumatic retinal dialysis.<br>(In contrast, non-traumatic dialysis tends to occur <b>superonasally</b>.)" },
{ q: "How does phacomorphic glaucoma differ from phacolytic glaucoma?", a: "<b>Phacomorphic glaucoma</b>:<br>• Swollen (intumescent) lens → pushes iris forward → <b>angle closure</b> (pupillary block)<br>• Lens capsule is <b>intact</b><br>• AC is <b>shallow</b><br><br><b>Phacolytic glaucoma</b>:<br>• Lens proteins leak through <b>intact capsule</b> of <b>hypermature/mature cataract</b><br>• Macrophages engulf proteins → clog TM → <b>open-angle</b> glaucoma<br>• AC may have macrophage-laden flare" },
{ q: "What findings differentiate an anterior (corneal) wound vs posterior (scleral) wound in open globe injury?", a: "<b>Anterior wound (corneal)</b>:<br>• <b>Shallow AC</b> (aqueous leaking out)<br>• Peaked pupil toward corneal wound<br>• Visible corneal wound<br><br><b>Posterior wound (scleral)</b>:<br>• <b>Deep AC</b> (vitreous loss posteriorly)<br>• Vitreous hemorrhage<br>• May have <b>360° subconjunctival hemorrhage</b><br>• Wound often not directly visible" },
{ q: "What imaging is used for suspected orbital fractures?", a: "<b>CT orbit</b> (non-contrast, thin-cut axial and coronal views) is the gold standard.<br>• Best for identifying bony fractures, herniated tissue, and foreign bodies<br>• Look for: teardrop sign, air in orbit, fracture lines<br>• <b>Avoid MRI</b> if metallic foreign body is suspected<br>• Plain X-rays have low sensitivity (rarely used)" },
{ q: "Why does enophthalmos occur after orbital floor fracture?", a: "<b>Enophthalmos</b> (sunken eye) occurs because:<br>• Fracture of the orbital floor <b>increases orbital volume</b> (tissue herniates into maxillary sinus)<br>• The globe <b>sinks posteriorly</b> into the enlarged orbit<br>• May be masked initially by orbital edema (becomes apparent as swelling resolves)" },
{ q: "What nerve is damaged in orbital floor fracture and what are its symptoms?", a: "The <b>infraorbital nerve (V2)</b> runs along the orbital floor and is commonly injured.<br>Results in <b>hypoesthesia/numbness</b> of:<br>• <b>Ipsilateral cheek</b><br>• <b>Upper lip</b><br>• <b>Upper teeth/gums</b><br>• <b>Side of nose</b><br>Numbness may be temporary or permanent." },
{ q: "What is the significance of subcutaneous emphysema (crepitus) after orbital trauma?", a: "<b>Subcutaneous emphysema</b> = air tracking from a <b>paranasal sinus</b> (usually maxillary or ethmoid) through a <b>fracture site</b> into the orbital/periorbital soft tissues.<br>Indicates an <b>orbital wall fracture</b> communicating with a sinus.<br>Instruct patient to <b>avoid nose blowing</b> (can force air into orbit → orbital emphysema or compartment syndrome)." },
{ q: "In orbital compartment syndrome, why must lateral canthotomy be performed emergently?", a: "The optic nerve and <b>central retinal artery</b> are compressed by rising orbital pressure.<br><b>Irreversible vision loss</b> can occur within <b>60–90 minutes</b> without decompression.<br>Lateral canthotomy + cantholysis is the fastest way to decompress the orbit, can be done at bedside, and should <b>not wait for imaging or ophthalmology consultation</b>." },
{ q: "What is the difference between canthotomy and cantholysis?", a: "<b>Canthotomy</b> = cutting the lateral canthus (the junction of upper and lower lids at the outer corner).<br><b>Cantholysis</b> = cutting the <b>inferior crus of the lateral canthal tendon</b> to release the lower lid from the orbital rim.<br>Both together decompress the orbit by allowing the globe and orbital contents to move anteriorly." },
{ q: "What ERG finding is an early indicator of siderosis bulbi?", a: "<b>Decreased b-wave amplitude</b> on electroretinography (ERG).<br>This is often the <b>earliest objective sign</b> of iron toxicity to the retina, even before clinical findings are apparent.<br>Progressive decrease → eventual extinguished ERG if FB not removed." },
{ q: "A copper IOFB with > 85% purity causes what severe reaction?", a: "<b>Suppurative endophthalmitis</b> — a severe, sterile inflammatory reaction that mimics infectious endophthalmitis.<br>This occurs with <b>high-purity (> 85%) copper</b> foreign bodies.<br>Lower-purity copper alloys (e.g., brass, bronze) cause <b>chalcosis</b> (chronic, less severe reaction)." },
{ q: "Why are topical steroids limited to the first 7–10 days in chemical burn treatment?", a: "After the first 7–10 days, topical steroids:<br>• <b>Inhibit collagen synthesis</b> by stromal keratocytes<br>• <b>Impair re-epithelialization</b><br>• Increase risk of <b>corneal melting and perforation</b> (stromal thinning)<br>They are beneficial early to control inflammation but harmful in the reparative phase." },
{ q: "What role does ascorbic acid play in chemical burn treatment?", a: "<b>Ascorbic acid (vitamin C)</b> — both topical and oral:<br>• <b>Promotes collagen synthesis</b> by corneal stromal fibroblasts<br>• Reduces the risk of <b>corneal perforation</b><br>• Acts as an antioxidant<br>It is a key adjunctive therapy, especially in <b>moderate-to-severe alkali burns</b>." },
{ q: "What is limbal stem cell deficiency and how does it relate to chemical burns?", a: "<b>Limbal stem cells</b> (at the corneoscleral junction) are responsible for <b>corneal epithelial renewal</b>.<br>Severe chemical burns destroy these cells → <b>limbal stem cell deficiency</b>:<br>• Conjunctival epithelium grows over the cornea (<b>conjunctivalization</b>)<br>• <b>Persistent epithelial defects</b><br>• <b>Corneal neovascularization</b><br>• <b>Chronic inflammation and opacification</b><br>Treatment: limbal stem cell transplant." },
{ q: "What is symblepharon?", a: "<b>Symblepharon</b> = <b>adhesion</b> between the palpebral (eyelid) conjunctiva and the bulbar (globe) conjunctiva.<br>Caused by severe conjunctival inflammation/destruction (chemical burns, Stevens-Johnson syndrome, cicatricial pemphigoid).<br>Results in <b>restricted eye movement, fornix shortening, and entropion</b>." },
{ q: "What variables comprise the Ocular Trauma Score (OTS)?", a: "<b>OTS calculation</b>:<br>Start with initial VA (raw points):<br>• NLP = 60, LP/HM = 70, 1/200–19/200 = 80, 20/200–20/50 = 90, ≥ 20/40 = 100<br><br>Subtract for:<br>• Globe rupture: −23<br>• Endophthalmitis: −17<br>• Perforating injury: −14<br>• Retinal detachment: −11<br>• APD: −10<br><br>Higher final score → better visual prognosis." },
{ q: "What is the most important factor in the OTS?", a: "<b>Initial visual acuity</b> is the most heavily weighted factor in the OTS and the single most important prognostic indicator for visual outcome after ocular trauma." },
{ q: "What type of retinal detachment occurs after trauma with retinal dialysis?", a: "<b>Rhegmatogenous retinal detachment</b> — caused by a break (dialysis) in the retina that allows <b>vitreous fluid to pass through</b> and separate the neurosensory retina from the RPE." },
{ q: "What is a giant retinal tear and its traumatic significance?", a: "A <b>giant retinal tear</b> = a retinal break extending <b>≥ 90° (3 clock hours)</b> of the circumference, usually at or near the ora serrata.<br>Can occur after severe blunt trauma.<br>Requires <b>vitrectomy with silicone oil or gas tamponade</b> for repair.<br>High risk of <b>PVR</b> (proliferative vitreoretinopathy)." },
{ q: "In blunt trauma, where does globe rupture typically occur relative to the impact site?", a: "In blunt trauma, globe rupture occurs <b>away from the impact site</b>, at the <b>weakest point</b> of the globe (limbus, muscle insertions, prior surgical sites).<br>This is because the <b>IOP spikes and the globe bursts at the point of least resistance</b> (inside-out mechanism)." },
{ q: "How do you determine if a corneal foreign body has penetrated the full thickness?", a: "Perform a <b>Seidel test</b>:<br>• Apply concentrated fluorescein over the wound site<br>• Observe under cobalt blue light<br>• <b>Negative Seidel</b> = no aqueous leak → partial-thickness (safe to remove at slit lamp)<br>• <b>Positive Seidel</b> = aqueous streaming → full-thickness wound (open globe) → emergent surgical management" },
{ q: "What antibiotic regimen is used for open globe injury?", a: "<b>IV antibiotics</b> for open globe:<br>• <b>Vancomycin</b> (covers gram-positive, including MRSA) <b>+</b><br>• <b>Fluoroquinolone</b> (e.g., levofloxacin) or <b>ceftazidime</b> (covers gram-negatives, especially <i>Pseudomonas</i>)<br>Goal: prevent <b>post-traumatic endophthalmitis</b>" },
{ q: "Why should patients with open globe injuries avoid Valsalva maneuvers?", a: "Valsalva maneuvers (coughing, straining, bearing down) <b>increase intraocular and venous pressure</b>, which can:<br>• Force <b>intraocular contents out through the wound</b><br>• Worsen hemorrhage<br>• Convert a contained injury into extrusion of uvea/vitreous<br>Prescribe antiemetics and stool softeners prophylactically." },
{ q: "What is the role of tetanus prophylaxis in ocular trauma?", a: "<b>Tetanus prophylaxis</b> should be administered for any <b>open globe injury or penetrating wound</b> — especially if the patient's immunization is not up to date or involves a contaminated/soil-exposed foreign body.<br>• Td booster if last vaccine > 5 years ago<br>• TIG (tetanus immunoglobulin) if not previously vaccinated" },
{ q: "What is the mechanism of the infraorbital nerve injury in blowout fracture?", a: "The <b>infraorbital nerve (V2)</b> travels through the <b>infraorbital groove/canal</b> along the orbital floor.<br>When the floor fractures, the nerve is <b>directly contused, stretched, or entrapped</b> in the fracture site → <b>hypoesthesia</b> of the cheek, upper lip, upper teeth, and lateral nose." },
{ q: "A child with orbital trauma has minimal bruising but severe restricted upgaze, nausea, vomiting, and bradycardia. Diagnosis?", a: "<b>White-eyed blowout fracture</b> with <b>inferior rectus entrapment</b>.<br>The minimal external injury (\"white eye\") is deceptive. The <b>oculocardiac reflex</b> from tight muscle entrapment causes bradycardia and vagal symptoms.<br>This is an <b>emergency requiring urgent surgical release</b> within hours." },
{ q: "What causes the deep AC in a posterior open globe wound?", a: "In a <b>posterior scleral wound</b>, <b>vitreous is lost posteriorly</b> through the wound.<br>This reduces posterior segment volume, causing the <b>lens-iris diaphragm to fall back</b>, resulting in a <b>deeper than normal anterior chamber</b>." },
{ q: "What is the CRASH trial and its relevance to traumatic optic neuropathy?", a: "The <b>CRASH trial</b> (Corticosteroid Randomisation After Significant Head Injury) showed that <b>high-dose IV methylprednisolone in head trauma was associated with increased mortality</b>.<br>This has made the use of steroids in <b>traumatic optic neuropathy controversial</b>, and many centers have moved away from routine steroid use." },
{ q: "What is the most common cause of enucleation after penetrating trauma?", a: "<b>Sympathetic ophthalmia prevention</b> has historically been a major reason for enucleation of a severely damaged eye.<br>However, the decision is controversial — modern immunosuppression may control the disease, and enucleation of a seeing (even poorly seeing) eye is rarely justified." },
{ q: "How quickly can sympathetic ophthalmia develop after penetrating injury?", a: "Sympathetic ophthalmia typically develops <b>2 weeks to several months</b> after penetrating injury, with <b>80% occurring within 3 months</b> and <b>90% within 1 year</b>.<br>It can rarely occur as early as <b>5 days</b> or as late as <b>decades</b> after injury." },
{ q: "What is the classic presentation of sympathetic ophthalmia in the sympathizing eye?", a: "The sympathizing (fellow) eye develops:<br>• <b>Bilateral granulomatous panuveitis</b><br>• <b>Mutton-fat KPs</b> (keratic precipitates)<br>• <b>Iris nodules</b> (Koeppe and Busacca)<br>• <b>Vitritis</b><br>• <b>Exudative retinal detachment</b><br>• <b>Dalen-Fuchs nodules</b> (yellow-white lesions at RPE level)<br>• Papillitis (optic disc edema)" },
{ q: "What is the significance of the rosette cataract pattern?", a: "A <b>rosette (flower-petal) cataract</b> is <b>pathognomonic for trauma</b>.<br>• Feathery spoke-like opacities radiating from the lens center<br>• Can involve anterior and/or posterior subcapsular cortex<br>• May develop <b>immediately or years after blunt/penetrating trauma</b><br>Seeing this pattern on exam should prompt a history of ocular trauma." },
{ q: "How does a traumatic retinal detachment from dialysis typically present?", a: "Often presents <b>insidiously, weeks to months after trauma</b>:<br>• Progressive <b>visual field loss</b> (inferior field loss from superior RD)<br>• <b>Floaters</b><br>• <b>Flashes</b> may be absent (unlike PVD-related tears)<br>• Fundoscopy: <b>retinal tear at ora serrata</b> with slowly progressive RD<br>• Most common in <b>young males</b>" },
{ q: "What organisms are most commonly associated with post-traumatic endophthalmitis?", a: "Post-traumatic endophthalmitis organisms:<br>• <b>Gram-positive</b>: <i>Staphylococcus</i> spp., <i>Streptococcus</i> spp., <b><i>Bacillus cereus</i></b> (especially soil-contaminated injuries — fulminant, devastating)<br>• <b>Gram-negative</b>: <i>Pseudomonas</i><br>• Fungi (delayed, soil/vegetable matter exposure)<br><b><i>Bacillus cereus</i></b> has the worst prognosis." },
{ q: "What distinguishes a contusion from a lamellar laceration under BETT?", a: "<b>Contusion</b>: <b>blunt</b> force → no visible wound (internal damage: hyphema, angle recession, commotio retinae, etc.)<br><b>Lamellar laceration</b>: <b>sharp</b> object → <b>partial-thickness wound</b> (the eye wall is cut but not penetrated fully)<br>Both are <b>closed globe</b> injuries." },
{ q: "What is the key differentiating factor between Grade III and Grade IV Roper-Hall chemical burns?", a: "<b>Grade III</b>: corneal haze but <b>iris details may still be partially visible</b>; 1/3–1/2 limbal ischemia → guarded prognosis<br><b>Grade IV</b>: <b>opaque cornea</b> with <b>no iris details visible</b>; > 1/2 limbal ischemia → <b>poor prognosis</b>" },
{ q: "A welder presents with bilateral eye pain, tearing, and photophobia starting 8 hours after work. Diagnosis and management?", a: "<b>Diagnosis</b>: UV keratitis (photokeratitis/welding flash burn).<br>Classic: <b>delayed onset 6–12 hours</b>, bilateral, severe pain.<br><b>Exam</b>: bilateral punctate epithelial erosions with fluorescein staining.<br><b>Management</b>: topical antibiotics, cycloplegic, oral analgesics, reassurance (self-resolving in 24–48 hours)." },
{ q: "What is the typical history that differentiates traumatic from spontaneous subconjunctival hemorrhage?", a: "<b>Traumatic</b>: direct blow or open globe injury → check for open globe signs, especially if 360° or posterior limit not visible.<br><b>Spontaneous</b>: occurs after Valsalva (coughing, sneezing, straining), or with anticoagulant use/HTN.<br>• Spontaneous is usually <b>sectoral, painless, and benign</b>.<br>• If recurrent spontaneous → check <b>BP and coagulation</b>." },
{ q: "Why is timolol preferred for IOP control in hyphema?", a: "<b>Topical timolol</b> (beta-blocker):<br>• Reduces aqueous humor production<br>• Does <b>not affect pupil size</b> (important — don't disturb the clot)<br>• <b>Safe in sickle cell patients</b> (unlike acetazolamide and epinephrine)<br>• Effective IOP reduction without increasing bleeding risk" },
{ q: "What is iridodialysis?", a: "<b>Iridodialysis</b> = <b>detachment of the iris root from the ciliary body</b> at its insertion point, caused by blunt trauma.<br>• Creates a <b>D-shaped pupil</b><br>• May cause <b>monocular diplopia and glare</b><br>• Often associated with hyphema<br>• Can be repaired surgically if symptomatic" },
{ q: "What is cyclodialysis and its significance?", a: "<b>Cyclodialysis</b> = <b>separation of the ciliary body from the scleral spur</b>, creating a direct communication between the anterior chamber and suprachoroidal space.<br>• Results in <b>hypotony</b> (low IOP) — aqueous drains into suprachoroidal space<br>• Seen on gonioscopy as a <b>cyclodialysis cleft</b><br>• May require surgical repair (laser, cryotherapy, or direct suture)" },
{ q: "What are the complications of untreated angle recession?", a: "The primary complication is <b>angle recession glaucoma</b>:<br>• Damaged trabecular meshwork → <b>reduced aqueous outflow</b><br>• <b>Open-angle glaucoma</b> mechanism<br>• May not manifest for <b>months to years</b><br>• Risk correlates with <b>extent of recession</b> (> 180° = higher risk)<br>• Requires <b>lifelong IOP monitoring</b>" },
{ q: "What percentage of angle recession is associated with higher risk of glaucoma?", a: "Angle recession involving <b>> 180° (> 6 clock hours)</b> of the angle is associated with significantly higher risk of developing glaucoma.<br>However, ANY degree of angle recession warrants <b>lifelong monitoring</b>." },
{ q: "A patient presents with monocular diplopia after blunt eye trauma. What should you suspect?", a: "Suspect <b>lens subluxation</b> — partial displacement of the lens from its normal position.<br>• The lens edge bisects the pupil → light passes through both phakic and aphakic zones → <b>monocular diplopia</b><br>• Look for: <b>iridodonesis</b>, <b>phacodonesis</b>, <b>unequal AC depth</b><br>• Also consider: corneal irregularity, iris damage" },
{ q: "What systemic condition is associated with spontaneous lens subluxation (non-traumatic)?", a: "Key associations:<br>• <b>Marfan syndrome</b> (superotemporal subluxation — most common cause)<br>• <b>Homocystinuria</b> (inferonasal subluxation)<br>• <b>Ehlers-Danlos syndrome</b><br>• <b>Weill-Marchesani syndrome</b> (microspherophakia)<br>If lens subluxation is found without trauma → evaluate for these conditions." },
{ q: "What is the role of CT in IOFB evaluation?", a: "<b>CT orbit (non-contrast, thin cuts)</b> is the imaging study of choice for IOFB:<br>• Detects <b>metallic, glass, and stone</b> foreign bodies with high sensitivity<br>• Localizes FB relative to the globe and orbit<br>• Rules out associated fractures<br>• <b>Wood and organic matter</b> may be poorly visualized on CT (may appear similar to air or be iso-dense with soft tissue)<br>• <b>MRI contraindicated if metallic FB suspected</b>" },
{ q: "What is the recommended pH target after chemical eye burn irrigation?", a: "The target pH after irrigation is <b>7.0–7.4</b> (physiologic pH).<br>Check pH with litmus paper in the inferior fornix <b>5–10 minutes after stopping irrigation</b>.<br>If pH has not normalized, <b>resume irrigation</b> and recheck." },
{ q: "What is the mechanism by which citric acid/citrate drops help in chemical burns?", a: "<b>Citric acid (citrate drops)</b>:<br>• Inhibits <b>PMN (polymorphonuclear leukocyte) migration</b> into the cornea<br>• Reduces <b>PMN-mediated collagenolysis</b> (breakdown of corneal collagen by matrix metalloproteinases)<br>• Helps prevent <b>corneal melting and perforation</b><br>• Used as adjunct therapy in the repair phase" },
{ q: "How does amniotic membrane transplant help in severe chemical burns?", a: "<b>Amniotic membrane transplant (AMT)</b>:<br>• Provides a <b>biological scaffold</b> for re-epithelialization<br>• Has <b>anti-inflammatory and anti-scarring</b> properties<br>• Reduces pain<br>• Prevents <b>symblepharon</b> formation<br>• Used in moderate-to-severe burns (Roper-Hall Grade II–IV)" },
{ q: "What is the difference between a penetrating injury with IOFB and a perforating injury?", a: "<b>Penetrating + IOFB</b>: A sharp object enters the eye and <b>leaves a retained foreign body</b> inside the globe (single entry wound + FB inside).<br><b>Perforating</b>: An object enters <b>and exits</b> the eye (two wounds — entry and exit) with <b>no retained FB</b> (it passed through)." },
{ q: "What are the key differences between direct and indirect traumatic optic neuropathy on CT?", a: "<b>Direct TON</b>:<br>• CT may show <b>bone fragment impinging on or lacerating the optic nerve/canal</b><br>• Associated with orbital/facial fractures<br><br><b>Indirect TON</b>:<br>• CT may be <b>normal</b> (no visible fracture through the optic canal)<br>• Damage is from <b>transmitted shear forces</b> (contrecoup)<br>• More common than direct TON" },
{ q: "A patient had penetrating eye injury 3 weeks ago. Now the fellow eye develops pain, photophobia, and blurred vision with mutton-fat KPs. Diagnosis?", a: "<b>Sympathetic ophthalmia</b>.<br>• Penetrating trauma to one eye (exciting eye) → autoimmune reaction → <b>bilateral granulomatous panuveitis</b><br>• Fellow eye (sympathizing eye) shows mutton-fat KPs, cells/flare, possible Dalen-Fuchs nodules<br>• Urgent treatment: <b>high-dose systemic steroids + immunosuppression</b>" },
{ q: "What is the most common mechanism of orbital floor fracture in adults?", a: "The <b>hydraulic mechanism</b>: a blunt object (fist, ball) larger than the orbital opening strikes the orbit → <b>sudden increase in intraorbital hydraulic pressure</b> → the weakest wall (floor) fractures outward into the maxillary sinus.<br>An alternative is the <b>buckling mechanism</b>: direct force to the inferior orbital rim transmits to the thin floor." },
{ q: "What instruction should patients with orbital fractures receive regarding nose blowing?", a: "Patients should be strictly instructed to <b>avoid blowing their nose</b> for at least <b>2 weeks</b>.<br>Nose blowing can force <b>air from the sinuses through the fracture into the orbit</b>, causing:<br>• <b>Orbital emphysema</b> (worsening proptosis)<br>• Potential <b>orbital compartment syndrome</b><br>• Increased risk of <b>orbital cellulitis</b> (sinus organisms entering orbit)" },
{ q: "What are the indications for emergent (vs delayed) surgical repair of orbital fractures?", a: "<b>Emergent repair</b> (within hours):<br>• <b>White-eyed blowout in children</b> (muscle entrapment with oculocardiac reflex)<br>• <b>Muscle entrapment</b> with restriction and oculocardiac reflex<br><br><b>Delayed repair</b> (1–2 weeks):<br>• Persistent diplopia in primary gaze after swelling resolves<br>• Enophthalmos > 2 mm<br>• Large floor defect > 50%<br>Most fractures are observed initially as many symptoms resolve with edema." },
{ q: "What medication is given prophylactically to prevent posterior synechiae in traumatic iritis and hyphema?", a: "<b>Topical cycloplegic/mydriatic</b> (e.g., atropine or cyclopentolate).<br>• Dilates the pupil → keeps the iris <b>away from the lens</b><br>• Prevents <b>posterior synechiae</b> (adhesion of iris to anterior lens capsule)<br>• Also provides pain relief by <b>relaxing the ciliary muscle</b> (reduces spasm)" },
{ q: "How does the management of hyphema differ between an adult with no comorbidities and a sickle cell patient?", a: "<b>Standard adult</b>:<br>• Shield, head elevation, atropine, topical steroid, timolol, avoid NSAIDs, daily IOP checks<br>• Acetazolamide can be used for elevated IOP<br><br><b>Sickle cell patient</b>:<br>• Same general measures BUT:<br>• <b>NO acetazolamide</b> (worsens AC sickling)<br>• <b>NO epinephrine</b> (vasoconstriction)<br>• <b>Lower threshold for surgical AC washout</b> (IOP > 24 mmHg for > 24h)" },
{ q: "What is the significance of a positive forced duction test in orbital fracture?", a: "A <b>positive forced duction test</b> = the eye <b>cannot be passively moved</b> in the restricted direction, confirming <b>mechanical entrapment</b> of tissue/muscle.<br>This is distinguished from <b>paresis</b> (negative forced duction — eye moves passively but not actively).<br>Note: <b>Do NOT perform if open globe is suspected.</b>" },
{ q: "What grading of hyphema has the highest risk of corneal blood staining?", a: "<b>Grade IV (total/8-ball hyphema)</b> has the highest risk of corneal blood staining because:<br>• <b>Maximum blood contact with corneal endothelium</b><br>• Often associated with <b>elevated IOP</b><br>• Prolonged contact + elevated IOP drives hemoglobin into stroma" },
{ q: "What is the typical timeline for development of disc pallor after traumatic optic neuropathy?", a: "<b>Optic disc pallor</b> (optic atrophy) develops approximately <b>4–6 weeks</b> after the injury.<br>The fundus may appear <b>completely normal initially</b> despite severe vision loss — this is a key diagnostic challenge.<br>An <b>APD</b> is the critical early sign." },
{ q: "What organisms should be covered by prophylactic antibiotics in open globe IOFB injury?", a: "Must cover:<br>• <b>Gram-positive</b> organisms (most common): <i>Staphylococcus</i>, <i>Streptococcus</i>, <b><i>Bacillus</i></b> → <b>vancomycin</b><br>• <b>Gram-negative</b> organisms: <i>Pseudomonas</i>, <i>Enterobacteriaceae</i> → <b>ceftazidime or fluoroquinolone</b><br>IOFB injuries carry a <b>higher endophthalmitis risk</b> (up to 7–13%) than simple lacerations." },
{ q: "Alkali burns are most commonly caused by which household/industrial agents?", a: "Most common alkali agents:<br>1. <b>Ammonia (NH₃)</b> — cleaning products, fertilizers (penetrates rapidly)<br>2. <b>Sodium hydroxide (NaOH/lye)</b> — drain cleaners, oven cleaners<br>3. <b>Calcium hydroxide (Ca(OH)₂/lime)</b> — cement, plaster, whitewash<br>4. <b>Potassium hydroxide (KOH)</b> — some cleaning agents<br>Ammonia penetrates the fastest; lime particles can lodge in fornices." },
{ q: "Why must lime particles be manually removed from the conjunctival fornices after exposure?", a: "<b>Lime (calcium hydroxide)</b> particles can lodge in the conjunctival fornices and <b>continue to release alkali</b> even during irrigation, acting as a <b>reservoir of ongoing chemical injury</b>.<br>Must <b>evert the eyelids and sweep the fornices</b> to remove all particulate matter before irrigation will be effective." },
{ q: "How do you differentiate traumatic mydriasis from pharmacologic dilation?", a: "<b>Traumatic mydriasis</b>:<br>• History of blunt trauma<br>• <b>Irregular pupil</b> (visible sphincter tears on slit-lamp)<br>• May have associated hyphema, iritis, angle recession<br>• Pupil does <b>not constrict</b> with pilocarpine (mechanical sphincter damage)<br><br><b>Pharmacologic dilation</b>:<br>• <b>Round, fully dilated pupil</b><br>• Does not constrict with pilocarpine (if anticholinergic agent)<br>• No trauma signs" },
{ q: "What is the significance of hypotony in the setting of ocular trauma?", a: "<b>Hypotony</b> (IOP < 5 mmHg) in trauma suggests:<br>1. <b>Open globe injury</b> — aqueous leaking through wound (most important to rule out)<br>2. <b>Cyclodialysis cleft</b> — aqueous draining into suprachoroidal space<br>3. <b>Ciliary body shutdown</b> (traumatic ciliary body inflammation reducing aqueous production)<br>Must rule out open globe before attributing to other causes." },
{ q: "What is the role of B-scan ultrasonography in ocular trauma?", a: "<b>B-scan ultrasonography</b> is used when the <b>posterior segment cannot be visualized</b> (e.g., dense vitreous hemorrhage, cataract, hyphema).<br>Can identify:<br>• <b>Retinal detachment</b><br>• <b>Vitreous hemorrhage</b><br>• <b>IOFB</b><br>• <b>Choroidal detachment</b><br><b>Caution</b>: avoid excessive pressure on the globe if open globe is suspected — use very light contact or immersion technique." },
{ q: "A construction worker is hit in the eye with a nail gun. What type of open globe injury classification applies?", a: "This is an <b>open globe laceration</b>.<br>Subtype depends on whether:<br>• Nail enters but does not exit → <b>IOFB</b> (if nail remains inside) or <b>penetrating</b> (if removed)<br>• Nail enters and exits → <b>perforating</b> injury<br>Management: shield, NPO, CT orbit, IV antibiotics, emergent surgical repair." },
{ q: "What finding on gonioscopy differentiates angle recession from a normal wide angle?", a: "<b>Asymmetry between the two eyes</b> is the key differentiator.<br>In angle recession:<br>• The <b>ciliary body band is abnormally widened</b> in the injured eye compared to the fellow eye<br>• The <b>iris insertion is more posterior</b><br>• A <b>torn iris process</b> may be seen<br>Normal wide angles (e.g., in myopes) are <b>symmetric bilaterally</b>." },
{ q: "What is the standard initial management sequence for any patient with ocular trauma?", a: "1. <b>Visual acuity</b> (document FIRST — most important prognostic indicator)<br>2. <b>Pupil exam</b> (check for APD)<br>3. <b>External exam</b> (lids, adnexa, orbit)<br>4. If open globe suspected → <b>STOP exam</b>, apply rigid shield<br>5. <b>CT orbit</b> (if FB or fracture suspected)<br>6. <b>Slit-lamp exam</b> (if globe integrity confirmed)<br>7. <b>Dilated fundus exam</b> (if safe)<br>8. <b>IOP measurement</b> (only if globe integrity confirmed)" },
{ q: "What complications can arise from a retained organic IOFB (e.g., wood)?", a: "<b>Organic IOFBs</b> (wood, vegetable matter) carry high risk of:<br>• <b>Endophthalmitis</b> (especially fungal — <i>Aspergillus</i>, <i>Fusarium</i>)<br>• <b>Abscess formation</b><br>• <b>Intense inflammatory reaction</b><br>• Difficult to visualize on CT (may be iso-dense with soft tissue)<br>• <b>MRI may be helpful</b> for non-metallic organic material (only if metallic FB excluded first)" },
{ q: "What is the difference between an exciting eye and a sympathizing eye?", a: "<b>Exciting eye</b> = the eye that sustained the <b>original penetrating trauma</b> or surgery (the injured eye).<br><b>Sympathizing eye</b> = the <b>fellow (uninvolved) eye</b> that develops sympathetic ophthalmia.<br>The autoimmune reaction targets <b>uveal antigens</b> exposed by the original injury." },
{ q: "What are Koeppe and Busacca nodules?", a: "<b>Koeppe nodules</b> = small nodules at the <b>pupillary margin</b> of the iris.<br><b>Busacca nodules</b> = nodules on the <b>iris stroma</b> (surface of the iris, away from the pupil margin).<br>Both are found in <b>granulomatous uveitis</b> (e.g., sympathetic ophthalmia, sarcoidosis, TB, VKH)." },
{ q: "What are the components of a dilated fundus exam that are important after blunt trauma?", a: "After blunt trauma, look for:<br>1. <b>Commotio retinae</b> (Berlin edema — retinal whitening)<br>2. <b>Choroidal rupture</b> (crescent-shaped streak)<br>3. <b>Retinal dialysis/tears</b> (especially inferotemporal)<br>4. <b>Vitreous hemorrhage</b><br>5. <b>Retinal detachment</b><br>6. <b>Optic nerve pallor</b> (if chronic)<br>7. <b>Macular hole</b> (traumatic)<br>8. <b>Subretinal hemorrhage</b>" },
{ q: "What type of uveitis does sympathetic ophthalmia cause?", a: "<b>Bilateral diffuse granulomatous panuveitis</b>.<br>• <b>Pan</b> = involves all layers (anterior, intermediate, and posterior uvea)<br>• <b>Granulomatous</b> = mutton-fat KPs, iris nodules, Dalen-Fuchs nodules<br>• Involves <b>both eyes</b> (exciting and sympathizing)" },
{ q: "Name three conditions that can mimic sympathetic ophthalmia.", a: "Conditions that can present similarly:<br>1. <b>Vogt-Koyanagi-Harada (VKH) syndrome</b> — bilateral granulomatous panuveitis, but NO history of penetrating trauma<br>2. <b>Sarcoidosis</b> — bilateral granulomatous uveitis, systemic findings<br>3. <b>Phacoantigenic (lens-induced) uveitis</b> — granulomatous reaction to lens material, typically unilateral" },
{ q: "What factors increase the risk of endophthalmitis after open globe injury?", a: "Risk factors for post-traumatic endophthalmitis:<br>1. <b>Retained IOFB</b> (highest risk factor)<br>2. <b>Delay in surgical repair</b> (> 24 hours)<br>3. <b>Rural/agricultural setting</b> (organic contamination)<br>4. <b>Lens capsule disruption</b><br>5. <b>Posterior wound location</b><br>6. <b>Dirty/contaminated injury</b><br>Prophylactic IV antibiotics significantly reduce this risk." },
{ q: "What is a traumatic macular hole and how does it present?", a: "A <b>traumatic macular hole</b> is a full-thickness defect in the fovea from blunt trauma.<br>• Presents with <b>central scotoma</b> and decreased central visual acuity<br>• Fundoscopy: round, well-defined hole in the macula<br>• <b>OCT</b> confirms full-thickness defect<br>• Some may close spontaneously; others require <b>vitrectomy with gas tamponade</b>" },
{ q: "What class of medication should be avoided in ALL hyphema patients (regardless of sickle cell status)?", a: "<b>Aspirin and NSAIDs</b> must be avoided in ALL hyphema patients because:<br>• They inhibit <b>platelet aggregation</b><br>• Increase the risk of <b>rebleeding</b> (which is most dangerous on days 3–5)<br>• Acetaminophen is the preferred analgesic" },
{ q: "What is the Fox shield?", a: "A <b>Fox shield</b> is a <b>rigid, protective eye shield</b> (metal or clear plastic) that is:<br>• Placed over the orbit (resting on the brow ridge and cheek/maxilla)<br>• Taped (not tied) to the face<br>• Does <b>NOT touch or apply pressure to the globe</b><br>• Used in <b>open globe injuries</b> to prevent further extrusion of intraocular contents<br>It is the standard of care for globe protection in ocular trauma." },
{ q: "What is the prognosis of commotio retinae (Berlin edema)?", a: "<b>Commotio retinae usually resolves spontaneously</b> over weeks.<br>• If <b>peripheral</b> → generally excellent visual prognosis<br>• If involving the <b>macula</b> → may cause permanent RPE changes and photoreceptor damage → <b>reduced central vision</b><br>No specific treatment; observation." },
{ q: "How does choroidal neovascularization (CNVM) relate to traumatic choroidal rupture?", a: "<b>CNVM</b> can develop as a <b>late complication</b> of choroidal rupture, especially if the rupture passes through the macula.<br>• New blood vessels grow from the choroid through Bruch's membrane defect<br>• Can cause <b>subretinal hemorrhage, fluid, and vision loss</b><br>• Treatment: <b>anti-VEGF injections</b> (bevacizumab, ranibizumab)" },
{ q: "What is the appropriate initial irrigation solution for chemical eye burns if normal saline is unavailable?", a: "<b>Any clean water</b> (tap water, bottled water) should be used <b>immediately</b>.<br>The key principle is: <b>do not delay irrigation searching for an ideal solution</b>.<br>Preferred solutions (in order): <b>balanced salt solution > Ringer's lactate > normal saline > tap water</b>.<br>Even <b>tap water</b> is appropriate as the osmotic effect is negligible compared to the chemical damage." },
{ q: "What is the relationship between the extent of limbal ischemia and prognosis in chemical burns?", a: "Greater limbal ischemia → <b>worse prognosis</b>:<br>• Limbal ischemia reflects <b>destruction of limbal blood supply and stem cells</b><br>• < 1/3 limbal ischemia (Grade II) → good prognosis<br>• 1/3–1/2 (Grade III) → guarded<br>• > 1/2 (Grade IV) → <b>poor prognosis</b> (likely to need stem cell transplant and corneal transplant)" },
          ]
        },
{
          section: 'Ethics, Law & Health Systems',
          topic: "Medical ethics — autonomy, beneficence, justice",
          icon: "scale",
          cards: [
            { q: "What is the ethical principle of <b>autonomy</b>?", a: "The obligation to respect a competent patient's right to <b>self-determination</b> and allow them to make decisions about their own medical care based on their values and beliefs." },
{ q: "What is the ethical principle of <b>beneficence</b>?", a: "The duty of the physician to act in the <b>best interest of the patient</b>, taking active steps to promote their health, well-being, and recovery." },
{ q: "What is the ethical principle of <b>non-maleficence</b>?", a: "The fundamental obligation to <b>do no harm</b> (<i>primum non nocere</i>), requiring that the risks of any medical intervention must be outweighed by its benefits." },
{ q: "What is the ethical principle of <b>justice</b> in healthcare?", a: "The requirement to treat patients fairly, distribute medical resources <b>equitably</b>, and resolve conflicts based on clinical need rather than social status or ability to pay." },
{ q: "How do autonomy and beneficence conflict when a competent adult refuses a life-saving blood transfusion?", a: "The patient's <b>autonomy</b> overrides the physician's duty of beneficence, meaning the refusal must be respected, even if it leads to death." },
{ q: "What is <b>paternalism</b> in medicine?", a: "The practice of overriding a patient's preferences or making decisions for them under the justification that it is for the patient's <b>own good</b> (largely rejected in modern ethics in favor of shared decision-making)." },
{ q: "What is <b>weak paternalism</b> and when is it ethically permissible?", a: "Intervening to make decisions for a patient whose decision-making capacity is <b>temporarily impaired or absent</b> (e.g., administering life-saving care to an unconscious suicide attempt patient)." },
{ q: "What is <b>strong paternalism</b> and is it ethically acceptable?", a: "Overriding the choices of a patient who has <b>full decision-making capacity</b> because the physician believes those choices are harmful (strictly unethical and illegal)." },
{ q: "What is the ethical principle of <b>utility</b> in public health and disaster triage?", a: "The utilitarian principle that decisions should aim to produce the <b>greatest benefit for the greatest number</b> of people when resources are scarce." },
{ q: "What is the difference between <b>distributive justice</b> and <b>social justice</b> in healthcare?", a: "<b>Distributive justice</b> concerns the fair allocation of scarce resources (e.g., ICU beds); <b>social justice</b> focuses on eliminating systemic inequities and ensuring fair access to healthcare for marginalized groups." },
{ q: "What is the difference between <b>equality</b> and <b>equity</b> in healthcare justice?", a: "<b>Equality</b> means giving every individual the exact same resources; <b>equity</b> means distributing resources based on individual needs to achieve equal health outcomes." },
{ q: "In the allocation of scarce medical resources (e.g., ventilators during a pandemic), which factors are ethically <b>permissible</b> to consider?", a: "Objective medical criteria including <b>clinical prognosis</b>, likelihood of survival to discharge, and short-term life expectancy." },
{ q: "In the allocation of scarce medical resources, which factors are ethically <b>impermissible</b> to consider?", a: "Socioeconomic status, wealth, perceived social worth, gender, race, political power, or ability to pay." },
{ q: "Is it ethically permissible to prioritize a patient for a scarce organ transplant because they are a prominent politician or wealthy donor?", a: "<b>No</b>. Under the principle of justice, organ allocation must be based on objective medical criteria (e.g., urgency, tissue compatibility, time on waitlist) and not financial or social status." },
{ q: "What is the primary ethical concern when using a <b>placebo</b> in a clinical trial when an effective standard treatment already exists?", a: "It violates <b>beneficence</b> by denying the control group an active, proven treatment, exposing them to unnecessary risk. Active control trials are preferred." },
{ q: "How does a patient's 'right to refuse' treatment differ from their 'right to demand' treatment?", a: "Autonomy gives patients the absolute right to <b>refuse</b> any treatment, but does not give them the right to <b>demand</b> non-indicated, futile, or harmful treatments." },
{ q: "When a competent patient refuses a highly recommended life-saving treatment, what is the physician's first clinical step?", a: "Assess the patient's <b>understanding</b> of the risks/benefits of refusal, explore the reasons for their decision, and ensure they have full decision-making capacity." },
{ q: "Under what public health conditions can a patient's individual autonomy be legally overridden?", a: "When the patient has a highly contagious, dangerous disease (e.g., active tuberculosis) and refuses isolation/treatment, threatening the safety of the public." },
{ q: "What is the legal definition of <b>medical battery</b>?", a: "Performing a medical procedure or physical contact without obtaining the patient's <b>informed consent</b> (even if the procedure was performed perfectly and caused no harm)." },
{ q: "What are the three essential components of a valid <b>informed consent</b>?", a: "1. <b>Information disclosure</b> (risks, benefits, alternatives)<br>2. <b>Decision-making capacity</b><br>3. <b>Voluntariness</b> (absence of coercion)." },
{ q: "What is the <b>reasonable person standard</b> of information disclosure in informed consent?", a: "The requirement that the physician disclose all information that a <b>reasonable patient</b> would want to know to make a well-informed decision." },
{ q: "Can a patient legally consent to a surgery while explicitly refusing to hear the risks or alternatives?", a: "<b>Yes</b>. A patient has the autonomous right to waive their right to information (<b>informed consent waiver</b>) and delegate the decision to the physician or a proxy." },
{ q: "What is <b>therapeutic privilege</b>?", a: "The extremely rare legal exception allowing a physician to withhold information from a patient if disclosing it would cause <b>immediate, severe psychological collapse</b> or physical self-harm." },
{ q: "Is therapeutic privilege justified if the physician believes the patient will refuse a necessary treatment if told the risks?", a: "<b>No</b>. Withholding information simply to manipulate a patient into consenting violates autonomy and is unethical." },
{ q: "What is the ethical and legal justification for treating an incapacitated patient in an emergency without prior consent?", a: "<b>Implied consent</b>. In life-threatening emergencies, consent is assumed because a reasonable person would want life-saving medical intervention." },
{ q: "What is the clinical difference between <b>decision-making capacity</b> and <b>competence</b>?", a: "<b>Capacity</b> is a clinical determination made by a physician for a specific decision at a specific time; <b>competence</b> is a global legal status determined only by a judge." },
{ q: "What four clinical criteria must a physician assess to determine if a patient has <b>decision-making capacity</b>?", a: "The patient must be able to:<br>1. <b>Communicate a clear, consistent choice</b><br>2. <b>Understand</b> the medical facts<br>3. <b>Appreciate</b> the consequences of the decision<br>4. <b>Reason</b> through the options." },
{ q: "Does a patient's diagnosis of a psychiatric illness (e.g., schizophrenia or depression) automatically mean they lack decision-making capacity?", a: "<b>No</b>. A patient with psychiatric illness may still have the capacity to make specific medical decisions if they meet the four capacity criteria during the assessment." },
{ q: "What is the ethical basis for the duty of <b>patient confidentiality</b>?", a: "It respects patient <b>autonomy</b> (privacy) and builds <b>trust</b>, encouraging patients to disclose honest information necessary for safe and effective care." },
{ q: "What is the primary purpose of the Health Insurance Portability and Accountability Act (<b>HIPAA</b>) Security Rule?", a: "To establish national standards to protect electronic protected health information (<b>ePHI</b>) from unauthorized access, loss, or disclosure." },
{ q: "What constitutes Protected Health Information (<b>PHI</b>) under HIPAA?", a: "Any individually identifiable health information (name, DOB, SSN, diagnosis, billing) created, used, or disclosed by a covered entity." },
{ q: "What should a physician do if they overhear colleagues discussing a patient's case in a public hospital elevator?", a: "Politely interrupt and remind them that discussing patients in public areas is a breach of <b>confidentiality and a HIPAA violation</b>." },
{ q: "What is a physician's reporting obligation when they suspect <b>child abuse or neglect</b>?", a: "They are legally mandated to report it immediately to Child Protective Services (CPS) upon developing a <b>reasonable suspicion</b>; no absolute proof is required." },
{ q: "If a parent begs a physician not to report suspected child abuse because it was a one-time mistake, what should the physician do?", a: "Explain that reporting is a <b>mandatory legal obligation</b> that cannot be waived, and file the report immediately." },
{ q: "Are physicians legally mandated to report suspected abuse or neglect of <b>vulnerable adults</b> (elderly or disabled)?", a: "<b>Yes</b>. In almost all jurisdictions, physicians are mandated reporters and must file a report with Adult Protective Services (APS) if abuse, neglect, or exploitation is suspected." },
{ q: "Under what circumstances must a physician report a physical injury to law enforcement without patient consent?", a: "When the injury is caused by a <b>gunshot wound, stab wound, or criminal act</b>, as mandated by state public safety laws." },
{ q: "What is the physician's duty regarding <b>reportable infectious diseases</b> (e.g., tuberculosis, syphilis, measles, meningococcal meningitis)?", a: "Physicians must report these diagnoses to the local or state <b>public health department</b> to protect the community." },
{ q: "Does reporting a mandatory infectious disease to public health authorities violate HIPAA?", a: "<b>No</b>. HIPAA specifically permits disclosures of PHI without authorization for <b>public health activities</b> authorized by law." },
{ q: "What was the significance of the landmark 1976 legal case <b>Tarasoff v. Regents of the University of California</b>?", a: "It established that mental health professionals (and by extension, physicians) have a <b>duty to protect/warn</b> third parties who are threatened with imminent harm by a patient." },
{ q: "What two conditions must be met to trigger the Tarasoff <b>duty to protect or warn</b>?", a: "1. The patient must express a <b>credible, imminent threat</b> of serious physical violence.<br>2. The threat must be directed at a <b>specifically identifiable person or group</b>." },
{ q: "Does the duty to warn apply if a patient expresses vague, generalized statements about wanting to hurt 'someone'?", a: "<b>No</b>. The threat must be specific and directed at an <b>identifiable victim</b>. Vague threats may justify involuntary psychiatric evaluation, but not warning the public at large." },
{ q: "If a patient with active tuberculosis refuses to isolate themselves and plans to return to a crowded office, what should the physician do?", a: "Notify the <b>public health department</b> immediately. Public health officers have the legal authority to enforce involuntary quarantine." },
{ q: "What should a physician do if a patient diagnosed with a sexually transmitted infection (e.g., HIV or syphilis) refuses to notify their spouse?", a: "Counsel the patient first. If they still refuse, the physician must notify the <b>public health department</b>, and depending on state law, may have a duty to warn the spouse directly." },
{ q: "Can a physician leave details of a patient's positive cancer biopsy on their home answering machine or voicemail?", a: "<b>No</b>. To protect confidentiality, voicemail messages should contain only the <b>minimal necessary information</b> (e.g., name, request to call back) and no clinical details." },
{ q: "An employer calls asking for the medical records of an employee who is your patient. Under what condition can you release this information?", a: "Only if the patient has signed a <b>specific, written authorization</b> permitting the release of those records to the employer." },
{ q: "When can a physician disclose a patient's medical information to their spouse or family members?", a: "Only if the patient gives <b>explicit consent</b>, or if the patient is incapacitated and the physician determines disclosure is in the patient's best interest and there is no reason to believe they would object." },
{ q: "If a patient's parents pay for their adult child's medical insurance, do they have a right to access the patient's medical records?", a: "<b>No</b>. The duty of confidentiality is owed solely to the patient. Payment of the bill does not grant access to private medical records without the patient's consent." },
{ q: "What is the purpose of the <b>Genetic Information Nondiscrimination Act (GINA)</b>?", a: "To prohibit health insurers and employers from using <b>genetic information</b> (such as genetic test results or family history) to deny coverage, adjust premiums, or make hiring decisions." },
{ q: "If genetic testing reveals a patient has a mutation for a severe hereditary disease (e.g., BRCA1), can the physician notify the patient's siblings directly?", a: "<b>No</b>. The physician is bound by confidentiality and cannot contact the siblings without the patient's <b>explicit consent</b>, even if it is in the siblings' clinical interest." },
{ q: "What is the general rule regarding adolescent confidentiality in healthcare?", a: "Minors have a right to confidential care for specific sensitive issues, including <b>contraception, STDs, pregnancy care, substance abuse, and mental health</b>, without parental consent or notification." },
{ q: "Under what conditions must a physician breach an adolescent patient's confidentiality?", a: "When there is an imminent risk of <b>self-harm, suicide, homicide, or severe abuse/neglect</b>, the physician must breach confidentiality to protect the minor." },
{ q: "If a 16-year-old patient requests a confidential pregnancy test, how should billing be handled to prevent parental disclosure?", a: "The clinic must coordinate alternative billing (e.g., sliding scale, confidential state funding) to prevent an insurance statement (Explanation of Benefits) from going to the parents." },
{ q: "Can a hospital employee view the electronic medical records of a celebrity patient admitted to their facility out of curiosity?", a: "<b>No</b>. This is a severe HIPAA violation. Accessing any patient record without a clinical <b>'need to know'</b> for direct patient care is strictly prohibited." },
{ q: "If police officers request a blood sample from a suspected drunk driver who refuses, what must the physician do?", a: "Refuse to draw blood unless the officers present a <b>warrant, subpoena, or court order</b>, or if the patient consents, subject to local state-specific implied consent laws." },
{ q: "Can a physician post a detailed case description on social media if they omit the patient's name?", a: "Only if the case is modified so heavily that the patient <b>cannot be identified</b>. Because rare clinical details can act as identifiers, posting case details online is highly discouraged." },
{ q: "What is the <b>'minimum necessary'</b> standard under HIPAA?", a: "The requirement that covered entities limit the use and disclosure of PHI to the <b>minimum amount necessary</b> to accomplish the intended medical or administrative task." },
{ q: "Is it a breach of confidentiality to discuss a patient's medical history with a consulting specialist?", a: "<b>No</b>. Under HIPAA, disclosures of PHI for <b>treatment, payment, or healthcare operations (TPO)</b> do not require explicit patient authorization." },
{ q: "What is the correct action if you discover a coworker is accessing patient files of people who are not their patients?", a: "Report the coworker immediately to the hospital's <b>privacy officer</b> or compliance department to investigate the security breach." },
{ q: "What is the definition of a <b>surrogate decision-maker</b>?", a: "An individual who is legally authorized or designated to make medical decisions on behalf of a patient who lacks <b>decision-making capacity</b>." },
{ q: "What is the <b>substituted judgment standard</b> in surrogate decision-making?", a: "The requirement that the surrogate make decisions based on what the <b>patient would have wanted</b>, using the patient's known values, beliefs, and past statements." },
{ q: "What is the <b>best interest standard</b> in surrogate decision-making?", a: "The requirement that the surrogate make decisions that maximize the <b>clinical benefit and minimize harm</b> for the patient when the patient's own wishes are completely unknown." },
{ q: "Under what circumstances does the best interest standard apply instead of the substituted judgment standard?", a: "When the patient's wishes are entirely unknown, or when the patient has <b>never had capacity</b> (e.g., severe intellectual disability from birth)." },
{ q: "Who is the highest priority surrogate decision-maker for an incapacitated patient?", a: "A legally designated <b>Healthcare Proxy / Durable Power of Attorney for Healthcare (DPOAH)</b>." },
{ q: "If a patient has a designated healthcare proxy and a spouse, who has the final authority to make medical decisions?", a: "The <b>healthcare proxy</b>, as they were explicitly chosen by the patient to represent their autonomous wishes." },
{ q: "What is the default hierarchy of surrogate decision-makers if no proxy has been designated?", a: "Spouse $\\\\rightarrow$ Adult children $\\\\rightarrow$ Parents $\\\\rightarrow$ Adult siblings." },
{ q: "What should a physician do if a patient's surrogate decision-maker makes a choice that is clearly contrary to the patient's written living will?", a: "Refuse the surrogate's demand, remind them of the <b>substituted judgment standard</b>, and consult the hospital <b>ethics committee</b> if they persist." },
{ q: "If a surrogate decision-maker refuses a life-saving treatment for a patient because of a clear conflict of interest (e.g., financial inheritance), what should the physician do?", a: "Challenge the surrogate's decision, seek an immediate <b>ethics committee consultation</b>, and if necessary, request a <b>court-appointed guardian</b> to replace the surrogate." },
{ q: "What is the ethical standard for parental decision-making in pediatric patients?", a: "Parents are expected to act in the <b>best interest of the child</b>, as children are not considered competent to make their own medical decisions." },
{ q: "Can parents refuse life-saving medical treatment (e.g., a blood transfusion) for their minor child based on their religious beliefs?", a: "<b>No</b>. The state's interest in protecting the child's life overrides parental authority; the physician must seek a <b>court order</b> or administer treatment immediately in an emergency." },
{ q: "In a non-emergency situation where parents refuse standard treatment for a child and it is not immediately life-threatening but will cause severe harm, what is the next step?", a: "Contact <b>Child Protective Services (CPS)</b> or seek a court order to authorize the necessary treatment." },
{ q: "What is the <b>mature minor doctrine</b>?", a: "A legal principle allowing older adolescents (typically $\\\\ge 15$ years old) who demonstrate sufficient maturity to make their own medical decisions without parental consent." },
{ q: "What criteria qualify a minor to be considered <b>emancipated</b> (giving them full adult medical decision-making rights)?", a: "Being married, serving in the military, being self-supporting and living independently, or being a parent themselves (varies by state)." },
{ q: "What is the difference between <b>consent</b> and <b>assent</b> in pediatric medicine?", a: "<b>Consent</b> is the legal permission given by a parent or guardian; <b>assent</b> is the child's active agreement to the treatment, which should be sought when developmentally appropriate." },
{ q: "If an incapacitated patient has no family, no friends, and no advance directive, how are medical decisions made?", a: "The physician must consult the <b>ethics committee</b> to make decisions, or seek a <b>court-appointed guardian</b> for non-emergent major decisions." },
{ q: "Can a surrogate decision-maker delegate their authority to another family member?", a: "<b>Yes</b>. A surrogate can voluntarily delegate the decision-making role to someone else who they believe is better suited or closer to the patient." },
{ q: "If adult siblings disagree on whether to withdraw life support for their incapacitated parent, what is the physician's first step?", a: "Convene a <b>family meeting</b> with all key decision-makers to clarify the clinical status, align goals, and facilitate consensus." },
{ q: "If a family meeting fails to resolve a dispute among surrogates regarding end-of-life care, what is the next step?", a: "Consult the hospital's <b>Ethics Committee</b> for mediation and ethical guidance." },
{ q: "If a surrogate wants to withdraw life support but the physician believes the patient has a high chance of a meaningful recovery, what should the physician do?", a: "Refuse to withdraw care immediately, discuss the prognosis in detail, consult the ethics committee, and if unresolved, offer to transfer the patient's care to another physician." },
{ q: "Can a surrogate demand that a physician perform a treatment that is medically futile?", a: "<b>No</b>. A surrogate cannot compel a physician to provide care that does not offer clinical benefit or violates the standard of care." },
{ q: "What should a physician do if a surrogate refuses to make a decision, stating that it is too emotionally painful?", a: "Offer support, involve palliative care or a chaplain, and ask if there is another family member the surrogate would like to delegate the decision-making to." },
{ q: "Does a surrogate's authority end if the patient regains decision-making capacity?", a: "<b>Yes</b>. As soon as the patient regains capacity, their own autonomous choices <b>immediately supersede</b> any surrogate's decisions." },
{ q: "What is the standard for determining if a surrogate is competent to make decisions?", a: "The surrogate must have the same <b>decision-making capacity</b> required of patients: understanding the options, appreciating the consequences, reasoning, and communicating a choice." },
{ q: "Can a patient verbally designate a healthcare proxy during a hospital admission without a written document?", a: "<b>Yes</b>. A patient can verbally appoint a surrogate in the presence of the medical team, which must be clearly documented in the medical record." },
{ q: "What is the standard of proof required to honor a patient's prior oral (spoken) wishes regarding end-of-life care?", a: "The <b>'clear and convincing evidence'</b> standard, requiring that the statements were specific, repeated, and made when the patient had full capacity." },
{ q: "If a surrogate has no written instructions from the patient but knows the patient's values, how should they apply the substituted judgment standard?", a: "They must make the decision that aligns with the patient's <b>known moral framework, life goals, and religious beliefs</b>." },
{ q: "What is the general rule regarding accepting gifts from patients?", a: "Small, inexpensive, or handmade gifts are generally acceptable as tokens of appreciation; large, expensive, or monetary gifts must be politely declined as they alter the therapeutic relationship." },
{ q: "What factors should a physician consider when deciding whether to accept a gift from a patient?", a: "The value of the gift, the patient's motivation (e.g., trying to secure special treatment), the timing (e.g., during active treatment vs. holidays), and the potential impact on the professional relationship." },
{ q: "Are financial loans or investments between a physician and a patient ethically permissible?", a: "<b>No</b>. Engaging in financial transactions with patients creates a conflict of interest, exploits the power imbalance, and violates professional boundaries." },
{ q: "What is the ethical guideline regarding accepting gifts or meals from pharmaceutical or medical device companies?", a: "Physicians should decline any personal gifts, trips, or expensive meals; only modest meals associated with educational presentations or low-value educational materials are acceptable." },
{ q: "Can a physician accept payment from a pharmaceutical company to attend a medical conference?", a: "<b>No</b>. Physicians cannot accept direct financial support from industry to attend conferences; they can only accept compensation for active services (e.g., serving as a speaker or consultant) under strict fair-market value rules." },
{ q: "What is the absolute rule regarding sexual or romantic relationships between a physician and a current patient?", a: "Sexual or romantic relationships with current patients are <b>strictly prohibited</b> under all circumstances and constitute severe professional misconduct." },
{ q: "Is a romantic relationship with a <b>former psychiatric patient</b> ever ethically acceptable?", a: "<b>No</b>. Due to the nature of transference and the permanent power imbalance, romantic relationships with former psychiatric patients are <b>always unethical</b>." },
{ q: "Under what conditions might a romantic relationship with a former non-psychiatric patient be considered acceptable?", a: "Only after a significant period of time has passed, the therapeutic relationship has been fully terminated, and there is no exploitation of the patient's vulnerability." },
{ q: "What is the difference between a <b>boundary crossing</b> and a <b>boundary violation</b>?", a: "A <b>boundary crossing</b> is a minor, non-harmful deviation from standard professional behavior (e.g., attending a patient's funeral); a <b>boundary violation</b> is a harmful, exploitative breach of professional limits (e.g., sexual contact)." },
{ q: "What must a physician do to ethically terminate a patient-physician relationship to avoid charges of patient abandonment?", a: "Give the patient <b>written notice</b>, continue to provide emergency care for a reasonable period (typically 30 days) to allow them to find a new provider, and facilitate the transfer of medical records." },
{ q: "What are acceptable reasons for a physician to terminate the patient-physician relationship?", a: "Irreconcilable differences, persistent non-compliance with life-saving treatment, disruptive or abusive behavior, or a breakdown in the therapeutic alliance." },
{ q: "Can a physician terminate a patient-physician relationship because the patient has developed a complex, difficult-to-treat illness?", a: "<b>No</b>. Terminating a relationship solely because of the complexity or severity of the patient's medical condition is unethical and constitutes abandonment." },
{ q: "How should a physician manage a patient who is persistently non-compliant with their medical regimen?", a: "Explore the <b>reasons for non-compliance</b> (e.g., side effects, cost, lack of understanding, cultural beliefs), educate them, and use shared decision-making to adapt the plan." },
{ q: "What should a physician do if a patient becomes verbally abusive or disruptive in the clinic?", a: "Set clear boundaries regarding acceptable behavior, and if safety is threatened or the behavior continues, formally terminate the relationship after ensuring emergency care is covered." },
{ q: "Is it ethically acceptable for a physician to treat close friends or family members?", a: "<b>Strongly discouraged</b> (except in emergencies or minor, routine issues), as the physician's clinical objectivity can be compromised, and boundaries can become blurred." },
{ q: "Is a physician permitted to prescribe controlled substances to themselves or immediate family members?", a: "<b>No</b>. Prescribing controlled substances to oneself or family members is unethical and illegal in most jurisdictions." },
{ q: "What is the purpose of having a chaperone present during sensitive physical examinations (e.g., pelvic, breast, or testicular exams)?", a: "To protect the patient's comfort and dignity, and to protect the physician against false allegations of misconduct." },
{ q: "If a patient refuses a chaperone for a sensitive exam, what should the physician do?", a: "Explain that the chaperone is standard policy for the safety of both parties; if the patient still refuses, the physician may decline to perform the exam and refer the patient to another provider." },
{ q: "Under what circumstances can a physician self-disclose personal information to a patient?", a: "Only when it is <b>clinically therapeutic</b>, brief, does not shift the focus to the physician, and does not violate professional boundaries." },
{ q: "If a patient makes a romantic advance or expresses romantic feelings toward a physician, how should the physician respond?", a: "Immediately clarify the professional boundaries of the relationship, document the interaction, and if the patient persists, terminate the relationship and refer them to another provider." },
{ q: "Can a physician refuse to treat a patient because of the patient's race, religion, sexual orientation, or gender identity?", a: "<b>No</b>. Discriminating against patients based on personal characteristics is a violation of the principle of justice and professional ethics." },
{ q: "What is the ethical status of a physician accepting a referral fee (fee-splitting) for sending a patient to a specialist?", a: "<b>Strictly unethical</b> and illegal (violates anti-kickback laws), as it compromises clinical objectivity and prioritizes financial gain over patient care." },
{ q: "How should a physician handle a patient who demands a specific brand-name drug they saw in an advertisement, but which is not clinically indicated?", a: "Decline the request, explain why the drug is not appropriate for their condition, and discuss evidence-based alternatives." },
{ q: "If a patient seeks a second opinion, how should the primary physician respond?", a: "Support the patient's request, facilitate the referral, and share medical records promptly. A second opinion is a valid exercise of patient autonomy." },
{ q: "If a patient asks a physician for spiritual or religious advice, what is the most appropriate action?", a: "Respect the patient's beliefs, offer to involve a hospital chaplain or spiritual advisor, and maintain focus on the medical aspects of their care." },
{ q: "What is a <b>conflict of interest</b> in medicine?", a: "A set of circumstances where professional judgment concerning a primary interest (patient welfare) tends to be unduly influenced by a secondary interest (e.g., financial gain, academic promotion)." },
{ q: "What are <b>double relationships</b> (or dual relationships) and why are they discouraged?", a: "Situations where a physician has an additional professional, financial, or personal relationship with a patient (e.g., doctor-patient and landlord-tenant), which can compromise objectivity and cause exploitation." },
{ q: "If a family requests that a physician withhold a diagnosis of terminal cancer from a patient, what should the physician do?", a: "Explain that the patient has a right to know their diagnosis; ask the patient how much information they wish to receive, and disclose the diagnosis honestly if the patient wants to know." },
{ q: "Under what circumstances is <b>therapeutic nondisclosure</b> (withholding information from the patient) ethically acceptable?", a: "Only when disclosing the diagnosis poses an immediate, serious threat of severe psychological or physical harm (which is extremely rare)." },
{ q: "A competent adult patient who is a Jehovah's Witness refuses a life-saving blood transfusion. What is the physician's duty?", a: "Respect the refusal, optimize non-blood management (e.g., erythropoietin, cell saver, iron), and document the refusal clearly." },
{ q: "If a patient is unable to communicate, has no surrogate or advance directive, and needs a blood transfusion, can the physician administer blood even if the patient's chart says 'suspected Jehovah's Witness'?", a: "<b>Yes</b>. In an emergency, emergency consent is implied; unless there is clear and convincing evidence (like a signed wallet card) of refusal, the physician must transfuse." },
{ q: "If a physician has a sincere conscientious objection to performing a legal procedure (e.g., abortion or prescribing emergency contraception), what must they do?", a: "Refuse to perform the procedure, but <b>immediately refer</b> the patient to another willing provider to ensure access to care, and provide care if it is a life-threatening emergency." },
{ q: "What is the ethical obligation of a physician who makes a medical error that causes harm to a patient?", a: "Promptly and honestly <b>disclose the error</b> to the patient/family, explain the consequences, apologize, and discuss the plan to mitigate the harm." },
{ q: "If a minor medical error occurs that does not cause any harm or change the treatment plan, is the physician still obligated to disclose it?", a: "<b>Yes</b>. Honesty and truth-telling (veracity) are fundamental to the patient-physician relationship, and disclosing minor errors builds trust." },
{ q: "What is the ethical duty of a physician who suspects a colleague is practicing medicine while impaired by substance abuse or illness?", a: "Report the colleague immediately to the hospital administration, chief of staff, or the state's <b>Physician Health Program (PHP)</b> to protect patient safety." },
{ q: "If a physician suspects a colleague is incompetent or committing Medicare fraud, what is their ethical duty?", a: "Report the colleague to the hospital's compliance department or the state licensing board to uphold professional standards and protect the public." },
{ q: "Are physicians ethically permitted to participate in state-sponsored executions (e.g., administering lethal injections)?", a: "<b>No</b>. Professional ethical codes (such as the AMA's) strictly prohibit physicians from participating in executions, as it contradicts the physician's role as a healer." },
{ q: "What is <b>clinical equipoise</b> and why is it a requirement for ethical clinical trials?", a: "The state of genuine uncertainty in the medical community regarding which of two or more treatments is more effective, ensuring no patient group is knowingly given inferior care." },
{ q: "What is the <b>expanded access</b> (or <b>compassionate use</b>) program?", a: "A pathway that allows patients with immediately life-threatening conditions to access investigational drugs outside of clinical trials when no comparable alternative therapies exist." },
{ q: "Is it ethical to use placebos in clinical practice without the patient's knowledge (e.g., giving a saline injection for pain)?", a: "<b>No</b>. This is deceptive, undermines patient trust, and violates patient autonomy." },
{ q: "What is the Stark Law (Physician Self-Referral Law)?", a: "A federal law prohibiting physicians from referring Medicare patients for designated health services to entities in which the physician has a financial interest." },
{ q: "What is the ethical problem with <b>ghostwriting</b> in medical literature?", a: "It is a form of scientific dishonesty where pharmaceutical companies write studies and pay academic physicians to sign as authors, misleading the medical community about objectivity." },
{ q: "During a disaster or public health emergency, how does the ethical framework shift regarding resource allocation?", a: "It shifts from an individual-centered approach (beneficence to one patient) to a **utilitarian approach** (maximizing survival and benefits for the population as a whole)." },
{ q: "What is the concept of <b>moral injury</b> (or <b>moral distress</b>) in healthcare?", a: "The psychological distress experienced by a clinician when they know the ethically correct action to take but are prevented from doing so by institutional or systemic constraints." },
{ q: "If a patient's family requests a treatment that is not supported by any medical evidence, does the physician's duty of beneficence require them to provide it?", a: "<b>No</b>. Beneficence does not require providing non-beneficial or potentially harmful treatments, and physicians must practice evidence-based medicine." }
          ]
        },
{
          section: 'Ethics, Law & Health Systems',
          topic: "Informed consent & capacity assessment",
          icon: "file-check",
          cards: [
            { q: "What are the <b>4 elements of valid informed consent</b>?", a: "<b>1. Disclosure</b> — adequate information (diagnosis, procedure, risks, benefits, alternatives, including no treatment)<br><b>2. Understanding</b> — patient comprehends the information<br><b>3. Voluntariness</b> — free from coercion or undue influence<br><b>4. Decision-making capacity</b> — patient has capacity to decide<br><i>All 4 must be present for consent to be valid</i>" },
  { q: "What information must be <b>disclosed</b> during informed consent?", a: "<b>Required disclosure:</b><br>• Diagnosis and nature of condition<br>• Proposed procedure/treatment<br>• Material risks (those a reasonable patient would consider significant)<br>• Benefits of proposed treatment<br>• Reasonable alternatives<br>• Consequences of declining treatment<br><i>Standard: 'reasonable patient' standard (majority) OR 'reasonable physician' standard (minority)</i>" },
  { q: "What is <b>decision-making capacity</b> (DMC)?", a: "Patient's ability to make a specific medical decision at a specific time<br><br><b>4 components (MacArthur criteria):</b><br>1. <b>Understand</b> — comprehend information provided<br>2. <b>Appreciate</b> — recognize how it applies to their situation<br>3. <b>Reason</b> — weigh risks/benefits logically<br>4. <b>Communicate</b> — express a consistent choice<br><br><i>Capacity is decision-specific and time-specific</i>" },
  { q: "How does <b>capacity</b> differ from <b>competency</b>?", a: "<b>Capacity:</b> Clinical determination made by physician at the bedside — can patient make this decision NOW?<br><br><b>Competency:</b> Legal determination made by a court judge<br><br><i>Physicians assess capacity; courts determine competency. In practice, a patient with capacity is presumed legally competent. A physician can declare a patient lacks capacity; a judge declares incompetency.</i>" },
  { q: "A patient refuses a blood transfusion. They seem confused. What is the <b>first step</b>?", a: "<b>Assess decision-making capacity</b><br><br>• Capacity is required for refusal to be valid<br>• If patient lacks capacity → surrogate decision-maker<br>• If patient HAS capacity → even life-threatening refusal must be respected (e.g., Jehovah's Witness)<br><br><i>Never assume incapacity due to diagnosis alone (e.g., dementia, psych disorder)</i>" },
  { q: "What is the <b>Mini-Mental State Examination (MMSE)</b> and its role in capacity?", a: "<b>MMSE</b> is a cognitive screening tool (score 0-30)<br><br>• <b>NOT</b> a direct test of decision-making capacity<br>• Low MMSE does not automatically mean incapacity<br>• A patient with low MMSE may still have capacity for simple decisions<br>• A patient with normal MMSE may lack capacity (e.g., delusional disorder)<br><br><i>Capacity requires functional ability to understand, appreciate, reason, and communicate — not just cognitive score</i>" },
  { q: "Which clinician should assess <b>decision-making capacity</b>?", a: "<b>Any licensed physician</b> can assess capacity for routine decisions<br><br>• Attending physician typically assesses<br>• <b>Psychiatry consult</b> recommended for: borderline cases, psychiatric illness, complex decisions, legal implications<br>• Ethics committee consult for value conflicts<br><br><i>No special certification required; however, documentation must reflect all 4 MacArthur criteria</i>" },
  { q: "What happens when a patient <b>lacks decision-making capacity</b>?", a: "<b>Surrogate decision-maker</b> (proxy) is used<br><br><b>Hierarchy (varies by state):</b><br>1. Legal healthcare proxy / healthcare power of attorney<br>2. Spouse or domestic partner<br>3. Adult children (majority)<br>4. Parents<br>5. Adult siblings<br>6. Close friends<br>7. Court-appointed guardian<br><br><i>If no surrogate available and non-emergent: seek court authorization. Emergencies: treat without consent.</i>" },
  { q: "What is a <b>Healthcare Power of Attorney (HCPOA)</b>?", a: "A legal document designating a <b>healthcare proxy/agent</b> to make medical decisions when the patient lacks capacity<br><br>• Also called: Durable Power of Attorney for Healthcare, Healthcare Proxy<br>• Agent uses <b>substituted judgment</b> standard — 'what would the patient want?'<br>• Activated only when patient lacks capacity<br>• Can be revoked by patient at any time while they have capacity<br><br><i>This is the PREFERRED advance directive for decision-making</i>" },
  { q: "What is <b>substituted judgment</b> vs <b>best interest standard</b>?", a: "<b>Substituted judgment:</b> Surrogate decides as the patient would — based on patient's known values, beliefs, prior statements (preferred standard)<br><br><b>Best interest standard:</b> Used when patient's wishes are unknown — surrogate decides based on what a 'reasonable person' would want in that situation<br><br><i>Substituted judgment > best interest. Best interest is a fallback.</i>" },
  { q: "What are <b>advance directives</b>?", a: "Legal documents expressing a patient's wishes about future medical care if they lose decision-making capacity<br><br><b>Types:</b><br>1. <b>Living will</b> — specifies what treatments patient wants/refuses<br>2. <b>Healthcare proxy/HCPOA</b> — designates decision-maker<br>3. <b>Do Not Resuscitate (DNR)/DNAR</b> — physician order<br>4. <b>POLST/MOLST</b> — Physician/Medical Orders for Life-Sustaining Treatment<br><br><i>Advance directives are honored only when patient lacks capacity</i>" },
  { q: "What is a <b>living will</b>?", a: "Written advance directive specifying patient's treatment preferences for specific future scenarios (e.g., terminal illness, persistent vegetative state)<br><br>• May include preferences about: ventilation, CPR, artificial nutrition, dialysis, antibiotics<br>• Activated only when: <b>patient lacks capacity</b> AND <b>scenario described occurs</b><br>• Less flexible than HCPOA<br><br><i>Living will tells WHAT to do; HCPOA names WHO decides</i>" },
  { q: "A competent patient refuses a life-saving amputation. What do you do?", a: "<b>Respect the refusal</b><br><br>• Competent patients have the right to refuse ANY treatment, even life-saving<br>• Document the discussion, ensure understanding of consequences<br>• Ensure the refusal is informed (patient understands risks of refusal)<br>• May offer palliative care<br><br><i>Autonomy: right to refuse treatment is absolute in competent adults. You cannot force treatment over competent refusal.</i>" },
  { q: "What is <b>implied consent</b>?", a: "Consent inferred from patient's behavior or circumstances — without explicit verbal/written agreement<br><br><b>Examples:</b><br>• Patient extends arm for blood draw (emergency/routine)<br>• Patient presents to ER unconscious → consent implied for life-saving treatment<br><br><i>Emergency exception: when patient cannot consent, treatment is implied in emergencies to prevent serious harm/death. Implied consent does not apply to elective procedures.</i>" },
  { q: "What is the <b>emergency exception</b> to informed consent?", a: "In true emergencies, when a patient cannot provide consent and delay would cause serious harm or death:<br>• Treat without consent<br>• Based on <b>implied consent doctrine</b> — reasonable person would want treatment<br><br><b>Conditions:</b><br>1. Immediate threat to life or serious harm<br>2. Patient unable to consent<br>3. No time to obtain surrogate<br>4. No known prior refusal<br><br><i>Exception does NOT apply if patient has a valid advance directive refusing treatment</i>" },
  { q: "Can a <b>minor</b> give informed consent?", a: "<b>Generally NO</b> — parents/guardians provide consent for minors (<18 years)<br><br><b>Exceptions where minors can consent independently:</b><br>• <b>Emancipated minors</b> (married, military, financially independent, court-ordered)<br>• <b>Mature minor doctrine</b> (case-by-case, sufficient maturity/understanding)<br>• <b>Specific services</b> (state-specific): STIs/sexual health, contraception, substance abuse, mental health (most states allow 12-14+)<br><br><i>Assent (minor's agreement) is still sought even when not legally required</i>" },
  { q: "What are the <b>emancipated minor</b> criteria?", a: "A minor who is legally treated as an adult for medical decision-making:<br><br>• Married (even if divorced)<br>• Active military service<br>• Financially self-supporting and living independently<br>• Parent of own child<br>• Court-declared emancipation<br><br><i>Emancipated minors can consent to all medical treatments, not just specific services</i>" },
  { q: "What is the <b>mature minor doctrine</b>?", a: "Allows a minor who demonstrates sufficient maturity and understanding to consent to medical treatment without parental consent<br><br>• Recognition: most US states (varies by state)<br>• Factors: age (typically 14+), ability to understand consequences, prior medical experience<br>• Not applicable in all states<br><br><i>Assent vs Consent: even non-emancipated, non-mature minors should be asked for 'assent' — their agreement, even if not legally binding</i>" },
  { q: "A 15-year-old requests <b>birth control</b> without parental consent. What do you do?", a: "<b>Provide contraception</b> without parental notification in most states<br><br>• Most states allow minors to consent independently to: contraception, STI testing/treatment, pregnancy care<br>• Encourage parental involvement but cannot require it<br>• Maintain confidentiality<br><br><i>Key USMLE point: confidentiality for minors seeking reproductive/STI/substance abuse care is protected in most states</i>" },
  { q: "What is <b>therapeutic privilege</b>?", a: "Withholding information from a patient if disclosure would cause serious psychological harm<br><br>• <b>Rarely justified</b> in modern medical ethics<br>• Paternalistic and controversial<br>• Cannot withhold information just because patient might refuse treatment<br>• Cannot withhold information to avoid distress<br><br><i>Therapeutic privilege is NOT justified simply because the patient might become upset or refuse treatment. It is only valid if disclosure would cause actual harm (e.g., severe psychiatric decompensation)</i>" },
  { q: "What is <b>waiver of informed consent</b>?", a: "A competent patient voluntarily waives the right to receive detailed information before treatment<br><br>• Patient states they trust the physician and don't want details<br>• Still must confirm voluntariness and competency<br>• Document waiver<br><br><i>Waiver is valid — patients can choose NOT to be informed. However, the patient must still be informed of their right to information. Cannot be coerced into waiving.</i>" },
  { q: "What is <b>research consent</b> vs clinical consent?", a: "<b>Research consent</b> has additional requirements (Belmont Report/federal regulations):<br>• Purpose of the research must be explained<br>• That participation is voluntary and can be withdrawn<br>• Expected duration of participation<br>• Foreseeable risks AND discomforts<br>• Anticipated benefits (to subject or others)<br>• Alternative treatments available<br>• Confidentiality protections<br>• Compensation for injury information<br><br><i>IRB (Institutional Review Board) must approve research protocols. Research consent is more stringent than clinical consent.</i>" },
  { q: "What is the role of an <b>Institutional Review Board (IRB)</b>?", a: "Independent committee that reviews, approves, and monitors research involving human subjects<br><br><b>Responsibilities:</b><br>• Ensure research benefits outweigh risks<br>• Verify informed consent process<br>• Protect vulnerable populations (children, prisoners, pregnant women)<br>• Monitor ongoing research<br><br><i>Mandated by the Belmont Report (1979) and federal law (45 CFR 46). Research cannot begin without IRB approval.</i>" },
  { q: "What are the <b>3 Belmont Report principles</b> for research ethics?", a: "<b>1. Respect for Persons</b> — autonomy: informed consent, protect those with diminished autonomy<br><b>2. Beneficence</b> — do good, minimize harm; maximize benefits and minimize risks<br><b>3. Justice</b> — equitable selection of subjects; don't exploit vulnerable groups; distribute benefits and burdens fairly<br><br><i>Published 1979 after Tuskegee syphilis study scandal. Foundation of US human subjects research regulations</i>" },
  { q: "What was the <b>Tuskegee syphilis study</b> and its ethical significance?", a: "<b>1932-1972</b>: US Public Health Service studied untreated syphilis in 399 African American men in Alabama<br><br>• Penicillin became available 1947 — NOT given to subjects<br>• Men not told they had syphilis or that treatment was withheld<br>• Led to <b>National Research Act (1974)</b> and <b>Belmont Report (1979)</b><br><br><b>Legacy:</b> Established need for IRBs, informed consent in research, and protection of vulnerable populations</i>" },
  { q: "What is the <b>Canterbury v. Spence</b> case significance?", a: "Landmark 1972 US federal case establishing the <b>patient-centered (reasonable patient) standard</b> for informed consent disclosure<br><br>• Physician failed to disclose 1% risk of paralysis from laminectomy<br>• Court ruled: disclosure must cover information that a <b>reasonable patient</b> would consider material to their decision<br><br><i>Majority US standard. Contrast with older 'professional standard' — what a reasonable physician would disclose</i>" },
  { q: "What is the <b>professional/physician standard</b> for informed consent?", a: "Disclosure obligation is what a <b>reasonable physician</b> in the same specialty would disclose in similar circumstances<br><br>• Minority standard in US<br>• Criticized as paternalistic — physicians decide what patients need to know<br><br><i>Compare with 'reasonable patient' standard (majority): what a reasonable patient would want to know. USMLE favors the reasonable patient standard.</i>" },
  { q: "When can physicians <b>disclose patient information</b> without consent?", a: "<b>Mandatory reporting exceptions:</b><br>• <b>Communicable diseases</b> (TB, STIs, COVID — state-specific lists)<br>• <b>Child abuse</b> (suspected, mandatory reporter)<br>• <b>Elder abuse</b><br>• <b>Gunshot/stab wounds</b> (most states)<br>• <b>Tarasoff duty to warn</b> (specific, credible threat to identifiable third party)<br>• Court orders / subpoenas<br>• Workers' compensation claims (limited)<br><br><i>Privacy broken for public safety, not convenience</i>" },
  { q: "What is the <b>Tarasoff duty to warn</b>?", a: "<b>Tarasoff v. Regents of UC (1976):</b> Therapist must take reasonable steps to protect an identifiable third party from a patient's serious, credible threat of harm<br><br><b>Duty triggered by:</b><br>• Serious threat (violence/harm)<br>• Identifiable victim<br>• Credible (patient has means/intent)<br><br><b>Actions:</b> Warn the intended victim, notify police, hospitalize patient (involuntary if needed), or some combination<br><br><i>Overrides confidentiality. Not all states have adopted Tarasoff; some have discretionary duty.</i>" },
  { q: "What is <b>HIPAA</b> and what does it protect?", a: "<b>Health Insurance Portability and Accountability Act (1996)</b><br><br>Protects <b>Protected Health Information (PHI)</b>:<br>• Any identifiable health information (name, DOB, SSN, address, diagnosis, etc.)<br><br><b>Permitted disclosures without authorization:</b><br>• Treatment, Payment, Healthcare Operations (TPO)<br>• Public health reporting<br>• Law enforcement (limited)<br>• Emergency situations<br><br><i>Patients have rights to: access records, amend records, receive accounting of disclosures, request restrictions</i>" },
  { q: "Under HIPAA, who can access a patient's medical records?", a: "<b>Access without patient authorization:</b><br>• Treating physicians (treatment)<br>• Insurers (payment)<br>• Quality review/accreditation (operations)<br>• Public health authorities<br><br><b>Requires patient authorization:</b><br>• Employers (except workers' comp)<br>• Life/disability insurers<br>• Family members (unless designated proxy or patient authorizes)<br>• Media<br>• Attorneys (except court order)<br><br><i>Even spouses do NOT have automatic right to PHI without patient authorization</i>" },
  { q: "A patient is brought in unconscious. Family requests information. What do you do?", a: "May share information with family if:<br>• Patient previously authorized disclosure to that family member<br>• Physician determines it is in the patient's best interest<br>• Information shared is limited to what's needed for care coordination<br><br><i>Unconscious patient cannot consent — apply emergency exception and use clinical judgment. Document reasoning. Once patient regains capacity, they resume control of their information.</i>" },
  { q: "What is the <b>right to refuse treatment</b> based on?", a: "Based on <b>autonomy</b> and the constitutional right to liberty (14th Amendment)<br><br>Legal precedents:<br>• <i>Cruzan v. Director, Missouri Dept. of Health (1990)</i> — SCOTUS: competent patients have constitutional right to refuse treatment including withdrawal of life-sustaining treatment<br>• <i>Schloendorff v. Society of NY Hospital (1914)</i> — Cardozo: 'every human being of adult years and sound mind has the right to determine what shall be done with his own body'<br><br><i>Refusal is only valid if patient has decision-making capacity</i>" },
  { q: "What is the legal standard for <b>involuntary psychiatric hospitalization</b>?", a: "Patient must meet criteria for <b>danger to self</b> (suicidal) OR <b>danger to others</b> OR <b>unable to care for self</b> due to mental illness<br><br><b>Process:</b><br>• Emergency holds: physician/police can initiate 72-hour hold (5150 in CA)<br>• Must have formal hearing for longer commitment<br>• Patient retains rights (to attorney, to challenge commitment)<br><br><i>Mental illness alone is NOT sufficient. Must demonstrate imminent danger.</i>" },
  { q: "A psychotic patient refuses antipsychotics. Can you force medication?", a: "<b>Generally NO</b> — even involuntarily hospitalized patients retain right to refuse medication<br><br><b>Exceptions:</b><br>• Imminent danger to self or others (emergency situation)<br>• Court order (after due process hearing)<br><br><i>Involuntary hospitalization ≠ right to force medication. Separate legal proceedings needed for forced medication in non-emergency. Riese hearings (CA) / Rogers hearings (MA) are examples.</i>" },
  { q: "What is <b>informed refusal</b>?", a: "A competent patient's documented decision to decline recommended treatment after being fully informed<br><br>• Physician must document: patient was informed of diagnosis, risks of refusal, alternatives<br>• Patient understands consequences<br>• Decision is voluntary<br>• Patient has decision-making capacity<br><br><i>Informed refusal carries same weight as informed consent. Document thoroughly. Cannot be undone by physician unilaterally.</i>" },
  { q: "A patient with <b>depression</b> refuses chemotherapy. Do they lack capacity?", a: "<b>NOT automatically</b> — psychiatric diagnosis does NOT equal incapacity<br><br>• Must formally assess all 4 components of DMC<br>• Depression may impair appreciation ('I'm not worth saving') → suggests incapacity<br>• If depressed patient understands, appreciates, reasons, and communicates → has capacity<br>• Treat depression and reassess<br><br><i>The decision to refuse (even for poor reasons) does not equal incapacity. Focus on the PROCESS of decision-making, not the outcome.</i>" },
  { q: "What is a <b>DNR/DNAR order</b>?", a: "<b>Do Not Resuscitate / Do Not Attempt Resuscitation</b> — physician order directing that CPR not be performed if patient has cardiopulmonary arrest<br><br>• Requires informed consent from patient (or surrogate if incapacitated)<br>• Does NOT mean 'do not treat' — other treatments continue<br>• Automatically suspended during general anesthesia (unless specifically discussed)<br>• Must be rewritten with each hospital admission<br><br><i>DNR ≠ withdrawal of care. Misunderstanding this is a common error.</i>" },
  { q: "What is <b>POLST</b> and how does it differ from a living will?", a: "<b>POLST (Physician Orders for Life-Sustaining Treatment)</b> — also MOLST, MOST, POST depending on state<br><br>• Medical ORDER (not just a directive) — immediately actionable<br>• Signed by physician AND patient<br>• Travels with patient across care settings<br>• Covers: CPR, hospitalization, artificial nutrition, ventilation<br><br><b>vs Living Will:</b><br>• Living will = patient document; POLST = physician order<br>• POLST is more specific and immediately enforceable<br><br><i>Ideal for seriously ill or frail patients</i>" },
  { q: "Under what circumstances should a physician <b>override a patient's stated wishes</b>?", a: "<b>Almost never</b> for a competent patient. Exceptions:<br>• Patient currently lacks capacity (prior wishes may be overridden by proper surrogate)<br>• Public health emergency (quarantine, mandatory reporting)<br>• Court order<br>• Patient is a minor (parental override in some cases)<br><br><i>Even lifestyle-endangering or medically inadvisable decisions must be respected if made by a competent adult. Physician should express disagreement but comply (or transfer care).</i>" },
  { q: "What is the <b>National Practitioner Data Bank (NPDB)</b>?", a: "Federal database of reports on physicians and other healthcare practitioners<br><br><b>Reports required for:</b><br>• Medical malpractice payments<br>• Adverse licensure actions<br>• Adverse clinical privilege actions<br>• Exclusions from Medicare/Medicaid<br>• Criminal convictions related to healthcare<br><br><i>Hospitals must query NPDB when credentialing physicians. NPDB protects confidentiality — not available to public</i>" },
  { q: "What are <b>conditions for valid consent in research</b> (beyond clinical care)?", a: "<b>Federal regulations (45 CFR 46) require:</b><br>1. Voluntary participation (right to withdraw without penalty)<br>2. Purpose and duration of research explained<br>3. Foreseeable risks and discomforts disclosed<br>4. Expected benefits explained<br>5. Alternatives described<br>6. Confidentiality protections<br>7. Compensation for injury policy<br>8. Contact information (questions/injury)<br>9. Statement that participation is voluntary<br><br><i>Additional protections for vulnerable populations: children, prisoners, pregnant women</i>" },
  { q: "When can informed consent be <b>waived in research</b>?", a: "IRB may waive consent if ALL of:<br>1. Research involves minimal risk<br>2. Waiver won't adversely affect subjects' rights<br>3. Research could not practicably be done without waiver<br>4. Subjects will be debriefed when appropriate<br><br><b>Examples:</b><br>• Chart reviews (retrospective, de-identified)<br>• Some observational studies<br>• Emergency research (separate regulations)<br><br><i>NOT waived simply for convenience or to increase enrollment</i>" },
  { q: "What is <b>assent</b> in pediatric medicine?", a: "A child's affirmative agreement to participate in research or medical treatment — distinct from legal consent (given by parent/guardian)<br><br>• Sought from children age <b>7-14+</b> (varies by institution)<br>• <b>Not legally required</b> but ethically important<br>• Child's dissent should be respected unless treatment is essential<br>• Documents respect for developing autonomy<br><br><i>Assent ≠ consent. Parent gives consent; child gives assent. If child dissents, carefully consider whether to proceed.</i>" },
  { q: "What is the <b>surrogate decision-making hierarchy</b> in most US states?", a: "<b>Priority order (varies by state):</b><br>1. Healthcare proxy/agent (HCPOA) — if designated<br>2. Court-appointed guardian<br>3. Spouse/domestic partner<br>4. Adult child (or majority of adult children)<br>5. Parent<br>6. Adult sibling<br>7. Close friend<br><br><i>Always check state law. If designated HCPOA exists, they supersede family hierarchy. If no surrogate exists → ethics committee or court</i>" },
  { q: "A patient designates their <b>adult daughter</b> as HCPOA. The spouse disagrees. Who decides?", a: "<b>The HCPOA (adult daughter)</b> — designated healthcare proxy supersedes default surrogate hierarchy<br><br>• HCPOA was legally designated by patient when they had capacity<br>• Patient's autonomous choice of agent must be honored<br>• Spouse has no authority to override the designated agent<br><br><i>Key principle: the designated HCPOA takes precedence over next-of-kin hierarchy</i>" },
  { q: "What is <b>surrogate decision-making conflict</b> and how is it resolved?", a: "When surrogates disagree (e.g., adult children can't agree) or surrogate decisions seem inconsistent with patient's known wishes<br><br><b>Steps:</b><br>1. Family meeting — facilitate discussion<br>2. Social work involvement<br>3. Palliative care consultation<br>4. Ethics committee consultation<br>5. Court involvement (last resort)<br><br><i>Goal: determine patient's authentic wishes using substituted judgment, not what family wants</i>" },
  { q: "What is the role of the <b>hospital ethics committee</b>?", a: "<b>Ethics committees</b> provide:<br>• Consultation on difficult ethical cases<br>• Policy development (DNR, consent, end-of-life)<br>• Education for staff<br>• Review of ethics violations<br><br>Consultations requested when:<br>• Disagreement about care plan<br>• Unclear advance directives<br>• Surrogate conflict<br>• Withholding/withdrawing treatment disputes<br><br><i>Advisory — not binding. Final decisions rest with patient, surrogate, or court</i>" },
  { q: "A Jehovah's Witness adult refuses a blood transfusion needed for survival. What do you do?", a: "<b>Respect the refusal</b> if patient has decision-making capacity<br><br>• Confirm capacity is intact<br>• Ensure decision is informed (knows the risk of death)<br>• Ensure decision is voluntary (not coerced by family/church)<br>• Document thoroughly<br>• Offer bloodless surgery alternatives if possible<br>• Do NOT transfuse over patient's objection<br><br><i>If patient loses capacity: follow advance directive or surrogate. If minor Jehovah's Witness: court order can be sought to transfuse to save life.</i>" },
  { q: "A Jehovah's Witness <b>minor</b> (parents refuse) needs blood transfusion. What do you do?", a: "<b>Seek emergency court order</b> to transfuse<br><br>• Minors cannot legally refuse life-saving treatment on religious grounds<br>• Parents' religious rights do not extend to denying life-saving treatment to minors<br>• In true emergency (no time for court) → treat to save life<br><br><i>Legal precedent: Parens patriae doctrine — state can override parental decisions when child's life is at risk. Adults can choose death; children cannot.</i>" },
  { q: "What is <b>informed consent for surgery</b> — who obtains it?", a: "<b>The performing surgeon</b> is responsible for obtaining informed consent<br><br>• Can delegate to physician assistant/resident who is familiar with the procedure<br>• Must ensure patient received adequate information<br>• Anesthesiologist obtains separate consent for anesthesia<br><br><i>Nursing staff do NOT obtain surgical consent (they may witness signature). The proceduralist bears responsibility.</i>" },
  { q: "What happens if a patient signs a consent form but doesn't understand what they signed?", a: "The consent is <b>NOT valid</b><br><br>• Signature alone does not constitute informed consent<br>• Patient must demonstrate understanding (not just sign)<br>• If patient cannot understand in English: use a qualified medical interpreter (not family member)<br>• If patient cannot read: explain verbally, confirm comprehension<br><br><i>Informed consent is a process (discussion), not just a signature on a form</i>" },
  { q: "When must a <b>medical interpreter</b> be used (vs family member)?", a: "<b>Professional/qualified medical interpreter preferred</b> for all clinical interactions with LEP (limited English proficiency) patients<br><br>• Federal law (Title VI Civil Rights Act): hospitals receiving federal funding must provide free language services<br>• Family interpreters: generally discouraged (conflict of interest, privacy, accuracy)<br>• <b>Absolutely avoid</b> using minor children as interpreters<br><br><i>For informed consent: using family interpreter risks invalid consent due to filtering/bias. Use telephonic interpreter if trained interpreter unavailable.</i>" },
  { q: "What is <b>capacity assessment in dementia</b>?", a: "Dementia ≠ automatic incapacity<br><br>• Mild dementia: often retain capacity for simple decisions<br>• Moderate/severe dementia: likely lack capacity for complex decisions<br>• Capacity is decision-specific: may have capacity for some decisions but not others<br>• Assess in 'best window' (morning, after rest, without sedating medications)<br><br><i>Even patients with dementia should be involved in care decisions to the extent possible. 'Assent' is sought even without full capacity.</i>" },
  { q: "What is capacity for a patient with <b>intellectual disability</b>?", a: "Intellectual disability (ID) does not automatically negate capacity<br><br>• Mild ID: often retain decision-making capacity<br>• Moderate/severe ID: frequently lack full capacity<br>• Must formally assess all 4 MacArthur criteria<br>• If lacks capacity: legal guardian provides consent<br>• If guardian not established: may need court appointment<br><br><i>Patients with ID should participate in decision-making to their fullest ability. Person-centered approach.</i>" },
  { q: "What is the <b>fluctuating capacity</b> situation (e.g., ICU delirium)?", a: "Patient's capacity may vary over time<br><br>• Reassess frequently in delirious/encephalopathic patients<br>• Make major decisions when patient is most lucid<br>• For non-emergent decisions: wait for capacity to return<br>• Document each capacity assessment with time and date<br><br><i>A patient who lacked capacity yesterday may have capacity today. Prior incapacity does not permanently invalidate future decision-making.</i>" },
  { q: "What is the '<b>sliding scale</b>' of capacity?", a: "The threshold for demonstrating decision-making capacity scales with the <b>risk of the decision</b>:<br><br>• <b>Low-risk decision</b> (e.g., taking aspirin): low threshold — basic understanding sufficient<br>• <b>High-risk decision</b> (e.g., refusing surgery needed to survive): higher threshold — must clearly demonstrate all 4 components<br><br><i>Proposed by Appelbaum & Grisso. Not universally adopted as formal standard but reflects clinical practice</i>" },
  { q: "A patient says 'I'll sign whatever, just do whatever you think is best.' Is this valid consent?", a: "<b>Not automatically</b> — this is a potential waiver of informed consent<br><br>• Confirm patient has capacity<br>• Confirm the waiver is voluntary (not coercion)<br>• Document that patient was offered information and chose to waive<br>• Note that waiver can be revoked at any time<br>• Still cannot proceed if patient previously expressed specific refusals<br><br><i>A voluntary waiver of information is valid. A coerced waiver is not.</i>" },
  { q: "What is <b>coercion</b> in the context of informed consent?", a: "Undue pressure that undermines voluntariness of consent<br><br><b>Forms of coercion:</b><br>• Explicit threats (e.g., 'if you don't consent, we won't treat you')<br>• Undue inducements (excessive payment for research participation)<br>• Pressure from family members<br>• Physician's own bias presented as fact<br><br><i>Consent obtained under coercion is invalid. Voluntariness is one of the 4 core elements of informed consent.</i>" },
  { q: "What does 'material risk' mean in informed consent?", a: "A risk is 'material' if it would be significant to a <b>reasonable patient</b> in deciding whether to undergo the procedure<br><br>• Material risks MUST be disclosed<br>• Low-probability but high-severity risks are material (e.g., death, paralysis, loss of organ)<br>• High-probability but minor risks are material (e.g., post-op pain, bruising)<br>• Does not require disclosing every theoretical risk<br><br><i>Test: would a reasonable patient want to know? If yes → disclose</i>" },
  { q: "What is the <b>doctrine of informed consent</b> and its legal basis?", a: "Legal/ethical doctrine requiring physicians to disclose material information to patients before obtaining consent for treatment<br><br><b>Legal foundations:</b><br>• Common law (battery — touching without consent)<br>• Negligence (failing to disclose material information = malpractice)<br>• Constitutional privacy rights<br><br><i>Failure to obtain valid informed consent = battery (unauthorized touching) OR negligence (if proper disclosure would have changed patient's decision)</i>" },
  { q: "What is the difference between <b>battery</b> and <b>negligence</b> in informed consent?", a: "<b>Battery:</b> Unauthorized touching — performing a procedure the patient did NOT consent to at all (e.g., operating on wrong site, performing additional procedure without prior consent)<br><br><b>Negligence:</b> Consent given but disclosure was inadequate — patient consented but wasn't told of a material risk that would have changed their decision<br><br><i>Most modern informed consent lawsuits are brought as negligence, not battery</i>" },
  { q: "A patient consented to appendectomy. During surgery, surgeon discovers colon cancer and removes it. Battery?", a: "<b>Yes — potentially battery</b> (unauthorized procedure)<br><br>• Consent was for appendectomy only<br>• Extending to additional procedure (colectomy) without prior consent = battery<br>• Exception: patient is under anesthesia and delay would cause serious harm (e.g., actively bleeding tumor) → <i>implied emergency consent</i><br><br><i>Best practice: discuss with patient in advance what to do if additional pathology is found. If non-urgent → wake patient up and discuss</i>" },
  { q: "What is <b>therapeutic misconception</b> in research?", a: "Research participants believe the primary purpose of the study is to benefit them personally, when research's primary goal is to generate generalizable knowledge<br><br>• Common in clinical trials<br>• Undermines voluntary informed consent<br>• Investigators must clearly distinguish research from treatment<br><br><i>Participants may confuse 'experimental treatment' with 'best treatment'. Investigators must clarify the experimental nature and that assignment (randomization) is not tailored to individual benefit</i>" },
  { q: "What are <b>vulnerable populations</b> in research and what protections apply?", a: "<b>Vulnerable populations</b> receive additional protections:<br>• <b>Children</b> — parental permission + child assent; most research requires parental consent<br>• <b>Prisoners</b> — limited to research directly benefiting prisoners or the class; must not offer undue inducement<br>• <b>Pregnant women</b> — research must offer benefit to woman/fetus or minimal risk<br>• <b>Cognitively impaired</b> — LAR (Legally Authorized Representative) gives permission<br><br><i>Additional Subpart protections in 45 CFR 46 (Subparts B, C, D)</i>" },
  { q: "What is a <b>certificate of confidentiality</b> in research?", a: "Issued by NIH — protects researchers from compelled legal disclosure of identifiable research data<br><br>• Protects even from court subpoenas<br>• Allows participants to refuse disclosure to law enforcement<br>• Encourages enrollment in sensitive research (substance abuse, mental health, genetics)<br><br><i>Mandatory for NIH-funded research involving sensitive data since 2017</i>" },
  { q: "What is the <b>Nuremberg Code</b>?", a: "First international code of research ethics — established after Nuremberg trials (1947) regarding Nazi human experimentation<br><br><b>Key principles:</b><br>1. Voluntary consent is absolutely essential<br>2. Experiment must be necessary and fruitful<br>3. Based on animal experiments first<br>4. Avoid unnecessary physical/mental harm<br>5. No experiment if death/disabling injury expected<br>6. Risk must be proportional to humanitarian importance<br>7. Subjects must be protected<br>8. Only conducted by scientifically qualified persons<br>9. Subject can withdraw at any time<br>10. Investigator must stop if injury becomes likely" },
  { q: "What is the <b>Declaration of Helsinki</b>?", a: "World Medical Association (WMA) 1964 document (revised multiple times) — ethical principles for medical research involving human subjects<br><br><b>Key points:</b><br>• Physician-researcher has primary duty to patient welfare<br>• Independent ethics committee review required<br>• Vulnerable subjects need extra protection<br>• Research must be based on adequate laboratory/animal work<br>• Control groups: best proven standard (not placebo if proven treatment exists)<br>• Post-trial access to beneficial treatments<br><br><i>International standard, updated most recently 2013</i>" },
  { q: "What is a <b>randomized controlled trial (RCT)</b> and its ethical requirements?", a: "Gold standard experimental design: participants randomly assigned to intervention vs control<br><br><b>Ethical requirements:</b><br>• <b>Equipoise</b> — genuine uncertainty which treatment is better<br>• Informed consent including disclosure of randomization<br>• IRB approval<br>• Data Safety Monitoring Board (DSMB) for ongoing safety<br>• Stopping rules defined in advance<br><br><i>Clinical equipoise justifies randomization. If one arm proves superior during trial → study should be stopped (DSMB responsibility)</i>" },
  { q: "What is <b>clinical equipoise</b>?", a: "Genuine uncertainty in the medical community about which of the trial treatments is superior<br><br>• Justifies randomization in an RCT<br>• Without equipoise → unethical to randomize patients to potentially inferior treatment<br>• If equipoise is broken (clear evidence of superiority) → trial should stop<br><br><i>Concept introduced by Benjamin Freedman (1987). Distinct from individual uncertainty — requires collective medical community uncertainty</i>" },
  { q: "What is a <b>Data Safety Monitoring Board (DSMB)</b>?", a: "Independent committee that monitors ongoing clinical trials for safety and efficacy<br><br><b>Responsibilities:</b><br>• Review interim data (investigators remain blinded)<br>• Assess adverse events<br>• Recommend stopping the trial if: clear superiority of one arm, unacceptable harm, or futility<br><br><i>DSMB exists to protect trial participants and maintain scientific integrity. Sponsors and investigators should not have access to unblinded interim data.</i>" },
  { q: "What is the difference between <b>Phase I, II, III, IV clinical trials</b>?", a: "<b>Phase I</b>: Safety/toxicity — small group, healthy volunteers (or patients), dose-finding<br><b>Phase II</b>: Efficacy + safety — larger group of patients, preliminary effectiveness<br><b>Phase III</b>: Efficacy vs standard treatment — large RCT, regulatory approval purpose<br><b>Phase IV</b>: Post-marketing surveillance — large population, long-term safety<br><br><i>Phases I-III required for FDA approval. Phase IV occurs after market release.</i>" },
  { q: "What is a <b>placebo</b> and when is its use ethical?", a: "An inert substance given to the control group in a trial<br><br><b>Ethical use of placebo:</b><br>• Acceptable when NO proven effective treatment exists<br>• Acceptable when placebo adds only minimal risk/discomfort<br><br><b>Unethical use:</b><br>• When a proven effective treatment exists — control group should receive best proven treatment (Declaration of Helsinki)<br><br><i>Exception: placebo add-on design (placebo + standard care vs active + standard care) may be ethical even when treatment exists</i>" },
  { q: "What is <b>double-blinding</b> in clinical trials and why is it important?", a: "Neither participants NOR investigators know who received treatment vs placebo/control<br><br><b>Importance:</b><br>• Prevents performance bias (investigators treating groups differently)<br>• Prevents ascertainment/detection bias<br>• Prevents placebo effect differences between groups<br>• Strengthens internal validity<br><br><i>Single-blind: only participant blinded. Double-blind: both blinded. Triple-blind: also blinded outcome assessors.</i>" },
  { q: "What is <b>community consent / waiver of individual consent</b> in research?", a: "In some research (especially in emergency or community settings), individual consent is waived and the community is consulted instead<br><br><b>Examples:</b><br>• Cluster randomized trials (randomization at community level)<br>• Emergency research (patients cannot consent, no time)<br>• Public health interventions<br><br><i>FDA 21 CFR 50.24: Exception from Informed Consent (EFIC) for emergency research — requires community consultation, public disclosure, IRB oversight</i>" },
  { q: "What is <b>deception</b> in research and when is it permitted?", a: "Withholding information or providing false information to participants about the research<br><br><b>When permitted (IRB may approve):</b><br>• Study could not be done otherwise<br>• No greater than minimal risk<br>• Participants are debriefed as soon as possible after participation<br><br><b>Examples:</b><br>• Obedience studies (Milgram), conformity studies<br>• Concealed observation studies<br><br><i>Cannot use deception if it would cause participants to refuse if they knew the true nature</i>" },
  { q: "What is the principle of <b>non-malfeasance</b> in the context of consent?", a: "Obligation to 'first, do no harm' (primum non nocere)<br><br>In consent context:<br>• Physician should not perform procedures without valid consent (harm from battery)<br>• Must disclose risks so patient can avoid harm from uninformed decisions<br>• Must NOT coerce patients (psychological harm)<br><br><i>Non-malfeasance sometimes conflicts with autonomy — if patient refuses beneficial treatment, physician's duty to avoid harm conflicts with respecting refusal. Autonomy usually wins in competent adults.</i>" },
  { q: "What is <b>disclosure of medical errors</b> (truth-telling)?", a: "Ethical and legal obligation to inform patients of significant errors in their care<br><br>• <b>Ethical basis</b>: respect for autonomy, honesty, non-deception<br>• <b>Legal basis</b>: most states require disclosure of unanticipated outcomes<br>• Should include: what happened, why, what will be done to address it<br>• Apology laws: in many states, apologies are not admissible as evidence of liability<br><br><i>Disclosure does NOT require admission of fault/negligence. Document the conversation.</i>" },
  { q: "What is a <b>mature minor</b> versus an <b>emancipated minor</b>?", a: "<b>Emancipated minor</b>: Legal status — can consent to ALL medical care (criteria: married, military, self-supporting, parent, court order)<br><br><b>Mature minor</b>: Clinical/case-by-case determination — minor demonstrates sufficient maturity and intelligence to understand consequences; can consent to specific treatments<br><br><i>Emancipated = status-based, automatic. Mature minor = capacity-based, assessed for each decision</i>" },
  { q: "A 16-year-old wants to <b>donate a kidney</b> to a sibling. Can they?", a: "<b>Generally NO</b> — minors cannot consent to non-therapeutic research or non-therapeutic organ donation<br><br>• Organ donation is not for the minor's medical benefit<br>• Even with parental consent, most institutions decline<br>• Requires court involvement and ethics committee review<br>• Most courts do NOT authorize living organ donation from minors<br><br><i>Autonomy of minors is restricted when there is no direct medical benefit and significant risk exists</i>" },
  { q: "What is the difference between <b>consent</b> and <b>assent</b> in pediatric clinical care?", a: "<b>Consent</b>: Legal authorization from parent/guardian (required for treatment)<br><br><b>Assent</b>: Child's active agreement — sought from children typically ages 7-14+<br><br>• Assent is ethically important even though not legally binding<br>• Child's dissent should prompt reconsideration unless treatment is essential<br>• Promotes trust and respects developing autonomy<br><br><i>Both are expected in pediatric care. Assent without parental consent is insufficient for treatment; parental consent without child's assent may be ethically problematic for elective procedures.</i>" },
  { q: "What are <b>advance directives for mental health</b> (psychiatric advance directives)?", a: "Documents specifying a patient's preferences for mental health treatment during future psychiatric crises when they may lack capacity<br><br>• May name a mental health proxy<br>• May specify preferred/refused medications, hospitalization preferences<br>• Recognized in most US states<br>• Can be overridden in emergencies involving imminent danger<br><br><i>Promotes autonomy for patients with serious mental illness who have capacity between episodes</i>" },
  { q: "What is the '<b>ulysses contract</b>'?", a: "An advance directive in which a patient with capacity instructs future providers to override their future refusal of treatment during a psychiatric episode<br><br>• Patient binds their future self to treatment (like Ulysses binding himself to the mast)<br>• Legal status varies by jurisdiction<br>• Ethically controversial — tension between respecting past autonomous wishes vs current stated wishes<br><br><i>Example: bipolar patient in remission instructs that future manic refusal of lithium should be overridden</i>" },
  { q: "What is the role of <b>patient advocates / patient representatives</b> in consent?", a: "Patient advocates assist patients in understanding their rights and navigating the healthcare system<br><br>• Not the same as a surrogate/proxy<br>• Do not make decisions for patients<br>• Help ensure patient's voice is heard<br>• May assist with advance directive completion<br>• Hospital patient representatives handle grievances<br><br><i>Particularly important for vulnerable patients (elderly, LEP, cognitively impaired, institutionalized)</i>" },
  { q: "What constitutes <b>informed consent for HIV testing</b>?", a: "<b>Previously required specific written consent</b> in most states; now most states allow HIV testing with general consent for medical care ('opt-out' approach)<br><br>• CDC recommends routine HIV testing (opt-out) for all 13-64 year olds<br>• Patient must still be informed testing will occur and have right to decline<br>• Positive results: counseling required before disclosure<br>• Confidentiality protected; specific HIPAA provisions apply<br><br><i>Opt-out approach has increased testing rates significantly</i>" },
  { q: "What is <b>genetic testing consent</b> — special considerations?", a: "Genetic testing carries unique informed consent requirements:<br><br>• Implications for biological relatives (not just the patient)<br>• Risk of genetic discrimination (employment, insurance) — GINA Act protects in some contexts<br>• Psychological impact of results<br>• Variants of unknown significance (VUS) — uncertain results<br>• Pre-test counseling (genetic counselor) strongly recommended<br><br><i>Genetic counseling integrates informed consent with psychological support and risk communication</i>" },
  { q: "What is the <b>Genetic Information Nondiscrimination Act (GINA)</b>?", a: "Federal law (2008) prohibiting discrimination based on genetic information:<br><br>• <b>Health insurers</b> cannot deny coverage or charge higher premiums based on genetic information<br>• <b>Employers</b> (>15 employees) cannot use genetic information in hiring, firing, or other employment decisions<br><br><b>Does NOT cover:</b><br>• Life insurance<br>• Disability insurance<br>• Long-term care insurance<br><br><i>Important context for genetic testing consent: GINA protections are limited</i>" },
  { q: "What are the <b>4 ethical principles of biomedical ethics</b> (Beauchamp & Childress)?", a: "<b>Principlism (Georgetown mantra):</b><br>1. <b>Autonomy</b> — respect patient self-determination<br>2. <b>Beneficence</b> — act in patient's best interest<br>3. <b>Non-maleficence</b> — do no harm<br>4. <b>Justice</b> — fair distribution of benefits and burdens<br><br><i>All 4 can conflict — the challenge of medical ethics is balancing them. Autonomy generally prevails in Western medicine for competent adults.</i>" },
  { q: "What is <b>beneficence</b> in the context of informed consent?", a: "Duty to act in the patient's best interest<br><br>In consent context:<br>• Disclosure serves beneficence — patient can make the best decision for themselves<br>• But paternalism (overriding patient wishes 'for their own good') violates autonomy<br>• Beneficence is NOT justification for withholding information or ignoring refusals<br><br><i>Tension: patient's autonomous decision may not align with physician's view of 'best interest'. Autonomy of competent adults generally prevails.</i>" },
  { q: "What is <b>paternalism</b> in medical ethics?", a: "Overriding a patient's autonomous choice to act in what the physician believes is the patient's best interest<br><br><b>Soft paternalism:</b> Intervening when autonomy is compromised (incapacity, coercion) — generally acceptable<br><b>Hard paternalism:</b> Overriding a competent patient's informed decision — generally NOT acceptable in modern bioethics<br><br><i>Example of hard paternalism: refusing to tell patient diagnosis 'to protect them', or forcing treatment on competent patient. Violates autonomy.</i>" },
  { q: "What is <b>capacity assessment tool — MacCAT-T</b>?", a: "<b>MacArthur Competence Assessment Tool for Treatment (MacCAT-T)</b>:<br>Structured interview assessing all 4 components of decision-making capacity:<br><br>1. Understanding<br>2. Appreciation<br>3. Reasoning<br>4. Expressing a choice<br><br>• Semi-structured interview format<br>• Most widely validated capacity assessment tool<br>• Takes ~20 minutes<br>• Used for research and complex clinical cases<br><br><i>Gold standard research tool; clinical capacity assessments often use less formal structured interview</i>" },
  { q: "What is the capacity assessment question for <b>Appreciation</b>?", a: "Testing <b>Appreciation</b>: Does the patient recognize that the information applies to their own situation?<br><br>Example questions:<br>• 'What do you think will happen if you refuse this surgery?'<br>• 'Why do you think the doctors are recommending this treatment?'<br>• 'Do you believe you have [condition]?'<br><br><i>Impaired appreciation: patient says 'I don't have cancer, the doctors are lying' despite evidence. Common in psychosis, severe depression ('I'm not worth saving').</i>" },
  { q: "What is the capacity assessment question for <b>Reasoning</b>?", a: "Testing <b>Reasoning</b>: Can the patient engage in logical reasoning process to weigh options?<br><br>Example questions:<br>• 'What factors led you to that decision?'<br>• 'Can you walk me through how you decided?'<br>• 'What would change your mind?'<br><br><i>Poor reasoning: patient makes decision based on completely irrelevant factors. Good reasoning: patient weighs risks/benefits, even if decision seems unwise to physician. Note: unwise decision ≠ impaired reasoning.</i>" },
  { q: "What is 'understanding' in decision-making capacity assessment?", a: "<b>Understanding</b>: Can the patient comprehend and recall the information disclosed?<br><br>Assessed by: 'Please tell me in your own words what I just explained about your condition and the proposed treatment.'<br><br>• Patient should be able to paraphrase diagnosis, proposed treatment, key risks and benefits, alternatives<br>• Not required to recall everything verbatim<br>• If fails: re-educate in simpler terms; reassess<br><br><i>First component tested. Foundation for all other components.</i>" },
  { q: "What is 'Expressing a choice' in capacity assessment?", a: "<b>Expressing a choice</b>: Can the patient communicate a consistent, stable decision?<br><br>• Lowest threshold component<br>• Patient must be able to state yes or no AND maintain that choice consistently<br>• Inconsistency may indicate delirium, ambivalence, or severe cognitive impairment<br><br><i>Note: the choice must be consistent — not necessarily the same on multiple assessments (patient can change their mind), but stable within a reasonable timeframe</i>" },
  { q: "What is the legal standard for <b>competency to stand trial</b> vs medical decision-making capacity?", a: "<b>Competency to stand trial (Dusky standard):</b><br>• Ability to understand the proceedings and assist in own defense<br>• Criminal law context<br><br><b>Medical decision-making capacity:</b><br>• Ability to understand, appreciate, reason about, and communicate medical decisions<br>• Clinical medicine context<br><br><i>Different standards for different contexts. A patient may lack medical DMC but be competent to stand trial (and vice versa). Both are functional, context-specific assessments.</i>" },
  { q: "What is <b>informed consent in telemedicine</b>?", a: "Telemedicine requires same informed consent elements as in-person care, plus:<br><br>• Disclosure that encounter is conducted via telemedicine<br>• Potential limitations (technology failure, inability to perform physical exam)<br>• Privacy and security protections<br>• Alternative options if patient is uncomfortable with telemedicine<br>• Licensure/jurisdiction disclosure<br><br><i>Many states have specific telemedicine consent statutes. Documenting consent to telemedicine is increasingly standard practice.</i>" },
  { q: "What is <b>organ donation consent</b>?", a: "<b>First-person consent (donor registry):</b> Individual registers as donor while alive — this is legally binding in most states<br><br><b>Family authorization:</b> Next-of-kin can authorize donation if no registry status; cannot override registered donor status<br><br><b>Presumed consent:</b> Some countries (Spain, Austria) — default is donor; opt-out required<br><br><i>US: opt-in system. Hospital staff (organ procurement organization — OPO) approach families. Donor registration status should be checked before family discussion.</i>" },
  { q: "What is the <b>Uniform Anatomical Gift Act (UAGA)</b>?", a: "Model state law governing organ and tissue donation in the US<br><br><b>Key provisions:</b><br>• First-person authorization is legally binding<br>• Family cannot override legally documented donor decision<br>• Allows donation for transplantation, research, education, or therapy<br>• Procurement organizations (OPOs) coordinate donation<br><br><i>All 50 states have adopted UAGA (2006 revision) with minor variations</i>" },
  { q: "What is <b>brain death</b> and its relation to organ donation consent?", a: "<b>Brain death:</b> Complete and irreversible cessation of all brain functions including brainstem<br><br>• Legally dead in all US states<br>• Two physicians (one a neurologist/neurosurgeon) must declare brain death<br>• Family must be informed of death before organ donation discussion<br>• Donation after cardiac death (DCD): separate protocol when brain death criteria not met but life support withdrawal planned<br><br><i>Consent for organ donation is separate from consent for withdrawal of life support. Both require family counseling.</i>" },
  { q: "What is <b>assent in pediatric research</b>?", a: "Positive agreement from child to participate in research<br><br>• Required in addition to parental permission for federally funded research<br>• Age threshold: typically 7 years old (some institutions 6 or 8)<br>• Age-appropriate explanation of research must be provided<br>• Child's dissent generally sufficient to exclude from research (unless no other access to therapy)<br><br><i>Unlike clinical care, research requires additional protections. Child's assent is more weighted in research than in clinical treatment decisions.</i>" },
  { q: "What is the ethical framework for <b>disclosing incidental findings</b> in genetic research?", a: "When research identifies an incidental finding (e.g., genetic variant for disease not being studied):<br><br><b>Duty to return:</b><br>• <i>Actionable</i> findings: generally should be returned (e.g., BRCA mutation, Lynch syndrome)<br>• <i>Non-actionable</i> findings: controversial — some argue no duty to return<br>• Must be addressed in advance in consent form<br><br><i>ACMG (American College of Medical Genetics) recommends returning pathogenic variants in 73 specified genes regardless of study indication</i>" },
  { q: "What is the '<b>right not to know</b>' in genetics?", a: "Patients have the right to decline information about their genetic predispositions<br><br>• Respects autonomy in the opposite direction — right not to be informed<br>• Example: patient doesn't want to know if they carry BRCA mutation<br>• Must be respected — cannot force information on a patient<br><br><i>Tension: if patient's genetic status affects relatives, do relatives have right to information? Physician's duty is primarily to the patient, not relatives — but ethical guidance varies</i>" },
  { q: "What is <b>decisional conflict</b> and how is it managed?", a: "Patient's uncertainty about which healthcare option to choose when faced with a consequential decision<br><br>• Normal part of decision-making; not the same as incapacity<br>• <b>Decision aids</b>: evidence-based tools (videos, written materials) that help patients make informed, values-consistent choices<br>• Shared decision-making (SDM): collaborative process where physician and patient make decisions together<br><br><i>Ottawa Decisional Conflict Scale assesses decisional conflict. Decision aids reduce conflict and improve adherence.</i>" },
  { q: "What is <b>shared decision-making (SDM)</b>?", a: "Collaborative process where physician and patient work together to make healthcare decisions consistent with patient's values and preferences<br><br><b>Components:</b><br>1. Physician presents evidence-based options<br>2. Patient shares values and preferences<br>3. Decision made together<br><br><b>When most appropriate:</b><br>• 'Preference-sensitive' decisions — where options have different tradeoffs<br>• PSA screening, elective surgeries, chronic disease management<br><br><i>SDM is NOT appropriate for emergencies or when one option is clearly superior</i>" },
  { q: "What is the '<b>reasonable patient</b>' vs '<b>reasonable physician</b>' standard for informed consent?", a: "<b>Reasonable patient standard (patient-centered, majority):</b> Disclose what a reasonable patient would want to know<br><br><b>Reasonable physician standard (professional, minority):</b> Disclose what a reasonable physician would disclose<br><br><i>Most US jurisdictions use the reasonable patient standard. USMLE and Step 2 favor this standard. Example: Canterbury v. Spence (1972) established reasonable patient standard in US federal courts.</i>" },
  { q: "What documentation is required after obtaining informed consent?", a: "<b>Documentation should include:</b><br>• Date and time of discussion<br>• Persons present (patient, family if applicable, witnesses)<br>• What was discussed (diagnosis, procedure, risks, benefits, alternatives)<br>• Patient's questions and responses<br>• Patient's decision<br>• Patient's capacity at time of discussion<br>• Signed consent form (for procedures)<br><br><i>The signed form documents the process but the note in the chart is equally important for demonstrating adequate disclosure</i>" },
  { q: "When can a physician <b>refuse to perform</b> a legally permitted procedure due to moral objection (conscientious objection)?", a: "Physician may decline if:<br>• Procedure violates physician's moral or religious beliefs<br>• Physician does NOT withhold this from patient in an emergency<br>• Physician provides adequate referral to a willing provider<br>• Patient care is not abandoned<br><br><b>Examples:</b> Abortion, assisted dying, sterilization<br><br><i>Limits: Cannot refuse care in emergencies. Must ensure patient can access care. Cannot abandon existing patients without proper transfer.</i>" },
  { q: "What is <b>patient abandonment</b>?", a: "Unilateral termination of physician-patient relationship without adequate notice or provision for alternative care<br><br>• Illegal and unethical<br>• Physician can end relationship but must: give adequate notice (typically 30 days), provide emergency care during transition, assist in finding new provider, transfer records<br><br><i>Conscientious objection does NOT give physician the right to abandon patients. Even if refusing a specific procedure, must continue other care or ensure safe transfer.</i>" },
  { q: "What is the difference between <b>confidentiality</b> and <b>privacy</b> in medicine?", a: "<b>Privacy</b>: Patient's right to control access to their personal information and body<br><br><b>Confidentiality</b>: Physician's duty to protect information shared within the therapeutic relationship<br><br>• Privacy is a right (broader concept)<br>• Confidentiality is a professional obligation (narrower, applies to clinical disclosures)<br>• Both are protected by HIPAA, common law, and professional ethics codes<br><br><i>Confidentiality is derived from respect for privacy. Breaching confidentiality violates patient privacy.</i>" },
  { q: "What is the <b>Cruzan v. Director</b> case significance?", a: "<b>Cruzan v. Director, Missouri Dept. of Health (1990)</b> — landmark SCOTUS case<br><br>• Nancy Cruzan: persistent vegetative state after car accident<br>• Family sought to withdraw feeding tube<br>• Missouri required 'clear and convincing evidence' of patient's wishes<br>• SCOTUS: competent persons have constitutional right to refuse life-sustaining treatment<br>• Incompetent patients: states can set evidentiary standards for surrogate decisions<br><br><i>Led to the Patient Self-Determination Act (1990) requiring hospitals to inform patients about advance directives</i>" },
  { q: "What is the <b>Patient Self-Determination Act (PSDA)</b>?", a: "Federal law (1991) requiring healthcare institutions receiving Medicare/Medicaid funding to:<br><br>1. Inform patients of their rights to make decisions about their care<br>2. Inform patients of their right to have an advance directive<br>3. Inquire and document whether patient has an advance directive<br>4. Not discriminate against patients based on advance directive status<br>5. Educate staff and community about advance directives<br><br><i>Passed in response to Cruzan decision. Applied to hospitals, nursing homes, home health agencies, hospices, and managed care organizations.</i>" },
  { q: "What is a <b>surrogate's standard</b> if patient's exact wishes are unknown?", a: "<b>Best interest standard</b> — used when substituted judgment is impossible (patient never had capacity, or wishes completely unknown)<br><br>• 'What would a reasonable person in this patient's situation want?'<br>• Considers quality of life, burdens of treatment, prognosis<br>• Surrogate must set aside their own wishes<br><br><i>Hierarchy: Substituted judgment (patient's known wishes) > best interest (reasonable person standard). Always try substituted judgment first.</i>" },
  { q: "What is the <b>Quinlan case</b> significance?", a: "<b>In re Quinlan (1976)</b> — NJ Supreme Court<br><br>• Karen Ann Quinlan: persistent vegetative state (drug/alcohol overdose)<br>• Father sought to remove ventilator<br>• NJ Supreme Court: family/guardian can authorize withdrawal of life-sustaining treatment<br><br><b>Legacy:</b><br>• Established legal right to withdraw life support<br>• Led to creation of hospital ethics committees<br>• Distinguished 'extraordinary' from 'ordinary' treatment<br><br><i>Landmark case establishing withdrawal of life support as permissible</i>" },
  { q: "What is the <b>Schiavo case</b> and its ethical significance?", a: "<b>Terri Schiavo (2005)</b>: Woman in persistent vegetative state; 15-year legal battle<br><br>• Husband (legal surrogate) sought to withdraw feeding tube per her alleged wishes<br>• Parents disagreed<br>• Congressional and presidential intervention (unusual political involvement)<br>• Courts ultimately ruled to allow withdrawal<br><br><b>Legacy:</b><br>• Highlighted importance of written advance directives<br>• Showed danger of surrogate conflict<br>• Led to increased advance directive awareness<br><br><i>Key lesson: DOCUMENT advance directives clearly and in writing</i>" },
  { q: "Can a patient <b>revoke informed consent</b> after giving it?", a: "<b>Yes</b> — a competent patient can withdraw consent at any time, even mid-procedure if possible<br><br>• Consent is not irrevocable<br>• Must stop procedure if patient withdraws consent (if clinically safe to do so)<br>• Patient must be informed that withdrawal is possible<br>• If stopping mid-procedure would cause more harm than completing it → complete and discuss after<br><br><i>Consent is an ongoing process, not a one-time event</i>" },
  { q: "What is <b>informed consent for HIV disclosure to partners</b>?", a: "Physician's duty when HIV+ patient refuses to disclose to partners:<br><br>1. Strongly encourage disclosure<br>2. May report to public health authorities (state-specific mandatory reporting)<br>3. Duty to warn partners directly: depends on state law — some require, some allow, some prohibit<br><br><b>Legal variation:</b><br>• Tarasoff-type duty may apply if specific identifiable partner at risk<br>• CDC and AMA support disclosure when non-disclosure poses serious risk<br><br><i>Document all discussions; involve ethics committee in difficult cases</i>" },
  { q: "What is the <b>'captain of the ship'</b> doctrine in surgical consent?", a: "Historical doctrine: attending surgeon bears ultimate responsibility for all actions in the operating room (including residents, nurses)<br><br>• Largely abandoned in modern law<br>• Individual providers now have independent liability<br>• Attending surgeon retains oversight responsibility<br><br><i>Relevant to informed consent: attending surgeon is ultimately responsible for ensuring valid informed consent, even if a resident obtains it. Delegation to uninformed staff is not acceptable.</i>" },
  { q: "What is <b>capacity in end-of-life decisions</b> — higher threshold?", a: "Decisions about life-sustaining treatment withdrawal carry<br><b>higher threshold</b> for demonstrating capacity (sliding scale principle)<br><br>• Must demonstrate robust understanding, appreciation, reasoning, and stable expression<br>• Psychiatry often consulted<br>• Must ensure decision is not driven by undertreated depression or delirium<br>• Document multiple capacity assessments over time<br><br><i>Key USMLE: when a patient requests withdrawal of ventilator/feeding tube, always assess capacity thoroughly and address treatable conditions (depression, pain) first</i>" },
  { q: "What is <b>surrogate consent for research</b>?", a: "When research participants lack decision-making capacity:<br><br>• LAR (Legally Authorized Representative) provides consent<br>• Research must provide direct benefit to participant OR minimal risk with benefit to group<br>• As participant gains capacity, their own consent must be obtained<br>• Participant's assent still sought<br><br><i>Additional IRB protections required when enrolling incapacitated subjects. Cannot enroll incapacitated subjects in higher-than-minimal-risk research without direct benefit.</i>" },
  { q: "What is the <b>Belmont Report</b>'s application to clinical practice?", a: "While the Belmont Report (1979) was written for research ethics, its principles apply broadly:<br><br>• <b>Respect for persons (autonomy)</b>: informed consent in clinical care<br>• <b>Beneficence</b>: acting in patient's best interest; maximizing benefit/minimizing harm<br>• <b>Justice</b>: equitable access to care; not exploiting vulnerable patients<br><br><i>Belmont principles ≈ Beauchamp & Childress 4 principles (autonomy, beneficence, non-maleficence, justice). Both frameworks are widely used in medical ethics.</i>" },
  { q: "What is the significance of <b>Schloendorff v. Society of New York Hospital (1914)</b>?", a: "Early landmark case establishing right to bodily autonomy in medicine<br><br>Judge Cardozo: '<i>Every human being of adult years and sound mind has a right to determine what shall be done with his own body; and a surgeon who performs an operation without his patient's consent commits an assault for which he is liable in damages.</i>'<br><br><i>Foundation of informed consent doctrine in US law. First major case establishing bodily autonomy as fundamental principle.</i>" },
  { q: "What are <b>exceptions to confidentiality</b> specifically for <b>adolescents</b>?", a: "Most states allow adolescent confidentiality for:<br>• STI testing/treatment<br>• Contraception<br>• Pregnancy-related care<br>• Substance abuse treatment<br>• Mental health services (varies)<br><br><b>Limits:</b><br>• Child abuse must still be reported<br>• Imminent danger to self/others → may need to notify parents<br>• Some states require parental notification for abortion<br><br><i>Goal: encourage adolescents to seek care without fear of parental disclosure. Balance adolescent confidentiality vs parental rights.</i>" },
  { q: "What is the <b>minimum necessary standard</b> under HIPAA?", a: "Healthcare providers should disclose only the <b>minimum necessary</b> PHI to accomplish the intended purpose<br><br>• When releasing records: don't share entire record if only specific info needed<br>• Workforce access: limit access to PHI based on job function<br>• Exception: treating providers — can access all necessary information for treatment (minimum necessary does not apply to treatment)<br><br><i>Reduces privacy breaches by limiting unnecessary exposure of health information</i>" },
  { q: "What is a <b>breach of confidentiality</b> vs a <b>HIPAA violation</b>?", a: "<b>Breach of confidentiality:</b> Ethical/legal violation — improper disclosure of patient health information (broader concept, common law, professional ethics)<br><br><b>HIPAA violation:</b> Specific federal statutory violation of HIPAA privacy or security rules<br><br>• A HIPAA violation is always a breach of confidentiality<br>• A breach of confidentiality may not always be a HIPAA violation (e.g., small practice not covered entity)<br><br><i>HIPAA has civil and criminal penalties. Ethical violations may result in professional sanctions.</i>" },
  { q: "What is informed consent for <b>electroconvulsive therapy (ECT)</b>?", a: "ECT requires <b>enhanced informed consent</b> due to its controversial history and risks:<br><br>• Procedure explanation (induced seizure)<br>• Risks: memory loss (anterograde/retrograde), headache, confusion, anesthesia risks<br>• Benefits for severe depression/catatonia<br>• Alternatives: medications, TMS<br>• Right to refuse and withdraw<br><br><b>Special considerations:</b><br>• If patient lacks capacity: surrogate can consent<br>• Some states require court order for ECT in incapacitated patients<br><br><i>Most states do NOT allow involuntary ECT except in extreme emergencies</i>" },
  { q: "What is the role of <b>proxy decision-making in organ transplant</b>?", a: "Competent transplant candidates consent for themselves<br><br>For incapacitated potential recipients:<br>• Surrogate can consent to organ transplantation<br>• Must apply substituted judgment or best interest standard<br>• Transplant team must ensure medical suitability<br><br>For living donors:<br>• Must be competent adults<br>• Minors and incapacitated persons generally cannot be living donors<br>• Donation must be voluntary and without undue inducement<br><br><i>Special ethics review for living donor cases — separate donor advocate required</i>" },
  { q: "What is <b>futility</b> and can it override patient/surrogate requests for treatment?", a: "<b>Medical futility</b>: Treatment that cannot achieve its physiologic goal OR offers no benefit (or is harmful) relative to goals of care<br><br>• Physicians are NOT obligated to provide clearly futile treatment<br>• <b>Quantitative futility</b>: <1% chance of success<br>• <b>Qualitative futility</b>: treatment would not achieve acceptable quality of life<br><br><i>Controversial — surrogates often demand 'everything.' Ethics committee involvement recommended. Physicians may offer treatment alternatives but cannot be forced to provide futile interventions.</i>" },
  { q: "What is 'slow code' and is it ethical?", a: "<b>Slow code</b>: Performing CPR in a perfunctory manner with no intention of achieving resuscitation (going through the motions)<br><br>• <b>UNETHICAL</b> — deceptive to family; does not honor patient dignity<br>• Violates honesty and informed consent principles<br>• If CPR is truly futile: obtain DNR order or ethics committee guidance<br>• Never appropriate as substitute for honest communication<br><br><i>The ethical alternative is an honest conversation about resuscitation goals and obtaining a DNR if appropriate</i>" },
  { q: "What is the difference between <b>withholding</b> and <b>withdrawing</b> life-sustaining treatment ethically?", a: "Ethically and legally: <b>No morally significant difference</b><br><br>• Both require patient/surrogate consent<br>• Both can be appropriate based on patient's wishes and prognosis<br>• Starting then stopping is NOT worse than never starting<br>• Emotional impact on providers may differ (harder to stop), but ethical obligations are equivalent<br><br><i>Courts (Cruzan, Quinlan) and medical ethics consistently hold withholding = withdrawal ethically. Clinicians should not be more willing to withhold than withdraw.</i>" },
  { q: "What is the <b>double effect principle</b> in ethics?", a: "An action with both a good and harmful effect may be permissible if:<br>1. The action itself is not evil<br>2. The agent intends only the good effect<br>3. The good effect doesn't flow from the bad effect<br>4. Sufficient reason exists to justify the harm<br><br><b>Medical application:</b> High-dose morphine for pain relief in dying patient may hasten death — permissible because intent is pain relief, not death<br><br><i>Distinguishes from euthanasia: intent matters. Palliative sedation is ethically permissible under this principle.</i>" },
  { q: "What is <b>palliative sedation</b> vs <b>physician-assisted suicide</b>?", a: "<b>Palliative sedation:</b> Sedatives titrated to relieve refractory suffering at end of life; may secondarily hasten death — ethical and legal<br><br><b>Physician-assisted suicide (PAS/MAID):</b> Physician prescribes lethal medication the patient self-administers — legal in some US states (OR, WA, CA, etc.)<br><br><b>Euthanasia:</b> Physician administers lethal medication — illegal in all US states<br><br><i>Key distinction: in palliative sedation, death is not the goal. In PAS, the medication directly causes death at patient's request.</i>" },
  { q: "What is <b>voluntarily stopping eating and drinking (VSED)</b>?", a: "Competent patient intentionally refuses all nutrition and hydration to hasten death<br><br>• Legal everywhere in US<br>• Ethically accepted by most professional organizations<br>• Patient must have decision-making capacity<br>• Palliative care to relieve discomfort during the process<br>• Advance directive for VSED can be made for future incapacity<br><br><i>Alternative to PAS in states where PAS is not legal. Typically takes 1-2 weeks. Hospice may support VSED patients.</i>" },
  { q: "What is the ethical issue with <b>gifts from patients</b>?", a: "<b>Gifts from patients</b>: potential conflict of interest and boundary issue<br><br>• Small, inexpensive gifts: generally acceptable<br>• Large, expensive gifts: problematic — may create sense of obligation, alter professional relationship<br>• Gifts from patients seeking prescriptions/special favors: refuse<br>• Declining a gift may be offensive; use judgment<br><br><i>Professional boundaries are essential. If uncertain, consult ethics committee or colleague.</i>" },
  { q: "What is the ethical obligation regarding <b>social media and patient privacy</b>?", a: "<b>Physicians must:</b><br>• Never post identifiable patient information without consent<br>• Never post photos/videos of patients or their conditions (even 'de-identified' if identifiable)<br>• Maintain professional boundaries with patients online<br>• Be cautious about accepting patient friend requests<br><br><i>HIPAA and professional ethics both apply online. Even de-identified cases can violate privacy if identifiable. 'What happens online, stays online.'</i>" },
  { q: "What is the role of <b>religion and spirituality</b> in informed consent?", a: "Religious/spiritual beliefs may influence patient's healthcare decisions<br><br>• Physician must respect religious-based refusals from competent adults (e.g., Jehovah's Witness blood refusal)<br>• Must ensure decision is truly the patient's own (not coerced by religious community)<br>• Physician may express concern but must ultimately respect autonomy<br>• Chaplaincy services can be helpful<br><br><i>Religion is part of patient's values — relevant to substituted judgment and advance care planning</i>" },
  { q: "What is <b>capacity for advance directive completion</b>?", a: "To complete a valid advance directive, a person must have <b>decision-making capacity</b> at the time of signing<br><br>• Written advance directives completed when patient had capacity are valid even after they lose it<br>• If patient lacks capacity when coming to hospital → existing advance directives are honored<br>• Once dementia is severe: may lack capacity to create new or modify existing ADs<br><br><i>Encourage completion of advance directives BEFORE capacity is lost. Best done during routine outpatient care.</i>" },
  { q: "What are the <b>legal requirements for an advance directive</b>?", a: "Requirements vary by state but typically include:<br><br>• Patient must be an adult (18+) and have capacity at signing<br>• Written document<br>• Dated signature<br>• Witnessed by 2 adults (typically not family members or healthcare providers)<br>• Notarization (some states)<br><br><i>Physicians should not be witnesses to advance directives of their own patients in most states. Forms available from state health departments.</i>" },
  { q: "What is a '<b>Do Not Hospitalize</b>' (DNH) order?", a: "Order used primarily in nursing home/long-term care settings indicating patient should NOT be transferred to hospital for most conditions<br><br>• Used for patients with serious illness, poor prognosis, comfort-focused goals<br>• Part of POLST/MOLST orders<br>• Emergency care and comfort care continue in facility<br>• Does not mean 'do not treat' — comfort measures continue<br><br><i>Important for seriously ill nursing home patients who prefer to die in familiar setting</i>" },
  { q: "What is the ethical framework for <b>resource allocation</b> in a pandemic (triage)?", a: "<b>Crisis standards of care</b> — ethical principles guiding allocation of scarce resources:<br><br>1. <b>Maximize lives saved</b> (utilitarian)<br>2. <b>Short-term prognosis</b> — prioritize those likely to survive<br>3. <b>Equal opportunity</b> — lottery if prognosis equal<br>4. <b>Prioritize essential workers</b> (some frameworks)<br>5. <b>First-come-first-served</b> (routine, not crisis standard)<br><br><i>Age and social utility are generally excluded from triage criteria (avoid discrimination). Triage committees vs. individual physician decisions.</i>" },
  { q: "What is the <b>Americans with Disabilities Act (ADA)</b> relevance to medical consent?", a: "ADA requires healthcare providers to provide equal access and effective communication for patients with disabilities<br><br>• Auxiliary aids: sign language interpreters, written materials in Braille, picture boards<br>• Reasonable accommodations during consent process<br>• Disability ≠ incapacity — assess capacity individually<br>• Cannot deny treatment based on disability alone<br><br><i>The consent process must be accessible. A deaf patient has the right to a sign language interpreter for informed consent discussions.</i>" },
  { q: "What is <b>medical futility</b> vs <b>physician discomfort</b>?", a: "<b>Medical futility:</b> Objective determination that treatment cannot achieve physiologic goal<br><br><b>Physician discomfort:</b> Subjective feeling that a patient's treatment choice is unwise or burdensome to provide<br><br>• Physician discomfort is NOT futility<br>• Cannot withhold beneficial treatment due to physician's value judgment<br>• Can express disagreement and offer alternatives<br>• Can seek ethics committee guidance<br><br><i>Physicians have limited leeway to impose their values. True futility is a narrow concept.</i>" },
  { q: "What is the <b>four-box method</b> of clinical ethics consultation?", a: "Structured approach to clinical ethics analysis (Jonsen, Siegler, Winslade):<br><br>1. <b>Medical indications</b>: diagnosis, prognosis, goals of treatment, benefits/burdens<br>2. <b>Patient preferences</b>: values, informed decisions, advance directives, capacity<br>3. <b>Quality of life</b>: patient's perspective on acceptable quality, biases of caregivers<br>4. <b>Contextual features</b>: family, culture, religion, finances, law, resource allocation<br><br><i>Systematically ensures all ethical dimensions are considered in complex cases</i>" },
          ]
        },
{
          section: 'Ethics, Law & Health Systems',
          topic: "End-of-life care & advance directives",
          icon: "heart-handshake",
          cards: [
            { q: "What is an advance directive?", a: "A legal document in which a patient specifies their preferences for medical care in the event they lose <b>decision-making capacity</b>." },
{ q: "What are the two primary components of an advance directive?", a: "A <b>living will</b> (written instructions) and a <b>durable power of attorney for healthcare</b> (healthcare proxy)." },
{ q: "What is a living will?", a: "A document containing <b>specific instructions</b> regarding which treatments a patient wants to receive or refuse (e.g., ventilator, PEG tube) if they become terminally ill or permanently vegetative." },
{ q: "What is a Durable Power of Attorney for Healthcare (DPOAH)?", a: "A legal document that designates a surrogate decision-maker (<b>healthcare proxy</b>) to make medical decisions on the patient's behalf if they lose capacity." },
{ q: "If a patient has both a living will and a healthcare proxy, which takes precedence in the event of an ambiguous scenario?", a: "The <b>healthcare proxy</b> takes precedence, as the proxy can interpret the patient's values and apply them to the specific clinical situation." },
{ q: "What is the medical definition of 'decision-making capacity'?", a: "A clinical determination of a patient's ability to <b>understand</b> a decision, <b>appreciate</b> the consequences, <b>reason</b> through options, and <b>communicate</b> a choice." },
{ q: "How does clinical 'capacity' differ from legal 'competence'?", a: "<b>Capacity</b> is determined by a clinician for a specific decision at a specific time; <b>competence</b> is a global legal status determined only by a judge." },
{ q: "Can an advance directive be executed by a patient who has been declared legally incompetent?", a: "<b>No</b>. A patient must have <b>decision-making capacity</b> at the time of signing for the advance directive to be legally valid." },
{ q: "When does a healthcare proxy's decision-making authority become active?", a: "Only after the patient's attending physician determines that the patient <b>lacks decision-making capacity</b>." },
{ q: "Can a competent patient override their own previously written advance directive?", a: "<b>Yes</b>. A competent patient's current, spoken wishes <b>always take precedence</b> over any written advance directive." },
{ q: "What is the ethical justification for honoring advance directives?", a: "The ethical principle of <b>autonomy</b>, which extends the patient's right to self-determination even after they lose the capacity to speak for themselves." },
{ q: "Under what circumstances can an oral (spoken) advance directive be considered valid?", a: "When the patient was competent at the time and made <b>clear, specific, and repeated statements</b> about their end-of-life wishes, particularly in the presence of family or physicians." },
{ q: "What is the legal standard of proof typically required to honor an oral advance directive?", a: "The <b>'clear and convincing evidence'</b> standard, requiring high certainty that the oral statements represented the patient's settled wishes." },
{ q: "What is the 'substituted judgment standard'?", a: "The rule that a surrogate must make decisions based on what they believe the <b>patient would have chosen</b>, using the patient's known values, beliefs, and past statements." },
{ q: "What is the 'best interests standard'?", a: "The rule that a surrogate must make decisions that maximize <b>clinical benefit and minimize harm</b> for the patient when the patient's own wishes are completely unknown." },
{ q: "What is the typical default hierarchy of surrogate decision-makers if a patient lacks capacity and has no advance directive?", a: "Spouse $\\\\rightarrow$ Adult children $\\\\rightarrow$ Parents $\\\\rightarrow$ Adult siblings $\\\\rightarrow$ Other relatives." },
{ q: "If a patient has multiple adult children who disagree on the course of action, what is the physician's first step?", a: "Convene a <b>family meeting</b> to clarify the medical situation, discuss the patient's values, and attempt to reach a consensus." },
{ q: "If a family dispute regarding end-of-life care cannot be resolved through family meetings, what is the next step?", a: "Consult the hospital's <b>Ethics Committee</b> to help mediate the dispute and clarify ethical duties." },
{ q: "Can a physician refuse to follow a surrogate's decision if it is clearly contrary to the patient's known wishes?", a: "<b>Yes</b>. The physician is ethically obligated to protect the patient's autonomy and should consult the <b>ethics committee</b> to resolve the conflict." },
{ q: "What is the legal status of an advance directive if the patient is pregnant?", a: "In many U.S. states, pregnancy <b>restricts or suspends</b> the advance directive if the fetus is viable, requiring life-sustaining treatment to continue." },
{ q: "Can a patient revoke an advance directive at any time?", a: "<b>Yes</b>. It can be revoked at <b>any time</b> and in <b>any manner</b> (orally, in writing, or by destroying the document) as long as the patient has capacity." },
{ q: "Who is legally prohibited from serving as a patient's surrogate decision-maker?", a: "Generally, members of the <b>treatment team</b> (physicians, nurses) cannot serve as proxies unless they are related to the patient by blood or marriage." },
{ q: "What is a POLST (Physician Orders for Life-Sustaining Treatment)?", a: "A set of <b>actionable medical orders</b> signed by a physician that translates a patient's end-of-life preferences into immediately executable medical instructions." },
{ q: "How does a POLST differ from a living will in terms of applicability?", a: "A POLST is a set of <b>active medical orders</b> valid across all settings (home, EMS, hospital); a living will is a statement of wishes that must be translated into orders." },
{ q: "What happens if an incapacitated patient has no surrogate decision-maker and no advance directive?", a: "The medical team must consult the <b>ethics committee</b> or seek a <b>court-appointed guardian</b> to make decisions." },
{ q: "Does a patient's advance directive apply during a temporary, reversible condition?", a: "Typically <b>no</b>; most advance directives only apply if the patient has a <b>terminal, incurable condition</b> or is in a persistent vegetative state." },
{ q: "What should a physician do if a patient with an advance directive is admitted to the hospital?", a: "Place a copy of the advance directive in the <b>medical record</b>, discuss it with the patient/proxy to confirm its details, and document the discussion." },
{ q: "What is a 'values history' questionnaire?", a: "A tool that helps patients identify and document their <b>overarching goals and values</b> regarding quality of life, pain, and dependency to guide future surrogate decisions." },
{ q: "What does a Do Not Resuscitate (DNR) order specifically command?", a: "That <b>no cardiopulmonary resuscitation (CPR)</b> be initiated in the event of cardiac or respiratory arrest." },
{ q: "What does a Do Not Intubate (DNI) order specifically command?", a: "That the patient <b>not be intubated</b> or placed on mechanical ventilation, though they may still receive chest compressions or non-invasive ventilation (e.g., CPAP)." },
{ q: "Does a DNR order mean 'do not treat' other conditions?", a: "<b>No</b>. A DNR only applies to cardiac/respiratory arrest. The patient must receive full medical care, including antibiotics, pressors, and surgeries, as appropriate." },
{ q: "What is an out-of-hospital DNR (OOH-DNR) order?", a: "A specific legal document or bracelet that instructs <b>Emergency Medical Services (EMS)</b> not to perform CPR in the community." },
{ q: "Can EMS honor a standard hospital DNR order when called to a patient's home?", a: "<b>No</b>. EMS can only honor official, state-approved <b>out-of-hospital DNR orders</b> or bracelets." },
{ q: "If a patient has a valid DNR order and the family demands CPR when the patient arrests, what should the physician do?", a: "<b>Honor the DNR order</b> and withhold CPR, while providing support and explanation to the family." },
{ q: "What is a 'slow code'?", a: "The unethical practice of performing CPR in a <b>deliberately slow or ineffective manner</b> to appease the family while ensuring the patient dies." },
{ q: "Why is a 'slow code' considered unethical?", a: "It is <b>deceptive</b>, violates professional integrity, ignores patient autonomy, and fails to respect the dignity of the patient." },
{ q: "If a patient's family demands CPR, but the medical team believes it is physiologically futile, is the physician obligated to perform it?", a: "Physicians are <b>not obligated to provide futile care</b>, but they must discuss this with the family, consult ethics, and offer to transfer care before unilaterally writing a DNR." },
{ q: "What is the default policy for DNR orders in the operating room (OR)?", a: "DNR orders are <b>not automatically cancelled</b>; they must be discussed and either suspended, modified, or maintained prior to surgery." },
{ q: "What is 'procedure-directed' modification of a DNR in the OR?", a: "An agreement where specific resuscitative measures are allowed only if they are <b>directly caused by the anesthesia or surgical procedure</b>." },
{ q: "What is the survival-to-discharge rate for in-hospital CPR in unselected patients?", a: "Approximately <b>15–20%</b>, and significantly lower (<b>$\\\\text{< } 2\\\\%$</b>) in patients with advanced metastatic cancer or multi-organ failure." },
{ q: "Does a DNI order prohibit the use of non-invasive ventilation (e.g., BiPAP or CPAP)?", a: "<b>No</b>, unless the patient has specifically refused non-invasive ventilation. NIPPV is often used for comfort or short-term support." },
{ q: "If a patient with a DNR attempts suicide and is found in respiratory distress, how should the physician proceed?", a: "The DNR should be <b>suspended</b> because it was written under the assumption of a natural death, not acute, self-inflicted harm." },
{ q: "If a patient is transferred from an outside facility with a DNR, does it remain active?", a: "<b>No</b>. A new DNR order must be written by the receiving physician after evaluating the patient." },
{ q: "Under what emergency circumstances can a physician write a DNR without surrogate consent?", a: "Only when CPR is deemed <b>physiologically futile</b>, and the surrogate is unreachable, or after following the hospital's futile care protocol and ethics consultation." },
{ q: "What is a 'chemical code only' order?", a: "An order where resuscitative drugs (e.g., epinephrine) are given during arrest, but <b>chest compressions and intubation are withheld</b> (generally discouraged)." },
{ q: "Who must sign a pediatric DNR order?", a: "The child's <b>parents or legal guardians</b>, after thorough discussion with the pediatric clinical team." },
{ q: "How does a DNR order affect intensive care unit (ICU) admission?", a: "A DNR <b>does not prevent ICU admission</b> if the patient requires invasive monitoring or non-resuscitative intensive therapies." },
{ q: "If a surrogate wishes to rescind a patient's DNR order, what must the physician verify first?", a: "Verify if the surrogate has the legal authority and if the change aligns with the patient's previously expressed values." },
{ q: "What is the difference between a DNR order and Comfort Measures Only (CMO)?", a: "A DNR only addresses <b>resuscitation during arrest</b>; CMO redirects all medical efforts toward comfort and symptom relief, discontinuing curative treatments." },
{ q: "If an emergency occurs and a patient's DNR status is unknown, what is the physician's duty?", a: "<b>Initiate full resuscitation</b>. The default presumption in emergency medicine is in favor of preserving life." },
{ q: "What is the legal and ethical consensus on withholding vs. withdrawing life-sustaining treatment?", a: "They are <b>ethically and legally equivalent</b>; there is no greater moral weight to stopping a treatment than to not starting it." },
{ q: "Does withdrawing mechanical ventilation from a terminally ill patient constitute active killing?", a: "<b>No</b>. It is the removal of an artificial barrier, allowing the <b>underlying disease</b> to cause death naturally." },
{ q: "What is the primary clinical goal during the withdrawal of mechanical ventilation?", a: "To maximize <b>patient comfort</b> and prevent air hunger (dyspnea), agitation, or pain." },
{ q: "What is 'terminal weaning' of mechanical ventilation?", a: "The <b>gradual reduction</b> of oxygen concentrations (FiO2) and ventilator pressures, allowing the patient to slowly transition to breathing on their own." },
{ q: "What is 'immediate extubation' in the context of withdrawal of care?", a: "The <b>rapid removal</b> of the endotracheal tube after ensuring adequate sedation and analgesia are in place." },
{ q: "Which medications are first-line for managing dyspnea during ventilator withdrawal?", a: "<b>Opioids</b> (e.g., morphine infusion) because they reduce respiratory drive and relieve the sensation of air hunger." },
{ q: "What is the 'death rattle' and how is it managed pharmacologically?", a: "Coarse breathing from pooled secretions in the upper airway; managed with <b>anticholinergic agents</b> (e.g., glycopyrrolate or scopolamine) to dry secretions." },
{ q: "Is it ethically permissible to withdraw artificial nutrition and hydration (ANH)?", a: "<b>Yes</b>. ANH is considered a medical intervention and can be withdrawn if it no longer benefits the patient or aligns with their wishes." },
{ q: "Why is artificial hydration often withheld or withdrawn in actively dying patients?", a: "Dehydration reduces <b>pulmonary secretions, pleural effusions, peripheral edema, and ascites</b>, improving overall comfort." },
{ q: "Does withdrawing feeding tubes cause painful starvation in actively dying patients?", a: "<b>No</b>. Fasting leads to ketosis, which has a <b>mild anesthetic effect</b> and suppresses hunger, while dry mouth can be managed with local oral care." },
{ q: "What is the recommendation for using gastrostomy tubes (PEG) in patients with advanced dementia?", a: "<b>Strongly discouraged</b>; PEG tubes do not prolong life, prevent aspiration, or improve comfort in advanced dementia. Hand feeding is preferred." },
{ q: "Is deactivating an Implantable Cardioverter-Defibrillator (ICD) at the end of life ethical?", a: "<b>Yes</b>. Deactivation prevents <b>painful, inappropriate shocks</b> as the patient's heart fails, allowing a peaceful death." },
{ q: "Does deactivating a pacemaker at the end of life constitute active euthanasia?", a: "<b>No</b>. It is the withdrawal of a medical intervention, allowing the patient's underlying cardiac pathology to take its course." },
{ q: "What is a 'time-limited trial' of life-sustaining treatment?", a: "An agreement to try an intervention (e.g., ventilator) for a <b>specified duration</b> to see if the patient improves, with a plan to withdraw it if goals are not met." },
{ q: "What should be done with physiological monitors (e.g., telemetry, pulse oximetry) when withdrawing care?", a: "They should be <b>turned off</b> to avoid distracting the family with alarms and numbers, shifting focus to the patient's physical comfort." },
{ q: "What is the role of neuromuscular blocking agents (paralytics) during ventilator withdrawal?", a: "They must be <b>discontinued and allowed to clear</b> before withdrawal to ensure the clinical team can assess and treat the patient's pain or dyspnea." },
{ q: "Can a competent patient demand the withdrawal of life support even if they are not terminally ill?", a: "<b>Yes</b>. A competent adult has the <b>absolute right</b> to refuse any medical treatment, even if it leads to death." },
{ q: "If a surrogate requests withdrawal of care, but the physician conscientiously objects, what must the physician do?", a: "Ensure the patient is cared for and arrange to <b>transfer the patient's care</b> to another physician who will honor the request." },
{ q: "Can a surrogate demand withdrawal of life support if the patient's written living will states they want 'all life-prolonging measures'?", a: "<b>No</b>. The surrogate is bound to follow the <b>substituted judgment standard</b> and cannot contradict the patient's explicit, written autonomous instructions." },
{ q: "How does terminal weaning differ from euthanasia?", a: "Terminal weaning allows death to occur from the <b>underlying illness</b>; euthanasia involves the active administration of a lethal agent to cause death." },
{ q: "What is active euthanasia?", a: "The <b>direct administration of a lethal drug</b> by a physician to end a patient's life, usually at the patient's request." },
{ q: "What is passive euthanasia?", a: "The withholding or withdrawing of <b>life-sustaining medical treatment</b>, allowing the patient to die of their underlying disease." },
{ q: "What is Physician-Assisted Suicide (PAS), or Medical Aid in Dying (MAID)?", a: "The practice where a physician <b>prescribes a lethal dose of medication</b> that the patient <b>self-administers</b> to end their life." },
{ q: "What is the legal status of active euthanasia in the United States?", a: "It is <b>illegal in all 50 states</b> and is prosecuted as homicide." },
{ q: "Is Physician-Assisted Suicide legal in the United States?", a: "It is <b>legal in several states</b> (e.g., Oregon, Washington, California) under specific state-legislated guidelines, but has no federal mandate." },
{ q: "What is the prognosis requirement for a patient to qualify for PAS/MAID?", a: "The patient must have a documented <b>terminal illness</b> with a life expectancy of <b>$\\\\text{< } 6\\\\text{ months}$</b>." },
{ q: "Can a healthcare proxy request PAS/MAID for an incapacitated patient?", a: "<b>No</b>. The request for PAS/MAID must be made <b>voluntarily and solely by the patient</b>; surrogates cannot request it." },
{ q: "What is the Principle of Double Effect (Doctrine of Double Effect)?", a: "The ethical rule that an action with a foreseen bad effect is permissible if the <b>primary intent is a good effect</b> (e.g., comfort), and the bad effect is not the direct means to the good." },
{ q: "How does the Principle of Double Effect apply to end-of-life opioid administration?", a: "It justifies giving high-dose opioids for pain relief, even if it <b>foreseeably hastens death</b> (due to respiratory depression), because the primary intent is analgesia." },
{ q: "If a doctor administers an opioid with the primary intent of stopping the patient's breathing to end suffering, does this fall under the double effect?", a: "<b>No</b>. The intent is to cause death, which constitutes <b>active euthanasia</b> and is illegal." },
{ q: "What did the Supreme Court decide in Washington v. Glucksberg?", a: "It ruled that there is <b>no constitutional right to physician-assisted suicide</b>, leaving states free to ban or permit the practice." },
{ q: "What is the difference between 'intent' and 'foresight' in the Principle of Double Effect?", a: "<b>Intent</b> is the physician's clinical goal (pain relief); <b>foresight</b> is the anticipation of possible side effects (respiratory depression, death) which are tolerated but not desired." },
{ q: "What is 'palliative sedation' (terminal sedation)?", a: "The use of sedative medications (e.g., midazolam) to induce <b>continuous unconsciousness</b> in a terminally ill patient with refractory, intolerable symptoms." },
{ q: "Is palliative sedation legally or ethically considered euthanasia?", a: "<b>No</b>. The primary intent is to <b>relieve refractory symptoms</b> by reducing consciousness, not to shorten the patient's life." },
{ q: "What is the most common reason cited by patients requesting Physician-Assisted Suicide?", a: "Loss of <b>autonomy and control</b> over their lives, rather than uncontrolled physical pain." },
{ q: "If a patient requesting PAS has suspected clinical depression, what is the mandatory next step?", a: "Referral to a <b>psychiatrist</b>; if depression is impairing decision-making capacity, PAS cannot be authorized until treated." },
{ q: "Can a physician legally administer the lethal dose prescribed for PAS if the patient is physically unable to do so?", a: "<b>No</b>. The patient must self-administer the medication; clinician administration constitutes <b>active euthanasia</b>, which is illegal." },
{ q: "What is the role of conscientious objection in physician-assisted suicide?", a: "Physicians in states where PAS is legal are <b>never forced to participate</b>; they may conscientiously object and decline to prescribe." },
{ q: "What are the typical waiting period requirements for a patient requesting PAS?", a: "Most states require <b>two oral requests</b> separated by a specific period (e.g., 15 days) and one written request." },
{ q: "Under the Principle of Double Effect, does the bad effect (death) have to be proportional to the good effect?", a: "<b>Yes</b>. There must be a <b>proportional, grave reason</b> (e.g., severe, refractory pain in a dying patient) to justify risking the bad effect." },
{ q: "What class of medications is most commonly used for self-administered physician-assisted suicide?", a: "High-dose <b>barbiturates</b> (e.g., secobarbital) or specific oral multi-drug combinations designed to cause rapid cardiac arrest." },
{ q: "If a patient asks a physician, 'Can you help me die?', what is the physician's immediate professional response?", a: "Explore the <b>underlying causes of distress</b> (physical, psychological, spiritual) and reassure the patient that their symptoms will be aggressively managed." },
{ q: "What is the primary difference between palliative care and hospice care?", a: "<b>Palliative care</b> can be initiated at any stage of a serious illness concurrent with curative therapy; <b>hospice care</b> requires a prognosis of <b>$\\\\text{< } 6\\\\text{ months}$</b> and cessation of curative treatment." },
{ q: "What is the prognosis requirement for admission to hospice care?", a: "A documented life expectancy of <b>$\\\\text{< } 6\\\\text{ months}$</b>, assuming the disease runs its natural course." },
{ q: "How many physicians must certify the terminal prognosis for initial hospice enrollment?", a: "<b>Two physicians</b>: the patient's attending physician and the hospice medical director." },
{ q: "Under what insurance program is hospice care primarily funded in the US?", a: "The <b>Medicare Hospice Benefit</b> (covered under Medicare Part A)." },
{ q: "What must a patient waive to enroll in hospice care?", a: "They must waive their right to <b>Medicare payment for curative treatments</b> for their terminal illness." },
{ q: "Can a patient on hospice receive treatment for an unrelated acute illness (e.g., a fracture)?", a: "<b>Yes</b>. Medicare will still cover standard treatment for conditions <b>unrelated</b> to the primary terminal diagnosis." },
{ q: "If a patient on hospice survives beyond 6 months, must they be discharged?", a: "<b>No</b>. They can be recertified for hospice in subsequent benefit periods as long as a physician confirms their prognosis is still <b>$\\\\text{< } 6\\\\text{ months}$</b>." },
{ q: "Can a patient choose to revoke their hospice status?", a: "<b>Yes</b>. A patient can revoke the hospice benefit at <b>any time</b> to return to curative care." },
{ q: "Is a signed Do Not Resuscitate (DNR) order a mandatory requirement for hospice admission?", a: "<b>No</b>. Although recommended, a patient cannot be denied hospice admission solely because they do not have a DNR." },
{ q: "What is the definition of 'respite care' in hospice?", a: "Temporary, short-term inpatient care (up to 5 days) provided to the patient to offer <b>relief and rest for the family caregivers</b>." },
{ q: "What services are provided to the family by hospice after the patient's death?", a: "<b>Bereavement services</b> and counseling for at least <b>12 months</b> following the death." },
{ q: "What is the first-line pharmacological agent for dyspnea (air hunger) in terminal patients?", a: "<b>Systemic opioids</b> (e.g., morphine), which reduce the perception of breathlessness and anxiety." },
{ q: "What non-pharmacological treatment can help relieve mild terminal dyspnea?", a: "A <b>cool fan blowing air</b> across the patient's face, stimulating trigeminal nerve receptors." },
{ q: "How is terminal agitation or delirium managed pharmacologically?", a: "With low-dose neuroleptics, primarily <b>haloperidol</b>; benzodiazepines may be added if there is co-existing anxiety." },
{ q: "What is the preferred route of medication administration when a dying patient is comatose?", a: "<b>Subcutaneous (SQ), intravenous (IV), sublingual (SL), or rectal (PR)</b>; intramuscular injections should be avoided." },
{ q: "Does enrolling in hospice care shorten a patient's life expectancy?", a: "<b>No</b>. Research shows that hospice care does not accelerate death and may even <b>prolong survival</b> slightly compared to aggressive hospital care." },
{ q: "What is the medical definition of brain death?", a: "The <b>irreversible loss of all clinical brain function</b>, including both the cerebral hemispheres and the brainstem." },
{ q: "What core body temperature is required before clinical brain death testing can begin?", a: "A core temperature of <b>$\\\\ge 36^\\\\circ\\\\text{C}$ ($96.8^\\\\circ\\\\text{F}$)</b> to exclude hypothermic coma." },
{ q: "What systolic blood pressure must be maintained during brain death testing?", a: "A systolic blood pressure of <b>$\\\\ge 100\\\\text{ mmHg}$</b> (vasopressors can be used to achieve this)." },
{ q: "What metabolic and drug exclusions are required before brain death testing?", a: "Absence of severe electrolyte, acid-base, or endocrine disturbances, and no evidence of <b>drug intoxication, poisoning, or paralytic agents</b>." },
{ q: "What are the three clinical hallmarks of brain death?", a: "1. <b>Coma</b> (no response to noxious stimuli)<br>2. <b>Absence of brainstem reflexes</b><br>3. <b>Apnea</b> (no respiratory drive)" },
{ q: "Which brainstem reflexes must be absent to confirm brain death?", a: "Pupillary, corneal, oculocephalic (doll's eyes), oculovestibular (cold calorics), gag, and cough reflexes." },
{ q: "Describe the oculovestibular (cold caloric) reflex test in brain death.", a: "Irrigating the ear canal with ice water produces <b>no eye deviation or nystagmus</b>, indicating loss of brainstem pathway." },
{ q: "What is the oculocephalic reflex test (doll's eyes) and its finding in brain death?", a: "Rapid turning of the head side-to-side produces <b>no movement of the eyes relative to the head</b> (eyes remain fixed in mid-position)." },
{ q: "What is the first step of the apnea test protocol?", a: "Pre-oxygenate the patient with <b>100% $O_2$</b> to ensure safety during ventilator disconnection." },
{ q: "What must the baseline arterial pCO2 be prior to beginning the apnea test?", a: "A normal baseline $pCO_2$ of <b>$\\\\text{35-45 mmHg}$</b>." },
{ q: "How is the patient oxygenated during the apnea test?", a: "By delivering passive 100% $O_2$ (e.g., $6\\\\text{ L/min}$) via a catheter placed in the <b>trachea at the carina</b>." },
{ q: "What clinical observation and blood gas results define a positive (confirmatory) apnea test?", a: "<b>No respiratory effort</b> for 8–10 minutes, with a post-test $\\\\text{pCO}_2$ of <b>$\\\\ge 60\\\\text{ mmHg}$</b> (or $\\\\ge 20\\\\text{ mmHg}$ increase from baseline) and <b>$\\\\text{pH < } 7.30$</b>." },
{ q: "Under what conditions must the apnea test be immediately aborted?", a: "Hemodynamic instability (systolic BP <b>$\\\\text{< } 90\\\\text{ mmHg}$</b>), severe oxygen desaturation, or significant cardiac arrhythmias." },
{ q: "When are ancillary confirmatory tests required for brain death diagnosis?", a: "When the clinical exam or apnea test <b>cannot be completed</b> (e.g., severe craniofacial trauma, high cervical spine injury, severe chronic CO2 retention)." },
{ q: "Name the standard ancillary tests used to confirm brain death.", a: "<b>Cerebral angiography</b> (no flow), <b>radionuclide brain scan</b> (hollow skull sign), <b>transcranial Doppler</b>, or <b>EEG</b> (electrocerebral silence)." },
{ q: "What is the legal status of a patient who has been declared brain dead?", a: "They are <b>legally dead</b>; the time of declaration is recorded as the legal time of death." },
{ q: "Is it ethical to maintain mechanical ventilation after a patient is declared brain dead?", a: "Only temporarily to <b>preserve organs for donation</b>, or briefly to allow family members to gather; otherwise, ventilation can be withdrawn unilaterally." },
{ q: "Can spinal reflexes (e.g., deep tendon reflexes, plantar flexion) occur in brain-dead patients?", a: "<b>Yes</b>. Spinal reflexes are mediated by the spinal cord, not the brain or brainstem, and their presence <b>does not rule out brain death</b>." }
          ]
        },
{
          section: 'Ethics, Law & Health Systems',
          topic: "Healthcare systems — Medicare, Medicaid, insurance",
          icon: "landmark",
          cards: [
            { q: "What is Medicare?", a: "A federal health insurance program in the United States designed primarily for individuals aged <b>$\\\\ge 65$</b>, younger people with specific disabilities, and individuals with End-Stage Renal Disease (ESRD) or ALS." },
{ q: "Which federal agency is responsible for administering the Medicare program?", a: "The <b>Centers for Medicare & Medicaid Services (CMS)</b>, which is a division of the Department of Health and Human Services (HHS)." },
{ q: "What is the age requirement for standard Medicare eligibility?", a: "Individuals must be <b>$\\\\ge 65$ years old</b>, and they or their spouse must have paid Medicare taxes for at least 10 years (40 quarters) to receive premium-free Part A." },
{ q: "Under what condition can an individual younger than 65 qualify for Medicare due to disability?", a: "They must have received Social Security Disability Insurance (SSDI) benefits for at least <b>24 months</b>." },
{ q: "What is the exception to the 24-month SSDI waiting period for Medicare eligibility in patients with ALS?", a: "Patients diagnosed with <b>Amyotrophic Lateral Sclerosis (ALS)</b> are eligible for Medicare the first month they begin receiving SSDI benefits, with no waiting period." },
{ q: "What is the Medicare eligibility criteria for patients with End-Stage Renal Disease (ESRD)?", a: "Patients with ESRD who require dialysis or a kidney transplant qualify for Medicare <b>regardless of age</b>, usually starting the 4th month of dialysis." },
{ q: "How is Medicare Part A (Hospital Insurance) primarily funded?", a: "Primarily through a dedicated <b>payroll tax</b> under the Federal Insurance Contributions Act (FICA), which is $1.45\\\\%$ for both employers and employees ($2.9\\\\%$ total)." },
{ q: "What is the Additional Medicare Tax introduced by the ACA, and how does it fund the program?", a: "An additional <b>$0.9\\\\%$ payroll tax</b> on self-employment and wages above $200,000 for individuals ($250,000 for married couples), which goes toward the Medicare Hospital Insurance Trust Fund." },
{ q: "How is Medicare Part B (Medical Insurance) funded?", a: "Through a combination of <b>general federal tax revenues</b> (approximately $75\\\\%$) and monthly <b>beneficiary premiums</b> (approximately $25\\\\%$)." },
{ q: "What are the four components of Medicare?", a: "<b>Part A</b> (Hospital Insurance), <b>Part B</b> (Medical Insurance), <b>Part C</b> (Medicare Advantage), and <b>Part D</b> (Prescription Drug Coverage)." },
{ q: "What type of care is covered under Medicare Part A?", a: "<b>Inpatient hospital care</b>, skilled nursing facility (SNF) care, home health care, and hospice care." },
{ q: "What type of care is covered under Medicare Part B?", a: "<b>Outpatient services</b>, physician services, preventive care (screenings, wellness visits), durable medical equipment (DME), and limited home health care." },
{ q: "What is Medicare Part C (Medicare Advantage)?", a: "A program that allows beneficiaries to enroll in private health plans (like HMOs or PPOs) that contract with Medicare to provide all Part A and Part B benefits, and usually Part D." },
{ q: "What is Medicare Part D?", a: "A voluntary <b>prescription drug benefit</b> run by private insurance companies that are approved and subsidized by Medicare." },
{ q: "Is Medicare Part A premium-free for everyone?", a: "<b>No</b>. It is premium-free only for those who have paid Medicare taxes for <b>$\\\\ge 40$ quarters</b> (10 years). Those with fewer quarters must pay a monthly premium." },
{ q: "How is the deductible for Medicare Part A hospital stays structured?", a: "It is charged per <b>benefit period</b> (which starts the day of admission and ends after 60 consecutive days without inpatient hospital or SNF care), not per calendar year." },
{ q: "How many inpatient hospital days does Medicare Part A cover per benefit period?", a: "Up to <b>90 days</b> of inpatient care, plus an additional 60 <b>lifetime reserve days</b> which can be used once the 90 days are exhausted." },
{ q: "What is the cost-sharing structure for inpatient hospital stays under Medicare Part A?", a: "$0$ copay for days 1–60, a daily copay for days 61–90, and a higher daily copay for lifetime reserve days. The patient pays 100% of costs beyond that." },
{ q: "Under what circumstances does Medicare Part A cover Skilled Nursing Facility (SNF) care?", a: "The stay must follow a hospital stay of at least <b>3 consecutive days</b> (excluding discharge day) for a related condition, and must be for skilled rehabilitation or nursing." },
{ q: "What is the maximum number of days of SNF care covered by Medicare Part A per benefit period?", a: "Up to <b>100 days</b>, with $0$ coinsurance for days 1–20 and a daily copayment for days 21–100." },
{ q: "Does Medicare Part A cover long-term custodial care (e.g., permanent nursing home residency)?", a: "<b>No</b>. Medicare Part A only covers short-term skilled nursing care for rehabilitation, not custodial care or assistance with activities of daily living (ADLs)." },
{ q: "Is Medicare Part B voluntary, and does it require a premium?", a: "<b>Yes</b>. Part B is voluntary, though most seniors enroll, and it requires a <b>monthly premium</b> which is typically deducted from Social Security checks." },
{ q: "What is the Income-Related Monthly Adjustment Amount (IRMAA) in Medicare?", a: "An <b>extra surcharge</b> added to Medicare Part B and Part D premiums for beneficiaries with higher incomes (based on tax returns from two years prior)." },
{ q: "What is the typical coinsurance rate for Medicare Part B services?", a: "<b>$20\\\\%$</b> of the Medicare-approved amount, which the patient must pay out-of-pocket after meeting the annual Part B deductible." },
{ q: "Does Medicare Part B cover routine preventive services?", a: "<b>Yes</b>. Services like annual wellness visits, mammograms, colonoscopies, and cardiovascular screenings are covered at <b>$100\\\\%$</b> with no coinsurance or deductible." },
{ q: "Under what condition does Medicare Part B cover outpatient prescription drugs?", a: "Only if they are drugs that are not usually self-administered, such as <b>chemotherapy infusions</b>, immunosuppressive drugs after transplant, or drugs given in an outpatient clinic." },
{ q: "Which vaccines are covered under Medicare Part B?", a: "Vaccines for <b>influenza, pneumococcal disease, COVID-19</b>, and hepatitis B (for intermediate/high-risk patients) are covered under Part B." },
{ q: "Which vaccines are covered under Medicare Part D instead of Part B?", a: "Most other preventive vaccines, such as those for <b>shingles (zoster)</b> and <b>Tdap</b> (tetanus, diphtheria, pertussis), are covered under Medicare Part D." },
{ q: "What is Medigap (Medicare Supplement Insurance)?", a: "Private insurance policies sold to individuals with Original Medicare (Parts A and B) to help pay for out-of-pocket costs like copayments, coinsurance, and deductibles." },
{ q: "Can an individual enrolled in Medicare Advantage (Part C) also buy a Medigap policy?", a: "<b>No</b>. It is illegal for private insurance companies to sell a Medigap policy to anyone who is enrolled in a Medicare Advantage plan." },
{ q: "How does Medicare Advantage (Part C) restrict provider choices compared to Original Medicare?", a: "Original Medicare allows patients to see any provider in the US who accepts Medicare. Medicare Advantage plans typically restrict patients to a <b>network of providers</b> (HMO or PPO)." },
{ q: "What was the 'donut hole' in Medicare Part D?", a: "A temporary coverage gap where beneficiaries had to pay a higher percentage of prescription drug costs out-of-pocket after total spending reached a certain threshold." },
{ q: "How did the Inflation Reduction Act of 2022 change insulin coverage under Medicare?", a: "It capped the out-of-pocket cost of Medicare-covered insulin at <b>$35 per month</b>, with no deductible applying to the insulin." },
{ q: "What major change does the Inflation Reduction Act of 2022 bring to Medicare Part D by 2025?", a: "It caps total annual out-of-pocket prescription drug spending for Medicare beneficiaries at <b>$2,000</b>." },
{ q: "Does Original Medicare cover routine dental, vision, or hearing services?", a: "<b>No</b>. Original Medicare does not cover routine cleanings, dentures, eyeglasses, or hearing aids, although many Medicare Advantage (Part C) plans offer these as extra benefits." },
{ q: "How is hospice care covered under Medicare?", a: "Hospice care is covered under <b>Medicare Part A</b>. To qualify, a physician must certify that the patient has a life expectancy of <b>$\\\\text{< } 6$ months</b>, and the patient must waive curative treatments." },
{ q: "What happens if a beneficiary fails to enroll in Medicare Part B when they first become eligible?", a: "They face a <b>late enrollment penalty</b> of a $10\\\\%$ premium increase for each full 12-month period they could have had Part B but didn't, which is added to their monthly premium for life." },
{ q: "What is a Medicare Administrative Contractor (MAC)?", a: "A private health care insurer that has been awarded a geographic jurisdiction to process Medicare Part A and Part B medical claims for providers." },
{ q: "What is a National Coverage Determination (NCD)?", a: "A nationwide determination by CMS regarding whether Medicare will pay for a specific medical service, item, or technology based on clinical evidence." },
{ q: "What is a Local Coverage Determination (LCD)?", a: "A decision by a Medicare Administrative Contractor (MAC) regarding whether a service is reasonable and necessary and therefore covered within their specific region." },
{ q: "What is Medicaid?", a: "A joint <b>federal and state program</b> that provides health insurance coverage to low-income individuals, families, children, pregnant women, the elderly, and disabled individuals." },
{ q: "How is Medicaid funded?", a: "Medicaid is funded jointly by the <b>federal government and state governments</b>. The federal government matches state Medicaid spending based on the FMAP." },
{ q: "What does FMAP stand for in the context of Medicaid funding?", a: "<b>Federal Medical Assistance Percentage</b>, which is the percentage of a state's Medicaid program costs paid by the federal government (ranging from $50\\\\%$ to over $80\\\\%$ based on state per capita income)." },
{ q: "Who is responsible for administering the Medicaid program?", a: "<b>Individual states</b> administer the program. They establish their own eligibility standards, benefit packages, and provider payment rates within broad federal guidelines." },
{ q: "What mandatory eligibility groups must all states cover under Medicaid?", a: "Low-income families, pregnant women, children up to age 19, recipients of Supplemental Security Income (SSI), and low-income elderly individuals." },
{ q: "What is the federal minimum income threshold for Medicaid coverage of pregnant women?", a: "States must cover pregnant women with household incomes up to at least <b>$133\\\\%$</b> of the Federal Poverty Level (FPL) (though many states choose to cover higher income levels)." },
{ q: "Under recent federal legislation, how long can states extend postpartum Medicaid coverage?", a: "States have the option to extend postpartum Medicaid coverage from the mandatory 60 days to <b>12 months</b>." },
{ q: "What is the Children's Health Insurance Program (CHIP)?", a: "A joint federal-state program that provides health insurance to children in families with incomes too high to qualify for Medicaid but too low to afford private coverage." },
{ q: "How did the Affordable Care Act (ACA) seek to change Medicaid eligibility?", a: "It established a nationwide expansion of Medicaid eligibility to nearly all adults with incomes up to <b>$138\\\\%$</b> of the Federal Poverty Level (FPL)." },
{ q: "What was the outcome of the 2012 Supreme Court ruling in NFIB v. Sebelius regarding Medicaid expansion?", a: "The Supreme Court ruled that the federal government could not penalize states that chose not to expand Medicaid, effectively making the ACA expansion <b>optional for states</b>." },
{ q: "What does the term 'dual eligible' mean?", a: "It refers to individuals who qualify for <b>both Medicare and Medicaid</b> (often low-income seniors or disabled individuals) and receive benefits from both programs." },
{ q: "In a dual-eligible beneficiary, which insurance program pays first for medical services?", a: "<b>Medicare</b> is the primary payer for Medicare-covered services; <b>Medicaid</b> is the secondary payer (payer of last resort), covering deductibles, coinsurance, and non-Medicare services." },
{ q: "Does Medicaid cover long-term custodial nursing home care?", a: "<b>Yes</b>. Medicaid is the <b>largest single payer</b> of long-term nursing home care in the United States, covering individuals who meet both clinical and financial eligibility criteria." },
{ q: "What is the Medicaid 'spend-down' process?", a: "A process by which individuals with incomes higher than Medicaid limits can qualify by subtracting their medical expenses from their income until it reaches the state's Medicaid threshold." },
{ q: "What is the Medicaid 'look-back period' for long-term care eligibility?", a: "A <b>5-year (60-month)</b> period prior to applying for Medicaid during which any assets transferred or sold for less than fair market value are scrutinized, which can trigger a penalty period." },
{ q: "What are mandatory Medicaid benefits that every state must provide?", a: "Inpatient and outpatient hospital services, physician services, laboratory and X-ray services, family planning services, and home health services." },
{ q: "What are examples of optional Medicaid benefits that states may choose to cover?", a: "Prescription drugs, dental care, physical therapy, vision care, and prosthetic devices. (Note: all states currently cover prescription drugs)." },
{ q: "Can states charge copayments or premiums to Medicaid beneficiaries?", a: "<b>Yes</b>, but they must be nominal, and certain populations (e.g., children, pregnant women) and services (e.g., emergency care) are exempt from cost-sharing under federal law." },
{ q: "What is a Section 1115 Medicaid Demonstration Waiver?", a: "A waiver granted by the federal government (CMS) that allows states to test pilot projects that differ from standard federal Medicaid rules (e.g., work requirements or unique benefit designs)." },
{ q: "What is the Medicaid Estate Recovery Program?", a: "A federally mandated program requiring states to recover the costs of long-term care services paid by Medicaid from the estate of deceased beneficiaries aged 55 or older." },
{ q: "What is an HMO (Health Maintenance Organization)?", a: "A managed care plan that requires members to receive care from a specific network of providers, designate a primary care provider (PCP), and obtain PCP referrals to see specialists." },
{ q: "What does it mean for a Primary Care Physician (PCP) to act as a 'gatekeeper' in an HMO?", a: "The PCP manages the patient's overall care and must authorize <b>referrals</b> for any specialist visits or diagnostic procedures for them to be covered by the insurance." },
{ q: "Does an HMO cover out-of-network care?", a: "<b>No</b>, except in the case of emergency medical services; all routine out-of-network care must be paid entirely by the patient." },
{ q: "What are the primary cost-control mechanisms used by HMO plans?", a: "Strict provider networks, utilization reviews, PCP gatekeeping, and paying providers via <b>capitation</b> or discounted fee schedules." },
{ q: "What is a PPO (Preferred Provider Organization)?", a: "A health plan that offers a network of preferred providers but allows members to see out-of-network doctors and see specialists without a referral, at a higher cost." },
{ q: "Are referrals required to see a specialist under a PPO plan?", a: "<b>No</b>. Patients enrolled in a PPO do not need referrals to see specialists and are not required to designate a primary care physician." },
{ q: "Does a PPO plan cover out-of-network care?", a: "<b>Yes</b>, but the patient is responsible for higher cost-sharing (e.g., higher deductibles and coinsurance) than when using in-network providers." },
{ q: "Why are PPO premiums typically higher than HMO premiums?", a: "Because PPOs offer <b>greater flexibility</b> and choice of providers, which reduces the insurer's ability to negotiate steep discounts and manage utilization." },
{ q: "What is an EPO (Exclusive Provider Organization)?", a: "A managed care plan where members must use <b>in-network providers only</b> (like an HMO) but do <b>not</b> need a PCP gatekeeper or referrals to see specialists (like a PPO)." },
{ q: "What happens if a patient in an EPO sees an out-of-network specialist for routine care?", a: "The insurance plan will <b>not cover</b> the services, and the patient must pay the entire cost out-of-pocket." },
{ q: "What is a POS (Point of Service) plan?", a: "A hybrid plan where patients choose a PCP gatekeeper for in-network care, but can see out-of-network providers if they obtain a PCP referral (with higher out-of-pocket costs)." },
{ q: "What is the primary difference between POS and HMO plans?", a: "Both require a PCP gatekeeper and referrals, but a <b>POS plan allows out-of-network care</b> with a referral, whereas an HMO does not allow out-of-network care at all." },
{ q: "Which health insurance plan types require a primary care physician gatekeeper?", a: "<b>HMO</b> and <b>POS</b> plans require a gatekeeper; <b>PPO</b> and <b>EPO</b> plans do not." },
{ q: "Which health insurance plan types offer out-of-network coverage for routine care?", a: "<b>PPO</b> (no referral needed) and <b>POS</b> (referral from PCP required) plans offer out-of-network coverage; <b>HMO</b> and <b>EPO</b> do not." },
{ q: "What is a High-Deductible Health Plan (HDHP)?", a: "A plan with lower premiums but higher annual deductibles ($1,650 for individuals / $3,300 for families minimum in 2024). It is the only plan type that can be paired with an HSA." },
{ q: "What is a Health Savings Account (HSA)?", a: "A tax-advantaged savings account owned by an individual to pay for qualified medical expenses using pre-tax contributions. It requires enrollment in an HDHP." },
{ q: "What happens to unused funds in a Health Savings Account (HSA) at the end of the year?", a: "The funds <b>roll over</b> indefinitely from year to year; there is no 'use-it-or-lose-it' rule, and the account stays with the individual if they change jobs." },
{ q: "What is a Flexible Spending Account (FSA)?", a: "An employer-established account where employees contribute pre-tax dollars for medical expenses. Unused funds are generally <b>subject to a 'use-it-or-lose-it'</b> rule at the end of the plan year." },
{ q: "In health insurance, what is a 'premium'?", a: "The amount paid (usually monthly) to the health insurance company by the individual or employer to keep the insurance policy active." },
{ q: "In health insurance, what is a 'deductible'?", a: "The fixed dollar amount a patient must pay out-of-pocket for covered medical services before the insurance plan begins to pay." },
{ q: "In health insurance, what is a 'copayment'?", a: "A flat, pre-determined fee (e.g., $25) that a patient pays at the time of service for a specific medical event, such as a doctor's visit or prescription refill." },
{ q: "In health insurance, what is 'coinsurance'?", a: "The percentage of a medical bill (e.g., $20\\\\%$) that the patient pays after meeting their deductible, with the insurance company paying the remaining percentage." },
{ q: "What is the 'Out-of-Pocket Maximum' (OOPM) in a health insurance plan?", a: "The most a patient will pay for covered services in a plan year; after reaching this limit, the insurance plan pays $100\\\\%$ of all covered costs." },
{ q: "What is 'prior authorization'?", a: "A requirement by health plans where a provider must obtain approval from the insurer before performing a procedure or prescribing a drug for it to be covered." },
{ q: "What is 'utilization review'?", a: "A process where the health plan evaluates the clinical necessity, appropriateness, and efficiency of proposed healthcare services and procedures." },
{ q: "What is a health insurance 'formulary'?", a: "A list of prescription drugs covered by a health insurance plan, usually divided into cost-sharing tiers (generic, brand name, specialty)." },
{ q: "What is 'step therapy' (also known as the 'fail-first' requirement)?", a: "A policy where an insurer requires a patient to try cheaper or standard medications first (and fail to respond) before they will cover a more expensive drug." },
{ q: "What is 'balance billing'?", a: "When a provider bills a patient for the difference between the provider's charge and the insurance company's allowed payment (often occurring with out-of-network care)." },
{ q: "What is the primary purpose of the federal No Surprises Act?", a: "To protect patients from <b>surprise medical bills</b> arising from emergency care or out-of-network services received at in-network facilities." },
{ q: "What is a Third-Party Administrator (TPA)?", a: "An organization that processes insurance claims and administers employee benefit plans on behalf of a self-insured employer." },
{ q: "What is the Fee-for-Service (FFS) reimbursement model?", a: "A payment model where healthcare providers are paid separately for <b>each service, procedure, test, or visit</b> they render." },
{ q: "What provider behavior does the Fee-for-Service model encourage?", a: "It encourages <b>over-utilization</b> and volume-driven care, as providers generate more revenue by performing more services." },
{ q: "In a Fee-for-Service model, who bears the financial risk of high healthcare utilization?", a: "The <b>insurer</b> (or the employer/government program funding the care), since they must pay for every service billed." },
{ q: "What is the Capitation reimbursement model?", a: "A payment model where a provider is paid a <b>fixed amount per patient per period</b> (e.g., monthly) to deliver all necessary care, regardless of the volume of services used." },
{ q: "In a capitated payment model, who bears the financial risk of high healthcare utilization?", a: "The <b>healthcare provider</b>, because if patients require costly services, the provider's expenses will exceed the fixed capitated payments." },
{ q: "What provider behavior does the Capitation model encourage?", a: "It encourages <b>under-utilization</b> of services, cost-efficiency, and a focus on preventive care to keep patients healthy and reduce expensive treatments." },
{ q: "What is a 'bundled payment' (episode-based payment) model?", a: "A reimbursement model where a single, consolidated payment covers <b>all services</b> related to a specific episode of care (e.g., a total hip replacement surgery and rehab)." },
{ q: "What is the primary goal of the bundled payment model?", a: "To encourage <b>coordination among different providers</b> (surgeons, hospitals, post-acute care) and reduce redundant tests and complications." },
{ q: "What is a 'global payment' (or global budgeting) model?", a: "A reimbursement model where a single fixed payment covers <b>all healthcare services</b> provided to a patient or population over a specific period (e.g., a hospital's annual operating budget)." },
{ q: "What is an Accountable Care Organization (ACO)?", a: "A voluntary group of doctors, hospitals, and other providers who collaborate to coordinate care for Medicare patients and share in financial savings." },
{ q: "What is the 'Shared Savings' mechanism in an ACO?", a: "An incentive program where providers who meet quality benchmarks and reduce overall healthcare spending compared to a benchmark receive a percentage of the savings." },
{ q: "What is the difference between 'one-sided' and 'two-sided' risk in ACOs?", a: "In <b>one-sided risk</b>, providers share in savings but face no penalty if spending increases; in <b>two-sided risk</b>, they must pay penalties if spending exceeds targets." },
{ q: "What is the Pay-for-Performance (P4P) reimbursement model?", a: "A reimbursement model that ties provider payments or bonuses directly to <b>quality metrics and outcomes</b> (e.g., readmission rates, HbA1c control, patient satisfaction)." },
{ q: "What is a Relative Value Unit (RVU) in physician reimbursement?", a: "A standard measure used to determine physician compensation based on <b>physician work</b>, <b>practice expenses</b>, and <b>malpractice insurance costs</b>." },
{ q: "What is the Resource-Based Relative Value Scale (RBRVS)?", a: "The system used by Medicare to calculate payments to physicians by multiplying the total <b>RVUs</b> by geographic and national conversion factors." },
{ q: "What is a Diagnosis-Related Group (DRG) in hospital billing?", a: "A classification system that groups inpatient stays based on diagnosis and pays the hospital a <b>fixed amount</b> per stay, regardless of actual resources consumed." },
{ q: "How does a DRG payment model affect a hospital's management of inpatient stay length?", a: "It encourages hospitals to <b>minimize the length of stay</b> and prevent complications, as they receive the same fixed payment regardless of how long the patient occupies a bed." },
{ q: "What is the Medicare Hospital Readmissions Reduction Program (HRRP)?", a: "A program that penalizes hospitals with higher-than-expected <b>30-day readmission rates</b> for specific conditions (e.g., heart failure, COPD) by reducing their Medicare payments." },
{ q: "What is the Hospital Value-Based Purchasing (VBP) Program?", a: "A CMS program that adjusts a portion of hospital payments based on quality of care, safety, efficiency, and patient experience scores." },
{ q: "What is 'reference pricing'?", a: "A model where an employer or insurer sets a maximum price they will pay for a standard service, and the patient pays the difference if they choose a more expensive provider." },
{ q: "What is EMTALA?", a: "The <b>Emergency Medical Treatment and Active Labor Act</b>, a federal law requiring Medicare-participating hospitals to screen and stabilize anyone seeking emergency care." },
{ q: "Does EMTALA apply to all hospitals in the United States?", a: "It applies specifically to all hospitals that accept Medicare funding and operate an <b>emergency department</b>." },
{ q: "What is a Medical Screening Examination (MSE) under EMTALA?", a: "A screening process performed by a qualified medical professional to determine if an <b>emergency medical condition (EMC)</b> or active labor exists." },
{ q: "Under EMTALA, what constitutes an Emergency Medical Condition (EMC)?", a: "An acute condition with symptoms of sufficient severity (such as severe pain) where lack of immediate medical attention could seriously jeopardize health or bodily function." },
{ q: "What is the definition of 'stabilized' under EMTALA?", a: "That no material clinical deterioration of the patient's condition is likely, within reasonable medical probability, to result from or occur during transfer." },
{ q: "Can a hospital transfer an unstable patient to another facility under EMTALA?", a: "Only if the patient requests the transfer in writing after being informed of the risks, or if a physician certifies that the <b>medical benefits of transfer outweigh the risks</b>." },
{ q: "What is 'patient dumping' under EMTALA?", a: "The illegal practice of transferring or refusing to treat an unstable patient because of their inability to pay or lack of health insurance." },
{ q: "What are the penalties for a hospital that violates EMTALA regulations?", a: "Civil monetary fines per violation and potential <b>termination of the hospital's Medicare provider agreement</b>." },
{ q: "What does COBRA stand for, and what is its primary purpose?", a: "<b>Consolidated Omnibus Budget Reconciliation Act</b>. It allows workers and their families to temporarily continue their employer's group health insurance after job loss." },
{ q: "What are common 'qualifying events' that make an individual eligible for COBRA?", a: "Voluntary or involuntary job loss, reduction in work hours, divorce or legal separation from the covered employee, or death of the covered employee." },
{ q: "Who is responsible for paying the premiums for COBRA coverage?", a: "The <b>individual</b> is responsible for the entire premium (both the employee and former employer shares) plus a $2\\\\%$ administrative fee, up to <b>$102\\\\%$</b> of the plan cost." },
{ q: "What is the typical maximum duration of COBRA coverage following job loss?", a: "Up to <b>18 months</b>. (Certain events like divorce or death of the covered employee can extend coverage up to 36 months)." },
{ q: "Which employers are legally required to offer COBRA continuation coverage?", a: "Employers in the private sector with <b>$\\\\ge 20$ employees</b> who offer a group health plan." },
{ q: "How long is the election period for an eligible individual to choose COBRA coverage?", a: "At least <b>60 days</b> from the date of the qualifying event or the date they receive notice of eligibility, whichever is later." },
{ q: "Does COBRA coverage apply retroactively once elected?", a: "<b>Yes</b>. If elected within the 60-day window, COBRA coverage is <b>retroactive</b> to the date of the qualifying event, preventing any gap in coverage." },
          ]
        },
{
          section: 'Ethics, Law & Health Systems',
          topic: "Patient safety & quality improvement",
          icon: "shield-check",
          cards: [
            { q: "What is an active error in patient safety?", a: "An error that occurs at the <b>point of contact</b> between a healthcare worker and the patient, having an immediate effect (e.g., a nurse administering the wrong medication dose)." },
  { q: "What is a latent error in patient safety?", a: "A structural or systemic flaw that is <b>hidden within the organization</b> and design of a system, which does not cause immediate harm but sets up conditions for active errors to occur (e.g., poor staffing, confusing labels)." },
  { q: "Give an example of a latent error leading to an active error in clinical practice?", a: "A pharmacy stocks two look-alike look-sound medications next to each other (<b>latent error</b>), leading to a busy physician selecting the wrong drug during a hectic shift (<b>active error</b>)." },
  { q: "What is the primary difference in focus between latent and active errors?", a: "Active errors focus on <b>human actions</b> at the sharp end (frontline staff), whereas latent errors focus on <b>system design and structural vulnerabilities</b> at the blunt end (management, physical layout, protocols)." },
  { q: "What is a diagnostic error?", a: "An error that includes <b>delayed, missed, or incorrect diagnoses</b>, or the failure to employ indicated diagnostic tests or act on test results." },
  { q: "What is a treatment error?", a: "An error occurring during the <b>execution of a therapy</b>, such as administering the wrong drug, performing a procedure incorrectly, or delaying treatment after a diagnosis is established." },
  { q: "What is a preventive error?", a: "An error characterized by a <b>failure to provide prophylactic treatment</b>, inadequate follow-up, or failure to monitor a patient during or after therapy." },
  { q: "What is a communication error in patient safety?", a: "An error resulting from <b>poor, incomplete, or absent sharing of clinical information</b> between healthcare providers or between the provider and patient." },
  { q: "Give an example of a diagnostic error in clinical practice.", a: "A clinician fails to recognize red flags of spinal epidural abscess in a back pain patient, leading to a <b>missed diagnosis</b> and subsequent paraplegia." },
  { q: "Give an example of a treatment error in clinical practice.", a: "Administering a dose of insulin that is <b>10 times higher</b> than prescribed due to misreading a handwritten order containing the abbreviation 'U' for units." },
  { q: "Give an example of a preventive error in clinical practice.", a: "Failing to prescribe <b>DVT prophylaxis</b> for a patient undergoing major orthopedic surgery who subsequently develops a fatal pulmonary embolism." },
  { q: "Give an example of a communication error in clinical practice.", a: "A resident fails to mention a critical lab result (e.g., highly elevated potassium) to the night team during cross-cover, leading to a <b>delay in treating life-threatening hyperkalemia</b>." },
  { q: "What is a slip in cognitive error taxonomy?", a: "An <b>inadvertent action</b> where the user has the correct plan but executes it incorrectly (an action-based error, e.g., reaching for drug A but picking up drug B)." },
  { q: "What is a lapse in cognitive error taxonomy?", a: "A <b>memory failure</b> where the correct plan is not executed because a step is forgotten (e.g., forgetting to check a patient's allergy status before prescribing)." },
  { q: "What is a mistake in cognitive error taxonomy?", a: "A <b>rule-based or knowledge-based error</b> where the user formulates an incorrect plan because they misapplied a rule or lacked required knowledge (e.g., treating a viral illness with antibiotics)." },
  { q: "What is a violation in patient safety?", a: "A <b>deliberate deviation</b> from established safety protocols, guidelines, or rules (e.g., bypassing a barcode scan step to save time during medication administration)." },
  { q: "What is a system error in medicine?", a: "An error that results from the design of the <b>entire healthcare delivery system</b> (processes, environment, resources) rather than the failure of a single individual." },
  { q: "What is a cognitive error in medicine?", a: "An error that occurs due to a <b>flaw in clinical reasoning</b>, decision-making, or information processing by the individual clinician." },
  { q: "Define anchoring bias in diagnostic reasoning.", a: "Over-relying on the <b>first piece of information</b> encountered (the 'anchor') and failing to adjust sufficiently as new data emerges (e.g., fixating on an initial diagnosis)." },
  { q: "Define availability bias in diagnostic reasoning.", a: "Overestimating the probability of a diagnosis because it comes to mind <b>easily</b>, often due to a recent, memorable, or dramatic case, rather than actual prevalence." },
  { q: "Define confirmation bias in diagnostic reasoning.", a: "Selectively seeking, interpreting, or remembering evidence that <b>supports a pre-existing hypothesis</b> while ignoring or discounting contradictory data." },
  { q: "Define premature closure in diagnostic reasoning.", a: "Accepting a diagnosis <b>before it has been fully verified</b>, stopping the search for alternatives once an initial hypothesis seems to fit (the most common cognitive error in medicine)." },
  { q: "Define the framing effect in diagnostic reasoning.", a: "The way in which clinical information is <b>presented (framed)</b> influences decision-making (e.g., selecting a treatment when described as having a 90% survival rate vs. a 10% mortality rate)." },
  { q: "Define search satisfying bias in diagnostic reasoning.", a: "Stopping the diagnostic search after finding <b>one abnormality</b>, thereby missing additional diagnoses (e.g., detecting one fracture on an X-ray and missing a second one)." },
  { q: "Define diagnostic momentum in patient safety.", a: "Once a diagnostic label is attached to a patient, it <b>gathers momentum</b> and is passed from provider to provider without critical reassessment, even if the label is incorrect." },
  { q: "What is Root Cause Analysis (RCA)?", a: "A structured, step-by-step <b>retrospective investigation</b> of a serious adverse event or sentinel event to identify the underlying system vulnerabilities that caused the error." },
  { q: "What is the design type of Root Cause Analysis (RCA)?", a: "A <b>retrospective</b> design, meaning it is performed after an event has already occurred to investigate how and why it happened." },
  { q: "What is the primary goal of a Root Cause Analysis (RCA)?", a: "To identify <b>systemic vulnerabilities and process flaws</b> that contributed to the error and modify them to prevent future occurrences, rather than placing blame on individuals." },
  { q: "Does Root Cause Analysis (RCA) assign individual blame?", a: "<b>No</b>. RCA operates on the principle that most medical errors are caused by flawed systems, not bad people, and actively avoids assigning individual blame." },
  { q: "Who should be included in an RCA multidisciplinary team?", a: "Frontline providers involved in the event, subject matter experts, patient safety officers, and individuals with <b>process design authority</b> (e.g., administration or leadership)." },
  { q: "What is the first step of a Root Cause Analysis (RCA)?", a: "<b>Define the event</b> and map out the timeline of what happened, gathering objective data, medical records, and interviewing those involved." },
  { q: "What is the 'Five Whys' technique in Root Cause Analysis?", a: "A simple troubleshooting method where the team repeatedly asks <b>'Why?'</b> (typically five times) to drill down through successive layers of cause-and-effect to find the root cause." },
  { q: "What is a Fishbone (Ishikawa) diagram?", a: "A visual tool used in RCA to organize and categorize potential causes of a problem, resembling the skeleton of a fish with the main problem at the 'head' and causes branching off as 'bones'." },
  { q: "What are the typical categories ('bones') in a healthcare Fishbone diagram?", a: "<b>People</b> (staffing, training), <b>Equipment</b> (machines, tools), <b>Environment</b> (lighting, noise), <b>Procedures</b> (protocols, guidelines), and <b>Policies</b> (organizational rules)." },
  { q: "What is the difference between a root cause and a contributing factor?", a: "A <b>root cause</b> is the fundamental reason that, if eliminated, would prevent recurrence. A <b>contributing factor</b> makes the event more likely but does not independently cause it." },
  { q: "What type of event typically triggers a Root Cause Analysis?", a: "A <b>sentinel event</b> (unexpected death or serious physical/psychological injury) or a high-risk 'near miss' that exposes major systemic vulnerabilities." },
  { q: "What is the final step/output of a Root Cause Analysis (RCA)?", a: "Developing a concrete, actionable <b>action plan</b> with specific measures, responsible owners, timelines, and metrics to prevent the error from happening again." },
  { q: "How does Root Cause Analysis (RCA) differ from peer review?", a: "RCA focuses on <b>system design</b> and processes, while peer review evaluates <b>individual performance</b> and professional competence." },
  { q: "What is the timeframe recommended by The Joint Commission to complete an RCA?", a: "Within <b>45 days</b> of the event occurring or its discovery." },
  { q: "What is a common limitation of Root Cause Analysis?", a: "It is susceptible to <b>hindsight bias</b> (evaluators knowing the outcome makes them judge actions more harshly) and relies on subjective retrospective memory." },
  { q: "What is the purpose of drawing a timeline in RCA?", a: "To establish the exact sequence of events without interpretation, which helps prevent <b>premature conclusions</b> about what caused the error." },
  { q: "How does the team verify a root cause in RCA?", a: "By testing if removing that specific cause <b>prevents the event</b> from occurring, or if its presence consistently reproduces the vulnerability." },
  { q: "Which of the following is the strongest RCA action plan recommendation?", a: "Implementing a <b>forcing function</b> (e.g., computer system block or physical lockout) is strong; providing retraining or writing a new policy is considered a weak recommendation." },
  { q: "Why are training and policies considered 'weak' recommendations in an RCA?", a: "Because they rely on <b>human memory and vigilance</b>, which are highly susceptible to fatigue, stress, and distraction." },
  { q: "What is a 'medium strength' action plan recommendation in RCA?", a: "Simplifying processes, standardizing equipment, or introducing checklists (which reduce cognitive load but still rely on human compliance)." },
  { q: "What is Failure Mode and Effects Analysis (FMEA)?", a: "A structured, <b>prospective</b> analysis tool used to identify potential failure points in a process before they occur and determine their impact." },
  { q: "What is the design type of Failure Mode and Effects Analysis (FMEA)?", a: "A <b>prospective</b> design, meaning it is conducted before a system or process is implemented (or to audit an existing one) to anticipate and prevent errors." },
  { q: "What is the primary goal of FMEA?", a: "To identify where a process might fail (<b>failure modes</b>) and implement preventive measures to design those errors out of the system before they can harm a patient." },
  { q: "What is a 'failure mode' in FMEA?", a: "The specific way in which a step in a process <b>could fail</b> to meet its intended function (e.g., pharmacy scanner failing to read a barcode)." },
  { q: "What is an 'effect' in FMEA?", a: "The clinical or operational <b>consequence of a failure mode</b> on the patient or the system (e.g., patient receives the wrong medication, causing anaphylaxis)." },
  { q: "What is the Risk Priority Number (RPN) in FMEA?", a: "A numerical score calculated for each potential failure mode to <b>prioritize which issues</b> need to be addressed first." },
  { q: "What is the formula to calculate the Risk Priority Number (RPN) in FMEA?", a: "<b>$\\\\text{RPN} = \\\\text{Severity (S)} \\\\times \\\\text{Occurrence (O)} \\\\times \\\\text{Detection (D)}$</b>" },
  { q: "In FMEA, what does Severity (S) measure and what is its typical scale?", a: "Measures the <b>seriousness of the consequences</b> of the failure mode, typically scored on a scale from 1 (no effect) to 10 (catastrophic/death)." },
  { q: "In FMEA, what does Occurrence (O) measure and what is its typical scale?", a: "Measures the <b>likelihood or frequency</b> that the failure mode will occur, typically scored on a scale from 1 (highly unlikely) to 10 (inevitable)." },
  { q: "In FMEA, what does Detection (D) measure and what is its typical scale?", a: "Measures the likelihood that the failure mode will be <b>detected before reaching the patient</b>, typically scored on a scale from 1 (almost certain to detect) to 10 (impossible to detect)." },
  { q: "Calculate the RPN if Severity (S) = 8, Occurrence (O) = 4, and Detection (D) = 5.", a: "<b>$\\\\text{RPN} = 8 \\\\times 4 \\\\times 5 = 160$</b>." },
  { q: "What does a high Risk Priority Number (RPN) indicate in FMEA?", a: "A <b>critical vulnerability</b> in the system that requires immediate corrective action, process redesign, or safety safeguards." },
  { q: "What is the first step in conducting an FMEA?", a: "Define the process to be analyzed, assemble a multidisciplinary team, and <b>map out the process flow</b> in detail (e.g., using a flowchart)." },
  { q: "How do FMEA and RCA differ in their relationship to an error?", a: "<b>FMEA is proactive</b> (aims to prevent potential errors), whereas <b>RCA is reactive</b> (aims to understand a past error)." },
  { q: "What is the final outcome of a completed FMEA process?", a: "A prioritized list of potential failures with <b>redesigned process steps</b> and assigned actions to reduce the RPNs of high-risk items." },
  { q: "What does the PDSA cycle stand for in Quality Improvement?", a: "<b>Plan, Do, Study, Act</b>. It is an iterative, four-stage model for testing and implementing change." },
  { q: "What occurs during the 'Plan' phase of a PDSA cycle?", a: "The team identifies the problem, sets an objective, formulates a <b>plan for change</b>, and predicts the outcomes and how data will be collected." },
  { q: "What occurs during the 'Do' phase of a PDSA cycle?", a: "The team carries out the test or change on a <b>small scale</b> (e.g., trying a new protocol with one doctor or on one ward for one day)." },
  { q: "What occurs during the 'Study' phase of a PDSA cycle?", a: "The team <b>analyzes the data</b> collected during the 'Do' phase, compares the results to their initial predictions, and summarizes what was learned." },
  { q: "What occurs during the 'Act' phase of a PDSA cycle?", a: "Based on the 'Study' phase, the team decides to <b>adopt</b> the change, <b>adapt</b> it (modify and retest), or <b>abandon</b> it." },
  { q: "Why is the PDSA cycle designed to be iterative?", a: "To allow teams to test changes in <b>rapid, low-risk cycles</b>, learning from failures early and adjusting before wide-scale implementation." },
  { q: "What is Lean methodology in healthcare?", a: "A quality improvement approach focused on <b>maximizing patient value</b> by identifying and eliminating waste (non-value-added steps) in processes." },
  { q: "What is the primary goal of Lean methodology?", a: "To streamline processes, reduce cycle times, and <b>eliminate waste</b> (called 'muda') so that every step adds value to the patient." },
  { q: "Name the 8 wastes of Lean in healthcare (mnemonic: DOWNTIME).", a: "<b>D</b>efects, <b>O</b>verproduction, <b>W</b>aiting, <b>N</b>on-utilized talent, <b>T</b>ransportation, <b>I</b>nventory, <b>M</b>otion, <b>E</b>xtra-processing." },
  { q: "What is Value-Stream Mapping (VSM) in Lean?", a: "A visual mapping tool that charts every step in a process from start to finish, categorizing each step as either <b>value-adding</b> or <b>waste</b>." },
  { q: "What is 'Kaizen' in Lean methodology?", a: "A philosophy of <b>continuous improvement</b> involving all employees, typically implemented through short, focused team events ('Kaizen blitzes') to solve a specific process problem." },
  { q: "What is the '5S' system in Lean methodology?", a: "A workplace organization method: <b>Sort</b> (remove unneeded items), <b>Straighten</b> (organize), <b>Shine</b> (clean), <b>Standardize</b> (make rules), and <b>Sustain</b> (discipline)." },
  { q: "What is Six Sigma methodology?", a: "A data-driven methodology focused on improving quality by <b>reducing variation and defects</b> in processes." },
  { q: "What is the primary goal of Six Sigma?", a: "To achieve near-perfect process output by reducing defects to no more than <b>3.4 defects per million opportunities</b>." },
  { q: "What is the DMAIC framework in Six Sigma?", a: "A structured problem-solving cycle used to improve existing processes: <b>Define, Measure, Analyze, Improve, Control</b>." },
  { q: "What is a Run Chart in Quality Improvement?", a: "A line graph displaying data over time, used to identify <b>trends, shifts, or runs</b> in a process to see if a QI intervention made a difference." },
  { q: "What is a Control Chart (Statistical Process Control)?", a: "A run chart that includes mathematically calculated <b>upper and lower control limits</b> (typically <b>$\\\\pm 3\\\\text{ standard deviations}$</b> from the mean) to differentiate common-cause variation from special-cause variation." },
  { q: "What is the difference between common-cause and special-cause variation?", a: "<b>Common-cause</b> is inherent to the system (predictable noise); <b>special-cause</b> arises from an external factor/event (unpredictable signal) requiring investigation." },
  { q: "What is a Pareto Chart and what does it display?", a: "A bar graph that ranks causes of problems from most to least frequent, with a cumulative percentage line. It helps identify the <b>'vital few'</b> issues that cause the most defects." },
  { q: "What is the 80/20 rule represented by the Pareto Chart?", a: "The principle that roughly <b>80% of problems</b> are caused by <b>20% of the root causes</b>, helping teams focus effort where it will have the greatest impact." },
  { q: "What is the I-PASS handoff protocol?", a: "A validated, standardized communication framework designed to reduce clinical errors during patient handoffs (transfers of care)." },
  { q: "In the I-PASS protocol, what does the 'I' stand for?", a: "<b>Illness severity</b> (e.g., Stable, Watcher, Unstable)." },
  { q: "In the I-PASS protocol, what does the 'P' stand for?", a: "<b>Patient summary</b> (a brief overview of the patient's diagnoses, hospital course, and treatment plan)." },
  { q: "In the I-PASS protocol, what does the 'A' stand for?", a: "<b>Action list</b> (to-do list for the receiving clinician, with clear ownership and deadlines)." },
  { q: "In the I-PASS protocol, what does the first 'S' stand for?", a: "<b>Situation awareness and contingency planning</b> (what to watch out for and what to do if the patient decompensates)." },
  { q: "In the I-PASS protocol, what does the second 'S' stand for?", a: "<b>Synthesis by receiver</b> (the receiver asks questions and briefly summarizes back the key points to confirm understanding)." },
  { q: "Why is a structured handoff protocol like I-PASS critical for patient safety?", a: "It minimizes the risk of <b>information loss</b> and miscommunication, which are among the most common causes of preventable adverse events." },
  { q: "What is a surgical 'time-out'?", a: "A planned pause by the entire surgical team immediately before the incision is made, to perform a final verification of the patient, site, and procedure." },
  { q: "When must the surgical time-out take place?", a: "<b>Immediately before</b> the surgical incision or start of the procedure." },
  { q: "What three core verifications must occur during a surgical time-out?", a: "Verify the <b>correct patient</b>, the <b>correct surgical site</b> (which should be physically marked), and the <b>correct procedure</b>." },
  { q: "Who must participate in a surgical time-out?", a: "<b>All active members</b> of the surgical team, including the surgeon, anesthesia provider, circulating nurse, and surgical scrub tech." },
  { q: "What is a read-back protocol?", a: "A verbal communication safety protocol where the receiver of an oral order or critical lab result repeats it back word-for-word, and the sender confirms it is correct." },
  { q: "When is a read-back protocol mandatory in clinical practice?", a: "When receiving <b>verbal orders, telephone orders</b>, or when critical lab results are reported over the phone." },
  { q: "What is Computerized Physician Order Entry (CPOE)?", a: "A system that allows direct entry of medical orders (meds, labs, imaging) into a computer system rather than writing them by hand." },
  { q: "How does CPOE improve patient safety?", a: "It eliminates <b>handwriting illegibility</b>, standardizes dosing ranges, and screens for drug-drug interactions or allergies in real-time." },
  { q: "What is 'alert fatigue' in safety informatics?", a: "A phenomenon where clinicians become desensitized to safety warnings because of a <b>high volume of clinically insignificant alerts</b>, leading them to bypass critical warnings." },
  { q: "What is medication reconciliation?", a: "The process of creating the most accurate list possible of all medications a patient is taking and comparing it against the physician's admission, transfer, or discharge orders." },
  { q: "When must medication reconciliation be performed?", a: "At <b>every transition of care</b>: admission to the hospital, transfer between units (e.g., ICU to floor), and discharge home." },
  { q: "What is the 'two-identifier' rule for patient identification?", a: "The requirement to use at least two independent patient identifiers (e.g., <b>full name and date of birth</b>) prior to administering medications, drawing blood, or performing procedures." },
  { q: "What is closed-loop communication in healthcare teams?", a: "A communication technique where the sender states a message, the receiver repeats it back, and the sender confirms the accuracy (e.g., during resuscitations)." },
  { q: "What is the Joint Commission's definition of a Sentinel Event?", a: "An unexpected occurrence involving <b>death, permanent harm, or severe temporary harm</b> (such as loss of a limb or function) that is not related to the natural course of the patient's illness." },
  { q: "Give an example of a sentinel event involving wrong site/patient.", a: "Performing a left-sided thoracentesis on a patient who was scheduled for a right-sided procedure (<b>wrong-site surgery</b>)." },
  { q: "Give an example of a sentinel event involving security/care environment.", a: "An infant abduction from the newborn nursery, or the <b>suicide</b> of a patient in a round-the-clock psychiatric facility." },
  { q: "What is the Swiss Cheese Model of system errors?", a: "A safety model illustrating that systems have multiple defensive layers (slices), but each has vulnerabilities (holes); an error occurs when holes in all layers align." },
  { q: "In the Swiss Cheese Model, what do the 'holes' represent?", a: "<b>Latent vulnerabilities or active failures</b> at different levels of the system." },
  { q: "In the Swiss Cheese Model, what do the 'slices of cheese' represent?", a: "<b>Defensive safeguards</b> or barriers built into the system (e.g., checklists, CPOE, read-back protocols, physical guards)." },
  { q: "Who popularized the Swiss Cheese Model of organizational accidents?", a: "<b>James Reason</b>, a cognitive psychologist who specialized in human error and system safety." },
  { q: "What defines a 'Culture of Safety' in a healthcare organization?", a: "An environment where safety is a top priority, staff feel safe reporting errors without fear of retribution, and errors are viewed as opportunities to improve systems." },
  { q: "What is a 'blame-free' reporting system?", a: "A reporting system where staff are not punished for reporting honest mistakes (slips/lapses), ensuring high rates of error disclosure to identify systemic flaws." },
  { q: "What is the 'Second Victim' phenomenon?", a: "The emotional distress, guilt, anxiety, or depression experienced by a <b>healthcare provider</b> who was involved in a serious medical error that harmed a patient." },
  { q: "Who is the 'second victim' in a medical error?", a: "The <b>healthcare professional</b> involved in the event (the patient is the primary victim)." },
  { q: "What support should be provided to a 'second victim'?", a: "Peer support programs, psychological counseling (e.g., Employee Assistance Program), and a <b>non-punitive debriefing</b> of the event." },
  { q: "What is the ethical requirement for disclosing medical errors to patients?", a: "Clinicians must provide a <b>prompt, honest, and empathetic disclosure</b> of the error to the patient/family, including what happened, immediate steps to mitigate harm, and how it will be prevented." },
  { q: "Does disclosing a medical error increase the risk of malpractice lawsuits?", a: "<b>No</b>. Studies show that honest disclosure, accompanied by an apology and explanation, actually <b>decreases</b> the likelihood of lawsuits and reduces litigation costs." },
  { q: "What is a 'Never Event' in patient safety?", a: "A subclass of sentinel events that are particularly shocking, unambiguous, and <b>completely preventable</b> (e.g., leaving a surgical sponge inside a patient)." },
  { q: "How do 'Never Events' differ from 'Sentinel Events' in terms of definitions?", a: "Never events are a defined list of <b>egregious, preventable events</b> (often linked to non-reimbursement), while sentinel events are defined by the severity of the patient outcome (death/harm)." },
  { q: "What is a 'forcing function' in safety design?", a: "A physical or digital design constraint that <b>makes it impossible</b> to perform an incorrect action (e.g., enteral feeding tubes that cannot physically connect to IV lines)." },
  { q: "Give an example of a forcing function for high-alert medications.", a: "Storing concentrated potassium chloride ampules <b>only in the pharmacy</b>, preventing staff from accidentally injecting it directly on the ward without dilution." },
  { q: "What is Human Factors Engineering?", a: "The study of how humans interact with systems, equipment, and environments, aiming to design processes that <b>accommodate human cognitive and physical limitations</b>." },
  { q: "What is Crew Resource Management (CRM) in healthcare?", a: "A safety training framework adapted from aviation focusing on <b>interpersonal communication, teamwork, situational awareness, and flat hierarchies</b> (anyone can speak up for safety)." },
  { q: "What is the difference between a workaround and a forcing function?", a: "A <b>workaround</b> is an informal bypass of a safety protocol (increases risk), while a <b>forcing function</b> is a hard system barrier that cannot be bypassed." },
  { q: "What is high-reliability organization (HRO) theory in healthcare?", a: "A framework for operating in complex, hazardous environments with <b>consistently low rates of error</b> through preoccupation with failure, reluctance to simplify, and deference to expertise." },
  { q: "What is psychological safety in a clinical team?", a: "The belief that one will not be punished, humiliated, or rejected for speaking up with ideas, questions, concerns, or mistakes." },
  { q: "What is the 'Two-Challenge Rule' in team communication?", a: "An advocacy/assertion protocol where a team member must state their concern at least <b>twice</b> if ignored, after which they must escalate up the chain of command." },
  { q: "What is the CUS tool in team communication?", a: "A standardized communication tool to escalate concerns: I am <b>C</b>oncerned, I am <b>U</b>ncomfortable, this is a <b>S</b>afety issue." }
          ]
        },
{
          section: 'Ethics, Law & Health Systems',
          topic: "Public health & preventive medicine",
          icon: "activity",
          cards: [
            { q: "What is the primary objective of <b>primary prevention</b>?", a: "To prevent the <b>onset of disease</b> by reducing exposure to risk factors and hazards (e.g., vaccines, smoking cessation counseling, healthy diet)." },
{ q: "What is the primary objective of <b>secondary prevention</b>?", a: "To detect disease at an <b>early, asymptomatic stage</b> (screening) when intervention can halt or reverse its progression (e.g., mammograms, Pap smears)." },
{ q: "What is the primary objective of <b>tertiary prevention</b>?", a: "To limit disability and <b>rehabilitate established, symptomatic disease</b> to restore function and prevent further complications (e.g., physical therapy, cardiac rehab)." },
{ q: "What is the primary objective of <b>quaternary prevention</b>?", a: "To identify patients at risk of <b>over-medicalization</b>, protect them from unnecessary or harmful medical interventions, and promote ethically acceptable alternatives." },
{ q: "Administering the <b>MMR vaccine</b> to a healthy child represents which level of prevention?", a: "<b>Primary prevention</b>, as it prevents the onset of measles, mumps, and rubella infections." },
{ q: "Advising a healthy adult patient to adopt a <b>low-sodium, Mediterranean diet</b> to prevent hypertension represents which level of prevention?", a: "<b>Primary prevention</b>, as it aims to prevent the development of cardiovascular disease and hypertension before they occur." },
{ q: "Adding <b>fluoride</b> to public drinking water represents which level of prevention?", a: "<b>Primary prevention</b>, as it strengthens tooth enamel and prevents the onset of dental caries in the population." },
{ q: "Supplementing prenatal vitamins with <b>folic acid</b> for women of childbearing age represents which level of prevention?", a: "<b>Primary prevention</b>, as it prevents the development of neural tube defects in the fetus." },
{ q: "Wearing a <b>seatbelt or helmet</b> represents which level of prevention?", a: "<b>Primary prevention</b>, as it prevents or reduces the severity of injury before an accident occurs." },
{ q: "Conducting a <b>screening mammogram</b> in an asymptomatic 50-year-old woman represents which level of prevention?", a: "<b>Secondary prevention</b>, as it aims to detect breast cancer at an early, asymptomatic stage." },
{ q: "Performing a routine <b>Papanicolaou (Pap) smear</b> on a 25-year-old woman represents which level of prevention?", a: "<b>Secondary prevention</b>, as it screens for cervical dysplasia to treat it before it progresses to invasive cervical cancer." },
{ q: "Checking the <b>blood pressure</b> of a healthy adult at a routine wellness visit represents which level of prevention?", a: "<b>Secondary prevention</b>, as it screens for asymptomatic hypertension." },
{ q: "Treating an asymptomatic patient who has a positive PPD skin test with <b>isoniazid</b> represents which level of prevention?", a: "<b>Secondary prevention</b>, as it treats latent tuberculosis infection to prevent it from progressing to active tuberculosis disease." },
{ q: "Performing a <b>screening colonoscopy</b> in an asymptomatic 45-year-old adult represents which level of prevention?", a: "<b>Secondary prevention</b>, as it detects and removes precancerous adenomatous polyps before they progress to colorectal cancer." },
{ q: "Providing <b>physical and occupational therapy</b> to a patient who recently suffered an ischemic stroke represents which level of prevention?", a: "<b>Tertiary prevention</b>, as it aims to maximize recovery, restore function, and prevent contractures or further disability from an established disease." },
{ q: "Enrolling a patient in a structured <b>cardiac rehabilitation program</b> after a myocardial infarction represents which level of prevention?", a: "<b>Tertiary prevention</b>, as it mitigates the damage of established coronary artery disease and reduces the risk of future cardiac events." },
{ q: "Performing <b>annual monofilament foot exams</b> and fundroscopic examinations in a patient with type 2 diabetes represents which level of prevention?", a: "<b>Tertiary prevention</b>, as it aims to detect early microvascular complications (neuropathy, retinopathy) to prevent diabetic ulcers, amputations, and blindness." },
{ q: "Prescribing daily <b>low-dose aspirin</b> to a patient with a prior history of myocardial infarction to prevent a recurrence represents which level of prevention?", a: "<b>Tertiary prevention</b>, as it is aimed at preventing the recurrence of events in a patient with established vascular disease." },
{ q: "Encouraging a patient diagnosed with chronic obstructive pulmonary disease (COPD) to attend a <b>pulmonary rehabilitation</b> program represents which level of prevention?", a: "<b>Tertiary prevention</b>, as it helps optimize breathing efficiency and quality of life in a patient with established chronic lung disease." },
{ q: "Avoiding a <b>lumbar MRI</b> in a patient with acute, uncomplicated low back pain who has no red flags represents which level of prevention?", a: "<b>Quaternary prevention</b>, as it protects the patient from unnecessary imaging, incidental findings, and subsequent unneeded procedures." },
{ q: "Withholding <b>antibiotics</b> in a patient diagnosed with a viral upper respiratory infection represents which level of prevention?", a: "<b>Quaternary prevention</b>, as it prevents antibiotic-associated side effects (e.g., C. difficile, allergic reactions) and the development of antibiotic resistance." },
{ q: "Using clinical decision rules (e.g., PECARN) to avoid performing a <b>head CT scan</b> in a child with minor, low-risk head trauma represents which level of prevention?", a: "<b>Quaternary prevention</b>, as it protects the child from unnecessary ionizing radiation exposure and potential radiation-induced malignancies." },
{ q: "Discussing the potential harms of <b>routine PSA screening</b> (e.g., overdiagnosis, complications of biopsy/surgery) with a 75-year-old man represents which level of prevention?", a: "<b>Quaternary prevention</b>, as it aims to prevent the over-medicalization and overtreatment of low-risk, slow-growing prostate cancer." },
{ q: "If a patient with a strong family history of hypercholesterolemia but normal lipid levels is prescribed a lipid-lowering diet, what level of prevention is this?", a: "<b>Primary prevention</b>, as the patient does not have the disease (hypercholesterolemia) and the intervention is aimed at preventing its onset." },
{ q: "If a patient with newly diagnosed, asymptomatic type 2 diabetes is started on metformin, what level of prevention is this?", a: "<b>Secondary prevention</b>, as the pathological process (diabetes) is already present and the drug is used to control blood glucose and halt progression before symptoms or complications develop." },
{ q: "What is the clinical definition of <b>sensitivity</b>?", a: "The probability that a diagnostic test will yield a <b>positive result</b> in a patient who truly <b>has the disease</b>." },
{ q: "What is the mathematical formula for <b>sensitivity</b> using double-escaped LaTeX?", a: "$\\\\text{Sensitivity} = \\\\frac{\\\\text{TP}}{\\\\text{TP} + \\\\text{FN}}$ where $\\\\text{TP}$ is True Positives and $\\\\text{FN}$ is False Negatives." },
{ q: "What is the clinical definition of <b>specificity</b>?", a: "The probability that a diagnostic test will yield a <b>negative result</b> in a patient who truly <b>does not have the disease</b>." },
{ q: "What is the mathematical formula for <b>specificity</b> using double-escaped LaTeX?", a: "$\\\\text{Specificity} = \\\\frac{\\\\text{TN}}{\\\\text{TN} + \\\\text{FP}}$ where $\\\\text{TN}$ is True Negatives and $\\\\text{FP}$ is False Positives." },
{ q: "What is the clinical definition of <b>Positive Predictive Value (PPV)</b>?", a: "The probability that a patient who <b>tests positive</b> actually <b>has the disease</b>." },
{ q: "What is the mathematical formula for <b>Positive Predictive Value (PPV)</b> using double-escaped LaTeX?", a: "$\\\\text{PPV} = \\\\frac{\\\\text{TP}}{\\\\text{TP} + \\\\text{FP}}$ where $\\\\text{TP}$ is True Positives and $\\\\text{FP}$ is False Positives." },
{ q: "What is the clinical definition of <b>Negative Predictive Value (NPV)</b>?", a: "The probability that a patient who <b>tests negative</b> actually <b>does not have the disease</b>." },
{ q: "What is the mathematical formula for <b>Negative Predictive Value (NPV)</b> using double-escaped LaTeX?", a: "$\\\\text{NPV} = \\\\frac{\\\\text{TN}}{\\\\text{TN} + \\\\text{FN}}$ where $\\\\text{TN}$ is True Negatives and $\\\\text{FN}$ is False Negatives." },
{ q: "What is the clinical definition of a <b>Positive Likelihood Ratio (LR+)</b>?", a: "The ratio of the probability of obtaining a positive test result in a patient <b>with the disease</b> to that in a patient <b>without the disease</b>." },
{ q: "What is the mathematical formula for the <b>Positive Likelihood Ratio (LR+)</b> using double-escaped LaTeX?", a: "$\\\\text{LR+} = \\\\frac{\\\\text{Sensitivity}}{1 - \\\\text{Specificity}}$" },
{ q: "What is the clinical definition of a <b>Negative Likelihood Ratio (LR-)</b>?", a: "The ratio of the probability of obtaining a negative test result in a patient <b>with the disease</b> to that in a patient <b>without the disease</b>." },
{ q: "What is the mathematical formula for the <b>Negative Likelihood Ratio (LR-)</b> using double-escaped LaTeX?", a: "$\\\\text{LR-} = \\\\frac{1 - \\\\text{Sensitivity}}{\\\\text{Specificity}}$" },
{ q: "How does an <b>increase in disease prevalence</b> affect the <b>Positive Predictive Value (PPV)</b> of a screening test?", a: "It <b>increases the PPV</b>, because there are more true positives and fewer false positives in the population." },
{ q: "How does an <b>increase in disease prevalence</b> affect the <b>Negative Predictive Value (NPV)</b> of a screening test?", a: "It <b>decreases the NPV</b>, because there are more false negatives and fewer true negatives in the population." },
{ q: "How does a <b>decrease in disease prevalence</b> affect the <b>sensitivity</b> and <b>specificity</b> of a test?", a: "Sensitivity and specificity <b>remain unchanged</b>, as they are intrinsic properties of the test itself and are independent of disease prevalence." },
{ q: "What is the mnemonic <b>SnNout</b> and when is it clinically applied?", a: "If a test has high <b>Se</b>nsitivity, a <b>N</b>egative result rules <b>out</b> the disease. This is applied in screening tests to minimize missed cases." },
{ q: "What is the mnemonic <b>SpPIn</b> and when is it clinically applied?", a: "If a test has high <b>Sp</b>ecificity, a <b>P</b>ositive result rules <b>in</b> the disease. This is applied in confirmatory tests to confirm a diagnosis." },
{ q: "If the cutoff value of a screening test is shifted to **increase sensitivity**, what happens to the test's **specificity**?", a: "The specificity <b>decreases</b>, as the threshold is lowered, resulting in more false positives." },
{ q: "If the cutoff value of a diagnostic test is shifted to **increase specificity**, what happens to the test's **sensitivity**?", a: "The sensitivity <b>decreases</b>, as the threshold is raised, resulting in more false negatives." },
{ q: "Shifting a diagnostic cutoff to make it **harder to test positive** (raising the threshold) has what effect on PPV and NPV?", a: "It <b>increases PPV</b> (fewer false positives) and <b>decreases NPV</b> (more false negatives)." },
{ q: "Shifting a diagnostic cutoff to make it **easier to test positive** (lowering the threshold) has what effect on PPV and NPV?", a: "It <b>decreases PPV</b> (more false positives) and <b>increases NPV</b> (fewer false negatives)." },
{ q: "What is plotted on the x-axis and y-axis of a <b>Receiver Operating Characteristic (ROC) curve</b>?", a: "The y-axis plots <b>Sensitivity</b> (True Positive Rate) and the x-axis plots <b>$1 - \\\\text{Specificity}$</b> (False Positive Rate)." },
{ q: "What does the <b>Area Under the ROC Curve (AUC)</b> measure, and what is its range?", a: "It measures the overall diagnostic accuracy of a test; the range is from <b>$0.5$</b> (no predictive power, equivalent to chance) to <b>$1.0$</b> (perfect diagnostic accuracy)." },
{ q: "What is <b>lead-time bias</b>?", a: "An apparent increase in survival time that is actually just <b>earlier detection</b> of the disease, with no change in the actual time of death or natural history of the illness." },
{ q: "How can lead-time bias be identified or controlled for in epidemiological studies?", a: "By measuring <b>overall mortality</b> (or cause-specific mortality) in a randomized controlled trial rather than survival time from the date of diagnosis." },
{ q: "What is <b>length-time bias</b>?", a: "An overestimation of survival time because screening disproportionately detects <b>slowly progressive, less aggressive</b> cases of a disease, which have a longer asymptomatic period, while missing rapidly fatal cases." },
{ q: "What is <b>overdiagnosis bias</b>?", a: "The detection of a disease (e.g., indolent prostate, thyroid, or breast tumors) through screening that would never have caused symptoms, morbidity, or death during the patient's lifetime." },
{ q: "According to the <b>Wilson-Jungner criteria</b>, what is the first requirement regarding the condition being screened?", a: "The condition should be an <b>important health problem</b> for the individual and the community." },
{ q: "According to the <b>Wilson-Jungner criteria</b>, what must be available for patients who test positive?", a: "There should be an <b>accepted and effective treatment</b> for patients with recognized disease." },
{ q: "According to the <b>Wilson-Jungner criteria</b>, what facilities must be available?", a: "Facilities for <b>diagnosis and treatment</b> should be readily available." },
{ q: "According to the <b>Wilson-Jungner criteria</b>, what stage of the disease must exist?", a: "There should be a <b>recognizable latent or early symptomatic stage</b> during which intervention is more effective." },
{ q: "According to the <b>Wilson-Jungner criteria</b>, what is required of the screening test itself?", a: "There should be a <b>suitable, valid, and reliable test</b> or examination." },
{ q: "According to the <b>Wilson-Jungner criteria</b>, how should the population view the test?", a: "The test must be <b>acceptable to the population</b> (non-invasive, safe, and easy to perform)." },
{ q: "According to the <b>Wilson-Jungner criteria</b>, what must be understood about the disease?", a: "The <b>natural history of the condition</b>, including development from latent to declared disease, should be adequately understood." },
{ q: "According to the <b>Wilson-Jungner criteria</b>, what policy must be established?", a: "There should be an <b>agreed policy on whom to treat</b> as patients (diagnostic thresholds)." },
{ q: "According to the <b>Wilson-Jungner criteria</b>, how should the cost of screening be evaluated?", a: "The cost of case-finding (including diagnosis and treatment) should be <b>economically balanced</b> in relation to possible expenditure on medical care as a whole." },
{ q: "According to the <b>Wilson-Jungner criteria</b>, what is the required continuity of the program?", a: "Case-finding should be a <b>continuing process</b> and not a 'once and for all' project." },
{ q: "What is the mathematical formula for <b>prevalence</b> using double-escaped LaTeX?", a: "$\\\\text{Prevalence} = \\\\frac{\\\\text{TP} + \\\\text{FN}}{\\\\text{TP} + \\\\text{FN} + \\\\text{FP} + \\\\text{TN}}$ representing the proportion of the population with the disease at a given point in time." },
{ q: "In a cohort of $10,000$ patients with a disease prevalence of $2\\%$, a test with $95\\%$ sensitivity will yield how many **True Positives (TP)**?", a: "<b>$190$</b>. Total diseased $= 2\\\\% \\\\times 10,000 = 200$. $\\\\text{TP} = 95\\\\% \\\\times 200 = 190$." },
{ q: "In a cohort of $10,000$ patients with a disease prevalence of $2\\%$, a test with $90\\%$ specificity will yield how many **False Positives (FP)**?", a: "<b>$980$</b>. Total disease-free $= 9,800$. $\\\\text{FP} = (1 - 0.90) \\\\times 9,800 = 0.10 \\\\times 9,800 = 980$." },
{ q: "If a test has a sensitivity of $90\\%$ and a specificity of $80\\%$, what is the **Positive Likelihood Ratio (LR+)**?", a: "<b>$4.5$</b>. $\\\\text{LR+} = \\\\frac{\\\\text{Sensitivity}}{1 - \\\\text{Specificity}} = \\\\frac{0.90}{1 - 0.80} = \\\\frac{0.90}{0.20} = 4.5$." },
{ q: "If a test has a sensitivity of $95\\%$ and a specificity of $90\\%$, what is the **Negative Likelihood Ratio (LR-)**?", a: "<b>$0.056$</b>. $\\\\text{LR-} = \\\\frac{1 - \\\\text{Sensitivity}}{\\\\text{Specificity}} = \\\\frac{1 - 0.95}{0.90} = \\\\frac{0.05}{0.90} \\\\approx 0.056$." },
{ q: "What is the clinical significance of a **Likelihood Ratio Positive (LR+)** of **$> 10$**?", a: "An $\\\\text{LR+ > 10}$ indicates a <b>very strong increase</b> in the post-test probability of disease, making a positive test highly diagnostic." },
{ q: "What is the clinical significance of a **Likelihood Ratio Negative (LR-)** of **$< 0.1$**?", a: "An $\\\\text{LR- < 0.1}$ indicates a <b>very strong decrease</b> in the post-test probability of disease, making a negative test highly effective at ruling out disease." },
{ q: "What is the clinical definition of **pre-test probability**?", a: "The probability that a patient has a disease <b>before the diagnostic test is performed</b>, based on demographics, prevalence, risk factors, and clinical presentation." },
{ q: "What is <b>passive disease surveillance</b>?", a: "A surveillance system where local healthcare providers and laboratories <b>voluntarily or legally report</b> cases of disease directly to health departments." },
{ q: "What are the main advantages and disadvantages of <b>passive surveillance</b>?", a: "Advantages: <b>Inexpensive</b>, easy to implement, and covers large populations. Disadvantages: <b>Underreporting</b> and incomplete data." },
{ q: "What is <b>active disease surveillance</b>?", a: "A surveillance system where health department personnel <b>actively contact</b> clinics, hospitals, and laboratories or visit communities to identify cases." },
{ q: "What are the main advantages and disadvantages of <b>active surveillance</b>?", a: "Advantages: <b>Highly accurate</b> and complete data. Disadvantages: <b>Expensive</b> and resource-intensive." },
{ q: "What is <b>syndromic surveillance</b>?", a: "The monitoring of **real-time, pre-diagnostic health indicators** (e.g., emergency department chief complaints, OTC drug sales, school absenteeism) to detect disease outbreaks early." },
{ q: "What is the primary clinical goal of <b>syndromic surveillance</b>?", a: "To identify <b>early warning signs</b> of an outbreak or bioterrorist event before laboratory confirmation is completed." },
{ q: "What is the <b>Nationally Notifiable Diseases Surveillance System (NNDSS)</b>?", a: "A CDC-coordinated system that compiles, analyzes, and publishes national data on list-specified infectious and non-infectious conditions reported by states." },
{ q: "What legal authority governs the mandatory reporting of infectious diseases in the United States?", a: "<b>State laws and regulations</b>; the federal government (CDC) cannot legally mandate reporting, but compiles data voluntarily submitted by states." },
{ q: "Which public health reporting category requires notification of the health department <b>immediately (within 24 hours)</b>?", a: "Diseases of **extreme public health urgency** or potential bioterrorism, such as <b>anthrax, botulism, smallpox, plague, cholera, and rabies</b>." },
{ q: "Which public health reporting category requires notification of the health department within **days to weeks**?", a: "Standard notifiable conditions of lower urgency, such as <b>chlamydia, gonorrhea, Lyme disease, syphilis, and chronic hepatitis C</b>." },
{ q: "What is the clinical definition of <b>isolation</b>?", a: "The physical separation and restriction of movement of **known infectious (ill) individuals** to prevent transmission of a pathogen to others." },
{ q: "What is the clinical definition of <b>quarantine</b>?", a: "The physical separation and restriction of movement of **asymptomatic individuals who were exposed** to a pathogen, during the incubation period, to monitor for symptom development." },
{ q: "What is the key difference between **isolation** and **quarantine**?", a: "<b>Isolation</b> applies to individuals who are <b>already ill or known to be infected</b>; <b>quarantine</b> applies to individuals who are <b>currently healthy/asymptomatic</b> but have been exposed." },
{ q: "Which federal agency holds the legal authority to order isolation or quarantine at US ports of entry?", a: "The <b>Centers for Disease Control and Prevention (CDC)</b>, operating under the Department of Health and Human Services (HHS)." },
{ q: "What is the constitutional basis for state-enforced isolation or quarantine orders?", a: "The <b>police power</b> reserved to the states under the <b>10th Amendment</b> to protect the health, safety, and welfare of their citizens." },
{ q: "What is <b>active monitoring</b> of an exposed individual in a quarantine setting?", a: "Public health staff regularly communicate (e.g., by phone or email) with the individual to check for fever or symptoms of the disease." },
{ q: "What is <b>direct active monitoring</b> in disease surveillance?", a: "Public health staff physically and visually observe the exposed individual at least once daily to check for symptoms or verify temperature." },
{ q: "What is <b>sentinel surveillance</b>?", a: "A surveillance system that collects data from a <b>pre-selected sample of high-quality reporting sites</b> (e.g., specific pediatric clinics) to monitor trends rather than count every case." },
{ q: "What is the purpose of <b>vector surveillance</b> in public health?", a: "Monitoring the population and infection rates of disease vectors (e.g., trapping mosquitoes to test for West Nile virus) to predict human transmission risk." },
{ q: "What is a <b>disease registry</b>?", a: "A centralized, organized database that collects uniform clinical and demographic data on individuals diagnosed with a specific condition (e.g., a state cancer registry)." },
{ q: "What is the **first step** in a standard outbreak investigation?", a: "<b>Verify the diagnosis</b> (confirm clinical/lab findings) and <b>prepare for field work</b>." },
{ q: "What is the **second step** in an outbreak investigation?", a: "<b>Confirm the existence of an outbreak</b> by determining if the observed number of cases exceeds the expected baseline number for that area and time." },
{ q: "What is the **third step** in an outbreak investigation?", a: "<b>Establish a case definition</b>, specifying clinical criteria, laboratory results, time constraints, and geographic boundaries." },
{ q: "What is the **fourth step** in an outbreak investigation?", a: "<b>Find cases systematically</b> and construct a <b>line listing</b> to compile clinical and exposure data for all identified cases." },
{ q: "What is the **fifth step** in an outbreak investigation?", a: "Perform <b>descriptive epidemiology</b> to characterize the outbreak by time (epidemic curve), place, and person." },
{ q: "What is the **sixth step** in an outbreak investigation?", a: "<b>Formulate hypotheses</b> regarding the source of the pathogen, the mode of transmission, and the specific exposures." },
{ q: "What is the **seventh step** in an outbreak investigation?", a: "<b>Evaluate hypotheses</b> through analytical epidemiology by conducting <b>case-control</b> or <b>cohort studies</b>." },
{ q: "What is the **eighth step** in an outbreak investigation?", a: "<b>Refine hypotheses</b> and perform additional environmental, laboratory, or epidemiological studies as needed." },
{ q: "What is the **ninth step** in an outbreak investigation?", a: "<b>Implement control and prevention measures</b> (e.g., recall food, close facilities, treat water) to stop transmission. <i>Note: This should be done at any point in the investigation when a source is recognized.</i>" },
{ q: "What is the **tenth step** in an outbreak investigation?", a: "<b>Communicate findings</b> by writing an official report, informing the public/media, and implementing long-term prevention policies." },
{ q: "What is a <b>case definition</b> in an outbreak investigation?", a: "A set of standard criteria used to decide whether an individual is classified as having the disease under investigation; it consists of clinical, lab, time, and place criteria." },
{ q: "What are the three categories of case certainty used in a case definition?", a: "<b>Suspected</b> (clinical signs only), <b>Probable</b> (clinical signs + epidemiological link), and <b>Confirmed</b> (laboratory verification)." },
{ q: "What is a <b>line listing</b> in descriptive epidemiology?", a: "A structured spreadsheet where each row represents a case patient, and each column contains key data (e.g., ID, age, sex, onset date, symptoms, exposures)." },
{ q: "What is an <b>epidemic curve (epi curve)</b>?", a: "A histogram showing the distribution of cases (y-axis) by their time of symptom onset (x-axis), used to determine the mode of transmission." },
{ q: "What are the visual features of a **point source outbreak** on an epi curve?", a: "A **sharp, rapid rise** in cases followed by a **gradual decline**, with all cases occurring within a single incubation period of the pathogen." },
{ q: "What are the visual features of a **continuous common source outbreak** on an epi curve?", a: "A **plateau or flat peak** in cases rather than a single sharp peak, representing ongoing exposure over a period longer than a single incubation period." },
{ q: "What are the visual features of an **intermittent common source outbreak** on an epi curve?", a: "An **irregular pattern of peaks and valleys**, reflecting periodic, non-continuous exposure to a common source." },
{ q: "What are the visual features of a **propagated outbreak** on an epi curve?", a: "Successive, **progressively larger waves** (peaks) of cases spaced approximately one incubation period apart, indicating person-to-person transmission." },
{ q: "What is the difference between an **outbreak** and a **cluster**?", a: "An <b>outbreak</b> is a clear, localized excess of cases compared to baseline; a <b>cluster</b> is an aggregation of cases in time or place that is suspected to be greater than expected." },
{ q: "Under what circumstances is a **case-control study** preferred over a cohort study in an outbreak investigation?", a: "When the **population at risk is ill-defined or open** (e.g., visitors to a city park), making it easy to compare cases to selected controls to identify exposures." },
{ q: "What is the definition of an <b>endemic</b> disease?", a: "The **constant presence or usual prevalence** of a disease or infectious agent within a specific geographic area or population group." },
{ q: "What is the definition of an <b>epidemic</b>?", a: "An **increase in the number of cases** of a disease above what is normally expected (the baseline) in a given population or area." },
{ q: "What is the definition of a <b>pandemic</b>?", a: "An **epidemic** that has spread over **multiple countries or continents**, usually affecting a very large number of people." },
{ q: "What is <b>herd immunity</b>?", a: "The **indirect protection** from an infectious disease that occurs when a high proportion of a population becomes immune, thereby disrupting transmission." },
{ q: "What is the <b>basic reproduction number ($R_0$)</b>?", a: "The average number of secondary cases generated by a single infectious individual in a **completely susceptible** population." },
{ q: "What is the mathematical formula for the <b>herd immunity threshold (HIT)</b> using double-escaped LaTeX?", a: "$\\\\text{HIT} = 1 - \\\\frac{1}{\\\\text{R}_0}$ representing the proportion of the population that must be immune to halt transmission." },
{ q: "If the $R_0$ for measles is $18$, what is the calculated **herd immunity threshold (HIT)**?", a: "<b>$94.4\\%$</b>. $\\\\text{HIT} = 1 - \\\\frac{1}{18} = \\\\frac{17}{18} \\\\approx 94.4\\\\%$." },
{ q: "If the $R_0$ for a strain of influenza is $2.0$, what is the calculated **herd immunity threshold (HIT)**?", a: "<b>$50\\%$</b>. $\\\\text{HIT} = 1 - \\\\frac{1}{2.0} = 0.50$ or $50\\\\%$." },
{ q: "What is the <b>effective reproduction number ($R$ or $R_t$)</b> and its formula using double-escaped LaTeX?", a: "The average number of secondary cases per infectious individual in a population with partial immunity. Formula: $\\\\text{R} = \\\\text{R}_0 \\\\times \\\\text{S}$ where $\\\\text{S}$ is the proportion of susceptible individuals." },
{ q: "Under what condition will a disease outbreak begin to decline and eventually die out?", a: "When the **effective reproduction number ($R$) is less than $1$** ($\\\\text{R < } 1$)." },
{ q: "What is the <b>Vaccine Adverse Event Reporting System (VAERS)</b>?", a: "A national, **passive surveillance system** co-managed by the CDC and FDA that accepts reports of adverse events post-vaccination from anyone." },
{ q: "What is the primary limitation of data collected by <b>VAERS</b>?", a: "It **cannot establish causality**; reports indicate only temporal association, are subject to reporting bias, and lack non-vaccinated comparison groups." },
{ q: "What is the <b>Vaccine Safety Datalink (VSD)</b>?", a: "An **active surveillance system** that links electronic health record data from large healthcare organizations to monitor vaccine safety in near real-time." },
{ q: "What is the role of the <b>Clinical Immunization Safety Assessment (CISA) Project</b>?", a: "A collaboration between CDC and medical centers that provides expert clinical consultation on complex vaccine safety cases and conducts clinical safety research." },
{ q: "What is the primary objective of **Phase 1** vaccine clinical trials?", a: "To evaluate **safety, tolerability, and immunogenicity** in a small group of healthy volunteers ($20\\text{--}80$ individuals)." },
{ q: "What is the primary objective of **Phase 2** vaccine clinical trials?", a: "To determine the **optimal dose, immunization schedule, and safety profile** in a larger target population ($100\\text{--}300$ individuals)." },
{ q: "What is the primary objective of **Phase 3** vaccine clinical trials?", a: "To confirm **efficacy and monitor for rare adverse events** in thousands of randomized participants ($1,000\\text{--}30,000+$ individuals)." },
{ q: "What is the primary objective of **Phase 4** vaccine trials?", a: "To perform **post-marketing surveillance** of safety and effectiveness in the general public after the vaccine is approved and distributed." },
{ q: "What are the two absolute contraindications for all **live attenuated vaccines** (e.g., MMR, varicella)?", a: "1. **Pregnancy** (risk of fetal transmission)<br>2. **Severe immunodeficiency** (e.g., CD4 count $< 200/\\\\mu\\\\text{L}$ or severe chemotherapy-induced immunosuppression)." },
{ q: "What is the immediate pharmacological management for an anaphylactic reaction following vaccination?", a: "Intramuscular **epinephrine** $0.3\\\\text{ mg}$ (dose for adults; $0.15\\\\text{ mg}$ for children) administered in the anterolateral thigh, airway management, and calling EMS." }
          ]
        },
        {
          section: "Clinical Case Integration (Step 2 CK)",
          topic: "Multi-system clinical vignettes",
          icon: "activity",
          cards: [
            { q: "A 28-year-old African American female presents with painful red nodules on her shins, blurry vision, and painful joints. Chest X-ray reveals bilateral hilar lymphadenopathy. What is the most likely diagnosis and what biopsy finding confirms it?", a: "<b>Sarcoidosis</b> (Löfgren syndrome triad: erythema nodosum, bilateral hilar lymphadenopathy, migratory polyarthralgia). Biopsy reveals <b>non-caseating granulomas</b> containing multinucleated giant cells with Schaumann and asteroid bodies." },
            { q: "A 32-year-old female with a history of joint pain and a malar rash presents with generalized edema. Urinalysis shows 3+ proteinuria and red blood cell casts. Which autoantibodies are most specific, and what is the next best step in management?", a: "<b>Anti-Smith</b> and <b>anti-dsDNA</b> are highly specific for SLE. The next best step is a <b>renal biopsy</b> to determine the class of lupus nephritis and guide immunosuppressive therapy." },
            { q: "A 65-year-old male presents with fatigue, macroglossia, peripheral neuropathy, and nephrotic-range proteinuria. Echocardiography shows a restrictive cardiomyopathy with a \"speckled\" appearance. What diagnostic stain and birefringence finding confirms the diagnosis?", a: "<b>Congo Red stain</b> of abdominal fat pad or rectal biopsy, showing <b>apple-green birefringence</b> under polarized light, confirming amyloid deposition." },
            { q: "A 52-year-old male presents with hyperpigmented skin, new-onset diabetes mellitus, hepatomegaly, and severe pain in his 2nd and 3rd metacarpophalangeal (MCP) joints. What is the most common gene mutation, and what is the preferred initial treatment?", a: "<b>HFE gene mutation</b> (typically C282Y homozygous on Chromosome 6). The preferred treatment is therapeutic <b>phlebotomy</b> to maintain ferritin levels < 50 mcg/L." },
            { q: "A 40-year-old IV drug user presents with fever, a new cardiac murmur, painless erythematous macules on his palms, and painful nodules on his pads of fingers. Urinalysis shows hematuria. What is the most likely diagnosis and what are these cutaneous findings called?", a: "<b>Infective Endocarditis</b> with systemic embolization. Painless palmar macules: <b>Janeway lesions</b> (microabscesses). Painful digital nodules: <b>Osler's nodes</b> (immune complex deposition). Splinter hemorrhages under nails and Roth spots on retina may also be present." },
            { q: "A 45-year-old male presents with chronic sinusitis, nasal mucosal ulcerations, hemoptysis, and acute renal failure. Urinalysis shows RBC casts. What serum marker is diagnostic, and what does biopsy show?", a: "<b>c-ANCA (PR3-ANCA)</b>. Biopsy of lung or kidney shows <b>necrotizing granulomatous vasculitis</b> (kidney shows pauci-immune crescentic glomerulonephritis)." },
            { q: "A 50-year-old female presents with purpuric skin lesions, hemoptysis, and acute renal failure, without any history of upper respiratory or sinus involvement. What serum marker is associated, and how does it differ histologically from GPA?", a: "<b>p-ANCA (MPO-ANCA)</b>. Histology shows necrotizing vasculitis <b>without granulomas</b> (unlike GPA, which features prominent granulomatous inflammation)." },
            { q: "A 38-year-old male with a history of severe asthma and allergic rhinitis presents with foot drop (mononeuritis multiplex) and palpable purpura. Labs show marked peripheral eosinophilia. What is the diagnosis and most common ANCA association?", a: "<b>Eosinophilic Granulomatosis with Polyangiitis (EGPA / Churg-Strauss)</b>. Associated with <b>p-ANCA (MPO-ANCA)</b> in ~40-50% of cases." },
            { q: "A 29-year-old female presents with chronic diarrhea, weight loss, iron deficiency anemia refractory to oral iron, and a pruritic vesicular rash on her elbows and knees. What is the rash, and what antibodies should be checked?", a: "The rash is <b>dermatitis herpetiformis</b> (caused by IgA deposition in dermal papillae). Screen with <b>anti-tissue transglutaminase (tTG) IgA</b> and <b>total serum IgA</b> (due to association with selective IgA deficiency)." },
            { q: "A 24-year-old male of Mediterranean descent presents with recurrent painful oral aphthous ulcers, painful scrotal ulcers, anterior uveitis, and painful red skin nodules. Puncture of his skin with a sterile needle results in a pustule 24 hours later. What is this clinical phenomenon and diagnosis?", a: "<b>Behçet syndrome</b>. The phenomenon is a <b>positive pathergy test</b>, demonstrating exaggerated skin inflammatory response." },
            { q: "A 44-year-old female presents with tightening of the skin on her fingers, face, and chest, along with dysphagia, exertional dyspnea, and severe hypertension with acute renal failure. What are the specific antibody associations and the diagnosis?", a: "<b>Diffuse cutaneous systemic sclerosis</b> with <b>scleroderma renal crisis</b> and interstitial lung disease. Associated with <b>anti-Scl-70 (anti-topoisomerase I)</b> and <b>anti-RNA polymerase III</b> antibodies. (Limited systemic sclerosis / CREST is associated with <b>anti-centromere</b>)." },
            { q: "An 8-year-old boy presents with developmental delay, seizures, hypopigmented macules (ash-leaf spots), facial angiofibromas, and multiple subependymal nodules on brain MRI. What renal tumor is associated with this condition?", a: "<b>Renal angiomyolipoma</b> (benign tumor of fat, muscle, and blood vessels; carries risk of life-threatening retroperitoneal hemorrhage if > 4 cm)." },
            { q: "A 14-year-old girl presents with >6 café-au-lait spots, axillary freckling (Crowe sign), iris hamartomas (Lisch nodules), and scoliosis. What vascular tumor of the adrenal gland is associated with this autosomal dominant condition?", a: "<b>Pheochromocytoma</b> (NF1 is associated with an increased risk of pheochromocytoma, GISTs, and optic pathway gliomas)." },
            { q: "A 35-year-old female with Graves' disease is admitted for emergency appendectomy. In the recovery room, she develops a fever of 104°F (40°C), tachycardia of 150 bpm, severe agitation, and jaundice. What is the diagnosis and the immediate medical regimen?", a: "<b>Thyroid Storm</b> (triggered by surgery). Immediate regimen: <b>propranolol</b> (beta-blocker), <b>propylthiouracil (PTU)</b> (blocks synthesis & peripheral conversion), <b>potassium iodide</b> (blocks release), and <b>hydrocortisone</b> (reduces conversion and treats relative adrenal insufficiency)." },
            { q: "A 55-year-old male farmer presents with chronic diarrhea, weight loss, migratory arthralgias, skin hyperpigmentation, and memory impairment. Small bowel biopsy reveals PAS-positive macrophages containing rod-shaped bacilli. What is the causative organism and preferred treatment?", a: "<i>Tropheryma whipplei</i>. Treatment is IV <b>ceftriaxone</b> for 2 weeks, followed by oral <b>trimethoprim-sulfamethoxazole (TMP-SMX)</b> for 1 year." },
            { q: "A 48-year-old male presents with fever, weight loss, severe abdominal pain after eating, testicular pain, and livedo reticularis. Labs show elevated creatinine and active Hepatitis B infection. What is the diagnosis and what does angiography show?", a: "<b>Polyarteritis Nodosa (PAN)</b>. Angiography reveals <b>segmental microaneurysms and occlusions</b> in medium-sized visceral arteries (renal, mesenteric)." },
            { q: "A 28-year-old female with a history of three consecutive 1st-trimester miscarriages presents with acute right leg swelling. Labs show a prolonged activated partial thromboplastin time (aPTT) that does not correct with a 1:1 mixing study. What is the diagnosis and what is the mechanism of the lab anomaly?", a: "<b>Antiphospholipid Syndrome (APS)</b>. The prolonged aPTT is caused by <b>lupus anticoagulant</b> binding to phospholipids in the test reagent, interfering with the coagulation assay <i>in vitro</i> (despite being highly prothrombotic <i>in vivo</i>)." },
            { q: "A 45-year-old female presents with severe dry eyes, dry mouth, rampant dental caries, and bilateral parotid gland enlargement. What antibodies are associated, and what lymphoma risk is increased?", a: "<b>Anti-Ro/SSA</b> and <b>anti-La/SSB</b>. There is a 5% lifetime risk (a 40-fold increase) of developing <b>non-Hodgkin lymphoma</b> (specifically B-cell MALT lymphoma)." },
            { q: "A 72-year-old male presents with lower back pain, fatigue, and constipation. Labs show serum calcium of 11.5 mg/dL, creatinine of 2.1 mg/dL, and Hb of 9.2 g/dL. X-rays reveal lytic lesions in the lumbar spine. What is the diagnosis and what diagnostic test is required?", a: "<b>Multiple Myeloma</b> (CRAB: Hypercalcemia, Renal insufficiency, Anemia, Bone lesions). Requires <b>bone marrow biopsy</b> showing > 10% clonal plasma cells." },
            { q: "A 52-year-old female presents with proximal muscle weakness (difficulty climbing stairs) and a violaceous rash on her upper eyelids, erythematous papules on her knuckles, and a rash across her upper back. What are these cutaneous findings, and what screening is critical?", a: "Heliotrope rash (eyelids), Gottron's papules (knuckles), and Shawl sign (upper back), diagnostic of <b>Dermatomyositis</b>. <b>Age-appropriate cancer screening</b> is critical due to a strong association with internal malignancies (ovarian, lung, GI)." },
            { q: "A 34-year-old female presents with Raynaud's phenomenon, swollen hands, proximal muscle weakness, and joint pain. Labs show high antinuclear antibody (ANA) titers and highly elevated antibodies to U1 ribonucleoprotein. What is the diagnosis?", a: "<b>Mixed Connective Tissue Disease (MCTD)</b>, defined by overlapping features of SLE, systemic sclerosis, and polymyositis with specific <b>anti-U1-RNP</b> antibodies." },
            { q: "A 19-year-old male presents with abnormal liver function tests, dysarthria, resting tremor, parkinsonian gait, and new-onset depression and psychosis. Slit-lamp exam reveals Kayser-Fleischer rings. What is the primary biochemical defect, and how is it diagnosed?", a: "<b>ATP7B gene mutation</b> causing impaired copper transport and biliary excretion. Diagnosed by <b>low serum ceruloplasmin</b>, elevated 24-hour urinary copper, and increased hepatic copper on biopsy." },
            { q: "A 50-year-old male presents with painless jaundice and a mass in the head of the pancreas mimicking pancreatic cancer. Biopsy reveals dense lymphoplasmacytic infiltrate with storiform fibrosis and obliterative phlebitis. Serum IgG4 is elevated. What is the diagnosis and initial treatment?", a: "<b>IgG4-related disease</b> (autoimmune pancreatitis). The initial treatment is highly responsive to <b>corticosteroids</b> (prednisone)." },
            { q: "A 54-year-old male with chronic Hepatitis C presents with palpable purpura on his lower extremities, joint pain, peripheral neuropathy, and hematuria. Serum complement levels reveal low C4. What is the diagnosis and what is the underlying pathophysiology?", a: "<b>Mixed Cryoglobulinemia</b>. Pathophysiology involves immune complexes of immunoglobulins (mostly IgM rheumatoid factor bound to IgG and HCV antigen) depositing in small vessels, causing <b>leukocytoclastic vasculitis</b>." },
            { q: "A 62-year-old male presents with sudden, tearing chest pain radiating to his back. On exam, he is hypertensive with asymmetric radial pulses. He suddenly develops left-sided weakness and a rise in serum creatinine. What is the mechanism of the neurological and renal signs?", a: "The dissecting aortic flap has <b>extended into the right brachiocephalic/common carotid artery</b> (causing cerebral ischemia/stroke) and the <b>renal arteries</b> (causing acute kidney injury)." },
            { q: "A 70-year-old male presents with worsening bone pain, increased hat size, and progressive bilateral hearing loss. Cardiovascular exam reveals a hyperdynamic state and bilateral pulmonary rales. What is the mechanism of the hearing loss and cardiac symptoms?", a: "<b>Paget's disease of bone</b>. Hearing loss is due to <b>cranial nerve VIII entrapment</b> in the stenosed internal auditory canal. High-output heart failure is caused by <b>arteriovenous shunts</b> formed in the highly vascular pagetic bone." },
            { q: "A 42-year-old male presents with progressive enlargement of his hands, widening dental spaces, severe sweating, and worsening sleep apnea. He is found to have a cardiomyopathy and a blood glucose of 210 mg/dL. What is the initial screening test and the definitive diagnostic test?", a: "Screen by measuring <b>serum IGF-1 level</b> (elevated). Confirm with an <b>oral glucose tolerance test (OGTT)</b>, demonstrating failure of GH suppression (< 1 ng/mL) after a 75g glucose load." },
            { q: "A 6-year-old girl is brought to the ED with fatigue, pallor, petechiae, and oliguria. She had an episode of bloody diarrhea 5 days ago. Labs show Hb of 7.5 g/dL, platelets of 45,000/mcL, and creatinine of 2.8 mg/dL. Smear shows schistocytes. What is the diagnosis and management?", a: "<b>Hemolytic Uremic Syndrome (HUS)</b>. Management is <b>supportive</b> (fluid/electrolyte monitoring, transfusion if needed). <b>Avoid antibiotics and antidiarrheals</b>, as they increase Shiga toxin release and worsen renal outcomes." },
            { q: "A 30-year-old female presents with recurrent nosebleeds and red macules on her lips and fingers. She also has chronic dyspnea and clubbing. Chest CT shows a pulmonary arteriovenous malformation (AVM). What is this autosomal dominant syndrome and what major cardiac complication can it cause?", a: "<b>Hereditary Hemorrhagic Telangiectasia (HHT / Osler-Weber-Rendu)</b>. The pulmonary AVMs cause right-to-left shunting (leading to hypoxemia/cyanosis) and can result in <b>high-output heart failure</b> due to decreased systemic vascular resistance." },
            { q: "A 35-year-old male presents with episodic throbbing headaches, palpitations, sweating, and severe hypertension. Family history is significant for medullary thyroid cancer. What genetic syndrome is suspected, and what screening test should be performed?", a: "<b>Multiple Endocrine Neoplasia Type 2 (MEN 2A or 2B)</b>. Screen for pheochromocytoma by measuring <b>plasma free metanephrines</b> or <b>24-hour urinary metanephrines</b>." }
          ]
        },
        {
          section: "Clinical Case Integration (Step 2 CK)",
          topic: "Diagnostic reasoning & management algorithms",
          icon: "git-branch",
          cards: [
            { q: "A 42-year-old female presents with severe epigastric pain radiating to her back, accompanied by nausea. What is the diagnostic criteria for acute pancreatitis, and what is the cornerstone of early management?", a: "Diagnosis requires <b>2 of 3</b>: 1) characteristic epigastric pain; 2) serum amylase or lipase <b>$\\\\ge 3$ times upper limit of normal</b>; 3) characteristic findings on abdominal imaging. Cornerstone of management is <b>aggressive IV fluid resuscitation</b> (preferably Lactated Ringer's) and early enteral nutrition. Prophylactic antibiotics are <b>not</b> recommended." },
            { q: "What is the diagnostic algorithm for a patient with suspected pulmonary embolism (PE) based on their Wells score?", a: "If Wells score is <b>low/moderate ($\\\\le 4$)</b>: check <b>D-dimer</b>. If D-dimer is normal, PE is ruled out; if elevated, perform <b>CT pulmonary angiography (CTPA)</b>. If Wells score is <b>high ($> 4$)</b>: proceed directly to <b>CTPA</b> without D-dimer. (Use V/Q scan if CTPA is contraindicated, e.g., renal failure, pregnancy, contrast allergy)." },
            { q: "A 62-year-old male is started on unfractionated heparin for a DVT. Five days later, his platelet count drops by 50% to 80,000/mcL. What is the immediate management algorithm?", a: "1) <b>Stop all heparin products immediately</b> (including flushes). 2) Start a non-heparin anticoagulant, preferably a <b>direct thrombin inhibitor</b> (e.g., argatroban, bivalirudin). 3) Send a HIT antibody assay (ELISA) followed by serotonin release assay. 4) <b>Do not give platelets</b> (prothrombotic) and <b>do not start warfarin</b> until platelets recover to $\\\\ge 150,000/\\\\text{mcL}$ (prevents venous limb gangrene)." },
            { q: "Explain the diagnostic and management algorithm for a patient presenting with new-onset ascites.", a: "Perform a diagnostic <b>paracentesis</b> to calculate the Serum-Ascites Albumin Gradient ($\\\\text{SAAG} = \\\\text{Serum Albumin} - \\\\text{Ascitic Albumin}$). If <b>SAAG $\\\\ge 1.1\\\\text{ g/dL}$</b>: portal hypertension (e.g., cirrhosis, heart failure); treat with salt restriction and diuretics (spironolactone + furosemide). If <b>SAAG $< 1.1\\\\text{ g/dL}$</b>: peritoneal cause (e.g., carcinomatosis, TB, pancreatitis); treat underlying cause." },
            { q: "A 65-year-old male with history of prostate cancer presents with progressive, severe back pain, lower extremity weakness, and urinary retention. What is the immediate management algorithm?", a: "1) Administer <b>high-dose intravenous glucocorticoids</b> (dexamethasone) immediately (before imaging, to reduce spinal edema). 2) Obtain an <b>urgent MRI of the entire spine</b>. 3) Consult <b>neurosurgery</b> or radiation oncology for decompression/radiation." },
            { q: "What is the first-line treatment for anaphylaxis, and how is it administered?", a: "Intramuscular <b>epinephrine $0.3\\\\text{ mg}$ (1:1000)</b> administered in the <b>anterolateral thigh</b>. Repeat every 5-15 minutes if symptoms persist or worsen. Give aggressive IV fluid boluses for hypotension refractory to epinephrine." },
            { q: "What is the immediate medical management for a patient presenting to the ED with crushing chest pain and ST-segment elevation on ECG (STEMI)?", a: "Administer <b>chewable aspirin $325\\\\text{ mg}$</b>, a <b>P2Y12 inhibitor</b> (e.g., clopidogrel, ticagrelor), and intravenous <b>unfractionated heparin</b>. Control pain and ischemia with sublingual <b>nitroglycerin</b> (unless contraindicated, e.g., right ventricular MI or PDE-5 inhibitor use) and IV <b>beta-blockers</b> (if hemodynamically stable). Arrange for <b>emergent coronary angiography/percutaneous coronary intervention (PCI)</b> within 90 minutes." },
            { q: "What is the management algorithm for a patient with a wide-complex tachycardia (monomorphic ventricular tachycardia) who is hemodynamically stable vs. hemodynamically unstable?", a: "If <b>unstable</b> (chest pain, dyspnea, hypotension, altered mental status): perform <b>immediate synchronized cardioversion</b>. If <b>stable</b>: administer antiarrhythmic medications (preferably <b>amiodarone</b> or <b>procainamide</b>; procainamide is preferred in stable WPW-associated tachycardia)." },
            { q: "What is the management algorithm for a patient with severe bradycardia (HR < 50 bpm) who is hemodynamically unstable?", a: "First-line medication is <b>atropine $1\\\\text{ mg}$ IV</b> (repeat every 3-5 mins, max $3\\\\text{ mg}$). If atropine is ineffective, initiate <b>transcutaneous pacing</b> or start an infusion of <b>epinephrine</b> or <b>dopamine</b>." },
            { q: "What is the step-by-step management algorithm for Diabetic Ketoacidosis (DKA) regarding fluids, insulin, and potassium?", a: "1) <b>Aggressive IV fluid resuscitation</b> with normal saline (NS). 2) Check potassium ($\\\\text{K}^+$): if <b>$\\\\text{K}^+ < 3.3\\\\text{ mEq/L}$</b>, hold insulin and replete $\\\\text{K}^+$; if <b>$\\\\text{K}^+$ 3.3–5.3</b>, start insulin infusion ($0.1\\\\text{ U/kg/hr}$) and add potassium ($20\\\\text{--}30\\\\text{ mEq/L}$) to fluids; if <b>$\\\\text{K}^+ > 5.3$</b>, start insulin only and check $\\\\text{K}^+$ every 2 hours. 3) Switch to dextrose-containing fluids when blood glucose is $< 200\\\\text{ mg/dL}$ (DKA) or $< 300\\\\text{ mg/dL}$ (HHS) to allow closure of the anion gap." },
            { q: "A patient with end-stage renal disease is found to have a serum potassium of 7.2 mEq/L. The ECG shows peaked T waves and QRS widening. What is the management algorithm?", a: "1) <b>Stabilize cardiac membrane</b>: Administer <b>intravenous calcium gluconate</b> (or calcium chloride) immediately. 2) <b>Shift potassium intracellularly</b>: Give <b>intravenous insulin + dextrose</b> and inhaled <b>albuterol</b> (or IV sodium bicarbonate if metabolic acidosis is present). 3) <b>Eliminate potassium</b>: Administer <b>loop diuretics</b>, <b>sodium zirconium cyclosilicate (Lokelma)</b>, or initiate <b>emergent hemodialysis</b>." },
            { q: "A patient presents with sudden onset right-sided weakness and aphasia starting 2 hours ago. What is the immediate diagnostic and management algorithm?", a: "1) Obtain a <b>non-contrast head CT</b> immediately to rule out intracranial hemorrhage. 2) Check blood glucose to rule out hypoglycemia. 3) If CT is negative for hemorrhage, and patient meets inclusion criteria, administer <b>intravenous alteplase (tPA)</b> (must be given within <b>3 to 4.5 hours</b> of symptom onset; keep blood pressure <b>$< 185/110\\\\text{ mmHg}$</b> before administration)." },
            { q: "Describe the escalational pharmacotherapy algorithm for a patient in status epilepticus (seizures lasting > 5 minutes).", a: "First-line (0-5 mins): IV <b>lorazepam</b> (or IM <b>midazolam</b> if no IV access). Second-line (5-20 mins): IV antiepileptic drug, e.g., <b>fosphenytoin</b>, <b>levetiracetam</b>, or <b>valproate</b>. Third-line (>20 mins): Continuous infusion of anesthetic agents (e.g., <b>propofol</b>, <b>midazolam</b>, or <b>ketamine</b>) with continuous EEG monitoring." },
            { q: "A patient presents with the \"worst headache of their life.\" The non-contrast head CT is normal. What is the next diagnostic step, and what is the management algorithm if positive?", a: "The next step is a <b>lumbar puncture</b> to look for <b>xanthochromia</b> (pink/yellow CSF from RBC lysis) or elevated RBC count that does not decrease from tube 1 to 4. If positive: manage blood pressure (target systolic $< 160\\\\text{ mmHg}$ using IV nicardipine/labetalol), administer <b>nimodipine</b> (prevents cerebral vasospasm/delayed ischemia), and obtain urgent neurosurgical consultation for coiling/clipping." },
            { q: "A 52-year-old male presents with fever, headache, altered mental status, and neck stiffness. What is the diagnostic and management algorithm?", a: "1) Draw blood cultures. 2) Immediately administer <b>empiric IV antibiotics + dexamethasone</b> (dexamethasone reduces neurological sequelae, especially in <i>S. pneumoniae</i> meningitis). 3) Perform head CT if signs of elevated ICP (papilledema, focal deficits) or immunocompromised. 4) Perform <b>lumbar puncture</b>. Empiric regimen: <b>ceftriaxone + vancomycin + ampicillin</b> (ampicillin covers <i>Listeria monocytogenes</i> in patients $> 50$ or immunocompromised)." },
            { q: "What is the management algorithm for hypernatremia (sodium > 145 mEq/L) based on volume status?", a: "If **hypovolemic and hemodynamically unstable**: resuscitate with <b>isotonic saline (0.9% NS)</b> until stable, then switch to a hypotonic solution (e.g., <b>5% dextrose in water (D5W)</b> or <b>0.45% saline</b>) to correct the free water deficit. If **euvolemic**: give free water orally or IV D5W. <b>Crucial rule</b>: Correct sodium slowly (rate <b>$< 10\\\\text{ mEq/L/day}$</b>) to prevent <b>cerebral edema</b>." },
            { q: "Describe the diagnostic and therapeutic algorithm for SIADH.", a: "Diagnostic criteria: hypotonic hyponatremia ($\\\\text{serum osm} < 275\\\\text{ mOsm/kg}$), high urine osmolality ($> 100\\\\text{ mOsm/kg}$), high urine sodium ($> 40\\\\text{ mEq/L}$), and clinical euvolemia. Management: 1) First-line: <b>fluid restriction</b> ($< 1\\\\text{ L/day}$). 2) Moderate: oral salt tablets + loop diuretics. 3) Severe (seizures, coma): <b>3% hypertonic saline</b> (correct slowly, <b>$< 8\\\\text{--}10\\\\text{ mEq/L/day}$</b>, to prevent <b>osmotic demyelination syndrome</b>)." },
            { q: "A 65-year-old female presents with sudden onset of severe right eye pain, headache, nausea, and blurry vision with halos around lights. The pupil is mid-dilated and non-reactive to light. What is the diagnostic and management algorithm?", a: "Diagnostic test is <b>tonometry</b> showing intraocular pressure (IOP) $> 30\\\\text{ mmHg}$. Management: immediate combination of topical drops (e.g., <b>timolol</b>, <b>apraclonidine</b>, <b>pilocarpine</b>), systemic <b>acetazolamide</b>, and urgent ophthalmology referral for definitive <b>bilateral laser peripheral iridotomy</b>." },
            { q: "In what specific order must medications be administered during a thyroid storm, and what is the pharmacological rationale?", a: "1) <b>Beta-blockers</b> (e.g., propranolol) first to block sympathetic hyperactivity. 2) <b>Thionamides</b> (e.g., PTU or methimazole) to block thyroid hormone synthesis. 3) <b>Iodine</b> (e.g., potassium iodide) administered <b>at least 1 hour AFTER</b> thionamides, to block hormone release (giving iodine first can fuel further hormone synthesis via the Wolff-Chaikoff effect). 4) <b>Glucocorticoids</b> (hydrocortisone) to reduce peripheral conversion of T4 to T3 and treat relative adrenal insufficiency." },
            { q: "What is the pharmacological preparation algorithm prior to surgical resection of a pheochromocytoma?", a: "1) Initiate <b>alpha-blockade</b> (e.g., phenoxybenzamine) for 7–14 days first to prevent hypertensive crisis. 2) Initiate <b>beta-blockade</b> (e.g., propranolol) only <b>after</b> adequate alpha-blockade to control reflex tachycardia. <b>Rule</b>: Never give a beta-blocker first, as it blocks beta-2-mediated vasodilation, leaving alpha-1 vasoconstriction unopposed, causing a catastrophic hypertensive crisis." },
            { q: "A patient presents 3 hours after ingestive overdose of acetaminophen. What is the management algorithm?", a: "1) If patient presents within 4 hours, administer <b>activated charcoal</b>. 2) Obtain a serum acetaminophen level at <b>exactly 4 hours</b> post-ingestion (or immediately if $> 4$ hours have passed). 3) Plot the level on the <b>Rumack-Matthew nomogram</b>. 4) If the level is above the treatment line, initiate <b>intravenous N-acetylcysteine (NAC)</b> (most effective within 8 hours of ingestion)." },
            { q: "A patient is rescued from a house fire presenting with headache, confusion, and cherry-red skin. Pulse oximetry is 98% on room air. What is the diagnostic test of choice and the management algorithm?", a: "Pulse oximetry is falsely normal because standard pulse oximeters cannot distinguish carboxyhemoglobin from oxyhemoglobin. Diagnostic test: <b>arterial or venous blood gas with co-oximetry</b> to measure <b>carboxyhemoglobin (COHb)</b>. Management: <b>100% high-flow oxygen</b> via non-rebreather mask (reduces CO half-life from 5 hours to 90 minutes). Use <b>hyperbaric oxygen</b> if COHb $> 25\\%$ (or $> 15\\%$ in pregnancy), or if neurological signs, myocardial ischemia, or severe acidosis are present." },
            { q: "A patient undergoing chemotherapy presents with a temperature of 101.3°F (38.5°C) and an absolute neutrophil count (ANC) of 300/mcL. What is the management algorithm?", a: "This is a medical emergency. 1) Obtain blood cultures (and other cultures/labs). 2) <b>Immediately (within 1 hour) administer empiric anti-pseudomonal monotherapy</b> (e.g., <b>cefepime</b>, <b>piperacillin-tazobactam</b>, or <b>meropenem</b>). Do not wait for culture results or imaging. Add vancomycin only if catheter infection, skin/soft tissue infection, hemodynamic instability, or pneumonia is suspected." },
            { q: "What are the key components of the 1-hour sepsis resuscitation bundle?", a: "1) Measure serum <b>lactate</b> level (re-measure if initial $> 2\\\\text{ mmol/L}$). 2) Obtain blood cultures <b>prior</b> to administration of antibiotics. 3) Administer broad-spectrum <b>IV antibiotics</b>. 4) Rapidly administer <b>$30\\\\text{ mL/kg}$ crystalloid fluid</b> for hypotension or lactate $\\\\ge 4\\\\text{ mmol/L}$. 5) Apply vasopressors (preferably <b>norepinephrine</b>) if the patient remains hypotensive during or after fluid resuscitation to maintain a Mean Arterial Pressure ($\\\\text{MAP}$) $\\\\ge 65\\\\text{ mmHg}$." },
            { q: "What are the diagnostic criteria and the ventilator management algorithm for Acute Respiratory Distress Syndrome (ARDS)?", a: "Diagnostic criteria (Berlin definition): 1) acute onset ($< 1$ week); 2) bilateral opacities on chest imaging not explained by heart failure; 3) hypoxemia defined by a ratio of $\\\\text{PaO}_2/\\\\text{FiO}_2 \\\\le 300\\\\text{ mmHg}$. Ventilator management: <b>low tidal volume ventilation ($6\\\\text{ mL/kg}$ of ideal body weight)</b> to prevent barotrauma, <b>high PEEP</b> to prevent atelectasis, and target oxygenation $\\\\text{SpO}_2$ 88–95% ($\\\\text{PaO}_2$ 55–80 mmHg)." },
            { q: "A 5-year-old child presents with high fever, sore throat, drooling, and stridor, sitting in a \"tripod\" position. What is the diagnostic and management algorithm?", a: "1) Keep the child calm and <b>avoid examining the throat with a tongue depressor</b> (can trigger fatal laryngospasm). 2) Transport the patient directly to the operating room for <b>controlled endotracheal intubation</b> under general anesthesia. 3) Confirm diagnosis with visualization of an erythematous, swollen epiglottis during intubation. 4) Administer IV antibiotics (e.g., ceftriaxone + vancomycin) after airway is secured." },
            { q: "What clinical parameters are used to monitor respiratory status in a patient with myasthenia gravis, and what is the management algorithm for a myasthenic crisis?", a: "Monitor respiratory status using <b>Forced Vital Capacity (FVC)</b> and <b>Negative Inspiratory Force (NIF)</b>. If FVC drops $< 20\\\\text{ mL/kg}$ or NIF is $>-30\\\\text{ cm H}_2\\\\text{O}$, intubate electively. Management of crisis: 1) **Hold anticholinesterase medications** (e.g., pyridostigmine) temporarily to reduce airway secretions. 2) Initiate <b>plasmapheresis (plasma exchange)</b> or <b>IVIG</b>. 3) Start high-dose corticosteroids." },
            { q: "A patient with chronic adrenal insufficiency presents with hypotension refractory to IV fluids, severe abdominal pain, and confusion. Labs show hyponatremia and hyperkalemia. What is the immediate management algorithm?", a: "1) Administer <b>intravenous hydrocortisone $100\\\\text{ mg}$</b> immediately (has both glucocorticoid and mineralocorticoid activity; do not delay for ACTH stimulation test results). 2) Administer aggressive <b>isotonic saline (0.9% NS) resuscitation</b> with 5% dextrose to correct hypotension, hyponatremia, and hypoglycemia." },
            { q: "How is Tumor Lysis Syndrome (TLS) prevented and managed?", a: "Prevention/Management: 1) <b>Aggressive IV hydration</b> to maintain high urine output. 2) For low/moderate risk: oral or IV <b>allopurinol</b> (xanthine oxidase inhibitor) to prevent uric acid formation. 3) For high risk or active TLS: IV <b>rasburicase</b> (recombinant urate oxidase) to convert uric acid to soluble allantoin. **Contraindication**: Rasburicase is contraindicated in <b>G6PD deficiency</b> due to the risk of severe acute hemolysis and methemoglobinemia." },
            { q: "What is the management algorithm for secondary hyperparathyroidism in chronic kidney disease?", a: "1) Restrict dietary phosphate. 2) Administer <b>phosphate binders</b> (e.g., <b>calcium carbonate/acetate</b> if calcium is low/normal; <b>sevelamer</b> or <b>lanthanum</b> if calcium is high, to prevent metastatic calcification). 3) Replete active vitamin D with <b>calcitriol</b> if parathyroid hormone (PTH) remains elevated. 4) Use calcimimetics (e.g., <b>cinacalcet</b>) to increase calcium-sensing receptor sensitivity on the parathyroid gland if refractory." }
          ]
        },
        {
          section: "Clinical Case Integration (Step 2 CK)",
          topic: "Pharmacotherapy in clinical context",
          icon: "pill",
          cards: [
            { q: "Which specific beta-blockers have a proven mortality benefit in patients with Heart Failure with Reduced Ejection Fraction (HFrEF), and when should they be initiated?", a: "<b>Metoprolol succinate</b> (extended-release), <b>carvedilol</b>, and <b>bisoprolol</b>. They must be initiated only when the patient is <b>hemodynamically stable</b> (e.g., not during an acute decompensated flare with fluid overload) at a low dose and slowly titrated upward." },
            { q: "What is the mechanism by which ACE inhibitors and ARBs slow the progression of diabetic nephropathy, and what hemodynamic effect do they have on the glomerulus?", a: "They block angiotensin II-mediated vasoconstriction of the <b>efferent arteriole</b>, leading to <b>efferent arteriole vasodilation</b>. This decreases <b>intraglomerular capillary pressure ($\\\\text{P}_{\\\\text{gc}}$)</b>, reducing hyperfiltration and proteinuria." },
            { q: "What are the major toxicities of amiodarone, and what routine screening tests must be performed?", a: "1) <b>Pulmonary toxicity</b> (interstitial pneumonitis/fibrosis); monitor with baseline and annual <b>chest X-ray and Pulmonary Function Tests (PFTs)</b>. 2) <b>Thyroid dysfunction</b> (hypo- or hyperthyroidism due to high iodine content); monitor <b>Thyroid Function Tests (TFTs)</b> every 6 months. 3) <b>Hepatotoxicity</b>; monitor <b>Liver Function Tests (LFTs)</b> every 6 months. 4) Corneal microdeposits and blue-gray skin discoloration." },
            { q: "Which commonly prescribed medications can precipitate acute lithium toxicity, and what is the mechanism?", a: "<b>Thiazide diuretics</b> (e.g., chlorthalidone), <b>NSAIDs</b> (except aspirin), and <b>ACE inhibitors/ARBs</b>. They decrease renal clearance of lithium by increasing sodium and water resorption in the proximal tubule, causing lithium to be co-reabsorbed." },
            { q: "What electrolyte abnormality predisposes a patient to digoxin toxicity, and what are the classic clinical signs and treatment?", a: "<b>Hypokalemia</b> (digoxin binds to the $\\\\text{K}^+$-binding site of the $\\\\text{Na}^+/\\\\text{K}^+$ ATPase; less potassium means more digoxin binding). Signs: nausea, vomiting, confusion, cardiac arrhythmias (classic: paroxysmal atrial tachycardia with AV block), and <b>yellow-green visual halos</b>. Treat severe toxicity with <b>digoxin-specific antibody (Fab) fragments</b>." },
            { q: "What is the mechanism of action of statins, what are their two main severe adverse effects, and what is the screening guideline?", a: "Mechanism: competitive inhibition of <b>HMG-CoA reductase</b>. Adverse effects: <b>statin-induced myopathy</b> (ranging from myalgias to rhabdomyolysis, increased risk when combined with fibrates) and <b>hepatotoxicity</b>. Check baseline <b>transaminases (AST/ALT)</b> before starting; routine monitoring is not required unless symptoms develop." },
            { q: "Contrast the molecular targets of Direct Oral Anticoagulants (DOACs) and Warfarin.", a: "<b>Apixaban, rivaroxaban, and edoxaban</b> are direct inhibitors of <b>Factor Xa</b> (converting prothrombin to thrombin). <b>Dabigatran</b> is a direct inhibitor of <b>Factor IIa (thrombin)</b>. <b>Warfarin</b> inhibits <b>vitamin K epoxide reductase complex subunit 1 (VKORC1)</b>, blocking the synthesis of clotting factors <b>II, VII, IX, and X</b> and proteins <b>C and S</b>." },
            { q: "What is the primary mechanism of action of metformin, what is its most feared adverse effect, and what GFR threshold contraindicates its use?", a: "Mechanism: inhibits mitochondrial respiratory chain complex I, leading to <b>decreased hepatic gluconeogenesis</b> and increased peripheral insulin sensitivity. Feared adverse effect: <b>lactic acidosis</b>. Contraindicated if <b>$\\\\text{GFR} < 30\\\\text{ mL/min/1.73 m}^2$</b> (hold metformin before iodinated contrast and resume 48 hours later after verifying normal renal function)." },
            { q: "What are the specific cardiovascular and renal benefits of GLP-1 receptor agonists vs. SGLT2 inhibitors in type 2 diabetes?", a: "<b>GLP-1 receptor agonists</b> (e.g., semaglutide, liraglutide) reduce major adverse cardiovascular events (MACE) and promote weight loss. <b>SGLT2 inhibitors</b> (e.g., empagliflozin, dapagliflozin) reduce <b>heart failure hospitalizations</b> and slow the progression of <b>diabetic kidney disease</b> (nephroprotection) by blocking renal glucose and sodium reabsorption in the proximal tubule." },
            { q: "What is the mechanism of action of sulfonylureas, and why are they generally avoided in the elderly?", a: "Mechanism: bind to and close the <b>sulfonylurea receptor/ATP-sensitive potassium ($\\\\text{K}_{\\\\text{ATP}}$) channel</b> in pancreatic beta cells, depolarizing the cell membrane and stimulating <b>insulin secretion</b> independent of glucose levels. They are avoided in the elderly due to a high risk of <b>prolonged, severe hypoglycemia</b> (especially long-acting agents like glyburide or glimepiride)." },
            { q: "Which atypical (second-generation) antipsychotics carry the highest risk of metabolic syndrome, and what unique monitoring is required for clozapine?", a: "<b>Olanzapine</b> and <b>clozapine</b> carry the highest risk of weight gain, hyperglycemia, and dyslipidemia. Clozapine requires absolute neutrophil count (ANC) monitoring due to the risk of <b>agranulocytosis</b> (neutropenia)." },
            { q: "A 25-year-old female is brought to the ED after taking a large bottle of amitriptyline. Her ECG shows a QRS duration of 120 ms. What is the clinical triad of TCA toxicity, and what is the treatment for cardiotoxicity?", a: "Triad: <b>Cardiotoxicity</b> (QRS widening, arrhythmias due to cardiac sodium channel blockade), <b>Convulsions</b> (seizures), and <b>Coma</b>. Treat cardiotoxicity with <b>intravenous sodium bicarbonate ($\\\\text{NaHCO}_3$)</b> to increase extracellular sodium concentration and raise blood pH, reducing drug binding to cardiac sodium channels." },
            { q: "Contrast the clinical presentation and pharmacotherapy of Neuroleptic Malignant Syndrome (NMS) and Serotonin Syndrome.", a: "<b>NMS</b>: characterized by <b>\"lead-pipe\" muscle rigidity</b>, high fever, autonomic instability, and elevated creatine kinase (CK); caused by dopamine antagonists; treat with <b>dantrolene</b> or <b>bromocriptine</b>. <b>Serotonin Syndrome</b>: characterized by <b>hyperreflexia, neuromuscular clonus</b>, tremor, diarrhea; caused by serotonergic drugs; treat with <b>cyproheptadine</b>." },
            { q: "What are the key adverse effects of Methotrexate and Hydroxychloroquine, and how are they monitored?", a: "<b>Methotrexate</b>: causes macrocytic anemia (folate deficiency), hepatotoxicity, oral ulcers, and pulmonary fibrosis; supplement with <b>folic acid</b> and monitor CBC and LFTs regularly. <b>Hydroxychloroquine</b>: causes <b>retinal toxicity</b> (maculopathy); monitor with baseline and annual <b>ophthalmologic exams</b> (field testing, SD-OCT)." },
            { q: "How does the pharmacotherapy for an acute gout flare differ from chronic gout management?", a: "<b>Acute flare</b>: treat with <b>NSAIDs (indomethacin)</b>, <b>colchicine</b> (inhibits microtubule polymerization), or <b>corticosteroids</b> (oral or intra-articular). <b>Chronic management</b>: treat with <b>allopurinol</b> or <b>febuxostat</b> (xanthine oxidase inhibitors). <b>Crucial rule</b>: Do not initiate or stop allopurinol during an acute flare, as fluctuating uric acid levels can worsen and prolong the attack." },
            { q: "What are the endocrine, skeletal, and ophthalmic side effects of chronic systemic corticosteroid use?", a: "Endocrine: <b>hyperglycemia</b> (insulin resistance), cushingoid habitus, adrenal insufficiency (suppression of HPA axis). Skeletal: <b>osteoporosis</b> (decreased osteoblast activity, treated with bisphosphonates), <b>avascular necrosis</b> of the femoral head. Ophthalmic: <b>cataracts</b> and <b>glaucoma</b> (increased IOP)." },
            { q: "Explain the mechanism of action of Sildenafil, Bosentan, and Epoprostenol in the treatment of pulmonary arterial hypertension (PAH).", a: "<b>Sildenafil</b>: inhibits <b>phosphodiesterase-5 (PDE-5)</b>, increasing cGMP and promoting nitric oxide-mediated vasodilation. <b>Bosentan</b>: is an antagonist of <b>endothelin-1 receptors</b>, blocking vasoconstriction. <b>Epoprostenol</b>: is a <b>prostacyclin (PGI2) analog</b>, promoting direct vasodilation and inhibiting platelet aggregation." },
            { q: "Contrast the mechanism, onset of action, and systemic side effects of Tamsulosin and Finasteride in Benign Prostatic Hyperplasia (BPH).", a: "<b>Tamsulosin</b>: is an <b>alpha-1 blocker</b> that relaxes prostatic smooth muscle; has rapid onset (days); side effects include orthostatic hypotension and retrograde ejaculation. <b>Finasteride</b>: is a <b>5-alpha-reductase inhibitor</b> that blocks conversion of testosterone to dihydrotestosterone (DHT), shrinking the prostate gland; has delayed onset (6-12 months); side effects include erectile dysfunction and decreased libido." },
            { q: "Why is the co-administration of nitroglycerin and sildenafil strictly contraindicated?", a: "Nitroglycerin increases nitric oxide, which stimulates guanylyl cyclase to produce cGMP. Sildenafil inhibits PDE-5, the enzyme that degrades cGMP. Together, they cause a <b>synergistic accumulation of cGMP</b>, leading to profound, life-threatening <b>systemic vasodilation and hypotension</b>." },
            { q: "What is the current standard first-step maintenance and reliever therapy for mild-to-moderate asthma based on GINA guidelines?", a: "<b>Low-dose Inhaled Corticosteroid (ICS) + Formoterol</b> (a rapid, long-acting beta-2 agonist) used <b>as-needed (prn)</b> for symptom relief. This combined therapy is preferred over SABA monotherapy to reduce the risk of severe exacerbations by treating airway inflammation early." },
            { q: "Under what clinical criteria does long-term oxygen therapy improve survival in patients with Chronic Obstructive Pulmonary Disease (COPD)?", a: "1) Resting arterial oxygen tension <b>$\\\\text{PaO}_2 \\\\le 55\\\\text{ mmHg}$</b> or oxygen saturation <b>$\\\\text{SaO}_2 \\\\le 88\\%$</b>. 2) Resting <b>$\\\\text{PaO}_2$ 56–59 mmHg</b> or <b>$\\\\text{SaO}_2$ 89%</b> with concurrent <b>cor pulmonale</b>, right heart failure, or erythrocytosis (hematocrit $> 55\\%$)." },
            { q: "What is the administration protocol for oral bisphosphonates (e.g., alendronate), and what is the clinical rationale?", a: "Take the medication <b>first thing in the morning</b> on an empty stomach with a <b>full glass of plain water</b>, and <b>remain completely upright for at least 30 minutes</b> before consuming any food, beverage, or other medications. This prevents drug-induced <b>pill esophagitis</b> (chemical irritation of the esophageal mucosa) and maximizes poor absorption." },
            { q: "Why is Levodopa always co-administered with Carbidopa, and what are the unique side effects of Dopamine Agonists (e.g., pramipexole)?", a: "<b>Carbidopa</b> inhibits peripheral <b>dopa decarboxylase</b>, preventing the peripheral conversion of levodopa to dopamine. This increases the amount of levodopa that crosses the blood-brain barrier and decreases peripheral dopamine side effects (nausea, orthostatic hypotension). <b>Dopamine agonists</b> can cause <b>impulse control disorders</b> (compulsive gambling, shopping, hypersexuality) due to stimulation of the mesolimbic dopamine pathway." },
            { q: "What are the FDA black box warnings and severe systemic toxicities associated with fluoroquinolones (e.g., ciprofloxacin, levofloxacin)?", a: "<b>Tendonitis and tendon rupture</b> (Achilles tendon most common), <b>QT interval prolongation</b> (arrhythmias), <b>aortic aneurysm dissection/rupture</b>, peripheral neuropathy, and glycemic fluctuations. They are generally contraindicated in pregnancy, during lactation, and in pediatric patients." },
            { q: "What are the three primary adverse effects of aminoglycosides (e.g., gentamicin, amikacin), and how is renal safety monitored?", a: "1) <b>Nephrotoxicity</b> (acute tubular necrosis, typically reversible). 2) <b>Ototoxicity</b> (vestibular dysfunction and cochlear damage, often irreversible). 3) <b>Neuromuscular blockade</b> (contraindicated in myasthenia gravis). Monitor renal safety by measuring <b>serum trough levels</b> (high trough levels correlate with increased toxicity risk) and creatinine." },
            { q: "What is the mechanism of \"red man syndrome\" associated with vancomycin, and how is it managed? What parameters are monitored to prevent nephrotoxicity?", a: "\"Red man syndrome\" is a <b>non-immunologic, rate-dependent histamine release</b> caused by rapid infusion of vancomycin; manage by <b>slowing the infusion rate</b> and administering antihistamines. Prevent nephrotoxicity by monitoring <b>vancomycin trough levels</b> (target <b>$15\\\\text{--}20\\\\text{ mcg/mL}$</b> for severe infections like MRSA bacteremia, osteomyelitis, or pneumonia)." },
            { q: "Explain the mixed acid-base disorder seen in acute aspirin (salicylate) toxicity, and what is the role of sodium bicarbonate?", a: "Salicylates cause: 1) <b>Primary respiratory alkalosis</b> by directly stimulating the medullary respiratory center (hyperventilation). 2) <b>Primary high anion gap metabolic acidosis</b> by uncoupling oxidative phosphorylation, leading to anaerobic glycolysis and accumulation of lactic acid and ketoacids. <b>Sodium bicarbonate ($\\\\text{NaHCO}_3$)</b> is administered to alkalinize the blood and urine, which ionizes the salicylate ($\\\\text{A}^-$), trapping it in the urine to promote renal excretion and preventing it from crossing the blood-brain barrier." },
            { q: "Contrast the pupillary and autonomic signs of acute opioid overdose and acute opioid withdrawal, and identify the first-line treatments?", a: "<b>Overdose</b>: presents with <b>miosis (pinpoint pupils)</b>, respiratory depression, bradycardia, hypothermia, decreased bowel sounds; treat with IV/intranasal <b>naloxone</b> (opioid antagonist). <b>Withdrawal</b>: presents with <b>mydriasis (dilated pupils)</b>, lacrimation, rhinorrhea, piloerection (\"goosebumps\"), yawning, diarrhea, hyperactive bowel sounds; treat with <b>methadone</b>, <b>buprenorphine</b>, or alpha-2 agonists like <b>clonidine</b> for autonomic symptoms." },
            { q: "State the specific antidotes for cyanide poisoning, lead poisoning, and ethylene glycol/methanol toxicity.", a: "<b>Cyanide</b>: treat with <b>hydroxocobalamin</b> (binds cyanide to form cyanocobalamin) or a combination of <b>sodium nitrite</b> (induces methemoglobinemia, which binds cyanide) and <b>sodium thiosulfate</b> (promotes conversion to thiocyanate). <b>Lead</b>: treat with oral <b>succimer</b> (mild/moderate) or IV <b>dimercaprol + EDTA</b> (severe/encephalopathy). <b>Ethylene glycol/methanol</b>: treat with <b>fomepizole</b> (inhibits alcohol dehydrogenase, preventing formation of toxic metabolites)." },
            { q: "What is the mechanism of spironolactone-induced gynecomastia in male patients, and what alternative drug can be used?", a: "Spironolactone is a non-selective aldosterone antagonist that also binds to and blocks <b>androgen receptors</b> and stimulates <b>progesterone receptors</b>. This leads to gynecomastia, decreased libido, and erectile dysfunction. The alternative is <b>eplerenone</b>, which is a selective aldosterone antagonist with low affinity for sex hormone receptors." }
          ]
        },
        {
          section: "Clinical Case Integration (Step 2 CK)",
          topic: "Surgical vs medical decision making",
          icon: "scissors",
          cards: [
            { q: "A 24-year-old male presents with 12 hours of periumbilical pain that has migrated to the right lower quadrant, accompanied by fever and guarding. What is the definitive management for uncomplicated acute appendicitis vs. appendiceal rupture with a stable abscess?", a: "For <b>uncomplicated acute appendicitis</b>: immediate <b>surgical appendectomy</b> (or intravenous antibiotics in select cases). For <b>ruptured appendicitis with a stable, localized abscess</b>: manage non-operatively first with <b>IV antibiotics and CT-guided percutaneous drainage</b>, followed by an <b>interval appendectomy</b> 6–8 weeks later." },
            { q: "Contrast the clinical presentation and management of Cholelithiasis, Acute Cholecystitis, Choledocholithiasis, and Acute Cholangitis.", a: "<b>Cholelithiasis</b>: transient postprandial RUQ pain, normal labs; treat with elective outpatient cholecystectomy. <b>Acute Cholecystitis</b>: persistent RUQ pain, positive Murphy's sign, fever, leukocytosis; treat with supportive care and laparoscopic cholecystectomy <b>within 72 hours</b>. <b>Choledocholithiasis</b>: gallstone in common bile duct causing obstructive jaundice (elevated bilirubin/ALP), no fever; treat with <b>ERCP</b> followed by cholecystectomy. <b>Acute Cholangitis</b>: Charcot's triad (fever, jaundice, RUQ pain) $\\\\pm$ Reynolds' pentad (plus hypotension, altered mental status); treat with <b>emergent ERCP for biliary decompression</b> + IV broad-spectrum antibiotics." },
            { q: "A 55-year-old female with a history of prior abdominal surgeries presents with nausea, vomiting, abdominal distension, and obstipation. What key clinical and radiographic findings dictate conservative medical management vs. emergent surgical laparotomy?", a: "<b>Conservative management</b> (NPO, IV fluids, NG tube decompression) is indicated for <b>partial SBO</b> (demonstrated by presence of air in the distal colon/rectum on X-ray) and stable patients. <b>Emergent laparotomy</b> is indicated for <b>complete SBO</b> (no distal gas) or signs of <b>strangulation/ischemia</b> (fever, tachycardia, leukocytosis, metabolic acidosis, continuous localized pain, or peritonitis)." },
            { q: "Explain the management criteria for uncomplicated diverticulitis vs. complicated diverticulitis with a large abscess vs. diverticulitis with perforation.", a: "<b>Uncomplicated</b>: managed outpatient with oral antibiotics and a clear liquid diet. <b>Complicated with abscess $\\\\ge 3\\\\text{ cm}$</b>: require hospitalization, IV antibiotics, and <b>CT-guided percutaneous drainage</b>. <b>Complicated with perforation/peritonitis</b>: require emergent surgical resection of the diseased segment with end-colostomy (<b>Hartmann's procedure</b>)." },
            { q: "A 72-year-old male with a history of peptic ulcer disease presents with sudden-onset, diffuse, severe abdominal pain. On exam, he has a rigid, silent abdomen with rebound tenderness. What is the diagnostic finding of choice and immediate management?", a: "Diagnostic finding: <b>pneumoperitoneum (free air under the diaphragm)</b> visible on upright chest X-ray or CT abdomen. Immediate management: <b>emergent surgical laparotomy</b>, IV broad-spectrum antibiotics (covering enteric gram-negative and anaerobic organisms), and aggressive fluid resuscitation." },
            { q: "What are the screening guidelines for Abdominal Aortic Aneurysm (AAA), and what are the specific indications for surgical repair?", a: "Screening: one-time <b>abdominal ultrasound</b> for men aged <b>65–75</b> who have <b>ever smoked</b>. Repair indications: 1) aneurysm size <b>$\\\\ge 5.5\\\\text{ cm}$</b>; 2) rapid expansion rate (<b>$> 0.5\\\\text{ cm}$ in 6 months</b> or $> 1\\\\text{ cm}$ in 1 year); 3) any <b>symptomatic</b> aneurysm (abdominal/back pain, tenderness, distal embolization) regardless of size." },
            { q: "What are the indications for carotid endarterectomy (CEA) based on stenosis severity in symptomatic vs. asymptomatic patients?", a: "<b>Symptomatic</b> (TIA/stroke in the ipsilateral carotid territory): CEA is indicated for <b>$70\\\\text{--}99\\%$ stenosis</b> (strong benefit) and <b>$50\\\\text{--}69\\%$ stenosis</b> (moderate benefit, depending on patient age and comorbidities). <b>Asymptomatic</b>: CEA is considered for <b>$60\\\\text{--}99\\%$ stenosis</b> if life expectancy is $> 5$ years and surgical complication rate is $< 3\\%$. Manage $< 50\\%$ medically with antiplatelets and statins." },
            { q: "Contrast the radiographic appearance, anatomy, and surgical indications for Epidural Hematomas (EDH) and Subdural Hematomas (SDH).", a: "<b>EDH</b>: biconvex (lens-shaped) hyperdensity, does not cross suture lines; rupture of <b>middle meningeal artery</b>; surgical decompression indicated if volume $> 30\\\\text{ cm}^3$, thickness $> 15\\\\text{ mm}$, midline shift $> 5\\\\text{ mm}$, or pupil abnormalities. <b>SDH</b>: crescent-shaped hyperdensity, crosses suture lines; rupture of <b>bridging veins</b>; surgical decompression indicated if thickness $> 10\\\\text{ mm}$, midline shift $> 5\\\\text{ mm}$, or neurological deterioration (GCS decrease $\\\\ge 2$). Small, asymptomatic hematomas can be monitored conservatively with serial CT scans." },
            { q: "What is the pediatric management algorithm for acute otitis media (AOM)?", a: "Administer <b>immediate amoxicillin</b> for: 1) age <b>$< 6$ months</b> (always); 2) age <b>$6\\\\text{--}23$ months</b> with <b>bilateral</b> AOM or severe symptoms (toxic-looking, severe otalgia, temp $\\\\ge 39^\\\\circ\\\\text{C}$); 3) age <b>$\\\\ge 2$ years</b> with severe symptoms. Offer <b>observation/watchful waiting</b> for 48–72 hours for unilateral AOM in children 6–23 months without severe symptoms, or unilateral/bilateral AOM in children $\\\\ge 2$ years without severe symptoms." },
            { q: "Describe the diagnostic and therapeutic algorithm for suspected Group A Streptococcal (GAS) pharyngitis using the Centor criteria.", a: "Centor criteria: <b>Fever</b> ($1$ pt), <b>Tonsillar exudates</b> ($1$ pt), <b>Tender anterior cervical adenopathy</b> ($1$ pt), <b>Absence of cough</b> ($1$ pt). If score <b>0–1</b>: no testing or treatment. If score <b>2–3</b>: perform <b>Rapid Antigen Detection Test (RADT)</b>; if positive, treat with oral penicillin/amoxicillin. If score <b>4</b>: treat empirically or perform RADT. (Note: in children, a negative RADT <b>must</b> be confirmed with a throat culture before withholding treatment; not required in adults)." },
            { q: "A patient is scheduled for elective splenectomy due to hereditary spherocytosis. What is the vaccination and prophylactic regimen, and what is the optimal timing?", a: "Vaccinate against encapsulated organisms: <b>Streptococcus pneumoniae</b>, <b>Neisseria meningitidis</b>, and <b>Haemophilus influenzae type b (Hib)</b>. Optimal timing: <b>$\\\\ge 14$ days prior</b> to surgery (or 14 days after emergency splenectomy). Daily prophylactic oral <b>penicillin</b> is recommended for children post-splenectomy for at least 5 years or until adulthood." },
            { q: "A patient presents with a stab wound to the abdomen. What clinical signs mandate immediate emergent laparotomy?", a: "1) **Hemodynamic instability** (systolic BP $< 90\\\\text{ mmHg}$). 2) **Peritonitis** (rigidity, rebound tenderness). 3) **Evisceration** (herniation of bowel/omentum). 4) Blood on nasogastric tube or rectal exam. (If hemodynamically stable and none of these are present, obtain a contrast-enhanced CT of the abdomen)." },
            { q: "Describe the diagnostic algorithm for blunt abdominal trauma based on hemodynamic stability and Focused Assessment with Sonography for Trauma (FAST) results.", a: "If the patient is **hemodynamically unstable**: perform a <b>FAST exam</b>. If <b>FAST positive</b> (free fluid in hepatorenal, splenorenal, pelvis, or pericardium), proceed directly to <b>emergent laparotomy</b>. If <b>FAST negative/indeterminate</b>, perform diagnostic peritoneal lavage or search for extra-abdominal blood loss. If the patient is **hemodynamically stable**: proceed to <b>abdominal CT with IV contrast</b> (regardless of FAST results)." },
            { q: "What is the diagnostic evaluation pathway for a palpable breast mass based on patient age?", a: "If age <b>$< 30$</b>: obtain a <b>breast ultrasound</b>. If simple cyst, aspirate if symptomatic; if solid/complex, perform a <b>core needle biopsy</b>. If age <b>$\\\\ge 30$</b>: obtain a <b>mammogram AND ultrasound</b>, followed by a <b>core needle biopsy</b> of any suspicious lesions. (Fine needle aspiration is not preferred for solid masses as it cannot evaluate tissue architecture)." },
            { q: "Outline the diagnostic algorithm for a newly discovered thyroid nodule $\\\\ge 1\\\\text{ cm}$.", a: "1) Measure <b>serum TSH level</b> and perform a <b>thyroid ultrasound</b>. 2) If TSH is <b>normal or elevated</b>: perform a <b>Fine Needle Aspiration (FNA)</b> biopsy based on ultrasound risk criteria (size $\\\\ge 1\\\\text{ cm}$ with high-suspicion features). 3) If TSH is <b>low</b>: obtain a <b>thyroid scintigraphy (radionuclide scan)</b>. If the nodule is \"hot\" (hyperfunctioning), it is benign; manage hyperthyroidism. If the nodule is \"cold\" (non-functioning), perform an <b>FNA</b>." },
            { q: "A 10-month-old infant presents with episodic severe abdominal pain, vomiting, and a sausage-shaped mass in the RUQ. What is the diagnostic test of choice and the management algorithm?", a: "Diagnostic test of choice is <b>abdominal ultrasound</b> showing a <b>\"target\" or \"donut\" sign</b>. Management: therapeutic <b>air or contrast enema</b> under fluoroscopic/ultrasonographic guidance. Perform <b>emergent surgical laparotomy</b> only if there are signs of peritonitis, bowel perforation (free air), or if the enema fails to reduce the intussusception." },
            { q: "A 4-week-old male infant presents with non-bilious projectile vomiting after every feed. On exam, he has an olive-shaped mass in the epigastrium. Labs show a hypokalemic, hypochloremic metabolic alkalosis. What is the immediate management algorithm?", a: "The immediate step is <b>NOT surgery</b>. First, <b>resuscitate with IV fluids (normal saline + dextrose + potassium)</b> to completely correct dehydration and electrolyte abnormalities (which reduces the risk of post-operative apnea). Once stable, perform a diagnostic ultrasound (pyloric muscle thickness $\\\\ge 4\\\\text{ mm}$, length $\\\\ge 15\\\\text{ mm}$), followed by surgical <b>pyloromyotomy</b>." },
            { q: "A 14-year-old male presents with sudden-onset, severe left testicular pain. On exam, the left testis is swollen, retracted upward, and the cremasteric reflex is absent. What is the management algorithm?", a: "This is a surgical emergency. <b>Immediate surgical exploration with detorsion and bilateral orchiopexy</b> (anchoring the testes to the scrotum to prevent recurrence). If surgical access is delayed, attempt manual detorsion (rotating \"like opening a book\"). <b>Rule</b>: Do not delay surgery to obtain a Doppler ultrasound if clinical suspicion is high and the presentation is within the 6-hour viability window." },
            { q: "Outline the medical vs. surgical management of kidney stones based on stone size and clinical complications.", a: "If stone is <b>$< 5\\\\text{ mm}$</b>: managed conservatively with hydration, analgesics, and an alpha-1 blocker (tamsulosin) to facilitate passage. If stone is <b>$5\text{--}10\\\\text{ mm}$</b>: medical expulsive therapy or elective urologic intervention. If stone is <b>$> 10\\\\text{ mm}$</b>, or if there is <b>refractory pain, acute kidney injury, or concurrent UTI/sepsis (obstructive uropathy)</b>: perform <b>urgent surgical decompression</b> via <b>retrograde ureteral stent insertion</b> or <b>percutaneous nephrostomy</b>, followed by lithotripsy." },
            { q: "Describe the initial stabilization and triage algorithm for a patient presenting with hematemesis.", a: "1) Secure airway if obtunded or actively vomiting. 2) Establish <b>two large-bore IVs</b> and start aggressive crystalloid fluid resuscitation. 3) Administer <b>IV proton pump inhibitor infusion</b> (pantoprazole). 4) If variceal bleed is suspected (e.g., history of cirrhosis), administer <b>IV octreotide</b> and prophylactic <b>IV ceftriaxone</b> (reduces mortality and infection risk). 5) Perform <b>urgent upper endoscopy (EGD) within 24 hours</b> for diagnosis and therapeutic intervention (banding, clipping, or thermal coagulation)." },
            { q: "A 68-year-old male with atrial fibrillation presents with sudden onset of severe right leg pain, pallor, coldness, and absent pulses. What is the immediate management algorithm?", a: "This is acute limb ischemia (the \"6 Ps\"). 1) Immediately administer an <b>intravenous heparin bolus followed by a continuous infusion</b> to prevent clot propagation. 2) Obtain urgent vascular surgery consultation for <b>emergent revascularization</b> (surgical embolectomy, catheter-directed thrombolysis, or bypass) within a 6-hour window to prevent irreversible tissue necrosis." },
            { q: "Under what clinical and anatomic circumstances is Coronary Artery Bypass Grafting (CABG) preferred over Percutaneous Coronary Intervention (PCI)?", a: "CABG is indicated and improves survival in patients with: 1) <b>Left main coronary artery stenosis $> 50\\%$</b>; 2) <b>Three-vessel coronary artery disease</b> (especially with depressed ejection fraction or diabetes); 3) <b>Two-vessel disease involving proximal Left Anterior Descending (LAD) artery</b> with depressed ejection fraction." },
            { q: "A 30-year-old pregnant female at 20 weeks gestation is diagnosed with a proximal DVT. What is the preferred anticoagulant therapy, and which agents are contraindicated?", a: "The drug of choice is <b>Low Molecular Weight Heparin (LMWH)</b> (e.g., enoxaparin) or unfractionated heparin, continued throughout pregnancy and for at least 6 weeks postpartum. **Contraindicated**: <b>Warfarin</b> is strictly contraindicated in pregnancy (highly teratogenic, causing fetal chondrodysplasia, nasal hypoplasia, and CNS hemorrhage). <b>DOACs</b> (apixaban, rivaroxaban) are not recommended due to cross-placental transfer." },
            { q: "What is the management algorithm for a primary spontaneous pneumothorax based on size and clinical stability?", a: "If **small ($< 2\\\\text{ cm}$ at the hilum) and clinically stable**: manage with <b>observation and supplemental oxygen</b> (oxygen accelerates pleural air absorption). If **large ($\\\\ge 2\\\\text{ cm}$) or clinically unstable**: perform <b>needle aspiration</b> or insert a <b>small-bore chest tube/catheter</b>. If recurrent or persistent air leak ($> 3\text{--}5$ days), perform video-assisted thoracoscopic surgery (VATS) with chemical pleurodesis." },
            { q: "What are the indications for performing a diagnostic thoracentesis in a patient with a pleural effusion, and what is the exception?", a: "Perform a diagnostic thoracentesis for any <b>new, unexplained pleural effusion</b> that is <b>$> 1\\\\text{ cm}$</b> in thickness on a lateral decubitus X-ray or ultrasound. **Exception**: Clinically apparent <b>congestive heart failure</b> with symmetric bilateral effusions; treat with diuretics first and perform thoracentesis only if the effusion is asymmetric, accompanied by fever/pleuritic chest pain, or fails to resolve after diuresis." },
            { q: "A 38-year-old obese female presents with episodes of sharp RUQ pain radiating to her right shoulder blade, lasting 2 hours after eating cheeseburgers. Ultrasound shows multiple gallstones without gallbladder wall thickening. What is the management plan?", a: "This is <b>biliary colic</b> (transient gallbladder obstruction). Management is conservative education (low-fat diet) and <b>elective outpatient laparoscopic cholecystectomy</b> to prevent future episodes of cholecystitis, choledocholithiasis, or gallstone pancreatitis." },
            { q: "Contrast the pharmacotherapy for non-severe, severe, and fulminant *Clostridioides difficile* infection (CDI), and state the indication for surgical intervention.", a: "<b>Non-severe/Severe</b>: treat with oral <b>vancomycin</b> ($125\\\\text{ mg}$ qid) or oral <b>fidaxomicin</b> ($200\\\\text{ mg}$ bid) for 10 days. <b>Fulminant</b> (hypotension, shock, ileus, or toxic megacolon): treat with <b>high-dose oral vancomycin ($500\\\\text{ mg}$ qid) + rectal vancomycin instillation + IV metronidazole</b>. Surgical intervention (<b>subtotal colectomy</b> or loop ileostomy) is indicated for toxic megacolon, bowel perforation, or clinical deterioration despite maximal medical therapy." },
            { q: "How does the management algorithm differ for Stanford Type A vs. Stanford Type B aortic dissection?", a: "<b>Stanford Type A</b> (involves ascending aorta): requires <b>emergent surgical repair</b> to prevent fatal complications (rupture, cardiac tamponade, acute aortic regurgitation, myocardial infarction). <b>Stanford Type B</b> (involves descending aorta only): managed <b>medically</b> first-line with <b>intravenous beta-blockers (esmolol, labetalol)</b> to target a heart rate $< 60$ bpm and systolic BP $100\text{--}120\\\\text{ mmHg}$ (reducing shear stress). Surgery (thoracic endovascular aortic repair - TEVAR) is indicated only if complicated by organ ischemia, rupture, or uncontrolled pain." },
            { q: "Outline the diagnostic pathway and treatment algorithm for suspected vertebral osteomyelitis.", a: "1) Obtain <b>blood cultures</b> and inflammatory markers (ESR/CRP). 2) Perform a <b>spine MRI</b> (most sensitive imaging). 3) If blood cultures are negative, perform a <b>CT-guided needle bone biopsy</b> to identify the pathogen prior to starting antibiotics. 4) Treat with <b>pathogen-directed IV antibiotics</b> for 6 weeks. <b>Surgical debridement</b> is indicated for neurological deficits (spinal cord compression), spinal instability, epidural abscess, or failure of medical therapy." },
            { q: "Contrast the management of a reducible inguinal hernia and a reducible femoral hernia.", a: "<b>Inguinal hernia</b>: can be monitored with watchful waiting if completely asymptomatic, or scheduled for elective surgical repair. <b>Femoral hernia</b>: requires <b>early elective surgical repair</b> even if asymptomatic, because the narrow femoral ring carries an extremely high risk of incarceration and strangulation ($30\text{--}40\\%$). (Any incarcerated/strangulated hernia requires <b>emergent surgical repair</b>)." }
          ]
        },
        {
          section: "Clinical Case Integration (Step 2 CK)",
          topic: "Interpretation of labs, imaging, biopsies in context",
          icon: "microscope",
          cards: [
            { q: "State Light's criteria for classifying pleural effusions, and explain how to interpret the results.", a: "An effusion is classified as <b>exudative</b> if it meets <b>at least one</b> of the following: 1) ratio of pleural fluid protein to serum protein <b>$> 0.5$</b>; 2) ratio of pleural fluid LDH to serum LDH <b>$> 0.6$</b>; 3) pleural fluid LDH <b>$> 2/3$ the upper limit of normal</b> for serum LDH. If none are met, it is <b>transudative</b>. Exudative effusions are caused by local inflammation/malignancy/infection; transudates are due to systemic hydrostatic/oncotic pressure imbalances (HF, cirrhosis, nephrotic syndrome)." },
            { q: "What are the diagnostic criteria for synovial fluid analysis in non-inflammatory, inflammatory, septic, and crystal-induced arthropathies?", a: "<b>Non-inflammatory</b> (osteoarthritis): WBC $< 2000/\\\\text{mcL}$, clear color, high viscosity. <b>Inflammatory</b> (RA, reactive arthritis): WBC $2000\\\\text{--}50,000/\\\\text{mcL}$ with $> 50\\%$ PMNs. <b>Septic</b>: WBC <b>$> 50,000/\\\\text{mcL}$</b> (often $> 100,000$) with <b>$> 75\\\\text{--}90\\%$ PMNs</b>, purulent. <b>Gout</b>: <b>needle-shaped, negatively birefringent</b> crystals (yellow when parallel to slow-wave light). <b>Pseudogout (CPPD)</b>: <b>rhomboid-shaped, weakly positively birefringent</b> crystals (blue when parallel)." },
            { q: "Write the formula for the Serum-Ascites Albumin Gradient (SAAG), and state which conditions are associated with a high vs. low gradient.", a: "$\\\\text{SAAG} = \\\\text{Serum Albumin} - \\\\text{Ascitic Fluid Albumin}$. <b>High gradient ($\\\\text{SAAG} \\\\ge 1.1\\\\text{ g/dL}$)</b>: indicates portal hypertension; causes include <b>cirrhosis</b>, <b>congestive heart failure</b> (constrictive pericarditis), and <b>Budd-Chiari syndrome</b>. <b>Low gradient ($\\\\text{SAAG} < 1.1\\\\text{ g/dL}$)</b>: indicates non-portal hypertension; causes include <b>peritoneal carcinomatosis</b>, <b>tuberculosis</b>, <b>nephrotic syndrome</b>, and <b>pancreatic ascites</b>." },
            { q: "State the formula for the Fractional Excretion of Sodium (FENa) and explain how to interpret FENa values. Under what clinical circumstance is FENa unreliable, and what alternative test is used?", a: "$\\\\text{FENa} = \\\\frac{\\\\text{U}_{\\\\text{Na}} \\\\times \\\\text{P}_{\\\\text{Cr}}}{\\\\text{P}_{\\\\text{Na}} \\\\times \\\\text{U}_{\\\\text{Cr}}} \\\\times 100\\%$. <b>$\\\\text{FENa} < 1\\%$</b>: indicates <b>prerenal etiology</b> (volume depletion, hypoperfusion, where kidneys conserve sodium). <b>$\\\\text{FENa} > 2\\%$</b>: indicates <b>intrinsic renal etiology</b> (Acute Tubular Necrosis, where damaged tubules lose sodium reabsorption capacity). FENa is <b>unreliable in patients taking diuretics</b> (which artificially increase urine sodium); use <b>Fractional Excretion of Urea (FEUrea)</b> instead (<b>$< 35\\%$</b> indicates prerenal)." },
            { q: "Contrast the opening pressure, leukocyte count/predominance, protein, and glucose levels in CSF for bacterial, viral, and fungal/TB meningitis.", a: "<b>Bacterial</b>: high opening pressure ($> 250\\\\text{ mm H}_2\\\\text{O}$); WBC <b>$> 1,000/\\\\text{mcL}$ with PMN (neutrophil) predominance</b>; high protein ($> 250\\\\text{ mg/dL}$); <b>low glucose ($< 40\\\\text{ mg/dL}$</b> or ratio $< 0.4$). <b>Viral</b>: normal/mildly high opening pressure; WBC $10\\\\text{--}500/\\\\text{mcL}$ with <b>lymphocyte predominance</b>; normal/mildly high protein; <b>normal glucose</b>. <b>Fungal/TB</b>: high opening pressure; WBC $10\\\\text{--}500/\\\\text{mcL}$ with <b>lymphocyte predominance</b>; high protein ($> 100\\\\text{ mg/dL}$); <b>low glucose</b>." },
            { q: "Write the formula for the Alveolar-arterial (A-a) oxygen gradient, and explain how it helps differentiate causes of hypoxemia.", a: "$\\\\text{A-a Gradient} = \\\\text{PAO}_2 - \\\\text{PaO}_2$, where $\\\\text{PAO}_2 = \\\\text{FiO}_2(\\\\text{P}_{\\\\text{atm}} - \\\\text{P}_{\\\\text{H}_2\\\\text{O}}) - \\\\frac{\\\\text{PaCO}_2}{\\\\text{R}}$. (On room air at sea level: $\\\\text{PAO}_2 \\\\approx 150 - 1.25 \\\\times \\\\text{PaCO}_2$). <b>Normal A-a gradient hypoxemia</b> is caused by <b>alveolar hypoventilation</b> (CNS depression, muscle weakness) or <b>high altitude</b>. <b>Elevated A-a gradient hypoxemia</b> is caused by <b>V/Q mismatch</b> (PE, pneumonia, COPD), <b>shunt</b> (intracardiac or pulmonary AVM), or <b>diffusion impairment</b> (ILD)." },
            { q: "State Winter's formula and explain how to apply it to diagnose mixed acid-base disorders.", a: "$\\\\text{Expected }\\\\text{PaCO}_2 = 1.5 \\\\times [\\\\text{HCO}_3^-] + 8 \\\\pm 2$. Used in <b>primary metabolic acidosis</b> to assess for respiratory compensation. If <b>actual }\\\\text{PaCO}_2 > \\\\text{expected</b>: concurrent <b>respiratory acidosis</b> (hypoventilation/respiratory failure). If <b>actual }\\\\text{PaCO}_2 < \\\\text{expected</b>: concurrent <b>respiratory alkalosis</b> (hyperventilation)." },
            { q: "Write the formula for the Delta-Delta ($\\\\Delta/\\\\Delta$) ratio and explain how it is used to identify mixed metabolic disorders in patients with anion gap metabolic acidosis.", a: "$\\\\frac{\\\\Delta\\\\text{AG}}{\\\\Delta\\\\text{HCO}_3^-} = \\\\frac{\\\\text{AG} - 12}{24 - \\\\text{HCO}_3^-}$. <b>Ratio $< 1$</b>: indicates a concurrent <b>non-anion gap metabolic acidosis (NAGMA)</b> (the $\\\\text{HCO}_3^-$ drop is greater than the $\\\\text{AG}$ increase). <b>Ratio 1–2</b>: indicates a <b>pure anion gap metabolic acidosis</b>. <b>Ratio $> 2$</b>: indicates a concurrent <b>metabolic alkalosis</b> (the $\\\\text{HCO}_3^-$ is higher than expected because of a pre-existing alkalosis)." },
            { q: "Write the formula for the Urine Anion Gap (UAG) and explain how it differentiates renal vs. extra-renal causes of a normal anion gap metabolic acidosis (NAGMA).", a: "$\\\\text{UAG} = (\\\\text{U}_{\\\\text{Na}} + \\\\text{U}_{\\\\text{K}}) - \\\\text{U}_{\\\\text{Cl}}$. <b>Negative UAG ($< 0$)</b>: indicates <b>GI bicarbonate loss</b> (e.g., diarrhea); the kidneys are functioning normally and increasing acid excretion in the form of ammonium ($\\\\text{NH}_4^+$), which is excreted with chloride ($\\\\text{Cl}^-$), raising urine chloride. <b>Positive UAG ($> 0$)</b>: indicates <b>Renal Tubular Acidosis (RTA)</b>; the kidneys are unable to excrete acid/ammonium, resulting in low urine chloride." },
            { q: "What are the characteristic ECG changes associated with hyperkalemia, hypokalemia, hypercalcemia, and hypocalcemia?", a: "<b>Hyperkalemia</b>: peaked symmetric T waves, PR prolongation, flat P waves, QRS widening, sine wave. <b>Hypokalemia</b>: flat T waves, <b>prominent U waves</b> (following T wave), ST segment depression, prolonged QT/QU. <b>Hypercalcemia</b>: <b>shortened QT interval</b>. <b>Hypocalcemia</b>: <b>prolonged QT interval</b> (torsades risk)." },
            { q: "Identify the classic sequential chest X-ray findings in a patient with progressive congestive heart failure.", a: "1) <b>Cephalization</b> of pulmonary vasculature (pulmonary venous pressure $10\text{--}15\\\\text{ mmHg}$). 2) <b>Kerley B lines</b> (horizontal lines at lung bases representing interstitial edema; pressure $15\text{--}20\\\\text{ mmHg}$). 3) <b>Alveolar edema</b> (\"batwing\" or \"butterfly\" perihilar infiltrates; pressure $> 25\\\\text{ mmHg}$). 4) Cardiomegaly and pleural effusions (blunting of costophrenic angles)." },
            { q: "What are the characteristic non-contrast head CT findings for an acute ischemic stroke, an epidural hematoma, a subdural hematoma, and a subarachnoid hemorrhage?", a: "<b>Acute Ischemic Stroke</b>: may be normal in first 6–12 hours, followed by <b>dark hypodensity</b> in a vascular territory. <b>Epidural Hematoma</b>: hyperdense, <b>biconvex (lens-shaped) extra-axial collection</b> that does not cross suture lines. <b>Subdural Hematoma</b>: hyperdense, <b>crescent-shaped collection</b> that crosses suture lines. <b>Subarachnoid Hemorrhage</b>: <b>hyperdensity filling the sulci</b> and basal cisterns (\"star of death\")." },
            { q: "What are the diagnostic X-ray findings for a small bowel obstruction, sigmoid volvulus, and cecal volvulus?", a: "<b>Small Bowel Obstruction</b>: central dilated loops of small bowel ($> 3\\\\text{ cm}$), <b>air-fluid levels</b> on upright view, and absence of distal colonic/rectal gas. <b>Sigmoid Volvulus</b>: a massive, smooth, dilated loop of colon arising from the pelvis, showing the <b>\"coffee bean\" sign</b> pointing to the RUQ. <b>Cecal Volvulus</b>: a dilated comma-shaped loop of colon in the LUQ arising from the RLQ." },
            { q: "Match the following chronic liver diseases with their classic biopsy findings: Chronic Hepatitis B, Chronic Hepatitis C, Alcoholic Hepatitis, and Primary Biliary Cholangitis.", a: "<b>Hepatitis B</b>: <b>ground-glass hepatocytes</b> (cytoplasm filled with HBsAg). <b>Hepatitis C</b>: portal tract lymphoid aggregates and lobular microvesicular steatosis. <b>Alcoholic Hepatitis</b>: swollen hepatocytes containing eosinophilic <b>Mallory-Denk bodies</b> surrounded by neutrophils. <b>Primary Biliary Cholangitis</b>: portal tract granulomatous destruction of interlobular bile ducts (\"florid duct lesion\")." },
            { q: "Identify the characteristic light microscopy, immunofluorescence, and electron microscopy findings for Minimal Change Disease, Membranous Nephropathy, and Post-streptococcal Glomerulonephritis.", a: "<b>Minimal Change Disease</b>: normal light microscopy; negative IF; <b>effacement of podocyte foot processes</b> on EM. <b>Membranous Nephropathy</b>: thickened capillary wall with <b>\"spikes\" on silver stain</b>; granular IgG/C3 deposits on IF; <b>subepithelial deposits</b> on EM. <b>Post-streptococcal Glomerulonephritis</b>: hypercellular glomeruli with PMNs; granular \"lumpy-bumpy\" IgG/C3 on IF; <b>subepithelial \"humps\"</b> on EM." },
            { q: "Contrast the serum iron, total iron binding capacity (TIBC), ferritin, and transferrin saturation in Iron Deficiency Anemia, Anemia of Chronic Disease, and Hereditary Hemochromatosis.", a: "<b>Iron Deficiency Anemia</b>: low iron, <b>high TIBC</b>, <b>low ferritin</b> ($< 30\\\\text{ ng/mL}$), low transferrin saturation ($< 20\\%$). <b>Anemia of Chronic Disease</b>: low/normal iron, <b>low/normal TIBC</b>, <b>normal/high ferritin</b> (acute phase reactant), low/normal transferrin saturation. <b>Hemochromatosis</b>: high iron, low TIBC, <b>very high ferritin</b>, <b>high transferrin saturation ($> 45\text{--}50\\%$)</b>." },
            { q: "Differentiate the TSH and free T4 patterns in Primary Hypothyroidism, Subclinical Hypothyroidism, Primary Hyperthyroidism, and Central (Secondary) Hypothyroidism.", a: "<b>Primary Hypothyroidism</b>: <b>high TSH, low free T4</b>. <b>Subclinical Hypothyroidism</b>: <b>high TSH, normal free T4</b>. <b>Primary Hyperthyroidism</b>: <b>low TSH, high free T4</b>. <b>Central Hypothyroidism</b> (pituitary/hypothalamic failure): <b>low or normal TSH, low free T4</b>." },
            { q: "What is the classic cerebrospinal fluid (CSF) finding in a patient with Guillain-Barré Syndrome, and what is the term for this phenomenon?", a: "<b>Albuminocytologic dissociation</b> — characterized by <b>markedly elevated protein</b> levels ($100\text{--}1000\\\\text{ mg/dL}$) with a <b>completely normal white blood cell count</b> ($< 5\\\\text{ WBC/mcL}$)." },
            { q: "How do you interpret the following liver function test patterns: AST/ALT ratio > 2:1, AST and ALT > 1000 U/L, and elevated Alkaline Phosphatase with elevated GGT?", a: "<b>AST/ALT ratio $> 2:1$</b>: highly suggestive of <b>alcoholic liver disease</b> (alcohol suppresses hepatic Pyridoxal-5-phosphate/Vitamin B6, which is required for ALT synthesis). <b>AST & ALT $> 1000\\\\text{ U/L}$</b>: indicates <b>acute hepatocyte necrosis</b>; top causes are <b>acute viral hepatitis</b>, <b>ischemic hepatitis (\"shock liver\")</b>, or <b>acetaminophen/toxic injury</b>. <b>Elevated ALP + elevated GGT (Gamma-glutamyltransferase)</b>: confirms the elevated ALP is of <b>biliary origin</b> (cholestasis/obstruction) rather than bone origin." },
            { q: "Identify the clinical associations of the following erythrocyte abnormalities on a peripheral smear: Target cells, Schistocytes, Heinz bodies, and Howell-Jolly bodies.", a: "<b>Target cells</b>: thalassemias, sickle cell disease, liver disease, or splenectomy. <b>Schistocytes</b> (helmet cells): microangiopathic hemolytic anemia (<b>TTP, HUS, DIC</b>). <b>Heinz bodies</b>: <b>G6PD deficiency</b> (precipitated, denatured hemoglobin; visualized with crystal violet). <b>Howell-Jolly bodies</b>: functional hyposplenism or <b>splenectomy</b> (nuclear chromatin remnants normally removed by spleen)." },
            { q: "A 28-year-old female with SLE has new-onset hematuria and proteinuria. Renal biopsy shows diffuse proliferative glomerulonephritis (Class IV). What are the characteristic light microscopy and electron microscopy findings?", a: "Light microscopy shows hypercellular glomeruli with <b>\"wire loop\" capillary lesions</b> (thickening of basement membrane due to immune deposition). EM shows <b>subendothelial immune complex deposits</b>. (Requires aggressive treatment with corticosteroids + mycophenolate mofetil or cyclophosphamide)." },
            { q: "What are the three classic histopathological findings on a duodenal biopsy in a patient with Celiac disease?", a: "1) <b>Intraepithelial lymphocytosis</b> (increased lymphocytes in the mucosa). 2) <b>Crypt hyperplasia</b> (deepening of the crypts of Lieberkühn). 3) <b>Blunting and atrophy of the villi</b> (reducing surface area for absorption)." },
            { q: "A 52-year-old male with a 30 pack-year smoking history presents with painless, gross hematuria. Urinalysis shows $> 20$ RBCs/hpf. What is the next diagnostic workup, and why?", a: "The next step is a <b>cystoscopy</b> to directly visualize the bladder mucosa and a <b>CT urogram</b> to evaluate the kidneys and ureters. Painless gross hematuria in a patient $> 35$ with smoking history is <b>bladder cancer (urothelial carcinoma)</b> until proven otherwise." },
            { q: "A patient with chronic kidney disease presents with severe bone pain. Hand radiographs show subperiosteal bone resorption of the phalanges, and blood work shows elevated calcium, elevated PTH, and low phosphate. What is the bone disease and the biopsy appearance?", a: "<b>Osteitis fibrosa cystica</b> (caused by hyperparathyroidism). Biopsy shows bone resorption with fibrous tissue replacement and cystic spaces filled with blood and osteoclasts, known as <b>\"brown tumors\"</b>." },
            { q: "What is the clinical utility and limitation of B-type Natriuretic Peptide (BNP) in the evaluation of dyspnea, and how is it affected by obesity?", a: "BNP has high sensitivity; a value <b>$< 100\\\\text{ pg/mL}$</b> has a high negative predictive value to rule out acute decompensated heart failure. Limitations: BNP can be falsely elevated in <b>renal failure</b> (decreased clearance) and advanced age. Importantly, <b>obesity is associated with falsely lower BNP levels</b> due to increased clearance receptors on adipocytes." },
            { q: "Differentiate the histopathological biopsy findings of Crohn's disease and Ulcerative Colitis.", a: "<b>Crohn's disease</b>: <b>transmural inflammation</b> (involving all layers of the bowel wall), non-caseating granulomas, lymphoid aggregates, and fissuring ulcers. <b>Ulcerative Colitis</b>: inflammation <b>limited to the mucosa and submucosa</b>, prominent <b>crypt abscesses</b> (neutrophilic infiltration of crypts), mucosal congestion, and no granulomas." },
            { q: "A 64-year-old male is found to have a nodule on digital rectal exam (DRE) and a serum PSA of 7.2 ng/mL. What is the next step to establish the diagnosis?", a: "Perform a <b>transrectal (or transperineal) ultrasound-guided (TRUS) needle biopsy</b> of the prostate. A DRE nodule or elevated PSA requires tissue biopsy to confirm prostate cancer and determine the <b>Gleason score</b> for grading." },
            { q: "What are the current USPSTF screening guidelines for lung cancer, and what test is used?", a: "Annual screening with a <b>low-dose chest CT</b> in adults aged <b>50 to 80</b> who have a <b>$\\\\ge 20$ pack-year smoking history</b> AND currently smoke or have quit within the past 15 years. Discontinue screening once the person has not smoked for 15 years or develops a limiting life expectancy." },
            { q: "What is the initial screening test for primary aldosteronism (Conn's syndrome) in a hypertensive patient with hypokalemia, and what ratio is diagnostic?", a: "Measure morning <b>plasma aldosterone concentration (PAC)</b> and <b>plasma renin activity (PRA)</b>. A <b>$\\\\text{PAC}/\\\\text{PRA}$ ratio $> 20$</b> with an absolute PAC <b>$> 15\\\\text{ ng/dL}$</b> is a positive screen, indicating renin-independent aldosterone hypersecretion. Confirm with a saline infusion test." },
            { q: "Why can measuring G6PD enzyme activity during or immediately after an acute hemolytic episode yield a false-negative result, and what is the proper protocol?", a: "During an acute hemolytic flare, the older erythrocytes (which have the lowest G6PD enzyme levels and are most susceptible to hemolysis) are destroyed first. The remaining circulating cells are young red cells and reticulocytes, which have normal or elevated G6PD levels. The proper protocol is to <b>delay testing and measure G6PD activity 2–3 months after the acute episode</b> has completely resolved." }
          ]
        }],
      'usmle1': [],
      'usmle2': [],
      'usmle3': []
    };

    let currentTab = 'year1';
    let currentTopicIndex = 0;
    let currentCardIndex = 0;

    const selectionView = document.getElementById('selection-view');
    const studyView = document.getElementById('study-view');
    const topicGrid = document.getElementById('topic-grid');
    const emptyState = document.getElementById('empty-state');
    
    const cardElement = document.getElementById('card-element');
    const frontText = document.getElementById('front-text');
    const backText = document.getElementById('back-text');
    const cardCounter = document.getElementById('card-counter');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const activeTopicName = document.getElementById('active-topic-name');

    function flashTopicSlug(topicName) {
      const base = String(topicName || 'Topic')
        .replace(/[^a-zA-Z0-9\s]/g, '')
        .replace(/\s+(\w)/g, (_, c) => c.toUpperCase())
        .replace(/\s+/g, '');
      const titled = base.charAt(0).toUpperCase() + base.slice(1);
      return titled + 'FlashCards';
    }

    function findFlashTopic(slug) {
      if (!slug) return null;
      const decoded = decodeURIComponent(slug);
      for (const tab of Object.keys(FLASH_DATA)) {
        const topics = FLASH_DATA[tab] || [];
        const idx = topics.findIndex(t => flashTopicSlug(t.topic) === decoded);
        if (idx >= 0) return { tab, index: idx };
      }
      return null;
    }

    function syncFlashTabUI(tab) {
      const mainTabs = document.getElementById('main-tabs');
      const mobileDropdown = document.getElementById('mobile-tab-dropdown');
      if (mainTabs) {
        mainTabs.querySelectorAll('.tab-item').forEach(t => {
          t.classList.toggle('active', t.dataset.tab === tab);
        });
      }
      if (mobileDropdown) mobileDropdown.value = tab;
    }

    function updateFlashUrl(index, replace = false) {
      const topic = FLASH_DATA[currentTab]?.[index];
      if (!topic) return;
      const slug = flashTopicSlug(topic.topic);
      const url = `/flash-cards/${encodeURIComponent(slug)}`;
      const state = { tab: currentTab, index };
      if (replace) history.replaceState(state, '', url);
      else history.pushState(state, '', url);
      document.title = `${topic.topic} Flashcards | MediHelp`;
    }

    function init() {
      const mainTabs = document.getElementById('main-tabs');
      const mobileDropdown = document.getElementById('mobile-tab-dropdown');

      // Desktop Tab Listeners
      if (mainTabs) {
        mainTabs.querySelectorAll('.tab-item').forEach(tab => {
          tab.onclick = () => {
            mainTabs.querySelectorAll('.tab-item').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            currentTab = tab.dataset.tab;
            if (mobileDropdown) mobileDropdown.value = currentTab;
            renderTopics();
          };
        });
      }

      // Mobile Dropdown Listener
      if (mobileDropdown) {
        mobileDropdown.onchange = (e) => {
          currentTab = e.target.value;
          // Sync desktop tabs
          if (mainTabs) {
            mainTabs.querySelectorAll('.tab-item').forEach(t => {
              t.classList.toggle('active', t.dataset.tab === currentTab);
            });
          }
          renderTopics();
        };
      }

      // Card Flip
      cardElement.onclick = () => {
        cardElement.classList.toggle('is-flipped');
      };

      // Nav Buttons
      prevBtn.onclick = (e) => {
        e.stopPropagation();
        if (currentCardIndex > 0) {
          currentCardIndex--;
          updateCard();
        }
      };

      nextBtn.onclick = (e) => {
        e.stopPropagation();
        const cards = FLASH_DATA[currentTab][currentTopicIndex].cards;
        if (currentCardIndex < cards.length - 1) {
          currentCardIndex++;
          updateCard();
        }
      };

      renderTopics();
      lucide.createIcons();

      const flashFaqs = [
        { q: 'How do medical flashcards help in active recall?', a: 'Active recall involves actively testing your memory instead of passively reviewing notes. When you look at the question side of a medical card and force your brain to retrieve the concept, you strengthen neural pathways, enhancing long-term memory retention for exams like MBBS, USMLE, and NBME.' },
        { q: 'Are these decks aligned with the USMLE syllabus?', a: 'Yes. The decks are divided by study years and exam targets (USMLE Step 1, Step 2 CK, and Step 3). They cover high-yield subjects such as Gross Anatomy, Histology, Embryology, Physiology, Pathology, Microbiology, Pharmacology, and clinical specialties like Cardiology, Pediatrics, Surgery, and OB/GYN.' },
        { q: 'Can I study these flashcards on mobile devices?', a: 'Absolutely. Our flashcard interface is fully responsive. You can study anatomy, physiology, and pathology decks on the go using your smartphone or tablet, although we recommend desktop usage for complete exam-simulator sessions.' },
        { q: 'Is there a cost to access these decks?', a: 'The first topic in each deck is a free demo. Full curriculum access requires a MediHelp Medical Exam Mastery license — the same license unlocks MCQs, case studies, and all flashcard decks.' }
      ];
      if (window.renderFAQ) renderFAQ('faq-flashcards', flashFaqs);

      const pathParts = window.location.pathname.split('/').filter(Boolean);
      if (pathParts[0] === 'flash-cards' && pathParts[1]) {
        const match = findFlashTopic(pathParts[1]);
        if (match) {
          currentTab = match.tab;
          syncFlashTabUI(currentTab);
          renderTopics();
          startStudyMode(match.index, match.index === 0, 'replace');
        }
      }

      window.addEventListener('popstate', () => {
        const parts = window.location.pathname.split('/').filter(Boolean);
        if (parts[0] === 'flash-cards' && parts[1]) {
          const match = findFlashTopic(parts[1]);
          if (match) {
            currentTab = match.tab;
            syncFlashTabUI(currentTab);
            startStudyMode(match.index, match.index === 0, 'none');
          }
        } else {
          exitStudyMode();
        }
      });
    }

    function renderTopics() {
      try {
        const topics = FLASH_DATA[currentTab];
        topicGrid.innerHTML = '';
        
        if (topics && topics.length > 0) {
          emptyState.classList.add('hidden');
          topicGrid.classList.remove('hidden');
          
          const sectionsMap = {};
          topics.forEach(t => {
            const s = t.section || 'General';
            if (!sectionsMap[s]) sectionsMap[s] = [];
            sectionsMap[s].push(t);
          });

          for (const [sectionName, secTopics] of Object.entries(sectionsMap)) {
            if (sectionName !== 'General' || Object.keys(sectionsMap).length > 1) {
              const header = document.createElement('div');
              header.className = 'section-header';
              header.style.gridColumn = '1 / -1';
              header.textContent = sectionName;
              topicGrid.appendChild(header);
            }
            
            secTopics.forEach((t) => {
              const idx = topics.indexOf(t);
              const isFreeDemo = (idx === 0);
              const slug = flashTopicSlug(t.topic || 'Untitled Topic');
              const card = document.createElement('a');
              card.className = 'topic-card-item';
              card.href = `/flash-cards/${encodeURIComponent(slug)}`;
              card.innerHTML = `
                ${isFreeDemo ? '<div style="position:absolute; top:12px; right:12px; background:var(--accent); color:white; font-size:10px; font-weight:800; padding:3px 10px; border-radius:6px; text-transform:uppercase; letter-spacing:1px; z-index:1; box-shadow:0 4px 12px rgba(var(--accent-rgb),0.3);">Free Demo</div>' : ''}
                <div class="topic-card-icon">
                  <i data-lucide="${t.icon || 'book'}"></i>
                </div>
                <div class="topic-card-title">${t.topic || 'Untitled Topic'}</div>
                <div class="topic-card-count">${(t.cards || []).length} Cards</div>
              `;
              card.onclick = (e) => {
                e.preventDefault();
                startStudyMode(idx, isFreeDemo);
              };
              topicGrid.appendChild(card);
            });
          }
          
          // Initialize Lucide icons with error catching
          if (window.lucide) {
            lucide.createIcons();
          }
        } else {
          topicGrid.classList.add('hidden');
          emptyState.classList.remove('hidden');
        }
      } catch (err) {
        console.error("MediHelp FlashCards Error:", err);
        topicGrid.classList.add('hidden');
        emptyState.classList.remove('hidden');
      }
    }

    async function isPremium() {
      return await MediHelp.isPremium();
    }

    function openPremiumModal() {
      const modal = document.getElementById('premium-modal');
      if (modal) modal.classList.add('visible');
    }

    function closePremiumModal() {
      const modal = document.getElementById('premium-modal');
      if (modal) modal.classList.remove('visible');
    }

    async function verifyLicense() {
      const key = document.getElementById('license-key').value.trim();
      const email = document.getElementById('license-email').value.trim();
      
      if (!key || !email) {
        alert("Please enter both license key and email.");
        return;
      }
      
      const btn = document.querySelector('.license-entry .btn-secondary');
      if (btn) {
        btn.textContent = "Verifying...";
        btn.disabled = true;
      }

      try {
        const success = await MediHelp.License.verify(key, email);
        if (success) {
          location.reload();
        } else {
          throw new Error("Verification failed");
        }
      } catch (e) {
        console.error("License Verification Error:", e);
        let msg = "Invalid license key or email. Please check and try again.";
        if (e.message === "LICENSE_LIMIT_REACHED") msg = "License limit reached (5 devices max).";
        if (e.message === "TIMEOUT") msg = "Verification timed out. The server can take up to 90s. If a row was saved in Supabase, refresh the page in a few seconds.";
        
        alert(msg);
        if (btn) {
          btn.textContent = "Activate Access";
          btn.disabled = false;
        }
      }
    }

    async function startStudyMode(index, isFreeDemo = false, urlMode = 'push') {
      if (!isFreeDemo) {
        const premium = await isPremium();
        if (!premium) {
          const { data: { user } } = await window.dbClient.auth.getUser();
          if (!user) {
            MediHelp.showAuthModal();
          } else {
            openPremiumModal();
          }
          return;
        }
      }
      currentTopicIndex = index;
      currentCardIndex = 0;
      activeTopicName.textContent = FLASH_DATA[currentTab][index].topic;
      
      selectionView.classList.add('hidden');
      studyView.classList.remove('hidden');
      if (urlMode === 'push') updateFlashUrl(index, false);
      else if (urlMode === 'replace') updateFlashUrl(index, true);
      updateCard();
    }

    function exitStudyMode() {
      studyView.classList.add('hidden');
      selectionView.classList.remove('hidden');
      history.pushState({}, '', '/flash-cards');
      document.title = 'Free Medical Flashcards for MBBS, USMLE & NBME Success | MediHelp';
    }

    function cleanLaTeX(text) {
      if (!text) return '';
      // Replace any run of backslashes (like \ or \\) with a single backslash for LaTeX
      return text.replace(/\\+/g, '\\');
    }

    function adjustFontSize(element, text) {
      if (!text) return;
      element.classList.remove('size-xs', 'size-sm', 'size-md', 'size-lg');
      const cleanText = text.replace(/<[^>]*>/g, ''); // strip HTML tags for character count
      const len = cleanText.length;
      const hasTable = text.includes('<table') || text.includes('</table>');
      
      if (hasTable) {
        element.classList.add('size-xs');
      } else if (len > 400) {
        element.classList.add('size-sm');
      } else if (len > 180) {
        element.classList.add('size-md');
      } else {
        element.classList.add('size-lg');
      }
    }

    function adjustCardHeight() {
      const scene = document.querySelector('.flash-card-scene');
      if (!scene) return;
      
      const frontText = document.getElementById('front-text');
      const backText = document.getElementById('back-text');
      if (!frontText || !backText) return;
      
      // Vertical padding (32px top + 24px bottom) + label/margin (38px) + safety breathing room (16px) = 110px
      const verticalPadding = 110; 
      
      const frontHeight = frontText.scrollHeight + verticalPadding;
      const backHeight = backText.scrollHeight + verticalPadding;
      
      const minHeight = window.innerWidth <= 600 ? 300 : 360;
      const maxHeight = Math.max(frontHeight, backHeight, minHeight);
      
      scene.style.height = `${maxHeight}px`;
    }

    function updateCard() {
      const topics = FLASH_DATA[currentTab];
      if (!topics || !topics[currentTopicIndex]) return;

      const cards = topics[currentTopicIndex].cards;
      const card = cards[currentCardIndex];

      cardElement.classList.remove('is-flipped');
      
      setTimeout(() => {
        const qContent = cleanLaTeX(card.q);
        const aContent = cleanLaTeX(card.a);
        
        frontText.innerHTML = qContent;
        backText.innerHTML = aContent;
        
        adjustFontSize(frontText, qContent);
        adjustFontSize(backText, aContent);
        
        cardCounter.textContent = `${currentCardIndex + 1} / ${cards.length}`;
        
        prevBtn.disabled = currentCardIndex === 0;
        nextBtn.disabled = currentCardIndex === cards.length - 1;

        // Trigger MathJax dynamic rendering
        if (window.MathJax && typeof MathJax.typesetPromise === 'function') {
          // Clear previous typeset state so MathJax can re-process these elements
          if (typeof MathJax.typesetClear === 'function') {
            MathJax.typesetClear([frontText, backText]);
          }
          MathJax.typesetPromise([frontText, backText]).then(() => {
            adjustCardHeight();
          }).catch((err) => {
            console.error("MathJax typesetting error:", err);
            adjustCardHeight();
          });
        } else {
          adjustCardHeight();
        }
      }, 50);
    }

    init();
  </script>
</body>
