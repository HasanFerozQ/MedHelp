                            {
                                      "q": "Enzyme deficiency causing episodic hemolysis after oxidative stress?",
                                      "a": "Glucose-6-Phosphate Dehydrogenase (G6PD) deficiency."
                            },
                            {
                                      "q": "Key smear findings in <b>G6PD deficiency</b>?",
                                      "a": "<b>Heinz bodies</b> (denatured Hb) and <b>Bite cells</b>."
                            },
                            {
                                      "q": "Differentiation between Warm and Cold <b>Autoimmune Hemolytic Anemia</b>?",
                                      "a": "Warm is IgG-mediated (extravascular); Cold is IgM-mediated (complement-mediated).\n\nWhite Blood Cell Disorders: Leukemias & Lymphomas"
                            },
                            {
                                      "q": "Characterization of Acute Leukemia in the bone marrow?",
                                      "a": ">20% blasts in the marrow."
                            },
                            {
                                      "q": "Pathognomonic biopsy finding for <b>Acute Myeloid Leukemia</b> (<b>AML</b>)?",
                                      "a": "<b>Auer Rods</b> (peroxidase-positive cytoplasmic inclusions)."
                            },
                            {
                                      "q": "Cytogenetic translocation associated with <b>Acute Promyelocytic Leukemia</b> (<b>APL</b>)?",
