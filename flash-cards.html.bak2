            { q: "Liver tumor associated with Oral Contraceptive Use?", a: "Hepatic Adenoma." },
            { q: "Treatment for Hepatic Adenoma >5cm?", a: "Surgical resection (due to rupture/malignancy risk)." },
            { q: "Hallmark of Zollinger-Ellison Syndrome?", a: "Gastrinoma leading to multiple, refractory peptic ulcers." },
            { q: "Screening test for Zollinger-Ellison Syndrome?", a: "Serum gastrin levels (>1000 pg/mL)." },
            { q: "Confirmatory test for Zollinger-Ellison Syndrome?", a: "Secretin stimulation test (gastrin levels remain high)." },
            { q: "Major site for Gastrinomas?", a: "Pancreas or Duodenum (Gastrinoma Triangle)." },
            { q: "Primary management of Boerhaave Syndrome?", a: "Emergent surgical repair." },
            { q: "Classic presentation of Ischemic Colitis?", a: "Pain followed by bloody diarrhea in the \"watershed\" areas (splenic flexure)." },
            { q: "Finding on CT for Ischemic Colitis?", a: "\"Thumbprinting\" (mucosal edema)." },
            { q: "Screening for patients with FAP (Familial Adenomatous Polyposis)?", a: "Annual sigmoidoscopy starting at age 10-12." },
            { q: "Diagnostic finding for Whipple's Disease?", a: "PAS-positive macrophages in the lamina propria." },
            { q: "Treatment for Whipple's Disease?", a: "Ceftriaxone followed by TMP-SMX for one year." },
            { q: "Definition of Barrett's Esophagus?", a: "Intestinal metaplasia (Squamous to Columnar epithelium)." },
