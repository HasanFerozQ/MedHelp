            { q: "Gold standard diagnosis for SIBO?", a: "Jejunal aspirate culture (though breath tests are common)." },
            { q: "Treatment for SIBO?", a: "Rifaximin." },
            { q: "Mechanism of Lactulose in Cirrhosis?", a: "Converted to lactic acid, acidifying the gut and converting NH3 to NH4+." },
            { q: "Most common cause of Budd-Chiari in young women?", a: "Oral contraceptive use or underlying hypercoagulability." },
            { q: "Major risk of Primary Sclerosing Cholangitis?", a: "Cholangiocarcinoma." },
            { q: "\"Onion skin\" fibrosis of bile ducts is seen in?", a: "Primary Sclerosing Cholangitis." },
