            },
            {
              "q": "Vitamin C deficiency symptoms (Scurvy)?",
              "a": "Bone pain, hemorrhages, and \"corkscrew\" hair due to impaired collagen synthesis (hydroxylation)."
            },
            {
              "q": "Vitamin D deficiency in children vs. adults?",
              "a": "<b>Children:</b> Rickets; Adults: Osteomalacia."
            },
            {
              "q": "Characteristics of \"Labile\" tissues?",
              "a": "Continuously dividing (e.g., surface epithelia, hematopoietic cells)."
            },
            {
              "q": "Characteristics of \"Stable\" tissues?",
              "a": "Quiescent (G<sub>0</sub> phase) but can divide in response to injury (e.g., Liver, Kidney)."
            },
            {
              "q": "Characteristics of \"Permanent\" tissues?",
              "a": "Terminally differentiated; non-proliferative (e.g., Neurons, Cardiac myocytes)."
            },
            {
              "q": "Definition of Hypercalcemia of Malignancy?",
              "a": "Result of PTHrP secretion or osteolytic bone metastases."
            },
            {
              "q": "What is \"<b>Atrophy</b>\"?",
              "a": "Shrinkage in the size of the cell by loss of cell substance."
            },
            {
              "q": "Role of Ubiquitin-Proteasome pathway in <b>atrophy</b>?",
              "a": "Degrades nuclear and cytosolic proteins when cells are under-stimulated or malnourished."
            },
            {
              "q": "Mechanism of Steatosis (Fatty Change)?",
              "a": "Abnormal accumulation of triglycerides within parenchymal cells (most common in liver)."
            },
            {
              "q": "Definition of Hemosiderosis?",
              "a": "Systemic overload of iron without associated tissue damage."
            },
            {
              "q": "Definition of Hemochromatosis?",
              "a": "Genetic or acquired iron overload resulting in tissue damage (liver, heart, pancreas)."
            },
            {
              "q": "Function of Telomerase in cancer?",
              "a": "Maintains telomere length, providing \"immortality\" to cancer cells by avoiding replicative senescence."
            },
            {
              "q": "Most common paraneoplastic syndrome?",
              "a": "Hypercalcemia."
            },
            {
              "q": "Definition of Cachexia?",
              "a": "Progressive loss of body fat and lean body mass, accompanied by profound weakness and anorexia (mediated by TNF)."
            },
            {
              "q": "Primary mediator of the Vasodilation phase of inflammation?",
              "a": "Histamine and Nitric Oxide (NO)."
            },
            {
              "q": "Cell type that predominates in <b>Chronic Inflammation</b>?",
              "a": "Macrophages."
            },
            {
              "q": "Cytokine that induces Cachexia?",
              "a": "TNF-alpha."
            },
            {
              "q": "What is \"Desmoplasia\"?",
              "a": "Abundant collagenous stroma induced by certain tumors (e.g., breast cancer), making them feel hard/gritty."
            },
            {
              "q": "Definition of \"<b>Carcinoma</b> in situ\"?",
              "a": "Full-thickness <b>dysplasia</b> of the epithelium without penetration of the basement membrane."
            },
            {
              "q": "Significance of the c-MYC oncogene?",
              "a": "Transcription factor involved in cell cycle progression; associated with Burkitt Lymphoma t(8;14)."
            },
            {
              "q": "Definition of \"Transudate\"?",
              "a": "Fluid with low protein content and low specific gravity; result of hydrostatic/oncotic pressure imbalance."
            },
            {
              "q": "Definition of \"Exudate\"?",
              "a": "Fluid with high protein content and cellular debris; result of increased vascular permeability (inflammation)."
            },
            {
              "q": "Most common type of embolus?",
              "a": "Thromboembolus."
            },
            {
              "q": "What are \"Heart Failure Cells\"?",
              "a": "Hemosiderin-laden macrophages in the lungs resulting from chronic pulmonary congestion."
            },
            {
              "q": "Effect of Aspirin on the Arachidonic Acid pathway?",
              "a": "Irreversible inhibition of Cyclooxygenase (COX-1 and COX-2)."
            },
            {
              "q": "Key cytokine for Fibrosis and Scarring?",
              "a": "TGF-beta."
            },
            {
              "q": "Primary enzyme in Neutrophil granules that produces HOCl?",
              "a": "Myeloperoxidase (MPO)."
            },
            {
              "q": "Definition of <b>Dysplasia</b>?",
              "a": "Disordered growth; loss of cellular uniformity and architectural orientation (often pre-neoplastic)."
            },
            {
              "q": "What is an \"Infarct\"?",
              "a": "An area of ischemic <b>necrosis</b> caused by occlusion of either the arterial supply or the venous drainage."
            },
            {
              "q": "Typical outcome of Septic Shock?",
              "a": "Multiple Organ Dysfunction Syndrome (MODS)."
            },
            {
              "q": "Role of P-glycoprotein in cancer cells?",
              "a": "An efflux pump that can expel chemotherapeutic drugs, leading to multi-drug resistance."
            },
            {
              "q": "Cause of \"Nutmeg Liver\"?",
              "a": "Chronic passive congestion of the liver due to right-sided heart failure."
            }
