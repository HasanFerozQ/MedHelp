            { q: "Mechanism of action of Venlafaxine and Duloxetine?", a: "Serotonin-Norepinephrine Reuptake Inhibitors (SNRIs)." },
            { q: "Major medical contraindication specific to initiating Venlafaxine?", a: "Uncontrolled hypertension (due to dose-dependent noradrenergic effects)." },
            { q: "SNRI preferred for patients with comorbid depression and chronic neuropathic pain?", a: "Duloxetine." },
            { q: "Unique mechanism of action of Mirtazapine?", a: "$\\alpha_2$ adrenergic antagonist, increasing release of $\\text{5-HT}$ and NE." },
            { q: "Two primary clinical benefits/side effects utilized when choosing Mirtazapine?", a: "Sedation (histamine-1 blockade) and appetite stimulation/weight gain." },
            { q: "Mechanism of action of Bupropion?", a: "Norepinephrine-Dopamine Reuptake Inhibitor (NDRI)." },
            { q: "Two major clinical advantages of Bupropion over SSRIs?", a: "Lack of sexual side effects and lack of weight gain." },
            { q: "Absolute medical contraindications for prescribing Bupropion?", a: "Seizure disorders, anorexia nervosa, bulimia nervosa, or active alcohol/benzo withdrawal." },
            { q: "Mechanism of Trazodone and its primary clinical utility in depression?", a: "$\\text{$\\text{5-HT}$}_{2}$ receptor antagonist and reuptake inhibitor; primarily used low-dose as a non-addictive hypnotic." },
            { q: "Rare, medical emergency side effect associated with Trazodone?", a: "Priapism." },
            { q: "Mechanism of action of Vortioxetine?", a: "SSRI combined with $\\text{$\\text{5-HT}$}_{1\\text{A}}$ agonism and $\\text{$\\text{5-HT}$}_{3}$/$\\text{$\\text{5-HT}$}_{7}$ antagonism." },
            { q: "Primary toxic mechanism of Tricyclic Antidepressants (TCAs) in overdose?", a: "Inhibition of fast sodium channels in the myocardium, leading to QRS widening and arrhythmias." },
            { q: "Triad of classic toxicities seen in TCA overdose?", a: "Cardiotoxicity (arrhythmias), Convulsions (seizures), and Coma." },
            { q: "Immediate medical antidote for TCA-induced cardiac arrhythmias?", a: "Intravenous Sodium Bicarbonate." },
            { q: "Dietary restriction mandatory for patients taking Monoamine Oxidase Inhibitors (MAOIs)?", a: "Low-tyramine diet (avoiding aged cheeses, cured meats, red wine)." },
            { q: "Pathophysiology of the hypertensive crisis caused by combining MAOIs with tyramine?", a: "Tyramine displaces stored norepinephrine into the synaptic cleft, causing massive vasoconstriction." },
            { q: "Immediate pharmacologic intervention for an MAOI-induced hypertensive crisis?", a: "Phentolamine ($\\alpha$-adrenergic antagonist)." },
            { q: "Mechanism behind Serotonin Syndrome when combining MAOIs and SSRIs?", a: "Overactivation of central and peripheral $\\text{$\\text{5-HT}$}_{1\\text{A}}$ and $\\text{$\\text{5-HT}$}_{2\\text{A}}$ receptors." },
            { q: "Minimum washout period required when switching from an SSRI to an MAOI?", a: "2 weeks (5 weeks specifically for Fluoxetine due to long half-life)." },
            { q: "Classic clinical triad of Serotonin Syndrome?", a: "Autonomic instability, altered mental status, and neuromuscular hyperactivity." },
            { q: "Pathognomonic physical exam finding that distinguishes Serotonin Syndrome from NMS?", a: "Hyperreflexia and clonus (spontaneous, inducible, or ocular)." },
            { q: "First-line medical treatment for severe Serotonin Syndrome?", a: "Cyproheptadine ($\\text{$\\text{5-HT}$}_{2\\text{A}}$ antagonist) along with aggressive cooling and benzodiazepines." },
            { q: "Evidence-based psychotherapy modalities proven effective as monotherapy for mild-to-moderate MDD?", a: "Cognitive Behavioral Therapy (CBT) and Interpersonal Therapy (IPT)." },
            { q: "Quickest, most effective treatment for severe, treatment-resistant MDD or psychotic depression?", a: "Electroconvulsive Therapy (ECT)." },
            { q: "Absolute medical contraindication to performing ECT?", a: "None (increased intracranial pressure is a relative contraindication requiring caution)." },
            { q: "Most common acute side effect associated with ECT courses?", a: "Retrograde and anterograde amnesia (usually resolves within a few months)." },
            { q: "Indication for Esketamine nasal spray in major depression?", a: "Treatment-Resistant Depression (TRD) or acute suicidal ideation, acting via NMDA receptor antagonism." },
            { q: "Standard maintenance guideline duration for an antidepressant after a patient's first MDE?", a: "Continue effective dose for 6 to 12 months after achieving full remission." },
            { q: "Indication for lifelong maintenance antidepressant therapy?", a: "History of 3 or more MDEs, or chronic severe episodes." },
            { q: "Minimal duration required to diagnose a manic episode?", a: "1 week (or any duration if hospitalization is required)." },
            { q: "Core requirement regarding mood change to diagnose a manic episode?", a: "Abnormally, persistently elevated, expansive, or irritable mood, PLUS persistently increased goal-directed activity/energy." },
            { q: "Minimum number of symptoms required for a manic episode diagnosis?", a: "Three (four if the mood is only irritable)." },
            { q: "Mnemonic DIGFAST for mania symptoms stands for?", a: "Distractibility, Indiscretion (impulsivity), Grandiosity, Flight of ideas, Activity increase, Sleep deficit, Talkativeness (pressured speech)." },
            { q: "True or False: A history of a Major Depressive Episode is required to diagnose Bipolar I Disorder?", a: "False (only 1 lifetime manic episode is required)." },
            { q: "True or False: The presence of hallucinations or delusions automatically classifies an episode as manic rather than hypomanic?", a: "True." },
            { q: "Defining social/occupational criteria separating mania from hypomania?", a: "Mania causes marked impairment in functioning or requires hospitalization; hypomania does not." },
            { q: "What is Bipolar I with rapid cycling?", a: "Four or more distinct mood episodes (mania, hypomania, or depression) within a 12-month period." },
            { q: "Class of medications known to precipitate or accelerate rapid cycling in Bipolar patients?", a: "Antidepressants (specifically TCAs and SNRIs/SSRIs)." },
            { q: "Peak age of onset for Bipolar I disorder?", a: "Late adolescence to early adulthood (18 to 25 years)." },
            { q: "Diagnostic criteria combination required to diagnose Bipolar II Disorder?", a: "At least one lifetime Hypomanic Episode AND at least one lifetime Major Depressive Episode." },
            { q: "True or False: A history of a single manic episode permanently changes a Bipolar II diagnosis to Bipolar I?", a: "True." },
            { q: "Minimal duration required to diagnose a hypomanic episode?", a: "4 consecutive days." },
            { q: "Define Cyclothymic Disorder criteria regarding symptom duration?", a: "At least 2 years (1 year in children/adolescents) of numerous periods of hypomanic and depressive symptoms that do not meet full criteria for an episode." },
            { q: "Maximum time a patient with Cyclothymia can be symptom-free during the 2-year diagnostic window?", a: "2 months." },
            { q: "Strongest risk factor for developing Bipolar I Disorder?", a: "Family history (monozygotic twin concordance rates approach 40% to 70%)." },
            { q: "Neurotransmitter alteration typically associated with acute mania?", a: "Hyperactivity of dopamine and norepinephrine pathways." },
            { q: "First-line mood stabilizer uniquely shown to reduce suicide risk in Bipolar Disorder?", a: "Lithium." },
            { q: "Baseline laboratory investigations mandatory before initiating Lithium?", a: "Renal function (BUN/Creatinine), Thyroid Function Tests (TSH), Electrolytes, and $\\beta$-hCG (pregnancy test)." },
            { q: "Classic congenital cardiac anomaly associated with first-trimester Lithium exposure?", a: "Ebstein's anomaly (displacement of tricuspid valve leaflets into the right ventricle)." },
            { q: "Narrow therapeutic index range for Lithium in acute mania?", a: "1.0 to 1.5 mEq/L." },
            { q: "Maintenance therapeutic index range for Lithium?", a: "0.6 to 1.2 mEq/L." },
            { q: "Common, benign neurologic side effect of therapeutic Lithium?", a: "Fine resting/intention tremor." },
            { q: "Long-term endocrine adverse effect of Lithium therapy requiring tracking?", a: "Hypothyroidism (often treatable by adding Levothyroxine without stopping Lithium)." },
            { q: "Renal pathology caused by long-term Lithium use resulting in polyuria/polydipsia?", a: "Nephrogenic Diabetes Insipidus (NDI)." },
            { q: "Pharmacologic treatment of choice for Lithium-induced Nephrogenic Diabetes Insipidus?", a: "Amiloride (blocks Lithium entry into collecting duct epithelial cells)." },
            { q: "Medication classes that acutely elevate Lithium levels and trigger toxicity?", a: "Thiazide diuretics, NSAIDs, and ACE inhibitors/ARBs." },
            { q: "Gastrointestinal and neurologic signs of acute Lithium toxicity?", a: "Nausea, vomiting, severe diarrhea, coarse tremor, ataxia, slurred speech, and seizures." },
            { q: "Definitive treatment intervention for acute Lithium toxicity with levels greater than 4.0 mEq/L (or greater than 2.5 mEq/L with severe neuro toxicity)?", a: "Hemodialysis." },
            { q: "First-line mood stabilizer preferred for Bipolar with mixed features or rapid cycling?", a: "Valproic Acid (Valproate)." },
            { q: "Baseline and maintenance laboratory tracking required for Valproate?", a: "Liver Function Tests (LFTs) and Complete Blood Count (CBC) for platelets." },
            { q: "Two black box warning toxicities associated with Valproate?", a: "Hepatotoxicity and Pancreatitis." },
            { q: "Teratogenic defect caused by Valproate exposure in early pregnancy?", a: "Neural tube defects (e.g., spina bifida via folate antagonism)." },
            { q: "Therapeutic plasma concentration range for Valproate in mood disorders?", a: "50 to 125 mcg/mL." },
            { q: "Primary clinical indication for Lamotrigine in Bipolar Disorder management?", a: "Maintenance therapy to prevent Bipolar Depression (ineffective for acute mania)." },
            { q: "Serious, life-threatening dermatologic adverse effect of Lamotrigine?", a: "Stevens-Johnson Syndrome (SJS) / Toxic Epidermal Necrolysis (TEN)." },
            { q: "Clinical titration strategy used to minimize the risk of Lamotrigine-induced SJS?", a: "Extremely slow, low-dose upward titration over several weeks." },
            { q: "Drug-drug interaction effect of Valproate on Lamotrigine metabolism?", a: "Valproate doubles Lamotrigine levels; Lamotrigine dose must be halved." },
            { q: "Mechanism of action making Carbamazepine useful in Bipolar mania?", a: "Blockade of voltage-gated sodium channels." },
            { q: "Serious hematologic side effect associated with Carbamazepine requiring CBC tracking?", a: "Agranulocytosis/Aplastic anemia." },
            { q: "Electrolyte abnormality frequently caused by Carbamazepine (especially in elderly)?", a: "Hyponatremia (SIADH-like effect)." },
            { q: "Role of Second-Generation Antipsychotics (SGAs) in managing acute manic episodes?", a: "First-line monotherapy or adjunct to mood stabilizers for rapid control of agitation and psychosis." },
            { q: "Which SGAs are specifically FDA-approved for the treatment of acute Bipolar Depression?", a: "Quetiapine, Lurasidone, Cariprazine, and the Olanzapine-Fluoxetine combination." },
            { q: "Primary metabolic side effects requiring long-term monitoring with Olanzapine and Clozapine?", a: "Weight gain, dyslipidemia, and hyperglycemia/Type 2 Diabetes." },
            { q: "Initial step in treating a patient presenting with an acute MDE who has a family history of Bipolar I?", a: "Screen carefully for past spontaneous manic/hypomanic episodes before starting an antidepressant." },
            { q: "Dangerous clinical outcome of treating a Bipolar patient with SSRI monotherapy?", a: "Treatment-emergent mania or hypomania switch." },
            { q: "First-line treatment strategy for a pregnant patient experiencing severe, life-threatening manic or depressive episodes?", a: "Electroconvulsive Therapy (ECT)." },
            { q: "Most common psychiatric comorbidity found in individuals with Bipolar Disorder?", a: "Anxiety disorders (followed closely by Substance Use Disorders)." },
            { q: "Percentage of individuals with Bipolar Disorder who attempt suicide at least once?", a: "Approximately 25% to 50%." },
            { q: "First-line pharmacologic strategy for a patient presenting with a manic episode with mixed features?", a: "Valproate or an atypical antipsychotic (avoid lithium if severe depressive features dominate)." },
            { q: "Difference between a \"response\" and \"remission\" in mood disorder treatment?", a: "Response is a 50% or greater reduction in symptoms; Remission is the near-total absence of symptoms." },
            { q: "Define Disruptive Mood Dysregulation Disorder (DMDD) age window for diagnosis?", a: "Onset must be before age 10; cannot diagnose before age 6 or after age 18." },
            { q: "Core clinical feature differentiating DMDD from Bipolar disorder in children?", a: "DMDD features persistent, chronic irritability between temper outbursts, rather than episodic shifts." },
            { q: "Minimum symptom duration required to diagnose Persistent Depressive Disorder (Dysthymia) in adults?", a: "2 years." },
            { q: "Minimum symptom duration required to diagnose Persistent Depressive Disorder (Dysthymia) in children?", a: "1 year." },
            { q: "Maximum period a patient can be symptom-free during the course of Persistent Depressive Disorder?", a: "2 months." },
            { q: "Core diagnostic symptom timing requirement for Premenstrual Dysphoric Disorder (PMDD)?", a: "Symptoms express in the week before menses onset, improve within a few days after menses starts, and become minimal/absent post-menses." },
            { q: "First-line pharmacologic treatment options for severe PMDD?", a: "SSRIs (administered either daily or luteal-phase-only)." },
            { q: "Primary defense mechanism implicated in depression according to classic psychoanalytic theory?", a: "Introjection (turning anger inward against the self after the loss of an object)." },
            { q: "Beck's Cognitive Triad of depression consists of negative views of what three things?", a: "The self, the world, and the future." },
            { q: "Structural brain change seen in Bipolar Disorder during neuroimaging structural studies?", a: "Nonspecific white matter hyperintensities and ventricular enlargement." },
            { q: "Most common cause of treatment failure in patients diagnosed with Bipolar Disorder?", a: "Medication non-adherence (often due to missing the high of hypomania/mania or side effects)." },
            { q: "Preferred maintenance drug for a bipolar patient with severe renal impairment?", a: "Valproate (avoid Lithium)." },
            { q: "Preferred maintenance drug for a bipolar patient with active hepatic failure?", a: "Lithium (avoid Valproate/Carbamazepine)." },
            { q: "Primary lab marker utilized to monitor for Carbamazepine auto-induction?", a: "Serum Carbamazepine levels (Carbamazepine induces its own metabolism over the first 4-6 weeks)." },
            { q: "HLA allele screening required before starting Carbamazepine in Asian patients?", a: "HLA-B*1502 (due to high risk of SJS/TEN)." },
            { q: "Pharmacologic treatment of choice for severe Bipolar depression when multiple monotherapies fail?", a: "Mood stabilizer (Lithium or Valproate) PLUS an atypical antipsychotic (e.g., Lurasidone or Quetiapine)." },
            { q: "True or False: Psychotherapy alone is sufficient as a primary treatment for acute Bipolar I mania?", a: "False (pharmacotherapy is mandatory; psychotherapy is an adjunct for maintenance)." },
            { q: "What is \"double depression\"?", a: "Major Depressive Episodes superimposed on a chronic course of Persistent Depressive Disorder." },
            { q: "Major clinical feature that distinguishes Bipolar I with psychotic features from Schizoaffective Disorder?", a: "In Bipolar, psychotic symptoms occur only during a mood episode; in Schizoaffective, psychosis occurs for 2 or more weeks in the absence of prominent mood symptoms." },
            { q: "Most common over-the-counter medication class that can precipitate depressive symptoms?", a: "Systemic corticosteroids (e.g., Prednisone)." },
            { q: "Cardiovascular medication class classically associated with treatment-emergent depression?", a: "$\\beta$-blocker (e.g., Propranolol)." },
            { q: "Neurological medication used for Parkinson’s disease that can precipitate manic-like symptoms?", a: "Levodopa (due to increase in central dopamine)." },
            { q: "Endocrine disorder that mimics a manic episode and must be ruled out with a TSH test?", a: "Hyperthyroidism." },
            { q: "Infectious disease characterized by profound fatigue, depressed mood, and atypical lymphocytosis?", a: "Epstein-Barr Virus (Infectious Mononucleosis)." },
            { q: "Pancreatic pathology classically presenting with sudden-onset depression before physical symptoms emerge?", a: "Pancreatic adenocarcinoma." },
            { q: "Neurological pathology presenting with depression, chorea, and dementia?", a: "Huntington's disease." },
            { q: "Substance withdrawal that presents with dysphoria, hypersomnia, hyperphagia, and vivid dreams?", a: "Cocaine or Amphetamine withdrawal (\"crashing\")." },
            { q: "Substance intoxication that presents with grandiosity, paranoia, tachycardia, and pupillary dilation?", a: "Amphetamine or Cocaine intoxication." },
            { q: "Over-the-counter herbal supplement used for depression that can cause Serotonin Syndrome if combined with an SSRI?", a: "St. John’s Wort." },
            { q: "What defines MDD with anxious distress specifier?", a: "Presence of at least two symptoms of anxiety (e.g., feeling keyed up, unusually restless) during a major depressive episode." },
            { q: "Diagnostic minimum for Bipolar I or II \"with mixed features\"?", a: "A full mood episode accompanied by at least three symptoms of the opposite polarity." },
            { q: "What defines MDD with peri-menopausal onset?", a: "Onset of depressive symptoms during the menopausal transition, linked to fluctuating estrogen levels." },
            { q: "True or False: Irritability can substitute for depressed mood in children and adolescents to meet Criterion A for MDD?", a: "True." },
            { q: "Minimum duration of symptoms required to diagnose Cyclothymic Disorder in pediatric patients?", a: "One year." },
            { q: "True or False: Subclinical hypothyroidism can cause resistance to standard antidepressant therapy?", a: "True." },
            { q: "Statistically, which demographic has the highest rate of completed suicide in the US?", a: "Elderly Caucasian males (age greater than 65)." },
            { q: "Strongest single predictive risk factor for a future completed suicide?", a: "A history of previous suicide attempts." },
            { q: "Gender paradox of suicide: Which gender attempts more, and which completes more?", a: "Females attempt suicide more frequently; males complete suicide more frequently." },
            { q: "Mirroring genetic risk: What is the concordance rate of Bipolar I disorder in monozygotic twins?", a: "Approximately 40% to 70%." },
            { q: "Mirroring genetic risk: What is the concordance rate of Major Depressive Disorder in monozygotic twins?", a: "Approximately 40% to 50%." },
            { q: "Lifetime prevalence range of Major Depressive Disorder in the general population?", a: "10% to 25% for women; 5% to 12% for men." },
            { q: "Antidepressant class characterized by strong antihistaminic ($\\text{H}_1$) and anti-$\\alpha_1$ adrenergic side effects?", a: "Tricyclic Antidepressants (TCAs)." },
            { q: "Symptom presentation of anti-$\\alpha_1$ adrenergic blockade from psychotropic medications?", a: "Orthostatic hypotension and reflex tachycardia." },
            { q: "Receptor blockade responsible for dry mouth, blurred vision, urinary retention, and constipation from TCAs?", a: "Muscarinic acetylcholine receptor blockade (anticholinergic effects)." },
            { q: "SSRI with the longest half-life, minimizing the risk of discontinuation syndrome?", a: "Fluoxetine." },
            { q: "SSRIs with the shortest half-lives, presenting the highest risk for discontinuation syndrome?", a: "Paroxetine and Venlafaxine." },
            { q: "Triad of features characterizing Antidepressant Discontinuation Syndrome?", a: "Flu-like symptoms, electrical shock sensations (\"brain zaps\"), and vivid dreams." },
            { q: "Mechanism of action of Vilazodone?", a: "SSRI combined with $\\text{$\\text{5-HT}$}_{1\\text{A}}$ receptor partial agonism." },
            { q: "Second-generation antipsychotic with a specific black-box warning for severe neutropenia/agranulocytosis?", a: "Clozapine." },
            { q: "Mandatory laboratory tracking protocol required for prescribing Clozapine?", a: "Absolute Neutrophil Count (ANC)." },
            { q: "Mechanism of action of Ramelteon, often used for sleep disturbances in mood disorders?", a: "Melatonin receptor (MT1 and MT2) agonist." },
            { q: "Initial medical intervention for a patient with Bipolar I presenting with acute Lithium toxicity and a prolonged QTc?", a: "Discontinue Lithium, administer intravenous hydration, and obtain urgent serum Lithium levels." },
            { q: "Preferred mood stabilizer for a patient with Bipolar I who has comorbid juvenile myoclonic epilepsy?", a: "Valproic Acid." },
            { q: "Maintenance treatment of choice for a patient with Bipolar II whose primary impairment stems from recurrent depressive crashes?", a: "Lamotrigine." },
            { q: "What step should be taken if a patient on Lithium develops mild, asymptomatic hypercalcemia and elevated parathyroid hormone?", a: "Monitor levels; Lithium can cause hyperparathyroidism." },
            { q: "First-line pharmacotherapy for a patient with MDD with psychotic features?", a: "Combination of an antidepressant and an antipsychotic (or ECT)." },
            { q: "Preferred antidepressant for an elderly patient with MDD, low appetite, and insomnia?", a: "Mirtazapine." },
            { q: "Antidepressant class absolutely contraindicated for use with any triptan medication due to Serotonin Syndrome risk?", a: "MAOIs (and cautiously with SSRIs/SNRIs)." },
            { q: "Next management step for a patient with MDD who has shown zero improvement after 4 weeks of maximum-dose SSRI therapy?", a: "Switch to a different class of antidepressant (e.g., SNRI or atypical)." },
            { q: "Next management step for a patient with MDD who has shown a partial response (30% improvement) after 6 weeks of maximum-dose SSRI therapy?", a: "Augment with a non-SSRI agent (e.g., Bupropion, Lithium, or a low-dose atypical antipsychotic)." },
            { q: "Psychotherapeutic approach focusing heavily on changing distorted core beliefs and automatic negative thoughts?", a: "Cognitive Behavioral Therapy (CBT)." },
            { q: "Psychotherapeutic approach focusing on grief, interpersonal role disputes, and role transitions?", a: "Interpersonal Psychotherapy (IPT)." },
            { q: "Key neuromuscular physical exam finding that distinguishes Serotonin Syndrome from Neuroleptic Malignant Syndrome (NMS)?", a: "Hyperreflexia and clonus are present in Serotonin Syndrome; \"lead-pipe\" rigidity is present in NMS." },
            { q: "Autonomic sign distinguishing Anticholinergic Toxicity from Serotonin Syndrome?", a: "Anticholinergic toxicity presents with dry, flushed skin and absent bowel sounds; Serotonin Syndrome presents with diaphoresis (sweating) and hyperactive bowel sounds." },
            { q: "Lab value abnormality characteristically elevated in both Neuroleptic Malignant Syndrome and severe Serotonin Syndrome due to muscle breakdown?", a: "Creatine Kinase (CK)." },
            { q: "Cardiac conduction abnormality that is an absolute contraindication to using Geodon (Ziprasidone) or Celexa (Citalopram) at high doses?", a: "QTc prolongation." },
            { q: "Maximum recommended daily dose of Citalopram in elderly patients due to risk of QTc prolongation?", a: "20 mg per day." },
            { q: "SSRI that is a potent inhibitor of CYP2D6 and can dramatically increase levels of $\\beta$-blocker and venlafaxine?", a: "Paroxetine (and Fluoxetine)." },
            { q: "Enzyme induced by Carbamazepine that causes it to clear itself and other anticonvulsants faster over the first month of treatment?", a: "CYP3A4." },
            { q: "Mood stabilizer that acts as a potent CYP3A4 inhibitor, increasing levels of Carbamazepine if co-administered?", a: "Valproate." },
            { q: "Antibiotic class (commonly used for UTIs) that can impair renal clearance and acutely increase Lithium levels?", a: "Tetracyclines (e.g., Doxycycline)." },
            { q: "Cardiac medication used for rate control that can decrease renal blood flow and elevate Lithium concentrations?", a: "Verapamil (and other calcium channel blockers)." },
            { q: "Structural brain abnormality found on MRI in patients with severe, chronic Bipolar Disorder?", a: "Enlargement of the lateral ventricles." },
            { q: "Functional neuroimaging finding (PET/SPECT) typically seen in the prefrontal cortex of depressed patients?", a: "Hypometabolism and decreased blood flow." },
            { q: "Neurotropic factor found to be significantly decreased in the serum and hippocampus of patients with active MDD?", a: "Brain-Derived Neurotrophic Factor (BDNF)." },
            { q: "First-line pharmacotherapy for a patient with severe Bipolar Mania who is also in her first trimester of pregnancy and refuses ECT?", a: "Haloperidol or a second-generation antipsychotic (e.g., Olanzapine)." },
            { q: "Next clinical step when a patient on Lithium develops rapid-onset confusion, coarse tremors, and nystagmus with a normal serum Lithium level?", a: "Check checking serum electrolytes, renal function, and re-verify the timing of the last Lithium dose relative to the blood draw." },
            { q: "Ideal time to draw blood for a steady-state therapeutic Lithium level check?", a: "12 hours after the last dose (trough level)." },
            { q: "Medical diagnosis to suspect when an older adult develops severe depression for the first time in life with asymmetric resting tremor and bradykinesia?", a: "Parkinson’s disease presenting with comorbid depression." },
            { q: "Treatment of choice for \"Pseudodementia\" (Depression-induced cognitive impairment in the elderly)?", a: "Antidepressants (SSRIs)." },
            { q: "Key clinical history feature distinguishing Pseudodementia from true Alzheimer’s Dementia?", a: "Patients with pseudodementia typically complain loudly about their memory loss and make little effort on cognitive tests (\"I don't know\" answers)." },
            { q: "True or False: Transcranial Magnetic Stimulation (TMS) is indicated for patients with severe psychotic depression?", a: "False (Psychotic depression requires ECT or combination pharmacotherapy; TMS is for non-psychotic treatment-resistant depression)." },
            { q: "What is the immediate next step in management for a depressed patient who admits to having a specific, actionable plan to commit suicide?", a: "Ensure patient safety via immediate voluntary or involuntary hospitalization." },
            { q: "True or False: If a patient with severe mania refuses hospitalization but poses an immediate danger to themselves or others, you must obtain a court order before placing an emergency hold?", a: "False (an emergency physician-initiated hold can be placed immediately; court review follows later)." },
            { q: "What is the legal doctrine that allows the state to intervene and involuntarily hospitalize a severely manic patient who is unable to provide for their own basic food, clothing, or shelter?", a: "Parens patriae (the state acting as a protector of citizens who cannot care for themselves)." },
            { q: "Next step in management if a patient with severe Bipolar I mania refuses life-saving medication during an acute involuntary hold?", a: "Administer emergency intramuscular medication (e.g., Haloperidol or Olanzapine) under emergency treatment protocols if they present an imminent threat of violence." },
            { q: "What is the immediate next step in management for a patient on Lithium who develops a mild, fine resting tremor but has a therapeutic serum level?", a: "Reassurance, or lower the dose slightly if clinically feasible, or add a low-dose $\\beta$-blocker (e.g., Propranolol)." },
            { q: "Next step in management for a patient taking an SSRI who develops acute, severe suicidal ideation within the first two weeks of starting the medication?", a: "Discontinue or lower the dose of the SSRI, monitor closely, and ensure immediate safety/hospitalization if necessary." },
            { q: "What is the preferred next step when a pregnant woman with Bipolar I stable on Lithium chooses to stay on her medication after a thorough risk-benefit discussion?", a: "Continue Lithium, but schedule targeted fetal echocardiography at 16 to 20 weeks of gestation to screen for Ebstein's anomaly." },
            { q: "Next step in management for a patient with MDD who achieves full remission on an SSRI but develops severe, treatment-limiting sexual dysfunction?", a: "Switch to Bupropion, or augment the SSRI with Bupropion or Sildenafil." },
            { q: "Next step in management for an adolescent patient diagnosed with MDD who fails to respond to cognitive behavioral therapy alone?", a: "Initiate pharmacotherapy with Fluoxetine (the SSRI with the most robust evidence and FDA approval for pediatric depression)." },
            { q: "How frequently should a patient's steady-state Lithium level be checked during the initial stabilization phase?", a: "Every 1 to 2 weeks until a stable, therapeutic level is achieved." },
            { q: "Once a patient is on a stable, long-term maintenance dose of Lithium, how often should renal function and TSH be checked?", a: "Every 6 to 12 months." },
            { q: "What baseline metric must be established before prescribing any second-generation antipsychotic for Bipolar depression due to metabolic risks?", a: "Fasting lipid panel, fasting blood glucose/HbA1c, body mass index (BMI), and waist circumference." },
            { q: "How often should a complete blood count (CBC) be monitored during the first few months of starting Carbamazepine?", a: "Every 2 to 4 weeks to screen for transient or severe leukopenia." }
          ]
        },
{
          section: 'Psychiatry',
          topic: "Psychotic disorders — schizophrenia spectrum",
          icon: 'brain',
          cards: [
            { q: "Core symptom domains required for a DSM-5-TR diagnosis of Schizophrenia?", a: "Delusions, hallucinations, disorganized speech, grossly disorganized/catatonic behavior, and negative symptoms." },
            { q: "Minimum number of core symptoms required for Schizophrenia diagnosis?", a: "At least two core symptoms." },
            { q: "Which specific core symptoms must include at least one to diagnose Schizophrenia?", a: "Delusions, hallucinations, or disorganized speech." },
            { q: "Minimum duration of active-phase symptoms required for Schizophrenia?", a: "One month." },
            { q: "Minimum total duration of continuous signs of disturbance required for Schizophrenia?", a: "Six months." },
            { q: "What does the 6-month Schizophrenia duration requirement include?", a: "Prodromal, active-phase, and residual-phase symptoms." },
            { q: "Define a delusion.", a: "A fixed, false belief unchanged by conflicting evidence." },
            { q: "Define a bizarre delusion.", a: "A delusion that is clearly implausible and not understandable from shared cultural experiences." },
            { q: "Most common type of delusion in schizophrenia spectrum disorders?", a: "Persecutory delusions." },
            { q: "Define a delusion of reference.", a: "The belief that random, innocuous environmental cues have highly personal significance." },
            { q: "Define thought broadcasting.", a: "The delusion that one's thoughts are being transmitted aloud to others." },
            { q: "Define thought insertion.", a: "The delusion that outside thoughts are being placed directly into one's mind." },
            { q: "Define thought withdrawal.", a: "The delusion that an outside force is removing thoughts from one's mind." },
            { q: "Define Capgras syndrome.", a: "The delusion that a familiar person has been replaced by an identical imposter." },
            { q: "Define Cotard syndrome.", a: "The nihilistic delusion that one is dead, decaying, or non-existent." },
            { q: "Define Fregoli syndrome.", a: "The delusion that different people are actually a single person in disguise." },
            { q: "Most common modality of hallucinations in schizophrenia?", a: "Auditory hallucinations." },
            { q: "Two specific types of auditory hallucinations traditionally tied to schizophrenia prognosis?", a: "Voices commenting on behavior and two or more voices conversing." },
            { q: "What should visual, olfactory, or gustatory hallucinations immediately prompt the clinician to suspect?", a: "An underlying medical, organic, or substance-induced etiology." },
            { q: "Define formal thought disorder.", a: "Disorganized thinking inferred objectively from speech patterns." },
            { q: "Define derailment (loose associations).", a: "Speech where ideas slip off track from one topic to an unrelated oblique topic." },
            { q: "Define tangentiality.", a: "Replying to questions in an oblique, irrelevant, or tangential manner." },
            { q: "Define incoherence (word salad).", a: "Speech that is linguistically disorganized and totally incomprehensible." },
            { q: "Define neologisms.", a: "Invented words created by combining parts of existing words." },
            { q: "Define perseveration.", a: "Persistent repetition of words, phrases, or ideas despite a change in context." },
            { q: "Define clang associations.", a: "Choosing words based on sound or rhyming rather than semantic meaning." },
            { q: "Define catatonia.", a: "Marked psychomotor disturbance involving decreased motor activity or excessive, purposeless activity." },
            { q: "Define waxy flexibility in catatonia.", a: "Slight, even resistance to positioning by examiner followed by maintenance of that new posture." },
            { q: "Define stupor in catatonia.", a: "Complete lack of psychomotor activity and unresponsiveness to the environment." },
            { q: "Define negativism in catatonia.", a: "Motiveless resistance to all instructions or maintenance of an opposite posture." },
            { q: "Define echolalia.", a: "Pathological repeating of another person's words." },
            { q: "Define echopraxia.", a: "Pathological mimicking of another person's movements." },
            { q: "List the \"5 A's\" of primary negative symptoms in Schizophrenia.", a: "Affective flattening, alogia, avolition, anhedonia, and asociality." },
            { q: "Define alogia.", a: "Poverty of speech and restriction in the amount or fluency of spontaneous speech." },
            { q: "Define avolition.", a: "An inability to initiate and persist in goal-directed activities." },
            { q: "Impact of negative symptoms vs. positive symptoms on long-term functional outcome?", a: "Negative symptoms are much stronger predictors of poor functional outcome." },
            { q: "Functional requirement essential for diagnosing Schizophrenia?", a: "Marked impairment in one or more major areas of functioning like work, relationships, or self-care." },
            { q: "Lifetime prevalence of Schizophrenia globally?", a: "Approximately 1%." },
            { q: "Male-to-female ratio of Schizophrenia prevalence?", a: "Equal (1:1), though presentation details differ." },
            { q: "Peak age of onset of Schizophrenia in males?", a: "Early to mid-20s (18-25 years)." },
            { q: "Peak age of onset of Schizophrenia in females?", a: "Late 20s to early 30s, with a smaller bimodal peak post-menopause." },
            { q: "Gender correlation with Schizophrenia prognosis?", a: "Females generally have a better prognosis and milder course." },
            { q: "Concordance rate of Schizophrenia in monozygotic twins?", a: "Approximately 40% to 50%." },
            { q: "Concordance rate of Schizophrenia in dizygotic twins?", a: "Approximately 10% to 15%." },
            { q: "Risk of developing Schizophrenia if one parent is diagnosed?", a: "Approximately 10% to 12%." },
            { q: "Risk of developing Schizophrenia if both parents are diagnosed?", a: "Approximately 40%." },
            { q: "Common neurodevelopmental birth complication linked to increased risk of Schizophrenia?", a: "In utero maternal infections (e.g., influenza) or obstetric complications causing fetal hypoxia." },
            { q: "Environmental factor involving season of birth associated with Schizophrenia?", a: "Late winter and early spring births." },
            { q: "Socioeconomic trend where Schizophrenia is more prevalent in lower socioeconomic classes?", a: "Social drift hypothesis (downward drift due to cognitive and behavioral impairment)." },
            { q: "Urban vs. rural environment risk for Schizophrenia?", a: "Urban environments double the risk of developing the disorder." },
            { q: "Classic substance abuse habit that carries a clear causal link to triggering psychotic episodes?", a: "Heavy cannabis use during adolescence." },
            { q: "Dopamine hypothesis: underlying mechanism of positive symptoms?", a: "Hyperactivity of dopamine neurotransmission in the mesolimbic pathway." },
            { q: "Dopamine hypothesis: underlying mechanism of negative and cognitive symptoms?", a: "Hypoactivity of dopamine neurotransmission in the mesocortical pathway." },
            { q: "Glutamate hypothesis of Schizophrenia?", a: "Hypofunction of NMDA receptors on GABAergic interneurons leading to downstream dopamine dysregulation." },
            { q: "Serotonin hypothesis contribution to Schizophrenia?", a: "$\\text{$\\text{5-HT}$}_{2\\text{A}}$ receptor activation modulates dopamine release, serving as the basis for atypical antipsychotic action." },
            { q: "Structural brain imaging finding most consistently replicated in Schizophrenia?", a: "Enlargement of the lateral and third ventricles." },
            { q: "Cortical structural brain change observed over time in Schizophrenia?", a: "Diffuse reduction in gray matter volume, most prominently in the temporal and frontal lobes." },
            { q: "Functional neuroimaging landmark pattern seen during executive task testing in Schizophrenia?", a: "Hypofrontality (decreased metabolic activity and blood flow in the prefrontal cortex)." },
            { q: "Microscopic histopathological finding in the hippocampus of Schizophrenia patients?", a: "Cellular disorientation and disarray of pyramidal neurons." },
            { q: "Alteration in normal adolescent brain development accelerated in Schizophrenia?", a: "Excessive or exaggerated synaptic pruning." },
            { q: "DSM-5-TR duration criteria for Brief Psychotic Disorder?", a: "At least 1 day but less than 1 month, with eventual full return to premorbid functioning." },
            { q: "Key specifier often associated with Brief Psychotic Disorder?", a: "With marked stressors (brief reactive psychosis)." },
            { q: "DSM-5-TR duration criteria for Schizophreniform Disorder?", a: "At least 1 month but less than 6 months." },
            { q: "Major diagnostic distinction between Schizophreniform Disorder and Schizophrenia?", a: "Schizophreniform requires a duration under 6 months and does not mandate social/occupational impairment." },
            { q: "Core requirement for diagnosing Schizoaffective Disorder?", a: "An uninterrupted period of illness during which there is a major mood episode concurrent with Schizophrenia Criterion A symptoms." },
            { q: "Essential rule for differentiating Schizoaffective Disorder from Mood Disorder with Psychotic Features?", a: "Delusions or hallucinations must be present for 2 or more weeks in the absence of a major mood episode." },
            { q: "Name the two main diagnostic subtypes of Schizoaffective Disorder.", a: "Bipolar type (if a manic or mixed episode occurs) and Depressive type." },
            { q: "Core DSM-5-TR requirement for Delusional Disorder?", a: "Presence of one or more delusions for a duration of 1 month or longer without other Criterion A schizophrenia symptoms." },
            { q: "Relative level of global psychosocial functioning in Delusional Disorder compared to Schizophrenia?", a: "Functioning is significantly less impaired; behavior is not obviously bizarre outside the delusion." },
            { q: "Define Erotomanic type Delusional Disorder.", a: "The central theme of the delusion is that another person (usually of higher status) is in love with the individual." },
            { q: "Define Grandiose type Delusional Disorder.", a: "The conviction of having some great, unrecognized talent, insight, or important discovery." },
            { q: "Define Jealous type Delusional Disorder.", a: "The central theme is that the individual's spouse or lover is unfaithful." },
            { q: "Define Somatic type Delusional Disorder.", a: "The central theme involves bodily functions or sensations (e.g., foul odor, parasite infestation)." },
            { q: "Define Persecutory type Delusional Disorder.", a: "The belief that the individual is being conspired against, cheated, spied on, followed, or harassed." },
            { q: "Subcortical dementia often presenting with prominent visual hallucinations and paranoid delusions early on?", a: "Lewy Body Dementia." },
            { q: "Common neuroendocrine emergency characterized by neuropsychiatric symptoms, visual hallucinations, and autonomic instability?", a: "Thyroid storm (severe hyperthyroidism)." },
            { q: "Autoimmune encephalitis associated with ovarian teratomas presenting with rapid-onset psychosis and catatonia?", a: "Anti-NMDA receptor encephalitis." },
            { q: "Infectious disease screening labs required for all new-onset psychosis workups?", a: "RPR/VDRL (Syphilis) and HIV serology." },
            { q: "Vital urine laboratory screening test for any acute first-episode psychosis evaluation?", a: "Urine toxicology screen (to rule out substance-induced psychosis)." },
            { q: "Primary mechanism of action of First-Generation (Typical) Antipsychotics?", a: "Strong, competitive post-synaptic antagonism of Dopamine $\\text{D}_2$ receptors." },
            { q: "Pathway targeted by Typical Antipsychotics to resolve positive symptoms?", a: "Mesolimbic pathway." },
            { q: "Pathway blocked by Typical Antipsychotics that induces Extrapyramidal Symptoms (EPS)?", a: "Nigrostriatal pathway." },
            { q: "Name two classic high-potency first-generation antipsychotics.", a: "Haloperidol and Fluphenazine." },
            { q: "Name two classic low-potency first-generation antipsychotics.", a: "Chlorpromazine and Thioridazine." },
            { q: "High-potency vs. low-potency first-generation antipsychotics side effect profiles?", a: "High-potency have more EPS; low-potency have more antihistaminic, anticholinergic, and $\\alpha_1$ antiadrenergic effects." },
            { q: "Specific ophthalmic complication unique to long-term Chlorpromazine use?", a: "Corneal and lens deposits." },
            { q: "Specific ophthalmic complication unique to long-term Thioridazine use?", a: "Retinitis pigmentosa." },
            { q: "Four main categories of Extrapyramidal Symptoms (EPS)?", a: "Acute dystonia, akathisia, parkinsonism, and tardive dyskinesia." },
            { q: "Timeframe for development of acute dystonia?", a: "Hours to days after starting or increasing medication." },
            { q: "Presentation of acute dystonia?", a: "Sustained, painful muscle contractions of the neck (torticollis), jaw (trismus), or eyes (oculogyric crisis)." },
            { q: "Preferred first-line pharmacological treatment for acute dystonia?", a: "Benztropine or Diphenhydramine (intravenous or intramuscular)." },
            { q: "Define akathisia.", a: "Subjective feeling of intense inner restlessness and objective inability to sit still." },
            { q: "First-line medical treatments for akathisia?", a: "$\\beta$-blocker (Propranolol) or low-dose Benzodiazepines." },
            { q: "Symptoms of antipsychotic-induced parkinsonism?", a: "Bradykinesia, rigidity, masked facies, and a resting pill-rolling tremor." },
            { q: "Pharmacological management for antipsychotic-induced parkinsonism?", a: "Benztropine or Amantadine." },
            { q: "Why should Levodopa never be used to treat antipsychotic-induced parkinsonism?", a: "It increases dopamine levels and will severely exacerbate the underlying psychosis." },
            { q: "Timeframe for development of Tardive Dyskinesia?", a: "Months to years of chronic antipsychotic exposure." },
            { q: "Classic visual presentation of Tardive Dyskinesia?", a: "Involuntary, choreoathetoid movements of the tongue, face, lips (puckering), or trunk." },
            { q: "Underlying pathophysiology of Tardive Dyskinesia?", a: "Upregulation and supersensitivity of postsynaptic $\\text{D}_2$ receptors in the nigrostriatal pathway." },
            { q: "Initial step in managing Tardive Dyskinesia if clinically feasible?", a: "Discontinue or taper the typical antipsychotic, or switch the patient to Clozapine." },
            { q: "FDA-approved drug class for the targeted treatment of Tardive Dyskinesia?", a: "VMAT2 inhibitors (Valbenazine or Deutetrabenazine)." },
            { q: "Pathway blocked by antipsychotics that leads to hyperprolactinemia?", a: "Tuberoinfundibular pathway." },
            { q: "Clinical manifestations of hyperprolactinemia in males and females?", a: "Gynecomastia, galactorrhea, amenorrhea, and erectile dysfunction." },
            { q: "Life-threatening idiosyncratic reaction to antipsychotics marked by rigidity, hyperthermia, and autonomic instability?", a: "Neuroleptic Malignant Syndrome (NMS)." },
            { q: "Key laboratory marker highly elevated in Neuroleptic Malignant Syndrome?", a: "Creatine Phosphokinase (CPK)." },
            { q: "First management steps for Neuroleptic Malignant Syndrome?", a: "Immediately discontinue the offending agent, initiate aggressive cooling, and provide IV hydration." },
            { q: "Two specific medications used to treat severe cases of Neuroleptic Malignant Syndrome?", a: "Dantrolene (skeletal muscle relaxant) and Bromocriptine (dopamine agonist)." },
            { q: "Primary mechanism of action of Second-Generation (Atypical) Antipsychotics?", a: "Combined Dopamine $\\text{D}_2$ antagonism and Serotonin $\\text{$\\text{5-HT}$}_{2\\text{A}}$ receptor antagonism." },
            { q: "Main clinical advantage of second-generation over first-generation antipsychotics?", a: "Significantly lower incidence of extrapyramidal symptoms (EPS) and tardive dyskinesia." },
            { q: "Primary long-term metabolic risk profile of second-generation antipsychotics?", a: "Weight gain, dyslipidemia, hyperglycemia, and new-onset Type 2 Diabetes." },
            { q: "Two atypical antipsychotics carrying the highest risk for metabolic syndrome?", a: "Olanzapine and Clozapine." },
            { q: "Two atypical antipsychotics carrying the lowest risk for metabolic syndrome?", a: "Ziprasidone and Aripiprazole." },
            { q: "Specific cardiac risk assessment mandatory for patients taking Ziprasidone?", a: "Electrocardiogram (EKG) monitoring for corrected QT (QTc) interval prolongation." },
            { q: "Unique mechanism of action of Aripiprazole?", a: "Partial $\\text{D}_2$ receptor agonist, partial $\\text{$\\text{5-HT}$}_{1\\text{A}}$ agonist, and $\\text{$\\text{5-HT}$}_{2\\text{A}}$ antagonist." },
            { q: "Specific side effect most frequently associated with Risperidone among the atypicals?", a: "Significant hyperprolactinemia, even at lower doses." },
            { q: "Atypical antipsychotic noted for causing significant sedation and cataracts in animal studies, requiring baseline eye exams?", a: "Quetiapine." },
            { q: "Absolute gold-standard indication for initiating Clozapine therapy?", a: "Treatment-resistant schizophrenia (failure of two separate adequate antipsychotic trials)." },
            { q: "Only antipsychotic proven to significantly reduce the risk of suicidal behavior in schizophrenia?", a: "Clozapine." },
            { q: "Most dangerous, black-box warning hematologic side effect of Clozapine?", a: "Agranulocytosis (absolute neutrophil count drops below 500/microliter)." },
            { q: "Mandatory laboratory monitoring protocol required for prescribing Clozapine?", a: "Regular tracking of absolute neutrophil count (ANC) via the Clozapine REMS program." },
            { q: "Severe, non-hematologic, dose-dependent neurological side effect of Clozapine?", a: "Seizures." },
            { q: "Gastrointestinal black-box warning associated with Clozapine that can become fatal if missed?", a: "Severe gastrointestinal hypomotility (paralytic ileus/fecal impaction)." },
            { q: "Cardiovascular emergency linked to Clozapine initiation requiring monitoring of troponins and CRP?", a: "Myocarditis or cardiomyopathy." },
            { q: "Common, bothersome nocturnal side effect reported by patients taking Clozapine?", a: "Sialorrhea (excessive drooling)." },
            { q: "Preferred medication formulation utilized to improve treatment adherence in non-compliant schizophrenia patients?", a: "Long-Acting Injectable (LAI) antipsychotics (depot formulations)." },
            { q: "Name two atypical antipsychotics available as Long-Acting Injectables (LAIs).", a: "Risperidone, Paliperidone, or Olanzapine." },
            { q: "Dangerous medical emergency that can occur immediately post-injection with Olanzapine pamoate LAI?", a: "Post-injection delirium sedation syndrome." },
            { q: "Define the prodromal phase of Schizophrenia.", a: "A period of subclinical decline characterized by social withdrawal, irritability, uncharacteristic odd beliefs, and poor hygiene prior to the first active psychotic episode." },
            { q: "Single strongest overall predictor of a poor prognosis in Schizophrenia?", a: "Insidious onset during early childhood or adolescence." },
            { q: "List three features predictive of a good prognosis in Schizophrenia.", a: "Acute onset, clear precipitating stressors, late age of onset, and prominent positive symptoms." },
            { q: "Impact of active substance abuse on the prognosis of Schizophrenia?", a: "Substantially worsens the course, increases relapse rates, and lowers medication adherence." },
            { q: "Leading cause of premature death in patients diagnosed with Schizophrenia?", a: "Suicide." },
            { q: "Lifetime percentage of Schizophrenia patients who attempt suicide?", a: "Approximately 20% to 40%." },
            { q: "Specific demographic subset of Schizophrenia patients at the highest risk for suicide?", a: "Young, highly intelligent males with high premorbid functioning who have insight into their functional decline." },
            { q: "Primary purpose of Cognitive Behavioral Therapy for Psychosis (CBTp)?", a: "To reduce the distress and functional impairment caused by persistent positive symptoms, rather than eliminating them entirely." },
            { q: "Family dynamic factor strongly correlated with high relapse and re-hospitalization rates in Schizophrenia?", a: "High Expressed Emotion (criticism, hostility, and emotional over-involvement)." },
            { q: "Evidence-based community treatment model utilizing a multidisciplinary team to deliver 24/7 comprehensive care directly to severe schizophrenia patients in real-world settings?", a: "Assertive Community Treatment (ACT)." },
            { q: "Recommended psychosocial intervention designed to improve real-world interpersonal interactions and independence?", a: "Social Skills Training (SST)." },
            { q: "What is the primary role of electroconvulsive therapy (ECT) within the psychotic disorders spectrum?", a: "Augmented treatment for severe catatonia or treatment-resistant schizophrenia with comorbid depression." },
            { q: "Neurological disease presenting with chorea and early psychiatric symptoms like psychosis and depression?", a: "Huntington's Disease." },
            { q: "Trinucleotide repeat expansion mutation responsible for Huntington's Disease?", a: "CAG repeats on chromosome 4." },
            { q: "Metabolic disorder presenting with psychosis, abdominal pain, neuropathy, and dark purple urine?", a: "Acute Intermittent Porphyria." },
            { q: "Deficient enzyme responsible for Acute Intermittent Porphyria?", a: "Porphobilinogen deaminase." },
            { q: "Heavy metal poisoning presenting with psychosis, a blue-gray line on the gums, and foot drop?", a: "Lead poisoning." },
            { q: "Vitamin deficiency classically presenting with psychosis, macrocytic anemia, and subacute combined degeneration of the spinal cord?", a: "Vitamin B12 (Cobalamin) deficiency." },
            { q: "Central nervous system infection to suspect in a patient with psychosis, Argyll Robertson pupils, and loss of proprioception?", a: "Neurosyphilis (Tertiary Syphilis)." },
            { q: "Define Argyll Robertson pupil.", a: "Pupils that constrict during accommodation but do not react to light." },
            { q: "Endocrine disorder presenting with psychosis, weight gain, coarse hair, and a delayed relaxation phase of deep tendon reflexes?", a: "Severe hypothyroidism (\"myxedema madness\")." },
            { q: "Illicit drug intoxication characterized by psychosis, extreme agitation, and rotary nystagmus?", a: "Phencyclidine (PCP) intoxication." },
            { q: "Illicit drug intoxication characterized by paranoia, visual hallucinations, pupillary dilation, and tactile hallucinations like formication?", a: "Cocaine or Amphetamine intoxication." },
            { q: "Define formication.", a: "The tactile hallucination or sensation that bugs are crawling on or under the skin." },
            { q: "Over-the-counter medication class that can induce severe delirium, confusion, and visual hallucinations in elderly patients?", a: "Anticholinergics (e.g., Diphenhydramine)." },
            { q: "Prescription medication class frequently causing treatment-induced psychosis or mania in patients treated for inflammatory or autoimmune conditions?", a: "Corticosteroids (e.g., Prednisone)." },
            { q: "Life-threatening withdrawal state characterized by visual/tactile hallucinations, severe tremors, and autonomic instability 48 to 96 hours after the last drink?", a: "Delirium Tremens (Alcohol withdrawal delirium)." },
            { q: "Medical emergency characterized by hyperthermia, rigidity, and hyperreflexia/clonus when mixing psychotropic medications?", a: "Serotonin Syndrome." },
            { q: "Main clinical differentiator between Serotonin Syndrome and Neuroleptic Malignant Syndrome (NMS)?", a: "Serotonin Syndrome features hyperreflexia and clonus; NMS features severe \"lead-pipe\" rigidity and hyporeflexia." },
            { q: "Antipsychotic medication that requires a major dose reduction if the patient completely stops smoking tobacco cigarettes?", a: "Clozapine (or Olanzapine)." },
            { q: "Why does stopping smoking alter Clozapine metabolism?", a: "Tobacco smoke induces the CYP1A2 enzyme; stopping smoke expression rapidly increases Clozapine blood concentrations." },
            { q: "Atypical antipsychotic that is the active metabolite of Risperidone?", a: "Paliperidone." },
            { q: "Atypical antipsychotic that must always be taken with food to ensure adequate gastrointestinal absorption?", a: "Ziprasidone (requires at least 500 calories) or Lurasidone (requires at least 350 calories)." },
            { q: "Mechanism by which low-potency antipsychotics cause severe orthostatic hypotension?", a: "Antagonism of peripheral $\\alpha_1$ adrenergic receptors." },
            { q: "Baseline metabolic tracking labs required prior to initiating any Second-Generation Antipsychotic?", a: "Fasting lipid panel, fasting blood glucose (or HbA1c), weight/BMI, and blood pressure." },
            { q: "Follow-up timeframe recommended by the ADA for checking lipids and blood glucose after starting an atypical antipsychotic?", a: "At 12 weeks, and then annually thereafter." },
            { q: "Quantitative QTc interval threshold on an EKG where antipsychotics should typically be held or discontinued?", a: "A QTc interval greater than 500 milliseconds." },
            { q: "Severe cardiac arrhythmia that a prolonged QTc interval predisposes a patient to develop?", a: "Torsades de Pointes." },
            { q: "Baseline laboratory test required before starting Clozapine to rule out benign baseline patterns?", a: "Baseline Absolute Neutrophil Count (ANC)." },
            { q: "Absolute Neutrophil Count (ANC) cutoff value below which Clozapine must be immediately discontinued?", a: "An ANC less than 1,000/microliter (or less than 500/microliter in verified benign ethnic neutropenia)." },
            { q: "Define the \"Deficit Syndrome\" variant of Schizophrenia.", a: "A subtype characterized by severe, enduring, primary negative symptoms that persist even during periods of clinical stability." },
            { q: "Association between the Deficit Syndrome and overall long-term prognosis?", a: "It carries a significantly poorer prognosis and is highly resistant to standard antipsychotic treatments." },
            { q: "What is the diagnostic significance of \"Post-psychotic Depression\" in Schizophrenia?", a: "A major depressive episode that emerges during the residual phase of schizophrenia, carrying an exceptionally high risk for suicide." },
            { q: "Electroencephalogram (EEG) changes typically observed in patients with chronic Schizophrenia?", a: "Non-specific focal abnormalities, localized slowing, and decreased $\\alpha$ wave activity." },
            { q: "Polysomnography (Sleep Study) architectural changes characteristically seen in Schizophrenia?", a: "Decreased slow-wave sleep (Stage N3) and shortened REM latency." },
            { q: "Neurological soft signs commonly found on physical exam in patients with schizophrenia spectrum disorders?", a: "Impaired left-right confusion, poor stereognosis, agraphesthesia, and dysdiadochokinesia." },
            { q: "Define stereognosis.", a: "The ability to perceive and recognize the form of an object in the absence of visual and auditory information, by using tactile sensations." },
            { q: "Define agraphesthesia.", a: "The inability to recognize symbols, letters, or numbers traced on the skin." },
            { q: "Eye-tracking physical exam abnormality heavily studied and linked as an endophenotype for Schizophrenia?", a: "Impairment in smooth-pursuit eye movements." },
            { q: "Clinical strategy used when switching a patient from a high-metabolic atypical antipsychotic to a low-metabolic one?", a: "Cross-titration (gradually tapering the old medication while slowly uptitrating the new one over weeks)." },
            { q: "Why is an immediate, abrupt switch from Olanzapine to Aripiprazole dangerous?", a: "It can cause a rebound cholinergic crisis or an acute exacerbation of psychosis due to sudden $\\text{D}_2$ receptor unbinding." },
            { q: "Symptoms of a rebound cholinergic crisis following abrupt withdrawal of low-potency or highly sedating antipsychotics?", a: "Diaphoresis, nausea, vomiting, diarrhea, and severe insomnia." },
            { q: "Antipsychotic medication that possesses the unique property of having a highly prolonged half-life, making missing occasional doses less critical?", a: "Cariprazine." },
            { q: "Atypical antipsychotic noted for a very low affinity for $\\text{D}_2$ receptors and rapid dissociation, making it ideal for treating psychosis in Parkinson's Disease?", a: "Pimavanserin (or low-dose Quetiapine)." },
            { q: "Mechanism of action of Pimavanserin?", a: "Inverse agonist and antagonist at Serotonin $\\text{$\\text{5-HT}$}_{2\\text{A}}$ receptors, completely lacking dopamine $\\text{D}_2$ blockade." },
            { q: "Drug-drug interaction risk when combining an atypical antipsychotic with a strong CYP3A4 inhibitor like Clarithromycin or Ketoconazole?", a: "Substantially increased antipsychotic serum levels, markedly elevating the risk of QTc prolongation and toxicity." },
            { q: "Drug-drug interaction risk when combining Clozapine with Carbamazepine?", a: "Synergistic bone marrow suppression, exponentially increasing the risk of life-threatening agranulocytosis." },
            { q: "Serious respiratory side effect of high-dose low-potency typical antipsychotics used in elderly patients with dementia-related psychosis?", a: "Increased risk of aspiration pneumonia due to impaired swallowing reflexes." },
            { q: "Black Box warning shared by all antipsychotics regarding their use in elderly patients with dementia-related behavioral disturbances?", a: "Increased risk of all-cause mortality, primarily due to cardiovascular events (stroke, heart failure) or infectious complications." },
            { q: "Primary legal justification allowing a physician to place a patient on an involuntary psychiatric hold?", a: "The presence of a mental illness causing the patient to be an imminent danger to themselves, an imminent danger to others, or gravely disabled." },
            { q: "Does an involuntary psychiatric hold automatically give the physician the right to force medications against the patient's will?", a: "No, an involuntary hold and the right to refuse medication are legally distinct entities requiring separate legal or administrative review." },
            { q: "Landmark legal case establishing that a psychiatrist has a \"duty to protect\" third parties from a patient's violent threats?", a: "Tarasoff v. Regents of the University of California." },
            { q: "Next immediate step if a patient with active command auditory hallucinations to harm a named individual demands to sign out of the hospital?", a: "Deny the request, initiate an involuntary hold, and notify both law enforcement and the intended victim." },
            { q: "Contrast medical \"competence\" versus medical \"capacity\".", a: "Competence is a legal determination made exclusively by a judge; capacity is a clinical assessment made by a treating physician." },
            { q: "Four foundational elements required to determine that a psychiatric patient has decision-making capacity?", a: "The ability to communicate a clear choice, understand the relevant medical facts, appreciate the clinical consequences, and rationally manipulate the information." }
          ]
        },
{
          section: 'Psychiatry',
          topic: "Anxiety disorders — GAD, panic, PTSD, OCD",
          icon: 'brain',
          cards: [
            { q: "Minimum duration of symptoms required for a DSM-5-TR diagnosis of Generalized Anxiety Disorder (GAD)?", a: "Six months." },
            { q: "Number of associated somatic symptoms required for adults to diagnose GAD under DSM-5-TR?", a: "At least three symptoms." },
            { q: "Number of associated somatic symptoms required for children to diagnose GAD under DSM-5-TR?", a: "Only one symptom." },
            { q: "List the six DSM-5-TR somatic symptoms associated with GAD.", a: "Restlessness, fatigue, difficulty concentrating, irritability, muscle tension, and sleep disturbance." },
            { q: "Pathophysiological brain region showing hyperactivation in GAD during emotional processing?", a: "Amygdala." },
            { q: "Pathophysiological brain region showing structural and functional hypoactivation in GAD?", a: "Prefrontal cortex." },
            { q: "First-line pharmacotherapy classes for the long-term management of GAD?", a: "SSRIs and SNRIs." },
            { q: "Non-benzodiazepine anxiolytic that acts as a $\\text{$\\text{5-HT}$}_{1\\text{A}}$ receptor partial agonist?", a: "Buspirone." },
            { q: "Timeframe required for buspirone to achieve therapeutic efficacy in GAD?", a: "Two to four weeks." },
            { q: "Primary clinical limitation of using benzodiazepines in the long-term management of GAD?", a: "Risk of physiological dependence, tolerance, and withdrawal." },
            { q: "First-line, evidence-based psychotherapy modality for GAD?", a: "Cognitive Behavioral Therapy (CBT)." },
            { q: "$\\alpha_2$-$\\delta$ ligand anticonvulsant frequently used off-label as a highly effective agent for GAD?", a: "Pregabalin." },
            { q: "Common $\\beta$-blocker used primarily for the autonomic, somatic symptoms of performance anxiety rather than generalized anxiety?", a: "Propranolol." },
            { q: "Minimum frequency and nature of panic attacks required for Panic Disorder diagnosis?", a: "Recurrent and unexpected panic attacks." },
            { q: "Timeframe and criteria required following a panic attack to meet Panic Disorder diagnosis?", a: "One month or more of persistent worry about future attacks or maladaptive behavioral changes." },
            { q: "Minimum number of physical or cognitive symptoms required to define a distinct panic attack?", a: "Four symptoms." },
            { q: "List four cognitive symptoms that can count toward a DSM-5 panic attack definition.", a: "Fear of losing control, fear of going crazy, derealization/depersonalization, and fear of dying." },
            { q: "Define agoraphobia according to the DSM-5-TR.", a: "Marked fear or anxiety about two or more public situations where escape might be difficult." },
            { q: "Neuroanatomical structure considered the \"panic center\" or primary source of norepinephrine in panic attacks?", a: "Locus coeruleus." },
            { q: "Acute, immediate pharmacological intervention for a patient experiencing a severe, disabling panic attack?", a: "Short-acting benzodiazepines (e.g., Alprazolam, Lorazepam)." },
            { q: "Gold-standard, first-line long-term maintenance pharmacotherapy for Panic Disorder?", a: "SSRIs (started at low doses to avoid initial activation/anxiety)." },
            { q: "Specific CBT technique involving deliberate exposure to feared bodily sensations to treat panic disorder?", a: "Interoceptive exposure." },
            { q: "Medical emergency or toxic state that can perfectly mimic a panic attack and must be ruled out via TSH?", a: "Hyperthyroidism." },
            { q: "Substance abuse/withdrawal state that can acutely precipitate panic attacks?", a: "Caffeine intoxication or Alcohol withdrawal." },
            { q: "Acid-base disturbance characteristically seen on an ABG during an acute panic attack due to hyperventilation?", a: "Respiratory alkalosis." },
            { q: "Minimum age required to apply standard DSM-5-TR PTSD criteria?", a: "Six years of age." },
            { q: "Minimum symptom duration required for a diagnosis of Post-Traumatic Stress Disorder (PTSD)?", a: "One month." },
            { q: "Diagnosis given if PTSD-like symptoms present after a trauma but resolve within one month?", a: "Acute Stress Disorder (ASD)." },
            { q: "Minimum and maximum timeframe for a diagnosis of Acute Stress Disorder?", a: "Three days to one month following trauma exposure." },
            { q: "Four core symptom clusters required for the diagnosis of PTSD?", a: "Intrusion, Avoidance, Negative alterations in cognition/mood, and Alterations in arousal/reactivity." },
            { q: "Neuroendocrine abnormality characteristically seen in the HPA axis of PTSD patients?", a: "Hypocortisolemia due to enhanced glucocorticoid receptor sensitivity." },
            { q: "Structural brain changes classically observed on neuroimaging in chronic PTSD patients?", a: "Decreased hippocampal volume." },
            { q: "Only two FDA-approved SSRIs for the treatment of PTSD?", a: "Sertraline and Paroxetine." },
            { q: "$\\alpha_1$ adrenergic antagonist used specifically to target trauma-related nightmares and sleep disruption in PTSD?", a: "Prazosin." },
            { q: "Most prominent side effect of Prazosin that requires nighttime titration?", a: "Orthostatic hypotension." },
            { q: "Preferred specialized trauma-focused psychotherapies for PTSD?", a: "Prolonged Exposure (PE) and Eye Movement Desensitization and Reprocessing (EMDR)." },
            { q: "Class of medications strictly avoided or contraindicated in PTSD due to high substance abuse comorbidity and lack of efficacy?", a: "Benzodiazepines." },
            { q: "Timeframe required to diagnose an Adjustment Disorder following an identifiable stressor?", a: "Development within three months of the stressor, resolving within six months of stressor termination." },
            { q: "Definition of an obsession in OCD?", a: "Recurrent, persistent, intrusive thoughts, urges, or images causing marked anxiety." },
            { q: "Definition of a compulsion in OCD?", a: "Repetitive behaviors or mental acts performed in response to an obsession or rigid rules." },
            { q: "Minimum time-consuming threshold required by DSM-5-TR for OCD symptoms?", a: "Symptoms take up more than one hour per day." },
            { q: "Define \"egodystonic\" as it applies to the obsessions in OCD.", a: "The thoughts are inconsistent with the patient's self-concept and are perceived as unacceptable." },
            { q: "Core differentiator between OCD and Obsessive-Compulsive Personality Disorder (OCPD)?", a: "OCD is egodystonic (distressing to self); OCPD is egosyntonic (perceived as correct/ideal by the patient)." },
            { q: "Primary neurobiological circuit implicated in the pathogenesis of OCD?", a: "Cortico-striato-thalamo-cortical (CSTC) circuit." },
            { q: "First-line pharmacotherapy class for OCD?", a: "SSRIs." },
            { q: "Dosing strategy difference for SSRIs in OCD compared to Major Depressive Disorder?", a: "OCD requires significantly higher doses of SSRIs." },
            { q: "Gold-standard tricyclic antidepressant (TCA) used for treatment-resistant OCD?", a: "Clomipramine." },
            { q: "Primary neurotransmitter mechanism of Clomipramine?", a: "Potent serotonin reuptake inhibition (most serotonin-selective TCA)." },
            { q: "Most effective, specialized behavioral therapy technique used for OCD?", a: "Exposure and Response Prevention (ERP)." },
            { q: "Neurodevelopmental condition characterized by sudden-onset OCD or tics following a Group A Streptococcal infection?", a: "PANDAS (Pediatric Autoimmune Neuropsychiatric Disorders Associated with Streptococcal Infections)." },
            { q: "FDA-approved second-line augmentation strategy for OCD patients not fully responding to SSRIs?", a: "Atypical antipsychotics (e.g., Risperidone, Aripiprazole)." },
            { q: "Neurosurgical or neuromodulatory intervention approved for severe, intractable, treatment-resistant OCD?", a: "Deep Brain Stimulation (DBS) or Anterior Cingulotomy." },
            { q: "Mechanism of action of Venlafaxine at low doses (less than 150mg/day)?", a: "Almost exclusive serotonin reuptake inhibition (behaves like an SSRI)." },
            { q: "Mechanism of action of Venlafaxine at high doses (greater than 150mg/day)?", a: "Dual serotonin and norepinephrine reuptake inhibition (true SNRI)." },
            { q: "Most critical vital sign to monitor in patients taking high-dose Venlafaxine or Duloxetine?", a: "Blood pressure (risk of dose-dependent diastolic hypertension)." },
            { q: "Unique mechanism of action of Mirtazapine?", a: "$\\alpha_2$ adrenergic antagonist, $\\text{$\\text{5-HT}$}_{2}$ and $\\text{$\\text{5-HT}$}_{3}$ receptor antagonist, and $\\text{H}_1$ histamine antagonist." },
            { q: "Two most prominent side effects of low-dose Mirtazapine due to its $\\text{H}_1$ affinity?", a: "Sedation and weight gain." },
            { q: "Life-threatening condition characterized by autonomic instability, altered mental status, and neuromuscular hyperactivity caused by combining SSRIs and MAOIs?", a: "Serotonin Syndrome." },
            { q: "Required washout period when switching from an SSRI (except Fluoxetine) to an MAOI?", a: "Two weeks." },
            { q: "Required washout period when switching from Fluoxetine to an MAOI due to its long half-life?", a: "Five to six weeks." },
            { q: "Active metabolite of Fluoxetine that accounts for its exceptionally long half-life?", a: "Norfluoxetine." },
            { q: "SSRI with the shortest half-life and highest risk for SSRI Discontinuation Syndrome?", a: "Paroxetine." },
            { q: "SSRI with the highest risk of congenital cardiac defects (Ebstein's anomaly/septal defects) if used in the first trimester?", a: "Paroxetine." },
            { q: "Distinctive EKG abnormality associated with high doses of Citalopram and Escitalopram?", a: "QTc prolongation." },
            { q: "Maximum recommended daily dose of Citalopram in geriatric patients to avoid arrhythmias?", a: "Twenty milligrams." },
            { q: "Benzodiazepine with an exceptionally long half-life and active metabolites, making it a poor choice for elderly patients?", a: "Diazepam." },
            { q: "Three benzodiazepines that undergo only phase II hepatic glucuronidation, making them safe for liver failure patients?", a: "Lorazepam, Oxazepam, Temazepam (Mnemonic: Outside The Liver)." },
            { q: "Flumazenil mechanism of action?", a: "Competitive antagonist at the benzodiazepine receptor site on the $\\text{GABA}_\\text{A}$ complex." },
            { q: "Primary danger of administering Flumazenil to a patient with chronic benzodiazepine dependence?", a: "Induction of acute, life-threatening withdrawal seizures." },
            { q: "Fatal medical risk of severe benzodiazepine withdrawal?", a: "Status epilepticus and cardiovascular collapse." },
            { q: "Diagnosis for a patient with episodic, unprovoked shortness of breath, chest pain, and fear of dying, with normal cardiac enzymes and EKG?", a: "Panic Disorder." },
            { q: "Diagnostic consideration for an elderly patient presenting with new-onset anxiety or panic symptoms for the first time in life?", a: "Anxiety secondary to a general medical condition or neurocognitive disorder." },
            { q: "Lab test to order when a young female presents with panic symptoms, weight loss, and lid lag?", a: "Thyroid Stimulating Hormone (TSH)." },
            { q: "Rare neuroendocrine tumor of the adrenal medulla that can perfectly mimic a panic disorder?", a: "Pheochromocytoma." },
            { q: "Screening lab test required to rule out Pheochromocytoma?", a: "Plasma free metanephrines or 24-hour urinary metanephrines." },
            { q: "Over-the-counter medication class that can acutely cause anxiety, tachycardia, and insomnia?", a: "Sympathomimetics (e.g., Pseudoephedrine)." },
            { q: "Cardiac valvular abnormality heavily associated with panic disorder in clinical epidemiology?", a: "Mitral Valve Prolapse (MVP)." },
            { q: "Differentiator between Social Anxiety Disorder and Agoraphobia?", a: "Social anxiety is driven by fear of scrutiny/humiliation; agoraphobia is driven by fear of being unable to escape." },
            { q: "Diagnosis for a patient who fears and avoids eating in public or public speaking due to fear of embarrassment?", a: "Social Anxiety Disorder (Social Phobia)." },
            { q: "First-line pharmacotherapy option for the performance-only subtype of Social Anxiety Disorder?", a: "$\\beta$-blocker (Propranolol) or short-acting benzodiazepines." },
            { q: "Contraindication for using Propranolol in a patient with performance anxiety?", a: "Asthma or severe chronic obstructive pulmonary disease (COPD)." },
            { q: "Core feature of Body Dysmorphic Disorder (BDD) that classifies it under the OCD-related disorders spectrum?", a: "Preoccupation with perceived flaws in physical appearance coupled with repetitive behaviors." },
            { q: "Diagnosis for a patient who persistently collects items regardless of value and experiences severe distress when attempting to discard them?", a: "Hoarding Disorder." },
            { q: "Hair-pulling disorder categorized under the DSM-5-TR Obsessive-Compulsive and Related Disorders section?", a: "Trichotillomania." },
            { q: "Primary defense mechanism employed in OCD where a patient separates an idea/thought from its emotional component?", a: "Isolation of affect." },
            { q: "Defense mechanism where an unacceptable impulse is converted into its exact opposite (common in OCD spectrum)?", a: "Reaction Formation." },
            { q: "Defense mechanism where an individual tries to counteract or \"make up for\" an unacceptable thought or action with a ritualistic behavior?", a: "Undoing." },
            { q: "Most common comorbidity found in individuals diagnosed with Tourette's Disorder?", a: "ADHD and OCD." },
            { q: "Definition of \"poor insight\" specifier in DSM-5 anxiety/OCD disorders?", a: "The patient thinks the disorder beliefs are probably true." },
            { q: "Definition of \"absent/delusional insight\" specifier in OCD?", a: "The patient is completely convinced that the OCD beliefs are definitely true." },
            { q: "Primary reason why patients with GAD frequently present to primary care clinics instead of psychiatry?", a: "They present primarily with physical, somatic complaints (headaches, GI distress, muscle pain)." },
            { q: "Diagnostic label for a patient exhibiting severe anxiety, hyperarousal, and flashbacks two weeks after a near-fatal motor vehicle accident?", a: "Acute Stress Disorder." },
            { q: "Diagnostic label if the same motor vehicle accident patient still has flashbacks and hyperarousal six months later?", a: "Post-Traumatic Stress Disorder." },
            { q: "Timeline requirement for the diagnosis of Selective Mutism?", a: "Consistent failure to speak in specific social situations lasting at least one month (not limited to the first month of school)." },
            { q: "First-line behavioral therapy for Trichotillomania?", a: "Habit Reversal Training (HRT)." },
            { q: "Standard first-line medical therapy for Excoriation (skin-picking) disorder?", a: "SSRIs and Cognitive Behavioral Therapy." },
            { q: "First-line non-pharmacological strategy for a pediatric patient with mild Separation Anxiety Disorder?", a: "Parent-Child Interaction Therapy (PCIT) or family-focused CBT." },
            { q: "Major risk factor for the development of Panic Disorder in adulthood?", a: "History of childhood separation anxiety disorder or early childhood trauma." },
            { q: "Substance intoxication that causes pupillary dilation, tachycardia, hypertension, and profound acute paranoia/anxiety?", a: "Cocaine or Amphetamine intoxication." },
            { q: "Substance withdrawal state presenting with severe anxiety, tremors, diaphoresis, and elevated vitals within 48 hours of cessation?", a: "Alcohol or Sedative-Hypnotic withdrawal." },
            { q: "Mechanism of action of Vilazodone?", a: "SSRI plus $\\text{$\\text{5-HT}$}_{1\\text{A}}$ receptor partial agonist." },
            { q: "Mechanism of action of Vortioxetine?", a: "SSRI, $\\text{$\\text{5-HT}$}_{1\\text{A}}$ agonist, $\\text{$\\text{5-HT}$}_{1\\text{B}}$ partial agonist, and $\\text{$\\text{5-HT}$}_{3}$/$\\text{$\\text{5-HT}$}_{7}$/$\\text{$\\text{5-HT}$}_{1\\text{D}}$ antagonist." },
            { q: "Primary clinical advantage of Vilazodone and Vortioxetine over traditional SSRIs?", a: "Lower incidence of sexual dysfunction." },
            { q: "Receptor antagonism responsible for the orthostatic hypotension caused by low-potency antipsychotics or TCAs?", a: "$\\alpha_1$ adrenergic receptor antagonism." },
            { q: "Receptor antagonism responsible for weight gain and sedation in psychotropic medications?", a: "Histamine $\\text{H}_1$ receptor antagonism." },
            { q: "Anticonvulsant that acts as a positive allosteric modulator of $\\text{GABA}_\\text{A}$ receptors, sometimes used for refractory anxiety?", a: "Phenobarbital or Topiramate (off-label)." },
            { q: "Why is Buspirone ineffective when used \"as-needed\" (PRN) for acute panic or anxiety spikes?", a: "It requires chronic daily administration to downregulate presynaptic $\\text{$\\text{5-HT}$}_{1\\text{A}}$ autoreceptors." },
            { q: "Major drug-drug interaction risk when combining SSRIs with NSAIDs?", a: "Increased risk of upper gastrointestinal bleeding due to impaired platelet serotonin reuptake." },
            { q: "Primary Cytochrome P450 enzyme inhibited by Fluoxetine and Paroxetine?", a: "CYP2D6." },
            { q: "Primary Cytochrome P450 enzyme inhibited by Fluvoxamine?", a: "CYP1A2 and CYP2C19." },
            { q: "Most sedating SSRI, often dosed at bedtime, due to mild anticholinergic and antihistaminergic properties?", a: "Paroxetine." },
            { q: "Most activating SSRI, often dosed in the morning, due to its $\\text{$\\text{5-HT}$}_{2\\text{C}}$ antagonist properties?", a: "Fluoxetine." },
            { q: "Non-benzodiazepine, sedating antihistamine frequently used PRN for acute mild anxiety or insomnia in substance abuse populations?", a: "Hydroxyzine." },
            { q: "Serious neurological side effect of long-term benzodiazepine use in the geriatric population?", a: "Cognitive impairment, anterograde amnesia, and increased risk of falls/fractures." },
            { q: "Serious paradoxical reaction to benzodiazepines most commonly observed in children and the elderly?", a: "Paradoxical excitement, disinhibition, and aggression." },
            { q: "Antidepressant absolutely contraindicated in patients with an active or past diagnosis of Bulimia or Anorexia Nervosa due to seizure risk?", a: "Bupropion." },
            { q: "Mechanism of action of Ramelteon, sometimes used for insomnia in anxiety patients?", a: "Melatonin MT1 and MT2 receptor agonist." },
            { q: "Primary clinical sign of Buspirone toxicity?", a: "Dizziness, nausea, vomiting, and miosis." },
            { q: "Why can SSRIs initially worsen anxiety or trigger panic attacks during the first week of treatment?", a: "Acute stimulation of $\\text{$\\text{5-HT}$}_{2\\text{A}}$ and $\\text{$\\text{5-HT}$}_{2\\text{C}}$ receptors in the limbic system before downregulation occurs." },
            { q: "Strategy used to prevent early SSRI-induced activation anxiety in Panic Disorder patients?", a: "Start at half or a quarter of the standard antidepressant starting dose and titrate slowly." },
            { q: "Mechanism of action of the anxiolytic drug Ashwagandha or other herbal remedies often asked about by patients?", a: "Weak $\\text{GABA}_\\text{A}$ receptor modulation and cortisol reduction (not standard first-line)." },
            { q: "Primary treatment for a patient with severe Benzodiazepine Discontinuation Syndrome?", a: "Re-institute the benzodiazepine and switch to a long-acting agent (like Clonazepam or Chlordiazepoxide) for a very gradual taper." },
            { q: "Common somatic manifestation of GAD involving the musculoskeletal system?", a: "Chronic muscle tension, myofascial pain, and tension headaches." },
            { q: "Diagnostic criteria difference for OCD specifier \"with muscle tics\"?", a: "Up to 30% of OCD patients have a comorbid tic disorder, which predicts a poorer response to standard SSRI therapy alone." },
            { q: "Structural neuroimaging finding uniquely linked to severe, early-onset OCD?", a: "Caudate nucleus atrophy or structural asymmetry." },
            { q: "First-line medical strategy for an OCD patient who fails two separate, optimized trials of different SSRIs?", a: "Switch to Clomipramine or augment the current SSRI with an atypical antipsychotic." },
            { q: "Primary physiological reason behind the respiratory symptoms (suffocation feelings) in panic attacks according to the \"false suffocation alarm\" theory?", a: "Hypersensitivity of brainstem chemoreceptors to carbon dioxide ($CO_2$)." },
            { q: "Term used when a patient experiences panic symptoms that do not meet the full 4-symptom threshold?", a: "Limited-symptom panic attack." },
            { q: "Diagnosis for an individual who develops severe anxiety and functional impairment after losing their job, lasting 4 months?", a: "Adjustment Disorder with Anxiety." },
            { q: "Lifetime prevalence of Generalized Anxiety Disorder (GAD) in the United States population?", a: "Approximately 5% to 6%." },
            { q: "Gender distribution ratio for Generalized Anxiety Disorder?", a: "Females are twice as likely to be diagnosed as males." },
            { q: "Average age of onset for Generalized Anxiety Disorder?", a: "Late adolescence to early adulthood, though many patients report lifelong anxiety." },
            { q: "Lifetime prevalence of Panic Disorder in the United States?", a: "Approximately 2% to 3%." },
            { q: "Peak age range of onset for Panic Disorder?", a: "Late adolescence to the mid-30s." },
            { q: "Gender distribution ratio for Panic Disorder?", a: "Females are twice as likely to be affected as males." },
            { q: "Lifetime prevalence of Post-Traumatic Stress Disorder (PTSD) among adults in the United States?", a: "Approximately 7% to 8%." },
            { q: "Highest prevalence rates of PTSD are found among which specific occupational or situational cohorts?", a: "Combat veterans, survivors of sexual assault, and first responders." },
            { q: "Lifetime prevalence of Obsessive-Compulsive Disorder (OCD) in the general population?", a: "Approximately 2% to 3%." },
            { q: "Mean age of onset for Obsessive-Compulsive Disorder?", a: "Around 19 to 20 years of age." },
            { q: "Gender distribution of Obsessive-Compulsive Disorder in childhood versus adulthood?", a: "More common in boys during childhood, but equalizes between males and females in adulthood." },
            { q: "Genetic heritability estimate for Obsessive-Compulsive Disorder?", a: "Approximately 40% to 50% in twin studies." },
            { q: "DSM-5-TR specifier for Panic Disorder when panic attacks occur during sleep?", a: "Nocturnal panic attacks." },
            { q: "Percentage of Panic Disorder patients who experience at least one nocturnal panic attack?", a: "Approximately 20% to 40%." },
            { q: "DSM-5-TR PTSD specifier for patients presenting with prominent depersonalization or derealization?", a: "PTSD with dissociative symptoms." },
            { q: "DSM-5-TR PTSD specifier applied when full diagnostic criteria are not met until at least 6 months after the traumatic event?", a: "PTSD with delayed expression." },
            { q: "DSM-5-TR specifier for OCD when an individual recognizes that their OCD beliefs are definitely or probably not true?", a: "OCD with good or fair insight." },
            { q: "DSM-5-TR specifier for OCD when an individual thinks their OCD beliefs are probably true?", a: "OCD with poor insight." },
            { q: "DSM-5-TR specifier for OCD when an individual is completely convinced that their OCD beliefs are true?", a: "OCD with absent insight/delusional beliefs." },
            { q: "DSM-5-TR specifier for OCD when an individual has a lifetime history of a chronic tic disorder?", a: "OCD with tic-related specifier." },
            { q: "Expected treatment response for an OCD patient carrying the tic-related specifier?", a: "Poorer response to standard SSRIs alone, often requiring atypical antipsychotic augmentation." },
            { q: "Neurotransmitter theory regarding GABA activity in patients with Generalized Anxiety Disorder?", a: "Decreased $\\text{GABA}_\\text{A}$ receptor binding or overall GABAergic hypoactivity." },
            { q: "Neurotransmitter abnormality involving serotonin ($5\\text{-HT}$) and norepinephrine ($\\text{NE}$) in GAD?", a: "Dysregulation and imbalance of both serotonin and norepinephrine pathways." },
            { q: "Brain pathway that exhibits structural abnormalities in neuroimaging studies of Panic Disorder?", a: "Amygdala-prefrontal cortex fear circuit." },
            { q: "Infusion of which substance can reliably precipitate a panic attack in a susceptible Panic Disorder patient in a laboratory setting?", a: "Sodium lactate or carbon dioxide ($CO_2$) inhalation." },
            { q: "Physiological explanation for why sodium lactate triggers panic attacks?", a: "It induces metabolic alkalosis and alters central cheoreceptor sensitivity in the brainstem." },
            { q: "Neurotransmitter changes found in the cerebrospinal fluid ($\\text{CSF}$) of patients with chronic, severe PTSD?", a: "Increased norepinephrine concentrations and decreased serotonin metabolites." },
            { q: "Functional neuroimaging finding in PTSD regarding the activity of the medial prefrontal cortex?", a: "Hypoactivity, leading to a failure to top-down inhibit an overactive amygdala." },
            { q: "Neuroanatomical structure responsible for contextualizing memories that is functionally impaired in PTSD?", a: "Hippocampus." },
            { q: "Neurotransmitter pathway targeted by the primary, first-line pharmacological agents used to treat OCD?", a: "Serotonergic pathway." },
            { q: "Neuroimaging finding regarding glucose metabolism in the orbitofrontal cortex of untreated OCD patients?", a: "Hypermetabolism or hyperactivation." },
            { q: "Function of the caudate nucleus within the cortico-striato-thalamo-cortical ($\\text{CSTC}$) circuit that is faulty in OCD?", a: "Failure to filter out or \"gate\" intrusive, anxiety-provoking thoughts from reaching the cerebral cortex?" },
            { q: "Primary mechanism of action of Buspirone at the molecular level?", a: "Partial agonist at presynaptic and postsynaptic $5\\text{-HT}_{1\\text{A}}$ serotonin receptors." },
            { q: "Why does Buspirone lack abuse potential compared to benzodiazepines?", a: "It does not modulate the GABA receptor complex and has no dopaminergic reward pathway activity." },
            { q: "Mechanism of action of Hydroxyzine when used for acute anxiety management?", a: "Potent histamine $\\text{H}_1$ receptor antagonist with mild $5\\text{-HT}_{2}$ antagonist properties." },
            { q: "Molecular target of benzodiazepines on the $\\text{GABA}\\text{-A}$ receptor complex?", a: "Allosteric binding site between the $\\alpha$ and $\\gamma$ subunits." },
            { q: "Immediate intracellular effect of benzodiazepine binding to the $\\text{GABA}\\text{-A}$ receptor?", a: "Increased frequency of chloride channel opening, leading to hyperpolarization of the neuron." },
            { q: "Molecular target of barbiturates on the $\\text{GABA}\\text{-A}$ receptor compared to benzodiazepines?", a: "Allosteric binding site that increases the duration of chloride channel opening." },
            { q: "Receptor affinity responsible for the prominent weight gain and sedation caused by Mirtazapine?", a: "High affinity antagonism at the histamine $\\text{H}_1$ receptor." },
            { q: "Why does Mirtazapine cause less sexual dysfunction compared to standard SSRIs?", a: "It blocks $5\\text{-HT}_2$ and $5\\text{-HT}_3$ receptors, diverting serotonin selectively to $5\\text{-HT}_1$ receptors." },
            { q: "Mechanism of action of Clomipramine that distinguishes it from other tricyclic antidepressants ($\\text{TCAs}$)?", a: "Exceptionally high selectivity and potency for inhibiting the serotonin reuptake transporter ($\\text{SERT}$)." },
            { q: "Serious cardiovascular risk associated with an overdose of Clomipramine or any other TCA?", a: "Sodium channel blockade leading to QRS prolongation, cardiac arrhythmias, and seizures." },
            { q: "Primary antidote for a tricyclic antidepressant ($\\text{TCA}$) overdose presenting with a widened QRS complex?", a: "Intravenous sodium bicarbonate." },
            { q: "Mechanism of action of Prazosin in treating PTSD-related nightmares?", a: "Competitive antagonist at central $\\alpha_1$ adrenergic receptors, reducing central sympathetic outflow." },
            { q: "Pharmacological rationale for using atypical antipsychotics like Risperidone as augmentation in OCD?", a: "$5\\text{-HT}_{2\\text{A}}$ receptor antagonism modulates downstream dopamine and glutamate release in the $\\text{CSTC}$ circuit." },
            { q: "SSRI discontinuation syndrome is most acutely severe with which medication due to its lack of active metabolites?", a: "Paroxetine." },
            { q: "List three common symptoms of SSRI discontinuation syndrome.", a: "Flu-like symptoms, irritability, dizziness, paresthesias described as \"brain zaps,\" and vivid dreams." },
            { q: "Life-threatening symptom complex seen in severe Serotonin Syndrome that distinguishes it from Neuroleptic Malignant Syndrome ($\\text{NMS}$)?", a: "Neuromuscular hyperactivity manifesting as hyperreflexia and clonus." },
            { q: "Pharmacological antidote used for severe, refractory cases of Serotonin Syndrome?", a: "Cyproheptadine." },
            { q: "Mechanism of action of Cyproheptadine?", a: "First-generation antihistamine with potent $5\\text{-HT}_1$ and $5\\text{-HT}_2$ receptor antagonist properties." },
            { q: "Primary cognitive distortion targeted in CBT for Generalized Anxiety Disorder?", a: "Catastrophizing and intolerance of uncertainty." },
            { q: "Core behavioral component of CBT used to treat Agoraphobia?", a: "In vivo exposure to feared public places or situations." },
            { q: "Ultimate goal of interoceptive exposure in the treatment of Panic Disorder?", a: "Habituation to physical sensations of panic to break the conditioned fear response." },
            { q: "Define the \"Exposure\" component of Exposure and Response Prevention ($\\text{ERP}$) for OCD.", a: "Deliberately confronting the thoughts, images, or situations that trigger obsessional anxiety." },
            { q: "Define the \"Response Prevention\" component of Exposure and Response Prevention ($\\text{ERP}$) for OCD.", a: "Strictly refraining from performing the compulsive ritual that serves to decrease the anxiety." },
            { q: "Primary behavioral mechanism through which Prolonged Exposure ($\\text{PE}$) therapy works for PTSD?", a: "Emotional processing and extinction of the conditioned fear response through repeated imaginal and in vivo exposure." },
            { q: "Unique mechanism of Eye Movement Desensitization and Reprocessing ($\\text{EMDR}$) for PTSD?", a: "Using bilateral stimulation (like side-to-side eye movements) while processing traumatic memories to facilitate cognitive restructuring." },
            { q: "Psychological defense mechanism where an individual shifts an unacceptable impulse or feeling from its original target to a safer substitute?", a: "Displacement." },
            { q: "Psychological defense mechanism where an individual attributes their own unacknowledged, unacceptable thoughts or feelings onto another person?", a: "Projection." },
            { q: "Cardiac arrhythmia that can perfectly mimic the palpitations, diaphoresis, and acute anxiety of a panic attack?", a: "Paroxysmal Supraventricular Tachycardia ($\\text{PSVT}$)." },
            { q: "Diagnostic test used to differentiate Paroxysmal Supraventricular Tachycardia from a primary Panic Disorder?", a: "Holter monitor or ambulatory electrocardiography ($\\text{EKG}$)." },
            { q: "Neurological disorder characterized by episodic, excessive catecholamine release that mimics panic attacks, weight loss, and diaphoresis?", a: "Pheochromocytoma." },
            { q: "Diagnostic step when a clinician suspects an underlying Pheochromocytoma causing anxiety symptoms?", a: "Order a 24-hour urinary fractionated metanephrines or plasma free metanephrines test." },
            { q: "Endocrine disorder that frequently presents with generalized anxiety, heat intolerance, weight loss, and tachycardia?", a: "Hyperthyroidism." },
            { q: "Lab testing strategy to rule out hyperthyroidism in a patient with new-onset generalized anxiety symptoms?", a: "Serum Thyroid-Stimulating Hormone ($\\text{TSH}$) and Free $\\text{T}_4$ levels." },
            { q: "Dietary or over-the-counter substance that a clinician must screen for in every patient presenting with generalized anxiety or panic?", a: "Caffeine intake." },
            { q: "Cardiovascular condition involving the connective tissue of a heart valve that is epidemiologically linked to Panic Disorder?", a: "Mitral Valve Prolapse ($\\text{MVP}$)." },
            { q: "Classic auscultatory finding associated with Mitral Valve Prolapse?", a: "Midsystolic click followed by a late systolic murmur." },
            { q: "Primary clinical feature that differentiates Social Anxiety Disorder from Panic Disorder?", a: "In Social Anxiety Disorder, panic attacks occur only in response to social scrutiny or public performance situations." },
            { q: "Diagnosis for a patient who avoids public transport and open spaces because they fear help won't be available if they develop incapacitating symptoms?", a: "Agoraphobia." },
            { q: "Primary clinical differentiator between Acute Stress Disorder ($\\text{ASD}$) and Post-Traumatic Stress Disorder ($\\text{PTSD}$)?", a: "Symptom duration; ASD is 3 days to 1 month, while PTSD is greater than 1 month." },
            { q: "Diagnosis for a patient experiencing significant distress and functional impairment from a non-catastrophic life stressor within 3 months of its onset?", a: "Adjustment Disorder." },
            { q: "Treatment of choice for Adjustment Disorder?", a: "Psychotherapy (supportive or cognitive-behavioral)." },
            { q: "Medical diagnosis when an adult presents with severe obsessions and compulsions that began immediately after an acute cerebrovascular accident?", a: "Anxiety disorder/Obsessive-compulsive symptoms secondary to a general medical condition." },
            { q: "Pediatric syndrome characterized by the abrupt, explosive onset of OCD or tics following an infection?", a: "PANDAS (Pediatric Autoimmune Neuropsychiatric Disorders Associated with Streptococcal Infections)." },
            { q: "Underlying pathophysiology of PANDAS?", a: "Molecular mimicry where antistreptococcal antibodies cross-react with the basal ganglia." },
            { q: "Diagnosis for a patient preoccupied with imagined defects in physical appearance, leading to repetitive mirror checking or skin picking?", a: "Body Dysmorphic Disorder ($\\text{BDD}$)." },
            { q: "First-line medical and psychological therapy combination for Body Dysmorphic Disorder?", a: "High-dose SSRIs and Cognitive Behavioral Therapy." },
            { q: "Diagnosis for a patient who intentionally pulls out their hair, resulting in noticeable hair loss, preceded by tension and followed by relief?", a: "Trichotillomania (Hair-Pulling Disorder)." },
            { q: "Microscopic examination finding of hair shafts in Trichotillomania that helps differentiate it from Alopecia Areata?", a: "Broken hair shafts of varying lengths with no signs of inflammation or fungal infection." },
            { q: "Diagnosis for an individual who has persistent difficulty discarding possessions, regardless of value, causing severe clutter that compromises living areas?", a: "Hoarding Disorder." },
            { q: "Most effective long-term treatment strategy for Hoarding Disorder?", a: "Specialized Cognitive Behavioral Therapy tailored for hoarding behaviors (pharmacotherapy has limited efficacy)." },
            { q: "Diagnosis for a patient who skin-picks compulsively, leading to skin lesions and functional impairment, despite repeated attempts to stop?", a: "Excoriation (Skin-Picking) Disorder." },
            { q: "Medication class that must be completely avoided in patients with a history of trauma who are experiencing severe acute anxiety?", a: "Benzodiazepines, due to high addiction potential and interference with trauma processing." },
            { q: "Substance intoxication presenting with pupillary constriction (miosis), respiratory depression, and bradycardia?", a: "Opioid intoxication." },
            { q: "Substance withdrawal state presenting with pupillary dilation (mydriasis), rhinorrhea, piloerection, yawning, and severe anxiety?", a: "Opioid withdrawal." },
            { q: "Substance intoxication presenting with nystagmus, agitation, hypertension, and unpredictable, violent behavior?", a: "Phencyclidine ($\\text{PCP}$) intoxication." },
            { q: "Substance withdrawal state that can present with severe anxiety, tremors, tactile hallucinations (formication), and life-threatening seizures?", a: "Alcohol or Sedative-Hypnotic withdrawal." },
            { q: "Minimum duration of maintenance pharmacotherapy recommended for a patient who has achieved remission from a first episode of GAD?", a: "Twelve months." },
            { q: "Tapering strategy required when discontinuing long-term benzodiazepine therapy to avoid severe withdrawal or rebound anxiety?", a: "Gradual reduction of the dose by 10% to 25% every 1 to 2 weeks over several months." },
            { q: "Clinical step to take when a patient with Panic Disorder shows zero improvement after 6 weeks on a maximally tolerated dose of Sertraline?", a: "Switch to a different first-line medication, such as an alternative SSRI or an SNRI (e.g., Venlafaxine)." },
            { q: "Adjunctive medication class that can be used safely to manage severe physical tremors and tachycardia in a patient with PTSD?", a: "$\\beta$-blocker (e.g., Propranolol)." },
            { q: "Prognostic factor associated with a higher likelihood of long-term recovery from OCD?", a: "Good premorbid functioning, late onset of symptoms, and the presence of precipitating events." },
            { q: "Prognostic factor associated with a poorer long-term outcome in patients with OCD?", a: "Childhood onset, presence of tics, yields to compulsions completely, or severe delusional (absent) insight." },
            { q: "Long-term clinical outcome for the majority of patients appropriately treated for Panic Disorder?", a: "Significant improvement or complete remission, though up to 30% may experience long-term, episodic relapses." },
            { q: "Diagnosis for a 24-year-old student with a 7-month history of daily unremitting worry about grades, health, and finances, accompanied by severe muscle soreness and insomnia?", a: "Generalized Anxiety Disorder." },
            { q: "Diagnosis for a 30-year-old female presenting to the ER with chest pain, sweating, paresthesias, and a conviction that she is actively dying, with normal cardiac workup?", a: "Panic Disorder." },
            { q: "Diagnosis for a veteran who presents with intrusive nightmares of an explosion, avoids loud crowds, stays hypervigilant, and has felt emotionally numb for 6 months?", a: "Post-Traumatic Stress Disorder." },
            { q: "Diagnosis for a 19-year-old who spends 3 hours a day washing her hands until they bleed because she fears chemical contamination?", a: "Obsessive-Compulsive Disorder." },
            { q: "Diagnosis for a patient who develops intense anxiety, palpitations, and sweating exclusively when asked to give a speech in front of colleagues?", a: "Social Anxiety Disorder, performance-only subtype." },
            { q: "Diagnosis for a patient who refuses to leave her apartment because she is terrified she will have a medical emergency in public with no one to help her?", a: "Agoraphobia." },
            { q: "Diagnosis for a man who undergoes multiple unnecessary plastic surgeries because he is convinced his nose is asymmetrical, though it appears perfectly normal to others?", a: "Body Dysmorphic Disorder." },
            { q: "Diagnosis for a 9-year-old child who completely stops talking at school but speaks completely normally and fluidly at home with his parents?", a: "Selective Mutism." },
            { q: "Diagnosis for an 8-year-old child who experiences extreme, unremitting distress, vomiting, and refusal to sleep alone when separated from his primary caregiver?", a: "Separation Anxiety Disorder." },
            { q: "Diagnosis for a patient who presents with severe flashbacks, insomnia, and hyperarousal exactly two weeks after surviving a house fire?", a: "Acute Stress Disorder." },
            { q: "Diagnosis for a patient who develops severe anxiety, depressed mood, and occupational impairment two months after a difficult divorce, which resolves four months after the divorce is finalized?", a: "Adjustment Disorder with mixed anxiety and depressed mood." },
            { q: "Most common comorbid psychiatric condition found in individuals diagnosed with Generalized Anxiety Disorder?", a: "Major Depressive Disorder." },
            { q: "Most common comorbid conditions found in patients diagnosed with Panic Disorder?", a: "Agoraphobia, Major Depressive Disorder, and Substance Use Disorder." },
            { q: "Patients with Panic Disorder carry a significantly elevated lifetime risk for which tragic clinical outcome?", a: "Suicide attempts." },
            { q: "Most common comorbid condition that co-occurs with PTSD?", a: "Substance Use Disorder, specifically Alcohol Use Disorder." },
            { q: "Two most common comorbid psychiatric disorders seen in patients with Obsessive-Compulsive Disorder?", a: "Anxiety disorders and Major Depressive Disorder." },
            { q: "Psychiatric condition that is strongly comorbid with pediatric OCD, appearing in up to 30% of cases?", a: "Tic disorders or Tourette's Disorder." },
            { q: "Medical condition characterized by a paroxysmal supraventricular tachycardia that must always be ruled out during a panic disorder workup?", a: "Wolff-Parkinson-White syndrome." },
            { q: "Endocrine disorder caused by a pituitary adenoma that can manifest with neuropsychiatric symptoms mimicking severe anxiety and panic?", a: "Cushing's disease." },
            { q: "Neurological disorder characterized by focal seizures in which brain region that can mimic panic attacks with sudden fear and autonomic symptoms?", a: "Temporal lobe epilepsy." },
            { q: "Neurological autoantibody disorder that can present with acute, severe psychiatric symptoms, including profound anxiety, psychosis, and catatonia?", a: "Anti-NMDA receptor encephalitis." },
            { q: "Substance abuse state that can mimic GAD and panic, characterized by pupillary dilation, tachycardia, hypertension, and extreme alertness?", a: "Amphetamine or Cocaine intoxication." },
            { q: "Substance withdrawal state that can mimic a severe anxiety panic state, characterized by pupillary dilation, rhinorrhea, lacrimation, and piloerection?", a: "Opioid withdrawal." },
            { q: "Mechanism of action of Buspirone that explains why it lacks sedative and muscle relaxant properties?", a: "It lacks any modulating activity at the GABA receptor complex." },
            { q: "Why must Buspirone be taken continuously rather than as-needed (PRN)?", a: "It requires weeks of daily administration to downregulate presynaptic serotonin autoreceptors." },
            { q: "Primary Cytochrome P450 enzyme responsible for the metabolism of Buspirone?", a: "CYP3A4." },
            { q: "Co-administration of Buspirone with which dietary substance can significantly increase its plasma concentrations?", a: "Grapefruit juice." },
            { q: "Primary mechanism of action of Hydroxyzine in treating acute anxiety?", a: "Strong inverse agonism at peripheral and central histamine $\\text{H}_1$ receptors." },
            { q: "Molecular subunit of the $\\text{GABA}_\\text{A}$ receptor to which benzodiazepines bind to exert their anxiolytic effects?", a: "$\\alpha_2$ subunit." },
            { q: "Molecular subunit of the $\\text{GABA}_\\text{A}$ receptor to which benzodiazepines bind to exert their sedative and amnestic effects?", a: "$\\alpha_1$ subunit." },
            { q: "Active metabolite of Diazepam and Chlordiazepoxide that contributes to their exceptionally prolonged half-lives?", a: "Desmethyldiazepam." },
            { q: "Why are Lorazepam, Oxazepam, and Temazepam preferred in patients with hepatic failure or the elderly?", a: "They are metabolized solely via Phase II glucuronidation and do not accumulate." },
            { q: "Mechanism of action of Flumazenil?", a: "Competitive antagonist at the benzodiazepine binding site on the $\\text{GABA}_\\text{A}$ receptor complex." },
            { q: "Absolute contraindication for the use of Flumazenil in an unknown drug overdose?", a: "Chronic benzodiazepine dependence or co-ingestion of tricyclic antidepressants, due to high seizure risk." },
            { q: "Mechanism of action of Mirtazapine that leads to an increase in both serotonin and norepinephrine release?", a: "Antagonism of central presynaptic $\\alpha_2$ adrenergic autoreceptors and heteroreceptors." },
            { q: "Why does the sedating effect of Mirtazapine decrease as the dose is increased from 15mg to 45mg?", a: "Higher doses increase noradrenergic neurotransmission, which counteracts the antihistaminergic sedation." },
            { q: "Mechanism of action of Clomipramine?", a: "Strong inhibition of the serotonin transporter (SERT) and moderate inhibition of the norepinephrine transporter (NET)." },
            { q: "Primary side effect profile concern for Clomipramine due to its structural class?", a: "Severe anticholinergic, antihistaminergic, and anti-$\\alpha_1$ adrenergic side effects." },
            { q: "Mechanism of action of Prazosin in the treatment of PTSD?", a: "Central $\\alpha_1$ adrenergic receptor antagonist that blunts the overactive noradrenergic response during sleep." },
            { q: "Initial dosing instruction for Prazosin to mitigate its most common immediate side effect?", a: "Dose at bedtime to prevent orthostatic hypotension and first-dose syncope." },
            { q: "Mechanism of action of Vilazodone?", a: "Serotonin reuptake inhibitor combined with $\\text{$\\text{5-HT}$}_{1\\text{A}}$ receptor partial agonism." },
            { q: "Mechanism of action of Vortioxetine?", a: "Serotonin reuptake inhibitor combined with $\\text{$\\text{5-HT}$}_{1\\text{A}}$ agonism, $\\text{$\\text{5-HT}$}_{1\\text{B}}$ partial agonism, and $\\text{$\\text{5-HT}$}_{3}$/$\\text{$\\text{5-HT}$}_{7}$ antagonism." },
            { q: "SSRI with the longest half-life that does not require a slow taper when discontinued?", a: "Fluoxetine." },
            { q: "SSRI with the shortest half-life and no active metabolites, carrying the highest risk for severe discontinuation syndrome?", a: "Paroxetine." },
            { q: "Specific cardiac risk associated with high-dose Citalopram administration?", a: "Dose-dependent QTc prolongation." },
            { q: "Maximum recommended dose of Citalopram in patients over the age of 60?", a: "20 milligrams per day." },
            { q: "Primary mechanism of action of atypical antipsychotics when used as augmentation in treatment-resistant OCD?", a: "Serotonin $\\text{$\\text{5-HT}$}_{2\\text{A}}$ receptor antagonism combined with dopamine $\\text{D}_2$ receptor modulation." },
            { q: "Core behavioral therapy component of Exposure and Response Prevention (ERP) for OCD?", a: "Preventing the patient from performing compulsive rituals after exposure to an obsession." },
            { q: "Primary behavioral technique used in Prolonged Exposure (PE) therapy for PTSD?", a: "Repeatedly approaching safe but trauma-related situations that the patient has been avoiding." },
            { q: "Goal of Cognitive Processing Therapy (CPT) for PTSD?", a: "Identifying and challenging unhelpful, stuck thoughts related to the traumatic event." },
            { q: "Behavioral therapy modality considered first-line for the treatment of Trichotillomania?", a: "Habit Reversal Training." },
            { q: "Psychological defense mechanism where an individual manages anxiety by focusing purely on facts and cold logic rather than emotions?", a: "Intellectualization." },
            { q: "Psychological defense mechanism where an individual counteracts an unacceptable thought or behavior by performing a ritualistic action?", a: "Undoing." },
            { q: "Psychological defense mechanism where an unacceptable impulse is unconsciously transformed into its diametric opposite?", a: "Reaction Formation." },
            { q: "Psychological defense mechanism where an individual attributes their own unacknowledged, unacceptable impulses onto someone else?", a: "Projection." },
            { q: "Psychological defense mechanism where an individual channels unacceptable impulses into socially acceptable, productive activities?", a: "Sublimation." },
            { q: "Minimum duration of successful pharmacotherapy treatment before attempting to taper an antidepressant in a stable GAD patient?", a: "Six to twelve months." },
            { q: "Recommended rate of tapering for a patient discontinuing long-term benzodiazepine therapy to avoid severe withdrawal?", a: "Reduce the total daily dose by no more than 10% to 25% every one to two weeks." },
            { q: "Prognostic factor that strongly correlates with a poor long-term outcome in Obsessive-Compulsive Disorder?", a: "Early childhood onset, poor initial treatment response, and absent or delusional insight." },
            { q: "Percentage of patients with Panic Disorder who achieve complete long-term remission with appropriate treatment?", a: "Approximately 30% to 40%." },
            { q: "Medical diagnosis when a patient presents with severe obsessions and compulsions that began immediately following an ischemic stroke in the basal ganglia?", a: "Obsessive-Compulsive Disorder secondary to a general medical condition." },
            { q: "Clinical sign that differentiates severe Serotonin Syndrome from Neuroleptic Malignant Syndrome (NMS)?", a: "Hyperreflexia and spontaneous clonus are prominent in Serotonin Syndrome, whereas lead-pipe rigidity is prominent in NMS." },
            { q: "Immediate first-line intervention for a patient presenting with acute, severe benzodiazepine withdrawal?", a: "Re-initiation of a long-acting benzodiazepine followed by a structured, gradual taper." },
            { q: "Term used to describe panic attacks that do not meet the full diagnostic criteria of at least four somatic or cognitive symptoms?", a: "Limited-symptom panic attacks." },
            { q: "Specifier applied when an individual meets all criteria for PTSD but also displays persistent feelings of unreality or detachment from their own body?", a: "PTSD with dissociative symptoms." },
            { q: "Criteria required to apply the \"delayed expression\" specifier to a PTSD diagnosis?", a: "Full diagnostic criteria are not met until at least 6 months after the traumatic event." }
          ]
        },
{
          section: 'Psychiatry',
          topic: "Substance use disorders — alcohol, opioids, stimulants",
          icon: 'brain',
          cards: [
            { q: "Minimum number of criteria required to diagnose a Substance Use Disorder (SUD) under DSM-5-TR?", a: "Two criteria met within a 12-month period." },
            { q: "Timeframe required to assess DSM-5-TR criteria for Substance Use Disorders?", a: "Within a 12-month period." },
            { q: "Number of criteria required to classify a Substance Use Disorder as mild?", a: "Two to three criteria." },
            { q: "Number of criteria required to classify a Substance Use Disorder as moderate?", a: "Four to five criteria." },
            { q: "Number of criteria required to classify a Substance Use Disorder as severe?", a: "Six or more criteria." },
            { q: "Definition of \"Early Remission\" in DSM-5-TR Substance Use Disorders?", a: "No criteria met (except craving) for at least 3 months but less than 12 months." },
            { q: "Definition of \"Sustained Remission\" in DSM-5-TR Substance Use Disorders?", a: "No criteria met (except craving) for 12 months or longer." },
            { q: "Diagnostic requirement for Alcohol Use Disorder according to DSM-5-TR?", a: "A problematic pattern of alcohol use leading to clinically significant impairment or distress." },
            { q: "Neurological receptor system primarily potentiated by acute alcohol consumption?", a: "$GABA_A$ receptors." },
            { q: "Neurological receptor system primarily inhibited by acute alcohol consumption?", a: "NMDA glutamate receptors." },
            { q: "Definition of legal intoxication for driving in most United States jurisdictions?", a: "Blood Alcohol Concentration (BAC) of 0.08% or higher." },
            { q: "Clinical signs of acute mild-to-moderate alcohol intoxication?", a: "Slurred speech, incoordination, unsteady gait, nystagmus, and flushed face." },
            { q: "Classic ocular sign of acute alcohol intoxication or early withdrawal?", a: "Horizontal gaze nystagmus." },
            { q: "Screening tool for alcohol use disorder utilizing the acronym CAGE?", a: "Cut down, Annoyed, Guilty, Eye-opener questionnaire." },
            { q: "Single most sensitive lab marker for identifying chronic heavy alcohol consumption?", a: "Carbohydrate-Deficient Transferrin (CDT)." },
            { q: "Hematologic abnormality frequently seen in chronic alcoholics due to direct toxicity or dietary deficiency?", a: "Macrocytosis (elevated MCV)." },
            { q: "Expected ratio of AST to ALT in patients with alcohol-induced liver injury?", a: "AST to ALT ratio greater than 2:1." },
            { q: "Cellular adaptation responsible for alcohol withdrawal symptoms upon cessation?", a: "Downregulation of $GABA_A$ receptors and upregulation of NMDA receptors." },
            { q: "Typical onset time of minor alcohol withdrawal symptoms following the last drink?", a: "6 to 24 hours." },
            { q: "Typical onset time of alcohol withdrawal seizures?", a: "12 to 48 hours." },
            { q: "Character of seizures typically observed during alcohol withdrawal?", a: "Generalized tonic-clonic seizures." },
            { q: "Typical onset time of alcoholic hallucinosis following cessation?", a: "12 to 48 hours." },
            { q: "Primary feature distinguishing alcoholic hallucinosis from Delirium Tremens?", a: "Intact sensorium and stable vital signs in alcoholic hallucinosis." },
            { q: "Typical onset time of Delirium Tremens (DTs) after alcohol cessation?", a: "48 to 96 hours." },
            { q: "Core clinical triad characterizing Delirium Tremens?", a: "Delirium, autonomic instability, and severe agitation." },
            { q: "Standardized clinical scale used to objectively assess and monitor alcohol withdrawal severity?", a: "Clinical Institute Withdrawal Assessment for Alcohol (CIWA-Ar)." },
            { q: "Gold-standard medication class used to manage acute alcohol withdrawal?", a: "Benzodiazepines." },
            { q: "Preferred benzodiazepines for alcohol withdrawal in patients with severe hepatic impairment?", a: "Lorazepam, Oxazepam, and Temazepam." },
            { q: "Rationale for using Lorazepam or Oxazepam in patients with liver failure?", a: "They undergo direct glucuronidation without active hepatic metabolites." },
            { q: "Long-acting benzodiazepines preferred for alcohol withdrawal protocols due to self-tapering effects?", a: "Chlordiazepoxide and Diazepam." },
            { q: "Most common cause of death in patients experiencing untreated Delirium Tremens?", a: "Cardiovascular collapse or hyperthermia." },
            { q: "Acute neurological syndrome caused by thiamine (Vitamin B1) deficiency?", a: "Wernicke's encephalopathy." },
            { q: "Classic clinical triad of Wernicke's encephalopathy?", a: "Encephalopathy (confusion), oculomotor dysfunction (nystagmus/ophthalmoplegia), and gait ataxia." },
            { q: "Irreversible chronic neurocognitive disorder that can follow Wernicke's encephalopathy?", a: "Korsakoff's syndrome." },
            { q: "Hallmark cognitive deficit and compensatory behavioral feature of Korsakoff's syndrome?", a: "Anterograde amnesia and confabulation." },
            { q: "Specific neuroanatomical structures characteristically damaged in Wernicke-Korsakoff syndrome?", a: "Mammillary bodies and medial dorsal nuclei of the thalamus." },
            { q: "Critical sequence rule when administering glucose and thiamine to an alcoholic patient?", a: "Administer thiamine before or concurrently with glucose to prevent worsening encephalopathy." },
            { q: "Mechanism of action of Naltrexone in treating Alcohol Use Disorder?", a: "$\\mu$-opioid receptor antagonist that reduces the reinforcing effects and cravings of alcohol." },
            { q: "Absolute contraindication for initiating Naltrexone therapy?", a: "Acute hepatitis, liver failure, or current opioid use." },
            { q: "Mechanism of action of Acamprosate?", a: "Modulates glutamate neurotransmission at NMDA receptors to restore GABA/glutamate balance." },
            { q: "Primary contraindication for the use of Acamprosate?", a: "Severe renal impairment (Creatinine Clearance less than 30 mL/min)." },
            { q: "Mechanism of action of Disulfiram?", a: "Irreversibly inhibits aldehyde dehydrogenase, causing accumulation of acetaldehyde." },
            { q: "Classic physical symptoms of a Disulfiram-alcohol reaction?", a: "Flushing, tachycardia, hypotension, nausea, and vomiting." },
            { q: "Second-line medication for AUD that is an $GABA_B$ receptor agonist used to reduce cravings?", a: "Baclofen." },
            { q: "Anticonvulsant medication used off-label to reduce alcohol cravings and heavy drinking days?", a: "Topiramate." },
            { q: "Primary receptor subtype responsible for the analgesic and euphoric effects of opioids?", a: "$\\mu$-opioid receptor." },
            { q: "Triad of clinical signs strongly diagnostic of acute opioid overdose?", a: "Respiratory depression, miosis (pinpoint pupils), and altered mental status." },
            { q: "Exception to the rule of pupil constriction in opioid overdose due to severe hypoxia or specific agent?", a: "Meperidine overdose (causes mydriasis)." },
            { q: "Immediate, life-saving antidote for acute opioid overdose with respiratory depression?", a: "Naloxone." },
            { q: "Mechanism of action of Naloxone?", a: "Short-acting competitive $\\mu$-opioid receptor antagonist." },
            { q: "Cardinal objective signs of acute opioid withdrawal?", a: "Mydriasis, piloerection, rhinorrhea, lacrimation, and hyperactive bowel sounds." },
            { q: "Expected timeline for peak withdrawal symptoms from short-acting opioids like heroin?", a: "36 to 72 hours." },
            { q: "Expected timeline for peak withdrawal symptoms from long-acting opioids like methadone?", a: "72 to 96 hours." },
            { q: "Standardized objective assessment scale used to quantify the severity of opioid withdrawal?", a: "Clinical Opiate Withdrawal Scale (COWS)." },
            { q: "Non-opioid $\\alpha_2$ adrenergic agonist used to manage autonomic symptoms of opioid withdrawal?", a: "Clonidine or Lofexidine." },
            { q: "Mechanism of action of Methadone in Opioid Use Disorder maintenance?", a: "Long-acting full $\\mu$-opioid receptor agonist." },
            { q: "Essential cardiac screening required for patients on high-dose Methadone therapy?", a: "Electrocardiogram (ECG) to monitor for QTc prolongation." },
            { q: "Regulatory restriction unique to Methadone prescription for Opioid Use Disorder in the US?", a: "Must be dispensed through a federally regulated Opioid Treatment Program (OTP)." },
            { q: "Mechanism of action of Buprenorphine?", a: "Partial $\\mu$-opioid receptor agonist and $\\kappa$-opioid receptor antagonist." },
            { q: "Precaution required before administering the first dose of Buprenorphine to a patient?", a: "The patient must be in mild-to-moderate objective opioid withdrawal to avoid precipitated withdrawal." },
            { q: "Rationale for combining Buprenorphine with Naloxone in Suboxone?", a: "To prevent intravenous abuse, as Naloxone blocks effects if injected but has low oral bioavailability." },
            { q: "Form of Naltrexone preferred for Opioid Use Disorder maintenance to ensure compliance?", a: "Monthly intramuscular depot injection (Vivitrol)." },
            { q: "Minimum duration a patient must be completely opioid-free before initiating Naltrexone?", a: "7 to 10 days to avoid severe precipitated withdrawal." },
            { q: "Primary mechanism of action of Cocaine at the synaptic cleft?", a: "Blocks the reuptake of dopamine, norepinephrine, and serotonin." },
            { q: "Primary mechanism of action of Amphetamines at the synaptic cleft?", a: "Stimulates the release of dopamine and norepinephrine and inhibits their reuptake." },
            { q: "Cardiovascular signs of acute stimulant intoxication?", a: "Tachycardia, hypertension, cardiac arrhythmias, and pupillary dilation (mydriasis)." },
            { q: "Psychological symptoms commonly seen in severe stimulant intoxication?", a: "Paranoia, auditory/visual hallucinations, hypervigilance, and grandiosity." },
            { q: "Name of the tactile hallucination where patients feel bugs crawling under their skin?", a: "Formication (\"cocaine bugs\")." },
            { q: "Life-threatening complication of severe stimulant overdose characterized by muscle breakdown?", a: "Rhabdomyolysis." },
            { q: "Drug class of choice for treating acute agitation and hypertension in cocaine intoxication?", a: "Benzodiazepines." },
            { q: "Medication class strictly contraindicated in acute cocaine intoxication due to risk of unopposed $\\alpha$-stimulation?", a: "Pure $\\beta$-blocker (e.g., Propranolol)." },
            { q: "Severe physical vascular complication of chronic intranasal cocaine use?", a: "Nasal septal perforation." },
            { q: "Unique dermatological and dental presentation associated with chronic methamphetamine use?", a: "Skin excoriations (from picking) and severe dental caries (\"meth mouth\")." },
            { q: "Core psychological feature characterizing the \"crash\" phase of stimulant withdrawal?", a: "Severe dysphoria, anhedonia, and vivid, unpleasant dreams." },
            { q: "Sleep disturbances typically observed during acute stimulant withdrawal?", a: "Hypersomnia followed by insomnia." },
            { q: "Changes in appetite associated with stimulant withdrawal?", a: "Hyperphagia (increased appetite)." },
            { q: "Risk profile peak during acute stimulant withdrawal that clinicians must monitor?", a: "Severe suicidal ideation and behavior." },
            { q: "FDA-approved maintenance medication for Stimulant Use Disorder?", a: "There are currently no FDA-approved medications for Stimulant Use Disorder." },
            { q: "Most effective evidence-based psychosocial interventions for Stimulant Use Disorder?", a: "Contingency management and Cognitive Behavioral Therapy (CBT)." },
            { q: "Psychiatric condition that must be differentiated from stimulant-induced psychosis?", a: "Schizophrenia or Bipolar I Disorder with psychotic features." },
            { q: "Distinguishing feature of substance-induced psychosis versus primary psychotic disorders?", a: "Resolution of psychotic symptoms within weeks of substance cessation." },
            { q: "Most common comorbid psychiatric disorder cluster associated with Substance Use Disorders?", a: "Antisocial Personality Disorder and Borderline Personality Disorder." },
            { q: "Term used when a patient has both a diagnosed Substance Use Disorder and a comorbid mental health disorder?", a: "Dual Diagnosis (or Co-occurring Disorders)." },
            { q: "First-line treatment for a pregnant patient with severe Opioid Use Disorder?", a: "Opioid Agonist Therapy with Methadone or Buprenorphine monotherapy." },
            { q: "Risk associated with abrupt opioid detoxification during pregnancy?", a: "Fetal distress, miscarriage, or preterm labor." },
            { q: "Neonatal condition resulting from maternal opioid use during pregnancy?", a: "Neonatal Abstinence Syndrome (NAS)." },
            { q: "First-line medical management for a neonate with severe Neonatal Abstinence Syndrome?", a: "Morphine or Methadone solution." },
            { q: "Classic triad of symptoms seen in Fetal Alcohol Syndrome (FAS)?", a: "Smooth philtrum, thin upper lip, and short palpebral fissures." },
            { q: "Fatal combination product formed when alcohol and cocaine are consumed concurrently?", a: "Cocaethylene." },
            { q: "Clinical significance of cocaethylene formation in the body?", a: "Longer half-life than cocaine and higher cardiotoxicity." },
            { q: "Neurotransmitter storm responsible for the life-threatening hyperthermia in MDMA (Ecstasy) overdose?", a: "Serotonin toxicity (Serotonin Syndrome)." },
            { q: "Severe electrolyte abnormality frequently triggered by MDMA use due to excessive water intake and SIADH?", a: "Hyponatremia." },
            { q: "Principal receptor target altered by chronic stimulant use leading to anhedonia during withdrawal?", a: "Downregulation of postsynaptic Dopamine $\\text{D}_2$ receptors." },
            { q: "Medication used off-label for amphetamine use disorder due to its dual action on norepinephrine and dopamine?", a: "Bupropion." },
            { q: "Medication combination that showed efficacy for methamphetamine use disorder in recent clinical trials?", a: "Injectable Naltrexone plus oral Bupropion." },
            { q: "Neurological pathway primarily responsible for the rewarding and addictive properties of all drugs of abuse?", a: "Mesolimbic dopamine pathway." },
            { q: "Specific anatomical origin and termination points of the mesolimbic dopamine pathway?", a: "Ventral Tegmental Area (VTA) projecting to the Nucleus Accumbens." },
            { q: "Patient with history of AUD presents with confusion, horizontal nystagmus, and wide-based gait. Diagnosis?", a: "Wernicke's Encephalopathy." },
            { q: "Patient presents with severe abdominal cramps, diarrhea, dilated pupils, and gooseflesh skin. Diagnosis?", a: "Opioid Withdrawal." },
            { q: "Patient presents with pinpoint pupils, respiratory rate of 4 breaths per minute, and bradycardia. Diagnosis?", a: "Opioid Intoxication (Overdose)." },
            { q: "Patient presents with tactile hallucinations, extreme paranoia, dilated pupils, and a blood pressure of 180/110 mmHg. Diagnosis?", a: "Stimulant Intoxication." },
            { q: "Patient 3 days post-appendectomy develops tremors, visual hallucinations, a heart rate of 120 bpm, and disorientation. Diagnosis?", a: "Delirium Tremens." },
            { q: "Patient presents with profound lethargy, intense craving, hyperphagia, and vivid nightmares after stopping a drug. Diagnosis?", a: "Stimulant Withdrawal." },
            { q: "Opioid maintenance therapy drug that carries a significant risk of respiratory depression if taken with alcohol?", a: "Methadone." },
            { q: "Screening questionnaire for alcohol use during pregnancy?", a: "T-ACE or TWEAK questionnaire." },
            { q: "Definitive diagnostic test to confirm recent substance ingestion in an emergency setting?", a: "Urine Drug Screen (UDS)." },
            { q: "Substance whose intoxication routinely causes horizontal, vertical, and rotary nystagmus?", a: "Phencyclidine (PCP)." },
            { q: "Laboratory finding that helps differentiate alcoholic ketoacidosis from diabetic ketoacidosis?", a: "Normal or only mildly elevated blood glucose levels in alcoholic ketoacidosis." },
            { q: "Definitive therapy for alcohol-induced cardiomyopathy?", a: "Complete abstinence from alcohol." },
            { q: "Common cause of death in acute severe sedative-hypnotic withdrawal?", a: "Status epilepticus." },
            { q: "Primary psychological defense mechanism used by individuals with severe Substance Use Disorders?", a: "Denial." },
            { q: "Stage of change where a patient acknowledges a problem exists but is not yet ready to commit to action?", a: "Contemplation stage." },
            { q: "Stage of change where a patient has no intention of changing behavior because they do not see a problem?", a: "Precontemplation stage." },
            { q: "Stage of change where a patient actively modifies their behavior and environment to overcome the addiction?", a: "Action stage." },
            { q: "Evidence-based counseling technique used to move patients through the stages of change?", a: "Motivational Interviewing." },
            { q: "Core spirit or pillar of Motivational Interviewing?", a: "Collaboration, Acceptance, Compassion, and Evocation." },
            { q: "Electrolyte replacement that must always accompany Thiamine in alcohol withdrawal management?", a: "Magnesium." },
            { q: "Rationale for checking magnesium levels in alcohol withdrawal?", a: "Hypomagnesemia causes resistance to thiamine therapy and lowers the seizure threshold." },
            { q: "Characteristic sleep architecture change seen in chronic alcoholics?", a: "Decreased REM sleep and disrupted slow-wave (deep) sleep." },
            { q: "Pupillary presentation during acute benzodiazepine overdose without co-ingestions?", a: "Normal or slightly dilated pupils (unlike pinpoint pupils of opioids)." },
            { q: "Primary mechanism of death in acute cocaine-induced myocardial infarction?", a: "Coronary artery vasospasm and accelerated platelet aggregation." },
            { q: "Long-term psychiatric syndrome characterized by persistent motivational deficits following chronic substance abuse?", a: "Amotivational syndrome." },
            { q: "Class of antidepressant medications that should be avoided in patients actively abusing alcohol or stimulants due to hypertensive risks?", a: "Monoamine Oxidase Inhibitors (MAOIs)." },
            { q: "Over-the-counter medication that can cause false-positive results for amphetamines on standard urine drug screens?", a: "Pseudoephedrine (or selegiline, bupropion)." },
            { q: "Opioid analgesic that does not show up on standard routine urine drug screens and requires a specific assay?", a: "Fentanyl (or Oxycodone/Methadone)." },
            { q: "Main structural brain change observed in structural neuroimaging of chronic alcoholics?", a: "Cerebral atrophy and ventricular enlargement." },
            { q: "Specific legal exception to patient confidentiality regarding Substance Use Disorder treatment records in the US?", a: "42 CFR Part 2 (requires explicit written consent, stricter than standard HIPAA)." },
            { q: "Phenomenon where a drug user requires larger doses to achieve the same initial effect?", a: "Tolerance." },
            { q: "Phenomenon where a drug user experiences physiological symptoms when a substance is abruptly discontinued?", a: "Withdrawal." },
            { q: "Primary mechanism of action of synthetic cathinones (\"bath salts\")?", a: "Inhibition of monoamine reuptake and promotion of dopamine release, similar to amphetamines." },
            { q: "Major clinical challenge when treating acute pain in a patient currently maintained on Suboxone?", a: "High $\\mu$-affinity of buprenorphine blocks other opioid analgesics from binding." },
            { q: "Preferred non-opioid medication class for managing acute somatic pain in patients with OUD?", a: "NSAIDs or Acetaminophen." },
            { q: "Name of the safe, supervised facility programs designed to reduce overdose deaths and infections?", a: "Harm Reduction Programs (e.g., Needle Exchange Programs)." },
            { q: "Alcohol withdrawal symptom that can present even while the patient's blood alcohol level is actively falling but still elevated?", a: "Tremor (or withdrawal seizures)." },
            { q: "Major endocrine abnormality caused by chronic opioid use due to suppression of the HPA axis?", a: "Opioid-Induced Hypogonadism." },
            { q: "Clinical manifestations of opioid-induced hypogonadism in male patients?", a: "Decreased libido, erectile dysfunction, and fatigue." },
            { q: "Clinical manifestations of opioid-induced hypogonadism in female patients?", a: "Amenorrhea or irregular menses." },
            { q: "Primary neurological track damaged in Marchiafava-Bignami disease associated with chronic alcohol use?", a: "Corpus callosum." },
            { q: "Characteristic clinical presentation of Marchiafava-Bignami disease?", a: "Dementia, spasticity, dysarthria, and gait disorders." },
            { q: "Diagnostic modality of choice to confirm Marchiafava-Bignami disease?", a: "Brain MRI showing symmetric lesions in the corpus callosum." },
            { q: "Major pulmonary risk associated with intravenous drug use of stimulants or opioids?", a: "Septic pulmonary emboli (secondary to infective endocarditis)." },
            { q: "Most common cardiac valve affected by intravenous drug use?", a: "Tricuspid valve." },
            { q: "Most common causative organism of infective endocarditis in intravenous drug users?", a: "Staphylococcus aureus." },
            { q: "Diagnostic screening procedure that should be performed routinely for any patient presenting with injection drug use history?", a: "Hepatitis C and HIV serology." },
            { q: "Primary psychological driver targeted during Cognitive Behavioral Therapy for substance use disorders?", a: "Identification and modification of maladaptive thoughts and triggers that lead to relapse." },
            { q: "Medication used to treat benzodiazepine overdose that can precipitate life-threatening seizures in chronic users?", a: "Flumazenil." },
            { q: "Active metabolite of choice when treating alcohol withdrawal in a patient with acute pancreatitis?", a: "Lorazepam (due to exclusive extrahepatic glucuronidation)." },
            { q: "Why is Diazepam often preferred over Lorazepam in a structurally normal liver during alcohol withdrawal?", a: "It has active metabolites ($nordiazepam$) providing a long, smooth self-tapering effect." },
            { q: "Impact of chronic alcohol consumption on the minimum alveolar concentration (MAC) of volatile anesthetics?", a: "Increases the MAC, requiring higher doses of anesthesia due to cross-tolerance." },
            { q: "Impact of acute alcohol intoxication on the minimum alveolar concentration (MAC) of volatile anesthetics?", a: "Decreases the MAC, requiring lower doses of anesthesia due to synergistic CNS depression." },
            { q: "The specific $GABA_A$ receptor subunit configuration targeted by alcohol that mediates its anxiolytic effects?", a: "$\\alpha_1$ and $\\alpha$-5 subunits." },
            { q: "Why does the combination of Buprenorphine and Naloxone ($Suboxone$) not cause precipitated withdrawal when swallowed normally?", a: "Naloxone undergoes extensive first-pass hepatic metabolism and has negligible oral bioavailability." },
            { q: "Expected pupil size changes if a patient co-ingests toxic doses of cocaine and heroin (\"speedball\")?", a: "Variable or normal pupillary size due to competing miotic and mydriatic effects." },
            { q: "Neurological receptor responsible for the development of rapid tolerance (tachyphylaxis) in chronic stimulant use?", a: "Downregulation and internalization of post-synaptic Dopamine $D_1$ and $D_2$ receptors." },
            { q: "Pathophysiological mechanism behind \"cocaine-induced chest pain\" in a young patient with normal coronary arteries?", a: "$\\alpha_1$ adrenergic receptor stimulation causing severe coronary artery vasospasm." },
            { q: "Initial choice of antihypertensive agent if a patient with cocaine intoxication remains hypertensive after maximizing benzodiazepines?", a: "Phentolamine (a pure $\\alpha$-adrenergic antagonist)." },
            { q: "Why are pure $\\beta$-blocker like Propranolol contraindicated in cocaine-induced acute coronary syndrome?", a: "They leave $\\alpha_1$ receptors unopposed, causing catastrophic vasoconstriction and coronary ischemia." },
            { q: "Most common structural cardiac anomaly found in long-term chronic methamphetamine abusers?", a: "Dilated cardiomyopathy." },
            { q: "Main arterial complication associated with chronic, heavy amphetamine use that can cause acute stroke in young adults?", a: "Necrotizing angiitis (cerebral vasculitis)." },
            { q: "Renal pathology directly caused by severe stimulant-induced rhabdomyolysis?", a: "Acute tubular necrosis due to myoglobinuria." },
            { q: "Gastrointestinal complication of acute cocaine use caused by focal mesenteric ischemia?", a: "Bowel ischemia or intestinal perforation." },
            { q: "Demographic group with the highest statistically verified rate of successful completion of suicide during substance withdrawal?", a: "Middle-aged males with concurrent Alcohol Use Disorder." },
            { q: "Federal schedule classification of Cocaine under the US Controlled Substances Act?", a: "Schedule II (due to its high abuse potential but accepted medical use as a local anesthetic)." },
            { q: "Federal schedule classification of Heroin under the US Controlled Substances Act?", a: "Schedule I (high abuse potential with no currently accepted medical use)." },
            { q: "Federal schedule classification of Methadone under the US Controlled Substances Act?", a: "Schedule II." },
            { q: "Federal schedule classification of Buprenorphine under the US Controlled Substances Act?", a: "Schedule III." },
            { q: "Medical legal requirement mandated by the DATA 2000 act for physicians prescribing Buprenorphine for OUD (historically referred to as)?", a: "The X-Waiver (note: federally removed in recent years, but historically heavily tested)." },
            { q: "Primary long-term neurodevelopmental deficit seen in children exposed to chronic intrauterine cocaine?", a: "Deficits in executive functioning, emotional regulation, and attention span." },
            { q: "Primary obstetric complication associated with acute maternal cocaine use during the third trimester?", a: "Placental abruption due to acute hypertensive spikes." },
            { q: "Preferred screening questionnaire specifically validated for detecting risky alcohol use in geriatric populations?", a: "Short Michigan Alcoholism Screening Test - Geriatric Version (SMAST-G)." },
            { q: "Why do geriatric patients achieve a higher Blood Alcohol Concentration (BAC) than younger peers with the same amount of alcohol?", a: "Decrease in total body water and decline in gastric alcohol dehydrogenase activity." },
            { q: "First-line non-pharmacological behavioral therapy used to manage mild Neonatal Abstinence Syndrome (NAS)?", a: "Rooming-in, swaddling, and low-stimulus environments." },
            { q: "Substance intoxication that uniquely mimics acute stimulant intoxication but is characterized by prominent vertical nystagmus and severe violence?", a: "Phencyclidine (PCP) intoxication." },
            { q: "Over-the-counter cough suppressant that can cause a false-positive result for PCP on a standard urine drug screen?", a: "Dextromethorphan." },
            { q: "Common prescription antidepressant that can cause a false-positive result for amphetamines on a routine urine drug screen?", a: "Bupropion." },
            { q: "Common fluoroquinolone antibiotic that can cause a false-positive result for opiates on a standard urine drug screen?", a: "Levofloxacin (or Ofloxacin)." },
            { q: "Why does a standard routine urine drug screen often return negative in a patient with a confirmed acute Fentanyl overdose?", a: "Standard screens test for morphine metabolites, whereas synthetic opioids require a specialized gas chromatography-mass spectrometry assay." },
            { q: "Life-threatening cardiovascular complication of utilizing old-generation antipsychotics to treat cocaine-induced psychosis?", a: "Prolongation of the QTc interval leading to Torsades de Pointes." },
            { q: "First-line pharmacological management for a patient presenting with an acute, unstable aortic dissection secondary to cocaine use?", a: "Intravenous Sodium Nitroprusside or Phentolamine combined with Benzodiazepines." },
            { q: "Preferred alternative medication for acute opioid withdrawal if a patient develops severe bradycardia or hypotension from Clonidine?", a: "Oral Methadone or Buprenorphine induction (if appropriate) or supportive symptomatic medications like Loperamide and Acetaminophen." },
            { q: "Clinical phenomenon where an alcohol withdrawal patient's tremor worsens drastically during active movement or targeted tasks?", a: "Intention tremor secondary to chronic alcohol-induced cerebellar degeneration." },
            { q: "Specific region of the cerebellum that undergoes selective atrophy in chronic, heavy alcohol users?", a: "The anterior vermis of the cerebellum." },
            { q: "Evidence-based behavioral management strategy that provides tangible rewards (e.g., vouchers) for verified negative drug screens?", a: "Contingency Management." },
            { q: "Primary objective of the \"Harm Reduction\" model of addiction treatment?", a: "Minimizing the negative health and social consequences of substance use without strictly requiring immediate total abstinence." },
            { q: "Standard peer-led, 12-step recovery program utilized worldwide for Alcohol Use Disorder support?", a: "Alcoholics Anonymous (AA)." },
            { q: "Core psychological concept of 12-step programs regarding control over addiction?", a: "Admission of powerlessness over the substance and surrender to a higher power or group structure." },
            { q: "Mandatory reporting requirement for a medical student who suspects a resident or attending physician is practicing while acutely intoxicated?", a: "Reporting directly to the hospital’s Physician Health Program (PHP) or the state medical board to ensure patient safety." },
            { q: "Genetic polymorphism linked to a significantly decreased risk of developing Alcohol Use Disorder due to severe flushing reactions?", a: "Homozygous $ALDH2*2$ allele mutation (inactive aldehyde dehydrogenase)." },
            { q: "Specific brain region responsible for the intense cue-induced cravings and relapse vulnerability seen in chronic substance users?", a: "The basolateral amygdala and prefrontal cortex." },
            { q: "Neurotransmitters whose depletion is responsible for the profound \"washed-out\" lethargy and depression following a multi-day methamphetamine binge?", a: "Total depletion of central intracellular Dopamine and Serotonin stores." },
            { q: "Structural adaptation in cardiac tissue directly responsible for sudden cardiac death in chronic cocaine users without an acute myocardial infarction?", a: "Focal myocardial fibrosis and contraction band necrosis." },
            { q: "Patient with severe AUD presents with vomiting, a high anion gap metabolic acidosis, but a normal or low serum glucose level. Diagnosis?", a: "Alcoholic Ketoacidosis (AKA)." },
            { q: "Primary pathophysiological driver of Alcoholic Ketoacidosis?", a: "Glycogen depletion combined with a high NADH/NAD+ ratio that shifts metabolism toward ketone body production." },
            { q: "Immediate initial medical treatment required for a patient in acute Alcoholic Ketoacidosis?", a: "Intravenous infusion of normal saline and dextrose (glucose) without the immediate need for insulin." },
            { q: "Patient with a history of intravenous drug use presents with acute lower back pain, high fever, and focal spinal tenderness. Diagnosis?", a: "Spinal Epidural Abscess." },
            { q: "Immediate diagnostic modality of choice for a suspected spinal epidural abscess in an injection drug user?", a: "Emergency MRI of the spine with gadolinium contrast." },
            { q: "Chronic stimulant user presents with severe, diffuse abdominal pain out of proportion to physical exam findings following an intense binge. Diagnosis?", a: "Acute mesenteric ischemia secondary to cocaine-induced vasoconstriction." }
          ]
        },
{
          section: 'Psychiatry',
          topic: "Personality disorders",
          icon: 'brain',
          cards: [
            { q: "What is the core definition of a personality disorder according to the DSM-5-TR?", a: "An enduring pattern of inner experience and behavior that deviates markedly from cultural expectations, is pervasive and inflexible, and leads to distress or impairment." },
            { q: "At what developmental stage must the features of a personality disorder typically manifest?", a: "They must trace back at least to adolescence or early adulthood." },
            { q: "Why can a personality disorder generally not be diagnosed before the age of 18?", a: "Personality traits are still developing and may represent transient developmental phases." },
            { q: "What is the single exception allowing a personality disorder diagnosis in individuals under 18?", a: "The traits must be present for at least one year, and it cannot be Antisocial Personality Disorder." },
            { q: "What does it mean for a personality disorder to be \"ego-syntonic\"?", a: "The individual perceives their behavior as natural, correct, and acceptable, rather than viewing it as a problem." },
            { q: "What does it mean for a condition to be \"ego-dystonic\"?", a: "The symptoms are perceived by the individual as unacceptable, alien, and inconsistent with their self-concept." },
            { q: "How do defense mechanisms in personality disorders differ from those in acute Axis I disorders?", a: "They are chronically deployed, deeply ingrained, and serve as the individual's primary way of navigating the world." },
            { q: "Which three personality disorders comprise Cluster A?", a: "Paranoid, Schizoid, and Schizotypal personality disorders." },
            { q: "What is the overarching descriptor commonly used for Cluster A disorders?", a: "Odd or eccentric." },
            { q: "Which four personality disorders comprise Cluster B?", a: "Antisocial, Borderline, Histrionic, and Narcissistic personality disorders." },
            { q: "What is the overarching descriptor commonly used for Cluster B disorders?", a: "Dramatic, emotional, or erratic." },
            { q: "Which three personality disorders comprise Cluster C?", a: "Avoidant, Dependent, and Obsessive-Compulsive personality disorders." },
            { q: "What is the overarching descriptor commonly used for Cluster C disorders?", a: "Anxious or fearful." },
            { q: "What diagnostic category is used when a patient meets general criteria for a personality disorder but not for a specific cluster?", a: "Other Specified or Unspecified Personality Disorder." },
            { q: "What is the central feature of Paranoid Personality Disorder?", a: "A pervasive, unjustified distrust and suspiciousness of others such that their motives are interpreted as malevolent." },
            { q: "How does a patient with Paranoid Personality Disorder view benign remarks or events?", a: "They hidden demeaning or threatening meanings into benign remarks or events." },
            { q: "How do patients with Paranoid Personality Disorder typically handle perceived slights or injuries?", a: "They persistently bear grudges and are unforgiving of insults or injuries." },
            { q: "What is the PPD patient's typical attitude regarding the fidelity of their spouse or sexual partner?", a: "They harbor recurrent, unjustified suspicions regarding the fidelity of their partner." },
            { q: "Why do individuals with Paranoid Personality Disorder reluctantly confide in others?", a: "They fear the information will be used maliciously against them." },
            { q: "What distinguishes Paranoid Personality Disorder from Schizophrenia?", a: "PPD lacks fixed, unshakeable delusions, hallucinations, and formal thought disorder." },
            { q: "Which defense mechanism is most prominently utilized by individuals with Paranoid Personality Disorder?", a: "Projection, where they attribute their own unacknowledged hostile feelings to others." },
            { q: "What is the primary psychological barrier to treating a patient with Paranoid Personality Disorder?", a: "Their profound mistrust makes establishing a therapeutic alliance exceptionally difficult." },
            { q: "What is the core characteristic of Schizoid Personality Disorder?", a: "A pervasive pattern of detachment from social relationships and a restricted range of emotional expression." },
            { q: "How do individuals with Schizoid Personality Disorder view close relationships, including being part of a family?", a: "They neither desire nor enjoy close relationships." },
            { q: "What type of activities do individuals with Schizoid Personality Disorder almost always choose?", a: "Solitary activities." },
            { q: "How do individuals with Schizoid Personality Disorder typically respond to praise or criticism?", a: "They appear indifferent to both praise and criticism from others." },
            { q: "What is the typical sexual history or interest level of a person with Schizoid Personality Disorder?", a: "They have little, if any, interest in having sexual experiences with another person." },
            { q: "How is the affect of a patient with Schizoid Personality Disorder usually described?", a: "Emotional coldness, detachment, or flattened affectivity." },
            { q: "What distinguishes Schizoid Personality Disorder from Avoidant Personality Disorder?", a: "Schizoid individuals prefer isolation, whereas Avoidant individuals desire relationships but fear rejection." },
            { q: "What distinguishes Schizoid Personality Disorder from Schizotypal Personality Disorder?", a: "Schizoid lacks the cognitive, perceptual distortions, and eccentricities seen in Schizotypal." },
            { q: "What is the definitive presentation of Schizotypal Personality Disorder?", a: "A pattern of acute discomfort in close relationships, cognitive or perceptual distortions, and eccentricities of behavior." },
            { q: "What are \"ideas of reference\" as frequently seen in Schizotypal Personality Disorder?", a: "Incorrect interpretations that innocuous, casual external events have highly personally significant meanings." },
            { q: "What kind of odd beliefs or magical thinking influence the behavior of an STPD patient?", a: "Beliefs inconsistent with subcultural norms, such as clairvoyance, telepathy, or a \"sixth sense.\"" },
            { q: "What type of unusual perceptual experiences might a Schizotypal patient report?", a: "Bodily illusions or sensing the presence of a person or force that is not actually there." },
            { q: "How is the speech of a Schizotypal patient typically characterized?", a: "Odd, vague, circumstantial, metaphorical, overelaborate, or stereotyped speech." },
            { q: "What type of anxiety do Schizotypal individuals experience in social situations that does not diminish with familiarity?", a: "Severe social anxiety that tends to be associated with paranoid fears rather than negative judgments about self." },
            { q: "Schizotypal Personality Disorder is genetically linked to which major psychiatric axis I disorder?", a: "Schizophrenia." },
            { q: "What medication class can be used in low doses to treat transient psychotic episodes or severe anxiety in STPD patients?", a: "Low-dose atypical antipsychotics." },
            { q: "What is the essential feature of Antisocial Personality Disorder?", a: "A pervasive pattern of disregard for, and violation of, the rights of others occurring since age 15." },
            { q: "What childhood diagnosis is a strict prerequisite for diagnosing Antisocial Personality Disorder?", a: "Conduct Disorder, with onset before age 15." },
            { q: "What is the minimum age at which Antisocial Personality Disorder can be officially diagnosed?", a: "18 years old." },
            { q: "How do individuals with Antisocial Personality Disorder typically behave regarding social norms and laws?", a: "They repeatedly perform acts that are grounds for arrest due to a failure to conform to lawful behaviors." },
            { q: "What is the characteristic trait of ASPD involving a complete lack of remorse?", a: "They are indifferent to, or rationalize, having hurt, mistreated, or stolen from another person." },
            { q: "How does impulsivity manifest behaviorally in individuals with Antisocial Personality Disorder?", a: "A failure to plan ahead, frequent job changes, and sudden, unprovoked relocations." },
            { q: "What physical behavior is frequently exhibited by individuals with Antisocial Personality Disorder?", a: "Irritability and aggressiveness, as indicated by repeated physical fights or assaults." },
            { q: "What is the primary secondary gain sought by patients with Antisocial Personality Disorder when interacting with healthcare systems?", a: "Obtaining substances, avoiding legal prosecution, or securing disability benefits." },
            { q: "What happens to the severity of criminal or antisocial behaviors as an ASPD patient reaches middle age?", a: "The overt, aggressive antisocial behaviors often decrease or remit as they grow older." },
            { q: "What is the core definition of Borderline Personality Disorder?", a: "A pervasive pattern of instability in interpersonal relationships, self-image, affects, and marked impulsivity." },
            { q: "What frantic efforts do individuals with Borderline Personality Disorder make?", a: "Frantic efforts to avoid real or imagined abandonment." },
            { q: "What is the characteristic pattern of interpersonal relationships in BPD?", a: "Unstable and intense relationships alternating between extremes of idealization and devaluation." },
            { q: "What defense mechanism is classically defined by alternating between total idealization and total devaluation?", a: "Splitting." },
            { q: "What is the nature of identity disturbance in Borderline Personality Disorder?", a: "A markedly and persistently unstable self-image or sense of self." },
            { q: "In what areas must a BPD patient show potentially self-damaging impulsivity?", a: "Spending, sex, substance abuse, reckless driving, or binge eating." },
            { q: "What recurrent behaviors are highly characteristic of crisis presentations in BPD patients?", a: "Recurrent suicidal behavior, gestures, threats, or self-mutilating acts like cutting." },
            { q: "What chronic internal feeling is frequently voiced by individuals with Borderline Personality Disorder?", a: "A chronic feeling of emptiness." },
            { q: "What happens to a BPD patient's cognitive state during periods of extreme, acute stress?", a: "They may experience transient, stress-related paranoid ideation or severe dissociative symptoms." },
            { q: "What is the gold-standard, evidence-based psychotherapy modality developed specifically for BPD?", a: "Dialectical Behavior Therapy (DBT)." },
            { q: "What are the four core skill modules taught to patients in Dialectical Behavior Therapy?", a: "Mindfulness, distress tolerance, emotion regulation, and interpersonal effectiveness." },
            { q: "Why should long-term benzodiazapine prescriptions be strictly avoided in BPD patients?", a: "They can cause behavioral disinhibition and carry a high risk for lethal overdose during impulsive gestures." },
            { q: "What is the primary characteristic of Histrionic Personality Disorder?", a: "A pervasive pattern of excessive emotionality and attention-seeking behavior." },
            { q: "How do individuals with Histrionic Personality Disorder feel when they are not the center of attention?", a: "Uncomfortable, unappreciated, or completely unfulfilled." },
            { q: "What is the nature of the interpersonal interactions initiated by individuals with Histrionic Personality Disorder?", a: "Interactions are frequently characterized by inappropriate sexually seductive or provocative behavior." },
            { q: "How is the expression of emotion described in a patient with Histrionic Personality Disorder?", a: "Rapidly shifting and shallow." },
            { q: "What physical means do Histrionic individuals consistently use to draw attention to themselves?", a: "They consistently use their physical appearance to attract attention." },
            { q: "How is the speech style of a patient with Histrionic Personality Disorder best described?", a: "Excessively impressionistic and strikingly lacking in detail." },
            { q: "What is the nature of the emotional expression of someone with Histrionic Personality Disorder?", a: "Highly dramatic, theatrical, and exaggerated." },
            { q: "How suggestible are individuals with Histrionic Personality Disorder?", a: "They are highly suggestible and easily influenced by others or by current fads." },
            { q: "How do Histrionic individuals typically misjudge the depth of their relationships?", a: "They consider relationships to be much more intimate than they actually are." },
            { q: "What is the essential feature of Narcissistic Personality Disorder?", a: "A pervasive pattern of grandiosity, a constant need for admiration, and a profound lack of empathy." },
            { q: "With what types of fantasies are individuals with Narcissistic Personality Disorder preoccupied?", a: "Fantasies of unlimited success, power, brilliance, beauty, or ideal love." },
            { q: "Who do individuals with Narcissistic Personality Disorder believe they should associate with?", a: "Other special, unique, or high-status people and institutions." },
            { q: "What baseline entitlement do individuals with Narcissistic Personality Disorder possess?", a: "Unreasonable expectations of especially favorable treatment or automatic compliance with their expectations." },
            { q: "How do individuals with Narcissistic Personality Disorder utilize other people in relationships?", a: "They are interpersonally exploitative, taking advantage of others to achieve their own ends." },
            { q: "What core human capacity is notably absent or deficient in Narcissistic Personality Disorder?", a: "Empathy, leading to an unwillingness to recognize or identify with the feelings and needs of others." },
            { q: "What emotion do individuals with NPD frequently experience toward others, or believe others experience toward them?", a: "Intense envy." },
            { q: "What underlying psychological vulnerability exists beneath the grandiose exterior of an NPD patient?", a: "Fragile self-esteem that renders them highly vulnerable to \"narcissistic injury\" from criticism." },
            { q: "What is the core presentation of Avoidant Personality Disorder?", a: "A pervasive pattern of social inhibition, feelings of inadequacy, and hypersensitivity to negative evaluation." },
            { q: "Why do individuals with Avoidant Personality Disorder avoid occupational activities that involve significant interpersonal contact?", a: "Because of profound fears of criticism, disapproval, or rejection." },
            { q: "What is the strict prerequisite for an avoidant individual to get involved with other people?", a: "They must be completely certain of being liked before entering a relationship." },
            { q: "What holds individuals with Avoidant Personality Disorder back in intimate relationships?", a: "A fear of being shamed, ridiculed, or rejected." },
            { q: "How do individuals with Avoidant Personality Disorder view themselves socially?", a: "As socially inept, personally unappealing, or inherently inferior to others." },
            { q: "Why are avoidant individuals unusually reluctant to take personal risks or engage in new activities?", a: "Because such activities may prove embarrassing or confirm their feelings of inadequacy." },
            { q: "What major Axis I anxiety disorder shares a massive clinical and genetic overlap with Avoidant Personality Disorder?", a: "Social Anxiety Disorder (Generalized Type)." },
            { q: "What medication class can be used to treat the severe physiological symptoms of social anxiety in AVPD?", a: "Selective Serotonin Reuptake Inhibitors (SSRIs) or $\\beta$-blocker." },
            { q: "What is the definitive feature of Dependent Personality Disorder?", a: "A pervasive and excessive need to be taken care of that leads to submissive and clinging behavior and fears of separation." },
            { q: "Why do individuals with Dependent Personality Disorder struggle to make everyday decisions?", a: "They require an excessive amount of advice and reassurance from others to make choices." },
            { q: "What do dependent individuals need others to do regarding major areas of their life?", a: "They need others to assume responsibility for most major areas of their life." },
            { q: "Why do individuals with Dependent Personality Disorder rarely express disagreement with others?", a: "Because of a profound fear of losing support, approval, or relationship connection." },
            { q: "Why do dependent individuals struggle to initiate projects or do things on their own?", a: "Due to a lack of self-confidence in their judgment or abilities rather than a lack of motivation or energy." },
            { q: "To what lengths will a person with Dependent Personality Disorder go to obtain nurture and support?", a: "They will go to excessive lengths, including volunteering to do things that are unpleasant or degrading." },
            { q: "How do individuals with Dependent Personality Disorder react when a close relationship ends?", a: "They urgently seek another relationship as a source of care and support." },
            { q: "With what terrifying internal belief are dependent individuals preoccupied?", a: "Unrealistic fears of being left to take care of themselves." },
            { q: "What is the core definition of Obsessive-Compulsive Personality Disorder?", a: "A pervasive pattern of preoccupation with orderliness, perfectionism, and mental and interpersonal control, at the expense of flexibility, openness, and efficiency." },
            { q: "What is the paradoxical result of an OCPD patient's extreme preoccupation with details, rules, lists, and schedules?", a: "The major point of the activity is frequently lost, and efficiency is severely compromised." },
            { q: "How does perfectionism specifically interfere with task completion in OCPD patients?", a: "Tasks are left unfinished because their own overly strict standards are not met." },
            { q: "To what extent do individuals with OCPD devote themselves to work and productivity?", a: "They dedicate themselves excessively to work to the total exclusion of leisure activities and friendships." },
            { q: "What is the OCPD patient's attitude regarding morality, ethics, or values?", a: "They are overly conscientious, scrupulous, and completely inflexible." },
            { q: "Why are individuals with OCPD highly reluctant to delegate tasks or work with others?", a: "Unless others agree to submit exactly to their specific way of doing things, they prefer to do it all themselves." },
            { q: "What is the OCPD patient's spending style regarding both self and others?", a: "A miserly spending style where money is viewed as something to be hoarded for future catastrophes." },
            { q: "What physical items do individuals with OCPD typically struggle to discard?", a: "Worn-out or worthless objects, even when they have absolutely no sentimental value." },
            { q: "What is the critical clinical difference between OCD and OCPD?", a: "OCD is characterized by true, ego-dystonic obsessions and compulsions, whereas OCPD is an ego-syntonic lifestyle of perfectionism." },
            { q: "Is there any FDA-approved medication specifically indicated for the primary treatment of any personality disorder?", a: "No medication is FDA-approved for treating personality disorders; pharmacotherapy targets comorbid symptoms or clusters." },
            { q: "According to Stahl’s Essential Psychopharmacology, what symptom dimension responds best to low-dose antipsychotics across all clusters?", a: "Cognitive-perceptual symptoms, such as transient paranoia, suspiciousness, or illusions." },
            { q: "Which medication class is preferred for managing affective dysregulation and impulsivity in Cluster B disorders?", a: "SSRIs or other mood stabilizers like lamotrigine and valproate." },
            { q: "What is the therapeutic risk of using tricyclic antidepressants (TCAs) in patients with Borderline Personality Disorder?", a: "High toxicity and lethality in acute, impulsive overdose scenarios." },
            { q: "What specific form of cognitive-behavioral therapy focuses on changing deep-seated, lifelong core beliefs in personality disorders?", a: "Schema Therapy." },
            { q: "What psychodynamic therapy framework focuses on the internal representations of self and others to treat Borderline Personality Disorder?", a: "Transference-Focused Psychotherapy (TFP)." },
            { q: "What treatment complication occurs when a patient unconsciously replicates their dysfunctional relationship patterns onto the clinician?", a: "Transference." },
            { q: "What occurs when a clinician develops unconscious emotional reactions toward a personality disorder patient based on the patient's behavior?", a: "Countertransference." },
            { q: "What steps should a clinical team take to counter a Borderline patient's attempts at splitting the staff?", a: "Establish regular, open communication and maintain strictly unified, consistent treatment boundaries." },
            { q: "What must a physician prioritize when establishing a treatment plan for a severely self-harming Cluster B patient?", a: "Clear behavioral contracts, clear safety planning, and firm boundary setting." },
            { q: "What features distinguish Schizotypal Personality Disorder from a Delusional Disorder?", a: "Schizotypal beliefs are odd and magical but lack the fixed, non-bizarre, unshakeable nature of a true delusion." },
            { q: "How do you differentiate a Social Anxiety Disorder flare from Avoidant Personality Disorder?", a: "Avoidant Personality Disorder is broader, globally pervasive, starts earlier, and is completely integrated into the identity." },
            { q: "What is the key differentiator between Narcissistic Personality Disorder and a manic episode?", a: "Mania features a distinct change from baseline mood, flight of ideas, decreased need for sleep, and episodic psychosis." },
            { q: "What separates the mood swings of Borderline Personality Disorder from Bipolar II disorder?", a: "BPD mood shifts are highly reactive to interpersonal triggers and last hours, whereas Bipolar II hypomania lasts days and is independent of triggers." },
            { q: "Individuals with Antisocial Personality Disorder have a markedly elevated comorbid lifetime risk for what class of psychiatric disorders?", a: "Substance Use Disorders." },
            { q: "What major personality disorder is a frequent precursor to or comorbidity of Somatization Disorders (Somatic Symptom Disorder)?", a: "Histrionic Personality Disorder." },
            { q: "What Axis I eating disorder has a strong, perfectionistic clinical overlap with Obsessive-Compulsive Personality Disorder?", a: "Anorexia Nervosa (especially the restricting type)." },
            { q: "What personality disorder is highly comorbid with Major Depressive Disorder and carries a massive risk for completed suicide?", a: "Borderline Personality Disorder." },
            { q: "What personality disorder cluster is most strongly associated with a family history of substance abuse and mood disorders?", a: "Cluster B." },
            { q: "What personality disorder cluster is most closely associated with a family history of anxiety disorders?", a: "Cluster C." },
            { q: "If a patient displays sudden, profound personality shifts later in life (e.g., age 50), what must be ruled out before assigning a personality disorder?", a: "A primary medical condition, central nervous system tumor, trauma, or early-onset neurodegenerative disease." },
            { q: "What is the estimated total prevalence of any personality disorder in the general United States population?", a: "Approximately 10% to 15% of the general population." },
            { q: "Which personality disorder is diagnosed significantly more frequently in clinical settings in females than in males?", a: "Borderline Personality Disorder." },
            { q: "Which personality disorder is diagnosed significantly more frequently in males than in females within forensic settings?", a: "Antisocial Personality Disorder." },
            { q: "What is the general long-term diagnostic stability of personality disorders as patients age into late adulthood?", a: "Symptoms often dull or manifest less overtly, with Cluster B showing the highest rates of mid-life burnout or remission." },
            { q: "Which personality disorder shows a strong familial and genetic aggregation with Schizophrenia spectrum disorders?", a: "Schizotypal Personality Disorder." },
            { q: "What neurobiological finding is frequently associated with the severe impulsivity and aggression seen in Antisocial and Borderline patients?", a: "Reduced central serotonergic activity or low cerebrospinal fluid levels of 5-HIAA." },
            { q: "Which personality disorder is epidemiologically associated with the highest rate of completed suicide?", a: "Borderline Personality Disorder." },
            { q: "What is the primary difference in healthcare utilization between Cluster B and Cluster A individuals?", a: "Cluster B individuals frequently utilize emergency and crisis services, whereas Cluster A individuals actively avoid healthcare systems." },
            { q: "What defense mechanism is characterized by a patient attributing their own unacceptable, aggressive thoughts to a physician, and then acting defensively?", a: "Projection." },
            { q: "What defense mechanism involves an individual dealing with emotional conflict by temporary alteration in the integrative functions of consciousness or identity?", a: "Dissociation." },
            { q: "What primitive defense mechanism is used when a patient acts out unacceptably to express internal conflict rather than verbalizing feelings?", a: "Acting out." },
            { q: "What defense mechanism involves an individual dealing with emotional conflict by attributing exaggerated positive qualities to others?", a: "Idealization." },
            { q: "What defense mechanism is being used when a patient treats one nurse as an absolute angel and another as a malicious enemy?", a: "Splitting." },
            { q: "What defense mechanism allows a patient to experience an internal emotional conflict but express it as a physical symptom like psychogenic blindness?", a: "Somatization." },
            { q: "What defense mechanism is utilized when a Narcissistic patient handles a failure by adopting an attitude of total contempt and superiority toward the evaluator?", a: "Devaluation." },
            { q: "What defense mechanism involves a patient unconsciously taking on the characteristics, traits, or behaviors of an influential authority figure?", a: "Identification." },
            { q: "A patient presents with a history of multiple transient jobs, recurrent arrests for fraud, and completely flat affect when discussing their victims; what is the diagnosis?", a: "Antisocial Personality Disorder." },
            { q: "A college student lives alone, has no friends, spends all night playing solo video games, and expresses total indifference to their parents' concern; what is the diagnosis?", a: "Schizoid Personality Disorder." },
            { q: "A patient arrives dressed in an elaborate Elizabethan costume, uses dramatic hand gestures, and weeps hysterically because the doctor was five minutes late; what is the diagnosis?", a: "Histrionic Personality Disorder." },
            { q: "A patient refuses a life-saving surgical procedure because they are convinced the surgical team is secretly recording them to steal their ideas; what is the diagnosis?", a: "Paranoid Personality Disorder." },
            { q: "A patient demands the chief of surgery perform their routine mole removal because they refuse to be treated by \"low-level residents\"; what is the diagnosis?", a: "Narcissistic Personality Disorder." },
            { q: "A patient presents with fresh linear scars on their forearms following a sudden breakup, demanding immediate admission or they will jump; what is the diagnosis?", a: "Borderline Personality Disorder." },
            { q: "A computer programmer brings a 40-page color-coded binder detailing their daily bathroom habits and fails to complete their project because the font wasn't perfect; what is the diagnosis?", a: "Obsessive-Compulsive Personality Disorder." },
            { q: "A 35-year-old man refuses a major job promotion because it requires moving to a new office where he might face criticism from new coworkers; what is the diagnosis?", a: "Avoidant Personality Disorder." },
            { q: "A 40-year-old woman allows her mother to select her clothes, food, and career, and becomes entirely non-functional when her mother passes away; what is the diagnosis?", a: "Dependent Personality Disorder." },
            { q: "A patient presents with unkempt clothing, speaks about using crystals to ward off negative spirits, and reports feeling a \"weird vibration\" in empty rooms; what is the diagnosis?", a: "Schizotypal Personality Disorder." },
            { q: "According to Stahl's Prescriber's Guide, what is the primary risk of prescribing atypical antipsychotics for Cluster B impulsivity?", a: "Significant metabolic side effects, including weight gain, dyslipidemia, and insulin resistance." },
            { q: "Which mood stabilizer has demonstrated high efficacy in reducing the specific symptom of affective instability in Borderline Personality Disorder?", a: "Lamotrigine." },
            { q: "Why are standard antidepressant medications often disappointing in the treatment of pure Narcissistic Personality Disorder?", a: "Because antidepressants do not alter the underlying grandiose character structure or lack of empathy." },
            { q: "What medication can be specifically used to target severe rejection sensitivity in Avoidant Personality Disorder?", a: "A Selective Serotonin Reuptake Inhibitor (SSRI) like sertraline or escitalmopram." },
            { q: "What is the clinical consensus regarding the use of long-term antipsychotic monotherapy for Schizoid Personality Disorder?", a: "It is generally ineffective and not recommended unless the patient develops a comorbid, overt psychotic disorder." },
            { q: "According to the Clinical Handbook of Psychotropic Drugs, what class of medication can safely mitigate the autonomic hyperactivity seen in Avoidant patients facing public tasks?", a: "$\\beta$-blocker, such as propranolol." },
            { q: "What is a critical safety consideration when using lithium to manage anger outbursts in a highly impulsive Borderline patient?", a: "The narrow therapeutic index creates a massive lethality risk if the patient attempts an intentional overdose." },
            { q: "What is the most effective initial management step when a physician recognizes intense anger or frustration toward a demanding Narcissistic patient?", a: "Acknowledging the countertransference privately and maintaining a neutral, professional, and non-defensive demeanor." },
            { q: "How should a medical team handle a Borderline patient who attempts to pit night-shift nurses against day-shift nurses?", a: "By holding a multidisciplinary team meeting to establish a single, strict, unyielding communication and care protocol." },
            { q: "What is the primary psychological trap a physician must avoid when managing a patient with Histrionic Personality Disorder?", a: "Falling into a dynamic of reciprocal flirtation or cross-boundary dual relationships due to the patient's seductive behavior." },
            { q: "What type of interview style is most effective for gathering accurate historical data from a highly paranoid patient?", a: "A polite, formal, objective, and non-confrontational interview style that avoids excessive friendliness or physical closeness." },
            { q: "What strategy should a physician use when a patient with Obsessive-Compulsive Personality Disorder demands endless, minute details about a drug's mechanism?", a: "Provide clear, structured, intellectualized explanations without engaging in an endless power struggle over control." },
            { q: "When a Dependent patient asks the physician to choose exactly what they should do regarding a lifestyle change, how should the physician respond?", a: "Gently decline to make the decision for them, while supporting and guiding the patient to explore their own options." },
            { q: "What is the legal or ethical obligation of a physician if an Antisocial patient explicitly threatens to physically harm a specific, named individual?", a: "The physician must breach confidentiality to warn the intended victim and notify law enforcement under the Tarasoff ruling." },
            { q: "What structural element is mandatory in any outpatient psychotherapy protocol for individuals with severe Borderline Personality Disorder?", a: "A clear, pre-negotiated crisis crisis plan that details what steps the patient must take before going to an emergency room." },
            { q: "What is the alternative model for personality disorders introduced in Section III of the DSM-5-TR?", a: "A hybrid dimensional-categorical model that assesses impairments in personality functioning and pathological personality traits." },
            { q: "What are the two core domains of personality functioning evaluated in the DSM-5 alternative dimensional model?", a: "Self functioning (identity and self-direction) and interpersonal functioning (empathy and intimacy)." },
            { q: "What are the five broad pathological personality trait domains utilized in the Section III dimensional diagnosis?", a: "Negative Affectivity, Detachment, Antagonism, Disinhibition, and Psychoticism." },
            { q: "Which pathological trait domain in the alternative model corresponds to the eccentricities seen in Cluster A disorders?", a: "Psychoticism." },
            { q: "Which pathological trait domain in the alternative model is the polar opposite of the conscientiousness seen in OCPD?", a: "Disinhibition." },
            { q: "If a patient meets criteria for both Borderline Personality Disorder and a major depressive episode, how should the diagnoses be coded?", a: "Both are coded concurrently, noting the depressive episode as the principal focus of clinical attention if it is the acute presenting issue." },
            { q: "What rule must be followed if personality-like traits appear exclusively during a state of severe Alcohol Use Disorder?", a: "A personality disorder cannot be diagnosed if the behaviors are entirely attributable to the direct physiological effects of a chronic substance." },
            { q: "Can a diagnosis of Antisocial Personality Disorder be given if the antisocial behaviors occur exclusively during the course of Schizophrenia or a Bipolar I manic episode?", a: "No, the diagnosis is excluded if the behavior occurs exclusively during those episodes." },
            { q: "How do you differentiate the lack of relationships in Schizoid Personality Disorder from that caused by Agoraphobia?", a: "Schizoid individuals genuinely lack the desire for connection, whereas agoraphobic individuals desire connection but are paralyzed by fear of panic attacks in public space." },
            { q: "What differentiates the manipulative behavior of a Borderline patient from that of an Antisocial patient?", a: "Borderline patients manipulate to secure nurturance and avoid abandonment, whereas Antisocial patients manipulate to gain material power, sex, or money." },
            { q: "What distinguishes the perfectionism of a patient with Anorexia Nervosa from a patient with pure Obsessive-Compulsive Personality Disorder?", a: "The anorexic patient’s rigid control is primarily confined to food intake and body image, whereas the OCPD patient's rigidity spans across all occupational and personal domains." },
            { q: "How does Paranoid Personality Disorder differ from the paranoid flavor of a major depressive episode with psychotic features?", a: "In PPD, the suspiciousness is chronic and baseline, while in depression with psychosis, it occurs exclusively during the discrete depressive episode." },
            { q: "What differentiates the social withdrawal of a Schizoid individual from that of a severely depressed patient?", a: "The Schizoid individual exhibits a lifelong, stable baseline of isolation, whereas the depressed patient experiences a distinct change from a previous level of functioning." },
            { q: "Why do patients with Borderline Personality Disorder often experience rapid, severe adverse drug reactions or paradoxical responses to psychotropic medications?", a: "Their intense affective instability and splitting can cause them to report extreme, fluctuating somatic complaints and subjective side effects." },
            { q: "What distinguishes Narcissistic Personality Disorder from Histrionic Personality Disorder regarding interpersonal exploitation?", a: "Narcissistic individuals exploit others to feed their grandiosity, while Histrionic individuals do so primarily to gain attention and emotional reassurance." },
            { q: "What childhood history component acts as a highly negative prognostic factor for the adulthood course of Antisocial Personality Disorder?", a: "A severe, early-onset history of physical cruelty to animals and fire-setting during the Conduct Disorder phase." },
            { q: "Which personality disorder cluster is most strongly correlated with a high risk of developing an accidental medication or illicit substance overdose?", a: "Cluster B, due to severe impulsivity, emotional reactivity, and high rates of comorbid substance abuse." },
            { q: "What is the typical longitudinal outcome for patients with Borderline Personality Disorder who complete a full course of Dialectical Behavior Therapy?", a: "They demonstrate high rates of symptom remission and significant reductions in self-harm and emergency department utilization." },
            { q: "How does the response to psychotherapy generally differ between Cluster C and Cluster A personality disorders?", a: "Cluster C patients generally demonstrate much higher insight and a more favorable response to psychotherapy than Cluster A patients." },
            { q: "What long-term socioeconomic trend is commonly observed in individuals with undiagnosed or untreated Obsessive-Compulsive Personality Disorder?", a: "They may achieve moderate professional success due to diligence, but their career ceiling is often limited by their inability to compromise or delegate tasks." }
          ]
        },
{
          section: 'Psychiatry',
          topic: "Eating disorders",
          icon: 'brain',
          cards: [
            { q: "Core diagnostic criteria for Anorexia Nervosa (AN)?", a: "Restriction of energy intake leading to significantly low body weight, intense fear of gaining weight, and distorted body image." },
            { q: "Weight threshold separating Anorexia Nervosa from Bulimia Nervosa?", a: "Anorexia Nervosa requires a significantly low body weight (BMI generally less than 18.5 kg/m² in adults)." },
            { q: "Two main subtypes of Anorexia Nervosa?", a: "Restricting type and Binge-eating/purging type." },
            { q: "Definition of Restricting type Anorexia Nervosa?", a: "Weight loss is accomplished primarily through dieting, fasting, and/or excessive exercise over the last 3 months." },
            { q: "Definition of Binge-eating/purging type Anorexia Nervosa?", a: "The individual has engaged in recurrent episodes of binge eating or purging behavior over the last 3 months." },
            { q: "Primary psychological distinction between OCD and Anorexia Nervosa obsessions?", a: "OCD obsessions are ego-dystonic, whereas Anorexia Nervosa obsessions regarding weight and food are ego-syntonic." },
            { q: "Severity specifiers for adult Anorexia Nervosa based on BMI?", a: "Mild (BMI 17–18.4), Moderate (BMI 16–16.99), Severe (BMI 15–15.99), Extreme (BMI less than 15)." },
            { q: "DSM-5-TR status of amenorrhea in Anorexia Nervosa diagnosis?", a: "Amenorrhea was removed as a required criterion to allow diagnosis in males, pre-menarcheal females, and those on hormonal contraceptives." },
            { q: "Most common vital sign abnormalities in severe Anorexia Nervosa?", a: "Bradycardia, hypotension, and hypothermia." },
            { q: "Cutaneous finding unique to severe starvation in Anorexia Nervosa?", a: "Lanugo (fine, downy body hair)." },
            { q: "Cardiovascular adaptation to chronic starvation in Anorexia Nervosa?", a: "Myocardial atrophy resulting in decreased cardiac output and a prolonged QTc interval." },
            { q: "Hematological manifestations of severe Anorexia Nervosa?", a: "Leukopenia, anemia, and occasionally thrombocytopenia due to bone marrow hypoplasia." },
            { q: "Endocrine abnormalities in female Anorexia Nervosa patients?", a: "Hypogonadotropic hypogonadism, leading to low estrogen and amenorrhea." },
            { q: "Bone health complication secondary to chronic estrogen deficiency in Anorexia Nervosa?", a: "Osteopenia and osteoporosis, which are often irreversible." },
            { q: "Expected thyroid function test panel findings in Anorexia Nervosa?", a: "Normal TSH with low-normal T4 and low T3, characteristic of Euthyroid Sick Syndrome." },
            { q: "Gastrointestinal complications associated with severe starvation in Anorexia Nervosa?", a: "Delayed gastric emptying and gastroparesis, leading to early satiety and bloating." },
            { q: "Salivary gland finding seen primarily in the purging subtype of Anorexia Nervosa?", a: "Parotid gland hypertrophy (sialadenosis)." },
            { q: "Dermatological sign associated with self-induced vomiting?", a: "Russell’s sign (calluses or scars on the knuckles/dorsal hand)." },
            { q: "Dental manifestation characteristic of chronic purging?", a: "Perimylolysis (erosion of dental enamel, particularly on the lingual surfaces)." },
            { q: "First-line medical priority in the stabilization of severe Anorexia Nervosa?", a: "Nutritional rehabilitation and restoration of a safe body weight." },
            { q: "Target weekly weight gain for an Anorexia Nervosa inpatient?", a: "2 to 3 pounds (0.9 to 1.4 kg) per week." },
            { q: "Target weekly weight gain for an Anorexia Nervosa outpatient?", a: "0.5 to 1 pound (0.2 to 0.5 kg) per week." },
            { q: "First-line psychotherapeutic modality for adolescents with Anorexia Nervosa?", a: "Family-Based Therapy (FBT), also known as the Maudsley Method." },
            { q: "Role of medications in the acute treatment of Anorexia Nervosa?", a: "Medications generally lack efficacy for core symptoms during acute starvation and are not first-line." },
            { q: "Atypical antipsychotic occasionally used to promote weight gain and reduce obsessive thinking in Anorexia Nervosa?", a: "Olanzapine." },
            { q: "Antidepressant completely contraindicated in Anorexia Nervosa and Bulimia Nervosa?", a: "Bupropion, due to an increased risk of generalized seizures." },
            { q: "Indication for inpatient hospitalization in Anorexia Nervosa based on heart rate?", a: "Bradycardia with a heart rate below 40 beats per minute." },
            { q: "Indication for inpatient hospitalization in Anorexia Nervosa based on blood pressure?", a: "Hypotension with a blood pressure below 80/50 mmHg or orthostatic changes." },
            { q: "Electrolyte indication for immediate inpatient admission in eating disorders?", a: "Severe hypokalemia, hypophosphatemia, or hypomagnesemia that cannot be corrected out-of-hospital." },
            { q: "Definition of Refeeding Syndrome?", a: "Severe fluid and electrolyte shifts that occur when nutritional rehabilitation is initiated in chronically starved patients." },
            { q: "Primary driving hormone behind Refeeding Syndrome?", a: "Insulin, which surges in response to carbohydrate introduction." },
            { q: "Intracellular electrolyte shift triggered by insulin during refeeding?", a: "Rapid intracellular shift of phosphate, magnesium, and potassium." },
            { q: "Pathognomonic laboratory hallmark of Refeeding Syndrome?", a: "Hypophosphatemia." },
            { q: "Clinical complications resulting from profound hypophosphatemia in Refeeding Syndrome?", a: "Cardiac arrhythmias, rhabdomyolysis, respiratory failure, and seizures." },
            { q: "Vitamin deficiency that must be corrected during refeeding to prevent Wernicke's encephalopathy?", a: "Thiamine (Vitamin B1)." },
            { q: "Initial approach to caloric prescription to prevent Refeeding Syndrome?", a: "Start caloric intake low (e.g., 30–40 kcal/kg/day or lower in extreme cases) and advance slowly while monitoring electrolytes." },
            { q: "Acid-base disturbance typically caused by chronic self-induced vomiting?", a: "Hypokalemic, hypochloremic metabolic alkalosis." },
            { q: "Acid-base disturbance typically caused by chronic laxative abuse?", a: "Metabolic acidosis due to bicarbonate loss in stool." },
            { q: "Electrolyte abnormality most responsible for cardiac arrhythmias in Bulimia Nervosa?", a: "Hypokalemia." },
            { q: "Diagnostic utility of serum amylase in purging disorders?", a: "Serum amylase is often elevated due to hypersecretion from hyperplastic salivary glands." },
            { q: "Life-threatening gastrointestinal emergency associated with forceful vomiting?", a: "Mallory-Weiss tears or esophageal rupture (Boerhaave syndrome)." },
            { q: "Cardiac complication linked to the chronic abuse of Ipecac syrup?", a: "Ipecac-induced cardiomyopathy, caused by the accumulation of emetine." },
            { q: "First-line psychotherapeutic treatment for Bulimia Nervosa?", a: "Cognitive Behavioral Therapy adapted for eating disorders (CBT-E)." },
            { q: "Only FDA-approved medication for the treatment of Bulimia Nervosa?", a: "Fluoxetine." },
            { q: "Dosage requirement for Fluoxetine in Bulimia Nervosa compared to major depressive disorder?", a: "Higher doses are required, typically 60 mg daily instead of the standard 20 mg." },
            { q: "Primary therapeutic goal of CBT-E in Bulimia Nervosa?", a: "Normalizing eating patterns, restructuring cognitive distortions regarding weight, and developing alternative coping mechanisms." },
            { q: "Core diagnostic criteria for Binge-Eating Disorder (BED)?", a: "Recurrent episodes of binge eating associated with marked distress, occurring in the absence of regular compensatory behaviors." },
            { q: "Frequency and duration requirements for Binge-Eating Disorder diagnosis?", a: "At least once a week for at least 3 months." },
            { q: "Three behavioral indicators required during a binge episode for BED diagnosis?", a: "Eating rapidly, eating until uncomfortably full, eating large amounts when not hungry, eating alone out of embarrassment, or feeling disgusted/guilty afterward." },
            { q: "Major clinical feature separating Binge-Eating Disorder from Bulimia Nervosa?", a: "Binge-Eating Disorder lacks the regular use of inappropriate compensatory behaviors." },
            { q: "Most common physical health comorbidity associated with Binge-Eating Disorder?", a: "Obesity and its related metabolic complications (e.g., type 2 diabetes, hypertension, dyslipidemia)." },
            { q: "First-line psychotherapeutic intervention for Binge-Eating Disorder?", a: "Cognitive Behavioral Therapy (CBT) or Interpersonal Psychotherapy (IPT)." },
            { q: "Only FDA-approved medication for the treatment of moderate-to-severe Binge-Eating Disorder?", a: "Lisdexamfetamine (Vyvanse)." },
            { q: "Mechanism of action by which Lisdexamfetamine treats Binge-Eating Disorder?", a: "It acts as a central nervous system stimulant, modulating dopamine and norepinephrine to reduce impulsive binging urges." },
            { q: "Off-label antiepileptic medication sometimes used to reduce binge frequency and promote weight loss?", a: "Topiramate." },
            { q: "Role of SSRIs in the management of Binge-Eating Disorder?", a: "Used as a second-line or adjunct treatment to reduce binge frequency and treat comorbid depressive or anxious symptoms." },
            { q: "Core definition of Avoidant/Restrictive Food Intake Disorder (ARFID)?", a: "An eating or feeding disturbance characterized by a persistent failure to meet appropriate nutritional and/or energy needs." },
            { q: "Three primary presentations/motivations behind food avoidance in ARFID?", a: "Apparent lack of interest in food, avoidance based on sensory characteristics, or concern about aversive consequences of eating (e.g., choking)." },
            { q: "Key clinical feature distinguishing ARFID from Anorexia Nervosa and Bulimia Nervosa?", a: "ARFID lacks any distortion in the perception of body weight or shape, and no fear of gaining weight." },
            { q: "Required clinical consequences to diagnose ARFID?", a: "Significant weight loss (or failure to achieve expected growth), significant nutritional deficiency, dependence on enteral feeding/supplements, or marked psychosocial impairment." },
            { q: "Most common pediatric psychiatric comorbidity overlapping with sensory-based ARFID?", a: "Autism Spectrum Disorder (ASD)." },
            { q: "Primary therapeutic modality used to treat ARFID?", a: "Behavioral interventions, systemic desensitization, and family-supported nutritional rehabilitation." },
            { q: "Core diagnostic criteria for Pica?", a: "Persistent eating of nonnutritive, nonfood substances over a period of at least 1 month." },
            { q: "Minimum developmental age required to legally diagnose Pica?", a: "At least 2 years of age, to ensure the behavior is developmentally inappropriate." },
            { q: "Common micronutrient deficiencies closely associated with Pica?", a: "Iron deficiency anemia and zinc deficiency." },
            { q: "Important medical risks associated with severe Pica?", a: "Lead poisoning, intestinal obstruction, intestinal perforation, and parasitic infections." },
            { q: "Core diagnostic criteria for Rumination Disorder?", a: "Repeated regurgitation of food over a period of at least 1 month, where food may be re-chewed, re-swallowed, or spit out." },
            { q: "Key behavioral distinction for Rumination Disorder?", a: "The behavior must not be due to an associated gastrointestinal or medical condition (e.g., GERD, pyloric stenosis)." },
            { q: "First-line behavioral intervention for Rumination Disorder?", a: "Diaphragmatic breathing techniques practiced immediately after eating." },
            { q: "Purpose of the \"Other Specified Feeding or Eating Disorder\" (OSFED) category?", a: "To classify presentations where symptoms cause clinically significant distress but do not meet the full diagnostic criteria for any specific eating disorder." },
            { q: "Definition of Atypical Anorexia Nervosa?", a: "All criteria for Anorexia Nervosa are met, except that despite significant weight loss, the individual's weight is within or above the normal range." },
            { q: "Definition of Bulimia Nervosa of low frequency and/or limited duration?", a: "All criteria for Bulimia Nervosa are met, except the binge eating and inappropriate compensatory behaviors occur less than once a week and/or for less than 3 months." },
            { q: "Definition of Purging Disorder?", a: "Recurrent purging behavior to influence weight or shape in the absence of binge eating episodes." },
            { q: "Definition of Night Eating Syndrome?", a: "Recurrent episodes of night eating, manifested by eating after awakening from sleep or by excessive food consumption after the evening meal, causing distress." },
            { q: "Mechanism by which Fluoxetine diminishes binging and purging behaviors?", a: "Downregulation of presynaptic $\\text{$\\text{5-HT}$}_{1\\text{A}}$ receptors and enhancement of serotonin neurotransmission in the hypothalamus." },
            { q: "Rationale behind avoiding Bupropion in purging patients based on neurotransmitter dynamics?", a: "Purging induces rapid electrolyte shifts that lower the seizure threshold, which compounding with Bupropion's inhibition of norepinephrine/dopamine reuptake triggers status epilepticus." },
            { q: "Clinical monitoring protocol required when using high-dose Fluoxetine in eating disorder clinics?", a: "Baseline and periodic ECGs to monitor for QTc prolongation, especially if electrolyte fluctuations are present." },
            { q: "Indication for using Topiramate adjunctively in Binge-Eating Disorder?", a: "It modulates $\\text{GABA}_\\text{A}$ receptors and inhibits AMPA/kainate pathways, reducing the reward-seeking urgency of binge behaviors." },
            { q: "Metabolic side effects of Olanzapine that require tracking when used for Anorexia Nervosa weight restoration?", a: "Fasting blood glucose, lipid panels, and baseline HbA1c to monitor for drug-induced metabolic syndrome." },
            { q: "Mechanism of action of Orlistat and its status in eating disorder management?", a: "Gastric and pancreatic lipase inhibitor; generally avoided or highly restricted due to high potential for abuse as a purging mechanism." },
            { q: "Psychiatric disorder with the highest mortality rate?", a: "Anorexia Nervosa." },
            { q: "Two primary causes of death in patients diagnosed with Anorexia Nervosa?", a: "Medical complications of starvation (primarily cardiac arrest) and suicide." },
            { q: "Peak age of onset for Anorexia Nervosa?", a: "Early adolescence, typically between 14 and 18 years of age." },
            { q: "Peak age of onset for Bulimia Nervosa?", a: "Late adolescence to early adulthood, typically between 18 and 22 years of age." },
            { q: "Gender distribution ratio for Anorexia Nervosa and Bulimia Nervosa in clinical populations?", a: "Approximately 10:1 female-to-male ratio." },
            { q: "Gender distribution of Binge-Eating Disorder compared to Anorexia Nervosa?", a: "Much more symmetric, with females representing roughly 60% and males representing 40% of cases." },
            { q: "Most common lifetime psychiatric comorbidities across all eating disorders?", a: "Major Depressive Disorder (MDD), Anxiety disorders (Social Anxiety, OCD), and Substance Use Disorders." },
            { q: "General long-term recovery rate for patients treated for Anorexia Nervosa?", a: "Approximately 50% achieve full recovery, 30% show partial improvement, and 20% develop a chronic, unremitting illness." },
            { q: "Diagnostic differentiation when a patient displays low weight, fear of fatness, and obsessive handwashing?", a: "Dual diagnosis of Anorexia Nervosa and OCD is warranted if the OCD obsessions extend completely outside of food and body image." },
            { q: "Distinguishing features between Body Dysmorphic Disorder (BDD) and Anorexia Nervosa?", a: "BDD involves preoccupation with specific, localized flaws in physical appearance, whereas Anorexia involves a global distortion of weight and body shape." },
            { q: "Medical conditions that mimic the profound weight loss of Anorexia Nervosa?", a: "Hyperthyroidism, Addison’s disease, Inflammatory Bowel Disease (IBD), and occult malignancies." },
            { q: "Lab profile finding that helps differentiate true fasting starvation from surreptitious purging?", a: "Purging presents with low urinary chloride levels, while fasting starvation maintains normal urinary electrolytes." },
            { q: "Diagnosis for a patient who limits dietary intake to \"pure\" or \"healthy\" foods, causing nutritional failure, but has no concern with weight or body shape?", a: "Orthorexia Nervosa (not a formal DSM-5-TR diagnosis; categorized under ARFID or OSFED)." },
            { q: "Diagnostic outcome when an individual meets all criteria for both Schizophrenia and Anorexia Nervosa?", a: "Both disorders should be diagnosed concurrently if the eating disturbance is not entirely subordinate to persecutory delusions about food." },
            { q: "Diagnostic outcome when binge eating episodes occur exclusively during episodes of Major Depressive Disorder?", a: "Both MDD and the appropriate eating disorder (e.g., BED or Bulimia) should be diagnosed if criteria for both are met independently." },
            { q: "Expected serum bicarbonate level in an active laxative-abusing patient?", a: "Low serum bicarbonate (metabolic acidosis)." },
            { q: "Expected serum bicarbonate level in an active vomiting patient?", a: "High serum bicarbonate (contraction metabolic alkalosis)." },
            { q: "Why does hypokalemia persist in purging patients despite oral potassium supplementation?", a: "Concurrent hypomagnesemia promotes renal potassium wasting, preventing correction until magnesium is replenished." },
            { q: "Mechanism of aldosterone elevation in chronic purging behaviors?", a: "Intravascular volume depletion triggers the renin-angiotensin-aldosterone system (RAAS), leading to secondary hyperaldosteronism." },
            { q: "Effect of secondary hyperaldosteronism on renal excretion in purging patients?", a: "It forces the kidneys to retain sodium and water at the expense of exacerbating urinary potassium and hydrogen excretion." },
            { q: "Phenomenon of rapid fluid retention and peripheral edema upon stopping chronic purging behaviors?", a: "\"Pseudo-Bartter syndrome,\" driven by the sudden withdrawal of purging while RAAS remains highly upregulated." },
            { q: "Immediate management strategy for severe pedal edema secondary to purging cessation?", a: "Avoid rapid diuretic use; treat with mild sodium restriction, leg elevation, and time to let the RAAS downregulate naturally." },
            { q: "Mechanism causing hypothalamic amenorrhea in starvation states?", a: "Suppression of the pulsatile secretion of Gonadotropin-Releasing Hormone (GnRH) from the hypothalamus." },
            { q: "Status of growth hormone (GH) levels in severe Anorexia Nervosa?", a: "Paradoxically elevated, but peripheral insulin-like growth factor 1 (IGF-1) production is profoundly suppressed due to hepatic GH resistance." },
            { q: "Cortisol levels typically found in patients with acute, severe Anorexia Nervosa?", a: "Elevated, due to starvation-induced activation of the hypothalamic-pituitary-adrenal (HPA) axis and prolonged clearance rates." },
            { q: "Structural brain changes observable on neuroimaging in severe Anorexia Nervosa?", a: "Pseudo-atrophy of the brain, characterized by increased ventricular size and prominent sulci, which largely reverses with weight restoration." },
            { q: "Changes in cholesterol panels frequently seen in starvation states?", a: "Paradoxical hypercholesterolemia, driven by decreased biliary excretion and altered cholesterol metabolism." },
            { q: "Pathophysiology behind delayed gastric emptying in starvation?", a: "Atrophy of the gastrointestinal smooth muscle coat combined with autonomic dysregulation." },
            { q: "Primary therapeutic goal during Phase 1 of Family-Based Therapy (Maudsley)?", a: "Parents are given complete, non-punitive control over the patient's eating habits and refeeding schedule." },
            { q: "Primary focus of Phase 2 of Family-Based Therapy (Maudsley)?", a: "Gradually returning control over eating back to the adolescent once weight stabilization is nearly achieved." },
            { q: "Primary target of Interpersonal Psychotherapy (IPT) when utilized for Bulimia Nervosa?", a: "Resolving current interpersonal problems, grief, or role transitions that trigger the emotional distress driving binge/purge cycles." },
            { q: "Cognitive distortion characterized by an eating disorder patient viewing a single bite of forbidden food as total failure?", a: "All-or-nothing (dichotomous) thinking." },
            { q: "Cognitive restructuring technique used in CBT-E to handle catastrophic thoughts about weight gain?", a: "Decatastrophizing, via logical challenging and behavioral experiments." },
            { q: "Transdiagnostic model concept regarding eating disorders?", a: "The theory that Anorexia, Bulimia, and BED share identical core psychopathology—over-evaluation of shape and weight—manifesting in different behavioral patterns." },
            { q: "Standard titration strategy for Lisdexamfetamine in Binge-Eating Disorder?", a: "Initiate at 30 mg orally once daily in the morning, and titrate weekly to a target therapeutic dose of 50 to 70 mg." },
            { q: "Black box warning consideration when initiating stimulants for Binge-Eating Disorder?", a: "High potential for abuse and dependence; careful screening for personal or family history of substance use disorder is required." },
            { q: "Cardiovascular absolute contraindications for initiating Lisdexamfetamine?", a: "Advanced arteriosclerosis, symptomatic cardiovascular disease, moderate-to-severe hypertension, or known structural cardiac abnormalities." },
            { q: "Primary side effect profile of Topiramate used off-label for binge behaviors?", a: "Paresthesias, cognitive slowing (\"word-finding difficulties\"), somnolence, and an increased risk of nephrolithiasis (kidney stones)." },
            { q: "Mechanism by which Topiramate induces metabolic acidosis?", a: "It acts as a weak inhibitor of carbonic anhydrase enzymes, increasing renal bicarbonate loss." },
            { q: "Most common side effect of high-dose Fluoxetine (60–80mg) during the first two weeks of treatment?", a: "Transiently increased anxiety, nausea, insomnia, and tremors." },
            { q: "Clinical monitoring required prior to initiating Olanzapine in an eating disorder patient?", a: "Baseline body weight, waist circumference, blood pressure, fasting plasma glucose, and fasting lipid profile." },
            { q: "Most likely eating disorder presentation in a patient with Type 1 Diabetes who consistently presents with unexplained DKA?", a: "Diabulimia, characterized by the deliberate withholding of insulin to induce glycosuria and rapid weight loss." },
            { q: "Expected serum chloride level in a patient who secondary-abuses diuretics versus a patient who purges via vomiting?", a: "Vomiting causes low urinary and serum chloride, whereas diuretic abuse causes high urinary chloride despite low serum chloride." },
            { q: "Diagnostic significance of a normal or elevated body weight in a patient who purges daily?", a: "It rules out Anorexia Nervosa and confirms a diagnosis of Bulimia Nervosa or Purging Disorder." },
            { q: "The \"Female Athlete Triad\" components frequently tested on Step 2 CK?", a: "Low energy availability (with or without an eating disorder), menstrual dysfunction (amenorrhea), and low bone mineral density." },
            { q: "Most sensitive screening tool utilized in primary care clinics to detect eating disorders?", a: "The SCOFF questionnaire." },
            { q: "Ethical justification for treating an adult Anorexia Nervosa patient against their will?", a: "Civil commitment or involuntary medical treatment is legally justified if severe malnutrition impairs cognitive capacity to the point of imminent self-harm." },
            { q: "Primary immediate cause of death during the first 48 hours of aggressive nutritional rehabilitation?", a: "Acute congestive heart failure secondary to fluid overload and severe hypophosphatemia." },
            { q: "Indication for cardiac telemetry in an eating disorder inpatient admission?", a: "A prolonged QTc interval greater than 500 milliseconds or a history of syncopal episodes." },
            { q: "Preferred route of nutritional replacement in a severely malnourished patient who refuses oral intake?", a: "Nasogastric tube feeding is preferred over total parenteral nutrition (TPN) to maintain gut mucosal integrity and minimize infection risk." },
            { q: "Expected changes in liver function tests (LFTs) during the first two weeks of refeeding therapy?", a: "Transient elevation of transaminases (AST and ALT) due to hepatic steatosis or rapid glycogen deposition." },
            { q: "Primary clinical presentation of Anorexia Nervosa in pre-pubertal children?", a: "Failure to make expected developmental height gains or a complete stagnation of the growth curve rather than overt weight loss." },
            { q: "Major obstetric complication associated with active Bulimia Nervosa during pregnancy?", a: "Increased risk of intrauterine growth restriction (IUGR), low birth weight, and postpartum depression." },
            { q: "Influence of maternal Anorexia Nervosa on the risk of miscarriage?", a: "It significantly increases the risk of spontaneous abortion due to an unfavorable uterine environment and hormonal instability." },
            { q: "Typical presentation of \"Muscle Dysmorphia\" (a variant of Body Dysmorphic Disorder often overlapping with eating disorders)?", a: "Core preoccupation that one's body is too small or insufficiently muscular, leading to excessive weightlifting and anabolic steroid abuse." },
            { q: "Primary neurochemical abnormality implicated in the altered satiety signals of Bulimia Nervosa?", a: "Blunted postprandial cholecystokinin (CCK) secretion and altered central serotonin receptor sensitivity." },
            { q: "Changes in cerebrospinal fluid (CSF) 5-HIAA levels in long-term recovered Anorexia Nervosa patients?", a: "Paradoxically elevated 5-HIAA levels, which may correlate with baseline trait anxiety and perfectionism." },
            { q: "Structural brain alteration on MRI that persists even after long-term weight restoration in Anorexia Nervosa?", a: "Persistent reductions in gray matter volume in specific regions of the anterior cingulate cortex have been observed in some chronic cases." },
            { q: "Heritability estimate for Anorexia Nervosa based on twin studies?", a: "High genetic liability, with heritability estimated between 50% and 60%." },
            { q: "Why are typical (first-generation) antipsychotics avoided in the treatment of Anorexia Nervosa?", a: "They carry a high risk of lowering the seizure threshold and exacerbating prolonged QTc intervals without providing weight-restoration benefits." },
            { q: "Management strategy for severe SSRI-induced gastrointestinal distress in a Bulimia Nervosa patient?", a: "Take the medication with a meal or split the daily dose, as the distress is driven by peripheral serotonin receptor activation." },
            { q: "Why is Mirtazapine considered an attractive off-label choice for some Anorexia Nervosa outpatients with comorbid depression?", a: "Its antagonism of $\\text{$\\text{5-HT}$}_{2\\text{C}}$ and $\\text{H}_1$ receptors robustly stimulates appetite and promotes weight gain while simultaneously reducing insomnia." },
            { q: "Drug-drug interaction risk when combining high-dose Fluoxetine with certain atypical antipsychotics like Ziprasidone?", a: "Severe additive QTc prolongation, which increases the risk of Torsades de Pointes." },
            { q: "Diagnostic criteria adjustments in the DSM-5-TR regarding the definition of a \"Binge\"?", a: "The DSM-5-TR clarifies that the \"sense of lack of control\" during a binge can be present even if the individual chooses to stop eating mid-episode." },
            { q: "How does DSM-5-TR classify a patient who presents with regular purging after eating normal amounts of food but does not binge?", a: "Purging Disorder, which is coded under Other Specified Feeding or Eating Disorder (OSFED)." },
            { q: "Diagnostic classification for \"Kline-Levin Syndrome\" to differentiate it from Binge-Eating Disorder?", a: "It is classified as a sleep-wake disorder (hypersomnolence), characterized by periodic episodes of hyperphagia and hypersexuality, not an eating disorder." },
            { q: "Differentiation between ARFID and selective eating based on religious or cultural practices?", a: "If the food restriction is entirely explained by organized religious fasting or cultural norms, an ARFID diagnosis cannot be made." },
            { q: "True or False: Leptin levels are characteristically elevated in patients with active Anorexia Nervosa?", a: "False; leptin levels are profoundly low due to the loss of adipose tissue, which removes a key stimulus for GnRH secretion." },
            { q: "Why do patients with severe Anorexia Nervosa exhibit cold intolerance beyond simple lack of insulation?", a: "Starvation induces a functional down-regulation of peripheral cellular metabolism to conserve energy, mimicking systemic hypothyroidism." },
            { q: "Expected effect of severe malnutrition on the secretion of Antidiuretic Hormone (ADH) and urine concentration?", a: "It can cause a mild, reversible central Diabetes Insipidus variant, leading to polyuria and an inability to maximally concentrate urine." },
            { q: "What happens to ghrelin levels in patients with acute Anorexia Nervosa?", a: "Ghrelin levels are significantly elevated as the body attempts to signal starvation and stimulate food intake, though the brain remains resistant to it." },
            { q: "Serum calcium status in chronic Anorexia Nervosa without active purging?", a: "Typically normal due to compensatory parathyroid hormone (PTH) elevation drawing calcium from bone stores, accelerating osteoporosis." },
            { q: "What is the \"Squat-and-Stand\" test used for in an eating disorder physical evaluation?", a: "It assesses proximal muscle wasting and motor weakness caused by myofibrillar catabolism due to severe protein-calorie malnutrition." },
            { q: "Definition of \"Melanosis Coli\" in a patient presenting with an unclassified eating disorder?", a: "A benign, dark pigmentation of the colorectal mucosa visible on colonoscopy, indicating chronic abuse of anthraquinone stimulant laxatives (e.g., senna)." },
            { q: "Diagnostic significance of a sudden, dramatic drop in blood urea nitrogen (BUN) in a severely emaciated patient?", a: "It reflects near-total depletion of protein stores and hepatic synthetic failure, a sign of terminal starvation." },
            { q: "Why does severe starvation cause non-inflammatory, bilateral enlargement of the parotid glands?", a: "Compensatory hyper-salivation and acinar hypertrophy occur as the body prepares to process scarce food efficiently." },
            { q: "What is \"Acrocyanosis\" in the context of severe eating disorders?", a: "A bluish or purple discoloration of the hands and feet caused by peripheral vasoconstriction to maintain core body temperature." },
            { q: "How do you differentiate the weight loss of a Major Depressive Episode from Anorexia Nervosa?", a: "Depressed patients lose appetite and weight without a distorted body image, drive for thinness, or intense fear of weight gain." },
            { q: "Core differentiator between Avoidant/Restrictive Food Intake Disorder (ARFID) and Somatic Symptom Disorder?", a: "Somatic Symptom Disorder focuses on the distressing nature of a physical symptom (e.g., abdominal pain), whereas ARFID focuses purely on the aversive consequences of eating itself (e.g., choking)." },
            { q: "Can an individual be diagnosed with both Pica and Rumination Disorder simultaneously?", a: "Yes, if the criteria for both disorders are fully met independently, they should be co-diagnosed." },
            { q: "Diagnostic outcome if a patient meets criteria for Bulimia Nervosa but only binges and purges once every two weeks for six months?", a: "Coded as Low Frequency Bulimia Nervosa under the Other Specified Feeding or Eating Disorder (OSFED) category." },
            { q: "Diagnostic boundary between Binge-Eating Disorder and Night Eating Syndrome?", a: "Night Eating Syndrome involves conscious awareness of eating a large amount of food post-dinner or mid-sleep, but lacks the specific \"loss of control\" binge episodes." },
            { q: "Immediate medical intervention for a patient with an eating disorder who presents with symptomatic hypoglycemia?", a: "Intravenous infusion of dextrose, preceded immediately by or paired with intravenous thiamine to prevent acute Wernicke’s encephalopathy." },
            { q: "Fluid resuscitation fluid of choice for a severely dehydrated, purging patient with hypokalemic metabolic alkalosis?", a: "Normal saline (0.9% NaCl) with potassium added, because chloride replacement is required to halt renal bicarbonate retention." },
            { q: "Why is lactated Ringer’s solution avoided in the initial resuscitation of a purging patient with metabolic alkalosis?", a: "It contains lactate, which is metabolized into bicarbonate and can worsen the pre-existing metabolic alkalosis." },
            { q: "Target inpatient heart rate during sleep that triggers an immediate medical intervention?", a: "A nocturnal heart rate falling consistently below 30 to 35 beats per minute." },
            { q: "Legal requirement for discharging a voluntary adult eating disorder patient who is medically unstable but demands to leave against medical advice (AMA)?", a: "The clinician must hold the patient under an emergency psychiatric/medical hold if the patient’s severe cognitive impairment from starvation constitutes an imminent risk to life." },
            { q: "Why does Lisdexamfetamine have a lower immediate abuse potential than immediate-release dextroamphetamine in Binge-Eating Disorder patients?", a: "It is a prodrug requiring rate-limited enzymatic cleavage by red blood cells to become active, preventing rapid euphoric spikes." },
            { q: "Rationale behind using low-dose atypical antipsychotics to manage acute mealtime distress in Anorexia Nervosa?", a: "They block $\\text{$\\text{5-HT}$}_{2\\text{A}}$ and $\\text{D}_2$ receptors, which transiently reduces the acute, severe delusional anxiety associated with food ingestion." },
            { q: "Why can SSRIs fail to treat comorbid depressive symptoms during the acute, starvation phase of Anorexia Nervosa?", a: "Severe malnutrition depletes tryptophan, the essential amino acid precursor required for the synthesis of serotonin." },
            { q: "Cardiovascular monitoring parameter that must be evaluated before prescribing Topiramate off-label?", a: "None; unlike stimulants, Topiramate does not increase blood pressure or heart rate, making it safer for patients with mild cardiovascular concerns." },
            { q: "Main reason why tricyclic antidepressants (TCAs) are avoided in purging patients?", a: "They lower the seizure threshold and have profound cardiotoxicity, which multiplies the danger of underlying electrolyte imbalances." },
            { q: "Core diagnostic criteria for Bulimia Nervosa?", a: "Recurrent episodes of binge eating followed by inappropriate compensatory behaviors to prevent weight gain, occurring at least weekly for 3 months." },
            { q: "Definition of a binge eating episode?", a: "Eating an amount of food definitely larger than what most individuals would eat, accompanied by a sense of lack of control." },
            { q: "Examples of inappropriate compensatory behaviors in Bulimia Nervosa?", a: "Self-induced vomiting, misuse of laxatives, diuretics, enemas, fasting, or excessive exercise." },
            { q: "Main clinical feature distinguishing Bulimia Nervosa from Anorexia Nervosa, binge-eating/purging type?", a: "Bulimia Nervosa patients maintain a normal or overweight body mass index (BMI $\\ge$ 18.5)." },
            { q: "DSM-5-TR frequency and duration requirements for Bulimia Nervosa?", a: "At least once a week for at least 3 months." },
            { q: "Personality trait frequently comorbid with Bulimia Nervosa compared to Restricting Anorexia?", a: "High impulsivity and emotional dysregulation (often overlapping with Borderline Personality Disorder)." },
            { q: "Severity categorization for Bulimia Nervosa?", a: "Based on the frequency of compensatory behaviors per week: Mild (1–3), Moderate (4–7), Severe (8–13), Extreme ($\\ge$14)." }
          ]
        },
{
          section: 'Psychiatry',
          topic: "Psychiatric emergencies & commitment law",
          icon: 'brain',
          cards: [
            { q: "Most common class of medications responsible for causing Neuroleptic Malignant Syndrome (NMS)?", a: "First-generation (typical) antipsychotics." },
            { q: "Primary pathophysiology underlying Neuroleptic Malignant Syndrome (NMS)?", a: "Central dopamine receptor ($D_2$) blockade." },
            { q: "Four cardinal clinical features of Neuroleptic Malignant Syndrome (NMS)?", a: "Altered mental status, hyperthermia, autonomic instability, and lead-pipe rigidity." },
            { q: "Serum marker that is massively elevated in Neuroleptic Malignant Syndrome (NMS) due to muscle rigidity?", a: "Creatine kinase (CK)." },
            { q: "Primary life-threatening complication of severe muscle necrosis in Neuroleptic Malignant Syndrome (NMS)?", a: "Rhabdomyolysis leading to acute renal failure." },
            { q: "First step in the management of suspected Neuroleptic Malignant Syndrome (NMS)?", a: "Discontinue the offending antipsychotic agent immediately." },
            { q: "Two primary pharmacological agents used to treat severe Neuroleptic Malignant Syndrome (NMS)?", a: "Dantrolene and bromocriptine." },
            { q: "Mechanism of action of dantrolene in Neuroleptic Malignant Syndrome (NMS) management?", a: "Ryanodine receptor antagonist that inhibits calcium release from the sarcoplasmic reticulum." },
            { q: "Mechanism of action of bromocriptine in Neuroleptic Malignant Syndrome (NMS) management?", a: "Dopamine receptor agonist." },
            { q: "Primary pathophysiology underlying Serotonin Syndrome (SS)?", a: "Overstimulation of central and peripheral serotonin receptors ($5\\text{-HT}_{1\\text{A}}$ and $5\\text{-HT}_{2\\text{A}}$)." },
            { q: "Classic triad of clinical features in Serotonin Syndrome (SS)?", a: "Altered mental status, autonomic hyperactivity, and neuromuscular abnormality." },
            { q: "Neuromuscular finding that differentiates Serotonin Syndrome (SS) from Neuroleptic Malignant Syndrome (NMS)?", a: "Hyperreflexia and clonus (spontaneous, inducible, or ocular)." },
            { q: "Specific physical exam finding often present in the lower extremities of Serotonin Syndrome (SS) patients?", a: "Ankle clonus." },
            { q: "First-line pharmacological antagonist used for severe Serotonin Syndrome (SS) failing supportive care?", a: "Cyproheptadine." },
            { q: "Mechanism of action of cyproheptadine?", a: "Non-specific serotonin ($5\\text{-HT}_1$ and $5\\text{-HT}_2$) receptor antagonist." },
            { q: "Dangerous drug interaction that frequently precipitates Serotonin Syndrome (SS)?", a: "Combining an MAOI with an SSRI or SNRI." },
            { q: "Minimum washout period required when switching from an SSRI (except fluoxetine) to an MAOI?", a: "Two weeks." },
            { q: "Required washout period when switching from fluoxetine to an MAOI due to its long half-life?", a: "Five weeks." },
            { q: "Definition of acute dystonia?", a: "Acute, involuntary, sustained muscle contractions or spasms." },
            { q: "Typical timeline for the onset of acute dystonia after starting an antipsychotic?", a: "Hours to days." },
            { q: "Definition of oculogyric crisis?", a: "Acute dystonic reaction causing involuntary upward deviation of the eyes." },
            { q: "Definition of torticollis?", a: "Acute dystonic spasm of the neck muscles causing the head to twist to one side." },
            { q: "First-line pharmacological treatments for an acute dystonic reaction?", a: "Benztropine or diphenhydramine." },
            { q: "Mechanism of action of benztropine in treating acute dystonia?", a: "Central anticholinergic (muscarinic receptor antagonist) agent." },
            { q: "Subjective feeling of intense inner restlessness and the urge to move?", a: "Akathisia." },
            { q: "First-line pharmacological options for the treatment of akathisia?", a: "$\\beta$-blocker (e.g., propranolol) or benzodiazepines." },
            { q: "Medical emergency characterized by potentially fatal laryngeal muscle spasm due to antipsychotic use?", a: "Laryngeal dystonia." },
            { q: "Management priority for a patient presenting with laryngeal dystonia?", a: "Intravenous benztropine and securing the airway." },
            { q: "Classic mnemonic phrase describing the signs of anticholinergic toxicity?", a: "\"Blind as a bat, mad as a hatter, red as a beet, hot as a hare, dry as a bone, bowel and bladder lose their tone.\"" },
            { q: "Pupillary finding characteristic of anticholinergic toxicity?", a: "Mydriasis (dilated pupils) with sluggish reactivity." },
            { q: "Skin and mucosal presentation in anticholinergic toxicity?", a: "Flushed, hot, dry skin and dry mucous membranes." },
            { q: "Antidote indicated for severe, life-threatening anticholinergic toxicity with delirium?", a: "Physostigmine." },
            { q: "Pharmacological class and mechanism of physostigmine?", a: "Acetylcholinesterase inhibitor that crosses the blood-brain barrier." },
            { q: "Major contraindication to administering physostigmine?", a: "Tricyclic antidepressant (TCA) overdose due to increased risk of asystole." },
            { q: "Life-threatening dermatologic emergency associated with lamotrigine titration?", a: "Stevens-Johnson Syndrome (SJS) / Toxic Epidermal Necrolysis (TEN)." },
            { q: "Initial clinical manifestation of Stevens-Johnson Syndrome (SJS) that requires immediate emergency evaluation?", a: "Flu-like prodrome followed by a painful, blistering rash and mucosal involvement." },
            { q: "Most crucial step in managing a patient who develops a rash on lamotrigine?", a: "Immediate discontinuation of lamotrigine." },
            { q: "Early gastrointestinal symptoms indicating acute lithium toxicity?", a: "Nausea, vomiting, and severe diarrhea." },
            { q: "Neurological signs associated with moderate to severe lithium toxicity?", a: "Coarse tremors, ataxia, dysarthria, hyperreflexia, and seizures." },
            { q: "Most common precipitating factor for chronic lithium toxicity?", a: "Volume depletion or renal impairment (e.g., from NSAIDs, thiazide diuretics, or ACE inhibitors)." },
            { q: "Drug class that increases lithium levels by decreasing renal clearance at the distal tubule?", a: "Thiazide diuretics." },
            { q: "Analgesic class that decreases renal blood flow and increases lithium levels?", a: "Nonsteroidal anti-inflammatory drugs (NSAIDs), excluding aspirin." },
            { q: "Initial management for mild to moderate acute lithium toxicity with stable vitals?", a: "Aggressive intravenous normal saline hydration." },
            { q: "Definitive treatment indicated for lithium levels $>4.0\\text{ mEq/L}$ (or $>2.5\\text{ mEq/L}$ with severe neurological signs)?", a: "Hemodialysis." },
            { q: "Cardiovascular complications responsible for most fatalities in TCA overdose?", a: "Cardiac conduction delays, ventricular arrhythmias, and hypotension." },
            { q: "ECG finding that is the most reliable predictor of seizures and arrhythmias in TCA overdose?", a: "QRS duration greater than 100 milliseconds." },
            { q: "Specific ECG change in lead aVR highly suggestive of TCA toxicity?", a: "Terminal $R$ wave $>3\\text{ mm}$ in lead aVR." },
            { q: "Pathophysiology behind QRS widening in TCA overdose?", a: "Blockade of fast axonal myocardial voltage-gated sodium channels." },
            { q: "Immediate first-line treatment for a patient with TCA overdose and a QRS $>100\\text{ ms}$?", a: "Intravenous sodium bicarbonate ($\\text{NaHCO}_3$)." },
            { q: "Mechanism by which sodium bicarbonate treats TCA-induced cardiac toxicity?", a: "Increases extracellular sodium concentration and alkalizes serum to decrease drug binding to sodium channels." },
            { q: "Triad of clinical signs diagnostic of acute opioid overdose?", a: "Respiratory depression, miosis (pinpoint pupils), and altered mental status." },
            { q: "Immediate antidote administered for respiratory depression in opioid overdose?", a: "Naloxone." },
            { q: "Mechanism of action of naloxone?", a: "Competitive opioid receptor antagonist." },
            { q: "Severe, life-threatening complication of abrupt alcohol or sedative-hypnotic withdrawal?", a: "Delirium Tremens (DTs)." },
            { q: "Typical timeline for the onset of Delirium Tremens after the last drink?", a: "48 to 96 hours." },
            { q: "Autonomic and neurological signs that define Delirium Tremens?", a: "Severe tachycardia, hypertension, diaphoresis, global confusion, and vivid hallucinations." },
            { q: "First-line pharmacological class used to treat and prevent seizures in alcohol withdrawal?", a: "Benzodiazepines (e.g., diazepam, chlordiazepoxide, lorazepam)." },
            { q: "Preferred benzodiazepines for alcohol withdrawal in patients with severe hepatic impairment?", a: "Lorazepam, Oxazepam, and Temazepam (the \"LOT\" drugs metabolized via glucuronidation)." },
            { q: "Neurological condition caused by acute thiamine deficiency in chronic alcohol use disorder?", a: "Wernicke's encephalopathy." },
            { q: "Clinical triad characterizing Wernicke's encephalopathy?", a: "Encephalopathy (confusion), oculomotor dysfunction (nystagmus/ophthalmoplegia), and gait ataxia." },
            { q: "Irreversible amnestic disorder that can develop if Wernicke's encephalopathy is left untreated?", a: "Korsakoff's syndrome." },
            { q: "Crucial administration sequence for thiamine and glucose in an emergency setting?", a: "Administer thiamine before or concurrently with glucose to prevent worsening encephalopathy." },
            { q: "Life-threatening complication of severe cocaine or amphetamine intoxication?", a: "Hypertensive crisis, myocardial infarction, or aortic dissection." },
            { q: "Antihypertensive drug class contraindicated in acute cocaine intoxication due to risk of unopposed $\\alpha$-stimulation?", a: "Pure $\\beta$-blocker (e.g., propranolol)." },
            { q: "Preferred first-line agent to manage agitation and hypertension in stimulant toxicity?", a: "Benzodiazepines." },
            { q: "Dissociative anesthetic toxicity characterized by nystagmus (horizontal, vertical, or rotary) and extreme agitation?", a: "Phencyclidine (PCP) intoxication." },
            { q: "Reversal agent used for severe, isolated benzodiazepine overdose?", a: "Flumazenil." },
            { q: "Major risk and contraindication associated with flumazenil administration in chronic benzodiazepine users?", a: "Precipitation of severe, treatment-resistant seizures." },
            { q: "Highest predictive demographic risk factor for completed suicide?", a: "Male sex." },
            { q: "Highest overall clinical predictive risk factor for future suicide completion?", a: "History of previous suicide attempts." },
            { q: "First priority in management when evaluating an actively violent or agitated patient?", a: "Ensuring the safety of the patient and medical staff." },
            { q: "Ideal physical setup for an interview room with a potentially volatile patient?", a: "The physician sits closest to the door with an unobstructed exit path." },
            { q: "Preferred medication combination for rapid chemical restraint of an acutely agitated, violent patient?", a: "Haloperidol and lorazepam (often administered together intramuscularly)." },
            { q: "Paradoxical reaction that can occur when administering benzodiazepines to elderly or delirious patients?", a: "Increased agitation, disinhibition, and confusion." },
            { q: "Clinical definition of suicidal ideation with plan and intent?", a: "The patient has a specific method chosen and expresses an active purpose to end their life." },
            { q: "Immediate intervention required for a patient presenting with active suicidal intent and plan?", a: "Involuntary psychiatric admission or continuous 1-to-1 safety observation." },
            { q: "Legal criteria required for involuntary psychiatric commitment in almost all jurisdictions?", a: "Presence of a mental illness causing an imminent danger to self, danger to others, or grave disability." },
            { q: "Definition of \"grave disability\" in psychiatric emergency law?", a: "Inability to provide for one's own basic needs (food, clothing, shelter) due to a mental illness." },
            { q: "Does involuntary commitment automatically strip a competent psychiatric patient of their right to refuse psychiatric medications?", a: "No, involuntary commitment and the right to refuse medication are legally distinct issues." },
            { q: "Legal term for the state's authority to protect individuals who cannot protect themselves?", a: "Parens patriae." },
            { q: "Legal term for the state's authority to protect citizens from dangerous individuals?", a: "Police power." },
            { q: "Supreme Court case establishing that a state cannot confine a non-dangerous individual who can survive safely in freedom?", a: "O'Connor v. Donaldson (1975)." },
            { q: "Legal precedent established by Tarasoff v. Regents of the University of California?", a: "The duty of a mental health professional to protect or warn an identifiable third party threatened by a patient." },
            { q: "First action a clinician must take under the Tarasoff \"duty to protect\" ruling?", a: "Notify law enforcement and make reasonable efforts to warn the intended victim." },
            { q: "Standard of proof required for civil commitment according to Addington v. Texas?", a: "Clear and convincing evidence." },
            { q: "General maximum duration for an emergency psychiatric hold before a formal judicial hearing is required?", a: "72 hours (excluding weekends and holidays)." },
            { q: "Term for a legal document written by a competent individual directing future psychiatric care in the event of incapacitation?", a: "Psychiatric Advance Directive (PAD)." },
            { q: "Legal exception to patient-psychiatrist confidentiality in an emergency department?", a: "Imminent threat of harm to self or an identifiable other." },
            { q: "Clinical scenario where a surrogate decision-maker is sought for a psychiatric patient?", a: "When the patient is formally deemed to lack decision-making capacity due to an acute psychiatric state." },
            { q: "Four components required to establish clinical decision-making capacity?", a: "Ability to communicate a choice, understand relevant information, appreciate the situation/consequences, and reason logically." },
            { q: "Difference between competency and capacity?", a: "Competency is a global legal determination made by a judge; capacity is a situation-specific clinical assessment made by a physician." },
            { q: "Severe behavioral syndrome characterized by immobility, mutism, posturing, and echolalia?", a: "Catatonia." },
            { q: "Definition of \"waxy flexibility\" in catatonia?", a: "The patient's limbs retain positions into which they are placed by the examiner." },
            { q: "Diagnostic bedside challenge used to confirm a diagnosis of catatonia?", a: "Lorazepam (or Amobarbital) challenge test." },
            { q: "First-line pharmacological treatment for catatonia?", a: "High-dose benzodiazepines (typically lorazepam)." },
            { q: "Definitive, highly effective non-pharmacological treatment for malignant catatonia refractory to medication?", a: "Electroconvulsive Therapy (ECT)." },
            { q: "Sudden, profound cardiovascular collapse and hyperthermia occurring during a severe episode of catatonia?", a: "Malignant catatonia." },
            { q: "Condition characterized by a patient intentionally feigning physical or psychological symptoms solely for primary psychological gain (the sick role)?", a: "Factitious disorder." },
            { q: "Condition characterized by intentional production of false or grossly exaggerated symptoms motivated by secondary external incentives (e.g., money, avoiding work)?", a: "Malingering." },
            { q: "Sudden onset of neurological symptoms (e.g., paralysis, blindness) that cannot be explained by a medical disease, often preceded by a stressor?", a: "Conversion disorder (Functional Neurological Symptom Disorder)." },
            { q: "Best initial management strategy for a patient diagnosed with Conversion Disorder?", a: "Education about the diagnosis and physical therapy." },
            { q: "Life-threatening hematologic adverse effect of clozapine requiring mandatory strict monitoring?", a: "Agranulocytosis." },
            { q: "Lab value absolute neutrophil count (ANC) threshold requiring immediate and permanent discontinuation of clozapine?", a: "ANC less than $1,000/\\mu\\text{L}$ (or $<500/\\mu\\text{L}$ for benign ethnic neutropenia)." },
            { q: "Mandatory lab monitoring schedule for clozapine during the first 6 months of treatment?", a: "Weekly Absolute Neutrophil Count (ANC)." },
            { q: "Potentially fatal cardiovascular complication of clozapine that typically occurs within the first few weeks of initiation?", a: "Myocarditis." },
            { q: "Symptoms that should prompt an immediate emergency ECG and troponin level in a patient taking clozapine?", a: "Unexplained chest pain, tachycardia, dyspnea, or flu-like symptoms." },
            { q: "Gastrointestinal emergency caused by clozapine's profound anticholinergic properties?", a: "Clozapine-induced gastrointestinal hypomotility (paralytic ileus/bowel obstruction)." },
            { q: "Acute, fluctuating disturbance in attention, awareness, and cognition, highly common in elderly emergency settings?", a: "Delirium." },
            { q: "Most common underlying medical etiology for new-onset delirium in an elderly patient?", a: "Urinary tract infection (UTI) or systemic infection." },
            { q: "Behavioral emergency in pediatric patients characterized by severe, recurrent temper outbursts grossly out of proportion to the situation?", a: "Disruptive Mood Dysregulation Disorder (DMDD)." },
            { q: "First-line approach for managing a pediatric patient presenting with an acute, non-suicidal behavioral temper tantrum?", a: "De-escalation techniques and providing a low-stimulation environment." },
            { q: "Rare but life-threatening complication of using SSRIs in children and adolescents that requires close emergency safety monitoring?", a: "Treatment-emergent suicidal ideation and behavior." },
            { q: "Life-threatening dietary interaction caused by consuming tyramine-rich foods while taking a Monoamine Oxidase Inhibitor (MAOI)?", a: "Hypertensive crisis." },
            { q: "Pathophysiology behind the MAOI-tyramine hypertensive crisis?", a: "Uninhibited release of endogenous norepinephrine due to displacement by tyramine." },
            { q: "Examples of tyramine-rich foods patients on MAOIs must avoid?", a: "Aged cheeses, cured meats, red wine, and draft beers." },
            { q: "First-line intravenous antihypertensive class used to reverse an MAOI-induced hypertensive crisis?", a: "$\\alpha_1$ receptor antagonists (e.g., phentolamine)." },
            { q: "Severe endocrine abnormality caused by SSRIs, especially in elderly patients, presenting with lethargy and confusion?", a: "Syndrome of Inappropriate Antidiuretic Hormone secretion (SIADH)." },
            { q: "Electrolyte abnormality diagnostic of SSRI-induced SIADH?", a: "Euvolemic hyponatremia." },
            { q: "Antipsychotic medication class with the highest risk of prolonging the QTc interval?", a: "Intravenous haloperidol and certain atypicals (e.g., ziprasidone, thioridazine)." },
            { q: "Fatal cardiac arrhythmia that can be precipitated by a QTc interval exceeding 500 milliseconds?", a: "Torsades de Pointes." },
            { q: "Immediate intravenous electrolyte treatment for stabilization of Torsades de Pointes?", a: "Magnesium sulfate." },
            { q: "Serious pulmonary medical emergency that can present as an acute panic attack with dyspnea and pleuritic chest pain?", a: "Pulmonary embolism." },
            { q: "Rare but severe adverse effect of trazodone requiring urgent urological intervention?", a: "Priapism." },
            { q: "Acute, transient psychiatric state occurring within 3 days to 1 month of exposure to a traumatic event?", a: "Acute Stress Disorder (ASD)." },
            { q: "Crucial timeline boundary that differentiates Acute Stress Disorder from Post-Traumatic Stress Disorder (PTSD)?", a: "Symptoms lasting longer than 1 month indicate PTSD." },
            { q: "State of profound confusion where a patient suddenly travels away from home and cannot recall their past identity?", a: "Dissociative fugue." },
            { q: "Immediate medical action required when a patient arrives in the ED claiming they have been sexually assaulted?", a: "Forensic medical evaluation using a sexual assault evidence collection kit, along with emergency contraception and prophylactic antibiotics." },
            { q: "Psychiatric condition where physical restraints are strictly contraindicated due to the risk of worsening hyperthermia and rhabdomyolysis?", a: "Excited delirium syndrome." },
            { q: "Legal standard used to determine if a defendant was insane at the time of a crime based on the inability to know right from wrong?", a: "The M'Naghten Rule." },
            { q: "Legal exception allowing emergency treatment without explicit informed consent?", a: "Emergency privilege (when delaying treatment to obtain consent would result in imminent serious harm or death)." },
            { q: "Key autonomic vital sign abnormality that differentiates Serotonin Syndrome/NMS from a pure severe panic attack?", a: "High-grade hyperthermia (panic attacks do not cause true hyperthermia)." },
            { q: "Neuromuscular finding that differentiates Malignant Hyperthermia (from volatile anesthetics) from NMS?", a: "Malignant hyperthermia causes immediate, generalized rigidity following anesthesia induction, whereas NMS develops over hours to days following antipsychotic use." },
            { q: "Specific physical exam maneuver used to elicit latent clonus in suspected mild Serotonin Syndrome?", a: "Rapidly dorsiflexing the patient's foot to assess for sustained ankle clonus." },
            { q: "Pupillary difference between anticholinergic toxicity and Serotonin Syndrome?", a: "Both cause mydriasis, but anticholinergic toxicity presents with completely dry skin, whereas Serotonin Syndrome presents with profuse diaphoresis." },
            { q: "Key laboratory finding that differentiates Factitious Disorder from Malingering?", a: "There are no specific lab findings, as the differentiation relies entirely on identifying the presence or absence of an external, secondary gain." },
            { q: "Over-the-counter cough suppressant that can precipitate Serotonin Syndrome when combined with an SSRI?", a: "Dextromethorphan." },
            { q: "Antibiotic with intrinsic MAOI activity that can precipitate Serotonin Syndrome when given to a patient on an antidepressant?", a: "Linezolid." },
            { q: "Opioid analgesic contraindicated in patients taking MAOIs due to severe risk of Serotonin Syndrome?", a: "Meperidine." },
            { q: "Herbal supplement commonly used for depression that can precipitate Serotonin Syndrome?", a: "St. John's Wort." },
            { q: "Severe metabolic side effect of second-generation antipsychotics (like olanzapine) that can present as an acute diabetic emergency?", a: "Diabetic Ketoacidosis (DKA) or Hyperosmolar Hyperglycemic State (HHS)." },
            { q: "Electrocardiogram monitoring requirement for a patient receiving intravenous haloperidol for acute delirium?", a: "Continuous telemetry monitoring to watch for QTc prolongation." },
            { q: "Definitive management for a patient on clozapine who presents with an Absolute Neutrophil Count (ANC) of $850/\\mu\\text{L}$?", a: "Immediate and permanent cessation of clozapine and daily ANC monitoring." },
            { q: "Benign ethnic neutropenia (BEN) adjustments for clozapine require a lower baseline ANC threshold of what value?", a: "$1,500/\\mu\\text{L}$ to initiate, and must be discontinued if it drops below $500/\\mu\\text{L}$." },
            { q: "Toxic byproduct of metabolized sodium nitroprusside sometimes used in hypertensive emergencies that presents with psychosis and metabolic acidosis?", a: "Cyanide toxicity." },
            { q: "Antipsychotic medication most notorious for causing severe, acute obstructive sialadenitis (salivary gland swelling) or sialorrhea as an emergency presentation?", a: "Clozapine." },
            { q: "Landmark Supreme Court case establishing that involuntary civil commitment requires the state to prove the individual is both mentally ill and actively dangerous?", a: "O'Connor v. Donaldson." },
            { q: "Landmark case establishing that a patient committed involuntarily still retains the right to refuse antipsychotic medications in non-emergency situations?", a: "Rogers v. Okin." },
            { q: "Court case that established the standard that a criminal defendant must understand the charges against them and be able to assist their attorney?", a: "Dusky v. United States (Competency to stand trial)." },
            { q: "Specific legal standard that shifted the Tarasoff ruling from a \"duty to warn\" to a broader \"duty to protect\"?", a: "Tarasoff II (allowing options like clinical hospitalization or warning law enforcement instead of just the victim)." },
            { q: "Under what specific clinical condition can a physician override a patient's right to refuse medication without a court order?", a: "An acute emergency where the patient poses an immediate, physical danger to themselves or others in the unit." },
            { q: "Legal designation for a court-appointed individual who manages the financial and personal affairs of an individual deemed legally incompetent?", a: "Conservator or Guardian." },
            { q: "Does a patient's family member have the legal right to view a psychiatric note regarding an emergency admission without the patient's consent?", a: "No, psychiatric notes are protected under HIPAA laws unless an emergency exception applies." },
            { q: "Legal term used when a physician holds a patient in the hospital against their will without documenting formal involuntary commitment papers?", a: "False imprisonment." },
            { q: "First and most essential verbal strategy when managing an escalating, uncooperative patient?", a: "Verbal de-escalation using a calm tone, validating distress, and establishing clear boundaries." },
            { q: "Maximum time limit allowed for a single adult physical restraint order before a physician must re-evaluate the patient face-to-face?", a: "Four hours." },
            { q: "Maximum time limit allowed for a physical restraint order for a child or adolescent (ages 9–17)?", a: "Two hours." },
            { q: "Immediate physical hazard that must be monitored continuously while a patient is in four-point leather restraints?", a: "Airway patency and peripheral vascular perfusion." },
            { q: "Serious metabolic consequence of prolonged, forceful physical struggle against restraints in an agitated patient?", a: "Metabolic acidosis and worsening rhabdomyolysis." },
            { q: "Drug of choice for acute behavioral control in an agitated patient with known prolonged QTc interval?", a: "Lorazepam (as it does not significantly alter the QTc interval)." },
            { q: "Why are intramuscular atypicals like olanzapine or ziprasidone preferred over haloperidol in patients with mild-to-moderate QTc baseline elevations?", a: "They carry a statistically lower immediate risk of inducing Torsades de Pointes." },
            { q: "Diagnostic criteria minimum number of symptoms required to diagnose catatonia under DSM-5-TR?", a: "Three or more out of twelve characteristic symptoms." },
            { q: "Definition of \"catalepsy\" in catatonia?", a: "Passive induction of a posture held against gravity." },
            { q: "Definition of \"mitmachen\" in catatonia?", a: "The patient moves their body in response to slight pressure despite being told to resist." },
            { q: "Definition of \"gegenhalten\" (negativism) in catatonia?", a: "The patient resists all passive movements with a force proportional to that applied by the examiner." },
            { q: "Immediate physiological indication for emergent Electroconvulsive Therapy (ECT)?", a: "Malignant catatonia with autonomic instability or severe, life-threatening food refusal." },
            { q: "Absolute medical contraindication to performing Electroconvulsive Therapy (ECT)?", a: "There are no absolute medical contraindications to ECT, only conditions of increased risk (e.g., increased intracranial pressure)." },
            { q: "Most common immediate cognitive side effect observed post-ECT?", a: "Transient anterograde and retrograde amnesia." },
            { q: "First-line medication used to safely manage emergent agitation in a pregnant patient?", a: "High-potency typical antipsychotics (e.g., haloperidol)." },
            { q: "Primary emergency concern when a postpartum mother presents with severe command auditory hallucinations to harm her infant?", a: "Postpartum psychosis, requiring immediate involuntary hospitalization to protect the infant." },
            { q: "Street drug known as \"Spice\" or \"K2\" that presents as an unpredictable psychiatric emergency with severe psychosis and tachyarrhythmias?", a: "Synthetic cannabinoids." },
            { q: "Recreational drug inhalation (\"whippets\") that can present with acute panic, paranoia, and subacute combined degeneration of the spinal cord?", a: "Nitrous oxide (causing vitamin $B_{12}$ inactivation)." },
            { q: "Drug toxicity presenting with a combination of vertical nystagmus, high pain tolerance, and extreme, unpredictable violence?", a: "Phencyclidine (PCP) intoxication." },
            { q: "Life-threatening withdrawal syndrome characterized by severe autonomic hyperactivity, formication (feeling bugs crawling), and tactile hallucinations?", a: "Severe alcohol withdrawal / Delirium Tremens." },
            { q: "Antidote for severe cardiotoxicity and widened QRS secondary to diphenhydramine overdose?", a: "Sodium bicarbonate (due to diphenhydramine's sodium-channel blocking properties at high doses)." },
            { q: "Can a patient who is actively hallucinating still possess the capacity to make a specific medical decision?", a: "Yes, if the hallucinations do not impair or interfere with the specific logic needed for that decision." },
            { q: "Most appropriate action if a patient lacks capacity and requires emergency surgery, but no surrogate decision-maker is contactable?", a: "Proceed with the surgery under the legal doctrine of emergency implied consent." },
            { q: "Key difference between non-suicidal self-injury (NSSI) and a suicide attempt?", a: "NSSI is performed without any intent to die, usually to alleviate severe negative emotional states." },
            { q: "Best predictor of immediate, near-term suicide risk during an emergency psychiatric evaluation?", a: "The presence of severe hopelessness joined with a specific, lethal plan and high intent." },
            { q: "Primary clinical management strategy for a patient presenting with an explicit suicide plan involving a firearm stored at home?", a: "Direct counseling on lethal means restriction, requiring the removal or secure locking of the firearm by a third party." }
          ]
        },
{
          section: 'Psychiatry',
          topic: "Psychopharmacology essentials",
          icon: 'brain',
          cards: [
            { q: "Mechanism of action of Selective Serotonin Reuptake Inhibitors (SSRIs)?", a: "Inhibition of the presynaptic serotonin transporter (SERT) pump, increasing synaptic serotonin levels." },
            { q: "First-line medication class for Generalized Anxiety Disorder (GAD), Panic Disorder, and Social Anxiety Disorder?", a: "Selective Serotonin Reuptake Inhibitors (SSRIs)." },
            { q: "SSRI with the longest half-life and no need for tapering when discontinued?", a: "Fluoxetine." },
            { q: "SSRI most commonly associated with QTc prolongation at higher doses?", a: "Citalopram." },
            { q: "SSRI with the highest risk for GI side effects and standardly approved for OCD?", a: "Fluvoxamine." },
            { q: "SSRI with the shortest half-life and highest risk for discontinuation syndrome?", a: "Paroxetine." },
            { q: "Mechanism of action of Serotonin-Norepinephrine Reuptake Inhibitors (SNRIs)?", a: "Inhibition of both serotonin (SERT) and norepinephrine (NET) presynaptic transporters." },
            { q: "Primary vital sign abnormality to monitor in patients taking high-dose Venlafaxine?", a: "Elevated blood pressure (hypertension)." },
            { q: "FDA-approved SNRI preferred for the dual treatment of depression and chronic musculoskeletal/neuropathic pain?", a: "Duloxetine." },
            { q: "Active metabolite of venlafaxine requiring minimal hepatic metabolism?", a: "Desvenlafaxine." },
            { q: "Main mechanism of action of Bupropion?", a: "Norepinephrine-dopamine reuptake inhibitor (NDRI)." },
            { q: "Major clinical contraindication for the use of Bupropion?", a: "Seizure disorders and history of bulimia or anorexia nervosa." },
            { q: "Preferred antidepressant for a patient concerned with sexual dysfunction or weight gain?", a: "Bupropion." },
            { q: "Mechanism of action of Mirtazapine?", a: "$\\alpha_2$ adrenergic receptor antagonist that increases release of serotonin and norepinephrine." },
            { q: "Two primary dose-dependent side effects of Mirtazapine at lower doses?", a: "Sedation and increased appetite leading to weight gain." },
            { q: "Mechanism of action of Trazodone?", a: "Serotonin antagonist and reuptake inhibitor (SARI)." },
            { q: "Rare but emergency medical adverse effect associated with Trazodone use?", a: "Priapism." },
            { q: "Mechanism of action of Vilazodone?", a: "SSRI combined with $\\text{$\\text{5-HT}$}_{1\\text{A}}$ receptor partial agonism." },
            { q: "Mechanism of action of Vortioxetine?", a: "Serotonin modulator and stimulator (SMS) via SERT inhibition and multiple $\\text{5-HT}$ receptor variations." },
            { q: "Mechanism of action of Tricyclic Antidepressants (TCAs)?", a: "Inhibition of SERT and NET, along with blockade of histamine, acetylcholine, and $\\alpha_1$ receptors." },
            { q: "Primary cause of lethality in a Tricyclic Antidepressant (TCA) overdose?", a: "Cardiac arrhythmias due to blockade of fast sodium channels." },
            { q: "Immediate EKG finding that indicates a severe TCA overdose?", a: "Widened QRS complex greater than 100 milliseconds." },
            { q: "Antidote used to treat cardiac toxicity and QRS widening in TCA overdose?", a: "Sodium bicarbonate." },
            { q: "Mechanism of action of Monoamine Oxidase Inhibitors (MAOIs)?", a: "Irreversible inhibition of monoamine oxidase enzymes (MAO-A and MAO-B), preventing breakdown of monoamines." },
            { q: "Life-threatening complication that occurs when a patient on an MAOI consumes tyramine-rich foods?", a: "Hypertensive crisis." },
            { q: "Minimum washout period required when switching from most SSRIs to an MAOI?", a: "Two weeks." },
            { q: "Specific washout period required when switching from Fluoxetine to an MAOI?", a: "Five weeks." },
            { q: "Triad of clinical signs that define Serotonin Syndrome?", a: "Autonomic instability, altered mental status, and neuromuscular hyperactivity." },
            { q: "Specific physical exam finding that distinguishes Serotonin Syndrome from Neuroleptic Malignant Syndrome?", a: "Hyperreflexia and clonus." },
            { q: "First-line medication used for the pharmacological management of severe Serotonin Syndrome?", a: "Cyproheptadine." },
            { q: "Primary therapeutic mechanism of First-Generation Antipsychotics (FGAs)?", a: "Strong, high-affinity antagonism of post-synaptic Dopamine $\\text{D}_2$ receptors." },
            { q: "Dopaminergic pathway targeted to reduce positive symptoms of schizophrenia?", a: "Mesolimbic pathway." },
            { q: "Dopaminergic pathway responsible for extrapyramidal symptoms (EPS) during antipsychotic therapy?", a: "Nigrostriatal pathway." },
            { q: "Dopaminergic pathway responsible for hyperprolactinemia during $\\text{D}_2$ receptor blockade?", a: "Tuberoinfundibular pathway." },
            { q: "High-potency First-Generation Antipsychotic most notorious for causing extrapyramidal symptoms?", a: "Haloperidol." },
            { q: "Low-potency FGA associated with corneal deposits and pigmentary retinopathy?", a: "Chlorpromazine." },
            { q: "Low-potency FGA known for causing retinal pigmentation and significant QTc prolongation?", a: "Thioridazine." },
            { q: "Definition and timeline of Acute Dystonia?", a: "Sudden, painful muscle spasms of the neck, face, or tongue occurring within hours to days of starting antipsychotics." },
            { q: "First-line treatment for an acute dystonic reaction?", a: "Intramuscular Benztropine or Diphenhydramine." },
            { q: "Definition and clinical presentation of Akathisia?", a: "Subjective feeling of inner restlessness and the physical compulsion to move, typically occurring within days to weeks." },
            { q: "First-line pharmacological options for the treatment of Akathisia?", a: "Propranolol or Benzodiazepines." },
            { q: "Presentation and timeline of Antipsychotic-Induced Parkinsonism?", a: "Bradykinesia, rigidity, and a resting tremor occurring within weeks to months of treatment initiation." },
            { q: "Preferred management for drug-induced parkinsonism if the antipsychotic cannot be lowered?", a: "Benztropine or Amantadine." },
            { q: "Definition and timeline of Tardive Dyskinesia?", a: "Involuntary, choreoathetotic movements of the mouth, tongue, and face following months to years of antipsychotic use." },
            { q: "Mechanism of action of medications approved to treat Tardive Dyskinesia (e.g., Valbenazine, Deutetrabenazine)?", a: "Vesicular monoamine transporter 2 (VMAT2) inhibitors." },
            { q: "Tetrad of symptoms defining Neuroleptic Malignant Syndrome (NMS)?", a: "Severe \"lead-pipe\" muscle rigidity, hyperthermia, autonomic instability, and altered mental status." },
            { q: "Laboratory marker characteristically elevated in Neuroleptic Malignant Syndrome?", a: "Creatine kinase (CK)." },
            { q: "Two primary pharmacological agents used to treat severe Neuroleptic Malignant Syndrome?", a: "Dantrolene and Bromocriptine." },
            { q: "Primary therapeutic mechanism of Second-Generation Antipsychotics (SGAs)?", a: "Dual antagonism of Serotonin $\\text{$\\text{5-HT}$}_{2\\text{A}}$ and Dopamine $\\text{D}_2$ receptors." },
            { q: "Gold-standard antipsychotic reserved for treatment-resistant schizophrenia?", a: "Clozapine." },
            { q: "Black box warning and mandatory laboratory monitoring parameter required for Clozapine?", a: "Severe neutropenia/agranulocytosis requiring absolute neutrophil count (ANC) tracking." },
            { q: "Threshold absolute neutrophil count (ANC) below which Clozapine must be immediately discontinued?", a: "Less than 1,000 per microliter." },
            { q: "Two Second-Generation Antipsychotics with the highest risk for causing metabolic syndrome?", a: "Olanzapine and Clozapine." },
            { q: "Two Second-Generation Antipsychotics with the lowest risk for metabolic syndrome and weight gain?", a: "Aripiprazole and Ziprasidone." },
            { q: "Second-Generation Antipsychotic requiring administration with food to ensure adequate absorption?", a: "Ziprasidone (or Lurasidone)." },
            { q: "Specific mechanism of action that differentiates Aripiprazole from most other SGAs?", a: "Partial $\\text{D}_2$ receptor agonism." },
            { q: "Second-Generation Antipsychotic with the highest propensity to elevate prolactin levels?", a: "Risperidone." },
            { q: "Antipsychotic preferred for managing psychosis in patients with Parkinson's disease due to low $\\text{D}_2$ affinity?", a: "Quetiapine." },
            { q: "First-line maintenance medication for Bipolar I disorder with proven anti-suicidal properties?", a: "Lithium." },
            { q: "Maintenance laboratory monitoring parameters required for a patient on Lithium?", a: "Thyroid function tests (TSH), renal function tests (BUN/Creatinine), and serum Lithium levels." },
            { q: "Target therapeutic serum concentration range for Lithium maintenance therapy?", a: "0.6 to 1.2 mEq/L." },
            { q: "Common ECG change seen with therapeutic Lithium use?", a: "T-wave flattening or inversion." },
            { q: "Renal side effect of Lithium characterized by polyuria and polydipsia?", a: "Nephrogenic Diabetes Insipidus." },
            { q: "Medication class that can dangerously increase serum Lithium levels by decreasing renal clearance?", a: "Thiazide diuretics (or NSAIDs/ACE inhibitors)." },
            { q: "Congenital cardiac anomaly associated with Lithium use during the first trimester of pregnancy?", a: "Ebstein's anomaly." },
            { q: "Mechanism of action of Valproic Acid (Valproate)?", a: "Blocks voltage-gated sodium channels and increases GABA concentrations in the brain." },
            { q: "Two major organ systems at risk for acute toxicity from Valproic Acid?", a: "Hepatic (hepatotoxicity) and Pancreatic (acute pancreatitis)." },
            { q: "Congenital malformation associated with maternal Valproic Acid use during pregnancy?", a: "Neural tube defects (e.g., spina bifida)." },
            { q: "Mechanism of action of Carbamazepine?", a: "Blocks voltage-gated sodium channels, inhibiting repetitive neuronal firing." },
            { q: "Serious hematologic adverse effect associated with Carbamazepine use?", a: "Agranulocytosis and aplastic anemia." },
            { q: "Genetic allele strongly associated with Stevens-Johnson Syndrome in Asian patients taking Carbamazepine?", a: "HLA-B*1502." },
            { q: "Unique pharmacokinetic property of Carbamazepine regarding its own metabolism?", a: "Autoinduction of its own metabolism via the CYP3A4 enzyme system." },
            { q: "Mood stabilizer primarily used for bipolar depression maintenance that requires slow titration?", a: "Lamotrigine." },
            { q: "Life-threatening dermatologic adverse effect associated with rapid titration of Lamotrigine?", a: "Stevens-Johnson Syndrome (SJS) / Toxic Epidermal Necrolysis (TEN)." },
            { q: "Interaction effect when Valproate and Lamotrigine are co-administered?", a: "Valproate doubles Lamotrigine levels, drastically increasing SJS risk." },
            { q: "Mechanism of action of Benzodiazepines?", a: "Positive allosteric modulators that increase the frequency of $\\text{GABA}_\\text{A}$ channel opening." },
            { q: "Three Benzodiazepines that bypass phase I hepatic oxidation and undergo only phase II glucuronidation?", a: "Oxazepam, Temazepam, and Lorazepam (mnemonic: OTL / Outside The Liver)." },
            { q: "Benzodiazepine preferred for the management of acute alcohol withdrawal in a patient with severe liver cirrhosis?", a: "Lorazepam (or Oxazepam)." },
            { q: "Specific competitive antagonist used to reverse benzodiazepine-induced respiratory depression?", a: "Flumazenil." },
            { q: "Major clinical danger of administering Flumazenil to a patient with chronic benzodiazepine dependence?", a: "Precipitation of acute withdrawal seizures." },
            { q: "Mechanism of action of Buspirone?", a: "Partial agonist at the Serotonin $\\text{$\\text{5-HT}$}_{1\\text{A}}$ receptor." },
            { q: "Clinical timeline limitation of Buspirone for the treatment of generalized anxiety disorder?", a: "It takes 2 to 4 weeks to become clinically effective and cannot be used prn (as needed)." },
            { q: "Mechanism of action of \"Z-drugs\" (Zolpidem, Zaleplon, Eszopiclone)?", a: "Selective agonists at the $\\alpha_1$ subunit of the $\\text{GABA}_\\text{A}$ receptor complex." },
            { q: "Main clinical advantage of Z-drugs over standard Benzodiazepines for insomnia?", a: "Minimal disruption of normal sleep architecture and lower risk of dependence." },
            { q: "Mechanism of action of Ramelteon?", a: "Melatonin receptor (MT1 and MT2) agonist." },
            { q: "Mechanism of action of Suvorexant?", a: "Orexin receptor antagonist that turns off wakefulness signals." },
            { q: "First-line medication for opioid overdose causing respiratory depression?", a: "Naloxone." },
            { q: "Long-acting opioid agonist used for maintenance therapy in opioid use disorder?", a: "Methadone." },
            { q: "EKG abnormality that requires strict monitoring in patients on high-dose Methadone maintenance?", a: "QTc prolongation." },
            { q: "Mechanism of action of Buprenorphine?", a: "Partial $\\mu$-opioid receptor agonist with a high binding affinity." },
            { q: "Purpose of adding Naloxone to Buprenorphine in sublingual combination formulations (Suboxone)?", a: "To prevent intravenous abuse; naloxone has poor bioavailability unless injected." },
            { q: "Competitive opioid antagonist used to prevent relapse in both alcohol and opioid use disorders?", a: "Naltrexone." },
            { q: "Baseline laboratory test required before initiating Naltrexone therapy?", a: "Liver function tests (due to risk of hepatotoxicity)." },
            { q: "Mechanism of action of Disulfiram?", a: "Irreversible inhibition of aldehyde dehydrogenase, causing accumulation of acetaldehyde upon alcohol ingestion." },
            { q: "Mechanism of action of Acamprosate?", a: "Modulates NMDA glutamate receptors and $\\text{GABA}_\\text{A}$ receptors to restore neurochemical balance." },
            { q: "Contraindication for the use of Acamprosate in patients with alcohol use disorder?", a: "Severe renal impairment (Creatinine Clearance $\\1$ mL/min)." },
            { q: "First-line pharmacological treatments for smoking cessation?", a: "Varenicline and Bupropion." },
            { q: "Mechanism of action of Varenicline?", a: "$\\alpha$-4-$\\beta_2$ nicotinic acetylcholine receptor partial agonist." },
            { q: "First-line pharmacological class for Attention-Deficit/Hyperactivity Disorder (ADHD) in pediatric and adult populations?", a: "Stimulants (Methylphenidate and Amphetamines)." },
            { q: "Mechanism of action of Methylphenidate?", a: "Blocks the reuptake of dopamine and norepinephrine via transporter inhibition." },
            { q: "Mechanism of action of Amphetamines?", a: "Stimulates the presynaptic release of dopamine and norepinephrine into the synaptic cleft." },
            { q: "Non-stimulant medication approved for ADHD that acts as a selective norepinephrine reuptake inhibitor (NRI)?", a: "Atomoxetine." },
            { q: "Mechanism of action of Guanfacine and Clonidine when used for ADHD?", a: "$\\alpha_2$ adrenergic receptor agonists that strengthen prefrontal cortical networks." },
            { q: "Mechanism of action of Donepezil, Rivastigmine, and Galantamine?", a: "Acetylcholinesterase inhibitors used to increase synaptic acetylcholine in Alzheimer's dementia." },
            { q: "Mechanism of action of Memantine?", a: "Uncompetitive NMDA glutamate receptor antagonist that protects against excitotoxicity." },
            { q: "Pharmacological agent used to treat neuroleptic-induced sialorrhea (drooling) from Clozapine?", a: "Sublingual Atropine drops (or oral Terazosin)." },
            { q: "Antidepressant most likely to cause a dose-dependent increase in diastolic blood pressure?", a: "Venlafaxine." },
            { q: "Antipsychotic medication that must be taken with a meal of at least 350 calories to ensure bioavailability?", a: "Lurasidone." },
            { q: "Antidote used to treat acute anticholinergic toxicity (e.g., severe atropine or antihistamine overdose)?", a: "Physostigmine." },
            { q: "Preferred pharmacological treatment for Moderate to Severe Alcohol Withdrawal Syndrome in a hospital setting?", a: "Diazepam or Chlordiazepoxide (long-acting benzodiazepines)." },
            { q: "Antidepressant that acts as a potent $\\text{H}_1$ histamine antagonist, causing substantial sedation and weight gain?", a: "Mirtazapine." },
            { q: "Class of medications that can precipitate Serotonin Syndrome if combined with Linezolid?", a: "SSRIs or SNRIs (due to Linezolid's weak MAOI activity)." },
            { q: "Antipsychotic drug least likely to cause hyperprolactinemia due to its $\\text{D}_2$ partial agonism?", a: "Aripiprazole." },
            { q: "Medication class used as first-line adjunctive therapy for the autonomic symptoms of performance-based social anxiety?", a: "$\\beta$-blocker (e.g., Propranolol)." },
            { q: "Serious hematologic monitoring parameter required during the first 6 months of Clozapine therapy?", a: "Weekly Absolute Neutrophil Count (ANC)." },
            { q: "Mood stabilizer that undergoes zero hepatic metabolism and is excreted 100% unchanged by the kidneys?", a: "Lithium." },
            { q: "First-line treatment for Restless Legs Syndrome (RLS) if iron stores are normal?", a: "Dopamine agonists (Pramipexole or Ropinirole) or $\\alpha_2$-$\\delta$ ligands (Gabapentin)." },
            { q: "Antidepressant approved for the treatment of Bulimia Nervosa?", a: "Fluoxetine." },
            { q: "Medication class that can cause severe lithium toxicity by reducing renal perfusion?", a: "Nonsteroidal Anti-inflammatory Drugs (NSAIDs)." },
            { q: "Medication used to counteract antipsychotic-induced hyperprolactinemia if the primary drug cannot be stopped?", a: "Aripiprazole (added at low doses for its partial $\\text{D}_2$ agonism)." },
            { q: "Primary receptor blockade responsible for orthostatic hypotension caused by low-potency antipsychotics?", a: "$\\alpha_1$ adrenergic receptors." },
            { q: "Primary receptor blockade responsible for the blurry vision, dry mouth, and urinary retention seen with TCAs?", a: "Muscarinic acetylcholine receptors." },
            { q: "Active metabolite of Risperidone that has a lower risk of hepatic drug-drug interactions?", a: "Paliperidone." },
            { q: "Only Second-Generation Antipsychotic that carries an FDA indication for monotherapy in bipolar depression?", a: "Quetiapine." },
            { q: "Neurotransmitter system modulated by Acamprosate to reduce alcohol cravings?", a: "Glutamatergic (NMDA receptor modulation)." },
            { q: "Contraindication for using Naltrexone in a patient with alcohol use disorder?", a: "Acute hepatitis, liver failure, or concurrent opioid use." },
            { q: "Antidepressant that is a potent CYP2D6 inhibitor and can reduce the efficacy of Tamoxifen?", a: "Paroxetine (or Fluoxetine)." },
            { q: "First-line medication class for the treatment of Obsessive-Compulsive Disorder (OCD)?", a: "High-dose SSRIs." },
            { q: "Preferred long-term medication for a patient with comorbid Major Depressive Disorder and Migraines?", a: "Tricyclic Antidepressants (e.g., Amitriptyline)." },
            { q: "Class of medications most effective for treating panic attacks acutely?", a: "Benzodiazepines." },
            { q: "Antidepressant with a dual mechanism that makes it highly effective for treating smoking cessation?", a: "Bupropion." },
            { q: "Serious neurological risk of correcting chronic hyponatremia too rapidly with saline solutions?", a: "Central Pontine Myelinolysis (Osmotic Demyelination Syndrome)." },
            { q: "Life-threatening condition caused by combining Lithium with Haloperidol in high doses?", a: "Irreversible neurotoxicity and encephalopathy." },
            { q: "Antipsychotic medication that requires a baseline eye exam every 6 months according to historical guidelines?", a: "Quetiapine (due to early animal study concerns for cataracts, though rarely done now)." },
            { q: "Antipsychotic choice for an agitated patient who refuses oral medications and requires rapid tranquilization?", a: "Intramuscular Haloperidol or Olanzapine." },
            { q: "Medication class that should never be given concurrently with intramuscular Olanzapine due to risk of fatal cardiorespiratory depression?", a: "Intramuscular Benzodiazepines." },
            { q: "Substance of abuse that acts as a non-competitive NMDA receptor antagonist and can cause nystagmus and agitation?", a: "Phencyclidine (PCP)." },
            { q: "Antidote used for the treatment of Benzodiazepine withdrawal seizures?", a: "Intravenous Phenobarbital or a long-acting Benzodiazepine taper." },
            { q: "Mechanism of action of Topiramate when used off-label for alcohol use disorder?", a: "Potentiates $\\text{GABA}_\\text{A}$ receptors and inhibits AMPA/kainate glutamate receptors." },
            { q: "Common benign side effect of Lamotrigine that does not warrant discontinuation?", a: "Benign maculopapular rash (requires close monitoring to differentiate from SJS)." },
            { q: "Antipsychotic that has the most prominent risk of causing significant QTc prolongation without being a low-potency FGA?", a: "Ziprasidone." },
            { q: "Enzyme system responsible for the metabolism of most psychiatric drugs, including SSRIs and antipsychotics?", a: "Cytochrome P450 system." },
            { q: "Medication class that can cause severe hypertensive crisis if combined with foods containing tyramine?", a: "Monoamine Oxidase Inhibitors (MAOIs)." },
            { q: "Primary symptom of Benzodiazepine toxicity when combined with alcohol?", a: "Respiratory depression." },
            { q: "Mechanism of action of Hydroxyzine when used for acute anxiety?", a: "Histamine $\\text{H}_1$ receptor antagonist." },
            { q: "Non-habit-forming medication used for the long-term management of Generalized Anxiety Disorder?", a: "Buspirone." },
            { q: "Preferred treatment for severe, treatment-resistant Major Depressive Disorder with psychotic features when rapid response is needed?", a: "Electroconvulsive Therapy (ECT)." },
            { q: "Mechanism by which Lithium causes hypothyroidism?", a: "Inhibits thyroid hormone synthesis and release." },
            { q: "Target serum concentration of Lithium during an acute manic episode?", a: "1.0 to 1.5 mEq/L." },
            { q: "Mechanism of action of Atomoxetine?", a: "Selective Norepinephrine Reuptake Inhibitor." },
            { q: "First-line medication class for Narcolepsy management?", a: "Modafinil or Armodafinil." },
            { q: "Mechanism of action of Modafinil?", a: "Weak dopamine reuptake inhibitor that increases wakefulness." },
            { q: "Medication used to treat the depressive phase of Bipolar Disorder that is also an anticonvulsant?", a: "Lamotrigine." },
            { q: "Most common side effect of Acetylcholinesterase inhibitors used in Alzheimer's disease?", a: "Gastrointestinal upset (nausea, vomiting, diarrhea)." },
            { q: "Medication used for the treatment of severe, intractable hiccups?", a: "Chlorpromazine." },
            { q: "Preferred antidepressant for elderly patients due to its clean side effect profile and low drug interactions?", a: "Sertraline (or Escitalopram)." },
            { q: "Antidepressant class generally considered first-line for major depressive disorder during pregnancy and breastfeeding?", a: "Selective Serotonin Reuptake Inhibitors (SSRIs), excluding paroxetine." },
            { q: "Specific neonatal complication associated with SSRI use late in the third trimester?", a: "Persistent Pulmonary Hypertension of the Newborn (PPHN) or neonatal adaptation syndrome." },
            { q: "Neonatal physical exam finding characteristic of Neonatal Adaptation Syndrome following in utero SSRI exposure?", a: "Irritability, tachypnea, tremors, and weak cry resolving within days." },
            { q: "Gold-standard mood stabilizer preferred for acute mania in pregnancy if lithium or valproate must be avoided?", a: "Haloperidol (or Second-Generation Antipsychotics like Olanzapine)." },
            { q: "Floppy infant syndrome and neonatal respiratory depression are associated with maternal use of which class near delivery?", a: "Benzodiazepines." },
            { q: "Mechanism of action of Esketamine (nasal spray) used for treatment-resistant depression?", a: "Non-competitive NMDA glutamate receptor antagonist." },
            { q: "Mandatory post-administration monitoring protocol required for patients receiving Esketamine?", a: "Observation for at least two hours for sedation, dissociation, and blood pressure spikes." },
            { q: "First FDA-approved oral medication specifically for Postpartum Depression (PPD) acting as a $\\text{GABA}_\\text{A}$ receptor positive allosteric modulator?", a: "Zuranolone (or intravenous Brexanolone)." },
            { q: "Primary clinical indication for prescribing a Long-Acting Injectable (LAI) antipsychotic?", a: "History of poor medication adherence in patients with severe chronic psychotic disorders." },
            { q: "First-generation antipsychotic available as a decanoate formulation for long-acting injection?", a: "Haloperidol Decanoate (or Fluphenazine Decanoate)." },
            { q: "Second-generation long-acting injectable antipsychotic requiring a 3-hour post-injection observation window due to delirium-sedation syndrome risk?", a: "Olanzapine Pamoate." },
            { q: "Long-acting injectable antipsychotic that does not require an oral medication overlap period when initiated?", a: "Invega Sustenna (Paliperidone Palmitate)." },
            { q: "Common over-the-counter herbal supplement that induces CYP3A4 and can drastically lower concentrations of oral contraceptives and cyclosporine?", a: "St. John's Wort." },
            { q: "Lifestyle factor that induces CYP1A2, thereby lowering serum levels of Clozapine and Olanzapine?", a: "Cigarette smoking (specifically polycyclic aromatic hydrocarbons)." },
            { q: "Clinical consequence of a patient abruptly quitting smoking while maintaining their baseline Clozapine dose?", a: "Toxic rise in Clozapine levels, increasing seizure and agranulocytosis risks." },
            { q: "Mechanism by which Fluoxetine or Paroxetine co-administration renders Codeine ineffective for pain control?", a: "Inhibition of CYP2D6, preventing the conversion of Codeine to its active form, Morphine." },
            { q: "Dietary substance that inhibits intestinal CYP3A4, leading to toxic levels of certain benzodiazepines and buspirone?", a: "Grapefruit juice." },
            { q: "DEA Controlled Substance schedule classification for Benzodiazepines and Z-drugs?", a: "Schedule IV." },
            { q: "DEA Controlled Substance schedule classification for Methylphenidate and Amphetamine stimulants?", a: "Schedule II." },
            { q: "Primary clinical toxicity concern when combining a Benzodiazepine with a prescribed Opioid medication?", a: "Fatal respiratory depression via synergistic CNS depression." },
            { q: "Black box warning applied to all antidepressants regarding their use in children, adolescents, and young adults?", a: "Increased risk of suicidal ideation and behavior." },
            { q: "Serum Lithium concentration above which hemodialysis is strongly indicated regardless of clinical symptoms?", a: "Greater than 4.0 mEq/L (or greater than 2.5 mEq/L with severe neurological symptoms)." },
            { q: "Initial fluid management strategy for treating acute, mild-to-moderate Lithium toxicity?", a: "Aggressive intravenous hydration with 0.9% Normal Saline to promote renal clearance." },
            { q: "Cardiac dysrhythmia risk associated with high-dose intravenous Haloperidol administration?", a: "Torsades de Pointes via QTc prolongation." },
            { q: "Pharmacological management for an intentional overdose of $\\beta$-blocker used off-label for performance anxiety?", a: "Intravenous Glucagon." },
            { q: "Baseline screening test mandated before initiating any stimulant medication for ADHD to rule out structural anomalies?", a: "Thorough cardiac history and physical exam (EKG only if cardiac risk factors are present)." },
            { q: "Adjunctive medication used to treat the significant weight gain associated with Olanzapine therapy?", a: "Metformin (or Topiramate)." },
            { q: "Mechanism behind Second-Generation Antipsychotic induced metabolic syndrome?", a: "Antagonism of Histamine $\\text{H}_1$ and Serotonin $\\text{$\\text{5-HT}$}_{2\\text{C}}$ receptors stimulating appetite." },
            { q: "Antipsychotic medication least likely to cause QTc prolongation or metabolic syndrome, making it ideal for cardiac patients?", a: "Lurasidone (or Aripiprazole)." },
            { q: "Landmark clinical trial that established the efficacy and metabolic side effect profiles of Second-Generation Antipsychotics?", a: "The CATIE trial (Clinical Antipsychotic Trials of Intervention Effectiveness)." },
            { q: "Only antidepressant with a definitive indication for treating nocturnal enuresis (bedwetting) in children?", a: "Imipramine (a TCA)." },
            { q: "Minimum symptom duration required to diagnose Prolonged Grief Disorder in adults according to the DSM-5-TR?", a: "Twelve months following the loss of a loved one." },
            { q: "Minimum symptom duration required to diagnose Prolonged Grief Disorder in children and adolescents according to the DSM-5-TR?", a: "Six months following the loss of a loved one." },
            { q: "New condition added to the DSM-5-TR section \"Conditions That May Be a Focus of Clinical Attention\" to track self-harm behaviors?", a: "Suicidal Behavior and Nonsuicidal Self-Injury." },
            { q: "Outdated diagnostic terminology replaced by \"Intellectual Disability\" in the DSM-5-TR?", a: "Intellectual Developmental Disorder (or Mental Retardation in historical texts)." },
            { q: "Specific Obsessive-Compulsive Related Disorder that received a new diagnostic specifier (\"Olfactory Reference Disorder\") in the DSM-5-TR?", a: "Other Specified Obsessive-Compulsive and Related Disorder." },
            { q: "Major change to the Clozapine monitoring protocol implemented by the FDA?", a: "Elimination of the requirement to submit absolute neutrophil count (ANC) results directly to a central REMS registry prior to dispensing." },
            { q: "Mechanism of action of Lumateperone used for schizophrenia and bipolar depression?", a: "Potent $\\text{$\\text{5-HT}$}_{2\\text{A}}$ receptor antagonism combined with post-synaptic low $\\text{D}_2$ receptor antagonism and partial presynaptic $\\text{D}_2$ agonism." },
            { q: "Non-antipsychotic combination medication approved for treating agitation associated with Alzheimer’s disease dementia?", a: "Dextromethorphan-quinidine (or the newer NMDA/Sigma-1 formulation AXS-05)." },
            { q: "Mechanism of action of Topiramate when used for alcohol use disorder or weight mitigation?", a: "Potentiates $\\text{GABA}_\\text{A}$ receptors, inhibits AMPA/kainate glutamate receptors, and inhibits carbonic anhydrase." },
            { q: "Common cognitive side effect reported by patients taking Topiramate?", a: "Psychomotor slowing, word-finding difficulties, and memory impairment (often called \"Dopamax\")." },
            { q: "Non-selective $\\beta$-blocker used off-label to treat the physiological tremors of Lithium toxicity or performance anxiety?", a: "Propranolol." },
            { q: "Anticonvulsant metabolized into phenobarbital that is used off-label to treat severe essential tremors?", a: "Primidone." },
            { q: "Mechanism by which Cyproheptadine reverses Serotonin Syndrome?", a: "Non-selective serotonin receptor antagonist (primarily targeting $\\text{$\\text{5-HT}$}_{1\\text{A}}$ and $\\text{$\\text{5-HT}$}_{2\\text{A}}$ receptors)." },
            { q: "Primary toxic metabolite of Acetaminophen that builds up during an intentional overdose and causes hepatotoxicity?", a: "N-acetyl-p-benzoquinone imine (NAPQI)." },
            { q: "Specific antidote administered to replenish glutathione stores in an acute Acetaminophen overdose?", a: "N-acetylcysteine (NAC)." },
            { q: "Severe developmental delay and craniofacial abnormality caused by in utero exposure to Phenytoin?", a: "Fetal Hydantoin Syndrome." },
            { q: "Visual field defect uniquely associated with the long-term use of Vigabatrin?", a: "Permanent concentric peripheral visual field loss (bilateral visual field constriction)." },
            { q: "Documented risk that triggers a Black Box Warning for all atypical antipsychotics used to treat behavioral disturbances in elderly dementia patients?", a: "Increased risk of all-cause mortality, primarily due to cardiovascular events or infections." },
            { q: "Preferred long-acting benzodiazepine equivalent used strictly to manage alcohol withdrawal but avoided in the elderly due to active metabolites?", a: "Chlordiazepoxide." },
            { q: "Antidepressant class completely avoided in elderly patients with a history of falls or urinary retention due to anticholinergic properties?", a: "Tricyclic Antidepressants (TCAs)." },
            { q: "First-line medication used to manage acute delirium in an intensive care unit setting when non-pharmacological interventions fail?", a: "Low-dose intravenous Haloperidol (with close EKG monitoring)." }
          ]
        },
