                            {
                                      "q": "Most common symptom of <b>Endometrial Carcinoma</b>?",
                                      "a": "Postmenopausal bleeding."
                            },
                            {
                                      "q": "Genetic mutation most associated with Endometrioid Carcinoma (Type I)?",
                                      "a": "<b>PTEN</b> tumor suppressor gene mutation."
                            },
                            {
                                      "q": "Histologic characteristic of Serous <b>Endometrial Carcinoma</b> (Type II)?",
                                      "a": "Papillary growth pattern with Psammoma bodies and <b>p53</b> mutations."
                            },
                            {
                                      "q": "Definition of <b>Adenomyosis</b>?",
                                      "a": "Extension of endometrial glands and stroma into the uterine myometrium."
                            },
