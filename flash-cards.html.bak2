            { q: "First-line treatment for Hereditary Hemochromatosis?", a: "Therapeutic phlebotomy." },
            { q: "Classic laboratory finding in Alcoholic Liver Disease?", a: "AST:ALT ratio > 2:1." },
            { q: "Diagnostic criteria for Spontaneous Bacterial Peritonitis (SBP)?", a: "Ascitic fluid Absolute Neutrophil Count (ANC) > 250 cells/mm³." },
            { q: "Empiric antibiotic for SBP?", a: "Third-generation cephalosporin (Cefotaxime)." },
            { q: "Primary Biliary Cholangitis (PBC) target population?", a: "Middle-aged women." },
            { q: "Hallmark antibody for Primary Biliary Cholangitis?", a: "Anti-mitochondrial antibody (AMA)." },
            { q: "Key laboratory abnormality in Nonalcoholic Fatty Liver Disease (NAFLD)?", a: "ALT > AST (usually in the setting of metabolic syndrome). Part 4: Pancreatitis" },
            { q: "Two most common causes of Acute Pancreatitis?", a: "Gallstones and Alcohol." },
            { q: "Most specific serum enzyme for Acute Pancreatitis?", a: "Lipase." },
            { q: "Diagnostic imaging of choice for Acute Pancreatitis?", a: "Abdominal CT with contrast (though often clinical diagnosis)." },
            { q: "Criteria used to predict severity/mortality in Pancreatitis?", a: "Ranson’s Criteria or APACHE II score." },
            { q: "Classic physical sign of hemorrhagic pancreatitis (periumbilical)?", a: "Cullen’s sign." },
            { q: "Classic physical sign of hemorrhagic pancreatitis (flank)?", a: "Grey Turner’s sign." },
            { q: "Most common complication of Acute Pancreatitis (weeks later)?", a: "Pancreatic pseudocyst." },
            { q: "Classic triad of Chronic Pancreatitis?", a: "Steatorrhea, Diabetes Mellitus, and Pancreatic calcifications." },
            { q: "Best initial test for Chronic Pancreatitis?", a: "Abdominal X-ray or CT showing calcifications." },
            { q: "Treatment for malabsorption in Chronic Pancreatitis?", a: "Pancreatic enzyme supplementation (Lipase/Amylase/Protease)." },
            { q: "Major risk factor for Pancreatic Adenocarcinoma?", a: "Smoking." },
            { q: "Tumor marker for Pancreatic Cancer?", a: "CA 19-9." },
            { q: "Painless jaundice and a palpable gallbladder (Courvoisier sign) suggests?", a: "Pancreatic Head Carcinoma. Part 5: Advanced GI & Hepatobiliary Integration" },
            { q: "Most common cause of jaundice in pregnancy?", a: "Viral hepatitis." },
            { q: "Management of asymptomatic gallstones?", a: "Observation (no surgery)." },
            { q: "Treatment of choice for Choledocholithiasis?", a: "ERCP (Endoscopic Retrograde Cholangiopancreatography)." },
            { q: "Charcot’s Triad for Ascending Cholangitis?", a: "Fever, RUQ pain, and Jaundice." },
            { q: "Reynolds’ Pentad (for Cholangitis)?", a: "Charcot’s Triad + Hypotension + Altered Mental Status." },
            { q: "Primary risk factor for Esophageal Adenocarcinoma?", a: "Barrett’s Esophagus (from chronic GERD)." },
            { q: "Type of esophageal cancer associated with smoking and alcohol?", a: "Squamous Cell Carcinoma." },
            { q: "First-line medication for symptomatic GERD?", a: "Proton Pump Inhibitors (PPIs)." },
            { q: "Gold standard for diagnosing GERD (if diagnosis unclear)?", a: "24-hour pH monitoring." },
            { q: "Best test to confirm H. pylori eradication?", a: "Urea Breath Test or Stool Antigen Test." },
            { q: "Classic laboratory finding in Autoimmune Hepatitis?", a: "Anti-smooth muscle antibodies (ASMA)." },
            { q: "Treatment for Wilson's Disease?", a: "Penicillamine or Trientine (Copper chelators)." },
            { q: "Definitive treatment for Alpha-1 Antitrypsin deficiency liver disease?", a: "Liver transplantation." },
            { q: "Medication used to decrease portal pressure in Cirrhosis?", a: "Non-selective beta-blockers (Propranolol, Nadolol)." },
            { q: "Most common cause of Small Bowel Obstruction (SBO)?", a: "Post-surgical adhesions." },
            { q: "Most common cause of Large Bowel Obstruction?", a: "Colorectal cancer." },
            { q: "Presentation of Achalasia on Barium Swallow?", a: "\"Bird’s beak\" tapering of the distal esophagus." },
            { q: "Pathophysiology of Achalasia?", a: "Loss of myenteric (Auerbach) plexus in the distal esophagus." },
            { q: "Initial treatment for C. difficile infection?", a: "Oral Vancomycin or Fidaxomicin." },
            { q: "Complication of C. difficile characterized by colonic dilation?", a: "Toxic Megacolon." },
            { q: "Classic biopsy finding in Celiac Disease?", a: "Villous atrophy and crypt hyperplasia." },
            { q: "Highly sensitive antibody for Celiac Disease?", a: "Anti-tissue transglutaminase (tTG) IgA." },
            { q: "Condition associated with Dermatitis Herpetiformis?", a: "Celiac Disease." },
            { q: "Screening recommendation for Colon Cancer (average risk)?", a: "Colonoscopy every 10 years starting at age 45." },
            { q: "First-line management for Zenker’s Diverticulum?", a: "Surgical cricopharyngeal myotomy." },
            { q: "Diagnostic finding in Boerhaave Syndrome?", a: "Pneumomediastinum (air in the mediastinum) on X-ray." },
            { q: "Difference between Mallory-Weiss and Boerhaave?", a: "Mallory-Weiss is a mucosal tear; Boerhaave is a full-thickness rupture." },
            { q: "Primary electrolyte abnormality in refeeding syndrome?", a: "Hypophosphatemia." },
            { q: "Presentation of Vitamin B12 deficiency in GI disease?", a: "Megaloblastic anemia and subacute combined degeneration of the spinal cord." },
            { q: "GI disorder associated with \"string sign\" on contrast imaging?", a: "Crohn's Disease (terminal ileum narrowing)." },
            { q: "Risk factor for Porcelain Gallbladder?", a: "Chronic cholecystitis (high risk for gallbladder carcinoma)." },
            { q: "Most common cause of drug-induced liver injury in the US?", a: "Acetaminophen." },
            { q: "Antidote for Acetaminophen toxicity?", a: "N-acetylcysteine (NAC)." },
            { q: "Serum marker for primary hepatocellular carcinoma?", a: "Alpha-fetoprotein (AFP)." },
            { q: "Key ultrasound finding for Acute Cholecystitis?", a: "Gallbladder wall thickening and pericholecystic fluid." },
            { q: "Most sensitive test for Acute Cholecystitis?", a: "HIDA scan (Cholescintigraphy)." },
            { q: "Treatment for primary biliary cholangitis?", a: "Ursodeoxycholic acid." },
            { q: "Defining feature of Dubin-Johnson syndrome?", a: "Conjugated hyperbilirubinemia and a \"black liver.\"" },
            { q: "Cause of Gilbert Syndrome?", a: "Reduced UGT1A1 activity leading to unconjugated hyperbilirubinemia during stress." },
            { q: "Major risk of Crigler-Najjar Syndrome Type I?", a: "Kernicterus (due to absent UGT enzyme)." },
            { q: "Management of a Pancreatic Pseudocyst <6cm and asymptomatic?", a: "Observation/Expectant management." },
            { q: "Complication of TPN (Total Parenteral Nutrition)?", a: "Gallstones/Biliary sludge." },
            { q: "Primary cause of Mesenteric Ischemia?", a: "Embolism (often from Atrial Fibrillation)." },
            { q: "Clinical presentation of Chronic Mesenteric Ischemia?", a: "\"Abdominal angina\" (post-prandial pain) and weight loss." },
