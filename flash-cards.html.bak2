                        "q": "What is the standard systemic adjuvant chemotherapy regimen utilized for Stage III (node-positive) colon cancer?",
                        "a": "FOLFOX (Fluorouracil, Leucovorin, and Oxaliplatin)."
            },
            {
                        "q": "What is the most common clinical subtype of cutaneous melanoma?",
                        "a": "Superficial spreading melanoma."
            },
            {
                        "q": "Which melanoma subtype is classically found on the palms, soles, or under the nail beds, and is more prevalent in darker-skinned populations?",
                        "a": "Acral lentiginous melanoma."
            },
            {
                        "q": "Which melanoma subtype grows rapidly vertically rather than horizontally, presenting as a dark, dome-shaped nodule with an early invasive phase?",
                        "a": "Nodular melanoma."
            },
            {
