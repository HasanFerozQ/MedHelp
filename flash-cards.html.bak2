            { q: "Hepatitis virus with high mortality rate in pregnant women?", a: "Hepatitis E." },
            { q: "Definition of Chronic Hepatitis B?", a: "HBsAg persistence for >6 months. Part 7: Gastric Pathologies & PUD" },
            { q: "Most common cause of chronic gastritis?", a: "H. pylori infection." },
            { q: "Location of H. pylori colonization in the stomach?", a: "Antrum." },
            { q: "Type of Gastritis involving the fundus and associated with Pernicious Anemia?", a: "Autoimmune Metaplastic Atrophic Gastritis (Type A)." },
            { q: "Mechanism of Pernicious Anemia in Type A Gastritis?", a: "Antibodies against Parietal cells and Intrinsic Factor." },
            { q: "Complication of H. pylori besides PUD?", a: "MALT Lymphoma and Gastric Adenocarcinoma." },
            { q: "First-line \"Triple Therapy\" for H. pylori?", a: "PPI + Amoxicillin + Clarithromycin." },
            { q: "Preferred H. pylori treatment in areas with high Clarithromycin resistance?", a: "Bismuth Quadruple Therapy (PPI + Bismuth + Metronidazole + Tetracycline)." },
            { q: "Classic symptom of a Duodenal Ulcer?", a: "Pain that improves with food." },
            { q: "Classic symptom of a Gastric Ulcer?", a: "Pain that worsens with food (leads to weight loss)." },
            { q: "Most common location for a Gastric Cancer?", a: "Lesser curvature of the antrum. Part 8: Malabsorption & Small Bowel" },
            { q: "Pathophysiology of Celiac Disease?", a: "Immune-mediated damage to small bowel villi due to gluten exposure (gliadin)." },
            { q: "Skin manifestation of Celiac Disease?", a: "Dermatitis Herpetiformis (IgA deposits at dermal papillae)." },
            { q: "Definitive diagnosis for Celiac Disease?", a: "Small bowel biopsy showing villous atrophy." },
            { q: "Findings in Tropical Sprue compared to Celiac?", a: "Similar villous atrophy but affects the entire small bowel (Celiac is distal duo/proximal jejunum)." },
            { q: "Diagnostic test for Lactose Intolerance?", a: "Hydrogen Breath Test." },
            { q: "Stool findings in Malabsorption/Steatorrhea?", a: "Increased fecal fat (>7g/day) and decreased Sudam III stain." },
            { q: "Vitamin deficiency common after ileal resection?", a: "Vitamin B12 and Bile Acid deficiency." },
            { q: "Classic presentation of Whipple’s Disease?", a: "Diarrhea, Weight loss, Arthralgia, and Neurological symptoms." },
            { q: "Characteristic of Small Intestinal Bacterial Overgrowth (SIBO)?", a: "Premature deconjugation of bile acids leading to fat malabsorption. Part 9: Vascular & Structural Disorders" },
            { q: "Definition of \"Angiodysplasia\"?", a: "Tortuous, dilated submucosal veins; common cause of painless hematochezia in elderly." },
            { q: "Risk factors for Ischemic Colitis?", a: "Hypotension (shock), vasculitis, or extreme exercise (marathons)." },
            { q: "Most common site for Ischemic Colitis?", a: "Splenic flexure (Griffith’s point) and Rectosigmoid junction (Sudek’s point)." },
            { q: "Presentation of Acute Mesenteric Ischemia?", a: "\"Pain out of proportion to exam\" in a patient with Atrial Fibrillation." },
            { q: "Management of a Sigmoid Volvulus?", a: "Sigmoidoscopic decompression (detorsion)." },
            { q: "Radiographic appearance of Sigmoid Volvulus?", a: "\"Coffee bean\" sign on X-ray." },
            { q: "Definitive treatment for recurrent Sigmoid Volvulus?", a: "Elective sigmoid resection." },
            { q: "Most common site for an indirect inguinal hernia?", a: "Through the deep inguinal ring (lateral to inferior epigastric vessels). Part 10: Advanced Liver & Biliary (Sleisenger/Harrison level)" },
            { q: "Pathophysiology of Hepatorenal Syndrome?", a: "Splanchnic vasodilation leading to renal vasoconstriction and failure." },
            { q: "Treatment for Hepatorenal Syndrome?", a: "Midodrine, Octreotide, and Albumin." },
            { q: "Best initial step for a patient with jaundice and dilated ducts on US?", a: "ERCP or MRCP." },
            { q: "Primary risk factor for Gallbladder Adenocarcinoma?", a: "Chronic cholelithiasis and Porcelain Gallbladder." },
            { q: "Management of symptomatic cholelithiasis in a pregnant patient?", a: "Conservative management first, then cholecystectomy in 2nd trimester if needed." },
            { q: "Expected lab findings in Extrahepatic Biliary Obstruction?", a: "Elevated Conjugated Bilirubin, High Alk Phos, and High GGT." },
            { q: "What does an isolated elevation of Alk Phos (normal GGT) suggest?", a: "Bone disease or pregnancy, not liver/biliary disease." },
            { q: "Cause of \"Pre-hepatic\" jaundice?", a: "Hemolysis (excess Unconjugated Bilirubin)." },
            { q: "Definition of Gilbert Syndrome?", a: "Mildly decreased UGT activity; asymptomatic jaundice during stress/fasting. Part 11: Miscellaneous High-Yield GI" },
            { q: "Most common cause of lower GI bleed in children?", a: "Meckel’s Diverticulum." },
            { q: "Cause of a \"Corkscrew Esophagus\" on barium swallow?", a: "Diffuse Esophageal Spasm (DES)." },
            { q: "First-line treatment for Diffuse Esophageal Spasm?", a: "Calcium channel blockers or Nitrates." },
            { q: "Criteria for diagnosing Irritable Bowel Syndrome (IBS)?", a: "Rome IV Criteria (recurrent abdominal pain 1 day/week for 3 months)." },
            { q: "Alarm symptoms in IBS that warrant further workup?", a: "Weight loss, nocturnal diarrhea, blood in stool, or age >50." },
            { q: "Management of Ogilvie Syndrome (Colonic Pseudo-obstruction)?", a: "Neostigmine or colonic decompression." },
            { q: "Most common cause of Boerhaave Syndrome?", a: "latrogenic (endoscopy) or forceful retching." },
            { q: "Characteristic finding in Intussusception?", a: "\"Currant jelly\" stools and \"Target sign\" on ultrasound." },
            { q: "Primary management of Intussusception in children?", a: "Air or Contrast enema (both diagnostic and therapeutic). Part 12: Pancreatic & Biliary Complications" },
            { q: "Lab marker to differentiate Pancreatitis from other causes of RUQ pain?", a: "Serum Lipase >3x upper limit of normal." },
            { q: "Management of infected pancreatic necrosis?", a: "Antibiotics (Meropenem) and delayed necrosectomy." },
            { q: "Most common location of a Gastrinoma?", a: "Duodenum (60-90%)." },
            { q: "Association of Gastrinomas with which genetic syndrome?", a: "MEN1 (Multiple Endocrine Neoplasia type 1)." },
            { q: "Best test to visualize the \"Onion Skinning\" of PSC?", a: "Liver biopsy (though MRCP/ERCP are often used for diagnosis)." },
            { q: "Drug that can cause drug-induced pancreatitis?", a: "Valproic acid, Diuretics (Furosemide, Thiazides), Azathioprine." },
            { q: "Classic electrolyte complication of Acute Pancreatitis?", a: "Hypocalcemia (due to saponification in fat necrosis). Part 13: Colorectal & Anorectal" },
            { q: "Definition of Internal Hemorrhoids?", a: "Above the dentate line; painless bleeding." },
            { q: "Definition of External Hemorrhoids?", a: "Below the dentate line; painful (especially if thrombosed)." },
            { q: "First-line treatment for Anal Fissures?", a: "Fiber, stool softeners, and topical nitroglycerin or diltiazem." },
            { q: "Most common location for an Anal Fissure?", a: "Posterior midline." },
            { q: "Lynch Syndrome (HNPCC) genetic defect?", a: "DNA Mismatch Repair (MMR) genes (MLH1, MSH2)." },
            { q: "Extracolonic cancers associated with Lynch Syndrome?", a: "Endometrial, Ovarian, and Gastric cancer." },
            { q: "Gardner Syndrome presentation?", a: "FAP + Osteomas + Soft tissue tumors + Impacted teeth." },
            { q: "Peutz-Jeghers Syndrome features?", a: "Hamartomatous polyps + Hyperpigmented macules on lips/buccal mucosa. Section: Quick-Fire Integration" },
            { q: "Jaundice + Weight Loss + Palpable Gallbladder?", a: "Pancreatic Cancer (Courvoisier sign)." },
            { q: "RUQ Pain + Jaundice + Fever?", a: "Acute Cholangitis." },
            { q: "Cirrhosis + New onset Fever + Abdominal Pain?", a: "Spontaneous Bacterial Peritonitis (SBP)." },
            { q: "Heartburn + Dysphagia to solids + History of asthma/atopy?", a: "Eosinophilic Esophagitis." },
            { q: "Endoscopic finding in Eosinophilic Esophagitis?", a: "Stacked rings or linear furrows (\"feline esophagus\")." },
            { q: "Treatment for Eosinophilic Esophagitis?", a: "Dietary modification or swallowed aerosolized steroids (Fluticasone)." },
            { q: "Primary mechanism of Ascites in Cirrhosis?", a: "Portal hypertension leading to splanchnic vasodilation and decreased effective arterial volume." },
            { q: "Most common cause of death in patients with Hemochromatosis?", a: "Hepatocellular Carcinoma (HCC)." },
            { q: "Defining characteristic of Type 1 Hepatorenal Syndrome (HRS)?", a: "Rapidly progressive renal failure (doubling of Cr >2.5 in <2 weeks)." },
            { q: "SAAG < 1.1 g/dL with high protein (>2.5) in ascitic fluid suggests?", a: "Malignancy, Nephrotic syndrome, or TB peritonitis." },
            { q: "Treatment for symptomatic Grade II/III Hepatic Encephalopathy?", a: "Lactulose titrated to 2-3 soft bowel movements per day." },
            { q: "Indication for adding Rifaximin in Hepatic Encephalopathy?", a: "Prevention of recurrence after a second episode." },
            { q: "Most common organism causing Spontaneous Bacterial Peritonitis (SBP)?", a: "E. coli." },
            { q: "Long-term prophylaxis for SBP after the first episode?", a: "Daily Ciprofloxacin or Trimethoprim-sulfamethoxazole." },
            { q: "MELD score components?", a: "Bilirubin, Creatinine, INR, and Sodium." },
            { q: "Use of the MELD score?", a: "Predicting 3-month mortality and prioritizing liver transplant candidates. Part 15: IBD — Nuanced Management & Complications" },
            { q: "IBD type associated with \"Creeping Fat\" on gross specimen?", a: "Crohn’s Disease." },
            { q: "Highest risk factor for Toxic Megacolon?", a: "Ulcerative Colitis (though it can occur in Crohn's or C. diff)." },
            { q: "Initial imaging for suspected Toxic Megacolon?", a: "Abdominal X-ray (showing colonic diameter >6 cm)." },
            { q: "Contraindicated procedures in acute Toxic Megacolon?", a: "Colonoscopy and Barium enema (due to perforation risk)." },
            { q: "Maintenance therapy for Crohn’s Disease if 5-ASA fails?", a: "Azathioprine, 6-Mercaptopurine, or Anti-TNF (Infliximab)." },
            { q: "IBD medication requiring TPMT enzyme activity testing before start?", a: "Azathioprine / 6-Mercaptopurine." },
            { q: "Most common site of stricture formation in Crohn’s?", a: "Terminal Ileum." },
            { q: "Surveillance colonoscopy timing for UC patients?", a: "Starting 8 years after diagnosis, then every 1-2 years." },
            { q: "Extraintestinal manifestation of IBD that does NOT correlate with bowel activity?", a: "Ankylosing spondylitis and Primary Sclerosing Cholangitis. Part 16: Pancreatitis — Advanced Management" },
            { q: "Most common cause of death in the first week of Acute Pancreatitis?", a: "Systemic Inflammatory Response Syndrome (SIRS) and multiorgan failure." },
            { q: "Most common cause of death AFTER the first week of Acute Pancreatitis?", a: "Pancreatic infection (Infected Necrosis)." },
            { q: "Preferred fluid for resuscitation in Acute Pancreatitis?", a: "Lactated Ringer’s (associated with lower SIRS risk than Normal Saline)." },
            { q: "\"Sentinel Loop\" on abdominal X-ray indicates?", a: "Localized ileus of the jejunum associated with nearby Pancreatitis." },
            { q: "Definition of \"Chronic\" Pancreatitis?", a: "Irreversible structural damage leading to exocrine and endocrine insufficiency." },
            { q: "Gold standard test for Pancreatic Exocrine Insufficiency?", a: "72-hour fecal fat collection (though Fecal Elastase-1 is the common initial test)." },
            { q: "Classic pain description for Pancreatic Cancer?", a: "Dull epigastric pain radiating to the back, worse at night." },
            { q: "Trousseau’s Syndrome in Pancreatic Cancer?", a: "Migratory superficial thrombophlebitis. Part 17: GI Bleeding — Special Scenarios" },
            { q: "Management of a \"Dieulafoy Lesion\"?", a: "Endoscopic clipping or thermal coagulation (it is a large submucosal artery)." },
            { q: "Presentation of \"Aortoenteric Fistula\"?", a: "Brisk \"herald bleed\" followed by massive hematochezia in a patient with a prior aortic graft." },
            { q: "Primary location of an Aortoenteric Fistula?", a: "Third part of the duodenum." },
            { q: "Scintigraphy (Tagged RBC Scan) is used for what GIB scenario?", a: "Detecting slow or intermittent LGIB when colonoscopy is inconclusive." },
            { q: "Most common cause of UGIB in a patient with chronic NSAID use?", a: "Gastric ulcer (NSAIDs inhibit prostaglandin synthesis)." },
            { q: "Cameron Lesions are found in what structural abnormality?", a: "Hiatal hernia (linear erosions in the gastric folds)." },
            { q: "Key management for bleeding secondary to Mallory-Weiss tear?", a: "Most stop spontaneously; if not, epinephrine injection or clipping. Part 18: Liver Disease — Immunology & Metabolism" },
            { q: "High Serum Ceruloplasmin levels are found in?", a: "Actually, Ceruloplasmin is low in Wilson's Disease." },
            { q: "Kayser-Fleischer rings are found in which layer of the cornea?", a: "Descemet’s membrane." },
            { q: "Most common liver disease in the Western world?", a: "Nonalcoholic Fatty Liver Disease (NAFLD)." },
            { q: "Histological hallmark of Alcoholic Hepatitis?", a: "Mallory-Denk bodies (intracytoplasmic eosinophilic inclusions)." },
            { q: "Medical treatment for severe Alcoholic Hepatitis (Maddrey Score >32)?", a: "Prednisolone (Corticosteroids)." },
            { q: "Drug used in Alcoholic Hepatitis if steroids are contraindicated?", a: "Pentoxifylline." },
            { q: "Difference between PBC and PSC location?", a: "PBC is intrahepatic ducts only; PSC is both intra- and extrahepatic. Part 19: Structural & Functional Integration" },
            { q: "Diagnosis for \"Doughnut sign\" or \"Target sign\" on CT?", a: "Intussusception." },
            { q: "Most common site for Volvulus in the elderly?", a: "Sigmoid colon." },
            { q: "Most common site for Volvulus in children?", a: "Midgut (associated with malrotation)." },
            { q: "\"Whirl sign\" on CT abdomen indicates?", a: "Volvulus (torsion of the mesentery)." },
            { q: "Pathophysiology of Zenker’s Diverticulum?", a: "Herniation through Killian’s triangle (weakness in the pharyngeal constrictor). Final Section: Step 2 CK \"Best Next Step\" Rapid Fire" },
            { q: "Best next step: Patient with cirrhosis, ascites, and altered mental status?", a: "Diagnostic paracentesis (rule out SBP)." },
            { q: "Best next step: Hematochezia in a patient over 50 with stable vitals?", a: "Colonoscopy." },
            { q: "Best next step: Suspected Peptic Ulcer perforation?", a: "Upright Chest X-ray (look for free air under the diaphragm)." },
            { q: "Best next step: Post-ERCP patient with severe epigastric pain?", a: "Check serum Amylase/Lipase (Post-ERCP pancreatitis)." },
            { q: "Best next step: Jaundice, pruritus, and elevated Alk Phos?", a: "Right upper quadrant ultrasound." },
            { q: "IBD-associated skin lesion that shows pathergy (worsens with trauma)?", a: "Pyoderma gangrenosum." },
            { q: "Most common vitamin deficiency in Crohn's disease patients with ileal involvement?", a: "Vitamin B12 (leading to macrocytic anemia)." },
            { q: "Type of kidney stone most common in Crohn’s disease?", a: "Calcium Oxalate stones (due to increased oxalate absorption)." },
            { q: "Gallstone type associated with Crohn’s disease?", a: "Cholesterol stones (due to decreased bile acid resorption in the ileum)." },
            { q: "Primary site of inflammation in microscopic colitis?", a: "Colon (appears endoscopically normal but shows inflammation on biopsy)." },
            { q: "Common trigger for Microscopic Colitis?", a: "NSAIDs, PPIs, or Sertraline." },
            { q: "Drug of choice for treating Microscopic Colitis?", a: "Oral Budesonide." },
            { q: "Most common complication of an ileal pouch-anal anastomosis (IPAA)?", a: "Pouchitis." },
            { q: "Initial treatment for Pouchitis?", a: "Ciprofloxacin or Metronidazole. Part 21: GI Bleeding — Nuance & Management" },
            { q: "Standard of care for preventing re-bleeding in non-variceal peptic ulcers?", a: "High-dose IV Proton Pump Inhibitors (PPI) for 72 hours." },
            { q: "Most common cause of a \"brisk\" Upper GI Bleed in a patient with Cirrhosis?", a: "Esophageal varices." },
            { q: "Mechanism of Octreotide in variceal bleeding?", a: "Causes splanchnic vasoconstriction, reducing portal venous pressure." },
            { q: "Next step if endoscopic therapy fails twice to control a variceal bleed?", a: "TIPS (Transjugular Intrahepatic Portosystemic Shunt)." },
            { q: "Contraindication for TIPS procedure?", a: "Severe Congestive Heart Failure or Hepatic Encephalopathy." },
            { q: "Appearance of Gastric Antral Vascular Ectasia (GAVE) on endoscopy?", a: "\"Watermelon stomach\" (streaky redness in the antrum)." },
            { q: "Presentation of Blue Rubber Bleb Nevus Syndrome?", a: "Multiple cavernous hemangiomas of the skin and GI tract leading to chronic GIB. Part 22: Liver Disease — Advanced Diagnostics" },
            { q: "Mnemonic for the causes of Acute Liver Failure?", a: "A-B-C-D-E-F (Acetaminophen/Amanita, Hep B, Hep C, Delta/Drugs, Eschemia, Fatty liver)." },
            { q: "Definition of \"Fulminant Hepatic Failure\"?", a: "Acute liver injury with encephalopathy and coagulopathy (INR >1.5) within 8 weeks of jaundice." },
            { q: "Most common cause of jaundice in the first 24 hours of life?", a: "Hemolytic disease (Pathological)." },
            { q: "Histological finding in Alpha-1 Antitrypsin deficiency?", a: "PAS-positive, diastase-resistant globules in hepatocytes." },
            { q: "Lab finding that differentiates Alcoholic Hepatitis from Viral Hepatitis?", a: "AST and ALT are rarely >500 U/L in alcoholic disease." },
            { q: "Medication used to reduce pruritus in Primary Biliary Cholangitis?", a: "Cholestyramine (bile acid sequestrant)." },
            { q: "Association between HLA-B8/DR3 and which liver disease?", a: "Autoimmune Hepatitis." },
            { q: "Presentation of Hepatic Hydrothorax?", a: "Right-sided pleural effusion in a cirrhotic patient without primary lung disease. Part 23: Pancreatitis & Biliary \"Gray Areas\"" },
            { q: "Most common cause of Chronic Pancreatitis in children?", a: "Cystic Fibrosis (CFTR mutations)." },
            { q: "Serum marker often elevated in Autoimmune Pancreatitis?", a: "IgG4." },
            { q: "First-line treatment for Autoimmune Pancreatitis?", a: "Corticosteroids." },
            { q: "Diagnosis for a \"Double Duct Sign\" (dilation of both CBD and pancreatic duct)?", a: "Pancreatic Head Cancer or Ampullary Cancer." },
            { q: "Preferred diagnostic test for suspected Choledocholithiasis when US is equivocal?", a: "MRCP (Magnetic Resonance Cholangiopancreatography)." },
            { q: "Most common cause of Pyogenic Liver Abscess?", a: "Biliary tract disease (e.g., ascending cholangitis)." },
            { q: "Characteristic CT finding of an Amoebic Liver Abscess?", a: "Single lesion in the right lobe with \"anchovy paste\" aspirate." },
            { q: "Treatment for Amoebic Liver Abscess?", a: "Metronidazole (Paromomycin follows to clear intraluminal cysts). Part 24: High-Yield Potpourri" },
            { q: "Definition of Ogilvie's Syndrome?", a: "Acute pseudo-obstruction of the colon in hospitalized/elderly patients." },
            { q: "Most common complication of a Meckel's Diverticulum in an adult?", a: "Small bowel obstruction." },
            { q: "Cause of \"Pneumatosis Intestinalis\" (air in the bowel wall) on X-ray?", a: "Mesenteric ischemia or Necrotizing Enterocolitis (NEC)." },
            { q: "Diagnostic finding for Sclerosing Mesenteritis?", a: "\"Misty mesentery\" on CT scan." },
            { q: "Drug of choice for prophylaxis of NSAID-induced ulcers?", a: "Misoprostol (Prostaglandin E1 analog)." },
            { q: "Primary risk of long-term PPI use?", a: "C. difficile infection, hip fractures (decreased Ca absorption), and B12 deficiency." },
            { q: "Hallmark of Dubin-Johnson Syndrome on laparoscopy?", a: "Grossly black/dark liver." },
            { q: "Diagnosis for a patient with RUQ pain, jaundice, and palpable gallbladder?", a: "Courvoisier sign (likely distal malignant biliary obstruction)." },
            { q: "Most common site for Gastric Carcinoid tumors?", a: "Gastric body (associated with hypergastrinemia)." },
            { q: "Diagnosis for a patient with ascites, hepatomegaly, and RUQ pain after starting OCPs?", a: "Budd-Chiari Syndrome (Hepatic vein thrombosis)." },
            { q: "\"Nutmeg liver\" on gross pathology indicates?", a: "Chronic passive congestion due to Right-Sided Heart Failure." },
            { q: "Primary treatment for a Pyogenic Liver Abscess?", a: "Percutaneous drainage and systemic antibiotics." },
            { q: "Causative organism for \"Hydatid Cysts\" in the liver?", a: "Echinococcus granulosus." },
            { q: "Pathognomonic CT finding for Echinococcus liver cyst?", a: "Eggshell calcification of the cyst wall." },
            { q: "Why is aspiration contraindicated in suspected Echinococcus cysts?", a: "Risk of anaphylactic shock from leakage of cyst contents." },
            { q: "Most common cause of portal hypertension in the absence of cirrhosis?", a: "Schistosomiasis (worldwide) or Portal Vein Thrombosis." },
            { q: "Diagnosis for a patient with jaundice and \"Hamman’s Crunch\" (mediastinal emphysema)?", a: "Boerhaave Syndrome (esophageal rupture). Part 26: Biliary Nuances & Gallbladder Disease" },
            { q: "Definition of \"Acalculous Cholecystitis\"?", a: "Gallbladder inflammation without stones, typically in critically ill/ICU patients." },
            { q: "Best initial treatment for Acalculous Cholecystitis in an unstable patient?", a: "Percutaneous cholecystostomy tube." },
            { q: "\"Gallstone Ileus\" usually results from a fistula between which two organs?", a: "Gallbladder and Duodenum." },
            { q: "Classic X-ray triad (Rigler’s Triad) for Gallstone Ileus?", a: "Small bowel obstruction, gallstone in ectopic location, and pneumobilia (air in biliary tree)." },
            { q: "Most common site of impaction in Gallstone Ileus?", a: "Ileocecal valve." },
            { q: "Finding of \"Strawberry Gallbladder\" (Cholesterolosis) indicates?", a: "Yellow specks of cholesterol esters within the gallbladder wall (usually asymptomatic)." },
            { q: "Primary risk factor for Cholangiocarcinoma in the Western world?", a: "Primary Sclerosing Cholangitis (PSC). Part 27: Chronic Pancreatitis & Functional Disorders" },
            { q: "Most common cause of Chronic Pancreatitis in adults (Western world)?", a: "Alcohol abuse." },
            { q: "Diagnosis for a patient with oily, foul-smelling stools and weight loss?", a: "Steatorrhea (Pancreatic Exocrine Insufficiency)." },
            { q: "Best initial step for suspected Pancreatic Exocrine Insufficiency?", a: "Fecal Elastase-1 test." },
            { q: "Treatment for abdominal pain in Chronic Pancreatitis?", a: "Alcohol/smoking cessation, small low-fat meals, and pancreatic enzyme supplementation." },
            { q: "Pathophysiology of Gastroparesis?", a: "Delayed gastric emptying in the absence of mechanical obstruction (common in Diabetes)." },
            { q: "Prokinetic agent of choice for Gastroparesis?", a: "Metoclopramide (D2 receptor antagonist) or Erythromycin." },
            { q: "Primary side effect of long-term Metoclopramide?", a: "Tardive dyskinesia. Part 28: Complex GI Bleeding & Small Bowel Pearls" },
            { q: "Diagnosis for \"watermelon stomach\" appearance in a patient with Systemic Sclerosis?", a: "GAVE (Gastric Antral Vascular Ectasia)." },
            { q: "First-line management for GAVE?", a: "Endoscopic Argon Plasma Coagulation (APC)." },
            { q: "Most common cause of Small Bowel Bleeding in patients <40 years old?", a: "Meckel’s Diverticulum or IBD." },
            { q: "Most common cause of Small Bowel Bleeding in patients >40 years old?", a: "Angiodysplasia or NSAID-induced ulcers." },
            { q: "Initial step for a patient with Hematochezia and hemodynamic instability?", a: "Rule out an Upper GI source with EGD (Upper GI bleed can present with red blood if brisk)." },
            { q: "Interpretation of a \"High SAAG\" (>1.1) with \"Low Protein\" (<2.5) in ascites?", a: "Cirrhosis." },
            { q: "Interpretation of a \"High SAAG\" (>1.1) with \"High Protein\" (>2.5) in ascites?", a: "Heart Failure or Budd-Chiari Syndrome. Part 29: Pharmacological Pearls in GI" },
            { q: "Mechanism of Ursodeoxycholic acid in PBC?", a: "Decreases cholesterol content of bile and reduces immune-mediated duct damage." },
            { q: "Prophylactic medication for esophageal varices in stable cirrhotics?", a: "Non-selective Beta-blockers (Nadolol or Propranolol)." },
            { q: "Mechanism of Terlipressin in Variceal Bleeding?", a: "Vasopressin analogue that causes splanchnic vasoconstriction." },
            { q: "Treatment for Pruritus in cholestatic liver disease?", a: "Cholestyramine, Rifampin, or Naltrexone." },
            { q: "Most common electrolyte side effect of PPIs?", a: "Hypomagnesemia." },
            { q: "Medication that causes \"black tongue\" and \"black stools\"?", a: "Bismuth subsalicylate. Part 30: Step 2 CK \"Management Next Steps\" Final Fire" },
            { q: "Next step for a patient with suspected Achalasia and a \"Bird’s Beak\" on Barium Swallow?", a: "Esophageal Manometry (to confirm absence of peristalsis and failed LES relaxation)." },
            { q: "Next step for a 55-year-old with new-onset GERD?", a: "Upper Endoscopy (to rule out Barrett's or malignancy due to age)." },
            { q: "Next step for a patient with a positive H. pylori stool antigen?", a: "Initiate Triple or Quadruple therapy." },
            { q: "Next step after a diagnosis of Colon Cancer is made via biopsy?", a: "CT scan of Chest/Abdomen/Pelvis for staging." },
            { q: "Next step for a cirrhotic patient with a new solid liver mass <1cm on US?", a: "Repeat Ultrasound in 3-4 months." },
            { q: "Next step for a cirrhotic patient with a new solid liver mass >1cm on US?", a: "Triple-phase CT or MRI with contrast (looking for arterial enhancement/venous washout)." },
            { q: "Diagnosis for a patient with ascites, hepatomegaly, and RUQ pain after starting OCPs?", a: "Budd-Chiari Syndrome (Hepatic vein thrombosis)." },
            { q: "\"Nutmeg liver\" on gross pathology indicates?", a: "Chronic passive congestion due to Right-Sided Heart Failure." },
            { q: "Primary treatment for a Pyogenic Liver Abscess?", a: "Percutaneous drainage and systemic antibiotics." },
            { q: "Causative organism for \"Hydatid Cysts\" in the liver?", a: "Echinococcus granulosus." },
            { q: "Pathognomonic CT finding for Echinococcus liver cyst?", a: "Eggshell calcification of the cyst wall." },
            { q: "Why is aspiration contraindicated in suspected Echinococcus cysts?", a: "Risk of anaphylactic shock from leakage of cyst contents." },
            { q: "Most common cause of portal hypertension in the absence of cirrhosis?", a: "Schistosomiasis (worldwide) or Portal Vein Thrombosis." },
            { q: "Diagnosis for a patient with jaundice and \"Hamman’s Crunch\" (mediastinal emphysema)?", a: "Boerhaave Syndrome (esophageal rupture). Part 26: Biliary Nuances & Gallbladder Disease" },
            { q: "Definition of \"Acalculous Cholecystitis\"?", a: "Gallbladder inflammation without stones, typically in critically ill/ICU patients." },
            { q: "Best initial treatment for Acalculous Cholecystitis in an unstable patient?", a: "Percutaneous cholecystostomy tube." },
            { q: "\"Gallstone Ileus\" usually results from a fistula between which two organs?", a: "Gallbladder and Duodenum." },
            { q: "Classic X-ray triad (Rigler’s Triad) for Gallstone Ileus?", a: "Small bowel obstruction, gallstone in ectopic location, and pneumobilia (air in biliary tree)." },
            { q: "Most common site of impaction in Gallstone Ileus?", a: "Ileocecal valve." },
            { q: "Finding of \"Strawberry Gallbladder\" (Cholesterolosis) indicates?", a: "Yellow specks of cholesterol esters within the gallbladder wall (usually asymptomatic)." },
            { q: "Primary risk factor for Cholangiocarcinoma in the Western world?", a: "Primary Sclerosing Cholangitis (PSC). Part 27: Chronic Pancreatitis & Functional Disorders" },
            { q: "Most common cause of Chronic Pancreatitis in adults (Western world)?", a: "Alcohol abuse." },
            { q: "Diagnosis for a patient with oily, foul-smelling stools and weight loss?", a: "Steatorrhea (Pancreatic Exocrine Insufficiency)." },
            { q: "Best initial step for suspected Pancreatic Exocrine Insufficiency?", a: "Fecal Elastase-1 test." },
            { q: "Treatment for abdominal pain in Chronic Pancreatitis?", a: "Alcohol/smoking cessation, small low-fat meals, and pancreatic enzyme supplementation." },
            { q: "Pathophysiology of Gastroparesis?", a: "Delayed gastric emptying in the absence of mechanical obstruction (common in Diabetes)." },
            { q: "Prokinetic agent of choice for Gastroparesis?", a: "Metoclopramide (D2 receptor antagonist) or Erythromycin." },
            { q: "Primary side effect of long-term Metoclopramide?", a: "Tardive dyskinesia. Part 28: Complex GI Bleeding & Small Bowel Pearls" },
            { q: "Diagnosis for \"watermelon stomach\" appearance in a patient with Systemic Sclerosis?", a: "GAVE (Gastric Antral Vascular Ectasia)." },
            { q: "First-line management for GAVE?", a: "Endoscopic Argon Plasma Coagulation (APC)." },
            { q: "Most common cause of Small Bowel Bleeding in patients <40 years old?", a: "Meckel’s Diverticulum or IBD." },
            { q: "Most common cause of Small Bowel Bleeding in patients >40 years old?", a: "Angiodysplasia or NSAID-induced ulcers." },
            { q: "Initial step for a patient with Hematochezia and hemodynamic instability?", a: "Rule out an Upper GI source with EGD (Upper GI bleed can present with red blood if brisk)." },
            { q: "Interpretation of a \"High SAAG\" (>1.1) with \"Low Protein\" (<2.5) in ascites?", a: "Cirrhosis." },
            { q: "Interpretation of a \"High SAAG\" (>1.1) with \"High Protein\" (>2.5) in ascites?", a: "Heart Failure or Budd-Chiari Syndrome. Part 29: Pharmacological Pearls in GI" },
            { q: "Mechanism of Ursodeoxycholic acid in PBC?", a: "Decreases cholesterol content of bile and reduces immune-mediated duct damage." },
            { q: "Prophylactic medication for esophageal varices in stable cirrhotics?", a: "Non-selective Beta-blockers (Nadolol or Propranolol)." },
            { q: "Mechanism of Terlipressin in Variceal Bleeding?", a: "Vasopressin analogue that causes splanchnic vasoconstriction." },
            { q: "Treatment for Pruritus in cholestatic liver disease?", a: "Cholestyramine, Rifampin, or Naltrexone." },
            { q: "Most common electrolyte side effect of PPIs?", a: "Hypomagnesemia." },
            { q: "Medication that causes \"black tongue\" and \"black stools\"?", a: "Bismuth subsalicylate. Part 30: Step 2 CK \"Management Next Steps\" Final Fire" },
            { q: "Next step for a patient with suspected Achalasia and a \"Bird’s Beak\" on Barium Swallow?", a: "Esophageal Manometry (to confirm absence of peristalsis and failed LES relaxation)." },
            { q: "Next step for a 55-year-old with new-onset GERD?", a: "Upper Endoscopy (to rule out Barrett's or malignancy due to age)." },
            { q: "Next step for a patient with a positive H. pylori stool antigen?", a: "Initiate Triple or Quadruple therapy." },
            { q: "Next step after a diagnosis of Colon Cancer is made via biopsy?", a: "CT scan of Chest/Abdomen/Pelvis for staging." },
            { q: "Next step for a cirrhotic patient with a new solid liver mass <1cm on US?", a: "Repeat Ultrasound in 3-4 months." },
            { q: "Next step for a cirrhotic patient with a new solid liver mass >1cm on US?", a: "Triple-phase CT or MRI with contrast (looking for arterial enhancement/venous washout). ===================================================================== ===================================================================== Section: Internal Medicine" }
          ]
        },
        {
          section: 'Internal Medicine',
          topic: "Nephrology — AKI, CKD, electrolyte & acid-base disorders",
          icon: 'droplet',
          cards: [
            { q: "Definition of AKI by KDIGO criteria?", a: "Increase in SCr $\\ge 0.3$ mg/dL within 48h or $\\ge 1.5\\times$ baseline within 7 days." },
            { q: "Most common cause of intrinsic AKI in hospitalized patients?", a: "Acute Tubular Necrosis (ATN)." },
            { q: "Calculation for Fractional Excretion of Sodium (FeNa)?", a: "$FeNa = \\frac{U_{Na} \\times P_{Cr}}{P_{Na} \\times U_{Cr}} \\times 100$." },
            { q: "FeNa value suggestive of Pre-renal azotemia?", a: "Less than 1%." },
            { q: "FeNa value suggestive of Acute Tubular Necrosis (ATN)?", a: "Greater than 2%." },
            { q: "Urine sediment finding in ATN?", a: "Muddy brown (granular) casts." },
            { q: "Urine sediment finding in Prerenal azotemia?", a: "Hyaline casts." },
            { q: "BUN:Creatinine ratio in Prerenal AKI?", a: "Greater than 20:1." },
            { q: "Two major phases of ATN?", a: "Maintenance phase (oliguric) and Recovery phase (polyuric)." },
            { q: "Classic triad of Acute Interstitial Nephritis (AIN)?", a: "Fever, rash, and peripheral eosinophilia." },
            { q: "Common drug triggers for AIN?", a: "NSAIDs, Penicillins, Sulfonamides, and Proton Pump Inhibitors." },
            { q: "Urinary finding diagnostic of AIN?", a: "White blood cell casts and eosinophiluria." },
            { q: "Pathogenesis of Contrast-Induced Nephropathy?", a: "Direct tubular toxicity and renal vasoconstriction." },
            { q: "Preferred prevention for Contrast-Induced Nephropathy?", a: "Isotonic saline hydration before and after the procedure." },
            { q: "Cause of AKI after starting an ACE inhibitor in a patient with hypertension?", a: "Bilateral Renal Artery Stenosis." },
            { q: "Pathognomonic biopsy finding in Ethylene Glycol poisoning?", a: "Envelope-shaped calcium oxalate crystals." },
            { q: "Treatment for Rhabdomyolysis-induced AKI?", a: "Aggressive IV fluid resuscitation and correction of electrolytes." },
            { q: "Formula for Urine Anion Gap (UAG)?", a: "$UAG = Na + K - Cl$." },
            { q: "Absolute indications for urgent dialysis (mnemonic AEIOU)?", a: "Acidosis, Electrolytes (K+), Ingestion (toxins), Overload (volume), Uremia. Part 2: Chronic Kidney Disease (CKD)" },
            { q: "Definition of CKD?", a: "GFR $< 60$ mL/min/1.73m² or markers of kidney damage for $\\ge 3$ months." },
            { q: "Most common cause of CKD in the US?", a: "Diabetes Mellitus." },
            { q: "Target Blood Pressure for CKD patients (KDIGO)?", a: "$< 120$ mmHg systolic." },
            { q: "Preferred antihypertensive for CKD with albuminuria?", a: "ACE inhibitors or ARBs." },
            { q: "GFR range for Stage 3 CKD?", a: "$30$ to $59$ mL/min/1.73m²." },
            { q: "Definition of Nephrotic-range proteinuria?", a: "$> 3.5$ g/24 hours." },
            { q: "First-line treatment for CKD-associated anemia?", a: "Iron supplementation, then Erythropoiesis-Stimulating Agents (ESAs)." },
            { q: "Target Hemoglobin in CKD patients on ESAs?", a: "$10$ to $11.5$ g/dL (avoiding $> 13$ due to stroke risk)." },
            { q: "Mechanism of Secondary Hyperparathyroidism in CKD?", a: "Phosphate retention and decreased $1,25(OH)_2D$ (Calcitriol) leading to hypocalcemia." },
            { q: "Classic X-ray finding in Renal Osteodystrophy?", a: "\"Rugger-jersey\" spine (subperiosteal bone resorption)." },
            { q: "First-line management for Hyperphosphatemia in CKD?", a: "Dietary phosphate restriction and phosphate binders (e.g., Sevelamer)." },
            { q: "Why is Metformin contraindicated in advanced CKD?", a: "Increased risk of Lactic Acidosis." },
            { q: "Screening test for Diabetic Nephropathy?", a: "Annual urine albumin-to-creatinine ratio (UACR). Part 3: Electrolyte Disorders - Sodium & Water" },
            { q: "Primary determinant of Plasma Osmolality?", a: "Sodium concentration." },
            { q: "Formula for Serum Osmolality?", a: "$2[Na] + \\frac{Glucose}{18} + \\frac{BUN}{2.8}$." },
            { q: "Definition of Hyponatremia?", a: "Serum Sodium $< 135$ mEq/L." },
            { q: "Cause of Hypertonic Hyponatremia?", a: "Hyperglycemia (glucose pulls water into the extracellular space)." },
            { q: "Correction factor for Sodium in Hyperglycemia?", a: "Add $1.6$ mEq/L to Na for every $100$ mg/dL glucose above normal." },
            { q: "Lab findings in SIADH?", a: "Hyponatremia, low serum osm, high urine osm ($> 100$), and high urine sodium ($> 40$)." },
            { q: "Treatment for severe symptomatic hyponatremia?", a: "Hypertonic ($3\\%$) saline." },
            { q: "Maximum rate of Sodium correction to avoid Central Pontine Myelinolysis?", a: "$8$ mEq/L per 24 hours." },
            { q: "Treatment for Hypovolemic Hyponatremia?", a: "Isotonic ($0.9\\%$) saline." },
            { q: "Primary symptom of Central Diabetes Insipidus?", a: "Polyuria and polydipsia with low urine osmolality." },
            { q: "Diagnostic test to differentiate Central vs. Nephrogenic DI?", a: "Desmopressin (DDAVP) challenge." },
            { q: "Response to DDAVP in Central Diabetes Insipidus?", a: "Significant increase in urine osmolality ($> 50\\%$)." },
            { q: "Common medication causing Nephrogenic DI?", a: "Lithium. Part 4: Electrolyte Disorders - Potassium" },
            { q: "Most common ECG change in Hyperkalemia?", a: "Peaked T-waves." },
            { q: "Order of ECG changes in worsening Hyperkalemia?", a: "Peaked T $\\rightarrow$ PR prolongation $\\rightarrow$ QRS widening $\\rightarrow$ Sine wave." },
            { q: "First step in treating Hyperkalemia with ECG changes?", a: "Calcium Gluconate (membrane stabilization)." },
            { q: "Medications that shift Potassium intracellularly?", a: "Insulin (+ glucose), $\\beta_2$-agonists, and Sodium Bicarbonate." },
            { q: "Definitive methods for Potassium removal from the body?", a: "Loop diuretics, Cation exchange resins (Patiromer), or Hemodialysis." },
            { q: "ECG findings in Hypokalemia?", a: "U-waves, T-wave flattening, and ST depression." },
            { q: "Electrolyte deficiency that makes Hypokalemia refractory to treatment?", a: "Hypomagnesemia." },
            { q: "Common cause of Hypokalemia with Hypertension and Metabolic Alkalosis?", a: "Primary Hyperaldosteronism (Conn Syndrome). Part 5: Acid-Base Disorders" },
            { q: "Formula for Anion Gap (AG)?", a: "$Na - (Cl + HCO_3)$." },
            { q: "Normal range for Serum Anion Gap?", a: "$8$ to $12$ mEq/L." },
            { q: "Mnemonic for High Anion Gap Metabolic Acidosis (HAGMA)?", a: "MUDPILES (Methanol, Uremia, DKA, Propylene glycol, Iron/INH, Lactic acid, Ethylene glycol, Salicylates)." },
            { q: "Winter’s Formula for expected $PCO_2$ in Metabolic Acidosis?", a: "$PCO_2 = (1.5 \\times [HCO_3]) + 8 \\pm 2$." },
            { q: "Significance of a measured $PCO_2$ higher than Winter’s Formula calculation?", a: "Concomitant Respiratory Acidosis." },
            { q: "Two major causes of Normal Anion Gap Metabolic Acidosis (NAGMA)?", a: "Diarrhea and Renal Tubular Acidosis (RTA)." },
            { q: "Defect in Type 1 (Distal) RTA?", a: "Inability to secrete $H^+$ in the distal tubule." },
            { q: "Urine pH in Type 1 (Distal) RTA?", a: "Abnormally high ($> 5.5$)." },
            { q: "Defect in Type 2 (Proximal) RTA?", a: "Inability to reabsorb $HCO_3$ in the proximal tubule." },
            { q: "Association of Type 2 RTA with other proximal transport defects?", a: "Fanconi Syndrome." },
            { q: "Defect in Type 4 RTA?", a: "Hypoaldosteronism or aldosterone resistance." },
            { q: "Distinguishing lab feature of Type 4 RTA?", a: "Hyperkalemia." },
            { q: "Acid-base disturbance in early Salicylate toxicity?", a: "Respiratory Alkalosis (direct stimulation of respiratory center)." },
            { q: "Acid-base disturbance in late Salicylate toxicity?", a: "Mixed Respiratory Alkalosis and High Anion Gap Metabolic Acidosis." },
            { q: "Next step if Metabolic Alkalosis is \"Chloride Responsive\"?", a: "Give Isotonic Saline (usually due to vomiting or diuretics)." },
            { q: "Examples of \"Chloride Resistant\" Metabolic Alkalosis?", a: "Hyperaldosteronism and Cushing Syndrome. Part 6: Glomerular Diseases" },
            { q: "Characteristics of Nephrotic Syndrome?", a: "Proteinuria $> 3.5$ g/day, hypoalbuminemia, edema, and hyperlipidemia." },
            { q: "Most common Nephrotic Syndrome in children?", a: "Minimal Change Disease." },
            { q: "Treatment of choice for Minimal Change Disease?", a: "Corticosteroids." },
            { q: "Most common Nephrotic Syndrome in African Americans and HIV patients?", a: "Focal Segmental Glomerulosclerosis (FSGS)." },
            { q: "Nephrotic Syndrome associated with Hepatitis B, NSAIDs, and solid tumors?", a: "Membranous Nephropathy." },
            { q: "Appearance of Membranous Nephropathy on Electron Microscopy?", a: "\"Spike and dome\" subepithelial deposits." },
            { q: "Definition of Nephritic Syndrome?", a: "Hypertension, hematuria (RBC casts), and mild-to-moderate proteinuria." },
            { q: "Most common cause of Glomerulonephritis worldwide?", a: "IgA Nephropathy (Berger Disease)." },
            { q: "Timing of IgA Nephropathy hematuria vs. Post-streptococcal GN?", a: "IgA is \"synpharyngitic\" (days); PSGN is 1-3 weeks post-infection." },
            { q: "Lab finding specific to Post-streptococcal Glomerulonephritis?", a: "Low C3 complement and high Antistreptolysin O (ASO) titers." },
            { q: "Light microscopy finding in Post-streptococcal GN?", a: "\"Starry sky\" granular appearance (lumpy-bumpy)." },
            { q: "Hallmark of Rapidly Progressive Glomerulonephritis (RPGN)?", a: "Crescents in Bowman’s space on light microscopy." },
            { q: "Mechanism of Goodpasture Syndrome?", a: "Anti-GBM antibodies against Type IV collagen." },
            { q: "Organ systems involved in Goodpasture Syndrome?", a: "Lungs (hemoptysis) and Kidneys (hematuria)." },
            { q: "Immunofluorescence pattern in Goodpasture Syndrome?", a: "Linear IgG deposits along the GBM." },
            { q: "Diagnosis for Nephritic syndrome + Hemoptysis + c-ANCA positive?", a: "Granulomatosis with Polyangiitis (Wegener’s)." },
            { q: "Diagnosis for Nephritic syndrome + Asthma + p-ANCA positive?", a: "Eosinophilic Granulomatosis with Polyangiitis (Churg-Strauss)." },
            { q: "Alport Syndrome inheritance and classic triad?", a: "X-linked dominant; Sensorineural deafness, eye abnormalities, and glomerulonephritis. Part 7: Cystic & Vascular Diseases" },
            { q: "Genetics of Adult Polycystic Kidney Disease (ADPKD)?", a: "Autosomal Dominant (PKD1 or PKD2 mutations)." },
            { q: "Extra-renal manifestations of ADPKD?", a: "Berry aneurysms (Circle of Willis), hepatic cysts, and Mitral Valve Prolapse." },
            { q: "Common cause of death in ADPKD patients?", a: "Subarachnoid hemorrhage (ruptured Berry aneurysm) or Cardiovascular disease." },
            { q: "Gold standard for diagnosing Renal Artery Stenosis?", a: "Renal Arteriography." },
            { q: "Typical patient demographic for Fibromuscular Dysplasia?", a: "Young females with new-onset hypertension." },
            { q: "Radiologic sign of Fibromuscular Dysplasia?", a: "\"String of pearls\" appearance of the renal artery." },
            { q: "Cause of AKI after a vascular procedure (e.g., cardiac cath)?", a: "Cholesterol Atheroembolism." },
            { q: "Physical exam finding in Cholesterol Embolization?", a: "Livedo reticularis or \"blue toe\" syndrome. Part 8: Calcium, Magnesium, & Phosphate" },
            { q: "Most common cause of Hypercalcemia in outpatients?", a: "Primary Hyperparathyroidism." },
            { q: "Most common cause of Hypercalcemia in hospitalized patients?", a: "Malignancy." },
            { q: "ECG change in Hypercalcemia?", a: "Shortened QT interval." },
            { q: "Initial treatment for severe Hypercalcemia?", a: "Aggressive Isotonic Saline hydration." },
            { q: "Signs of Hypocalcemia (Neuromuscular irritability)?", a: "Chvostek sign (facial twitch) and Trousseau sign (carpal spasm)." },
            { q: "ECG change in Hypocalcemia?", a: "Prolonged QT interval." },
            { q: "Common cause of Hypomagnesemia?", a: "Chronic alcoholism, diarrhea, and diuretics." },
            { q: "Life-threatening arrhythmia associated with Hypomagnesemia?", a: "Torsades de Pointes. Part 9: Diuretics" },
            { q: "Site of action for Acetazolamide?", a: "Proximal Convoluted Tubule (Carbonic Anhydrase inhibitor)." },
            { q: "Mechanism of Loop Diuretics (e.g., Furosemide)?", a: "Inhibition of Na-K-2Cl cotransporter in the thick ascending limb." },
            { q: "Major side effects of Loop Diuretics?", a: "Ototoxicity, Hypokalemia, Hypocalcemia, and Hyperuricemia." },
            { q: "Mechanism of Thiazide Diuretics?", a: "Inhibition of Na-Cl cotransporter in the distal convoluted tubule." },
            { q: "Distinctive electrolyte effect of Thiazides compared to Loops?", a: "Thiazides cause Hypercalcemia (Loops cause Hypocalcemia)." },
            { q: "Site of action for Spironolactone?", a: "Cortical collecting duct (Aldosterone receptor antagonist)." },
            { q: "Major side effect of Spironolactone in males?", a: "Gynecomastia. Part 10: Miscellaneous High-Yield" },
            { q: "Most common type of kidney stone?", a: "Calcium Oxalate." },
            { q: "Radiologic appearance of Magnesium Ammonium Phosphate (Struvite) stones?", a: "\"Staghorn\" calculus." },
            { q: "Organism associated with Struvite stones?", a: "Urease-positive bacteria (e.g., Proteus, Klebsiella)." },
            { q: "Stones that are radiolucent on X-ray?", a: "Uric Acid stones." },
            { q: "Treatment for Uric Acid stones?", a: "Alkalinization of urine (Potassium Citrate)." },
            { q: "Pathogenesis of Nephrogenic Systemic Fibrosis?", a: "Exposure to Gadolinium-based contrast in patients with low GFR." },
            { q: "Definition of the \"Delta-Delta\" ($\\Delta \\Delta$)?", a: "The ratio of the change in Anion Gap to the change in Bicarbonate ($\\Delta AG / \\Delta HCO_3$)." },
            { q: "Interpretation of a $\\Delta \\Delta$ ratio $> 2$?", a: "Concomitant Metabolic Alkalosis underlying the High Anion Gap Metabolic Acidosis." },
            { q: "Interpretation of a $\\Delta \\Delta$ ratio $< 0.4$?", a: "Concomitant Normal Anion Gap Metabolic Acidosis (NAGMA)." },
            { q: "Formula for the Osmolar Gap?", a: "$Measured\\ Osmolality - Calculated\\ Osmolality$." },
            { q: "Significance of an Osmolar Gap $> 10$ mOsm/kg?", a: "Presence of unmeasured osmotically active substances (e.g., Ethanol, Methanol, Ethylene Glycol)." },
            { q: "Gold standard for diagnosing the specific cause of NAGMA?", a: "Urine Anion Gap (UAG)." },
            { q: "Meaning of a Positive Urine Anion Gap in the setting of Metabolic Acidosis?", a: "Low urinary $NH_4^+$ excretion, suggesting a Renal Tubular Acidosis (RTA)." },
            { q: "Meaning of a Negative Urine Anion Gap in the setting of Metabolic Acidosis?", a: "High urinary $NH_4^+$ excretion, suggesting gastrointestinal bicarbonate loss (Diarrhea). Part 12: Nephrotic & Nephritic Deep Dive" },
            { q: "Pathogenesis of Membranoproliferative Glomerulonephritis (MPGN) Type II?", a: "C3 Nephritic Factor (antibody that stabilizes C3 convertase)." },
            { q: "Classic EM finding in MPGN Type II (Dense Deposit Disease)?", a: "Ribbon-like deposits within the Glomerular Basement Membrane." },
            { q: "Most common cause of secondary FSGS?", a: "Obesity, Heroin use, or HIV infection." },
            { q: "Primary pathology in Diabetic Nephropathy?", a: "Non-enzymatic glycosylation of the GBM and efferent arteriole hyalinization." },
            { q: "Pathognomonic light microscopy finding in Diabetic Nephropathy?", a: "Kimmelstiel-Wilson nodules (nodular glomerulosclerosis)." },
            { q: "Effect of ACE inhibitors on glomerular hemodynamics?", a: "Vasodilation of the efferent arteriole, decreasing intraglomerular pressure." },
            { q: "Renal pathology associated with Hepatitis C virus?", a: "Cryoglobulinemia leading to MPGN." },
            { q: "Characteristic renal biopsy finding in Systemic Lupus Erythematosus (Class IV)?", a: "\"Wire-loop\" lesions (subendothelial immune complex deposits)." },
            { q: "Most common cause of Nephrotic Syndrome in adults in the US?", a: "Focal Segmental Glomerulosclerosis (FSGS)." },
            { q: "Only Nephrotic Syndrome that may present with low complement levels?", a: "Membranoproliferative Glomerulonephritis (MPGN). Part 13: Complex Electrolyte Management" },
            { q: "Definition of \"Pseudohyponatremia\"?", a: "Factitiously low sodium due to extreme Hyperlipidemia or Hyperproteinemia." },
            { q: "Treatment of choice for Euvolemic Hyponatremia (SIADH) resistant to fluid restriction?", a: "Salt tablets, Urea, or Vaptans (Vasopressin antagonists)." },
            { q: "Electrolyte abnormality that increases the risk of Digoxin toxicity?", a: "Hypokalemia." },
            { q: "Common cause of Hypermagnesemia?", a: "Excessive intake of Magnesium-containing antacids/laxatives in CKD patients." },
            { q: "Management of severe Hypermagnesemia with respiratory depression?", a: "IV Calcium Gluconate (antagonizes Magnesium effects)." },
            { q: "Definition of \"Hungry Bone Syndrome\"?", a: "Severe hypocalcemia and hypophosphatemia following parathyroidectomy." },
            { q: "Characteristic lab profile of Vitamin D deficiency?", a: "Low Calcium, Low Phosphate, High PTH." },
            { q: "Characteristic lab profile of Hypoparathyroidism?", a: "Low Calcium, High Phosphate, Low PTH. Part 14: Genetic & Rare Tubular Disorders" },
            { q: "Inheritance and defect in Bartter Syndrome?", a: "Autosomal recessive; defect in the Na-K-2Cl cotransporter (Loop of Henle)." },
            { q: "Clinical presentation of Bartter Syndrome?", a: "Mimics chronic Loop Diuretic use (Hypokalemia, Metabolic Alkalosis, Hypercalciuria)." },
            { q: "Inheritance and defect in Gitelman Syndrome?", a: "Autosomal recessive; defect in the Na-Cl cotransporter (Distal Tubule)." },
            { q: "Clinical presentation of Gitelman Syndrome?", a: "Mimics Thiazide Diuretic use (Hypokalemia, Metabolic Alkalosis, Hypocalciuria, Hypomagnesemia)." },
            { q: "Difference in Urinary Calcium between Bartter and Gitelman?", a: "Bartter has High Urine Calcium; Gitelman has Low Urine Calcium." },
            { q: "Inheritance and defect in Liddle Syndrome?", a: "Autosomal dominant; gain-of-function mutation in ENaC (Collecting Duct)." },
            { q: "Clinical presentation of Liddle Syndrome?", a: "Hypertension, Hypokalemia, and Metabolic Alkalosis with low Aldosterone/Renin levels." },
            { q: "Treatment for Liddle Syndrome?", a: "Amiloride or Triamterene (blocks ENaC); Spironolactone is ineffective. Part 15: Acute Kidney Injury Nuances" },
            { q: "Indication for starting a \"Renal Dose\" of Dopamine in AKI?", a: "None; \"Renal Dose\" Dopamine is no longer recommended and provides no benefit." },
            { q: "Most sensitive indicator of early recovery from ATN?", a: "Increase in urine output (Polyuric phase)." },
            { q: "Common cause of AKI in a patient with a \"fountain-like\" rash and eosinophilia?", a: "Acute Interstitial Nephritis (AIN)." },
            { q: "Likely diagnosis for AKI + palpable purpura + abdominal pain?", a: "IgA Vasculitis (Henoch-Schönlein Purpura)." },
            { q: "Diagnosis for AKI + Schistocytes on peripheral smear + Thrombocytopenia?", a: "Hemolytic Uremic Syndrome (HUS) or Thrombotic Thrombocytopenic Purpura (TTP)." },
            { q: "Pathogenesis of HUS in children?", a: "Shiga toxin (E. coli O157:H7) causing endothelial damage." },
            { q: "Why are NSAIDs contraindicated in AKI?", a: "They inhibit prostaglandins, leading to afferent arteriole vasoconstriction and reduced GFR." },
            { q: "Preferred fluid for resuscitation in a patient with severe Metabolic Acidosis and AKI?", a: "Isotonic Sodium Bicarbonate or Lactated Ringer’s (avoiding normal saline to prevent hyperchloremic acidosis). Part 16: Stones and Obstruction" },
            { q: "Management of a kidney stone $< 5$ mm?", a: "Spontaneous passage with hydration and Alpha-blockers (Tamsulosin)." },
            { q: "Absolute indication for surgical intervention in Urolithiasis?", a: "Urosepsis, intractable pain, or stone in a solitary kidney." },
            { q: "Diagnostic test of choice for suspected Nephrolithiasis?", a: "Non-contrast CT Abdomen and Pelvis." },
            { q: "Dietary recommendation to prevent Calcium Oxalate stones?", a: "Low sodium, normal calcium intake, and increased fluid intake." },
            { q: "Why is low-calcium diet NOT recommended for Calcium Oxalate stones?", a: "Low calcium increases intestinal oxalate absorption, leading to hyperoxaluria." },
            { q: "Diagnosis for sudden onset flank pain + hematuria + enlarged kidney in a Nephrotic patient?", a: "Renal Vein Thrombosis." },
            { q: "Nephrotic Syndrome most commonly associated with Renal Vein Thrombosis?", a: "Membranous Nephropathy. Part 17: Dialysis and Transplant" },
            { q: "Most common cause of death in Dialysis patients?", a: "Cardiovascular disease (Arrhythmias and Heart Failure)." },
            { q: "Most common complication of Peritoneal Dialysis?", a: "Peritonitis (usually Staphylococcus species)." },
            { q: "First-line treatment for Hyperacute Transplant Rejection (within minutes)?", a: "Immediate surgical removal of the graft." },
            { q: "Mechanism of Hyperacute Rejection?", a: "Pre-formed recipient antibodies against donor HLA (Type II Hypersensitivity)." },
            { q: "Mechanism of Acute Transplant Rejection (weeks to months)?", a: "T-cell mediated response against donor HLA (Type IV Hypersensitivity)." },
            { q: "Biopsy finding in Acute Cellular Rejection?", a: "Lymphocytic infiltration of the renal tubules (Tubulitis)." },
            { q: "Major side effect of Cyclosporine?", a: "Nephrotoxicity and gingival hyperplasia." },
            { q: "Characteristic toxicity of Tacrolimus?", a: "Nephrotoxicity and new-onset Diabetes Mellitus." },
            { q: "Drug of choice for CMV prophylaxis in renal transplant?", a: "Valganciclovir. Part 18: Pregnancy and the Kidney" },
            { q: "Normal change in GFR during pregnancy?", a: "Increases by approximately $50\\%$." },
            { q: "Normal Serum Creatinine range in a healthy pregnant woman?", a: "$0.4$ to $0.8$ mg/dL (values $> 0.8$ are abnormal)." },
            { q: "Definition of Preeclampsia?", a: "New-onset Hypertension ($> 140/90$) and Proteinuria ($> 300$ mg/24h) after 20 weeks gestation." },
            { q: "Preferred treatment for Preeclamptic Hypertensive crisis?", a: "IV Hydralazine, Labetalol, or Nifedipine." },
            { q: "Goal of Magnesium Sulfate in Preeclampsia/Eclampsia?", a: "Seizure prophylaxis." },
            { q: "Treatment for Magnesium toxicity in a pregnant patient?", a: "IV Calcium Gluconate." },
            { q: "Explanation for \"Normal Anion Gap\" in some cases of Multiple Myeloma?", a: "Cationic IgG paraproteins decrease the measured anion gap toward zero or negative values." },
            { q: "Effect of severe Hypoalbuminemia on the Anion Gap?", a: "Every 1 g/dL drop in Albumin decreases the \"normal\" AG by 2.5 mEq/L." },
            { q: "Acid-base status in a patient with both persistent vomiting and DKA?", a: "Mixed High Anion Gap Metabolic Acidosis and Metabolic Alkalosis (pH may appear normal)." },
            { q: "Typical electrolyte profile in Adrenal Insufficiency (Addison's)?", a: "Hyponatremia, Hyperkalemia, and Normal Anion Gap Metabolic Acidosis (Type 4 RTA)." },
            { q: "Mechanism of \"Milk-Alkali Syndrome\"?", a: "Excessive intake of Calcium and absorbable alkali leading to Hypercalcemia, Metabolic Alkalosis, and AKI." },
            { q: "Why does Hypokalemia worsen Hepatic Encephalopathy?", a: "It stimulates renal $NH_3$ production (ammoniagenesis), which crosses the blood-brain barrier. Part 20: Advanced Tubular & Glomerular Physiology" },
            { q: "Primary function of the \"Principal Cell\" in the Collecting Duct?", a: "Sodium reabsorption (via ENaC) and Potassium secretion." },
            { q: "Primary function of the \"Alpha-Intercalated Cell\"?", a: "Hydrogen ion ($H^+$) secretion and Bicarbonate ($HCO_3^-$) regeneration." },
            { q: "Definition of the \"Myogenic Response\" in renal autoregulation?", a: "Afferent arterioles constrict in response to high stretch (pressure) to protect the glomerulus." },
            { q: "Mechanism of \"Tubuloglomerular Feedback\"?", a: "Macula densa senses high $NaCl$ delivery and triggers afferent arteriole constriction via Adenosine." },
            { q: "Impact of Prostaglandins on the Afferent Arteriole?", a: "Vasodilation (keeps the \"pipe\" open to maintain GFR)." },
            { q: "Definition of \"Nephron Loss Compensation\"?", a: "Remaining nephrons undergo hypertrophy and hyperfiltration to maintain total GFR. Part 21: Clinical Nephrology & Systemic Disease" },
            { q: "Pathogenesis of Hepatorenal Syndrome (HRS)?", a: "Splanchnic vasodilation leading to severe renal vasoconstriction and \"functional\" AKI." },
            { q: "First-line medical therapy for Hepatorenal Syndrome?", a: "Vasoconstrictors (Terlipressin or Midodrine/Octreotide) plus Albumin." },
            { q: "Classic renal finding in Scleroderma Renal Crisis?", a: "\"Onion-skin\" thickening of the arterial walls and malignant hypertension." },
            { q: "Treatment of choice for Scleroderma Renal Crisis?", a: "ACE Inhibitors (even if Serum Creatinine is rising)." },
            { q: "Significance of \"Dismorphic RBCs\" in urine microscopy?", a: "Suggests the source of bleeding is glomerular (passed through the basement membrane)." },
            { q: "Definition of \"Orthostatic Albuminuria\"?", a: "Increased protein excretion while upright, but normal while supine (common in adolescents). Part 22: Toxicology & The Kidney" },
            { q: "Treatment for Ethylene Glycol or Methanol poisoning?", a: "Fomepizole (inhibits Alcohol Dehydrogenase) and Hemodialysis." },
            { q: "Major renal side effect of Amphotericin B?", a: "Distal (Type 1) RTA and significant Magnesium/Potassium wasting." },
            { q: "Renal toxicity associated with Acyclovir?", a: "Crystalline nephropathy (obstructive AKI); prevented by aggressive hydration." },
            { q: "Likely toxin in a patient with AKI and \"Fanconi-like\" symptoms (glycosuria, phosphaturia)?", a: "If old: Expired Tetracyclines; If modern: Ifosfamide or Tenofovir." },
            { q: "Mechanism of Aristolochic Acid nephropathy (Chinese Herb Nephropathy)?", a: "Severe tubulointerstitial fibrosis and high risk of urothelial malignancy. Part 23: CKD-MBD (Mineral and Bone Disorder)" },
            { q: "Why is Calcitriol ($1,25(OH)_2D$) low in CKD?", a: "Loss of 1-alpha-hydroxylase enzyme in the proximal tubule and high FGF-23 levels." },
            { q: "Role of FGF-23 in early CKD?", a: "Increases urinary phosphate excretion to prevent hyperphosphatemia (at the cost of lowering Vitamin D)." },
            { q: "Definition of \"Calciphylaxis\" (Calcific Uremic Arteriolopathy)?", a: "Systemic calcification of arterioles leading to skin ischemia and necrotic ulcers." },
            { q: "Primary risk factor for Calciphylaxis?", a: "High Calcium-Phosphate product and Warfarin use in ESRD patients." },
            { q: "Distinction between \"Osteitis Fibrosa Cystica\" and \"Adynamic Bone Disease\"?", a: "Osteitis is high bone turnover (high PTH); Adynamic is low bone turnover (over-suppressed PTH). Part 24: Practical Management Nuances" },
            { q: "Definition of \"Resistance\" to Loop Diuretics?", a: "Hypertrophy of the distal tubule allows for compensatory $NaCl$ reabsorption." },
            { q: "Strategy to overcome Loop Diuretic resistance?", a: "\"Sequential Nephron Blockade\" by adding a Thiazide (e.g., Metolazone)." },
            { q: "Indication for Sodium Bicarbonate in CKD patients?", a: "Serum $HCO_3 < 22$ mEq/L (to slow progression of CKD and bone loss)." },
            { q: "When to initiate Dialysis in CKD (non-urgent)?", a: "Usually when GFR is $< 10$ mL/min or when uremic symptoms (nausea, pericarditis, encephalopathy) appear." },
            { q: "Preferred vascular access for long-term Hemodialysis?", a: "Arteriovenous (AV) Fistula (lowest infection and thrombosis rates)." },
            { q: "How long does an AV Fistula typically need to \"mature\" before use?", a: "6 to 8 weeks." },
            { q: "Most common cause of EPO-resistant anemia in CKD?", a: "Iron deficiency. Part 25: Rapid-Fire Differentials" },
            { q: "Patient with Nephrotic syndrome + Macroglossia + Heart Failure?", a: "Renal Amyloidosis." },
            { q: "Apple-green birefringence under polarized light (Congo Red stain)?", a: "Amyloidosis." },
            { q: "Hematuria + Flank Pain + Palpable Mass?", a: "Renal Cell Carcinoma triad (though rarely all three appear together)." },
            { q: "Most common histologic type of Renal Cell Carcinoma?", a: "Clear Cell Carcinoma." },
            { q: "Paraneoplastic syndrome associated with Renal Cell Carcinoma?", a: "Erythrocytosis (due to EPO production)." },
            { q: "Patient with \"Muddy Brown Casts\" + high FeNa after a long surgery?", a: "Ischemic Acute Tubular Necrosis (ATN)." },
            { q: "Sudden AKI + \"Humps\" on EM + Low C3?", a: "Post-streptococcal Glomerulonephritis." },
            { q: "Definition of Laboratory Tumor Lysis Syndrome (TLS)?", a: "Hyperuricemia, hyperkalemia, hyperphosphatemia, and hypocalcemia." },
            { q: "Mechanism of AKI in Tumor Lysis Syndrome?", a: "Intratubular precipitation of uric acid and calcium phosphate crystals." },
            { q: "Preferred agent to prevent TLS in high-risk patients?", a: "Allopurinol (blocks xanthine oxidase)." },
            { q: "Agent used to treat acute, existing hyperuricemia in TLS?", a: "Rasburicase (recombinant urate oxidase that converts uric acid to allantoin)." },
            { q: "Common cause of \"Bland\" urine sediment but rising SCr in a Multiple Myeloma patient?", a: "Myeloma Kidney (Light Chain Cast Nephropathy)." },
            { q: "Nephrotic syndrome classic to Hodgkin Lymphoma?", a: "Minimal Change Disease. Part 27: Diuretic Resistance & Advanced Pharma" },
            { q: "The \"Braking Phenomenon\" in diuretic therapy?", a: "The kidney's compensatory increase in sodium reabsorption in response to chronic loop diuretic use." },
            { q: "Mechanism of Furosemide in treating pulmonary edema (besides diuresis)?", a: "Rapid venous dilation (increasing venous capacitance) before the onset of diuresis." },
            { q: "Electrolyte abnormality caused by Loop Diuretics that can lead to metabolic alkalosis?", a: "Contraction Alkalosis (loss of chloride-rich, bicarbonate-poor fluid)." },
            { q: "Why are Thiazides ineffective when GFR is $< 30$ mL/min?", a: "They cannot reach their site of action in the distal tubule (Metolazone is a notable exception)." },
            { q: "Mechanism of Acetazolamide-induced Metabolic Acidosis?", a: "Inhibition of proximal tubule $HCO_3^-$ reabsorption leads to increased bicarbonate excretion. Part 28: Geriatric & Critical Care Nephrology" },
            { q: "Why is Serum Creatinine an unreliable marker of GFR in the elderly?", a: "Decreased muscle mass leads to lower creatinine production, masking significant renal impairment." },
            { q: "Most common cause of Hyponatremia in the elderly on new medication?", a: "Thiazide-induced hyponatremia." },
            { q: "Distinguishing feature between Hyponatremia caused by SIADH vs. Salt-Wasting?", a: "Salt-Wasting involves volume depletion (hypovolemia); SIADH is euvolemic." },
            { q: "First-line treatment for \"Hepatorenal Syndrome Type 1\"?", a: "Albumin and Vasoconstrictors (e.g., Terlipressin or Norepinephrine)." },
            { q: "Classic renal biopsy finding in \"Myoglobinuric AKI\"?", a: "Pigmented granular casts and tubular necrosis. Part 29: Glomerular Nuances & Rare GN" },
            { q: "Serum Complement level (C3/C4) in IgA Nephropathy?", a: "Characteristically Normal." },
            { q: "Most common extra-renal finding in IgA Vasculitis (Henoch-Schönlein)?", a: "Palpable purpura on the lower extremities and buttocks." },
            { q: "Renal syndrome associated with \"Anti-Phospholipase A2 Receptor\" (PLA2R) antibodies?", a: "Primary Membranous Nephropathy." },
            { q: "Pathogenesis of Alport Syndrome?", a: "Mutation in the alpha-3, 4, or 5 chains of Type IV Collagen." },
            { q: "EM finding in Alport Syndrome?", a: "Irregular thinning and thickening of the GBM (\"Basket-weave\" appearance)." },
            { q: "Classic feature of Thin Basement Membrane Disease?", a: "Persistent, benign microscopic hematuria with a normal family history of renal function. Part 30: Electrolyte \"Double-Checks\"" },
            { q: "Why does Hypermagnesemia cause Hypocalcemia?", a: "It suppresses Parathyroid Hormone (PTH) secretion." },
            { q: "Most common cause of Hypoxemia during a Hemodialysis session?", a: "Acetate in the dialysate or complement activation on the dialysis membrane leading to pulmonary sequestration of WBCs." },
            { q: "Preferred treatment for Hyperkalemia in a patient with Metabolic Acidosis?", a: "Sodium Bicarbonate (shifts $K^+$ into cells while treating the underlying pH)." },
            { q: "ECG finding classic for Hypocalcemia?", a: "Prolonged QT interval (predisposes to arrhythmias)." },
            { q: "Corrected Sodium formula for Hyperglycemia (the \"1.6\" rule)?", a: "$Corrected\\ Na = Measured\\ Na + 0.016 \\times (Glucose - 100)$. Part 31: Transplant Immunology & Rejection" },
            { q: "Timeframe for \"Chronic Rejection\" of a renal transplant?", a: "Months to years after transplant." },
            { q: "Primary pathology in Chronic Transplant Rejection?", a: "Vascular fibrosis and \"Graft Arteriopathy\" (intimal thickening)." },
            { q: "Role of BK Virus in transplant nephropathy?", a: "Reactivation of the polyomavirus leads to tubulointerstitial inflammation and graft loss." },
            { q: "Most common cause of Post-transplant Erythrocytosis?", a: "Overproduction of EPO by the native kidneys or the graft (treated with ACE inhibitors). Part 32: Rapid-Fire Differentials (Summary Cards)" },
            { q: "Hematuria + Hemoptysis + Anti-GBM (+)?", a: "Goodpasture Syndrome." },
            { q: "Hematuria + Hemoptysis + c-ANCA (+)?", a: "Granulomatosis with Polyangiitis (Wegener’s)." },
            { q: "Hematuria + Asthma + p-ANCA (+)?", a: "Eosinophilic Granulomatosis with Polyangiitis (Churg-Strauss)." },
            { q: "Hematuria + Deafness + Family History (+)?", a: "Alport Syndrome." },
            { q: "Hematuria + Recent Pharyngitis (1-3 days prior)?", a: "IgA Nephropathy." },
            { q: "Hematuria + Recent Pharyngitis (2 weeks prior) + Low C3?", a: "Post-Streptococcal Glomerulonephritis (PSGN)." },
            { q: "Hematuria + HIV + Heroin Use + Nephrotic range proteinuria?", a: "Focal Segmental Glomerulosclerosis (FSGS)." },
            { q: "Definition of \"Renal Reserve\"?", a: "The ability of the kidney to increase GFR in response to a protein load or amino acid infusion." },
            { q: "Why does Urea reabsorption increase in states of dehydration?", a: "ADH (Vasopressin) increases the permeability of the medullary collecting duct to urea to maintain the osmotic gradient." },
            { q: "Formula for \"Free Water Clearance\" ($C_{H2O}$)?", a: "$C_{H2O} = V - \\frac{U_{osm} \\times V}{P_{osm}}$." },
            { q: "Significance of a negative Free Water Clearance?", a: "The kidney is conserving water (producing concentrated urine), typical in states of ADH excess." },
            { q: "What does \"Urine Osmolar Gap\" measure?", a: "It estimates ammonium ($NH_4^+$) excretion in Normal Anion Gap Metabolic Acidosis." },
            { q: "Calculation for Urine Osmolar Gap?", a: "$U_{osm} (measured) - [2(Na + K) + \\frac{Urea}{2.8} + \\frac{Glucose}{18}]$. Part 34: Nephrolithiasis & Crystal Arthropathy" },
            { q: "Primary inhibitor of calcium stone formation found in normal urine?", a: "Citrate (it chelates calcium in the urine)." },
            { q: "Most common cause of Hypercalciuria with normal serum calcium?", a: "Idiopathic Hypercalciuria." },
            { q: "Why does Crohn’s Disease increase the risk of Calcium Oxalate stones?", a: "Fat malabsorption binds calcium in the gut, leaving oxalate free to be absorbed (Enteric Hyperoxaluria)." },
            { q: "Classic urine crystal finding in Ethylene Glycol ingestion?", a: "Monohydrate calcium oxalate (needle/dumbbell shaped) or dihydrate (envelope shaped)." },
            { q: "Mechanism of \"Indinavir Stones\"?", a: "Precipitation of the protease inhibitor medication itself; these stones are radiolucent on CT. Part 35: Vascular & Ischemic Renal Disease" },
            { q: "Definition of \"Flash Pulmonary Edema\" in Nephrology?", a: "Sudden, severe pulmonary edema often associated with bilateral renal artery stenosis." },
            { q: "Preferred screening test for Renal Artery Stenosis in patients with CKD?", a: "Doppler Ultrasound or MR Angiography (avoiding CT with contrast)." },
            { q: "Most common cause of Renal Artery Stenosis in elderly males?", a: "Atherosclerosis." },
            { q: "Renal biopsy finding in Malignant Hypertension?", a: "Hyperplastic arteriolitis (\"onion-skinning\") and fibrinoid necrosis." },
            { q: "Typical presentation of Renal Artery Embolism?", a: "Acute flank pain, nausea, and high LDH with a normal urine sediment. Part 36: Pediatric & Congenital Anomalies" },
            { q: "Most common cause of bladder outlet obstruction in newborn males?", a: "Posterior Urethral Valves." },
            { q: "Diagnostic test of choice for Posterior Urethral Valves?", a: "Voiding Cystourethrogram (VCUG)." },
            { q: "Mnemonic for Potter Sequence (resulting from oligohydramnios)?", a: "Pulmonary hypoplasia, Oligohydramnios, Twisted face, Twisted skin, Extremity defects, Renal failure." },
            { q: "Most common cause of a palpable abdominal mass in a newborn?", a: "Multicystic Dysplastic Kidney (MCDK)." },
            { q: "Genetic defect in Autosomal Recessive Polycystic Kidney Disease (ARPKD)?", a: "Mutation in the PKHD1 gene (fibrocystin)." },
            { q: "Systemic finding always present in ARPKD?", a: "Congenital Hepatic Fibrosis. Part 37: Advanced Fluid Management" },
            { q: "Definition of \"Isotonic saline\" ($0.9\\% NaCl$) osmolality?", a: "308 mOsm/L." },
            { q: "Why can $0.9\\%$ Saline cause a Normal Anion Gap Metabolic Acidosis?", a: "The high chloride load ($154$ mEq/L) drives bicarbonate out of the plasma (Hyperchloremic Acidosis)." },
            { q: "Preferred fluid for resuscitation in Hypernatremic Dehydration?", a: "Initial Isotonic Saline (to restore BP), followed by $5\\%$ Dextrose ($D5W$) or $0.45\\%$ Saline." },
            { q: "Formula for \"Free Water Deficit\" in Hypernatremia?", a: "$0.6 \\times Weight \\times (\\frac{Current\\ Na}{140} - 1)$. Part 38: Kidney in Systemic Disease (The \"Connectors\")" },
            { q: "Most common renal lesion in patients with Rheumatoid Arthritis?", a: "AA Amyloidosis (secondary to chronic inflammation)." },
            { q: "Effect of NSAIDs on Renal Blood Flow in a \"low-effective-circulating-volume\" state?", a: "They block vasodilatory prostaglandins, leading to acute prerenal failure." },
            { q: "Distinguishing feature of Lithium-induced Nephrogenic DI vs. others?", a: "It can persist even after the drug is discontinued due to permanent collecting duct damage." },
            { q: "Classic renal finding in Sarcoidosis?", a: "Hypercalciuria and Hypercalcemia (due to extra-renal 1-alpha-hydroxylase in granulomas)." },
            { q: "Renal biopsy finding in Sjogren’s Syndrome?", a: "Chronic Interstitial Nephritis, often presenting as Type 1 RTA. Part 39: End-Stage Renal Disease (ESRD) Management" },
            { q: "Leading cause of death in the first year of starting Dialysis?", a: "Infection (specifically catheter-related sepsis)." },
            { q: "Target \"Urea Reduction Ratio\" (URR) for adequate dialysis?", a: "Greater than $65\\%$." },
            { q: "Definition of \"Disequilibrium Syndrome\" during dialysis?", a: "Cerebral edema caused by the rapid removal of urea from the blood while it remains high in the brain." },
            { q: "Primary treatment for Uremic Pericarditis?", a: "Immediate intensification of Hemodialysis." },
            { q: "Why is Heparin used during Hemodialysis?", a: "To prevent clotting of the blood within the extracorporeal circuit/dialyzer. Part 40: Acid-Base \"Must-Knows\"" },
            { q: "Most common cause of Respiratory Alkalosis in a clinical setting?", a: "Hyperventilation (Anxiety, Pain, or early Sepsis)." },
            { q: "Expected compensation for Acute Respiratory Acidosis?", a: "Bicarbonate increases by $1$ mEq/L for every $10$ mmHg increase in $PCO_2$." },
            { q: "Expected compensation for Chronic Respiratory Acidosis?", a: "Bicarbonate increases by $3.5$ to $4$ mEq/L for every $10$ mmHg increase in $PCO_2$." },
            { q: "Definition of \"Metabolic Alkalosis, Saline-Resistant\"?", a: "Urinary Chloride $> 20$ mEq/L; usually due to mineralocorticoid excess." },
            { q: "Definition of \"Metabolic Alkalosis, Saline-Responsive\"?", a: "Urinary Chloride $< 15$ mEq/L; usually due to vomiting or nasogastric suction. ===================================================================== ===================================================================== Section: Internal Medicine" }
          ]
        },
        {
          section: 'Internal Medicine',
          topic: "Endocrinology — Diabetes, thyroid, adrenal, pituitary",
          icon: 'activity',
          cards: [
            { q: "Diagnostic criteria for DM based on Fasting Plasma Glucose (FPG)?", a: "$\\ge 126$ mg/dL (7.0 mmol/L)." },
            { q: "Diagnostic criteria for DM based on HbA1c?", a: "$\\ge 6.5\\%$." },
            { q: "Diagnostic criteria for DM based on 2-hour Oral Glucose Tolerance Test (OGTT)?", a: "$\\ge 200$ mg/dL (11.1 mmol/L)." },
            { q: "Definition of \"Prediabetes\" by HbA1c range?", a: "$5.7\\%$ to $6.4\\%$." },
            { q: "Primary pathology in Type 1 DM?", a: "Autoimmune destruction of pancreatic beta cells leading to absolute insulin deficiency." },
            { q: "Most common autoantibody checked in Type 1 DM?", a: "Glutamic Acid Decarboxylase (GAD-65) antibodies." },
            { q: "Primary pathology in Type 2 DM?", a: "Insulin resistance combined with relative insulin deficiency." },
            { q: "First-line pharmacological treatment for Type 2 DM?", a: "Metformin." },
            { q: "Major contraindication for Metformin use?", a: "Estimated GFR < 30 mL/min (risk of lactic acidosis)." },
            { q: "Mechanism of action of Sulfonylureas (e.g., Glipizide)?", a: "Closes ATP-sensitive K+ channels in beta cells to stimulate insulin release." },
            { q: "Primary side effect of Sulfonylureas?", a: "Hypoglycemia and weight gain." },
            { q: "Mechanism of SGLT-2 inhibitors (e.g., Empagliflozin)?", a: "Inhibits glucose reabsorption in the proximal convoluted tubule, causing glucosuria." },
            { q: "Specific benefit of SGLT-2 inhibitors in comorbid patients?", a: "Reduction in heart failure hospitalizations and progression of CKD." },
            { q: "Common side effect of SGLT-2 inhibitors?", a: "Euglycemic DKA and Genitourinary yeast infections." },
            { q: "Mechanism of GLP-1 agonists (e.g., Liraglutide, Semaglutide)?", a: "Increases glucose-dependent insulin secretion, slows gastric emptying, increases satiety." },
            { q: "GLP-1 agonists are contraindicated in patients with a history of?", a: "Medullary Thyroid Cancer or MEN 2 (due to C-cell hyperplasia risk)." },
            { q: "Clinical triad of Diabetic Ketoacidosis (DKA)?", a: "Hyperglycemia, Ketosis (Anion Gap Metabolic Acidosis), and Dehydration." },
            { q: "Best initial step in management of DKA?", a: "Aggressive IV fluid resuscitation (Normal Saline)." },
            { q: "When should Potassium be added to IV fluids in DKA management?", a: "When serum K+ is < 5.2 mEq/L (insulin will shift K+ intracellularly)." },
            { q: "Distinctive feature of Hyperosmolar Hyperglycemic State (HHS) compared to DKA?", a: "Extreme hyperglycemia (> 600 mg/dL), high serum osmolality, and absence of significant ketoacidosis." },
            { q: "Screening frequency for diabetic retinopathy and nephropathy?", a: "Annually (starting at diagnosis for T2DM; 5 years after diagnosis for T1DM)." },
            { q: "First sign of diabetic nephropathy on labs?", a: "Moderately increased albuminuria (Microalbuminuria, 30–300 mg/day). Section 2: Thyroid Disorders" },
            { q: "Most common cause of Hypothyroidism in iodine-sufficient regions?", a: "Hashimoto Thyroiditis (Chronic Autoimmune Thyroiditis)." },
            { q: "Best initial screening test for thyroid function?", a: "Serum TSH." },
            { q: "Serum TSH and Free T4 levels in Subclinical Hypothyroidism?", a: "Elevated TSH with normal Free T4." },
            { q: "Serum TSH and Free T4 levels in Secondary (Central) Hypothyroidism?", a: "Low or inappropriately normal TSH with low Free T4." },
            { q: "Most common cause of Hyperthyroidism?", a: "Graves Disease." },
            { q: "Pathognomonic physical exam findings in Graves Disease?", a: "Exophthalmos (proptosis) and Pretibial Myxedema." },
            { q: "Antibody associated with Graves Disease?", a: "Thyroid Stimulating Immunoglobulin (TSI) or TSH-receptor antibodies." },
            { q: "Radioactive Iodine Uptake (RAIU) pattern in Graves Disease?", a: "Diffuse, increased uptake." },
            { q: "RAIU pattern in Toxic Multinodular Goiter?", a: "Patchy, focal areas of increased uptake (\"Hot\" nodules)." },
            { q: "RAIU pattern in Subacute (de Quervain) Thyroiditis?", a: "Decreased or low uptake (due to release of preformed hormone/inflammation)." },
            { q: "Clinical presentation of de Quervain Thyroiditis?", a: "Painful/tender thyroid gland, often following a viral URI." },
            { q: "Management of de Quervain Thyroiditis?", a: "NSAIDs and Beta-blockers (self-limiting)." },
            { q: "Serious side effect of Thionamides (PTU/Methimazole)?", a: "Agranulocytosis." },
            { q: "Preferred Thionamide in the first trimester of pregnancy?", a: "Propylthiouracil (PTU)." },
            { q: "Preferred Thionamide for most non-pregnant patients and 2nd/3rd trimester?", a: "Methimazole (due to lower hepatotoxicity)." },
            { q: "Characteristic EKG finding in Myxedema Coma?", a: "Bradycardia and low voltage complexes." },
            { q: "Treatment for Thyroid Storm?", a: "Propranolol, PTU, IV Iodine (1 hour after PTU), and Glucocorticoids." },
            { q: "Most common type of Thyroid Cancer?", a: "Papillary Thyroid Carcinoma." },
            { q: "Histological hallmarks of Papillary Thyroid Carcinoma?", a: "Orphan Annie eye nuclei and Psammoma bodies." },
            { q: "Thyroid cancer associated with MEN 2A and 2B?", a: "Medullary Thyroid Carcinoma (derived from C-cells; produces Calcitonin)." },
            { q: "Management of a thyroid nodule with low TSH?", a: "Perform Thyroid Scintigraphy (RAIU scan)." },
            { q: "Management of a thyroid nodule > 1cm with normal/high TSH?", a: "Fine Needle Aspiration (FNA). Section 3: Adrenal Gland Disorders" },
            { q: "Most common cause of Primary Adrenal Insufficiency (Addison's) worldwide?", a: "Tuberculosis (Autoimmune in developed countries)." },
            { q: "Electrolyte abnormalities in Primary Adrenal Insufficiency?", a: "Hyponatremia, Hyperkalemia, and Hyperchloremic Metabolic Acidosis." },
            { q: "Why does skin hyperpigmentation occur in Addison's Disease?", a: "High ACTH levels lead to increased Melanocyte-Stimulating Hormone (MSH) production." },
            { q: "Best initial test for suspected Adrenal Insufficiency?", a: "8 AM Serum Cortisol and ACTH." },
            { q: "Definitive diagnostic test for Adrenal Insufficiency?", a: "Cosyntropin (ACTH) Stimulation Test." },
            { q: "Management of Acute Adrenal Crisis?", a: "High-dose IV Hydrocortisone and aggressive IV fluids." },
            { q: "Difference between Cushing Syndrome and Cushing Disease?", a: "Syndrome is any cause of hypercortisolism; Disease is specifically a pituitary ACTH-secreting adenoma." },
            { q: "Most common overall cause of Cushing Syndrome?", a: "Exogenous glucocorticoid administration." },
            { q: "First-line screening tests for Cushing Syndrome (choose one)?", a: "24-hour urinary free cortisol, late-night salivary cortisol, or Low-dose Dexamethasone Suppression Test." },
            { q: "Results of High-dose Dexamethasone Suppression Test in Cushing Disease?", a: "Cortisol levels suppress by > 50%." },
            { q: "Results of High-dose Dexamethasone Suppression Test in Ectopic ACTH (e.g., Small Cell Lung Cancer)?", a: "No suppression of cortisol." },
            { q: "Classic triad of Pheochromocytoma?", a: "Episodic headache, diaphoresis, and tachycardia (with hypertension)." },
            { q: "Best initial screening test for Pheochromocytoma?", a: "Plasma or 24-hour urinary metanephrines." },
            { q: "Pre-operative management order for Pheochromocytoma?", a: "Alpha-blockade (Phenoxybenzamine) first, then Beta-blockade." },
            { q: "Primary Hyperaldosteronism (Conn Syndrome) triad?", a: "Hypertension, Hypokalemia, and Metabolic Alkalosis." },
            { q: "Screening test for Primary Hyperaldosteronism?", a: "Plasma Aldosterone to Plasma Renin Activity (PAC/PRA) ratio > 20." },
            { q: "Most common cause of Congenital Adrenal Hyperplasia (CAH)?", a: "21-hydroxylase deficiency." },
            { q: "Lab finding in 21-hydroxylase deficiency?", a: "Elevated 17-hydroxyprogesterone. Section 4: Pituitary and Hypothalamus" },
            { q: "Most common functional (secretory) pituitary adenoma?", a: "Prolactinoma." },
            { q: "Clinical presentation of Prolactinoma in women?", a: "Galactorrhea, amenorrhea, and infertility." },
            { q: "First-line treatment for Prolactinomas?", a: "Dopamine agonists (Cabergoline or Bromocriptine)." },
            { q: "Gold standard test for diagnosing Acromegaly?", a: "Oral Glucose Tolerance Test (failure to suppress Growth Hormone)." },
            { q: "Screening test for Acromegaly?", a: "Serum Insulin-like Growth Factor-1 (IGF-1)." },
            { q: "Clinical features of Acromegaly?", a: "Enlarged hands/feet, frontal bossing, macroglossia, and new-onset Sleep Apnea or DM." },
            { q: "Definition of Diabetes Insipidus (DI)?", a: "Passage of large volumes (> 3L/day) of dilute urine (Osmolality < 300)." },
            { q: "Central vs. Nephrogenic DI response to Desmopressin (DDAVP)?", a: "Central DI shows > 50% increase in urine osmolality; Nephrogenic DI shows little to no response." },
            { q: "Common medication cause of Nephrogenic DI?", a: "Lithium." },
            { q: "Electrolyte hallmark of SIADH?", a: "Euvolemic Hyponatremia." },
            { q: "Management of mild SIADH?", a: "Fluid restriction." },
            { q: "Dangerous complication of correcting hyponatremia too rapidly?", a: "Osmotic Demyelination Syndrome (Central Pontine Myelinolysis)." },
            { q: "Safe rate of sodium correction in chronic hyponatremia?", a: "< 8-10 mEq/L in 24 hours." },
            { q: "Definition of Sheehan Syndrome?", a: "Ischemic necrosis of the pituitary gland following severe postpartum hemorrhage." },
            { q: "Early sign of Sheehan Syndrome?", a: "Failure to lactate (loss of prolactin). Section 5: Calcium and Bone Metabolism" },
            { q: "Most common cause of Primary Hyperparathyroidism?", a: "Solitary Parathyroid Adenoma." },
            { q: "Lab findings in Primary Hyperparathyroidism?", a: "Elevated Calcium, Low Phosphorus, Elevated PTH, Elevated Vitamin D." },
            { q: "Radiographic finding classic for Hyperparathyroidism?", a: "Osteitis Fibrosa Cystica (salt-and-pepper skull, subperiosteal bone resorption)." },
            { q: "Primary cause of Secondary Hyperparathyroidism?", a: "Chronic Kidney Disease (low Vitamin D/High Phos leading to high PTH)." },
            { q: "Definition of Tertiary Hyperparathyroidism?", a: "Autonomous PTH secretion following long-standing secondary hyperparathyroidism." },
            { q: "Chvostek and Trousseau signs indicate?", a: "Hypocalcemia." },
            { q: "EKG finding in Hypocalcemia?", a: "Prolonged QT interval." },
            { q: "EKG finding in Hypercalcemia?", a: "Shortened QT interval." },
            { q: "First-line treatment for symptomatic or severe Hypercalcemia (>14)?", a: "Aggressive IV hydration (Normal Saline)." },
            { q: "T-score range for Osteopenia?", a: "-1.0 to -2.5." },
            { q: "T-score for Osteoporosis?", a: "$\\le -2.5$." },
            { q: "First-line pharmacological treatment for Osteoporosis?", a: "Bisphosphonates (e.g., Alendronate). Section 6: Multiple Endocrine Neoplasia (MEN)" },
            { q: "Components of MEN 1 (3 Ps)?", a: "Pituitary adenoma, Parathyroid hyperplasia, Pancreatic tumors (Zollinger-Ellison)." },
            { q: "Components of MEN 2A (1 M, 2 Ps)?", a: "Medullary thyroid cancer, Pheochromocytoma, Parathyroid hyperplasia." },
            { q: "Components of MEN 2B (2 Ms, 1 P)?", a: "Medullary thyroid cancer, Marfanoid habitus/Mucosal neuromas, Pheochromocytoma." },
            { q: "Gene mutation associated with MEN 2A and 2B?", a: "RET proto-oncogene. Section 7: Reproductive Endocrinology (Internal Medicine context)" },
            { q: "Most common cause of hirsutism and infertility in women?", a: "Polycystic Ovary Syndrome (PCOS)." },
            { q: "Lab ratio suggestive of PCOS?", a: "LH:FSH ratio > 2:1 (though not diagnostic)." },
            { q: "Primary risk associated with untreated PCOS?", a: "Endometrial Hyperplasia/Cancer (due to unopposed estrogen)." },
            { q: "Definition of Klinefelter Syndrome karyotype?", a: "47, XXY." },
            { q: "Physical findings in Klinefelter Syndrome?", a: "Small firm testes, gynecomastia, tall stature, and primary hypogonadism." },
            { q: "Definition of Kallmann Syndrome?", a: "Hypogonadotropic hypogonadism with anosmia (failed migration of GnRH neurons). Section 8: Miscellaneous High-Yield" },
            { q: "Serum marker for monitoring Medullary Thyroid Cancer recurrence?", a: "Calcitonin." },
            { q: "Serum marker for monitoring Papillary/Follicular Thyroid Cancer recurrence?", a: "Thyroglobulin." },
            { q: "Diagnosis of VIPoma (WDHA Syndrome)?", a: "Watery Diarrhea, Hypokalemia, Achlorhydria." },
            { q: "Diagnosis of Glucagonoma?", a: "Necrolytic Migratory Erythema, Weight loss, and Diabetes." },
            { q: "Primary hormone deficiency in Polyglandular Autoimmune Syndrome Type 1?", a: "Hypoparathyroidism, Adrenal Insufficiency, and Mucocutaneous Candidiasis." },
            { q: "\"Rule of 10s\" for Pheochromocytoma?", a: "10% bilateral, 10% malignant, 10% extra-adrenal, 10% familial." },
            { q: "Effect of Estrogen (Pregnancy/OCPs) on thyroid lab values?", a: "Increases Thyroid Binding Globulin (TBG), increasing Total T4, but Free T4 remains normal." },
            { q: "Most common cause of death in patients with Acromegaly?", a: "Heart Failure (dilated cardiomyopathy)." },
            { q: "Medical treatment to reduce GH in Acromegaly?", a: "Octreotide or Lanreotide (Somatostatin analogs)." },
            { q: "Definition of Nelson Syndrome?", a: "Rapid enlargement of an ACTH-secreting pituitary adenoma after bilateral adrenalectomy. Section 9: Advanced Diabetes Management & Complications" },
            { q: "What is the \"Somogyi Effect\"?", a: "Rebound hyperglycemia in the morning caused by a response to hypoglycemia during the night." },
            { q: "What is the \"Dawn Phenomenon\"?", a: "Morning hyperglycemia due to the natural early-morning surge of Growth Hormone and Cortisol." },
            { q: "Preferred screening test for Diabetic Gastroparesis?", a: "Gastric emptying study (scintigraphy) with a solid meal." },
            { q: "First-line medical treatment for Diabetic Gastroparesis?", a: "Metoclopramide or Erythromycin." },
            { q: "Management of Diabetic Neuropathy pain?", a: "Gabapentin, Pregabalin, or Duloxetine." },
            { q: "Most common cause of death in patients with Diabetes Mellitus?", a: "Cardiovascular disease (Myocardial Infarction)." },
            { q: "Diagnostic criteria for Metabolic Syndrome?", a: "3 of 5: Large waist, High TG, Low HDL, HTN, High fasting glucose." },
            { q: "Mechanism of Thiazolidinediones (e.g., Pioglitazone)?", a: "Activates PPAR-gamma to increase peripheral insulin sensitivity." },
            { q: "Major side effects of Pioglitazone?", a: "Weight gain, edema, and worsening of Heart Failure." },
            { q: "Mechanism of Alpha-glucosidase inhibitors (e.g., Acarbose)?", a: "Inhibits intestinal enzymes to delay carbohydrate absorption. Section 10: Specific Thyroid Scenarios" },
            { q: "Management of Amiodarone-induced Thyrotoxicosis Type 1 (Jod-Basedow)?", a: "Thionamides (Methimazole/PTU)." },
            { q: "Management of Amiodarone-induced Thyrotoxicosis Type 2 (Destructive)?", a: "Glucocorticoids." },
            { q: "Thyroid finding in Riedel Thyroiditis?", a: "\"Rock-hard,\" fixed, painless goiter (fibrosis may extend to adjacent structures)." },
            { q: "Definition of \"Euthyroid Sick Syndrome\"?", a: "Low T3, normal/low T4, and normal/low TSH in the setting of severe non-thyroidal illness." },
            { q: "Most common cause of Euthyroid Sick Syndrome?", a: "Critical illness or starvation (decreased peripheral conversion of T4 to T3)." },
            { q: "Management of Euthyroid Sick Syndrome?", a: "Observation and treatment of the underlying illness (do not give levothyroxine)." },
            { q: "Risk of untreated Subclinical Hyperthyroidism in the elderly?", a: "Atrial Fibrillation and Osteoporosis." },
            { q: "Thyroid cancer that spreads hematogenously?", a: "Follicular Thyroid Carcinoma." },
            { q: "Why can't FNA distinguish Follicular Adenoma from Follicular Carcinoma?", a: "Carcinoma requires visual evidence of capsular or vascular invasion (not seen on cytology). Section 11: Adrenal Nuances & Surgery" },
            { q: "Most common cause of Secondary Adrenal Insufficiency?", a: "Chronic glucocorticoid therapy followed by abrupt withdrawal." },
            { q: "Differentiator between Primary and Secondary Adrenal Insufficiency on labs?", a: "Secondary has normal Mineralocorticoid (Aldosterone) levels and no hyperpigmentation." },
            { q: "Management of an incidentally discovered adrenal mass (Incidentaloma)?", a: "Screen for function (24hr catecholamines, cortisol, and renin/aldosterone)." },
            { q: "When is surgery indicated for an adrenal incidentaloma?", a: "If it is functional (hormone-secreting) or > 4cm in size." },
            { q: "Management of Primary Hyperaldosteronism due to bilateral adrenal hyperplasia?", a: "Aldosterone antagonists (Spironolactone or Eplerenone)." },
            { q: "Mechanism of Metyrapone?", a: "Inhibits 11-beta-hydroxylase, blocking cortisol synthesis (used in Cushing's testing)." },
            { q: "Electrolyte finding in Waterhouse-Friderichsen Syndrome?", a: "Acute adrenal insufficiency (low Na+, high K+) due to adrenal hemorrhage. Section 12: Hypothalamic & Pituitary Details" },
            { q: "Triad of McCune-Albright Syndrome?", a: "Precocious puberty, Café-au-lait spots (irregular borders), and Polyostotic fibrous dysplasia." },
            { q: "Most common cause of Hyperprolactinemia besides Prolactinoma?", a: "Medications (especially Antipsychotics/Dopamine antagonists)." },
            { q: "Mechanism of Pituitary Apoplexy?", a: "Sudden hemorrhage or infarction of a pituitary adenoma." },
            { q: "First step in suspected Pituitary Apoplexy with visual loss?", a: "Urgent surgical decompression and high-dose glucocorticoids." },
            { q: "Difference between Psychogenic Polydipsia and DI?", a: "In Psychogenic Polydipsia, serum sodium is typically low (dilutional)." },
            { q: "Lab finding in Empty Sella Syndrome?", a: "Often incidental and asymptomatic; pituitary function is usually normal." },
            { q: "Most common tumor of the pituitary region in children?", a: "Craniopharyngioma." },
            { q: "Imaging characteristic of Craniopharyngioma?", a: "Suprasellar mass with calcifications on CT. Section 13: Lipid Metabolism (Harrison's Highlights)" },
            { q: "First-line therapy for isolated Hypertriglyceridemia (> 500 mg/dL)?", a: "Fibrates (to prevent Pancreatitis)." },
            { q: "Mechanism of Statins?", a: "HMG-CoA Reductase inhibitors (upregulate LDL receptors)." },
            { q: "Most common side effect of Statins?", a: "Myalgia and (rarely) Rhabdomyolysis." },
            { q: "Mechanism of Ezetimibe?", a: "Inhibits cholesterol absorption at the brush border of the small intestine." },
            { q: "Primary side effect of Niacin?", a: "Skin flushing (mediated by prostaglandins; treat with Aspirin)." },
            { q: "Type I Dyslipidemia (Hyperchylomicronemia) deficiency?", a: "Lipoprotein Lipase (LPL) or ApoC-II deficiency." },
            { q: "Physical finding in Type II Hypercholesterolemia?", a: "Tendon Xanthomas (Achilles) and Xanthelasma." },
            { q: "Physical finding in Hypertriglyceridemia?", a: "Eruptive Xanthomas (yellow papules on back/buttocks). Section 14: Bone & Mineral (Williams Textbook Focus)" },
            { q: "Definitive treatment for Vitamin D deficiency (Osteomalacia)?", a: "Ergocalciferol or Cholecalciferol (Vitamin D2 or D3) supplementation." },
            { q: "Lab values in Vitamin D deficiency?", a: "Low Ca, Low Phosphorus, High PTH." },
            { q: "Hallmark of Paget’s Disease of Bone on labs?", a: "Isolated, severely elevated Alkaline Phosphatase with normal Ca/Phos/PTH." },
            { q: "First-line treatment for Paget’s Disease of Bone?", a: "Bisphosphonates (to inhibit osteoclast activity)." },
            { q: "Management of Hungry Bone Syndrome (post-parathyroidectomy)?", a: "Aggressive Calcium and Vitamin D supplementation." },
            { q: "Cause of Pseudohypoparathyroidism?", a: "End-organ resistance to PTH (Albright Hereditary Osteodystrophy)." },
            { q: "Lab profile of Pseudohypoparathyroidism?", a: "Low Calcium, High Phosphorus, High PTH. Section 15: Metabolic Emergency & \"Must-Knows\"" },
            { q: "Best fluid choice for a patient in Hypercalcemic Crisis?", a: "0.9% Normal Saline (aggressive rate)." },
            { q: "Why is Loop Diuretic (Furosemide) use restricted in Hypercalcemia?", a: "Only used after volume repletion to prevent fluid overload." },
            { q: "Standard medical management for Symptomatic Hypocalcemia?", a: "IV Calcium Gluconate." },
            { q: "Most common cause of hypercalcemia in the outpatient setting?", a: "Primary Hyperparathyroidism." },
            { q: "Most common cause of hypercalcemia in the inpatient setting?", a: "Malignancy (PTHrP or bone metastases)." },
            { q: "How to calculate Corrected Calcium?", a: "Corrected Ca = [Measured Ca] + 0.8 * (4 - Albumin)." },
            { q: "Immediate treatment for severe Hyperkalemia with EKG changes?", a: "IV Calcium Gluconate (to stabilize the cardiac membrane)." },
            { q: "Hormonal cause of secondary Hypertension in a young patient with abdominal bruit?", a: "Renal Artery Stenosis (Secondary Hyperaldosteronism)." },
            { q: "Characteristic of Glucagonoma rash?", a: "Necrolytic Migratory Erythema (presents in intertriginous areas)." },
            { q: "Hormone elevated in Carcinoid Syndrome?", a: "Serotonin (5-HIAA in urine)." },
            { q: "Clinical symptoms of Carcinoid Syndrome?", a: "Flushing, diarrhea, and right-sided heart valve lesions." },
            { q: "Why does Carcinoid Syndrome usually require liver metastasis?", a: "Primary tumor secretions are normally metabolized by the liver (first-pass). Section 16: Endocrine Hypertension & Renovascular" },
            { q: "Screening test for Renal Artery Stenosis?", a: "Renal Duplex Ultrasound or CT/MR Angiography." },
            { q: "Effect of Renal Artery Stenosis on Renin and Aldosterone?", a: "High Renin, High Aldosterone (Secondary Hyperaldosteronism)." },
            { q: "Most common cause of Renal Artery Stenosis in young women?", a: "Fibromuscular Dysplasia." },
            { q: "Most common cause of Renal Artery Stenosis in elderly men?", a: "Atherosclerosis." },
            { q: "Classic finding in Fibromuscular Dysplasia on angiography?", a: "\"String of beads\" appearance of the renal artery." },
            { q: "Why are ACE inhibitors contraindicated in bilateral Renal Artery Stenosis?", a: "They can cause acute renal failure by reducing efferent arteriolar tone/filtration pressure. Section 17: Rare Endocrine Tumors & Syndromes" },
            { q: "Clinical presentation of Insulinoma?", a: "Whipple’s Triad: Symptoms of hypoglycemia, low blood glucose, and relief of symptoms with glucose." },
            { q: "C-peptide levels in Insulinoma vs. Exogenous Insulin use?", a: "Elevated in Insulinoma; Low/Suppressed in Exogenous Insulin use." },
            { q: "Diagnosis of Somatostatinoma?", a: "Triad of Diabetes, Cholelithiasis (gallstones), and Steatorrhea." },
            { q: "Primary symptom of a Gastrinoma (Zollinger-Ellison Syndrome)?", a: "Multiple, refractory, or distal peptic ulcers and chronic diarrhea." },
            { q: "Best initial test for Gastrinoma?", a: "Fasting serum gastrin level (>1000 pg/mL is diagnostic)." },
            { q: "Secretin Stimulation Test result in Gastrinoma?", a: "Paradoxical increase in serum gastrin levels. Section 18: Pediatric & Pubertal Transitions (Internal Medicine Prep)" },
            { q: "Definition of Delayed Puberty in boys?", a: "Absence of testicular enlargement (volume < 4mL) by age 14." },
            { q: "Definition of Delayed Puberty in girls?", a: "Absence of breast development (Thelarche) by age 13." },
            { q: "Most common cause of Constitutional Delay of Growth and Puberty?", a: "Genetic/Familial (delayed \"bone age\" matches height age rather than chronological age). Section 19: Advanced Electrolytes & Hormone Interactions" },
            { q: "Effect of Hypomagnesemia on Potassium levels?", a: "Refractory Hypokalemia (K+ cannot be corrected until Mg2+ is replaced)." },
            { q: "Effect of Hypomagnesemia on PTH secretion?", a: "Inhibits PTH secretion and causes end-organ resistance to PTH, leading to hypocalcemia." },
            { q: "What is \"Hungry Bone Syndrome\"?", a: "Severe hypocalcemia and hypophosphatemia following parathyroidectomy in patients with high preoperative bone turnover." },
            { q: "Medical management of Hypercalcemia of Malignancy (refractory to fluids)?", a: "IV Bisphosphonates (Zoledronic acid) or Denosumab. Section 20: Rapid-Fire Management \"Next Steps\"" },
            { q: "Next step for a patient with a \"Cold\" nodule on Thyroid Scan?", a: "Fine Needle Aspiration (FNA)." },
            { q: "Next step for a patient with a \"Hot\" nodule on Thyroid Scan?", a: "Evaluate for hyperthyroidism; rarely malignant." },
            { q: "Management of a pregnant patient with Hyperthyroidism?", a: "PTU in 1st trimester; Methimazole in 2nd and 3rd trimesters." },
            { q: "Preferred imaging for localized Pheochromocytoma?", a: "CT or MRI of the abdomen/pelvis." },
            { q: "Imaging used if CT/MRI fails to find a suspected Pheochromocytoma?", a: "MIBG (Metaiodobenzylguanidine) scan." },
            { q: "When to screen for Gestational Diabetes?", a: "Between 24 and 28 weeks of gestation." },
            { q: "Initial treatment for Gestational Diabetes?", a: "Dietary modification and exercise." },
            { q: "Preferred pharmacotherapy for Gestational Diabetes if lifestyle fails?", a: "Insulin (Metformin/Glyburide are second-line in some guidelines)." },
            { q: "Lab finding that distinguishes 21-Hydroxylase deficiency from 11-beta-Hydroxylase deficiency?", a: "11-beta-Hydroxylase deficiency presents with Hypertension (due to 11-deoxycorticosterone)." },
            { q: "Major risk of over-replacing Levothyroxine in the elderly?", a: "Atrial fibrillation and bone mineral density loss. Final Synthesis: Clinical \"Gems\"" },
            { q: "Common cause of falsely low HbA1c?", a: "Conditions with high red blood cell turnover (e.g., Hemolytic Anemia, EPO therapy)." },
            { q: "Common cause of falsely high HbA1c?", a: "Iron deficiency anemia (longer RBC lifespan)." },
            { q: "What is the \"Rule of 1s\" for Addison's crisis?", a: "1 liter of NS every 1 hour, plus 100mg Hydrocortisone." },
            { q: "Primary hormonal deficiency in a patient with Pituitary Stalk Transection?", a: "All pituitary hormones decrease EXCEPT Prolactin (which increases due to loss of dopamine inhibition)." },
            { q: "What is \"Apoplectic\" presentation?", a: "Sudden onset of \"worst headache of life,\" visual field defects, and ophthalmoplegia." },
            { q: "Target HbA1c for most non-pregnant adults with DM2?", a: "< 7.0%." },
            { q: "Primary reason to use Eplerenone over Spironolactone?", a: "Avoidance of anti-androgenic side effects like gynecomastia." },
            { q: "Diagnostic test for Acromegaly after IGF-1 is found elevated?", a: "Glucose suppression test (GH should drop below 1 ng/mL after glucose load). Section 21: Complex Metabolic & Electrolyte Nuances" },
            { q: "What is the \"Hooks Effect\" in Prolactinoma testing?", a: "Extremely high prolactin levels can saturate the lab assay, leading to a falsely low report; requires sample dilution." },
            { q: "Serum Calcium and Phosphorus levels in Vitamin D-Resistant Rickets (X-linked hypophosphatemia)?", a: "Normal Calcium, Low Phosphorus, and Low/Normal Vitamin D ($1,25,OH_2D$)." },
            { q: "Primary hormonal abnormality in Gitelman Syndrome?", a: "Mimics Thiazide diuretic use (Hypokalemia, Metabolic Alkalosis, Hypomagnesemia, and Hypocalciuria)." },
            { q: "Primary hormonal abnormality in Bartter Syndrome?", a: "Mimics Loop diuretic use (Hypokalemia, Metabolic Alkalosis, and Hypercalciuria)." },
            { q: "Definition of \"Schmidt Syndrome\" (APS Type 2)?", a: "Adrenal insufficiency + Autoimmune thyroid disease + Type 1 Diabetes Mellitus. Section 22: Advanced Pharmacology & Interactions" },
            { q: "Effect of Cholestyramine on Levothyroxine absorption?", a: "Decreases absorption; Levothyroxine should be taken 4 hours apart from bile acid sequestrants." },
            { q: "Mechanism of Denosumab?", a: "Monoclonal antibody against RANKL, inhibiting osteoclast maturation." },
            { q: "Mechanism of Cinacalcet?", a: "Calcimimetic that increases the sensitivity of calcium-sensing receptors on the parathyroid gland to suppress PTH." },
            { q: "Why is Pioglitazone avoided in patients with a history of bladder cancer?", a: "Potential increased risk of bladder malignancy." },
            { q: "Major side effect of Mitotane?", a: "Adrenolytic effect used to treat adrenal cortex carcinoma; causes severe GI distress and CNS depression. Section 23: Rare Syndromes & Pathophysiology" },
            { q: "Clinical presentation of Klinefelter Syndrome at puberty?", a: "Gynecomastia, sparse body hair, and \"firm\" small testes (testicular dysgenesis)." },
            { q: "Hormonal profile of Turner Syndrome (45, X)?", a: "Primary ovarian failure leading to high FSH and LH (Hypergonadotropic Hypogonadism)." },
            { q: "Most common cause of \"Precocious Puberty\" in boys?", a: "CNS tumors (e.g., hypothalamic hamartoma)." },
            { q: "Most common cause of \"Precocious Puberty\" in girls?", a: "Idiopathic (early activation of the HPO axis)." },
            { q: "What is \"Liddle Syndrome\"?", a: "Genetic mutation causing overactive ENaC channels; presents as hypertension, hypokalemia, and suppressed renin/aldosterone. Section 24: Critical \"Next Best Step\" Scenarios" },
            { q: "Next step in a patient with suspected Pheochromocytoma and a family history of Medullary Thyroid Cancer?", a: "Genetic testing for RET proto-oncogene (MEN 2)." },
            { q: "Next step for a patient with symptomatic Hypercalcemia and a suppressed PTH?", a: "Measure PTHrP, 1,25-dihydroxyvitamin D, and SPEP (screen for malignancy/sarcoid)." },
            { q: "Next step for a patient with new-onset Diabetes and high Ferritin levels?", a: "Genetic testing for HFE gene (Hereditary Hemochromatosis/Bronze Diabetes)." },
            { q: "Management of a patient with an LDL > 190 mg/dL?", a: "Immediate initiation of High-intensity Statin therapy regardless of 10-year risk score." },
            { q: "Preferred treatment for a pregnant patient with Prolactinoma?", a: "Discontinue Dopamine agonists; monitor for visual field changes. Section 25: The \"Ridiculously Simple\" Review" },
            { q: "Classic \"Stone, Moans, Groans, and Psychic Overtones\" refers to?", a: "Clinical symptoms of Hypercalcemia." },
            { q: "Mnemonic for the causes of a \"High Anion Gap\" in Endocrinology?", a: "MUDPILES (specifically \"D\" for Diabetic Ketoacidosis)." },
            { q: "Why does Primary Hypothyroidism sometimes cause Hyperprolactinemia?", a: "High TRH acts as a weak prolactin-releasing factor." },
            { q: "Characteristic of \"Watery Diarrhea\" in VIPoma?", a: "Persists even during fasting (secretory diarrhea)." },
            { q: "What is \"Ertl’s sign\"?", a: "A rare physical sign (thyroid bruits) sometimes heard in Graves disease. Section 26: Diagnostic Thresholds Recap" },
            { q: "Minimum diameter for a thyroid nodule to warrant FNA if it has \"high-risk\" ultrasound features?", a: "$\\ge 1$ cm." },
            { q: "Fasting glucose level defining \"Impaired Fasting Glucose\"?", a: "100 mg/dL to 125 mg/dL." },
            { q: "Random blood glucose level + symptoms required for DM diagnosis?", a: "$\\ge 200$ mg/dL." },
            { q: "Normal range for 24-hour urinary free cortisol?", a: "< 90 mcg/day (varies slightly by lab, but high-yield for \"normal\" cutoffs)." },
            { q: "Urine osmolality in a patient with Primary Polydipsia?", a: "Low (< 100 mOsm/kg), as the kidneys are maximally diluting urine to excrete water. Section 27: Hormone Resistance & Genetic Variants" },
            { q: "Cause of Pseudohypoparathyroidism Type 1a?", a: "Defect in the Gs-protein alpha subunit (maternal inheritance)." },
            { q: "Phenotype of Albright Hereditary Osteodystrophy?", a: "Short stature, round face, short 4th and 5th metacarpals, and subcutaneous calcifications." },
            { q: "Lab profile of Vitamin D-dependent Rickets Type II?", a: "High 1,25-dihydroxyvitamin D levels due to vitamin D receptor resistance." },
            { q: "Clinical sign of Severe Insulin Resistance (Type A)?", a: "Severe Acanthosis Nigricans and virilization in young women." },
            { q: "Difference between MODY (Maturity-Onset Diabetes of the Young) and Type 2 DM?", a: "MODY is autosomal dominant, occurs in non-obese young patients, and is due to a single gene defect in beta-cell function. Section 28: Paraneoplastic & Ectopic Endocrine Syndromes" },
            { q: "Most common cause of Ectopic ACTH production?", a: "Small Cell Lung Cancer." },
            { q: "Paraneoplastic cause of Hypercalcemia in Squamous Cell Lung Cancer?", a: "PTH-related protein (PTHrP) production." },
            { q: "Endocrine cause of Erythrocytosis (high Hgb/Hct)?", a: "Pheochromocytoma or Cushing’s Syndrome (due to EPO-like effects or cortisol's marrow stimulation)." },
            { q: "Syndrome associated with Primary Adrenal Lymphoma?", a: "Bilateral adrenal enlargement and primary adrenal insufficiency. Section 29: Thyroid & Metabolic Nuances" },
            { q: "Result of a Perchlorate Discharge Test?", a: "Identifies defects in thyroid iodine organification." },
            { q: "Definition of \"Pemberton’s Sign\"?", a: "Facial flushing and neck vein distension when raising arms, indicating a large substernal goiter." },
            { q: "Serum marker that is elevated in Thyroid Lymphoma?", a: "Anti-TPO antibodies (often arises in the background of Hashimoto's)." },
            { q: "Preferred management for a \"toxic\" (hyperfunctioning) thyroid nodule?", a: "Radioactive Iodine Ablation or Surgery (Methimazole is usually bridge therapy). Section 30: Advanced Lipidology & Metabolism" },
            { q: "Characteristic finding in Type III Dysbetalipoproteinemia?", a: "Palmar xanthomas and elevations in IDL (Intermediate-Density Lipoprotein)." },
            { q: "Genetic defect in Type III Dysbetalipoproteinemia?", a: "ApoE-2 homozygosity (results in decreased clearance of chylomicron remnants)." },
            { q: "Effect of high-dose Glucocorticoids on Calcium metabolism?", a: "Decreases intestinal calcium absorption and increases renal calcium excretion (leads to osteoporosis)." },
            { q: "Primary cause of death in untreated Primary Hyperparathyroidism?", a: "Actually usually unrelated to the PTH; however, severe \"Hypercalcemic Crisis\" can lead to cardiac arrest. Section 31: Specific Drug-Induced Endocrine Changes" },
            { q: "Effect of Spironolactone on Testosterone?", a: "Competitively inhibits the androgen receptor and decreases testosterone synthesis (causes gynecomastia)." },
            { q: "Medication that can cause both Hypothyroidism and Hyperthyroidism?", a: "Amiodarone (due to high iodine content)." },
            { q: "Effect of Phenytoin/Rifampin on Vitamin D metabolism?", a: "Induces P450 enzymes, leading to increased catabolism of Vitamin D and potential osteomalacia." },
            { q: "Why is Radioiodine therapy contraindicated in Graves' patients with severe Ophthalmopathy?", a: "It can acutely worsen the eye disease by increasing TSH-receptor antibody titers. Section 32: The \"Last Look\" USMLE Pearls" },
            { q: "Most common cause of Primary Hyperparathyroidism in a patient with MEN 1?", a: "Parathyroid Hyperplasia (multiglandular) rather than a single adenoma." },
            { q: "Diagnostic test for suspected Cushing's in a patient with Renal Failure?", a: "Late-night salivary cortisol (24-hour urine cortisol is unreliable in renal failure)." },
            { q: "Preferred steroid for replacement in Addison’s to mimic natural rhythm?", a: "Hydrocortisone (divided doses, 2/3 in morning, 1/3 in afternoon)." },
            { q: "Requirement for adding Fludrocortisone in Adrenal Insufficiency?", a: "Only needed in Primary Adrenal Insufficiency (to replace Mineralocorticoids)." },
            { q: "Clinical presentation of \"Apathetic Hyperthyroidism\"?", a: "Depression, lethargy, and weight loss in elderly patients with thyrotoxicosis (missing the usual \"hyper\" symptoms)." },
            { q: "Definition of \"Wolff-Chaikoff Effect\"?", a: "Reduction in thyroid hormone levels caused by the ingestion of a large amount of iodine." },
            { q: "Definition of \"Jod-Basedow Phenomenon\"?", a: "Iodine-induced hyperthyroidism in a patient with a pre-existing multinodular goiter. Section 33: Enzymatic Deficiencies (CAH Variations)" },
            { q: "Characteristic finding in 17-alpha-hydroxylase deficiency?", a: "Hypertension and Hypokalemia with female phenotype (or undescended testes in males)." },
            { q: "Primary steroid excess in 11-beta-hydroxylase deficiency?", a: "11-deoxycorticosterone (leads to hypertension)." },
            { q: "Distinguishing feature between 21-hydroxylase and 11-beta-hydroxylase deficiency?", a: "21-hydroxylase deficiency causes hypotension; 11-beta-hydroxylase deficiency causes hypertension." },
            { q: "Primary hormone deficiency in 3-beta-hydroxysteroid dehydrogenase deficiency?", a: "Deficiency of all adrenal and gonadal steroid hormones. Section 34: Hypoglycemia & Non-Diabetes Pancreatic Issues" },
            { q: "Diagnosis of Non-insulinoma Pancreatogenous Hypoglycemia Syndrome (NIPHS)?", a: "Postprandial hypoglycemia caused by beta-cell hypertrophy (not a tumor)." },
            { q: "Mechanism of Factitious Hypoglycemia via Sulfonylurea?", a: "Elevated Insulin and elevated C-peptide (mimics Insulinoma; requires urine drug screen)." },
            { q: "What is the \"72-hour fast\" used for?", a: "The gold standard for diagnosing Insulinoma in a controlled inpatient setting." },
            { q: "Treatment for symptomatic hypoglycemia in a patient with an Inoperable Insulinoma?", a: "Diazoxide (inhibits insulin secretion) or Octreotide. Section 35: Metabolic Bone Disease Fine-Tuning" },
            { q: "Effect of Hyperthyroidism on bone metabolism?", a: "Increased bone resorption leading to hypercalciuria and potentially osteoporosis." },
            { q: "Lab finding in Hypophosphatemic Rickets?", a: "Low serum phosphorus with inappropriately low or normal 1,25-dihydroxyvitamin D." },
            { q: "Why is Vitamin D supplementation essential in Hypoparathyroidism?", a: "Lack of PTH prevents the conversion of 25-OH Vitamin D to its active 1,25-OH form." },
            { q: "Radiographic sign of Scurvy (Vitamin C deficiency) in children?", a: "Wimberger’s ring sign (circular calcification around the epiphyseal center). Section 36: Neuroendocrinology & Sleep" },
            { q: "Effect of Sleep Apnea on the endocrine system?", a: "Can cause secondary polycythemia and is highly associated with insulin resistance/Type 2 DM." },
            { q: "Hormone secreted by the Pineal Gland?", a: "Melatonin." },
            { q: "Effect of Craniopharyngioma on growth in children?", a: "Growth failure due to Growth Hormone Deficiency (pituitary compression). Section 37: Endocrine Changes in Systemic Disease" },
            { q: "Endocrine manifestation of Sarcoidosis?", a: "Hypercalcemia (due to 1-alpha-hydroxylase activity in macrophages) and Central Diabetes Insipidus." },
            { q: "Endocrine manifestation of Hemochromatosis?", a: "Central Hypogonadism (iron deposition in pituitary) and \"Bronze\" Diabetes (pancreatic deposition)." },
            { q: "Common endocrine side effect of Checkpoint Inhibitors (Immunotherapy)?", a: "Hypophysitis (inflammation of the pituitary gland). Section 38: Pregnancy & Reproductive Nuances" },
            { q: "Effect of Pregnancy on Total T4 and T3?", a: "Increases due to high Estrogen-induced Thyroid Binding Globulin (TBG)." },
            { q: "Why is hCG able to stimulate the Thyroid gland?", a: "The alpha-subunit of hCG is identical to TSH." },
            { q: "Definition of \"Postpartum Thyroiditis\"?", a: "Autoimmune thyroiditis occurring within 1 year of delivery; usually transient hyperthyroid followed by hypothyroid." },
            { q: "Management of Gestational Hypothyroidism?", a: "Aggressive Levothyroxine replacement; requirements often increase by 30–50% during pregnancy. Section 39: The \"Differential\" Master List" },
            { q: "Differential for a \"Low TSH, Low Free T4\"?", a: "Central (Secondary) Hypothyroidism or Euthyroid Sick Syndrome." },
            { q: "Differential for \"High PTH, High Calcium\"?", a: "Primary Hyperparathyroidism or Familial Hypocalciuric Hypercalcemia (FHH)." },
            { q: "How to distinguish FHH from Primary Hyperparathyroidism?", a: "FHH has a low 24-hour urinary calcium excretion (UCCE < 0.01)." },
            { q: "Differential for \"Low PTH, High Calcium\"?", a: "Malignancy, Vitamin D toxicity, or Sarcoidosis." },
            { q: "Differential for \"High PTH, Low Calcium\"?", a: "Secondary Hyperparathyroidism (usually CKD or Vitamin D deficiency) or Pseudohypoparathyroidism. Section 40: \"Ridiculously Simple\" Clinical Logic" },
            { q: "Why do we treat Hyperkalemia with Insulin and Glucose?", a: "Insulin drives potassium into the cells by stimulating the Na+/K+ ATPase pump." },
            { q: "Mnemonic for MEN 1?", a: "The 3 Ps: Pituitary, Parathyroid, Pancreas." },
            { q: "Mnemonic for MEN 2A?", a: "The 1 M, 2 Ps: Medullary Thyroid, Pheochromocytoma, Parathyroid." },
            { q: "Mnemonic for MEN 2B?", a: "The 2 Ms, 1 P: Medullary Thyroid, Marfanoid Habitus/Mucosal Neuromas, Pheochromocytoma. Section 41: Endocrine Oncology & Genetic Markers" },
            { q: "Screening test for family members of a patient with Medullary Thyroid Cancer?", a: "DNA testing for RET proto-oncogene mutations." },
            { q: "Serum marker used to monitor treatment response in Carcinoid tumors?", a: "Chromogranin A." },
            { q: "Most common site for an extra-adrenal Pheochromocytoma (Paraganglioma)?", a: "The Organ of Zuckerkandl (near the aortic bifurcation)." },
            { q: "Diagnostic test for suspected Cushing's when initial screening is equivocal?", a: "Inferior Petrosal Sinus Sampling (IPSS) to distinguish pituitary vs. ectopic source." },
            { q: "Hormone typically secreted by a \"non-functioning\" pituitary adenoma?", a: "Gonadotropins (specifically the alpha-subunit), though they rarely cause a clinical syndrome. Section 42: Specialized Management Nuances" },
            { q: "When is surgery (Parathyroidectomy) indicated for asymptomatic Primary Hyperparathyroidism?", a: "Age < 50, Calcium > 1.0 mg/dL above normal, T-score < -2.5, or GFR < 60." },
            { q: "Initial medical management for a patient with a known VIPoma?", a: "Octreotide (to control diarrhea) and aggressive fluid/electrolyte replacement." },
            { q: "Preferred treatment for \"Toxic Multinodular Goiter\"?", a: "Radioactive Iodine (131-I) or surgery (methimazole is not a definitive cure)." },
            { q: "First-line management for Central Diabetes Insipidus?", a: "Desmopressin (DDAVP), available in oral, nasal, or parenteral forms." },
            { q: "First-line management for Nephrogenic Diabetes Insipidus?", a: "HCTZ (Thiazide diuretics), NSAIDs, and a low-salt diet. Section 43: Endocrine Emergencies (Detailed)" },
            { q: "Serum Glucose level diagnostic of \"Hypoglycemia\" in a non-diabetic patient?", a: "< 55 mg/dL with associated symptoms." },
            { q: "Calculation for Serum Osmolality?", a: "$2 \\times [Na^+] + \\frac{Glucose}{18} + \\frac{BUN}{2.8}$." },
            { q: "First step in managing a patient with suspected Thyroid Storm?", a: "Propranolol (to control sympathetic overactivity)." },
            { q: "Management of Myxedema Coma?", a: "IV Levothyroxine ($T_4$), IV Liothyronine ($T_3$), and stress-dose Glucocorticoids." },
            { q: "Why must Glucocorticoids be given before $T_4$ in Myxedema Coma?", a: "To prevent precipitating an adrenal crisis if the patient has co-existing adrenal insufficiency. Section 44: Reproductive & Gonadal Nuances" },
            { q: "Definition of \"Primary Amenorrhea\"?", a: "No menses by age 15 with secondary sex characteristics, or by age 13 without them." },
            { q: "Most common cause of Primary Amenorrhea with a present uterus?", a: "Turner Syndrome (45, X)." },
            { q: "Most common cause of Primary Amenorrhea with an absent uterus?", a: "Müllerian Agenesis (Mayer-Rokitansky-Küster-Hauser syndrome)." },
            { q: "Distinguishing feature of Androgen Insensitivity Syndrome (AIS) from Müllerian Agenesis?", a: "AIS has male-level testosterone and absent pubic/axillary hair." },
            { q: "Hormone elevated in 11-beta-hydroxylase deficiency but low in 21-hydroxylase deficiency?", a: "11-deoxycorticosterone (DOC). Section 45: \"Ridiculously Simple\" Electrolyte Memory Hooks" },
            { q: "How does \"Acidosis\" affect ionized Calcium levels?", a: "Increases ionized Calcium (hydrogen ions displace calcium from albumin)." },
            { q: "How does \"Alkalosis\" affect ionized Calcium levels?", a: "Decreases ionized Calcium (leads to increased binding to albumin; can cause tetany)." },
            { q: "Mnemonic for the effects of Glucagon?", a: "GREAT: Glycogenolysis, Releases Insulin, Energy (fatty acid oxidation), Acetone (ketogenesis), Tops gluconeogenesis. Section 46: Chronic Disease & Endocrine Overlap" },
            { q: "Most common endocrine abnormality in patients with Thalassemia Major?", a: "Hypogonadotropic hypogonadism (due to iron overload in the pituitary)." },
            { q: "Endocrine association with Celiac Disease?", a: "Type 1 Diabetes and Autoimmune Thyroiditis (shared genetic predisposition)." },
            { q: "Why do patients with Chronic Kidney Disease (CKD) develop osteomalacia?", a: "Inability to perform 1-alpha-hydroxylation of Vitamin D. ===================================================================== ===================================================================== Section: Internal Medicine" }
          ]
        },
        {
          section: 'Internal Medicine',
          topic: "Hematology/Oncology — Anemias, leukemia, lymphoma, coagulopathies",
          icon: 'activity',
          cards: [
            { q: "Most common cause of microcytic hypochromic anemia worldwide?", a: "Iron deficiency anemia." },
            { q: "Initial and most sensitive lab test for diagnosing iron deficiency anemia?", a: "Serum ferritin level." },
            { q: "Formula for Total Iron Binding Capacity (TIBC) relation to transferrin?", a: "TIBC is a direct measurement of serum transferrin levels." },
            { q: "Pattern of serum iron and TIBC in iron deficiency anemia?", a: "Low serum iron and elevated TIBC." },
            { q: "Pattern of serum iron and TIBC in Anemia of Chronic Disease (ACD)?", a: "Low serum iron and low or normal TIBC." },
            { q: "Key inflammatory cytokine that mediates Anemia of Chronic Disease?", a: "Hepcidin." },
            { q: "Mechanism by which hepcidin causes anemia of chronic disease?", a: "Binds to and degrades ferroportin, trapping iron inside macrophages and enterocytes." },
            { q: "Microcytic anemia presenting with basophilic stippling and ringed sideroblasts?", a: "Lead poisoning." },
            { q: "Enzyme inhibited by lead that leads to accumulation of protoporphyrin?", a: "Ferrochelatase (and ALA dehydratase)." },
            { q: "Definitve diagnostic test to distinguish Thalassemia trait from Iron Deficiency Anemia?", a: "Hemoglobin electrophoresis." },
            { q: "Hemoglobin electrophoresis profile characteristic of Beta-Thalassemia minor?", a: "Elevated $HbA_2$ ($>3.5\\%$) and slightly elevated HbF." },
            { q: "Chromosome location of the alpha-globin genes?", a: "Chromosome 16." },
            { q: "Chromosome location of the beta-globin genes?", a: "Chromosome 11." },
            { q: "Clinical manifestation of a 3-alpha-globin gene deletion alpha-thalassemia?", a: "Hemoglobin H (HbH) disease, causing chronic hemolytic anemia." },
            { q: "Composition of Hemoglobin H (HbH)?", a: "Tetramers of beta-globin ($\\beta_4$)." },
            { q: "Clinical manifestation of a 4-alpha-globin gene deletion alpha-thalassemia?", a: "Hydrops fetalis (Hemoglobin Barts)." },
            { q: "Composition of Hemoglobin Barts?", a: "Tetramers of gamma-globin ($\\gamma_4$)." },
            { q: "Classic skull X-ray finding in Beta-Thalassemia major due to extramedullary hematopoiesis?", a: "\"Crew-cut\" appearance (hair-on-end). Macrocytic and Normocytic Anemias" },
            { q: "Distinctive peripheral blood smear finding that differentiates megaloblastic from non-megaloblastic macrocytic anemia?", a: "Hypersegmented neutrophils ($>5$ lobes)." },
            { q: "Metabolic product that builds up in Vitamin B12 deficiency but NOT in folate deficiency?", a: "Methylmalonic acid (MMA)." },
            { q: "Spinal cord pathology associated with severe Vitamin B12 deficiency?", a: "Subacute Combined Degeneration (SCD) of the spinal cord." },
            { q: "Specific anatomical site of dietary Vitamin B12 absorption?", a: "Terminal ileum." },
            { q: "Glycoprotein required for Vitamin B12 absorption that is deficient in pernicious anemia?", a: "Intrinsic Factor (IF)." },
            { q: "Primary site of dietary folate absorption?", a: "Jejunum." },
            { q: "Classic triad of Paroxysmal Nocturnal Hemoglobinuria (PNH)?", a: "Hemolytic anemia, pancytopenia, and venous thrombosis." },
            { q: "Flow cytometry findings diagnostic for Paroxysmal Nocturnal Hemoglobinuria (PNH)?", a: "Absence of CD55 and CD59 on RBC surfaces." },
            { q: "Mutated gene responsible for Paroxysmal Nocturnal Hemoglobinuria?", a: "PIGA gene (phosphatidylinositol glycan anchor biosynthesis class A)." },
            { q: "Mode of inheritance for Hereditary Spherocytosis?", a: "Autosomal dominant." },
            { q: "Most common molecular/protein defects in Hereditary Spherocytosis?", a: "Defects in ankyrin, spectrin, or band 3." },
            { q: "Screening test of choice for diagnosing Hereditary Spherocytosis?", a: "Eosin-5-maleimide (EMA) binding test or osmotic fragility test." },
            { q: "Definitive treatment to control hemolytic symptoms in Hereditary Spherocytosis?", a: "Splenectomy." },
            { q: "Exact amino acid substitution that causes Sickle Cell Anemia?", a: "Glutamic acid to valine at position 6 of the beta-globin chain." },
            { q: "Most common precipitating factor for a sickle cell vaso-occlusive crisis?", a: "Hypoxia, dehydration, or infection." },
            { q: "Encapsulated organisms that autosplenectomized sickle cell patients are highly susceptible to?", a: "Streptococcus pneumoniae, Neisseria meningitidis, and Haemophilus influenzae." },
            { q: "Maintenance medication used in Sickle Cell Anemia to increase Hemoglobin F production?", a: "Hydroxyurea." },
            { q: "Most common organism causing osteomyelitis in patients with Sickle Cell Disease?", a: "Salmonella species." },
            { q: "Mode of inheritance for Glucose-6-Phosphate Dehydrogenase (G6PD) deficiency?", a: "X-linked recessive." },
            { q: "Two classic structures visualized on a peripheral blood smear during a G6PD crisis?", a: "Heinz bodies and bite cells." },
            { q: "Diagnostic test used to differentiate Autoimmune Hemolytic Anemia (AIHA) from hereditary hemolytic anemias?", a: "Direct Antiglobulin Test (DAT / Direct Coombs)." },
            { q: "Immunoglobulin type associated with Warm Autoimmune Hemolytic Anemia?", a: "IgG." },
            { q: "Immunoglobulin type associated with Cold Agglutinin Disease?", a: "IgM." },
            { q: "Classic physical exam finding that differentiates Aplastic Anemia from leukemia or lymphoma?", a: "Absence of splenomegaly or lymphadenopathy." },
            { q: "Bone marrow biopsy finding diagnostic for Aplastic Anemia?", a: "Hypocellular marrow replaced by fat cells. Acute Leukemias" },
            { q: "Minimum percentage of bone marrow blasts required to diagnose Acute Myeloid Leukemia (AML)?", a: "$20\\%$ or greater." },
            { q: "Pathognomonic crystalline cytoplasmic inclusion bodies found in AML blasts?", a: "Auer rods." },
            { q: "Chromosomal translocation pathognomonic for Acute Promyelocytic Leukemia (APL)?", a: "$\\text{t}(15;17)$." },
            { q: "Fusion gene product created by the $\\text{t}(15;17)$ translocation?", a: "PML-RARA." },
            { q: "Life-threatening coagulopathy frequently precipitated by Acute Promyelocytic Leukemia?", a: "Disseminated Intravascular Coagulation (DIC)." },
            { q: "Targeted medical therapy used to induce differentiation of blasts in APL?", a: "All-trans retinoic acid (ATRA) and arsenic trioxide." },
            { q: "Histochemical stain used to differentiate AML blasts from ALL blasts?", a: "Myeloperoxidase (MPO) stain." },
            { q: "Most common pediatric malignancy?", a: "Acute Lymphoblastic Leukemia (ALL)." },
            { q: "Cell surface markers/enzymes characteristic of lymphoblasts in ALL?", a: "Terminal deoxynucleotidyl transferase (TdT)." },
            { q: "Chromosomal translocation associated with a poor prognosis in adult B-cell ALL?", a: "$\\text{t}(9;22)$ (Philadelphia chromosome)." },
            { q: "Prophylactic therapy required in all ALL treatment regimens to prevent relapse?", a: "Central Nervous System (CNS) prophylaxis (intrathecal chemotherapy). Chronic Myeloproliferative and Lymphoproliferative Disorders" },
            { q: "Chromosomal translocation present in $>95\\%$ of Chronic Myeloid Leukemia (CML) cases?", a: "$\\text{t}(9;22)$." },
            { q: "Constitutively active tyrosine kinase fusion protein produced in CML?", a: "BCR-ABL1." },
            { q: "First-line targeted therapy for Chronic Myeloid Leukemia?", a: "Tyrosine kinase inhibitors (e.g., Imatinib, Dasatinib)." },
            { q: "Leukocyte Alkaline Phosphatase (LAP) score trend in CML vs. Leukemoid Reaction?", a: "Decreased in CML; elevated in Leukemoid Reaction." },
            { q: "Terminal phase of CML characterized by $>20\\%$ blasts in the blood or marrow?", a: "Blast crisis." },
            { q: "Driver mutation found in $>95\\%$ of cases of Polycythemia Vera?", a: "JAK2 V617F mutation." },
            { q: "Classic pruritus symptom unique to Polycythemia Vera?", a: "Aquagenic pruritus (itching after a warm bath/shower)." },
            { q: "Primary therapeutic intervention to maintain hematocrit $<45\\%$ in Polycythemia Vera?", a: "Therapeutic phlebotomy." },
            { q: "Bone marrow biopsy feature hallmark of Primary Myelofibrosis?", a: "Extensive collagen fibrosis and megakaryocyte hyperplasia." },
            { q: "Classic erythrocyte morphology seen on peripheral smear in Primary Myelofibrosis?", a: "Teardrop poikilocytes (dacrocytes)." },
            { q: "Most common leukemia of adults in Western countries?", a: "Chronic Lymphocytic Leukemia (CLL)." },
            { q: "Characteristic artifactual cell configuration seen on peripheral smear in CLL?", a: "Smudge cells." },
            { q: "Immunophenotype co-expression pattern characteristic of CLL B-cells?", a: "CD5 and CD19/CD20/CD23." },
            { q: "Name given to the transformation of CLL into an aggressive Diffuse Large B-cell Lymphoma?", a: "Richter transformation. Lymphomas" },
            { q: "Pathognomonic giant, multinucleated cell type seen in Hodgkin Lymphoma?", a: "Reed-Sternberg (RS) cell." },
            { q: "Immunophenotype markers typically expressed by classic Reed-Sternberg cells?", a: "CD15 and CD30." },
            { q: "Most common histological subtype of Hodgkin Lymphoma?", a: "Nodular sclerosis subtype." },
            { q: "Constitutional symptoms designated as \"B symptoms\" in lymphoma staging?", a: "Fever, drenching night sweats, and unexplained weight loss ($>10\\%$ in 6 months)." },
            { q: "Name of the staging system used for Hodgkin and Non-Hodgkin Lymphomas?", a: "Ann Arbor Staging System (or Lugano classification)." },
            { q: "Most common subtype of Non-Hodgkin Lymphoma worldwide?", a: "Diffuse Large B-Cell Lymphoma (DLBCL)." },
            { q: "Chromosomal translocation and gene associated with Burkitt Lymphoma?", a: "$\\text{t}(8;14)$ causing c-myc overexpression." },
            { q: "Characteristic histological description of a Burkitt Lymphoma biopsy?", a: "\"Starry sky\" appearance." },
            { q: "Infection highly associated with endemic (African) Burkitt Lymphoma?", a: "Epstein-Barr Virus (EBV)." },
            { q: "Chromosomal translocation and gene associated with Follicular Lymphoma?", a: "$\\text{t}(14;18)$ causing BCL-2 overexpression." },
            { q: "Pathophysiological effect of BCL-2 overexpression in Follicular Lymphoma?", a: "Inhibition of apoptosis in B-cells." },
            { q: "Chromosomal translocation and gene associated with Mantle Cell Lymphoma?", a: "$\\text{t}(11;14)$ causing Cyclin D1 overexpression. Plasma Cell Dyscrasias" },
            { q: "Diagnostic criteria that differentiates Multiple Myeloma from MGUS?", a: "Clonal bone marrow plasma cells $\\ge 10\\%$ OR biopsy-proven plasmacytoma, plus CRAB features." },
            { q: "Components of the acronym CRAB used in Multiple Myeloma diagnosis?", a: "HyperCalcemia, Renal insufficiency, Anemia, and Bone lytic lesions." },
            { q: "Monoclonal protein production description in MGUS without end-organ damage?", a: "Serum M-protein $<3\\text{ g/dL}$ and bone marrow plasma cells $<10\\%$." },
            { q: "RBC stacking phenomenon seen on peripheral smear in Multiple Myeloma?", a: "Rouleaux formation." },
            { q: "Free light chains cleared by the kidney and found in the urine of Myeloma patients?", a: "Bence-Jones proteins." },
            { q: "Classic skull X-ray finding in Multiple Myeloma?", a: "\"Punched-out\" lytic bone lesions." },
            { q: "Triad defining Waldenström Macroglobulinemia?", a: "Lymphoplasmacytic lymphoma in marrow, monoclonal IgM spike, and hyperviscosity." },
            { q: "Primary clinical presentation unique to Waldenström Macroglobulinemia due to IgM size?", a: "Hyperviscosity syndrome (visual changes, neurological symptoms, bleeding). Platelet Disorders and Coagulopathies" },
            { q: "Primary target of autoantibodies in Immune Thrombocytopenic Purpura (ITP)?", a: "Platelet GP IIb/IIIa or GP Ib/IX receptors." },
            { q: "First-line medical therapy for an adult with symptomatic ITP and platelets $<30,000$?", a: "Corticosteroids (or IVIG)." },
            { q: "Pentad of clinical findings in Thrombotic Thrombocytopenic Purpura (TTP)?", a: "Thrombocytopenia, microangiopathic hemolytic anemia, fever, renal failure, neurological signs." },
            { q: "Enzyme deficiency or autoantibody target responsible for TTP?", a: "ADAMTS13." },
            { q: "Pathophysiological function of the ADAMTS13 enzyme?", a: "Cleaves ultra-large von Willebrand factor (vWF) multimers." },
            { q: "Contraindicated treatment modality in TTP that can worsen thrombosis?", a: "Platelet transfusion." },
            { q: "Essential first-line treatment for Thrombotic Thrombocytopenic Purpura (TTP)?", a: "Therapeutic plasma exchange (plasmapheresis)." },
            { q: "Triad characterizing Hemolytic Uremic Syndrome (HUS)?", a: "Microangiopathic hemolytic anemia, thrombocytopenia, and acute kidney injury." },
            { q: "Most common infectious trigger for typical HUS in children?", a: "Shiga toxin-producing Escherichia coli (STEC, O157:H7)." },
            { q: "Most common inherited bleeding disorder?", a: "von Willebrand Disease (vWD)." },
            { q: "Dual function of von Willebrand Factor in hemostasis?", a: "Mediates platelet adhesion to subendothelium and stabilizes Factor VIII." },
            { q: "Pattern of coagulation studies (PT/aPTT/Bleeding Time) in von Willebrand Disease?", a: "Normal PT, normal or prolonged aPTT, prolonged bleeding time (or abnormal PFA-100)." },
            { q: "Initial medical treatment used to elevate endogenous vWF and Factor VIII levels?", a: "Desmopressin (DDAVP)." },
            { q: "Coagulation factor deficiency in Hemophilia A?", a: "Factor VIII deficiency." },
            { q: "Coagulation factor deficiency in Hemophilia B?", a: "Factor IX deficiency." },
            { q: "Mode of inheritance for Hemophilia A and B?", a: "X-linked recessive." },
            { q: "Classic clinical bleeding manifestation of severe hemophilia?", a: "Hemarthrosis (bleeding into joints)." },
            { q: "Coagulation profile (PT, aPTT, Platelets) for Hemophilia A or B?", a: "Prolonged aPTT, normal PT, normal platelet count." },
            { q: "Diagnostic mixing study result if prolonged aPTT is due to factor deficiency?", a: "The aPTT corrects to normal when mixed 1:1 with normal plasma." },
            { q: "Diagnostic mixing study result if prolonged aPTT is due to a factor inhibitor?", a: "The aPTT does not correct when mixed 1:1 with normal plasma." },
            { q: "Classic lab profile of Disseminated Intravascular Coagulation (DIC)?", a: "Prolonged PT, prolonged aPTT, decreased platelets, decreased fibrinogen, elevated D-dimer. Hypercoagulable States (Thrombophilia)" },
            { q: "Most common inherited hypercoagulable state among Caucasians?", a: "Factor V Leiden." },
            { q: "Molecular mechanism of Factor V Leiden mutation?", a: "Single nucleotide mutation rendering Factor V resistant to inactivation by Activated Protein C (APC)." },
            { q: "Molecular mechanism of the Prothrombin G20210A mutation?", a: "Mutation in the 3' untranslated region leading to increased prothrombin levels." },
            { q: "Dermatological complication that can occur when initiating Warfarin without heparin bridging?", a: "Warfarin-induced skin necrosis." },
            { q: "Inherited thrombophilias that increase risk for warfarin-induced skin necrosis?", a: "Protein C or Protein S deficiency." },
            { q: "Target of autoantibodies in Antiphospholipid Syndrome (APS)?", a: "Lupus anticoagulant, Anticardiolipin antibodies, or Anti-beta2-glycoprotein I antibodies." },
            { q: "Paradoxical laboratory finding in patients with Antiphospholipid Syndrome?", a: "Prolonged in vitro aPTT that does not correct with mixing studies, despite in vivo thrombosis. Transfusion Medicine & Complications" },
            { q: "Acute transfusion reaction characterized by fever, chills, and flank pain due to ABO incompatibility?", a: "Acute Hemolytic Transfusion Reaction." },
            { q: "Cause of Febrile Non-Hemolytic Transfusion Reaction?", a: "Cytokines accumulated in the stored blood product during storage." },
            { q: "Primary preventive strategy to avoid Febrile Non-Hemolytic Transfusion Reactions?", a: "Leukoreduction of blood products." },
            { q: "Pulmonary transfusion complication presenting with hypoxemia and non-cardiogenic pulmonary edema within 6 hours?", a: "Transfusion-Related Acute Lung Injury (TRALI)." },
            { q: "Pathophysiology driving Transfusion-Related Acute Lung Injury (TRALI)?", a: "Donor antibodies targeting recipient neutrophils in the pulmonary vasculature." },
            { q: "Pulmonary transfusion complication presenting with hypoxemia, hypertension, and jugular venous distention?", a: "Transfusion-Associated Circulatory Overload (TACO)." },
            { q: "Delayed transfusion reaction occurring days to weeks later, presenting with mild jaundice and falling hemoglobin?", a: "状况 Delayed Hemolytic Transfusion Reaction." },
            { q: "Primary mechanism behind Delayed Hemolytic Transfusion Reactions?", a: "Anamnestic antibody response against minor RBC antigens (e.g., Kidd, Kell). Myelodysplastic Syndromes and Bone Marrow Failure" },
            { q: "Pathognomonic bone marrow finding in Myelodysplastic Syndrome (MDS) showing a ring of iron deposits around the nucleus?", a: "Ringed sideroblast." },
            { q: "Distinctive bi-lobed neutrophil morphology (\"sunglasses appearance\") classic for Myelodysplastic Syndrome?", a: "Pelger-Huët anomaly." },
            { q: "Most common cytogenetic deletion associated with a specific, favorable-prognosis subtype of MDS?", a: "5q deletion (5q- syndrome)." },
            { q: "Targeted medical therapy of choice for transfusion-dependent patients with 5q- Myelodysplastic Syndrome?", a: "Lenalidomide." },
            { q: "Inherited bone marrow failure syndrome presenting with aplastic anemia, short stature, absent thumbs, and café-au-lait spots?", a: "Fanconi Anemia." },
            { q: "Definitive diagnostic screening test for Fanconi Anemia?", a: "Chromosome breakage analysis (using diepoxybutane or mitomycin C)." },
            { q: "Inherited pure red cell aplasia presenting in infancy with craniofacial abnormalities and triphalangeal thumbs?", a: "Diamond-Blackfan Anemia. Hemolytic and Hemoglobinopathic Nuances" },
            { q: "Mechanism of RBC destruction in Warm Autoimmune Hemolytic Anemia?", a: "Splenic macrophages pit the IgG-coated membrane, causing extravascular hemolysis and spherocyte formation." },
            { q: "Mechanism of RBC destruction in Cold Agglutinin Disease?", a: "IgM binds RBCs in the cold, fixes complement, and C3b-coated RBCs are destroyed by hepatic Kupffer cells." },
            { q: "Two classic infections that characteristically precipitate Cold Agglutinin Disease?", a: "Mycoplasma pneumoniae and Epstein-Barr Virus (EBV)." },
            { q: "Primary therapeutic choice for severe, symptomatic Warm Autoimmune Hemolytic Anemia?", a: "Corticosteroids (or Rituximab)." },
            { q: "First-line management strategy for Cold Agglutinin Disease that avoids immunosuppressants?", a: "Avoidance of cold temperatures." },
            { q: "Most common presentation of Sickle Cell Trait (heterozygous HbAS) on routine urinalysis?", a: "Microscopic hematuria (due to focal sickling in the renal medulla)." },
            { q: "Phenomenon causing acute, profound drop in hemoglobin in sickle cell patients, associated with a reticulocytopenia?", a: "Aplastic crisis." },
            { q: "Most common viral pathogen responsible for triggering an aplastic crisis in sickle cell or hereditary spherocytosis patients?", a: "Parvovirus B19." },
            { q: "Phenomenon causing an acute drop in hemoglobin in sickle cell patients, associated with splenomegaly and reticulocytosis?", a: "Splenic sequestration crisis." },
            { q: "Leading cause of death in adult patients with Sickle Cell Disease?", a: "Acute Chest Syndrome." },
            { q: "Diagnostic criteria for Acute Chest Syndrome in a sickle cell patient?", a: "New pulmonary infiltrate on chest X-ray plus fever, chest pain, tachypnea, or hypoxia. Advanced Leukemia and Lymphoma Concepts" },
            { q: "Genetic mutation found in nearly all cases of Hairy Cell Leukemia?", a: "BRAF V600E mutation." },
            { q: "Key histochemical stain historically used to identify Hairy Cell Leukemia cells?", a: "Tartrate-Resistant Acid Phosphatase (TRAP) stain." },
            { q: "Preferred highly effective first-line purine analog therapy for Hairy Cell Leukemia?", a: "Cladribine (2-chlorodeoxyadenosine)." },
            { q: "Classic physical exam finding characteristically ABSENT in Hairy Cell Leukemia despite massive splenomegaly?", a: "Lymphadenopathy." },
            { q: "The single most important prognostic factor for patients diagnosed with Hodgkin Lymphoma?", a: "Stage of the disease at the time of diagnosis." },
            { q: "Unique physical symptom where lymph nodes become painful specifically after drinking alcohol?", a: "Alcohol-induced nodal pain in Hodgkin Lymphoma." },
            { q: "Lymphoma subtype characterized by a \"waxy,\" painless lymphadenopathy that fluctuates in size over years?", a: "Follicular Lymphoma." },
            { q: "Histological finding that differentiates Follicular Lymphoma from benign reactive follicular hyperplasia?", a: "Monoclonal B-cell population and absence of tingible body macrophages in the follicles." },
            { q: "Aggressive T-cell lymphoma presenting with lytic bone lesions, hypercalcemia, skin lesions, and \"cloverleaf\" T-cells?", a: "Adult T-Cell Leukemia/Lymphoma (ATLL)." },
            { q: "Causative viral pathogen direct linked to Adult T-Cell Leukemia/Lymphoma?", a: "Human T-Cell Leukemia Virus type 1 (HTLV-1)." },
            { q: "Cutaneous T-cell lymphoma characterized by cerebriform nuclei and skin plaques?", a: "Mycosis Fungoides." },
            { q: "Term used when Mycosis Fungoides leukemizes, presenting with erythroderma and malignant T-cells in the peripheral blood?", a: "Sézary Syndrome. Coagulation, Anticoagulation, and Platelet Pathology" },
            { q: "Laboratory marker used to monitor the therapeutic efficacy and dosing of Unfractionated Heparin?", a: "Activated Partial Thromboplastin Time (aPTT)." },
            { q: "Laboratory marker used to monitor the therapeutic efficacy and dosing of Warfarin?", a: "Prothrombin Time (PT) / International Normalized Ratio (INR)." },
            { q: "Antidote used for the immediate reversal of Unfractionated Heparin?", a: "Protamine sulfate." },
            { q: "Specific reversal agent for the Direct Oral Anticoagulant (DOAC) Dabigatran?", a: "Idarucizumab." },
            { q: "Specific reversal agent for Factor Xa inhibitors (Rivaroxaban, Apixaban)?", a: "Andexanet alfa." },
            { q: "Pathophysiological mechanism behind Heparin-Induced Thrombocytopenia (HIT)?", a: "IgG antibodies form against the Heparin-Platelet Factor 4 (PF4) complex, activating platelets." },
            { q: "Standard alternative anticoagulant of choice when HIT is confirmed or highly suspected?", a: "Direct thrombin inhibitors (e.g., Argatroban, Bivalirudin)." },
            { q: "Most accurate confirmatory laboratory assay for Heparin-Induced Thrombocytopenia?", a: "Serotonin Release Assay (SRA)." },
            { q: "Inherited condition presenting with prolonged bleeding time, normal platelet count, and giant platelets due to GP Ib-IX-V defect?", a: "Bernard-Soulier Syndrome." },
            { q: "Inherited condition presenting with prolonged bleeding time, normal platelet count, and defective platelet aggregation due to GP IIb/IIIa defect?", a: "Glanzmann Thrombasthenia." },
            { q: "Distinguishing aggregation assay result between Bernard-Soulier and Glanzmann Thrombasthenia?", a: "Ristocetin agglutination fixes Bernard-Soulier but does not correct Glanzmann; normal plasma corrects neither." },
            { q: "Rare, life-threatening manifestation of severe DIC or meningococcemia presenting with bilateral adrenal hemorrhage and shock?", a: "Waterhouse-Friderichsen syndrome. Oncological Emergencies and Support" },
            { q: "Metabolic triad and secondary complication defining Tumor Lysis Syndrome (TLS)?", a: "Hyperuricemia, hyperkalemia, hyperphosphatemia, and hypocalcemia." },
            { q: "Mechanism by which Tumor Lysis Syndrome induces acute kidney injury?", a: "Precipitation of uric acid or calcium phosphate crystals in the renal tubules." },
            { q: "Prophylactic medication used to prevent Tumor Lysis Syndrome by inhibiting xanthine oxidase?", a: "Allopurinol." },
            { q: "Recombinant uric acid oxidase enzyme used to treat established, severe hyperuricemia in TLS?", a: "Rasburicase." },
            { q: "Absolute Neutrophil Count (ANC) threshold used to define severe neutropenia?", a: "$\\text{ANC} < 500/\\mu\\text{L}$." },
            { q: "Empiric monotherapy antibiotic class required immediately in a patient with febrile neutropenia?", a: "Antipseudomonal beta-lactam (e.g., Cefepime, Meropenem, Piperacillin/Tazobactam)." },
            { q: "Immediate medical management for a cancer patient presenting with thoracic back pain, hyperreflexia, and lower extremity weakness?", a: "Intravenous high-dose corticosteroids (followed by emergent MRI for spinal cord compression)." },
            { q: "Pathophysiology behind Leukostasis Syndrome in patients with ultra-high WBC counts ($>100,000/\\mu\\text{L}$)?", a: "Increased blood viscosity and blast plugs causing tissue hypoxia, particularly in the brain and lungs. Iron Overload and Storage Disorders" },
            { q: "Classical triad of Hemochromatosis?", a: "Cirrhosis, diabetes mellitus (\"bronze diabetes\"), and skin hyperpigmentation." },
            { q: "Most common genetic mutation associated with Hereditary Hemochromatosis?", a: "HFE gene mutation (C282Y or H63D)." },
            { q: "Transmembrane protein that is mutated or non-functional in Juvenile Hemochromatosis?", a: "Hemojuvelin or Hepcidin." },
            { q: "Best screening lab evaluation for Hereditary Hemochromatosis?", a: "Transferrin saturation ($>45\\%$) and serum ferritin." },
            { q: "First-line management strategy for symptomatic Hereditary Hemochromatosis?", a: "Therapeutic phlebotomy." },
            { q: "Preferred iron chelation therapy used for secondary iron overload due to chronic transfusions?", a: "Deferasirox (oral) or Deferoxamine (IV/SC)." },
            { q: "Quantitative organ assessment method considered the non-invasive gold standard for tracking tissue iron overload?", a: "T2* MRI of the liver and heart. Porphyrias and Heme Synthesis Defects" },
            { q: "Enzyme deficiency responsible for Acute Intermittent Porphyria (AIP)?", a: "Porphobilinogen (PBG) deaminase." },
            { q: "Classic clinical presentation pentad of Acute Intermittent Porphyria?", a: "Painful abdomen, Polyneuropathy, Psychiatic disturbances, Purple-red urine, and Precipitated by drugs/alcohol." },
            { q: "Two primary compounds that accumulate in the urine during an Acute Intermittent Porphyria crisis?", a: "ALA (aminolevulinic acid) and PBG (porphobilinogen)." },
            { q: "Primary therapeutic intervention to abort an acute attack of AIP by suppressing ALA synthase?", a: "Intravenous Hemin (or high-dose glucose)." },
            { q: "Most common porphyria overall, presenting with blistering skin lesions on sun-exposed areas?", a: "Porphyria Cutanea Tarda (PCT)." },
            { q: "Enzyme deficiency responsible for Porphyria Cutanea Tarda?", a: "Uroporphyrinogen decarboxylase (UROD)." },
            { q: "Common chronic infectious disease strongly associated with the development of Porphyria Cutanea Tarda?", a: "Hepatitis C virus (HCV). Myeloproliferative and Eosinophilic Variations" },
            { q: "Mutation strongly associated with Essential Thrombocythemia (ET) and Primary Myelofibrosis outside of JAK2?", a: "CALR (calreticulin) or MPL mutation." },
            { q: "Platelet count threshold typically used to prompt evaluation for Essential Thrombocythemia?", a: "Platelets $>450,000/\\mu\\text{L}$ sustained on repeat checks." },
            { q: "Phenomenon where severe thrombocytosis causes bleeding due to functional loss of high-molecular-weight vWF multimers?", a: "Acquired von Willebrand Syndrome." },
            { q: "First-line cytoreductive therapy of choice for high-risk Essential Thrombocythemia?", a: "Hydroxyurea." },
            { q: "Variant of Chronic Myelomonocytic Leukemia (CMML) requires what absolute monocyte count for diagnosis?", a: "Persistent peripheral blood monocytosis $\\ge 1,000/\\mu\\text{L}$." },
            { q: "Distinctive genetic fusion product seen in Chronic Eosinophilic Leukemia that responds exceptionally well to Imatinib?", a: "FIP1L1-PDGFRA fusion gene. Rare and Complex Lymphoma Entities" },
            { q: "Rare, highly aggressive Non-Hodgkin B-cell lymphoma with features intermediate between DLBCL and Burkitt lymphoma?", a: "High-grade B-cell lymphoma (often called \"double-hit\" or \"triple-hit\" lymphoma if MYC, BCL2, and/or BCL6 are rearranged)." },
            { q: "T-cell lymphoma subtype characterized by a \"necklace\" of malignant T-cells around subcutaneous fat cells, mimicking panniculitis?", a: "Subcutaneous Panniculitis-like T-cell Lymphoma." },
            { q: "Extranodal lymphoma subtype arising in chronic inflammatory states, strongly associated with H. pylori infection in the stomach?", a: "MALT lymphoma (Mucosa-Associated Lymphoid Tissue lymphoma)." },
            { q: "Chromosomal translocation frequently driving MALT lymphoma that predicts resistance to H. pylori eradication therapy?", a: "$\\text{t}(11;18)$." },
            { q: "Aggressive extranodal T/NK-cell lymphoma presenting as a destructive midline facial mass, strongly associated with EBV?", a: "Extranodal NK/T-cell lymphoma, nasal type." },
            { q: "Rare B-cell lymphoproliferative disorder characteristically localized to the pleural or pericardial cavities in HIV/AIDS patients, driven by HHV-8?", a: "Primary Effusion Lymphoma. Complex Coagulation and Thrombophilia Concepts" },
            { q: "Autosomal dominant condition presenting with telangiectasias, recurrent epistaxis, and arteriovenous malformations (AVMs)?", a: "Hereditary Hemorrhagic Telangiectasia (Osler-Weber-Rendu syndrome)." },
            { q: "Primary autoantibody target responsible for Heparin-Induced Thrombocytopenia type II?", a: "Platelet Factor 4 (PF4)-heparin complexes." },
            { q: "Name of the clinical pre-test probability scoring system used to risk-stratify suspected HIT?", a: "The 4Ts Score." },
            { q: "Mechanistic explanation for why an isolated Factor XII deficiency prolongs aPTT but does NOT cause clinical bleeding?", a: "Factor XII is crucial for in vitro contact activation but redundant for in vivo coagulation initiation." },
            { q: "Rare bleeding disorder characterized by normal PT, aPTT, and platelet counts, but presents with delayed wound healing and severe bleeding?", a: "Factor XIII deficiency." },
            { q: "Definitive laboratory test used to screen for a suspected Factor XIII deficiency?", a: "5M urea clot solubility test (or quantitative Factor XIII activity assay)." },
            { q: "Mechanism by which Dysfibrinogenemia can present simultaneously with both bleeding and thrombotic risks?", a: "Structural fibrinogen mutations alter either its cleavage by thrombin or its ability to bind tissue plasminogen activator (tPA). Transfusion Reactions and Complications (Extended)" },
            { q: "Expected incremental rise in hemoglobin and platelet count after 1 unit of packed RBCs and 1 unit of apheresis platelets respectively?", a: "Hemoglobin rises by $1\\text{ g/dL}$; platelet count rises by $30,000\\text{ to }50,000/\\mu\\text{L}$." },
            { q: "Transfusion reaction presenting with severe rigors and hyperthermia, caused by bacterial endotoxins contaminating the blood product?", a: "Septic transfusion reaction (most common with platelet transfusions due to room temperature storage)." },
            { q: "Fatal complication of transfusion occurring in immunocompromised hosts where donor T-cells attack recipient tissues?", a: "Transfusion-Associated Graft-Versus-Host Disease (TA-GVHD)." },
            { q: "Standard processing technique used to completely eliminate the risk of Transfusion-Associated Graft-Versus-Host Disease?", a: "Gamma or X-ray irradiation of cellular blood products." },
            { q: "Phenomenon where severe, life-threatening thrombocytopenia develops 5-10 days after a transfusion due to alloantibodies against human platelet antigen-1a (HPA-1a)?", a: "Post-Transfusion Purpura (PTP)." },
            { q: "Preferred initial management strategy for Post-Transfusion Purpura?", a: "Intravenous Immunoglobulin (IVIG) or plasmapheresis. Amyloidosis and Heavy Chain Diseases" },
            { q: "Protein precursor mismatch driving Primary Systemic Amyloidosis (AL)?", a: "Monoclonal immunoglobulin light chains (typically lambda)." },
            { q: "Characteristic organ biopsy finding when examining systemic amyloid deposits under polarized light microscopy?", a: "Apple-green birefringence under Congo red staining." },
            { q: "Classic soft-tissue finding in AL amyloidosis characterized by macroglossia and purple periorbital discoloration?", a: "\"Racoon eyes\" (periorbital purpura)." },
            { q: "Most common protein precursor responsible for Secondary Systemic Amyloidosis (AA)?", a: "Serum Amyloid A (an acute-phase reactant driven by chronic inflammation)." },
            { q: "Plasma cell dyscrasia characterized by the production of truncated heavy chains without attached light chains?", a: "Heavy Chain Disease (e.g., Franklin disease, Seligmann disease)." },
            { q: "Rare systemic disorder presenting with Polyneuropathy, Organomegaly, Endocrinology abnormalities, Monoclonal plasma cell proliferative disorder, and Skin changes?", a: "POEMS syndrome. Coagulation Cascade and Lab Interpretations" },
            { q: "Coagulation factor that initiates the extrinsic pathway of coagulation following vascular injury?", a: "Tissue Factor (Factor III)." },
            { q: "Coagulation factors unique to the intrinsic pathway?", a: "Factors XII, XI, IX, and VIII." },
            { q: "Coagulation factors comprising the common pathway?", a: "Factors X, V, II (prothrombin), and I (fibrinogen)." },
            { q: "Only coagulation factor that does not circulate as a serine protease zymogen?", a: "Factor V (and Factor VIII; they act as cofactors)." },
            { q: "Coagulation factor responsible for cross-linking fibrin polymers to stabilize a clot?", a: "Factor XIII (Fibrin-stabilizing factor)." },
            { q: "Expected coagulation profile (PT and aPTT) in a patient with a severe Vitamin K deficiency?", a: "Both PT and aPTT are prolonged (PT typically prolongs first due to short half-life of Factor VII)." },
            { q: "Exact mechanism by which Warfarin acts as an anticoagulant?", a: "Inhibits Vitamin K Epoxide Reductase Complex 1 (VKORC1), preventing gamma-carboxylation of Factors II, VII, IX, X, and Proteins C/S." },
            { q: "Mechanistic reason why Unfractionated Heparin prolongs aPTT more significantly than Low-Molecular-Weight Heparin (LMWH)?", a: "Unfractionated heparin binds antithrombin to inhibit both Thrombin and Factor Xa, whereas LMWH principally inhibits Factor Xa." },
            { q: "Laboratory assay used to accurately monitor therapeutic levels of Low-Molecular-Weight Heparin when clinically indicated?", a: "Anti-Factor Xa assay. Myelodysplastic/Myeloproliferative Overlap and Rare Anemias" },
            { q: "Distinctive bone marrow feature that distinguishes Chronic Myelomonocytic Leukemia (CMML) from CML?", a: "Absence of the BCR-ABL1 fusion gene and presence of persistent peripheral monocytosis." },
            { q: "Diagnostic genetic deletion confirming Secondary Acute Myeloid Leukemia arising from prior MDS or chemotherapy?", a: "Deletion of chromosome 5 (del(5q)) or chromosome 7 (del(7q))." },
            { q: "Rare congenital normocytic anemia presenting with triphalangeal thumbs and a striking increased risk of osteosarcoma and AML?", a: "Diamond-Blackfan Anemia." },
            { q: "Autosomal recessive disorder presenting with progressive pancytopenia, café-au-lait spots, microcephaly, and a high risk of squamous cell carcinomas?", a: "Fanconi Anemia." },
            { q: "Mechanistic cause of anemia in Lead Poisoning outside of enzyme inhibition?", a: "Inhibition of pyrimidine 5'-nucleotidase, causing ribosomal RNA degradation failure and subsequent basophilic stippling." },
            { q: "Classic clinical triad of Plummer-Vinson Syndrome?", a: "Iron deficiency anemia, esophageal webs, and dysphagia. Lymphoma and Leukemia Molecular Pathogenesis" },
            { q: "Immunophenotypic cell surface marker used to definitively identify classic Hodgkin Lymphoma Reed-Sternberg cells via immunohistochemistry?", a: "CD15 and CD30 positive (CD45 negative)." },
            { q: "Histological variant of Hodgkin Lymphoma characterized by \"popcorn cells\" that express B-cell markers like CD20?", a: "Nodular Lymphocyte Predominant Hodgkin Lymphoma (NLPHL)." },
            { q: "Chromosomal translocation and gene rearrangement characteristic of Anaplastic Large Cell Lymphoma (ALCL)?", a: "$\\text{t}(2;5)$ resulting in the NPM-ALK fusion gene." },
            { q: "Non-Hodgkin Lymphoma subtype characterized by primary involvement of the skin, presenting as generalized erythroderma, lymphadenopathy, and atypical T-cells with cerebriform nuclei?", a: "Sézary Syndrome (leukemic phase of Mycosis Fungoides)." },
            { q: "Unique oncogenic mechanism driving Diffuse Large B-Cell Lymphoma (DLBCL) in up to $30\\%$ of cases?", a: "BCL6 gene rearrangements or dysregulation on chromosome 3q27." },
            { q: "Primary viral driver implicated in Primary Central Nervous System Lymphoma in immunocompromised/HIV patients?", a: "Epstein-Barr Virus (EBV)." },
            { q: "Translocation associated with a subset of Acute Myeloid Leukemias that carries a highly favorable prognosis?", a: "$\\text{t}(8;21)$ involving the RUNX1-RUNX1T1 fusion." },
            { q: "Cytogenetic abnormality in AML involving chromosome 16 that correlates with abnormal eosinophils in the bone marrow and a favorable prognosis?", a: "$\\text{inv}(16)$ or $\\text{t}(16;16)$. Non-Malignant Hematological Emergencies" },
            { q: "First line medical therapy for acute, severe bleeding in a patient taking direct oral Factor Xa inhibitors?", a: "Andexanet alfa." },
            { q: "Immediate management step for a sickle cell patient presenting with sudden-onset severe dyspnea, new chest infiltrate, and hypoxia?", a: "Emergent empiric antibiotics, supplemental oxygen, IV fluids, and consideration for exchange transfusion (Acute Chest Syndrome)." },
            { q: "Pathophysiological driver of priapism in male pediatric patients with Sickle Cell Disease?", a: "Vaso-occlusion and stasis of sickled erythrocytes within the corpora cavernosa." },
            { q: "Vital intervention required immediately for a neutropenic cancer patient presenting with a single oral temperature reading of $\\ge 38.3^\\circ\\text{C}$ ($101^\\circ\\text{F}$)?", a: "Draw blood cultures and immediately administer empiric broad-spectrum antipseudomonal IV antibiotics (e.g., Cefepime)." },
            { q: "Major electrolyte abnormality that can precipitate life-threatening cardiac arrhythmias during massive blood transfusion protocols?", a: "Hypocalcemia (caused by citrate preservative binding free calcium). Histiocytic and Dendritic Cell Disorders" },
            { q: "Clonal proliferation of dendritic antigen-presenting cells presenting with lytic bone lesions, skin rashes, and diabetes insipidus?", a: "Langerhans Cell Histiocytosis (LCH)." },
            { q: "Pathognomonic electron microscopy finding in Langerhans Cell Histiocytosis?", a: "Birbeck granules (tennis-racket shaped structures)." },
            { q: "Key immunohistochemical markers used to confirm Langerhans Cell Histiocytosis?", a: "CD1a and Langerin (CD207) positivity." },
            { q: "Highly aggressive, life-threatening syndrome characterized by cytopenias, hepatosplenomegaly, and hyperferritinemia due to overactivation of macrophages?", a: "Hemophagocytic Lymphohistiocytosis (HLH)." },
            { q: "Diagnostic ferritin threshold typically used as a major criterion for Hemophagocytic Lymphohistiocytosis?", a: "Serum ferritin $\\ge 500\\text{ }\\mu\\text{g/L}$ (often $>3,000\\text{ }\\mu\\text{g/L}$ is highly suggestive)." },
            { q: "Common genetic mutations identified in adult presentations of Langerhans Cell Histiocytosis?", a: "BRAF V600E mutation (found in roughly $50\\%$ of cases). Advanced Hypercoagulable and Thrombotic Concepts" },
            { q: "Autosomal dominant condition presenting with recurrent venous thromboembolisms where standard therapeutic doses of Heparin fail to prolong the aPTT?", a: "Antithrombin (ATIII) deficiency." },
            { q: "Specific clinical scenario where an Antiphospholipid Syndrome patient requires lifelong therapeutic anticoagulation with Warfarin over DOACs?", a: "Triple-positive Antiphospholipid Syndrome (positive for Lupus Anticoagulant, Anticardiolipin, and Anti-beta2-glycoprotein I)." },
            { q: "Rare condition presenting with a combination of arterial/venous thromboses, livedo reticularis, and recurrent ischemic strokes in young adults?", a: "Sneddon Syndrome." },
            { q: "Mechanistic cause of neonatal purpura fulminans immediately after birth?", a: "Homozygous Protein C or Protein S deficiency." },
            { q: "Coagulation test modification required to confirm the presence of a Lupus Anticoagulant?", a: "Demonstration of phospholipid-dependence using the Dilute Russell's Viper Venom Time (dRVVT) or high-phospholipid neutralization." },
            { q: "Most common site of visceral vein thrombosis in patients diagnosed with Paroxysmal Nocturnal Hemoglobinuria (PNH)?", a: "Hepatic vein thrombosis (Budd-Chiari syndrome). Bone Marrow Microenvironment and Specialized Anemias" },
            { q: "Key stromal-derived cytokine essential for the survival, proliferation, and differentiation of early hematopoietic stem cells?", a: "Stem Cell Factor (SCF) (or c-Kit ligand)." },
            { q: "Specialized macrophage-containing structures in the bone marrow where erythroblast maturation occurs?", a: "Erythroblastic islands." },
            { q: "Autosomal dominant pure red cell aplasia linked to ribosomal protein gene mutations ($RPS19$)?", a: "Diamond-Blackfan Anemia." },
            { q: "Distinctive physical exam sign on the hands that differentiates Diamond-Blackfan Anemia from Fanconi Anemia?", a: "Triphalangeal thumbs in Diamond-Blackfan; absent or hypoplastic thumbs/radii in Fanconi." },
            { q: "Acquired pure red cell aplasia (PRCA) is classically associated with what encapsulated mediastinal tumor?", a: "Thymoma." },
            { q: "Rare, inherited normocytic anemia characterized by multinucleated erythroblasts and a positive acidified serum lysis (Ham) test?", a: "Congenital Dyserythropoietic Anemia (CDA). Hemoglobinopathies: Structural Variants and Genetics" },
            { q: "Structural hemoglobin variant that causes Hemoglobin C disease?", a: "Lysine substitution for glutamic acid at position 6 of the beta-globin chain." },
            { q: "Classic morphology of erythrocytes on a peripheral blood smear from a patient with Hemoglobin CC disease?", a: "HbC crystals (rod-shaped/rectangular structures) and target cells." },
            { q: "Structural variant where glutamic acid is replaced by lysine at position 26 of the beta-globin chain, common in Southeast Asia?", a: "Hemoglobin E ($HbE$)." },
            { q: "Underlying genetic mechanism responsible for the vast majority of Alpha-Thalassemia cases?", a: "Gene deletions (large structural deletions via unequal crossing over)." },
            { q: "Underlying genetic mechanism responsible for the vast majority of Beta-Thalassemia cases?", a: "Point mutations (splicing, promoter, or nonsense mutations)." },
            { q: "Hemoglobin variant formed by two alpha chains and two delta chains ($\\alpha_2\\delta_2$)?", a: "Hemoglobin $A_2$ ($HbA_2$)." },
            { q: "Definitive quantitative assay used to precisely monitor Hemoglobin S levels in sickle cell patients undergoing exchange transfusion?", a: "High-Performance Liquid Chromatography (HPLC). Immune and Non-Immune Hemolytic Pathophysiology" },
            { q: "Specific complement regulatory protein missing in PNH that normally degrades C3 convertases?", a: "CD55 (Decay-accelerating factor / DAF)." },
            { q: "Specific complement regulatory protein missing in PNH that normally prevents assembly of the Membrane Attack Complex (MAC)?", a: "CD59 (Membrane inhibitor of reactive lysis / MIRL)." },
            { q: "Humanized monoclonal antibody targeting complement component C5 used to treat Paroxysmal Nocturnal Hemoglobinuria?", a: "Eculizumab (or Ravulizumab)." },
            { q: "Classic mechanism of cell destruction in Microangiopathic Hemolytic Anemia (MAHA)?", a: "Mechanical shearing of erythrocytes as they pass through fibrin-platelet meshworks in microvessels." },
            { q: "Physical footprint of intravascular hemolysis measured via a decrease in which specific serum transport protein?", a: "Haptoglobin." },
            { q: "Oxidation product of hemoglobin breakdown that accumulates in the urine during sustained, severe intravascular hemolysis?", a: "Hemosiderin (Hemosiderinuria)." },
            { q: "Protozoal intraerythrocytic infection that mimics G6PD deficiency by inducing hemolytic anemia and forming \"Maltese cross\" tetrads?", a: "Babesiosis. Advanced Leukemia Classification and Cytogenetics" },
            { q: "Cell surface markers used to differentiate early T-cell ALL from B-cell ALL via flow cytometry?", a: "T-ALL expresses CD3, CD7, and CD2; B-ALL expresses CD19, CD10, and CD22." },
            { q: "Chromosomal translocation $\\text{t}(12;21)$ involving $ETV6-RUNX1$ confers what type of prognosis in pediatric B-ALL?", a: "Highly favorable prognosis." },
            { q: "Chromosomal translocation $\\text{t}(1;19)$ involving $TCF3-PBX1$ confers what type of prognosis in pediatric B-ALL?", a: "Unfavorable/poor prognosis." },
            { q: "Specific WHO classification cytogenetic rearrangement in AML that involves the $RUNX1-RUNX1T1$ fusion?", a: "$\\text{t}(8;21)$." },
            { q: "Cytogenetic abnormality in AML that results in the $CBFB-MYH11$ fusion protein?", a: "$\\text{inv}(16)$ or $\\text{t}(16;16)$." },
            { q: "The presence of NPM1 or CEBPA mutations in the absence of FLT3-ITD mutations in AML signals what prognosis?", a: "Favorable prognosis (in cytogenetically normal AML)." },
            { q: "Cell-of-origin classification marker that identifies the chronic phase of CML from leukemoid reactions?", a: "Low or zero Leukocyte Alkaline Phosphatase (LAP) score in CML." },
            { q: "Splenic pathology classic for Chronic Myeloid Leukemia?", a: "Massive splenomegaly due to extensive extramedullary hematopoiesis in the red pulp. Non-Hodgkin Lymphoma and T-Cell Malignancies" },
            { q: "Cell of origin for Follicular Lymphoma?", a: "Germinal center B-cells." },
            { q: "Cell surface marker universally absent on normal B-cells but characteristically aberrant/positive on Chronic Lymphocytic Leukemia (CLL) B-cells?", a: "CD5." },
            { q: "Pathognomonic tissue biopsy layout defining Mantle Cell Lymphoma?", a: "Monomorphic expansion of small-to-medium lymphocytes surrounding germinal centers in the mantle zone." },
            { q: "Unique biological mechanism behind the growth of Gastric MALT lymphoma?", a: "$H.\\text{ pylori}$-specific T-cells stimulate the malignant B-cell clone via cytokine signaling." },
            { q: "Chromosomal translocation $\\text{t}(11;18)$ in MALT lymphoma fuses which two genes?", a: "$API2$ and $MALT1$." },
            { q: "Most common clinical presentation of Anaplastic Large Cell Lymphoma (ALCL) in young adults?", a: "Lymphadenopathy with skin/soft tissue involvement and systemic B symptoms." },
            { q: "Hallmark cell morphology describing Anaplastic Large Cell Lymphoma?", a: "Large \"hallmark\" cells with kidney- or horseshoe-shaped nuclei and a prominent perinuclear halo." },
            { q: "Target antigen for the antibody-drug conjugate Brentuximab Vedotin used in Hodgkin Lymphoma and ALCL?", a: "CD30. Complex Hypercoagulability and Endothelial Pathology" },
            { q: "Autoimmune clotting disorder presenting with prolonged aPTT, livedo reticularis, and false-positive VDRL/RPR tests for syphilis?", a: "Antiphospholipid Syndrome (APS)." },
            { q: "Primary mechanism by which anti-beta2-glycoprotein I antibodies promote a prothrombotic state?", a: "Activation of endothelial cells, platelets, and monocytes, upregulating tissue factor expression." },
            { q: "Inherited condition caused by a mutation in the prothrombin gene untranslated region that increases prothrombin mRNA stability?", a: "Prothrombin G20210A mutation." },
            { q: "Most accurate timing to check Protein C or Protein S functional activity levels to evaluate for inherited deficiency?", a: "At least 2 weeks after terminating oral Warfarin therapy and when the patient is free from acute thrombosis." },
            { q: "Rare, life-threatening complication of Unfractionated Heparin infusion presenting with a $>50\\%$ drop in platelets within 5-10 days?", a: "Heparin-Induced Thrombocytopenia (HIT) Type II." },
            { q: "Specific functional diagnostic confirmation test for HIT Type II that measures radioactive isotope emission?", a: "Serotonin Release Assay (SRA). Platelet Function Defects and Vascular Purpuras" },
            { q: "Inherited qualitative platelet disorder due to a deficiency in the Glycoprotein Ib-IX-V complex?", a: "Bernard-Soulier Syndrome." },
            { q: "Inherited qualitative platelet disorder due to a deficiency in the Glycoprotein IIb/IIIa complex?", a: "Glanzmann Thrombasthenia." },
            { q: "Unique laboratory feature that differentiates Bernard-Soulier Syndrome from Glanzmann Thrombasthenia on a peripheral blood smear?", a: "Presence of giant platelets in Bernard-Soulier Syndrome." },
            { q: "Effect of adding normal plasma to a platelet agglutination test using Ristocetin in a patient with Bernard-Soulier Syndrome?", a: "No correction (because the defect is in the structural platelet GP Ib receptor, not a plasma factor)." },
            { q: "Effect of adding normal plasma to a platelet agglutination test using Ristocetin in a patient with von Willebrand Disease?", a: "Correction (because normal plasma replenishes the missing von Willebrand Factor)." },
            { q: "Acquired vascular purpura caused by Vitamin C deficiency affecting collagen cross-linking?", a: "Scurvy." },
            { q: "Classic perifollicular skin findings pathognomonic for severe Vitamin C deficiency?", a: "Perifollicular hemorrhages and \"corkscrew\" hairs. Myelofibrosis and Secondary Myeloproliferative States" },
            { q: "Principal bone marrow cytokine responsible for driving the extensive reactive collagen fibrosis in Primary Myelofibrosis?", a: "Transforming Growth Factor-beta (TGF-$\\beta$) (released from clonal megakaryocytes)." },
            { q: "Name given to the dry tap bone marrow aspiration attempt classic in Primary Myelofibrosis and Hairy Cell Leukemia?", a: "Punctio sicca." },
            { q: "Most common physiological cause of a secondary polycythemia presenting with elevated erythropoietin (EPO) levels?", a: "Chronic hypoxemia (e.g., severe COPD, sleep apnea, high altitude) or EPO-secreting tumors." },
            { q: "Paraneoplastic syndrome condition where a renal cell carcinoma or cerebellar hemangioblastoma causes erythrocytosis?", a: "Inappropriate secondary polycythemia (via autonomous EPO production)." },
            { q: "Pathophysiological driver of erythromelalgia (burning pain and erythema in extremities) in Essential Thrombocythemia?", a: "Platelet microvascular occlusion and subsequent endothelial inflammation. Special Storage Profiles and Plasma Cell Variants" },
            { q: "Diagnostic plasma cell threshold required to classify a patient as Smoldering Multiple Myeloma?", a: "Serum M-protein $\\ge 3\\text{ g/dL}$ OR bone marrow clonal plasma cells $10\\%\\text{ to }60\\%$ without CRAB features." },
            { q: "Cytogenetic deletion strongly associated with high-risk Multiple Myeloma and short survival times?", a: "Deletion $17\\text{p}$ ($del(17p)$ losing the p53 gene)." },
            { q: "Primary mode of therapeutic action for Immunomodulatory drugs (IMiDs like Lenalidomide) in Multiple Myeloma?", a: "Binding to Cereblon, leading to the selective degradation of Ikaros and Aiolos transcription factors." },
            { q: "Mechanism of action for Bortezomib in the treatment of Multiple Myeloma?", a: "Reversible inhibition of the $26\\text{S}$ proteasome, inducing unfolded protein stress and apoptosis." },
            { q: "Specific organ dysfunction that makes the usage of systemic Bisphosphonates highly risky or contraindicated in Myeloma patients?", a: "Severe Renal Insufficiency ($\\text{GFR} < 30\\text{ mL/min}$)." },
            { q: "Diagnostic criteria for Light Chain Smoldering Multiple Myeloma?", a: "Involved/uninvolved serum free light chain ratio $\\ge 100$ plus bone marrow plasma cells $<60\\%$. Coagulation Cascade Regulation and Thrombophilia Pathology" },
            { q: "Endothelial cell surface receptor that binds Thrombin to activate the Protein C pathway?", a: "Thrombomodulin." },
            { q: "Co-factor that accelerates the inactivation of Factors Va and VIIIa by Activated Protein C?", a: "Protein S." },
            { q: "Plasma inhibitor that directly neutralizes Tissue Factor-Factor VIIa-Factor Xa complexes?", a: "Tissue Factor Pathway Inhibitor (TFPI)." },
            { q: "Specific mechanism by which Antithrombin III neutralizes Thrombin and Factor Xa?", a: "Functions as a suicide substrate protease inhibitor, forming a stable 1:1 complex with the active site of the clotting factors." },
            { q: "Specific structural component of the endothelial surface that naturally accelerates Antithrombin III activity?", a: "Heparan sulfate proteoglycans." },
            { q: "Diagnostic pitfall when testing for Antithrombin III deficiency during an acute thrombotic event?", a: "Acute thrombosis can transiently consume Antithrombin III, leading to a false-positive diagnosis." },
            { q: "Minimum duration a patient must be off oral Warfarin before testing for functional Protein C and S levels?", a: "Two weeks. Hemolytic Anemias: Enzymatic and Membrane Details" },
            { q: "Metabolic pathway in which Glucose-6-Phosphate Dehydrogenase (G6PD) operates to protect RBCs from oxidative stress?", a: "Hexose monophosphate (HMP) shunt." },
            { q: "Key reducing equivalent generated by G6PD that maintains glutathione in its active state?", a: "NADPH." },
            { q: "Molecular consequence to hemoglobin when NADPH is depleted under oxidative stress?", a: "Sulfhydryl groups on Hb cross-link, causing the protein to denature and precipitate as Heinz bodies." },
            { q: "Specific physiological mechanism by which \"bite cells\" are formed in G6PD deficiency?", a: "Splenic macrophages pluck out denatured hemoglobin inclusions (Heinz bodies) from the erythrocytes." },
            { q: "Diagnostic pitfall when testing G6PD enzyme activity levels immediately after an acute hemolytic crisis?", a: "False-negative result due to the destruction of older, enzyme-deficient RBCs and a high concentration of young, enzyme-replete reticulocytes." },
            { q: "Transmembrane transport protein mutated in the majority of patients with autosomal dominant Hereditary Spherocytosis?", a: "Ankyrin (encoded by the ANK1 gene)." },
            { q: "Primary site of RBC destruction in Hereditary Spherocytosis?", a: "The splenic cords of Billroth (extravascular hemolysis). Hemoglobinopathies and Quantitative Globin Defects" },
            { q: "Normal physiological composition of adult Hemoglobin A ($HbA$)?", a: "Two alpha-globin chains and two beta-globin chains ($\\alpha_2\\beta_2$)." },
            { q: "Normal physiological composition of fetal Hemoglobin F ($HbF$)?", a: "Two alpha-globin chains and two gamma-globin chains ($\\alpha_2\\gamma_2$)." },
            { q: "Exact amino acid substitution at position 6 of the beta-chain that results in Hemoglobin S ($HbS$)?", a: "Substitution of hydrophilic glutamic acid with hydrophobic valine." },
            { q: "Molecular consequence when deoxygenated Hemoglobin S molecules aggregate?", a: "Hydrophobic interactions cause polymerization into long, rigid crystalline polymers that distort the RBC into a sickle shape." },
            { q: "Exact amino acid substitution at position 6 of the beta-chain that results in Hemoglobin C ($HbC$)?", a: "Substitution of glutamic acid with lysine." },
            { q: "Microscopic structural morphology typical of Hemoglobin C crystals seen in homozygous HbCC patients?", a: "Hexagonal, dark-staining, rod-like intracellular crystals." },
            { q: "Pathophysiological mechanism behind the development of Beta-Thalassemia major?", a: "Severe reduction or complete absence of beta-globin synthesis leading to an excess of unpaired, unstable alpha-globin chains that precipitate and cause ineffective erythropoiesis. Acute Leukemia Cytogenetics and Molecular Drivers" },
            { q: "Cytogenetic translocation $\\text{t}(15;17)(\\text{q}24;\\text{q}21)$ fuses which two genes?", a: "PML (promyelocytic leukemia) and RARA (retinoic acid receptor alpha)." },
            { q: "Biological function disrupted by the PML-RARA fusion protein in Acute Promyelocytic Leukemia?", a: "Blocks myeloid differentiation at the promyelocytic stage by recruiting histone deacetylases to repress transcription." },
            { q: "Cytogenetic translocation $\\text{t}(8;21)(\\text{q}22;\\text{q}22)$ in AML fuses which two genes?", a: "RUNX1 (AML1) and RUNX1T1 (ETO)." },
            { q: "Cytogenetic inversion $\\text{inv}(16)(\\text{p}13.1\\text{q}22)$ in Acute Myeloid Leukemia fuses which two genes?", a: "CBFB (core-binding factor subunit beta) and MYH11." },
            { q: "Prognostic significance of $\\text{t}(8;21)$ or $\\text{inv}(16)$ in a patient with de novo Acute Myeloid Leukemia?", a: "Confers a favorable prognosis (classified as Core Binding Factor AML)." },
            { q: "Internal tandem duplication mutation in which gene confers a poor prognosis in cytogenetically normal AML?", a: "FLT3 (Fms-like tyrosine kinase 3)." },
            { q: "Cell surface protein configuration that characterizes the immunophenotype of standard Acute Lymphoblastic Leukemia lymphoblasts?", a: "TdT positive, CD19 positive, and CD10 positive (Common ALL Antigen / CALLA). Chronic Lymphoproliferative and Plasma Cell Disorders" },
            { q: "Clonal cell surface marker expression pattern that definitively differentiates CLL from Mantle Cell Lymphoma via flow cytometry?", a: "Both express CD5, but CLL is CD23 positive and Mantle Cell Lymphoma is CD23 negative." },
            { q: "Histological pattern within lymph nodes when CLL manifests primarily as a solid tumor (Small Lymphocytic Lymphoma)?", a: "Diffuse effacement of nodal architecture with proliferation centers containing prolymphocytes and paraimmunoblasts." },
            { q: "Laboratory parameter used in the Rai Staging System to classify Stage IV Chronic Lymphocytic Leukemia?", a: "Thrombocytopenia (platelets $<100,000/\\mu\\text{L}$)." },
            { q: "Diagnostic evaluation required to differentiate Smoldering Multiple Myeloma from Monoclonal Gammopathy of Undetermined Significance (MGUS)?", a: "Quantifying clonal bone marrow plasma cells ($10\\text{ to }60\\%$ in Smoldering vs. $<10\\%$ in MGUS)." },
            { q: "Most common light-chain configuration found in systemic AL amyloidosis secondary to plasma cell dyscrasias?", a: "Lambda ($\\lambda$) light chains." },
            { q: "Mechanism by which Multiple Myeloma plasma cells induce lytic bone lesions?", a: "Secretion of RANKL and DKK1, which activates osteoclasts and suppresses osteoblasts. Chronic Myeloproliferative Neoplasms" },
            { q: "Translocation $\\text{t}(9;22)(\\text{q}34.1;\\text{q}11.2)$ relocates the c-ABL proto-oncogene to which specific gene site on chromosome 22?", a: "BCR (breakpoint cluster region)." },
            { q: "Intracellular signaling pathways constitutively activated by the BCR-ABL1 fusion tyrosine kinase?", a: "JAK/STAT, RAS/MAPK, and PI3K/AKT pathways." },
            { q: "Specific JAK2 mutation found in nearly all cases of Polycythemia Vera?", a: "A valine-to-phenylalanine substitution at codon 617 (JAK2 V617F) in the pseudokinase domain." },
            { q: "Pathophysiological effect of the JAK2 V617F mutation on hematopoietic growth factor receptors?", a: "Confers hypersensitivity to erythropoietin, thrombopoietin, and G-CSF, allowing cytokine-independent signaling." },
            { q: "Major bone marrow biopsy feature that distinguishes Essential Thrombocythemia from Primary Myelofibrosis in early stages?", a: "ET shows loose clusters of giant, mature megakaryocytes without significant reticulin fibrosis." },
            { q: "Serum erythropoietin (EPO) level expected in a patient with Polycythemia Vera vs. Secondary Polycythemia?", a: "Suppressed/low in Polycythemia Vera; elevated in Secondary Polycythemia. Advanced Coagulopathies and Platelet Dysfunctions" },
            { q: "Target antigen of the autoantibodies driving Immune Thrombocytopenic Purpura (ITP)?", a: "Platelet membrane glycoproteins GPIIb/IIIa or GPIb/IX." },
            { q: "Plasma metalloprotease responsible for cleaving ultra-large von Willebrand factor (vWF) multimers?", a: "ADAMTS13." },
            { q: "Pathophysiological mechanism behind the microvascular thrombosis in Thrombotic Thrombocytopenic Purpura (TTP)?", a: "Accumulation of uncleaved ultra-large vWF multimers causes spontaneous platelet aggregation and microvascular shear stress." },
            { q: "Crucial laboratory parameter that differentiates TTP/HUS from Disseminated Intravascular Coagulation (DIC)?", a: "Coagulation profiles (PT and aPTT) are normal in TTP/HUS but prolonged in DIC." },
            { q: "Inherited structural defect responsible for Bernard-Soulier Syndrome?", a: "Deficiency or dysfunction of the GPIb-IX-V receptor complex on the platelet membrane." },
            { q: "Inherited structural defect responsible for Glanzmann Thrombasthenia?", a: "Deficiency or dysfunction of the GPIIb/IIIa (integrin $\\alpha_{\\text{IIb}}\\beta_3$) receptor complex on the platelet membrane." },
            { q: "Laboratory aggregation pattern diagnostic for von Willebrand Disease when evaluating platelet-rich plasma?", a: "Impaired platelet agglutination to Ristocetin, which normalizes upon the addition of normal plasma. Lymphoma Pathogenesis and Immunophenotypical Nuances" },
            { q: "Chromosomal translocation t(8;14)(q24;q32) characteristically moves which proto-oncogene to the immunoglobulin heavy chain locus?", a: "MYC." },
            { q: "Chromosomal translocation t(14;18)(q32;q21) characteristically fuses the BCL2 gene to which locus?", a: "Immunoglobulin heavy chain (IGH) locus." },
            { q: "Molecular mechanism by which BCL2 overexpression promotes cell survival in Follicular Lymphoma?", a: "It stabilizes the outer mitochondrial membrane, preventing the release of cytochrome c and inhibiting apoptosis." },
            { q: "Chromosomal translocation t(11;14)(q13;q32) overexpresses which protein?", a: "Cyclin D1 (encoded by the CCND1 gene)." },
            { q: "Primary physiological function of Cyclin D1 that is dysregulated in Mantle Cell Lymphoma?", a: "Promotes transition from G1 to S phase of the cell cycle by phosphorylating and inactivating the Retinoblastoma (Rb) protein." },
            { q: "Specific translocation t(11;18)(q21;q21) seen in gastric MALT lymphoma fuses which two genes?", a: "BIRC3 (API2) and MALT1." },
            { q: "Immunophenotypic profile that characterizes classic Reed-Sternberg cells?", a: "CD15 positive, CD30 positive, and CD45 negative." },
            { q: "Immunophenotypic profile that distinguishes Nodular Lymphocyte Predominant Hodgkin Lymphoma (NLPHL) from classic Hodgkin Lymphoma?", a: "Popcorn cells in NLPHL are CD20 positive, CD45 positive, CD15 negative, and CD30 negative. Porphyrias and Disorders of Heme Biosynthesis" },
            { q: "Enzyme deficiency responsible for the clinical presentation of Acute Intermittent Porphyria (AIP)?", a: "Porphobilinogen deaminase (also known as hydroxymethylbilane synthase)." },
            { q: "Major neurotoxic precursors that accumulate in plasma and urine during an acute flare of AIP?", a: "Aminolevulinic acid (ALA) and porphobilinogen (PBG)." },
            { q: "Primary enzymatic step inhibited by lead poisoning in the heme synthesis pathway?", a: "Aminolevulinic acid dehydratase (ALA dehydratase) and ferrochelatase." },
            { q: "Intermediate product that accumulates in erythrocytes as a direct consequence of lead poisoning?", a: "Zinc protoporphyrin." },
            { q: "Enzyme deficiency responsible for Porphyria Cutanea Tarda (PCT)?", a: "Uroporphyrinogen decarboxylase." },
            { q: "Classic skin pathology seen on sun-exposed areas of patients with Porphyria Cutanea Tarda?", a: "Subepidermal blistering, fragility, and hyperpigmentation due to porphyrin activation by UV light." },
            { q: "First-line medical therapies used to downregulate heme synthesis during an acute attack of AIP?", a: "Intravenous hemin or high-dose glucose infusions (which repress hepatic ALA synthase-1). Bone Marrow Failure and Myelodysplastic Pathology" },
            { q: "Pathognomonic bone marrow erythroid finding in myelodysplastic syndrome characterized by a ring of iron granules around the nucleus?", a: "Ring sideroblast." },
            { q: "Exact organelle where iron accumulates abnormally to form the morphology of a ring sideroblast?", a: "Mitochondria." },
            { q: "Genetic mutation strongly associated with the presence of ring sideroblasts in Myelodysplastic Syndrome?", a: "SF3B1 mutation (a spliceosome gene)." },
            { q: "Nuclear morphology change in neutrophils (\"pseudo-Pelger-Huët anomaly\") classic for Myelodysplastic Syndrome?", a: "Hyposegmented (bilobed or monolobed) neutrophilic nuclei." },
            { q: "Chromosomal deletion associated with a specific myelodysplastic syndrome variant that responds dramatically to lenalidomide?", a: "Isolated deletion of the long arm of chromosome 5 (del(5q))." },
            { q: "Molecular defect driving Fanconi Anemia?", a: "Defect in the multiprotein FANCA-complex responsible for DNA interstrand cross-link repair." },
            { q: "Classic developmental phenotype that distinguishes Diamond-Blackfan Anemia from Fanconi Anemia?", a: "Diamond-Blackfan shows pure red cell aplasia and triphalangeal thumbs; Fanconi shows pancytopenia and absent or hypoplastic thumbs. Specialized Hypercoagulable Conditions" },
            { q: "Structural alteration caused by the Factor V Leiden mutation?", a: "A single point mutation (Arg506Gln) at the cleavage site of Factor V." },
            { q: "Functional consequence of the Arg506Gln mutation in Factor V Leiden?", a: "Renders Factor Va resistant to cleavage and inactivation by Activated Protein C (APC)." },
            { q: "Molecular basis of the Prothrombin G20210A mutation?", a: "A point mutation in the 3' untranslated region of the prothrombin gene that increases mRNA stability and prothrombin expression." },
            { q: "Mechanism of hypercoagulability in a patient with an Antithrombin III deficiency?", a: "Failure to neutralize serine protease clotting factors (Thrombin, Factor Xa, Factor IXa)." },
            { q: "Mechanistic reason why initiating Warfarin therapy can induce temporary hypercoagulability?", a: "Warfarin depletes Protein C and Protein S (short half-lives) faster than it depletes clotting factors II, IX, and X." },
            { q: "Diagnostic test used to confirm a Lupus Anticoagulant that utilizes viper venom?", a: "Dilute Russell's Viper Venom Time (dRVVT)." },
            { q: "True underlying pathophysiology behind the false-positive VDRL/RPR test in Antiphospholipid Syndrome?", a: "Antibodies cross-react with the cardiolipin antigen used in the syphilis screening assay. Transfusion Complications and Precision Management" },
            { q: "Transfusion reaction presenting with fever, chills, and mild dyspnea within 1 to 6 hours, driven by pre-formed cytokines in the blood product bag?", a: "Febrile Non-Hemolytic Transfusion Reaction." },
            { q: "Processing step utilized by blood banks to drastically reduce the incidence of Febrile Non-Hemolytic Transfusion Reactions?", a: "Leukoreduction (filtering out donor white blood cells prior to storage)." },
            { q: "Transfusion reaction presenting as acute hypoxemia and non-cardiogenic pulmonary edema within 6 hours of a transfusion?", a: "Transfusion-Related Acute Lung Injury (TRALI)." },
            { q: "Primary immunological driver behind Transfusion-Related Acute Lung Injury (TRALI)?", a: "Donor HLA or neutrophil-specific antibodies targeting and activating recipient neutrophils within the pulmonary vasculature." },
            { q: "Clinical feature that distinguishes Transfusion-Associated Circulatory Overload (TACO) from TRALI?", a: "TACO presents with signs of volume overload, such as hypertension, elevated JVP, and response to diuretics." },
            { q: "Storage requirement used to prevent Transfusion-Associated Graft-Versus-Host Disease (TA-GVHD) in immunocompromised recipients?", a: "Gamma or X-ray irradiation of cellular blood products to inactivate donor T-lymphocytes." },
            { q: "Phenomenon where profound thrombocytopenia occurs 5 to 10 days post-transfusion due to alloantibodies against human platelet antigens?", a: "Post-Transfusion Purpura (PTP). Histiocytic and Histological Borderlands" },
            { q: "Clonal neoplastic proliferation of dendritic cells presenting with lytic bone lesions, skin rash, and diabetes insipidus?", a: "Langerhans Cell Histiocytosis (LCH)." },
            { q: "Pathognomonic electron microscopy finding inside Langerhans Cell Histiocytosis cells?", a: "Birbeck granules (tennis-racket shaped cytoplasmic structures)." },
            { q: "Immunohistochemical cell surface markers positive in Langerhans Cell Histiocytosis?", a: "CD1a and Langerin (CD207)." },
            { q: "Aggressive, life-threatening syndrome characterized by cytopenias, massive hepatosplenomegaly, and hyperferritinemia driven by uninhibited macrophage activation?", a: "Hemophagocytic Lymphohistiocytosis (HLH)." },
            { q: "Principal cytokine that drives the hyperactivation of macrophages and subsequent hemophagocytosis in HLH?", a: "Interferon-gamma (IFN-γ)." },
            { q: "Histological pattern in lymph nodes showing an expansion of marginal zone B-cells that form a halo around reactive germinal centers?", a: "Marginal Zone Lymphoma." },
            { q: "Rare plasma cell variant disorder presenting with polyneuropathy, organomegaly, endocrinopathy, monoclonal protein, and skin changes?", a: "POEMS syndrome. Direct Oral Anticoagulants (DOACs) and Specific Reversal Agents" },
            { q: "Specific mechanism of action of Dabigatran?", a: "Direct, competitive thrombin (Factor IIa) inhibitor." },
            { q: "Specific mechanism of action of Rivaroxaban, Apixaban, and Edoxaban?", a: "Direct, selective inhibitors of free and clot-bound Factor Xa." },
            { q: "Monoclonal antibody fragment used for the immediate reversal of Dabigatran?", a: "Idarucizumab." },
            { q: "Decoy receptor protein used to reverse direct Factor Xa inhibitors (Rivaroxaban and Apixaban)?", a: "Andexanet alfa." },
            { q: "Standard coagulation screening test most prolonged by therapeutic doses of Dabigatran?", a: "Thrombin Time (TT) (and aPTT)." },
            { q: "Primary route of elimination for Dabigatran that requires strict dosage adjustments in renal failure?", a: "Renal clearance ($80\\%$). Secondary and Microangiopathic Thrombocytopenias" },
            { q: "Classic drug-induced thrombocytopenia mechanism associated with Quinine, Sulfa drugs, or Gold salts?", a: "Drug-dependent antibodies bind to platelet glycoproteins only in the presence of the drug, causing accelerated clearance." },
            { q: "Pathophysiological mechanism behind Heparin-Induced Thrombocytopenia (HIT) Type I?", a: "Direct non-immunologic pro-aggregatory effect of heparin on platelets, occurring within 1–2 days and presenting with mild, transient thrombocytopenia." },
            { q: "Minimum percentage drop in platelet count from baseline that defines a positive \"4Ts\" criteria component for HIT Type II?", a: "$>50\\%$ drop in platelet count." },
            { q: "Timing window post-heparin exposure during which HIT Type II characteristically manifests?", a: "5 to 10 days (or within 24 hours if pre-exposed to heparin in the past 100 days)." },
            { q: "Standard non-heparin anticoagulant of choice for a patient with confirmed HIT who has concurrent severe hepatic impairment?", a: "Bivalirudin or Fondaparinux (Argatroban is avoided/dose-reduced due to hepatic metabolism)." },
            { q: "Pathophysiological driver of diarrhea-associated (typical) Hemolytic Uremic Syndrome (HUS)?", a: "Shiga toxin localizes to the renal endothelial cells, causing endothelial damage, microthrombi formation, and mechanical hemolysis." },
            { q: "Alternative (atypical) Hemolytic Uremic Syndrome (aHUS) is primarily driven by genetic mutations in what physiological pathway?", a: "Regulatory proteins of the alternative complement pathway (e.g., Factor H, Factor I, or CD46)." },
            { q: "Humanized monoclonal antibody targeting complement protein C5 used as first-line therapy for atypical HUS?", a: "Eculizumab. Platelet Storage Pool and Adhesion Defects" },
            { q: "Specific substance stored inside platelet alpha-granules that is deficient in Gray Platelet Syndrome?", a: "Platelet-specific proteins (e.g., vWF, Fibrinogen, Platelet Factor 4, PDGF)." },
            { q: "Structural morphology of platelets on a peripheral blood smear in Gray Platelet Syndrome?", a: "Large, pale/gray platelets lacking normal purple azurophilic granulation." },
            { q: "Specific substances stored inside platelet dense ($\\delta$) granules that are deficient in Hermansky-Pudlak syndrome?", a: "ADP, ATP, Serotonin, and Calcium." },
            { q: "Oculocutaneous albinism combined with a bleeding diathesis due to dense granule deficiency defines which syndrome?", a: "Hermansky-Pudlak syndrome." },
            { q: "Quantitative functional test used to assess the initial stage of platelet adhesion in clinical practice?", a: "Platelet Function Analysis (PFA-100) closure time. High-Yield Lymphoma Mimics and Subtypes" },
            { q: "Benign, self-limiting lymphadenopathy characterized by follicular hyperplasia and sheets of pale histiocytes with tingible body macrophages?", a: "Reactive follicular hyperplasia." },
            { q: "Lymphoma variant that characteristically presents as an isolated, enlarging mass in the testis of an elderly man?", a: "Diffuse Large B-Cell Lymphoma (DLBCL)." },
            { q: "Distinctive immunohistochemical marker used to identify Primary Central Nervous System Lymphoma cells on biopsy?", a: "CD20 positive (as they are almost universally diffuse large B-cell lymphomas)." },
            { q: "Rare B-cell variant that arises within the walls of a chronic fluid-filled cavity, universally driven by HHV-8?", a: "Primary Effusion Lymphoma." },
            { q: "Slowly progressive T-cell lymphoma presenting with erythroderma, generalized lymphadenopathy, and circulating atypical T-cells with cerebriform nuclei?", a: "Sézary Syndrome. Advanced Hemoglobinopathies and Hydrops Fetalis" },
            { q: "Quantitative percentage of Hemoglobin A ($HbA$) expected on a hemoglobin electrophoresis of a patient with Beta-Thalassemia Major?", a: "$0\\%$ (completely absent in $\\beta^0/\\beta^0$ genotypes)." },
            { q: "Predominant hemoglobin type visualized on electrophoresis in a child with Beta-Thalassemia Major?", a: "Hemoglobin F ($\\alpha_2\\gamma_2$)." },
            { q: "Quantitative hemoglobin profile diagnostic for Alpha-Thalassemia Minor (trait) in an adult?", a: "Normal hemoglobin electrophoresis profile (diagnosed via genetic testing, as no abnormal bands are formed in adults)." },
            { q: "Specific name given to the dangerous condition where all four alpha-globin genes are deleted?", a: "Hydrops fetalis (or Alpha-Thalassemia Major)." },
            { q: "Cause of tissue hypoxia in a fetus with Hemoglobin Barts ($\\gamma_4$)?", a: "Hemoglobin Barts has an extremely high oxygen affinity, refusing to release oxygen to peripheral fetal tissues. Oncological Emergencies and Intracellular Lysis" },
            { q: "Electrocardiogram (ECG) changes expected during acute Tumor Lysis Syndrome due to severe hyperkalemia?", a: "Peaked T waves, PR interval prolongation, and widening of the QRS complex." },
            { q: "Intravenous medication given in Tumor Lysis Syndrome to stabilize the cardiac myocyte membrane against hyperkalemia?", a: "Calcium gluconate (or calcium chloride)." },
            { q: "Mechanism of action of Rasburicase in managing hyperuricemia?", a: "Catalyzes the oxidation of uric acid into allantoin, which is highly soluble and easily excreted by the kidneys." },
            { q: "Specific absolute neutrophil count (ANC) calculation formula?", a: "$\\text{ANC} = \\text{WBC} \\times (\\% \\text{Neutrophils} + \\% \\text{Bands}) / 100$." },
            { q: "Most common bacterial pathogens isolated from the blood of patients presenting with febrile neutropenia?", a: "Gram-positive cocci (e.g., Staphylococcus epidermidis, Staphylococcus aureus) and Gram-negative bacilli (e.g., Pseudomonas aeruginosa). Direct Oral Anticoagulants (DOACs) and Specific Reversal Agents" },
            { q: "Specific mechanism of action of Dabigatran?", a: "Direct, competitive thrombin (Factor IIa) inhibitor." },
            { q: "Specific mechanism of action of Rivaroxaban, Apixaban, and Edoxaban?", a: "Direct, selective inhibitors of free and clot-bound Factor Xa." },
            { q: "Monoclonal antibody fragment used for the immediate reversal of Dabigatran?", a: "Idarucizumab." },
            { q: "Decoy receptor protein used to reverse direct Factor Xa inhibitors (Rivaroxaban and Apixaban)?", a: "Andexanet alfa." },
            { q: "Standard coagulation screening test most prolonged by therapeutic doses of Dabigatran?", a: "Thrombin Time (TT)." },
            { q: "Primary route of elimination for Dabigatran that requires strict dosage adjustments in renal failure?", a: "Renal clearance (approximately 80%). Secondary and Microangiopathic Thrombocytopenias" },
            { q: "Classic drug-induced thrombocytopenia mechanism associated with Quinine, Sulfa drugs, or Gold salts?", a: "Drug-dependent antibodies bind to platelet glycoproteins only in the presence of the drug, causing accelerated clearance." },
            { q: "Pathophysiological mechanism behind Heparin-Induced Thrombocytopenia (HIT) Type I?", a: "Direct non-immunologic pro-aggregatory effect of heparin on platelets, occurring within 1–2 days and presenting with mild, transient thrombocytopenia." },
            { q: "Minimum percentage drop in platelet count from baseline that defines a positive \"4Ts\" criteria component for HIT Type II?", a: "Greater than 50% drop in platelet count." },
            { q: "Timing window post-heparin exposure during which HIT Type II characteristically manifests?", a: "5 to 10 days (or within 24 hours if pre-exposed to heparin in the past 100 days)." },
            { q: "Standard non-heparin anticoagulant of choice for a patient with confirmed HIT who has concurrent severe hepatic impairment?", a: "Bivalirudin or Fondaparinux (Argatroban is avoided or significantly dose-reduced due to hepatic metabolism)." },
            { q: "Pathophysiological driver of diarrhea-associated (typical) Hemolytic Uremic Syndrome (HUS)?", a: "Shiga toxin localizes to the renal endothelial cells, causing endothelial damage, microthrombi formation, and mechanical hemolysis." },
            { q: "Alternative (atypical) Hemolytic Uremic Syndrome (aHUS) is primarily driven by genetic mutations in what physiological pathway?", a: "Regulatory proteins of the alternative complement pathway (e.g., Factor H, Factor I, or CD46)." },
            { q: "Humanized monoclonal antibody targeting complement protein C5 used as first-line therapy for atypical HUS?", a: "Eculizumab. Platelet Storage Pool and Adhesion Defects" },
            { q: "Specific substance stored inside platelet alpha-granules that is deficient in Gray Platelet Syndrome?", a: "Platelet-specific proteins (e.g., vWF, Fibrinogen, Platelet Factor 4, PDGF)." },
            { q: "Structural morphology of platelets on a peripheral blood smear in Gray Platelet Syndrome?", a: "Large, pale/gray platelets lacking normal purple azurophilic granulation." },
            { q: "Specific substances stored inside platelet dense ($\\delta$) granules that are deficient in Hermansky-Pudlak syndrome?", a: "ADP, ATP, Serotonin, and Calcium." },
            { q: "Oculocutaneous albinism combined with a bleeding diathesis due to dense granule deficiency defines which syndrome?", a: "Hermansky-Pudlak syndrome." },
            { q: "Quantitative functional test used to assess the initial stage of platelet adhesion in clinical practice?", a: "Platelet Function Analysis (PFA-100) closure time. High-Yield Lymphoma Mimics and Subtypes" },
            { q: "Benign, self-limiting lymphadenopathy characterized by follicular hyperplasia and sheets of pale histiocytes with tingible body macrophages?", a: "Reactive follicular hyperplasia." },
            { q: "Lymphoma variant that characteristically presents as an isolated, enlarging mass in the testis of an elderly man?", a: "Diffuse Large B-Cell Lymphoma (DLBCL)." },
            { q: "Distinctive immunohistochemical marker used to identify Primary Central Nervous System Lymphoma cells on biopsy?", a: "CD20 positive (as they are almost universally diffuse large B-cell lymphomas)." },
            { q: "Rare B-cell variant that arises within the walls of a chronic fluid-filled cavity, universally driven by HHV-8?", a: "Primary Effusion Lymphoma." },
            { q: "Slowly progressive T-cell lymphoma presenting with erythroderma, generalized lymphadenopathy, and circulating atypical T-cells with cerebriform nuclei?", a: "Sézary Syndrome. Advanced Hemoglobinopathies and Hydrops Fetalis" },
            { q: "Quantitative percentage of Hemoglobin A ($HbA$) expected on a hemoglobin electrophoresis of a patient with Beta-Thalassemia Major?", a: "0% (completely absent in $\\beta^0/\\beta^0$ genotypes)." },
            { q: "Predominant hemoglobin type visualized on electrophoresis in a child with Beta-Thalassemia Major?", a: "Hemoglobin F ($\\alpha_2\\gamma_2$)." },
            { q: "Quantitative hemoglobin profile diagnostic for Alpha-Thalassemia Minor (trait) in an adult?", a: "Normal hemoglobin electrophoresis profile (diagnosed via genetic testing, as no abnormal bands are formed in adults)." },
            { q: "Specific name given to the dangerous condition where all four alpha-globin genes are deleted?", a: "Hydrops fetalis (or Alpha-Thalassemia Major)." },
            { q: "Cause of tissue hypoxia in a fetus with Hemoglobin Barts ($\\gamma_4$)?", a: "Hemoglobin Barts has an extremely high oxygen affinity, refusing to release oxygen to peripheral fetal tissues. Oncological Emergencies and Intracellular Lysis" },
            { q: "Electrocardiogram (ECG) changes expected during acute Tumor Lysis Syndrome due to severe hyperkalemia?", a: "Peaked T waves, PR interval prolongation, and widening of the QRS complex." },
            { q: "Intravenous medication given in Tumor Lysis Syndrome to stabilize the cardiac myocyte membrane against hyperkalemia?", a: "Calcium gluconate (or calcium chloride)." },
            { q: "Mechanism of action of Rasburicase in managing hyperuricemia?", a: "Catalyzes the oxidation of uric acid into allantoin, which is highly soluble and easily excreted by the kidneys." },
            { q: "Specific absolute neutrophil count (ANC) calculation formula?", a: "$\\text{ANC} = \\text{WBC} \\times (\\% \\text{Neutrophils} + \\% \\text{Bands}) / 100$." },
            { q: "Most common bacterial pathogens isolated from the blood of patients presenting with febrile neutropenia?", a: "Gram-positive cocci (e.g., Staphylococcus epidermidis, Staphylococcus aureus) and Gram-negative bacilli (e.g., Pseudomonas aeruginosa). Anticoagulant Monitoring Pitfalls & Heparin Resistance" },
            { q: "Most common physiological cause of \"Heparin Resistance,\" where exceptionally high doses of heparin fail to prolong the aPTT?", a: "Antithrombin (ATIII) deficiency (inherited or acquired via consumption)." },
            { q: "Alternative laboratory assay used to accurately monitor Unfractionated Heparin therapy when a patient has a baseline prolonged aPTT?", a: "Chromogenic anti-Factor Xa assay." },
            { q: "Effect of therapeutic doses of direct oral Factor Xa inhibitors on standard Prothrombin Time (PT) assays?", a: "They prolong the PT in a variable, reagent-dependent manner that is unreliable for quantification." },
            { q: "Coagulation test that remains completely unaffected by the presence of therapeutic direct oral Factor Xa inhibitors?", a: "Thrombin Time (TT) (which only evaluates thrombin-to-fibrin conversion). Paroxysmal Nocturnal Hemoglobinuria (PNH) & Complement Therapeutics" },
            { q: "Principal cause of chronic iron deficiency in patients with untreated Paroxysmal Nocturnal Hemoglobinuria?", a: "Continuous intravascular hemolysis leading to marked, persistent hemosiderinuria and urinary iron loss." },
            { q: "Serious infectious complication for which patients must be vaccinated prior to initiating Eculizumab or Ravulizumab therapy?", a: "Neisseria meningitidis infection (due to therapeutic blockade of the terminal complement pathway/MAC assembly)." },
            { q: "Primary mechanism of breakthrough extravascular hemolysis that can occur in PNH patients treated with C5 inhibitors?", a: "C3b fragments continue to accumulate on the RBC surface upstream of C5, leading to splenic macrophage clearing." },
            { q: "Target of Pegcetacoplan, a newer complement inhibitor used to prevent both intravascular and extravascular hemolysis in PNH?", a: "Complement component C3 (and C3b). Myelodysplastic/Myeloproliferative Overlap & Histiocytic Subtleties" },
            { q: "Minimum percentage of peripheral blood monocytes required over a 3-month period to satisfy WHO diagnostic criteria for CMML?", a: "Persistent monocytosis $\\ge 10\\%$ of the total white blood cell count (and $\\ge 1,000/\\mu\\text{L}$)." },
            { q: "Distinguishing bone marrow feature that separates Chronic Myelomonocytic Leukemia (CMML) from Chronic Myeloid Leukemia (CML)?", a: "CMML lacks the BCR-ABL1 fusion gene and shows dominant monocytic proliferation rather than granulocytic." },
            { q: "Key diagnostic criteria that separates Juvenile Myelomonocytic Leukemia (JMML) from adult CMML forms?", a: "JMML is a childhood disorder strongly linked to mutations in the RAS pathway (e.g., PTPN11, NF1, KRAS) and exhibits elevated Hemoglobin F." },
            { q: "Classic radiological description of the bone lesions seen in Langerhans Cell Histiocytosis (LCH) of the skull?", a: "\"Punched-out\" lytic lesions without a reactive sclerotic rim." },
            { q: "Therapeutic backbone for a patient presenting with severe, life-threatening Hemophagocytic Lymphohistiocytosis (HLH)?", a: "The HLH-94 protocol consisting of Etoposide, Dexamethasone, and Cyclosporine A. Quantitative Platelet Aggregometry Profiles" },
            { q: "Platelet aggregometry response to ADP, Epinephrine, and Collagen in a patient with Glanzmann Thrombasthenia?", a: "Severely impaired or completely absent aggregation." },
            { q: "Platelet aggregometry response to Ristocetin in a patient with Glanzmann Thrombasthenia?", a: "Normal agglutination (because the GP Ib-IX-V complex is entirely intact)." },
            { q: "Platelet aggregometry response to ADP, Epinephrine, and Collagen in a patient with Bernard-Soulier Syndrome?", a: "Normal aggregation." },
            { q: "Platelet aggregometry response to Ristocetin in a patient with Bernard-Soulier Syndrome?", a: "Absent agglutination, which does not correct when mixed with normal plasma. Rare T-Cell & Aggressive B-Cell Lymphoma Variants" },
            { q: "Highly aggressive T-cell lymphoma arising in the background of long-standing, poorly controlled Celiac Disease?", a: "Enteropathy-Associated T-Cell Lymphoma (EATL)." },
            { q: "Primary anatomical location where Enteropathy-Associated T-Cell Lymphoma (EATL) characteristically causes ulceration and perforation?", a: "The proximal small intestine (jejunum and ileum)." },
            { q: "Rare B-cell malignancy that characteristically arises within the walls of a chronic fluid-filled cavity, universally driven by HHV-8?", a: "Primary Effusion Lymphoma (PEL)." },
            { q: "Aggressive Non-Hodgkin Lymphoma presenting as a rapidly expanding, destructive midline mass in the nasal cavity, strongly linked to EBV?", a: "Extranodal NK/T-cell Lymphoma, nasal type." },
            { q: "Cytogenetic configuration that defines a \"Double-Hit\" High-Grade B-cell Lymphoma?", a: "Concurrent rearrangements of the MYC gene along with either the BCL2 or BCL6 gene. Targeted Oncological Mechanisms & Toxicities" },
            { q: "Most common long-term, life-threatening organ toxicity associated with the use of Anthracyclines (e.g., Doxorubicin)?", a: "Dilated cardiomyopathy (congestive heart failure) due to cumulative, iron-dependent free radical generation." },
            { q: "Cardioprotective chelating agent administered alongside Doxorubicin to reduce the risk of anthracycline-induced cardiomyopathy?", a: "Dexrazoxane." },
            { q: "Classic chemotherapeutic agent historically associated with the development of secondary Acute Myeloid Leukemia (sAML) with a short latency period?", a: "Etoposide (a Topoisomerase II inhibitor, often associated with $\\text{t}(11;23)$ or MLL gene rearrangements)." },
            { q: "Class-specific adverse effect of Tyrosine Kinase Inhibitors like Imatinib related to fluid balance?", a: "Fluid retention presenting as periorbital edema, pleural effusions, or peripheral edema." },
            { q: "Distinctive pulmonary toxic side effect characteristically associated with Bleomycin therapy?", a: "Pulmonary fibrosis (interstitial lung disease), which requires serial pulmonary function testing (DLCO monitoring). Targeted Therapeutics & Precision Mechanisms" },
            { q: "Specific molecular target of Rituximab used in B-cell lymphomas and autoimmune cytopenias?", a: "CD20 surface antigen expressed on mature B cells." },
            { q: "Humanized monoclonal antibody targeting CD38 used as a core therapy for relapsed or refractory Multiple Myeloma?", a: "Daratumumab." },
            { q: "Reversible proteasome inhibitor that disrupts protein homeostasis to induce apoptosis in Multiple Myeloma plasma cells?", a: "Bortezomib." },
            { q: "Mechanism of action of Brentuximab Vedotin used in Hodgkin Lymphoma?", a: "Antibody-drug conjugate targeting CD30 that delivers a microtubule-disrupting agent (MMAE) directly to Reed-Sternberg cells." },
            { q: "Chimeric antigen receptor (CAR) T-cell therapies primarily target which antigen in refractory B-cell Acute Lymphoblastic Leukemia?", a: "CD19." },
            { q: "Unique mechanism of action of Romiplostim used in chronic Immune Thrombocytopenic Purpura (ITP)?", a: "Thrombopoietin (TPO) receptor agonist that stimulates platelet production in the bone marrow. Microenvironment, Iron Transport, and Secondary Anemias" },
            { q: "Major iron-transport protein responsible for moving iron from enterocytes and macrophages into circulation?", a: "Ferroportin." },
            { q: "Plasma transport protein that binds toxic free hemoglobin in the blood to prevent oxidative tissue damage?", a: "Haptoglobin." },
            { q: "Intracellular storage protein that serves as the primary accessible reserve for iron inside hepatocytes and macrophages?", a: "Ferritin." },
            { q: "Specific physiological site of erythropoietin (EPO) production in the adult human body?", a: "Peritubular interstitial cells of the renal cortex." },
            { q: "Primary mechanism behind the development of Anemia of Prematurity?", a: "Impaired erythropoietin production in response to hypoxia combined with a shortened red blood cell lifespan." },
            { q: "Distinctive bone marrow feature that distinguishes Congenital Dyserythropoietic Anemia (CDA) from other causes of ineffective erythropoiesis?", a: "Marked erythroblast multinuclearity and nuclear bridging. Hypercoagulability Nuances & Endothelial Interactions" },
            { q: "Autosomal dominant condition causing a mutation in the thrombomodulin gene results in what clinical phenotype?", a: "Increased risk of early-onset venous thromboembolism due to impaired activation of Protein C." },
            { q: "Impact of severe Hepatic Cirrhosis on a patient's natural anticoagulant systems?", a: "Marked reduction in the synthesis of Protein C, Protein S, and Antithrombin, which can paradoxically balance out the loss of procoagulants." },
            { q: "Most accurate timing to check for a suspected hereditary Protein S deficiency after an acute deep vein thrombosis?", a: "At least 2 weeks after completing acute anticoagulation therapy, as acute thrombosis consumes Protein S." },
            { q: "Mechanism by which active malignancies promote a systemic hypercoagulable state (Trousseau syndrome)?", a: "Tumor cells secrete tissue factor-bearing microvesicles and mucins that directly activate Factor X." },
            { q: "Cardinal clinical presentation that defines May-Thurner Syndrome?", a: "Left-sided deep vein thrombosis caused by compression of the left common iliac vein by the overlying right common iliac artery. Histiocytic Profiles & Bone Marrow Borderlands" },
            { q: "Clonal driver mutation present in approximately 50% of cases of Langerhans Cell Histiocytosis (LCH)?", a: "BRAF V600E mutation." },
            { q: "Classic immunohistochemical marker that identifies Langerhans cells by staining for the component of Birbeck granules?", a: "Langerin (CD207)." },
            { q: "Standard first-line systemic therapy for multi-system Langerhans Cell Histiocytosis?", a: "Vinblastine combined with Prednisone." },
            { q: "Life-threatening diagnostic criteria for Hemophagocytic Lymphohistiocytosis (HLH) includes what level of fasting serum triglycerides?", a: "Fasting triglycerides $\\ge 265\\text{ mg/dL}$ (or $\\ge 3\\text{ mmol/L}$)." },
            { q: "Diagnostic bone marrow hallmark observed on a core biopsy of a patient with advanced Primary Myelofibrosis?", a: "Dense reticulin or collagen fibrosis with a complete absence of normal fat spaces. Rare Coagulopathies & Mixing Study Logistics" },
            { q: "Coagulation profile (PT, aPTT, bleeding time) characteristically observed in an isolated Factor VII deficiency?", a: "Prolonged PT, normal aPTT, and normal bleeding time." },
            { q: "Coagulation factor deficiency that characteristically causes a severely prolonged aPTT in vitro but presents with absolutely no clinical bleeding tendency?", a: "Factor XII (Hageman factor) deficiency." },
            { q: "Diagnostic implication if a patient's prolonged aPTT fails to correct back to normal limits immediately upon a 1:1 mixing study?", a: "Indicates the presence of a coagulation inhibitor (e.g., Lupus Anticoagulant or a specific factor antibody)." },
            { q: "Diagnostic implication if a patient's prolonged aPTT corrects immediately upon a 1:1 mixing study, but prolongs again after a 2-hour incubation?", a: "Indicates the presence of a time-dependent, temperature-dependent factor inhibitor (classic for Factor VIII inhibitors)." },
            { q: "Rare bleeding disorder characterized by a normal PT, normal aPTT, and normal platelet count, but presents with delayed severe hemorrhage after trauma?", a: "Factor XIII deficiency." },
            { q: "Definitive qualitative screening test used to detect a suspected clinical Factor XIII deficiency?", a: "Urea clot solubility test (Factor XIII-deficient clots dissolve rapidly in a 5-molar urea solution). Transfusion Immunology & Metabolic Complications" },
            { q: "Mechanism behind a Delayed Hemolytic Transfusion Reaction?", a: "Anamnestic antibody response against minor red blood cell antigens (such as Kidd or Kell) previously encountered via transfusion or pregnancy." },
            { q: "Metabolic complication resulting from the rapid transfusion of multiple units of packed red blood cells stored for an extended period?", a: "Hyperkalemia (caused by the gradual leakage of potassium out of aging erythrocytes into the supernatant fluid of the storage bag)." },
            { q: "Primary mechanism behind Post-Transfusion Purpura (PTP)?", a: "Production of alloantibodies against human platelet antigen-1a (HPA-1a) that paradoxically destroy both the transfused and autologous platelets." },
            { q: "Processing modification required for blood products given to a patient with a history of severe, IgA-mediated anaphylactic transfusion reactions?", a: "Extensive washing of cellular blood products with saline to remove all traces of donor plasma proteins." },
            { q: "Direct physiological trigger for Transfusion-Associated Circulatory Overload (TACO)?", a: "Rapid infusion of a large volume of blood product exceeding the cardiovascular system's regulatory capacity, increasing hydrostatic pressure. Myeloma Mimics, Heavy Chain Diseases, and Organ Toxicity" },
            { q: "Distinctive clinical triad that differentiates Waldenström Macroglobulinemia from Multiple Myeloma?", a: "Presence of a monoclonal IgM spike, lymphoplasmacytic bone marrow infiltration, and absence of lytic bone lesions." },
            { q: "Primary pathophysiological mechanism driving the hyperviscosity syndrome in Waldenström Macroglobulinemia?", a: "Large IgM pentamers circulate in high concentrations, significantly increasing plasma resistance and shearing forces." },
            { q: "Rare plasma cell dyscrasia characterized by the isolated production of truncated immunoglobulin heavy chains without light chains?", a: "Heavy Chain Disease (such as Franklin disease or Seligmann disease)." },
            { q: "Distinctive organ biopsy finding when examining systemic amyloid deposits under polarized light microscopy?", a: "Apple-green birefringence under Congo red staining." },
            { q: "Rare systemic disorder presenting with Polyneuropathy, Organomegaly, Endocrinology abnormalities, Monoclonal plasma cell proliferative disorder, and Skin changes?", a: "POEMS syndrome." },
            { q: "Class-specific, long-term, life-threatening organ toxicity associated with the cumulative use of Anthracyclines like Doxorubicin?", a: "Dilated cardiomyopathy due to iron-dependent free radical generation." },
            { q: "Cardioprotective chelating agent administered alongside Doxorubicin to mitigate the risk of anthracycline-induced cardiomyopathy?", a: "Dexrazoxane." },
            { q: "Distinctive pulmonary toxic side effect characteristically associated with Bleomycin therapy requiring serial DLCO monitoring?", a: "Pulmonary fibrosis. Bone Marrow Microenvironment and Non-Malignant Pancytopenias" },
            { q: "Key stromal-derived cytokine essential for the survival, homing, and differentiation of early hematopoietic stem cells?", a: "Stem Cell Factor (SCF)." },
            { q: "Specialized microenvironmental structures in the bone marrow where erythroblast maturation and iron transfer occur around a central macrophage?", a: "Erythroblastic islands." },
            { q: "Autosomal dominant pure red cell aplasia linked to ribosomal protein gene mutations ($RPS19$) presenting in infancy?", a: "Diamond-Blackfan Anemia." },
            { q: "Distinctive physical exam sign on the hands that differentiates Diamond-Blackfan Anemia from Fanconi Anemia?", a: "Triphalangeal thumbs in Diamond-Blackfan; absent or hypoplastic thumbs and radii in Fanconi." },
            { q: "Acquired pure red cell aplasia (PRCA) in adults is classically associated with what encapsulated anterior mediastinal tumor?", a: "Thymoma." },
            { q: "Rare, inherited normocytic anemia characterized by multinucleated erythroblasts, nuclear bridging, and a positive acidified serum lysis (Ham) test?", a: "Congenital Dyserythropoietic Anemia (CDA). Hemoglobinopathies: Structural Variants and Technical Testing" },
            { q: "Structural hemoglobin variant that defines Hemoglobin C disease?", a: "Lysine substitution for glutamic acid at position 6 of the beta-globin chain." },
            { q: "Classic morphology of erythrocytes on a peripheral blood smear from a patient with homozygous Hemoglobin CC disease?", a: "Hexagonal, rod-shaped intracellular HbC crystals and target cells." },
            { q: "Structural variant where glutamic acid is replaced by lysine at position 26 of the beta-globin chain, highly prevalent in Southeast Asia?", a: "Hemoglobin E ($HbE$)." },
            { q: "Underlying genetic mechanism responsible for the vast majority of Alpha-Thalassemia cases?", a: "Large structural gene deletions via unequal chromosomal crossing over." },
            { q: "Underlying genetic mechanism responsible for the vast majority of Beta-Thalassemia cases?", a: "Point mutations affecting globin mRNA splicing, promoter regions, or translation termination." },
            { q: "Normal minor adult hemoglobin variant formed by two alpha chains and two delta chains ($\\alpha_2\\delta_2$)?", a: "Hemoglobin $A_2$ ($HbA_2$)." },
            { q: "Definitive quantitative assay used to precisely measure and monitor Hemoglobin S levels in sickle cell patients undergoing exchange transfusion?", a: "High-Performance Liquid Chromatography (HPLC). Immune and Non-Immune Hemolytic Footprints" },
            { q: "Humanized monoclonal antibody targeting complement component C5 used to treat Paroxysmal Nocturnal Hemoglobinuria and atypical HUS?", a: "Eculizumab." },
            { q: "Physical footprint of intravascular hemolysis measured via a marked decrease in which specific serum transport protein?", a: "Haptoglobin." },
            { q: "Oxidation product of hemoglobin breakdown that accumulates in the renal tubules and urine during sustained, severe intravascular hemolysis?", a: "Hemosiderin (Hemosiderinuria)." },
            { q: "Protozoal intraerythrocytic infection that mimics G6PD deficiency by inducing hemolytic anemia and forming \"Maltese cross\" tetrads on a thick smear?", a: "Babesiosis." },
            { q: "Metabolic pathway in which Glucose-6-Phosphate Dehydrogenase (G6PD) operates to protect RBCs from oxidative stress?", a: "Hexose monophosphate (HMP) shunt." },
            { q: "Diagnostic pitfall when testing G6PD enzyme activity levels immediately after an acute hemolytic crisis?", a: "False-negative result due to the destruction of older, enzyme-deficient RBCs and a high concentration of young, enzyme-replete reticulocytes. Secondary Myeloproliferative States and Reactive Changes" },
            { q: "Principal bone marrow cytokine responsible for driving the extensive reactive collagen fibrosis in Primary Myelofibrosis?", a: "Transforming Growth Factor-beta (TGF-$\\beta$) released from clonal megakaryocytes." },
            { q: "Name given to the dry tap bone marrow aspiration attempt classic in both Primary Myelofibrosis and Hairy Cell Leukemia?", a: "Punctio sicca." },
            { q: "Most common physiological cause of a secondary polycythemia presenting with elevated erythropoietin (EPO) levels?", a: "Chronic hypoxemia due to severe lung disease, sleep apnea, high altitude, or right-to-left shunts." },
            { q: "Paraneoplastic condition where a renal cell carcinoma or cerebellar hemangioblastoma causes erythrocytosis?", a: "Inappropriate secondary polycythemia via autonomous EPO production." },
            { q: "Pathophysiological driver of erythromelalgia presenting as burning pain and erythema in the extremities of patients with Essential Thrombocythemia?", a: "Platelet microvascular occlusion and subsequent localized endothelial inflammation." },
            { q: "Expected Leukocyte Alkaline Phosphatase (LAP) score trend in Chronic Myeloid Leukemia versus a benign Leukemoid Reaction?", a: "Decreased or absent in CML; significantly elevated in a Leukemoid Reaction. ===================================================================== ===================================================================== Section: Internal Medicine" }
          ]
        },
        {
          section: 'Internal Medicine',
          topic: "Infectious Disease — Sepsis, HIV, fungal & parasitic infections",
          icon: 'shield-alert',
          cards: [
            { q: "First-line empiric treatment for native valve infective endocarditis?", a: "Vancomycin plus Ceftriaxone." },
            { q: "Most common causative organism of acute infective endocarditis in IV drug users?", a: "Staphylococcus aureus." },
            { q: "Classic valvular pathology seen in intravenous drug users with endocarditis?", a: "Tricuspid regurgitation." },
            { q: "Mechanism of action of Vancomycin?", a: "Inhibits bacterial cell wall synthesis by binding to the D-Ala-D-Ala terminus of peptidoglycan precursors." },
            { q: "Mechanism of action of Daptomycin?", a: "Disrupts cell membrane function by creating transmembrane channels causing intracellular ion leakage." },
            { q: "Major adverse effect of Daptomycin that requires weekly monitoring?", a: "Myopathy and elevated Creatine Kinase (CK) levels." },
            { q: "Why is Daptomycin ineffective in treating bacterial pneumonia?", a: "It is inactivated by pulmonary surfactant." },
            { q: "Empiric treatment for a patient with suspected bacterial meningitis aged 2 to 50 years?", a: "Vancomycin plus a third-generation cephalosporin (Ceftriaxone or Cefotaxime)." },
            { q: "Crucial antibiotic addition to empiric meningitis treatment for patients over 50 or immunocompromised?", a: "Ampicillin." },
            { q: "Why is Ampicillin added to empiric meningitis regimens in older or vulnerable adults?", a: "To cover Listeria monocytogenes." },
            { q: "Which adjunctive medication should be given prior to or with the first dose of antibiotics in pneumococcal meningitis?", a: "Dexamethasone." },
            { q: "Most common cause of community-acquired pneumonia (CAP) across all age groups?", a: "Streptococcus pneumoniae." },
            { q: "Empirical outpatient treatment for a healthy adult with Community-Acquired Pneumonia and no comorbidities?", a: "Amoxicillin, Doxycycline, or a Macrolide (if local resistance is <25%)." },
            { q: "Empirical inpatient (non-ICU) treatment for Community-Acquired Pneumonia?", a: "A respiratory fluoroquinolone (e.g., Levofloxacin) OR a beta-lactam plus a macrolide." },
            { q: "Drug of choice for treating severe Clostridioides difficile infection?", a: "Oral Vancomycin or Fidaxomicin. HIV, Opportunistic Infections, and Prophylaxis" },
            { q: "CD4 count threshold below which prophylaxis for Pneumocystis jirovecii pneumonia (PJP) is indicated?", a: "<200 cells/mm³." },
            { q: "First-line agent used for Pneumocystis jirovecii pneumonia (PJP) prophylaxis?", a: "Trimethoprim-Sulfamethoxazole (TMP-SMX)." },
            { q: "CD4 count threshold below which prophylaxis for Toxoplasma gondii is indicated in seropositive patients?", a: "<100 cells/mm³." },
            { q: "Medication used for Toxoplasma gondii prophylaxis?", a: "Trimethoprim-Sulfamethoxazole (TMP-SMX)." },
            { q: "Diagnostic finding on a brain MRI for an HIV patient with Toxoplasma gondii encephalitis?", a: "Multiple ring-enhancing lesions with a preference for the basal ganglia." },
            { q: "Preferred treatment for active Toxoplasma encephalitis?", a: "Pyrimethamine plus Sulfadiazine (plus Leucovorin)." },
            { q: "Opportunistic infection causing painful, linear esophageal ulcers in an HIV patient?", a: "Cytomegalovirus (CMV)." },
            { q: "Opportunistic infection causing round, punched-out esophageal ulcers in an HIV patient?", a: "Herpes Simplex Virus 1 (HSV-1)." },
            { q: "Diagnostic finding on a fundoscopic exam for Cytomegalovirus (CMV) retinitis?", a: "Pizzalike retinopathy showing perivascular hemorrhages and fluffy white exudates." },
            { q: "First-line treatment for Cytomegalovirus (CMV) retinitis?", a: "Ganciclovir or Valganciclovir." },
            { q: "CD4 count threshold below which primary prophylaxis for Mycobacterium avium complex (MAC) was historically indicated (no longer routinely required if ART is started immediately)?", a: "<50 cells/mm³." },
            { q: "Preferred treatment for an active Mycobacterium avium complex (MAC) infection?", a: "Azithromycin or Clarithromycin combined with Ethambutol." },
            { q: "Most common central nervous system fungal infection in HIV patients?", a: "Cryptococcal meningitis." },
            { q: "Initial diagnostic test visualizing encapsulated yeasts in cerebrospinal fluid via negative staining?", a: "India ink preparation." },
            { q: "Most sensitive and specific rapid diagnostic test for Cryptococcal meningitis?", a: "Cryptococcal antigen (CrAg) lateral flow assay." },
            { q: "Induction therapy regimen for Cryptococcal meningitis?", a: "Liposomal Amphotericin B plus Flucytosine." },
            { q: "Maintenance therapy agent for Cryptococcal meningitis after induction?", a: "Fluconazole." },
            { q: "Form of skin lesion associated with Human Herpesvirus 8 (HHV-8) in HIV patients?", a: "Kaposi sarcoma. Tick-Borne and Zoonotic Diseases" },
            { q: "Causative organism of Lyme disease?", a: "Borrelia burgdorferi." },
            { q: "Classic initial dermatological presentation of Lyme disease?", a: "Erythema migrans (bull's-eye rash)." },
            { q: "Vector responsible for transmitting Lyme disease and Anaplasmosis?", a: "Ixodes tick." },
            { q: "First-line oral antibiotic for early localized Lyme disease in adults?", a: "Doxycycline." },
            { q: "Preferred antibiotic for Lyme disease in pregnant patients or children under 8?", a: "Amoxicillin." },
            { q: "Manifestation of late disseminated Lyme disease involving the joints?", a: "Asymmetric monoarticular or oligoarticular arthritis, usually affecting the knee." },
            { q: "Causative organism of Rocky Mountain Spotted Fever (RMSF)?", a: "Rickettsia rickettsii." },
            { q: "Classic progression of the rash in Rocky Mountain Spotted Fever?", a: "Starts on the wrists and ankles and spreads centripetally to the trunk, palms, and soles." },
            { q: "Drug of choice for Rocky Mountain Spotted Fever in ALL patients, including children and pregnant women?", a: "Doxycycline." },
            { q: "Tick-borne disease characterized by hemolytic anemia, jaundice, and a Maltese cross appearance on blood smear?", a: "Babesiosis." },
            { q: "Vector for Babesia microti?", a: "Ixodes tick." },
            { q: "First-line antimicrobial combination for mild-to-moderate Babesiosis?", a: "Atovaquone plus Azithromycin." },
            { q: "Tick-borne illness characterized by leukopenia, thrombocytopenia, elevated liver enzymes, and morulae inside monocytes?", a: "Human Monocytic Ehrlichiosis (HME). Tuberculosis & Mycobacterial Diseases" },
            { q: "Standard 4-drug regimen for initial treatment of active Tuberculosis (TB)?", a: "Rifampin, Isoniazid, Pyrazinamide, and Ethambutol (RIPE)." },
            { q: "Mechanism of action of Isoniazid?", a: "Inhibits the synthesis of mycolic acids, an essential component of the mycobacterial cell wall." },
            { q: "Common adverse effect of Isoniazid preventable by co-administering Vitamin B6 (Pyridoxine)?", a: "Peripheral neuropathy." },
            { q: "Mechanism of action of Rifampin?", a: "Inhibits bacterial DNA-dependent RNA polymerase." },
            { q: "Benign, classic side effect of Rifampin that patients must be counseled on?", a: "Red-orange discoloration of bodily fluids (urine, tears, sweat)." },
            { q: "Unique toxic side effect of Ethambutol requiring baseline and periodic visual testing?", a: "Optic neuritis (reversible red-green color blindness and decreased visual acuity)." },
            { q: "Major metabolic side effect associated with Pyrazinamide?", a: "Hyperuricemia (which can precipitate acute gouty arthritis)." },
            { q: "Screening test cut-off for a positive Tuberculin Skin Test (TST) in a healthcare worker with no other risk factors?", a: "$\\ge 10\\text{ mm}$ of induration." },
            { q: "Screening test cut-off for a positive Tuberculin Skin Test (TST) in an HIV-infected or severely immunosuppressed patient?", a: "$\\ge 5\\text{ mm}$ of induration." },
            { q: "Screening test cut-off for a positive Tuberculin Skin Test (TST) in a person with no known risk factors for TB?", a: "$\\ge 15\\text{ mm}$ of induration." },
            { q: "Preferred preferred regimen for treating Latent Tuberculosis Infection (LTBI) to optimize compliance?", a: "3 months of weekly Isoniazid plus Rifapentine OR 4 months of daily Rifampin. Sexually Transmitted Infections (STIs)" },
            { q: "Causative organism of Syphilis?", a: "Treponema pallidum." },
            { q: "Classic presentation of primary Syphilis?", a: "A single, painless ulcer (chancre) with clean bases and indurated margins." },
            { q: "Clinical features characteristic of secondary Syphilis?", a: "Maculopapular rash on palms and soles, lymphadenopathy, and condylomata lata." },
            { q: "Screening (nontreponemal) serologic tests for Syphilis?", a: "VDRL (Venercal Disease Research Laboratory) and RPR (Rapid Plasma Reagin)." },
            { q: "Confirmatory (treponemal) serologic tests for Syphilis?", a: "FTA-ABS (Fluorescent Treponemal Antibody Absorption) and TP-PA (Treponema pallidum particle agglutination)." },
            { q: "Treatment of choice for primary, secondary, or early latent Syphilis?", a: "A single intramuscular dose of Benzathine Penicillin G ($2.4\\text{ million units}$)." },
            { q: "Acute febrile reaction accompanied by headache and myalgias that can occur within 24 hours of starting penicillin for syphilis?", a: "Jarisch-Herxheimer reaction." },
            { q: "Preferred treatment for Neurosyphilis?", a: "Intravenous Aqueous Crystalline Penicillin G for 10 to 14 days." },
            { q: "Painful, friable genital ulcer accompanied by painful, suppurative inguinal lymphadenopathy (buboes)?", a: "Chancroid (caused by Haemophilus ducreyi)." },
            { q: "First-line empirical treatment for uncomplicated urogenital Chlamydia trachomatis infection?", a: "Doxycycline ($100\\text{ mg}$ orally twice daily for 7 days)." },
            { q: "First-line empirical treatment for uncomplicated Gonococcal urethritis?", a: "A single intramuscular dose of Ceftriaxone ($500\\text{ mg}$)." },
            { q: "Diagnostic finding on a wet mount for Trichomonas vaginalis?", a: "Motile, flagellated trichomonads." },
            { q: "First-line treatment for both the patient and sexual partner in a Trichomonas vaginalis infection?", a: "Oral Metronidazole. Systemic Mycoses and Fungal Infections" },
            { q: "Fungal infection endemic to the Ohio and Mississippi River valleys, associated with bird or bat droppings?", a: "Histoplasmosis (Histoplasma capsulatum)." },
            { q: "Diagnostic tissue finding for Histoplasma capsulatum?", a: "Small intracellular yeasts within macrophages." },
            { q: "Fungal infection endemic to the Southwestern United States, presenting with valley fever (fever, arthralgias, erythema nodosum)?", a: "Coccidioidomycosis (Coccidioides immitis)." },
            { q: "Diagnostic tissue finding for Coccidioides immitis?", a: "Large spherules filled with endospores." },
            { q: "Fungal infection endemic to the Great Lakes and Ohio River valley, causing inflammatory cutaneous and osteolytic lesions?", a: "Blastomycosis (Blastomyces dermatitidis)." },
            { q: "Diagnostic tissue finding for Blastomyces dermatitidis?", a: "Large, round yeasts with broad-based budding." },
            { q: "First-line treatment for mild-to-moderate localized systemic fungal infections (e.g., Histoplasmosis, Blastomycosis)?", a: "Itraconazole." },
            { q: "First-line treatment for severe, disseminated systemic fungal infections?", a: "Amphotericin B." },
            { q: "Invasive fungal infection causing rapidly progressive paranasal sinus necrosis in a patient with diabetic ketoacidosis (DKA)?", a: "Mucormycosis (caused by Mucor or Rhizopus species)." },
            { q: "Microscopic appearance of Mucor or Rhizopus hyphae in tissue biopsy?", a: "Broad, nonseptate hyphae branching at right ($90^\\circ$) angles." },
            { q: "Microscopic appearance of Aspergillus fumigatus hyphae?", a: "Septate hyphae branching at acute ($45^\\circ$) angles. Gastrointestinal and Intra-abdominal Infections" },
            { q: "Most common bacterial cause of bloody diarrhea (dysentery) in the United States, associated with poultry?", a: "Campylobacter jejuni." },
            { q: "Complication of Campylobacter jejuni infection presenting as ascending paralysis?", a: "Guillain-Barré syndrome." },
            { q: "Gram stain morphology of Campylobacter jejuni?", a: "Comma- or S-shaped Gram-negative rod with polar flagella." },
            { q: "Bacterial diarrheal pathogen associated with undercooked ground beef and Hemolytic Uremic Syndrome (HUS)?", a: "Enterohemorrhagic Escherichia coli (EHEC), specifically O157:H7." },
            { q: "Why are antibiotics contraindicated in children suspected of having EHEC O157:H7 infection?", a: "They increase the release of Shiga toxin, raising the risk of Hemolytic Uremic Syndrome (HUS)." },
            { q: "Triad of signs defining Hemolytic Uremic Syndrome (HUS)?", a: "Microangiopathic hemolytic anemia, thrombocytopenia, and acute kidney injury." },
            { q: "Protozoan parasite causing foul-smelling, fatty diarrhea (steatorrhea) after drinking water from mountain streams?", a: "Giardia lamblia." },
            { q: "Treatment of choice for Giardiasis?", a: "Tinidazole or Metronidazole." },
            { q: "Empiric antibiotic regimen for acute diverticulitis?", a: "Ciprofloxacin plus Metronidazole OR Amoxicillin-Clavulanate monotherapy." },
            { q: "Most common cause of spontaneous bacterial peritonitis (SBP) in cirrhotic patients?", a: "Escherichia coli." },
            { q: "Diagnostic threshold of polymorphonuclear leukocytes (PMNs) in ascitic fluid to confirm spontaneous bacterial peritonitis?", a: "$\\ge 250\\text{ cells/mm}^3$." },
            { q: "First-line antibiotic choice for Spontaneous Bacterial Peritonitis?", a: "A third-generation cephalosporin (e.g., Cefotaxime or Ceftriaxone). Urinary Tract and Soft Tissue Infections" },
            { q: "Most common causative organism of uncomplicated Urinary Tract Infections (UTIs)?", a: "Escherichia coli." },
            { q: "First-line antibiotic options for acute uncomplicated cystitis in women?", a: "Nitrofurantoin, Trimethoprim-Sulfamethoxazole (TMP-SMX), or Fosfomycin." },
            { q: "First-line empiric treatment for outpatient acute uncomplicated pyelonephritis?", a: "Oral Fluoroquinolones (e.g., Ciprofloxacin or Levofloxacin)." },
            { q: "Soft tissue infection characterized by painful, well-demarcated, bright red erythema of the superficial dermis, often on the face?", a: "Erysipelas (most commonly caused by Streptococcus pyogenes)." },
            { q: "Soft tissue infection presenting as ill-defined, flat, warm erythema of the deeper dermis and subcutaneous tissue?", a: "Cellulitis (commonly caused by Streptococcus pyogenes or Staphylococcus aureus)." },
            { q: "Surgical emergency presenting with soft tissue swelling, severe pain out of proportion to exam findings, and gas (crepitus) on X-ray?", a: "Necrotizing fasciitis. Zoonotic and Miscellaneous Bacterial Infections" },
            { q: "Causative organism of Cat Scratch Disease?", a: "Bartonella henselae." },
            { q: "First-line antibiotic therapy to shorten the duration of painful lymphadenopathy in Cat Scratch Disease?", a: "Azithromycin." },
            { q: "Causative agent of Q fever, typically transmitted via inhalation of aerosols from farm animal amniotic fluid?", a: "Coxiella burnetii." },
            { q: "Classic clinical presentation of acute Q fever?", a: "Culture-negative endocarditis, severe flu-like symptoms, and hepatitis or atypical pneumonia." },
            { q: "Causative agent of Brucellosis, acquired via unpasteurized dairy products?", a: "Brucella species." },
            { q: "Standard antibiotic regimen for treating Brucellosis?", a: "Doxycycline plus Rifampin." },
            { q: "Causative organism of Tularemia, associated with handling infected rabbits or tick bites?", a: "Francisella tularensis." },
            { q: "First-line antibiotic treatment for severe Francisella tularensis (Tularemia) infection?", a: "Streptomycin or Gentamicin." },
            { q: "Causative organism of Pasteurellosis, following a domestic dog or cat bite?", a: "Pasteurella multocida." },
            { q: "Prophylactic and definitive first-line oral antibiotic for mammalian bite wounds?", a: "Amoxicillin-Clavulanate. Viral Pathogens and Vaccines" },
            { q: "Causative virus of Infectious Mononucleosis?", a: "Epstein-Barr Virus (EBV)." },
            { q: "Diagnostic test that detects heterophile antibodies in patients with suspected EBV?", a: "Monospot test." },
            { q: "Classic adverse drug reaction seen when treating a patient who has EBV mononucleosis with Amoxicillin?", a: "A diffuse maculopapular rash." },
            { q: "Serious splenic complication of Infectious Mononucleosis requiring avoidance of contact sports for at least 3-4 weeks?", a: "Splenic rupture." },
            { q: "Preferred antiviral drug used to treat severe Influenza infections within 48 hours of symptom onset?", a: "Oseltamivir." },
            { q: "Antiviral mechanism of action of Oseltamivir?", a: "Inhibits neuraminidase, preventing the release of new viral particles from host cells." },
            { q: "First-line treatment for chronic Hepatitis C infection across major genotypes?", a: "Direct-acting antivirals (DAAs) such as Sofosbuvir/Velpatasvir." },
            { q: "Post-exposure prophylaxis regimen for an unvaccinated individual exposed to Hepatitis B?", a: "Hepatitis B vaccine series plus Hepatitis B Immune Globulin (HBIG)." },
            { q: "Post-exposure prophylaxis protocol for a person bitten by a wild, potentially rabid animal?", a: "Rabies vaccine series (days 0, 3, 7, 14) plus Rabies Immune Globulin (RIG) infiltrated around the wound. Sepsis and Healthcare-Associated Infections" },
            { q: "Definition of Sepsis according to Sepsis-3 guidelines?", a: "Life-threatening organ dysfunction caused by a dysregulated host response to infection." },
            { q: "Clinical scoring system used to identify worsening organ dysfunction in the intensive care unit?", a: "Sequential Organ Failure Assessment (SOFA) score." },
            { q: "Definition of Septic Shock according to Sepsis-3 guidelines?", a: "Sepsis requiring vasopressors to maintain a mean arterial pressure (MAP) $\\ge 65\\text{ mmHg}$ and serum lactate $>2\\text{ mmol/L}$ despite adequate fluid resuscitation." },
            { q: "First-line vasopressor of choice for fluid-refractory septic shock?", a: "Norepinephrine." },
            { q: "Initial fluid resuscitation volume recommended for patients with sepsis-induced tissue hypoperfusion?", a: "$30\\text{ mL/kg}$ of intravenous crystalloids within the first 3 hours." },
            { q: "Most common source of bacteremia leading to healthcare-associated infections?", a: "Central venous catheters." },
            { q: "Diagnostic action required when a central venous catheter-associated bloodstream infection is suspected?", a: "Draw simultaneous blood cultures from both the catheter lumen and a peripheral vein. Parasitic and Helminthic Infections" },
            { q: "Vector responsible for transmitting Malaria (Plasmodium species)?", a: "Female Anopheles mosquito." },
            { q: "Gold standard diagnostic test for confirming Malaria and determining parasitemia levels?", a: "Thick and thin microscopic blood smears." },
            { q: "First-line agent for treating uncomplicated chloroquine-resistant Plasmodium falciparum malaria?", a: "Artemether-Lumefantrine OR Atovaquone-Proguanil." },
            { q: "Medication added to eradicate hypnozoites in latent hepatic phases of Plasmodium vivax and Plasmodium ovale?", a: "Primaquine." },
            { q: "Vital pre-screening requirement before initiating Primaquine therapy?", a: "Glucose-6-Phosphate Dehydrogenase (G6PD) activity assay to avoid severe hemolysis." },
            { q: "Parasitic infection causing perianal pruritus, diagnosed via the cellophane tape test?", a: "Enterobiasis (Pinworm infection, caused by Enterobius vermicularis)." },
            { q: "Drug of choice for treating Enterobius vermicularis (Pinworm) infections?", a: "Pyrantel pamoate or Albendazole." },
            { q: "Parasitic tissue infection caused by ingesting undercooked pork containing cysts, presenting with periorbital edema, myalgias, and eosinophilia?", a: "Trichinellosis (Trichinella spiralis)." },
            { q: "Treatment of choice for tissue microfilariae in Onchocerciasis (River Blindness)?", a: "Ivermectin." },
            { q: "Treatment of choice for Neurocysticercosis?", a: "Albendazole plus corticosteroids (e.g., Dexamethasone). Bioterrorism & Rare Pathogens" },
            { q: "Initial diagnostic test of choice for a patient presenting with a painless cutaneous black eschar surrounded by extensive edema?", a: "Gram stain and culture of the skin lesion to evaluate for Bacillus anthracis." },
            { q: "First-line antimicrobial treatment for naturally acquired or inhalational Anthrax?", a: "Ciprofloxacin or Doxycycline (combined with an antitoxin for systemic disease)." },
            { q: "Flaccid, descending paralysis beginning with cranial nerve palsies after consuming home-canned foods?", a: "Botulism (caused by Clostridium botulinum toxin)." },
            { q: "Mechanism of action of the Botulinum neurotoxin?", a: "Cleaves SNARE proteins, preventing the presynaptic release of Acetylcholine at the neuromuscular junction." },
            { q: "Treatment for foodborne Botulism in adults?", a: "Equine-derived heptavalent botulinum antitoxin." },
            { q: "Treatment for infant Botulism caused by ingestion of Clostridium botulinum spores (e.g., from honey)?", a: "Human-derived botulinum immune globulin (BabyBIG). Specific Exposure & Environmental Associations" },
            { q: "Prophylactic antibiotic regimen for a patient who sustained a puncture wound through the sole of a sneaker?", a: "Ciprofloxacin (to cover Pseudomonas aeruginosa)." },
            { q: "Organism responsible for a rapidly progressive, necrotizing soft-tissue infection after exposure to warm seawater or raw oysters in a patient with chronic liver disease?", a: "Vibrio vulnificus." },
            { q: "First-line treatment for a systemic or necrotizing Vibrio vulnificus infection?", a: "Doxycycline plus a third-generation cephalosporin (e.g., Ceftriaxone)." },
            { q: "Causative organism of a localized cutaneous ulcer with painful regional lymphadenopathy following a scratch from a wild rabbit?", a: "Francisella tularensis." },
            { q: "Flu-like illness with severe calf muscle tenderness, conjunctival suffusion, and jaundice after swimming in water contaminated with animal urine?", a: "Leptospirosis (caused by Leptospira interrogans)." },
            { q: "Classic clinical triad of severe Leptospirosis (Weil disease)?", a: "Jaundice, acute kidney injury, and hemorrhage. Infection Control & Isolation Precautions" },
            { q: "Type of isolation precaution required for a patient with active Pulmonary Tuberculosis?", a: "Airborne precautions (requires an airborne infection isolation room [AIIR] and N95 respirator)." },
            { q: "Type of isolation precaution required for a patient with Clostridioides difficile infection?", a: "Contact precautions (requires gowns, gloves, and mandatory handwashing with soap and water instead of alcohol gel)." },
            { q: "Type of isolation precaution required for a patient with Neisseria meningitidis meningitis?", a: "Droplet precautions (requires a surgical mask for healthcare providers; can be discontinued after 24 hours of effective antibiotic therapy)." },
            { q: "Type of isolation precaution required for a patient with disseminated Herpes Zoster (shingles)?", a: "Airborne and Contact precautions. Surgical Prophylaxis & Medical Conditions" },
            { q: "Standard timing for the administration of pre-operative prophylactic antibiotics to maximize tissue concentration?", a: "Within 60 minutes prior to the surgical incision." },
            { q: "Preferred first-line antibiotic for routine surgical prophylaxis in clean procedures (e.g., orthopedic joint replacement)?", a: "Cefazolin." },
            { q: "Empiric prophylactic antibiotic added to surgical regimens involving the colorectal tract to cover anaerobes?", a: "Cefoxitin, Cefotetan, or Cefazolin plus Metronidazole." },
            { q: "Empiric antimicrobial management for a patient presenting with febrile neutropenia (Absolute Neutrophil Count $<500/\\mu\\text{L}$)?", a: "Monotherapy with an antipseudomonal beta-lactam (e.g., Piperacillin-Tazobactam, Cefepime, or Meropenem)." },
            { q: "Target window to administer post-exposure prophylaxis (PEP) after an occupational needle-stick exposure to HIV?", a: "Ideally within 2 hours, and no later than 72 hours after exposure." },
            { q: "Standard duration of antiretroviral therapy for HIV post-exposure prophylaxis (PEP)?", a: "28 days." },
            { q: "Standard three-drug regimen used for HIV post-exposure prophylaxis (PEP)?", a: "Tenofovir, Emtricitabine, and an integrase strand transfer inhibitor (e.g., Dolutegravir or Raltegravir). Central Nervous System & Head/Neck Extensions" },
            { q: "Organism causing a rapidly fatal meningoencephalitis in a healthy individual with a recent history of swimming in warm, fresh water?", a: "Naegleria fowleri." },
            { q: "Diagnostic finding on a wet mount of cerebrospinal fluid in a patient with Naegleria fowleri infection?", a: "Motile, trophozoite amebae." },
            { q: "Severe, painful otitis externa with granulation tissue at the floor of the ear canal in an elderly diabetic patient?", a: "Malignant Otitis Externa." },
            { q: "Most common causative pathogen of Malignant Otitis Externa?", a: "Pseudomonas aeruginosa." },
            { q: "Preferred first-line intravenous antibiotic therapy for Malignant Otitis Externa?", a: "Ciprofloxacin or Cefepime." },
            { q: "Rapidly progressive, bilateral cellulitis of the submandibular and sublingual spaces, typically originating from an infected mandibular molar?", a: "Ludwig angina." },
            { q: "Primary immediate clinical priority in managing a patient with Ludwig angina?", a: "Secure and maintain a patent airway. Endocarditis & Vascular Additions" },
            { q: "Culture-negative infective endocarditis organism associated with poor dental hygiene or periodontal disease?", a: "Eikenella corrodens (part of the HACEK group)." },
            { q: "Culture-negative infective endocarditis organism associated with exposure to farm animals and presenting as a chronic, indolent infection?", a: "Coxiella burnetii." },
            { q: "Most common causative organism of prosthetic valve endocarditis within the first year after valve replacement surgery?", a: "Staphylococcus epidermidis." },
            { q: "Classic immunologically mediated physical exam finding in infective endocarditis presenting as painful nodules on the pads of fingers or toes?", a: "Osler nodes." },
            { q: "Classic physical exam finding in infective endocarditis presenting as painless, erythematous macules on the palms or soles?", a: "Janeway lesions." },
            { q: "Diagnostic criteria schema used to establish a clinical diagnosis of Infective Endocarditis?", a: "Modified Duke Criteria. Travel Medicine & Prophylaxis" },
            { q: "Preferred malaria chemoprophylaxis regimen for a pregnant traveler visiting a chloroquine-resistant region?", a: "Mefloquine." },
            { q: "Malaria chemoprophylaxis agent that must be started 1 to 2 weeks before travel and continued for 4 weeks after returning?", a: "Mefloquine or Doxycycline." },
            { q: "Malaria chemoprophylaxis agent that can be started 1 to 2 days before travel and stopped 7 days after returning?", a: "Atovaquone-Proguanil." },
            { q: "Live-attenuated vaccine required for entry into certain sub-Saharan African and South American countries, documented via an International Certificate of Vaccination?", a: "Yellow Fever vaccine." },
            { q: "Most common bacterial cause of traveler's diarrhea?", a: "Enterotoxigenic Escherichia coli (ETEC)." },
            { q: "First-line antibiotic choice for empirical self-treatment of severe traveler's diarrhea accompanied by high fever or systemic symptoms?", a: "Azithromycin or a fluoroquinolone (e.g., Ciprofloxacin). High-Yield Antibiotic Toxicities & Crossover Interactions" },
            { q: "Antibiotic class classic for causing tendonitis and Achilles tendon rupture, particularly in elderly patients or those taking glucocorticoids?", a: "Fluoroquinolones." },
            { q: "Antibiotic known to cause serotonin syndrome when co-administered with selective serotonin reuptake inhibitors (SSRIs) due to its weak monoamine oxidase inhibitor (MAOI) activity?", a: "Linezolid." },
            { q: "Reversible hematologic adverse effect associated with prolonged ($>2$ weeks) Linezolid therapy?", a: "Bone marrow suppression, most commonly presenting as thrombocytopenia." },
            { q: "Classic electrolyte abnormality associated with high-dose Trimethoprim-Sulfamethoxazole (TMP-SMX) administration?", a: "Hyperkalemia (due to trimethoprim blocking sodium channels in the distal nephron)." },
            { q: "Antimicrobial agent associated with a disulfiram-like reaction (flushing, tachycardia, nausea) when consumed with alcohol?", a: "Metronidazole." },
            { q: "Class of antibiotics that carries a small risk of cross-reactivity in patients with a confirmed, IgE-mediated anaphylactic allergy to penicillins?", a: "Cephalosporins (specifically first-generation agents). Adult Immunizations & Special Populations" },
            { q: "Pneumococcal vaccination strategy recommended for all immunocompetent adults aged 65 years or older who have never received a pneumococcal vaccine?", a: "A single dose of PCV20 OR a single dose of PCV15 followed by PPSV23 one year later." },
            { q: "Vaccine recommended for all pregnant individuals during weeks 27 through 36 of each pregnancy to provide passive immunity to the neonate?", a: "Tdap (Tetanus, Diphtheria, Acellular Pertussis)." },
            { q: "Age at which the recombinant Zoster vaccine (Shingrix) is routinely recommended for immunocompetent adults to prevent shingles?", a: "50 years and older (administered as a 2-dose series)." },
            { q: "Two core vaccinations that must be administered to patients prior to undergoing an elective splenectomy?", a: "Meningococcal conjugate and Pneumococcal vaccines (along with Haemophilus influenzae type b). Fever of Unknown Origin & Culture-Negative Entities" },
            { q: "Classic definition of Fever of Unknown Origin (FUO) in an outpatient setting?", a: "Fever $\\ge 38.3^\\circ\\text{C}$ ($101^\\circ\\text{F}$) on several occasions lasting for at least 3 weeks with no diagnosis after 3 days of in-hospital investigation or 3 outpatient visits." },
            { q: "Most common overall category of diseases responsible for Fever of Unknown Origin in adults?", a: "Infections (followed closely by malignancies and non-infectious inflammatory diseases)." },
            { q: "Zoonotic bacterial cause of culture-negative endocarditis or FUO associated with consuming unpasteurized goat cheese?", a: "Brucella melitensis." },
            { q: "Systemic infectious disease caused by Tropheryma whipplei, presenting with arthralgias, weight loss, chronic diarrhea, and hyperpigmentation?", a: "Whipple disease." },
            { q: "Classic diagnostic finding on a small bowel biopsy for a patient with Whipple disease?", a: "Periodic acid–Schiff (PAS)-positive macrophages containing rod-shaped bacilli. ===================================================================== ===================================================================== Section: Internal Medicine" }
          ]
        },
        {
          section: 'Internal Medicine',
          topic: "Rheumatology — SLE, RA, vasculitis, crystal arthropathies",
          icon: 'activity',
          cards: [
            { q: "Initial diagnostic imaging of choice for a patient suspected of having Rheumatoid Arthritis?", a: "Bilateral hand and wrist radiographs." },
            { q: "Earliest radiographic finding seen in early Rheumatoid Arthritis?", a: "Periarticular osteopenia and soft tissue swelling." },
            { q: "Definitive late-stage radiographic features pathognomonic for Rheumatoid Arthritis?", a: "Marginal joint erosions and joint space narrowing." },
            { q: "Most specific autoantibody for diagnosing Rheumatoid Arthritis?", a: "Anti-Cyclic Citrullinated Peptide (anti-CCP) antibody." },
            { q: "Joint classification that is characteristically spared in Rheumatoid Arthritis?", a: "Distal Interphalangeal (DIP) joints." },
            { q: "Most common deformity of the thumb seen in advanced Rheumatoid Arthritis?", a: "Boutonniere deformity." },
            { q: "Name of the deformity characterized by PIP hyperextension and DIP flexion?", a: "Swan-neck deformity." },
            { q: "Life-threatening cervical spine complication of Rheumatoid Arthritis that requires screening before elective surgery?", a: "Atlantoaxial subluxation." },
            { q: "First-line disease-modifying antirheumatic drug (DMARD) used for moderate-to-severe Rheumatoid Arthritis?", a: "Methotrexate." },
            { q: "Supplement that must be co-prescribed with Methotrexate to reduce side effects?", a: "Folic acid." },
            { q: "Serious pulmonary complication associated with chronic Methotrexate therapy?", a: "Interstitial lung disease (methotrexate pneumonitis)." },
            { q: "Best initial screening test required before initiating any TNF-alpha inhibitor therapy?", a: "Interferon-gamma release assay (IGRA) or PPD test for latent Tuberculosis." },
            { q: "Triad defining Felty Syndrome?", a: "Rheumatoid Arthritis, splenomegaly, and neutropenia." },
            { q: "Most accurate diagnostic test for Felty Syndrome when presenting with severe neutropenia?", a: "Bone marrow biopsy showing myeloid maturation arrest." },
            { q: "Constellation of symptoms defining Caplan Syndrome?", a: "Rheumatoid Arthritis combined with coal worker's pneumoconiosis. Systemic Lupus Erythematosus (SLE)" },
            { q: "Most sensitive screening autoantibody for Systemic Lupus Erythematosus?", a: "Antinuclear Antibody (ANA)." },
            { q: "Most specific autoantibodies for diagnosing Systemic Lupus Erythematosus?", a: "Anti-double-stranded DNA (anti-dsDNA) and Anti-Smith (anti-Sm) antibodies." },
            { q: "Autoantibody closely correlated with disease activity and lupus nephritis development in SLE?", a: "Anti-double-stranded DNA (anti-dsDNA)." },
            { q: "Autoantibody associated with Drug-Induced Lupus Erythematosus?", a: "Anti-histone antibody." },
            { q: "Top three medications most frequently implicated in Drug-Induced Lupus?", a: "Procainamide, Hydralazine, and Isoniazid." },
            { q: "Classic skin manifestation of SLE triggered or exacerbated by sunlight exposure?", a: "Malar (butterfly) rash sparing the nasolabial folds." },
            { q: "Type of endocarditis characterized by sterile verrucous vegetations on both sides of cardiac valves in SLE patients?", a: "Libman-Sacks endocarditis." },
            { q: "Best initial management for mild systemic manifestations of SLE like arthritis or cutaneous lesions?", a: "Hydroxychloroquine." },
            { q: "Mandatory routine screening test for patients on long-term Hydroxychloroquine therapy?", a: "Annual ophthalmologic exam to screen for retinal toxicity." },
            { q: "Most accurate diagnostic method to confirm and classify Lupus Nephritis?", a: "Renal biopsy." },
            { q: "Standard induction therapy for severe, proliferative Lupus Nephritis (Class III or IV)?", a: "Mycophenolate mofetil or Cyclophosphamide combined with high-dose glucocorticoids." },
            { q: "Serum complement levels characteristically seen during an active SLE flare?", a: "Decreased C3 and C4 levels." },
            { q: "Primary mechanism of anemia commonly seen in active, severe SLE?", a: "Warm Autoimmune Hemolytic Anemia (Coombs-positive)." },
            { q: "Severe, life-threatening complication of systemic juvenile idiopathic arthritis or adult SLE involving massive macrophage activation?", a: "Macrophage Activation Syndrome (MAS)." },
            { q: "Key laboratory hallmarks of Macrophage Activation Syndrome?", a: "Precipitous drop in ESR, skyrocketing Ferritin, cytopenias, and elevated triglycerides. Antiphospholipid Syndrome (APS)" },
            { q: "Paradoxical laboratory finding seen in Antiphospholipid Syndrome despite an increased risk of thrombosis?", a: "Prolonged Activated Partial Thromboplastin Time (aPTT)." },
            { q: "The three diagnostic autoantibodies for Antiphospholipid Syndrome?", a: "Lupus anticoagulant, anti-beta-2-glycoprotein I, and anti-cardiolipin antibodies." },
            { q: "Common false-positive screening result seen in patients with high titers of anti-cardiolipin antibodies?", a: "False-positive VDRL or RPR test for Syphilis." },
            { q: "Preferred long-term anticoagulation therapy for a non-pregnant patient with confirmed Antiphospholipid Syndrome and a history of DVT?", a: "Warfarin." },
            { q: "Target INR range for a patient with Antiphospholipid Syndrome experiencing a first venous thromboembolic event?", a: "INR of 2.0 to 3.0." },
            { q: "Preferred anticoagulation regimen for a pregnant patient with Antiphospholipid Syndrome?", a: "Low-molecular-weight heparin (LMWH) combined with low-dose aspirin." },
            { q: "Rare, life-threatening form of APS causing simultaneous multi-organ microvascular failure?", a: "Catastrophic Antiphospholipid Syndrome (CAPS)." },
            { q: "First-line management triad for Catastrophic Antiphospholipid Syndrome?", a: "High-dose IV glucocorticoids, therapeutic anticoagulation, and plasma exchange or IVIG. Scleroderma (Systemic Sclerosis)" },
            { q: "Autoantibody most specific for Diffuse Cutaneous Systemic Sclerosis?", a: "Anti-Scl-70 (anti-topoisomerase I) antibody." },
            { q: "Autoantibody most specific for Limited Cutaneous Systemic Sclerosis (CREST syndrome)?", a: "Anti-centromere antibody." },
            { q: "The components that comprise the acronym CREST syndrome?", a: "Calcinosis, Raynaud phenomenon, Esophageal dysmotility, Sclerodactyly, and Telangiectasia." },
            { q: "Most common cause of death in patients with Diffuse Cutaneous Systemic Sclerosis?", a: "Interstitial Lung Disease (pulmonary fibrosis)." },
            { q: "Leading vascular cause of death in patients with Limited Cutaneous Systemic Sclerosis?", a: "Pulmonary Arterial Hypertension." },
            { q: "Sudden, life-threatening renal complication of Diffuse Scleroderma presenting with malignant hypertension and microangiopathic hemolytic anemia?", a: "Scleroderma Renal Crisis." },
            { q: "Drug class of choice that is lifesaving in the management of Scleroderma Renal Crisis?", a: "Angiotensin-Converting Enzyme (ACE) inhibitors." },
            { q: "Class of medications strictly contraindicated in high doses in systemic sclerosis due to the risk of precipitating Scleroderma Renal Crisis?", a: "Glucocorticoids." },
            { q: "First-line medical therapy for managing severe Raynaud phenomenon in scleroderma patients?", a: "Calcium channel blockers (e.g., Nifedipine). Sjögren Syndrome" },
            { q: "Classic diagnostic triad of primary Sjögren Syndrome?", a: "Keratoconjunctivitis sicca (dry eyes), xerostomia (dry mouth), and parotid gland enlargement." },
            { q: "The two autoantibodies most highly associated with Sjögren Syndrome?", a: "Anti-Ro (SS-A) and Anti-La (SS-B) antibodies." },
            { q: "Fetal risk associated with pregnant patients carrying positive anti-Ro (SS-A) antibodies?", a: "Neonatal lupus and congenital complete heart block." },
            { q: "Best objective initial test to evaluate for decreased tear production in suspected Sjögren Syndrome?", a: "Schirmer test." },
            { q: "Most definitive diagnostic test to confirm Sjögren Syndrome if serology is ambiguous?", a: "Lip biopsy showing focal lymphocytic sialadenitis." },
            { q: "Patients with Sjögren Syndrome have a markedly elevated risk for developing which specific malignancy?", a: "Non-Hodgkin Lymphoma (specifically B-cell MALT lymphoma). Inflammatory Myopathies (Dermatomyositis & Polymyositis)" },
            { q: "Pattern of muscle weakness characteristically seen in Polymyositis and Dermatomyositis?", a: "Symmetrical, proximal muscle weakness affecting the shoulders and hips." },
            { q: "Most specific autoantibody for Polymyositis and Dermatomyositis associated with interstitial lung disease?", a: "Anti-Jo-1 (anti-tRNA synthetase) antibody." },
            { q: "Autoantibody highly specific for Dermatomyositis presenting with classic cutaneous signs?", a: "Anti-Mi-2 antibody." },
            { q: "Pathognomonic violaceous rash over the eyelids seen in Dermatomyositis?", a: "Heliotrope rash." },
            { q: "Pathognomonic erythematous, scaly papules found over the bony prominences of the MCP and PIP joints?", a: "Gottron papules." },
            { q: "Cutaneous finding in Dermatomyositis characterized by hyperkeratosis and scaling on the lateral aspects of the fingers?", a: "Mechanic's hands." },
            { q: "Key histological difference on muscle biopsy between Polymyositis and Dermatomyositis?", a: "Polymyositis shows endomysial inflammation, while Dermatomyositis shows perimysial/perivascular inflammation." },
            { q: "Crucial age-appropriate screening required upon diagnosing a patient with Dermatomyositis?", a: "Internal malignancy screening." },
            { q: "First-line systemic pharmacotherapy for both Polymyositis and Dermatomyositis?", a: "High-dose oral glucocorticoids. Seronegative Spondyloarthropathies" },
            { q: "Genotypic human leukocyte antigen highly associated with all seronegative spondyloarthropathies?", a: "HLA-B27." },
            { q: "Classic radiographic spine finding in advanced, long-standing Ankylosing Spondylitis?", a: "Bamboo spine due to marginal syndesmophytes and fusion." },
            { q: "Clinical pattern of low back pain classic for Ankylosing Spondylitis?", a: "Chronic back pain that improves with exercise and worsens with rest." },
            { q: "Most common extra-articular manifestation of Ankylosing Spondylitis?", a: "Acute anterior uveitis." },
            { q: "Screening test of choice for early Ankylosing Spondylitis when plain radiographs are normal?", a: "MRI of the sacroiliac joints." },
            { q: "Classic clinical triad defining Reactive Arthritis?", a: "Uveitis/conjunctivitis, urethritis, and arthritis (\"Can't see, can't pee, can't climb a tree\")." },
            { q: "Common infectious triggers preceding Reactive Arthritis?", a: "Chlamydia trachomatis, Campylobacter, Salmonella, Shigella, and Yersinia." },
            { q: "Characteristic cutaneous lesion of Reactive Arthritis found on the palms or soles resembling pustular psoriasis?", a: "Keratoderma blennorrhagica." },
            { q: "Unique radiographic and clinical finding of the digits seen in Psoriatic Arthritis?", a: "Dactylitis (\"sausage digits\")." },
            { q: "Classic radiographic feature of the phalanges seen in severe Psoriatic Arthritis?", a: "\"Pencil-in-cup\" deformity." },
            { q: "Class of medications used as first-line therapy for the symptomatic management of Ankylosing Spondylitis?", a: "NSAIDs. Crystal-Induced Arthropathies (Gout & Pseudogout)" },
            { q: "Polarized light microscopy appearance of monosodium urate crystals in Gout?", a: "Needle-shaped and negatively birefringent (yellow when parallel to the slow wave of the compensator)." },
            { q: "Polarized light microscopy appearance of calcium pyrophosphate dihydrate (CPPD) crystals in Pseudogout?", a: "Rhomboid-shaped and weakly positively birefringent (blue when parallel to the slow wave of the compensator)." },
            { q: "Name given to the classic involvement of the first metatarsophalangeal (MTP) joint in acute Gout?", a: "Podagra." },
            { q: "Radiographic hallmark of chronic, tophaceous Gout?", a: "Punched-out lytic bone erosions with overhanging cortical edges." },
            { q: "Radiographic hallmark of Pseudogout (CPPD) found within joint cartilage?", a: "Chondrocalcinosis." },
            { q: "First-line abortive therapies for an acute flare of Gout in a patient with normal renal function?", a: "NSAIDs (e.g., Indomethacin) or systemic/intra-articular glucocorticoids." },
            { q: "Mechanism of action of Colchicine in acute gout management?", a: "Inhibits microtubule polymerization, disrupting neutrophil chemotaxis and degranulation." },
            { q: "Major toxicities of Colchicine that restrict its use in patients with severe renal failure?", a: "Diarrhea, neuromyopathy, and bone marrow suppression." },
            { q: "Best long-term, first-line urate-lowering therapy for chronic gout prevention?", a: "Allopurinol." },
            { q: "Severe, life-threatening hypersensitivity syndrome associated with Allopurinol therapy?", a: "DRESS syndrome (Drug Reaction with Eosinophilia and Systemic Symptoms) or Stevens-Johnson Syndrome." },
            { q: "Genetic screening test recommended for Asian patients before initiating Allopurinol to prevent severe cutaneous adverse reactions?", a: "HLA-B*5801 allele testing." },
            { q: "Primary mechanism of action of Allopurinol and Febuxostat?", a: "Xanthine oxidase inhibition." },
            { q: "Dangerous phenomenon that can occur if urate-lowering therapy is started during an acute gout flare without anti-inflammatory prophylaxis?", a: "Precipitation or worsening of the acute gout flare." },
            { q: "Three systemic metabolic conditions strongly associated with secondary Pseudogout (CPPD)?", a: "Hyperparathyroidism, Hemochromatosis, and Hypomagnesemia. Vasculitis (Large, Medium, Small Vessel)" },
            { q: "Most dreaded complication of untreated Giant Cell (Temporal) Arteritis?", a: "Permanent blindness due to anterior ischemic optic neuropathy." },
            { q: "Immediate management step when Giant Cell Arteritis is strongly suspected, prior to obtaining a biopsy?", a: "High-dose intravenous or oral systemic glucocorticoids." },
            { q: "Most definitive diagnostic test for confirming Giant Cell Arteritis?", a: "Temporal artery biopsy." },
            { q: "Condition characterized by proximal limb girdle stiffness and high ESR, occurring in 50% of patients with Giant Cell Arteritis?", a: "Polymyalgia Rheumatica (PMR)." },
            { q: "Large-vessel vasculitis predominantly affecting young Asian females, causing upper extremity pulse deficits?", a: "Takayasu Arteritis." },
            { q: "Medium-vessel necrotizing vasculitis strongly associated with chronic Hepatitis B infection?", a: "Polyarteritis Nodosa (PAN)." },
            { q: "Classic angiographic finding seen in the mesenteric or renal vessels of a patient with Polyarteritis Nodosa?", a: "Microaneurysms with a \"string-of-beads\" appearance." },
            { q: "Organ system characteristically spared in Polyarteritis Nodosa?", a: "The lungs." },
            { q: "Pediatric medium-vessel vasculitis presenting with high fever, strawberry tongue, and desquamating rash?", a: "Kawasaki Disease." },
            { q: "Most critical cardiac complication of untreated Kawasaki Disease?", a: "Coronary artery aneurysms." },
            { q: "Standard first-line medical regimen for acute Kawasaki Disease to reduce coronary artery risks?", a: "Intravenous Immunoglobulin (IVIG) and high-dose Aspirin." },
            { q: "Small-vessel vasculitis characterized by granulomatous inflammation of the respiratory tract and necrotizing glomerulonephritis?", a: "Granulomatosis with Polyangiitis (GPA / Wegener's)." },
            { q: "Highly specific serum autoantibody marker for Granulomatosis with Polyangiitis?", a: "c-ANCA (PR3-ANCA)." },
            { q: "Small-vessel vasculitis presenting with asthma, prominent blood eosinophilia, and transient pulmonary infiltrates?", a: "Eosinophilic Granulomatosis with Polyangiitis (EGPA / Churg-Strauss)." },
            { q: "Highly specific serum autoantibody marker for Eosinophilic Granulomatosis with Polyangiitis and Microscopic Polyangiitis?", a: "p-ANCA (MPO-ANCA)." },
            { q: "Most common systemic vasculitis in children, presenting with palpable purpura, arthralgias, abdominal pain, and hematuria?", a: "IgA Vasculitis (Henoch-Schönlein Purpura)." },
            { q: "Deposition finding on renal biopsy pathognomonic for IgA Vasculitis?", a: "Mesangial IgA immune complex deposition." },
            { q: "Small-vessel vasculitis precipitated by cold temperatures, causing palpable purpura, arthralgias, and strongly associated with Hepatitis C?", a: "Mixed Cryoglobulinemia." },
            { q: "Key serum complement profile finding in patients presenting with a Mixed Cryoglobulinemia flare?", a: "Markedly depressed C4 levels with normal or mildly low C3. Other Rheumatologic Conditions" },
            { q: "Diagnostic criteria combination used to confirm Behcet Syndrome?", a: "Recurrent painful oral aphthous ulcers plus two of: recurrent genital ulcers, ocular lesions (uveitis), or pachyderma skin lesions." },
            { q: "Simple, non-invasive physical exam test demonstrating skin hyperreactivity used to support Behcet Syndrome diagnosis?", a: "Pathergy test (pustule formation 24-48 hours after a sterile needle prick)." },
            { q: "Serious neurological manifestation of Behcet Syndrome that can mimic multiple sclerosis?", a: "Neuro-Behcet disease (meningoencephalitis or dural sinus thrombosis)." },
            { q: "Best initial screening tool for assessing bone mineral density to diagnose Osteoporosis?", a: "Dual-energy X-ray absorptiometry (DEXA) scan." },
            { q: "T-score threshold on a DEXA scan defining the diagnostic cutoff for Osteoporosis?", a: "T-score of -2.5 or lower." },
            { q: "First-line pharmacotherapy class for the prevention and treatment of postmenopausal Osteoporosis?", a: "Oral Bisphosphonates (e.g., Alendronate)." },
            { q: "Rare, severe jaw complication associated with long-term, high-dose Bisphosphonate therapy?", a: "Osteonecrosis of the jaw." },
            { q: "Atypical skeletal fracture complication associated with prolonged Bisphosphonate therapy exceeding 5 years?", a: "Atypical subtrochanteric femoral fractures." },
            { q: "Core chronic widespread pain syndrome characterized by specific tender points, normal inflammatory markers, and sleep disturbance?", a: "Fibromyalgia." },
            { q: "First-line FDA-approved non-opioid medications for the management of Fibromyalgia?", a: "Amitriptyline, Duloxetine, or Pregabalin. Rheumatology-Hematology Overlap & Drug Toxicities" },
            { q: "Most common drug-induced cytopenia associated with high-dose Azathioprine therapy?", a: "Leukopenia (bone marrow suppression)." },
            { q: "Genetic enzyme deficiency that exponentially increases the risk of severe bone marrow toxicity when taking Azathioprine?", a: "Thiopurine Methyltransferase (TPMT) deficiency." },
            { q: "Mechanism by which Allopurinol co-administration causes life-threatening cytopenias in a patient taking Azathioprine?", a: "Allopurinol inhibits xanthine oxidase, preventing the metabolism of active azathioprine metabolites." },
            { q: "Signature hematologic abnormality seen in the peripheral blood smear of a patient with active Macrophage Activation Syndrome?", a: "Hemophagocytosis (macrophages engulfing erythrocytes, leukocytes, and platelets)." },
            { q: "The classic presentation of Adult-Onset Still’s Disease?", a: "Quotidien (daily) high fevers, salmon-pink evanescent rash, arthritis, and extreme leukocytosis." },
            { q: "Serum biomarker that is characteristically elevated to extreme levels in Adult-Onset Still's Disease?", a: "Ferritin." },
            { q: "Serious hematologic adverse effect of Cyclophosphamide therapy that requires monitoring with regular urinalyses?", a: "Hemorrhagic cystitis." },
            { q: "Co-administered agent utilized to neutralize the metabolite acrolein and prevent Cyclophosphamide-induced hemorrhagic cystitis?", a: "Mesna (2-mercaptoethane sulfonate)." },
            { q: "Malignancy that patients treated with Cyclophosphamide have a significantly increased long-term risk of developing?", a: "Transitional cell carcinoma of the bladder. Osteoarthritis (OA)" },
            { q: "Most important non-pharmacologic intervention for slowing the progression of knee and hip Osteoarthritis?", a: "Weight loss and low-impact exercise." },
            { q: "First-line pharmacotherapy for symptomatic management of mild-to-moderate Osteoarthritis?", a: "Topical or oral NSAIDs (e.g., Diclofenac, Naproxen)." },
            { q: "Radiographic hallmarks of advanced Osteoarthritis?", a: "Asymmetric joint space narrowing, subchondral sclerosis, osteophytes, and subchondral cysts." },
            { q: "Name given to the palpable osteophyte nodules located at the Distal Interphalangeal (DIP) joints in Osteoarthritis?", a: "Heberden nodes." },
            { q: "Name given to the palpable osteophyte nodules located at the Proximal Interphalangeal (PIP) joints in Osteoarthritis?", a: "Bouchard nodes." },
            { q: "Character of joint stiffness in Osteoarthritis compared to Rheumatoid Arthritis?", a: "Morning stiffness lasting less than 30 minutes that worsens with use and improves with rest. Infectious & Reactive Arthritides" },
            { q: "Most common causative organism of acute bacterial septic arthritis in the general adult population?", a: "Staphylococcus aureus." },
            { q: "Most common causative organism of septic arthritis in sexually active young adults?", a: "Neisseria gonorrhoeae." },
            { q: "Classic disseminated triad of Disseminated Gonococcal Infection (DGI)?", a: "Polyarthralgias, tenosynovitis, and painless pustular skin lesions." },
            { q: "Synovial fluid analysis findings pathognomonic for acute Septic Arthritis?", a: "Purulent fluid, WBC count greater than 50,000/µL, and greater than 75% polymorphonuclear leukocytes." },
            { q: "Empiric antibiotic regimen of choice for a patient with suspected acute Septic Arthritis while cultures are pending?", a: "Intravenous Vancomycin combined with a third-generation cephalosporin (e.g., Ceftriaxone)." },
            { q: "Standard diagnostic protocol for a patient presenting with an acute, hot, swollen monoarticular joint?", a: "Immediate joint aspiration (arthrocentesis) and synovial fluid analysis." },
            { q: "Classic rheumatologic manifestation of late-stage, untreated Lyme Disease?", a: "Intermittent or chronic monoarticular or oligoarticular arthritis, most commonly affecting the knee." },
            { q: "Preferred first-line oral antibiotic for early localized Lyme disease and early Lyme arthritis?", a: "Doxycycline. Sarcoidosis" },
            { q: "Classic chest radiographic finding pathognomonic for Stage I Sarcoidosis?", a: "Bilateral hilar adenopathy." },
            { q: "Distinct triad defining Löfgren Syndrome (an acute presentation of Sarcoidosis)?", a: "Bilateral hilar adenopathy, erythema nodosum, and migratory polyarthritis." },
            { q: "Histopathological hallmark finding on biopsy of an affected organ in Sarcoidosis?", a: "Non-caseating granulomas." },
            { q: "Serum electrolyte and enzyme abnormalities classic for active systemic Sarcoidosis?", a: "Hypercalcemia, hypercalciuria, and elevated Angiotensin-Converting Enzyme (ACE) levels." },
            { q: "Primary mechanism causing hypercalcemia in patients with Sarcoidosis?", a: "Unregulated 1-alpha-hydroxylase activity in granulomatous macrophages converting vitamin D to its active form." },
            { q: "First-line systemic treatment for symptomatic or progressive organ-threatening Sarcoidosis?", a: "Systemic glucocorticoids. Adult-Onset Still's Disease (AOSD)" },
            { q: "Classic triad of symptoms defining Adult-Onset Still's Disease?", a: "Quotidian (daily) high spiking fevers, an evanescent salmon-pink maculopapular rash, and arthritis." },
            { q: "The unique timing characteristic of the salmon-pink rash in Adult-Onset Still's Disease?", a: "The rash appears or worsens concurrently with the daily fever spikes." },
            { q: "Extreme laboratory abnormality characteristic of Adult-Onset Still's Disease that helps differentiate it from other rheumatologic conditions?", a: "Markedly elevated serum Ferritin levels (often exceeding 5,000 ng/mL) and profound leukocytosis." },
            { q: "First-line pharmacotherapy for mild manifestations of Adult-Onset Still's Disease?", a: "High-dose NSAIDs." },
            { q: "Preferred biologic drug targets for refractory or severe cases of Adult-Onset Still's Disease?", a: "Interleukin-1 (IL-1) inhibitors (e.g., Anakinra) or Interleukin-6 (IL-6) inhibitors (e.g., Tocilizumab). Systemic Autoinflammatory & IgG4 Diseases" },
            { q: "Most common hereditary autoinflammatory periodic fever syndrome, caused by mutations in the MEFV gene?", a: "Familial Mediterranean Fever (FMF)." },
            { q: "Classic clinical presentation of a Familial Mediterranean Fever flare?", a: "Recurrent, self-limiting episodes of fever accompanied by peritonitis, pleuritis, or synovitis lasting 1 to 3 days." },
            { q: "First-line maintenance medication used to decrease the frequency of flares and prevent systemic amyloidosis in Familial Mediterranean Fever?", a: "Colchicine." },
            { q: "Type of systemic amyloidosis that develops as a long-term complication of untreated Familial Mediterranean Fever?", a: "AA (Secondary) Amyloidosis." },
            { q: "Fibroinflammatory condition characterized by tumefactive lesions, elevated serum titers, and lymphoplasmacytic infiltrates?", a: "IgG4-Related Disease." },
            { q: "Pathognomonic histopathological features of IgG4-Related Disease on tissue biopsy?", a: "Dense lymphoplasmacytic infiltrate rich in IgG4+ plasma cells, storiform fibrosis, and obliterative phlebitis." },
            { q: "Common clinical manifestations or organ involvements seen in IgG4-Related Disease?", a: "Autoimmune pancreatitis (Type 1), Riedel thyroiditis, Mikulicz syndrome (enlarged lacrimal and salivary glands), and retroperitoneal fibrosis. Advanced Biologics & Mechanisms of Action" },
            { q: "Specific molecular target of Rituximab used in severe granulomatosis with polyangiitis and refractory SLE?", a: "CD20 antigen on B lymphocytes." },
            { q: "Mechanism of action of Belimumab used as an adjunctive therapy in systemic lupus erythematosus?", a: "Inhibits B-lymphocyte stimulator (BLyS), preventing B-cell survival and differentiation." },
            { q: "Mechanism of action of Abatacept used in refractory Rheumatoid Arthritis?", a: "Binds to CD80 and CD86 on antigen-presenting cells, blocking the costimulatory signal required for T-cell activation." },
            { q: "Mechanism of action of Tocilizumab used in Giant Cell Arteritis and Rheumatoid Arthritis?", a: "Interleukin-6 (IL-6) receptor antagonist." },
            { q: "Mechanism of action of Secukinumab used in the treatment of severe Psoriatic Arthritis and Ankylosing Spondylitis?", a: "Interleukin-17A (IL-17A) inhibitor." },
            { q: "Mechanism of action of Ustekinumab utilized in Psoriatic Arthritis?", a: "Inhibits the p40 subunit of both Interleukin-12 (IL-12) and Interleukin-23 (IL-23)." },
            { q: "Mechanism of action of Tofacitinib and Upadacitinib used in severe Rheumatoid Arthritis?", a: "Janus Kinase (JAK) inhibitors, blocking intracellular cytokine signaling." },
            { q: "Black box warning or screening required before starting a patient on Janus Kinase (JAK) inhibitors?", a: "Screening for latent tuberculosis and monitoring for an increased risk of deep vein thrombosis (DVT) and malignancy. ===================================================================== ===================================================================== Section: Internal Medicine" }
          ]
        },
        {
          section: 'Internal Medicine',
          topic: "Neurology — Stroke, seizures, headache, dementia, MS",
          icon: 'brain',
          cards: [
            { q: "Most common overall site for a hypertensive intraparenchymal hemorrhage?", a: "Putamen." },
            { q: "Classical presentation of a putaminal hemorrhage?", a: "Contralateral hemiparesis and gaze deviation toward the side of the lesion." },
            { q: "Clinical presentation distinguishing cerebellar hemorrhage from other intracranial bleeds?", a: "Sudden ataxia and vomiting without hemiparesis." },
            { q: "Definitive emergency intervention for an expanding cerebellar hemorrhage with neurological decline?", a: "Surgical decompression." },
            { q: "Initial neuroimaging diagnostic step when evaluating an acute stroke-like presentation?", a: "Non-contrast CT scan of the head to rule out hemorrhage." },
            { q: "Time window for administering intravenous alteplase in acute ischemic stroke?", a: "Within 4.5 hours of when the patient was last seen normal." },
            { q: "Primary absolute contraindication to thrombolytic therapy in acute ischemic stroke?", a: "History of any intracranial hemorrhage." },
            { q: "Eligibility window for mechanical thrombectomy in large vessel occlusion of the anterior circulation?", a: "Within 24 hours of symptom onset." },
            { q: "Preferred initial antiplatelet management for acute ischemic stroke outside the thrombolytic window?", a: "Aspirin." },
            { q: "Pathophysiological structure occluded in Lateral Medullary (Wallenberg) Syndrome?", a: "Posterior Inferior Cerebellar Artery or vertebral artery." },
            { q: "Classic clinical triad of Lateral Medullary Syndrome?", a: "Ipsilateral Horner syndrome, ipsilateral facial loss of pain/temperature, and contralateral body loss of pain/temperature." },
            { q: "Cranial nerve deficits explaining hoarseness and dysphagia in Wallenberg Syndrome?", a: "Nucleus ambiguus involvement affecting cranial nerves IX and X." },
            { q: "Clinical presentation of a total basilar artery occlusion?", a: "Locked-in syndrome with preserved consciousness and vertical eye movements." },
            { q: "Classic visual field deficit associated with a posterior cerebral artery occlusion?", a: "Homonymous hemianopsia with macular sparing." },
            { q: "Characteristic shape of a subdural hematoma on a non-contrast head CT?", a: "Crescent-shaped collection crossing suture lines." },
            { q: "Vessel ruptured causing a subdural hematoma?", a: "Bridging cortical veins." },
            { q: "Predisposed patient populations for chronic subdural hematomas?", a: "Elderly individuals and chronic alcoholics." },
            { q: "Characteristic shape of an epidural hematoma on a non-contrast head CT?", a: "Biconvex or lens-shaped collection restricted by suture lines." },
            { q: "Vessel ruptured causing an epidural hematoma?", a: "Middle meningeal artery." },
            { q: "Classical clinical progression of an epidural hematoma?", a: "Head trauma followed by a lucid interval and then rapid neurological demise." },
            { q: "Most common etiology of a non-traumatic subarachnoid hemorrhage?", a: "Rupture of a saccular or berry aneurysm." },
            { q: "First-line medication used to prevent vasospasm following a subarachnoid hemorrhage?", a: "Nimodipine. Section 2: Neurodegenerative Disorders & Dementias" },
            { q: "Definitive histopathological features of Alzheimer disease?", a: "Extracellular amyloid-beta plaques and intracellular neurofibrillary tangles of hyperphosphorylated tau protein." },
            { q: "Core cognitive presentation that differentiates Alzheimer disease from frontotemporal dementia?", a: "Early loss of short-term memory with preserved personality in early stages." },
            { q: "Characterizing presentation of frontotemporal dementia?", a: "Early changes in personality, social disinhibition, and executive dysfunction." },
            { q: "Clinical triad defining Dementia with Lewy Bodies?", a: "Fluctuating cognition, visual hallucinations, and spontaneous Parkinsonism." },
            { q: "Classical clinical triad of Normal Pressure Hydrocephalus?", a: "Gait apraxia, urinary incontinence, and cognitive decline." },
            { q: "Diagnostic and temporary therapeutic intervention for Normal Pressure Hydrocephalus?", a: "Large-volume lumbar puncture." },
            { q: "Definitive definitive long-term treatment for Normal Pressure Hydrocephalus?", a: "Ventriculoperitoneal shunting." },
            { q: "Distinguishing clinical feature of vascular dementia?", a: "Stepwise decline in cognitive function matching focal ischemic events." },
            { q: "Characterizing clinical feature of Creutzfeldt-Jakob disease?", a: "Rapidly progressive dementia accompanied by myoclonus and ataxia." },
            { q: "Diagnostic EEG finding associated with Creutzfeldt-Jakob disease?", a: "Periodic sharp wave complexes." },
            { q: "Core diagnostic criteria required for a diagnosis of Parkinson disease?", a: "Bradykinesia combined with either a resting tremor or rigidity." },
            { q: "Mechanism of action of carbidopa when co-administered with levodopa?", a: "Inhibits peripheral DOPA decarboxylase to maximize central nervous system bioavailability." },
            { q: "Genetic inheritance pattern and mutation associated with Huntington disease?", a: "Autosomal dominant CAG trinucleotide repeat expansion on chromosome 4." },
            { q: "Specific neuroanatomical structure that atrophies in Huntington disease?", a: "Caudate nucleus. Section 3: Neuromuscular & Peripheral Nerve Disorders" },
            { q: "Classical cerebrospinal fluid analysis finding in Guillain-Barré Syndrome?", a: "Albuminocytologic dissociation featuring elevated protein with normal white blood cell count." },
            { q: "Most common infectious trigger associated with Guillain-Barré Syndrome?", a: "Campylobacter jejuni enteritis." },
            { q: "Most critical monitoring parameters for a patient admitted with acute Guillain-Barré Syndrome?", a: "Forced vital capacity and negative inspiratory force to monitor respiratory failure." },
            { q: "Proven effective treatments for Guillain-Barré Syndrome?", a: "Intravenous immunoglobulin or plasmapheresis." },
            { q: "Contraindicated medication class in the management of acute Guillain-Barré Syndrome?", a: "Systemic corticosteroids." },
            { q: "Underlying pathophysiology of Myasthenia Gravis?", a: "Autoantibodies directed against postsynaptic nicotinic acetylcholine receptors." },
            { q: "Classic presentation of muscle weakness in Myasthenia Gravis?", a: "Fluctuating skeletal muscle weakness that worsens with repetitive use and improves with rest." },
            { q: "Screening test that must be performed on all patients newly diagnosed with Myasthenia Gravis?", a: "CT scan of the chest to rule out a thymoma." },
            { q: "First-line long-term medical management for symptomatic Myasthenia Gravis?", a: "Pyridostigmine." },
            { q: "Immediate medical management for a patient in myasthenic crisis?", a: "Endotracheal intubation followed by plasmapheresis or intravenous immunoglobulin." },
            { q: "Underlying pathophysiology of Lambert-Eaton Myasthenic Syndrome?", a: "Autoantibodies directed against presynaptic voltage-gated calcium channels." },
            { q: "Classical physical exam finding that differentiates Lambert-Eaton from Myasthenia Gravis?", a: "Proximal muscle weakness that improves with repetitive contraction." },
            { q: "Most common neoplastic condition associated with Lambert-Eaton Myasthenic Syndrome?", a: "Small cell lung carcinoma." },
            { q: "Sensory distribution altered in a classic stocking-glove pattern?", a: "Length-dependent peripheral polyneuropathy." },
            { q: "First-line pharmacological management for painful diabetic neuropathy?", a: "Gabapentin, pregabalin, or duloxetine." },
            { q: "Sensory and motor deficits found in a patient with a common peroneal nerve injury?", a: "Foot drop with loss of sensation on the dorsum of the foot." },
            { q: "Physical exam finding pointing to a lesion of the long thoracic nerve?", a: "Winging of the scapula." },
            { q: "Nerve compressed in carpal tunnel syndrome?", a: "Median nerve. Section 4: Demyelinating & Neuroinflammatory Diseases" },
            { q: "Core diagnostic requirement for Multiple Sclerosis according to McDonald criteria?", a: "Neurological lesions disseminated in time and space." },
            { q: "Gold standard neuroimaging modality for diagnosing Multiple Sclerosis?", a: "MRI of the brain and spine with gadolinium." },
            { q: "Classic cerebrospinal fluid finding in patients with Multiple Sclerosis?", a: "Oligoclonal IgG bands on electrophoresis." },
            { q: "Preferred initial treatment for an acute exacerbation of Multiple Sclerosis?", a: "Intravenous high-dose methylprednisolone." },
            { q: "Mechanism of action of interferon-beta used in relapsing-remitting Multiple Sclerosis?", a: "Immunomodulation to reduce the frequency of clinical relapses." },
            { q: "Defining clinical feature of Internuclear Ophthalmoplegia?", a: "Impaired adduction of the ipsilateral eye with nystagmus of the contralateral abducting eye during lateral gaze." },
            { q: "Specific neuroanatomical structure damaged in Internuclear Ophthalmoplegia?", a: "Medial longitudinal fasciculus." },
            { q: "Target antigen in Neuromyelitis Optica (Devic disease)?", a: "Aquaporin-4 water channels." },
            { q: "Typical presentation of acute disseminated encephalomyelitis?", a: "Multifocal neurological deficits and encephalopathy following a viral infection or vaccination. Section 5: Epilepsy & Seizures" },
            { q: "First-line pharmacological agent used to abort status epilepticus?", a: "Intravenous lorazepam or diazepam." },
            { q: "Clinical definition of status epilepticus?", a: "Continuous seizure activity lasting greater than 5 minutes or recurrent seizures without recovery between episodes." },
            { q: "Preferred long-term antiepileptic drug for generalized tonic-clonic seizures?", a: "Levetiracetam, valproic acid, or lamotrigine." },
            { q: "Characteristic EEG abnormality seen in absence seizures?", a: "Generalized 3-Hz spike-and-wave discharges." },
            { q: "First-line pharmacological treatment for absence seizures?", a: "Ethosuximide." },
            { q: "Antiepileptic medication known to cause gingival hyperplasia and hirsutism?", a: "Phenytoin." },
            { q: "Teratogenic risk uniquely associated with valproic acid exposure in utero?", a: "Neural tube defects." },
            { q: "Severe dermatological adverse reaction associated with rapid titration of lamotrigine?", a: "Stevens-Johnson syndrome." },
            { q: "Electrolyte abnormality classically induced by carbamazepine therapy?", a: "Hyponatremia due to syndrome of inappropriate antidiuretic hormone secretion." },
            { q: "Defining feature that separates a complex focal seizure from a simple focal seizure?", a: "Impairment of consciousness or awareness. Section 6: Headache Syndromes & Cranial Neuralgias" },
            { q: "Classical clinical presentation of a cluster headache?", a: "Unilateral, excruciating periorbital pain accompanied by ipsilateral lacrimation and rhinorrhea." },
            { q: "First-line abortive therapy for an acute attack of cluster headache?", a: "100% high-flow oxygen via non-rebreather mask or subcutaneous sumatriptan." },
            { q: "First-line prophylactic medication used to prevent cluster headaches?", a: "Verapamil." },
            { q: "Abortive medication class for severe migraines contraindicated in patients with coronary artery disease?", a: "Triptans." },
            { q: "Prophylactic medication options for frequent migraine headaches?", a: "Topiramate, valproic acid, propranolol, or amitriptyline." },
            { q: "Clinical presentation of a tension headache?", a: "Bilateral, band-like, non-pulsatile headache without photophobia or phonophobia." },
            { q: "First-line abortive treatment for a tension-type headache?", a: "Acetaminophen or nonsteroidal anti-inflammatory drugs." },
            { q: "Clinical presentation of trigeminal neuralgia?", a: "Unilateral, lancinating, shock-like facial pain triggered by light touch or chewing." },
            { q: "First-line pharmacological management for trigeminal neuralgia?", a: "Carbamazepine." },
            { q: "Diagnostic criteria that must be checked immediately in a patient over 50 presenting with a new headache and jaw claudication?", a: "Erythrocyte sedimentation rate and C-reactive protein to screen for Giant Cell Arteritis. Section 7: CNS Infections & Altered Mental Status" },
            { q: "Classic triad of bacterial meningitis?", a: "Fever, altered mental status, and nuchal rigidity." },
            { q: "Cerebrospinal fluid profile typical of acute bacterial meningitis?", a: "Elevated polymorphonuclear leukocytes, markedly decreased glucose, and elevated protein." },
            { q: "Empirical antibiotic regimen for suspected bacterial meningitis in an adult aged 18 to 50?", a: "Ceftriaxone plus vancomycin." },
            { q: "Additional empirical antibiotic required for meningitis in patients over age 50 or immunocompromised?", a: "Ampicillin to cover Listeria monocytogenes." },
            { q: "Adjunctive medication that should be administered prior to or concurrently with antibiotics in suspected pneumococcal meningitis?", a: "Dexamethasone." },
            { q: "Cerebrospinal fluid profile typical of viral meningitis?", a: "Elevated lymphocytes, normal glucose, and normal to mildly elevated protein." },
            { q: "Most common focal lobe involved in Herpes Simplex Virus encephalitis?", a: "Temporal lobe." },
            { q: "Preferred antiviral therapy for confirmed or highly suspected HSV encephalitis?", a: "Intravenous acyclovir." },
            { q: "Classic diagnostic finding on cerebrospinal fluid analysis for Cryptococcal meningitis?", a: "Positive India ink preparation or cryptococcal antigen assay." },
            { q: "Defining clinical difference between delirium and dementia?", a: "Delirium features an acute onset with fluctuating attention and awareness, whereas dementia is progressive and chronic. Section 8: Spinal Cord & Neuro-oncology/Vascular Compression" },
            { q: "Clinical syndrome presenting with ipsilateral loss of motor function and contralateral loss of pain/temperature sensation?", a: "Brown-Séquard syndrome (spinal cord hemisection)." },
            { q: "Specific spinal cord pathways affected in Vitamin B12 deficiency?", a: "Dorsal columns and lateral corticospinal tracts." },
            { q: "Clinical triad of spinal epidural abscess?", a: "Severe localized spinal pain, fever, and progressive neurological deficits." },
            { q: "Best next step in management for a patient with suspected neoplastic spinal cord compression?", a: "Intravenous dexamethasone followed by an emergency MRI of the spine." },
            { q: "Clinical features differentiating Cauda Equina Syndrome from Conus Medullaris Syndrome?", a: "Cauda Equina presents with asymmetric, hyporeflexic lower motor neuron signs and saddle anesthesia, whereas Conus Medullaris presents with symmetric, hyperreflexic signs and early bowel/bladder dysfunction." },
            { q: "Pathophysiological cause of Idiopathic Intracranial Hypertension?", a: "Decreased resorption of cerebrospinal fluid in the presence of normal ventricular size." },
            { q: "Medication used as first-line therapy to decrease cerebrospinal fluid production in Idiopathic Intracranial Hypertension?", a: "Acetain-induced or acetazolamide." },
            { q: "Primary ophthalmologic risk associated with untreated Idiopathic Intracranial Hypertension?", a: "Permanent vision loss due to optic atrophy from chronic papilledema. Section 9: Neuro-Ophthalmology, Otology, & Autonomic Disorders" },
            { q: "Clinical test used to differentiate benign paroxysmal positional vertigo from central causes of vertigo?", a: "Dix-Hallpike maneuver." },
            { q: "Definitive bedside repositioning maneuver used to treat benign paroxysmal positional vertigo?", a: "Epley maneuver." },
            { q: "Distinguishing clinical feature that separates vestibular neuritis from labyrinthitis?", a: "Labyrinthitis presents with unilateral sensorineural hearing loss, while vestibular neuritis preserves hearing." },
            { q: "Classic presentation of Meniere disease?", a: "Episodic vertigo, sensorineural hearing loss, and tinnitus accompanied by a sensation of fullness in the ear." },
            { q: "Clinical triad defining Horner syndrome?", a: "Ptosis, miosis, and anhidrosis." },
            { q: "Underlying pupillary defect seen in an Argyll Robertson pupil?", a: "Pupil constricts to accommodation but fails to constrict to direct light." },
            { q: "Most common infectious disease associated with an Argyll Robertson pupil?", a: "Neurosyphilis ( tertiary syphilis)." },
            { q: "Diagnostic pupillary finding seen in an afferent pupillary defect (Marcus Gunn pupil)?", a: "Paradoxical dilation of the affected eye when light is swung from the unaffected eye to the affected eye. Section 10: Toxic, Metabolic, & Nutritional Encephalopathies" },
            { q: "Classical clinical triad of Wernicke encephalopathy?", a: "Encephalopathy, oculomotor dysfunction, and gait ataxia." },
            { q: "Irreversible cognitive syndrome that develops if Wernicke encephalopathy is left untreated?", a: "Korsakowski syndrome, characterized by anterograde amnesia and confabulation." },
            { q: "Crucial administration sequence rule for thiamine and glucose in an unresponsively malnourished patient?", a: "Administer thiamine before or concurrently with glucose to prevent worsening of encephalopathy." },
            { q: "Specific neuroanatomical structures damaged in Wernicke encephalopathy?", a: "Mammillary bodies and medial thalamic nuclei." },
            { q: "Pathophysiological complication of correcting chronic hyponatremia too rapidly?", a: "Central pontine myelinolysis or osmotic demyelination syndrome." },
            { q: "Clinical presentation of central pontine myelinolysis?", a: "Acute paralysis, dysphagia, dysarthria, and locked-in syndrome occurring days after electrolyte correction." },
            { q: "Pathophysiological complication of correcting acute hypernatremia too rapidly?", a: "Cerebral edema and seizures." },
            { q: "Characteristic physical exam finding pathognomonic for hepatic encephalopathy?", a: "Asterixis, or flapping tremor of the extended wrists." },
            { q: "First-line pharmacological agent used to decrease serum ammonia in hepatic encephalopathy?", a: "Lactulose." },
            { q: "Secondary mechanism of action of rifaximin in the management of hepatic encephalopathy?", a: "Decreases ammonia-producing gut bacteria." },
            { q: "Classic neuroimaging finding in carbon monoxide poisoning?", a: "Bilateral necrosis of the globus pallidus. Section 11: Atypical Movement Disorders & Cerebellar Pathology" },
            { q: "Core clinical features of Progressive Supranuclear Palsy?", a: "Parkinsonism, early falls, and impairment of vertical downgaze." },
            { q: "Distinguishing clinical feature of Multiple System Atrophy?", a: "Parkinsonism accompanied by severe, early autonomic failure and orthostatic hypotension." },
            { q: "First-line medical treatment for an isolated essential tremor?", a: "Propranolol or primidone." },
            { q: "Classic physical characteristic of an essential tremor?", a: "Action or postural tremor that improves with alcohol consumption." },
            { q: "Pathophysiological cause of Wilson disease?", a: "Autosomal recessive mutation leading to impaired copper transport and toxic accumulation." },
            { q: "Ocular physical exam finding diagnostic for Wilson disease?", a: "Kayser-Fleischer rings in the cornea." },
            { q: "Preferred initial medical treatment for symptomatic Wilson disease?", a: "Penicillamine or trientine copper chelators." },
            { q: "Classic gait abnormality seen in a patient with a cerebellar midline hemispheric lesion?", a: "Wide-based, unsteady gait known as truncal ataxia. Section 12: Neuro-Oncology & Paraneoplastic Syndromes" },
            { q: "Most common primary malignant brain tumor in adults?", a: "Glioblastoma multiforme." },
            { q: "Classic neuroimaging appearance of a glioblastoma multiforme on MRI?", a: "Ring-enhancing lesion crossing the corpus callosum with a necrotic center." },
            { q: "Most common benign primary brain tumor in adults?", a: "Meningioma." },
            { q: "Histopathological hallmark of a meningioma?", a: "Whorled pattern of cells and psammoma bodies." },
            { q: "Most common sources of metastatic tumors found in the central nervous system?", a: "Lung cancer, breast cancer, and melanoma." },
            { q: "Paraneoplastic syndrome presenting with opsoclonus-myoclonus ataxia in children?", a: "Neuroblastoma." },
            { q: "Target antigen in paraneoplastic limbic encephalitis associated with ovarian teratomas?", a: "Anti-NMDA receptors. Section 13: Neuro-Trauma, Intracranial Pressure, & Brain Death" },
            { q: "Clinical triad pointing to increased intracranial pressure and impending herniation?", a: "Cushing triad, featuring bradycardia, respiratory irregularity, and hypertension." },
            { q: "Immediate medical intervention used to acutely hyperventilate a patient with elevated intracranial pressure?", a: "Lowering arterial carbon dioxide tension to induce cerebral vasoconstriction." },
            { q: "Osmotic diuretic agent used to acutely reduce brain volume in cerebral edema?", a: "Intravenous mannitol." },
            { q: "Specific cranial nerve compromised when uncal herniation causes a fixed and dilated pupil?", a: "Oculomotor nerve." },
            { q: "Clinical definition of brain death?", a: "Irreversible loss of all brain function, including the brainstem, confirmed by an apnea test. Section 14: Neuro-Rheumatology & Autoimmune Neuro-Pathology" },
            { q: "Classical presentation of Central Nervous System Vasculitis?", a: "Multifocal ischemic strokes of varying ages combined with chronic headache and encephalopathy." },
            { q: "Preferred initial management for confirmed Giant Cell Arteritis to prevent ischemic blindness?", a: "High-dose intravenous or oral systemic corticosteroids." },
            { q: "Neurological presentation of neuro-Behçet disease?", a: "Recurrent meningoencephalitis and brainstem lesions in a patient with oral and genital ulcers." },
            { q: "Classic neurological manifestation of Neuro-Sarcoidosis?", a: "Unilateral or bilateral cranial nerve VII palsies with granulomatous basilar meningitis. Section 15: Autonomic, Sleep, & Cranial Nerve Disorders" },
            { q: "Clinical triad diagnostic for Narcolepsy?", a: "Excessive daytime sleepiness, cataplexy, and hypnagogic hallucinations." },
            { q: "First-line pharmacological treatment for the maintenance of wakefulness in Narcolepsy?", a: "Modafinil." },
            { q: "Preferred medical intervention used to treat acute cataplexy in narcoleptic patients?", a: "Sodium oxybate or selective serotonin reuptake inhibitors." },
            { q: "Clinical presentation of Bell Palsy?", a: "Sudden onset unilateral facial paralysis involving both the upper and lower face." },
            { q: "Preferred early medical intervention for optimal recovery from Bell Palsy?", a: "Oral corticosteroids administered within 72 hours of symptom onset." },
            { q: "Primary physical sign distinguishing a peripheral Bell Palsy from a central stroke lesion?", a: "Bell palsy involves the forehead muscles, whereas a stroke spares the forehead due to bilateral cortical innervation. Section 16: Systemic Disease Manifestations & Spinal Pathology" },
            { q: "Most common spinal cord tract involved in tabes dorsalis?", a: "Posterior or dorsal columns." },
            { q: "Clinical signs of tabes dorsalis?", a: "Sensory ataxia, lightning pains, and loss of proprioception." },
            { q: "Classic presentation of syringomyelia?", a: "Capelike, bilateral loss of pain and temperature sensation across the shoulders and upper extremities with preserved touch." },
            { q: "Neuroanatomical structure compressed first by an expanding syrinx in syringomyelia?", a: "Anterior white commissure." },
            { q: "Spinal cord tracts degenerated in Amyotrophic Lateral Sclerosis?", a: "Corticospinal tracts and anterior horn cells." },
            { q: "Clinical physical exam findings characterizing Amyotrophic Lateral Sclerosis?", a: "Combined upper motor neuron and lower motor neuron signs without sensory loss." },
            { q: "Only approved medication demonstrated to modestly prolong survival in Amyotrophic Lateral Sclerosis?", a: "Riluzole." },
            { q: "Mechanism of action of riluzole in Amyotrophic Lateral Sclerosis?", a: "Decreases presynaptic glutamate release." },
            { q: "Spinal cord structures damaged in anterior spinal artery occlusion?", a: "Anterior two-thirds of the spinal cord, sparing the dorsal columns." },
            { q: "Clinical presentation of an anterior spinal artery infarction?", a: "Sudden bilateral loss of motor function and pain/temperature sensation below the lesion with preserved proprioception." },
            { q: "Diagnostic imaging step for a patient presenting with new onset spinal cord compression symptoms?", a: "Urgent emergent MRI of the entire spine." },
            { q: "Most common cause of neurogenic claudication?", a: "Lumbar spinal stenosis." },
            { q: "Classic physical positioning that relieves the pain of lumbar spinal stenosis?", a: "Flexion of the spine or leaning forward." },
            { q: "Clinical feature distinguishing neurogenic claudication from vascular claudication?", a: "Neurogenic claudication is strictly positional, while vascular claudication is volume-of-exertion dependent." },
            { q: "Classic neurological complication of untreated idiopathic intracranial hypertension?", a: "Progressive optic atrophy and permanent blindness. Section 17: Neuro-Toxicology & Drug-Induced Emergencies" },
            { q: "Classic neuroimaging finding in acute methanol poisoning?", a: "Bilateral necrosis of the putamen." },
            { q: "Clinical presentation of methanol poisoning distinguishing it from ethylene glycol toxicity?", a: "Severe visual impairment or blindness described as \"being in a snowstorm.\"" },
            { q: "Classic neuroimaging and clinical finding in ethylene glycol poisoning?", a: "Acute kidney injury with calcium oxalate crystals in the urine and cranial neuropathy." },
            { q: "Antidote used to competitively inhibit alcohol dehydrogenase in toxic alcohol ingestions?", a: "Fomepizole." },
            { q: "Life-threatening condition characterized by severe rigidity, hyperthermia, and autonomic instability following dopamine antagonist administration?", a: "Neuroleptic Malignant Syndrome." },
            { q: "First-line medical treatment for severe Neuroleptic Malignant Syndrome?", a: "Dantrolene or bromocriptine." },
            { q: "Pathophysiological cause of Serotonin Syndrome that distinguishes its physical exam from Neuroleptic Malignant Syndrome?", a: "Presence of neuromuscular hyperreactivity featuring hyperreflexia and clonus." },
            { q: "First-line pharmacological management for severe Serotonin Syndrome?", a: "Cyproheptadine." },
            { q: "Acute movement emergency presenting with involuntary sustained muscle contractions of the neck or tongue within hours of taking an antipsychotic?", a: "Acute dystonia." },
            { q: "First-line medication used to reverse an acute dystonic reaction?", a: "Intravenous or intramuscular benztropine or diphenhydramine. Section 18: Neurocutaneous Syndromes & Transitional Pathology" },
            { q: "Autosomal dominant neurocutaneous disorder presenting with café-au-lait spots, axillary freckling, and Lisch nodules?", a: "Neurofibromatosis Type 1." },
            { q: "Most common central nervous system tumors associated with Neurofibromatosis Type 2?", a: "Bilateral vestibular schwannomas." },
            { q: "Clinical presentation of Tuberous Sclerosis?", a: "Infantile spasms, ash-leaf spots, shagreen patches, and facial angiofibromas." },
            { q: "Classic neuroimaging findings associated with Tuberous Sclerosis?", a: "Cortical tubers and subependymal nodules." },
            { q: "Neurocutaneous syndrome characterized by a facial port-wine stain in the V1/V2 distribution and leptomeningeal angiomas?", a: "Sturge-Weber syndrome." },
            { q: "Primary neurological complication associated with Sturge-Weber syndrome?", a: "Refractory seizures and contralateral hemiparesis." },
            { q: "Central nervous system vascular tumors characteristically found in Von Hippel-Lindau disease?", a: "Hemangioblastomas of the retina and cerebellum. Section 19: Autonomic Bladder Disorders & Advanced Stroke Mimics" },
            { q: "Bladder dysfunction characterized by an overactive detrusor muscle due to a spinal cord lesion above T12?", a: "Neurogenic detrusor overactivity or spastic bladder." },
            { q: "Bladder dysfunction characterized by an underactive detrusor muscle due to a conus medullaris or cauda equina lesion?", a: "Flaccid bladder or detrusor arreflexia resulting in overflow incontinence." },
            { q: "Clinical condition presenting with acute stroke-like deficits following severe hypoglycemia?", a: "Neuroglycopenic focal deficit or hypoglycemia stroke mimic." },
            { q: "Immediate diagnostic step for any patient presenting with acute focal neurological deficits prior to ordering a head CT?", a: "Point-of-care fingerstick blood glucose measurement." },
            { q: "Clinical syndrome presenting with severe headache, visual changes, seizures, and posterior white matter edema on MRI?", a: "Posterior Reversible Encephalopathy Syndrome." },
            { q: "Most common systemic trigger for Posterior Reversible Encephalopathy Syndrome?", a: "Acute, severe hypertension or hypertensive emergency." },
            { q: "Clinical presentation of Transient Global Amnesia?", a: "Sudden onset of anterograde amnesia with repetitive questioning that completely resolves within 24 hours." },
            { q: "Diagnostic criteria distinguishing transient ischemic attacks from ischemic strokes?", a: "Transient ischemic attacks feature focal deficits lasting under 24 hours with absolutely no evidence of infarction on diffusion-weighted MRI. ===================================================================== =====================================================================" }
          ]
        },
