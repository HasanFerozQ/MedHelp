            { q: "Nerve providing sensation to the lower teeth?", a: "Inferior Alveolar Nerve (V3)." },
            { q: "Branch of the facial nerve that exits the skull but does not innervate facial expression muscles?", a: "Posterior Auricular Nerve." },
