            {
              "q": "Definition of a \"Paradoxical Embolus\"?",
              "a": "A systemic embolus that originates in the venous circulation but enters the arterial system through a septal defect (e.g., PFO)."
            },
            {
              "q": "Common clinical triad of Fat Embolism Syndrome?",
              "a": "Hypoxemia, Neurologic symptoms, and Petechial rash (24-72 hours post-fracture)."
            },
            {
              "q": "Definition of Red (Hemorrhagic) Infarct?",
              "a": "Occurs in venous occlusions, loose tissues (lung), or tissues with dual circulation (liver/small intestine)."
            },
            {
              "q": "Definition of White (Anemic) Infarct?",
              "a": "Occurs in arterial occlusions in solid organs with end-arterial circulation (heart, spleen, kidney)."
            },
            {
              "q": "The three stages of Shock?",
              "a": "1. Nonprogressive (compensated), 2. Progressive (hypoperfusion/metabolic imbalance), 3. Irreversible."
            },
            {
              "q": "Mode of inheritance for Marfan Syndrome?",
              "a": "Autosomal Dominant (Mutation in FBN1 gene, encoding Fibrillin-1)."
