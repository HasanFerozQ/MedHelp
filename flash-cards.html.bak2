            { q: "Serologic marker indicating active Hepatitis B replication?", a: "HBeAg." },
            { q: "Serologic marker indicating immunity to Hepatitis B (vaccination)?", a: "Anti-HBs only." },
            { q: "Serologic marker indicating immunity to Hepatitis B (prior infection)?", a: "Anti-HBs and Anti-HBc (IgG)." },
            { q: "First-line treatment for Hepatitis C (HCV)?", a: "Direct-acting antivirals (e.g., Sofosbuvir)." },
