                            },
                            {
                                      "q": "Standard treatment to induce differentiation in <b>APL</b>?",
                                      "a": "<b>All</b>-trans retinoic acid (ATRA)."
                            },
                            {
                                      "q": "Most common pediatric malignancy?",
                                      "a": "<b>Acute Lymphoblastic Leukemia</b> (<b>ALL</b>)."
                            },
                            {
                                      "q": "Marker for Pre-B and Pre-T <b>ALL</b>?",
                                      "a": "TdT (Terminal deoxynucleotidyl transferase)."
                            },
                            {
                                      "q": "Common translocation in B-<b>ALL</b> with a better prognosis?",
                                      "a": "<i>t</i>(12;21)."
                            },
                            {
                                      "q": "Hallmark lab finding in <b>Chronic Lymphocytic Leukemia</b> (<b>CLL</b>)?",
                                      "a": "Absolute lymphocytosis and \"<b>Smudge cells</b>\" on peripheral smear."
