  <!-- Premium Access Modal -->
  <div id="premium-modal" class="modal-overlay">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="grad-text">Unlock Premium Access</h2>
        <button class="close-modal" onclick="closePremiumModal()">×</button>
      </div>
      <div class="modal-body">
        <div class="premium-feature-list">
          <div class="feature-item">
            <div class="feature-icon">✨</div>
            <div class="feature-text">
              <strong>Full Curriculum Access</strong>
              <p>Unlock all 4 years and USMLE Step preparation modules.</p>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-icon">📚</div>
            <div class="feature-text">
              <strong>5,000+ Clinical MCQs</strong>
              <p>High-yield questions with detailed explanations and reasoning.</p>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-icon">⚡</div>
            <div class="feature-text">
              <strong>Interactive Flash Cards</strong>
              <p>Master concepts faster with our active recall system.</p>
            </div>
          </div>
        </div>
        
        <div class="pricing-box">
          <div class="price-value">$24.99<small>/year</small></div>
          <p>One-time annual payment. Cancel anytime.</p>
          <a href="https://prodat.gumroad.com/l/medical-exam-mastery" target="_blank" class="btn btn-primary" style="width: 100%; margin-top: 15px;">Get Instant Access</a>
        </div>

        <div class="license-entry">
          <p>Already have a license? Enter it below:</p>
          <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 12px;">
            <input type="text" id="license-key" placeholder="Gumroad License Key" style="width: 100%; padding: 12px; border-radius: 12px; border: 1px solid var(--border); background: var(--bg-body); color: var(--text-h); font-size: 14px;">
            <input type="email" id="license-email" placeholder="Email Address" style="width: 100%; padding: 12px; border-radius: 12px; border: 1px solid var(--border); background: var(--bg-body); color: var(--text-h); font-size: 14px;">
            <button class="btn btn-secondary" onclick="verifyLicense()" style="width: 100%; padding: 12px; border-radius: 12px; font-weight: 700; margin-top: 4px;">Activate Access</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .modal-overlay {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0,0,0,0.85); backdrop-filter: blur(8px);
      z-index: 10000; display: none; align-items: center; justify-content: center;
      padding: 20px;
    }
    .modal-overlay.visible { display: flex; }
    .modal-content {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 24px; max-width: 500px; width: 100%;
      padding: 32px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);
    }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
    .close-modal { background: none; border: none; font-size: 28px; color: var(--text-muted); cursor: pointer; }
    .feature-item { display: flex; gap: 16px; margin-bottom: 20px; text-align: left; }
    .feature-icon { font-size: 24px; }
    .feature-text strong { display: block; color: var(--text-h); font-size: 15px; }
    .feature-text p { font-size: 13px; color: var(--text-muted); margin-top: 2px; }
    .pricing-box { background: rgba(var(--accent-rgb),0.05); border: 1px solid rgba(var(--accent-rgb),0.2); border-radius: 16px; padding: 24px; margin: 24px 0; text-align: center; }
    .price-value { font-size: 32px; font-weight: 900; color: var(--accent); }
    .license-entry p { font-size: 12px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
  </style>

  <main class="flash-container">
    <div id="selection-view">
      <div style="text-align: center; margin-bottom: 40px;">
                        <h1 class="hero-h1">Medical Flashcards</h1>
        <p class="hero-sub" style="max-width: 780px; margin: 0 auto 20px;">Free active recall decks for MBBS &amp; USMLE students.</p>
      </div>

      <!-- ⚠️ Mobile Advisory Banner -->
      <div id="mobile-advisory" style="
        display: flex;
        margin: -10px auto 30px;
        max-width: 800px;
        padding: 14px 20px;
        background: linear-gradient(135deg, rgba(var(--amber-rgb),0.14), rgba(var(--amber-rgb),0.06));
        border: 1px solid rgba(var(--amber-rgb),0.45);
        border-radius: 12px;
        color: var(--amber-tint);
        font-size: 13px;
        font-weight: 600;
        text-align: center;
        align-items: center;
        justify-content: center;
        gap: 8px;
        backdrop-filter: blur(8px);
      ">
        💻&nbsp; <strong>Advisory:</strong> Use on desktop for better examination experience
      </div>

      <!-- Main Tabs -->
      <div class="tab-nav" id="main-tabs" style="justify-content: center;">
        <div class="tab-item active" data-tab="year1">1st Year</div>
        <div class="tab-item" data-tab="year2">2nd Year</div>
        <div class="tab-item" data-tab="year3">3rd Year</div>
        <div class="tab-item" data-tab="year4">4th Year</div>
        <div class="tab-item" data-tab="usmle1">USMLE 1</div>
        <div class="tab-item" data-tab="usmle2">USMLE 2</div>
        <div class="tab-item" data-tab="usmle3">USMLE 3</div>
      </div>

      <!-- Mobile Dropdown -->
      <select class="mobile-tab-select" id="mobile-tab-dropdown">
        <option value="year1">1st Year</option>
        <option value="year2">2nd Year</option>
        <option value="year3">3rd Year</option>
        <option value="year4">4th Year</option>
        <option value="usmle1">USMLE 1</option>
        <option value="usmle2">USMLE 2</option>
        <option value="usmle3">USMLE 3</option>
      </select>

      <!-- Topic Grid -->
      <div class="topic-grid" id="topic-grid">
        <!-- Topics injected here as cards -->
      </div>

            <div id="empty-state" class="empty-state hidden">
        <div style="margin-bottom: 20px; opacity: 0.5; display: flex; justify-content: center;">
          <i data-lucide="layers-2" style="width: 64px; height: 64px; stroke-width: 1;"></i>
        </div>
        <h3>No Flash Cards Yet</h3>
        <p>We are currently populating this section with high-yield content. Check back soon!</p>
      </div>

      <!-- FAQ & SEO Section -->
      <section class="faq-section" style="margin-top: 60px; text-align: left;">
        <div class="section-label">Flashcard FAQs</div>
        <h2 class="section-title">Common Questions</h2>
        <div class="faq-grid" id="faq-flashcards"></div>
      </section>

      <!-- Internal Navigation Section to keep users on site -->
      <section class="internal-tools-section" style="margin-top: 40px; padding: 32px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; text-align: center;">
        <h3 style="font-size: 18px; font-weight: 800; color: var(--text-h); margin-bottom: 8px;">Explore More Free MediHelp Resources</h3>
        <p style="color: var(--text-muted); font-size: 13px; max-width: 600px; margin: 0 auto 20px;">Use our patient advocacy and reference tools to check billing accuracy, lookup codes, or calculate clinical stats.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;">
          <a href="/cpt-code-search" class="btn btn-ghost" style="padding: 10px 20px; font-size: 13px; border-radius: 10px; text-decoration: none;">🔍 CPT &amp; ICD Code Lookup</a>
          <a href="/medical-calculator" class="btn btn-ghost" style="padding: 10px 20px; font-size: 13px; border-radius: 10px; text-decoration: none;">🧮 Bedside Clinical Calculators</a>
          <a href="/claim-denial-codes" class="btn btn-ghost" style="padding: 10px 20px; font-size: 13px; border-radius: 10px; text-decoration: none;">❌ Claim Denial Code Guide</a>
        </div>
      </section>
    </div>

    <!-- Flash Card Study View (Hidden by default) -->
    <div id="study-view" class="hidden">
      <div class="back-nav" onclick="exitStudyMode()">
        <i data-lucide="chevron-left" style="width: 20px; height: 20px; stroke-width: 3;"></i>
        Back to Topics
      </div>

      <div style="text-align: center; margin-bottom: 20px;">
        <h2 class="section-h" id="active-topic-name">Thorax</h2>
      </div>

      <div class="flash-card-scene">
        <div class="flash-card" id="card-element">
          <div class="flash-card-face flash-card-front">
            <div class="flash-card-label">Question</div>
            <div class="flash-card-text" id="front-text">Loading...</div>
          </div>
          <div class="flash-card-face flash-card-back">
            <div class="flash-card-label">Answer</div>
            <div class="flash-card-text" id="back-text">...</div>
          </div>
        </div>
      </div>

      <div class="flash-card-controls">
        <button class="flash-card-nav-btn" id="prev-btn" title="Previous Card">
          <i data-lucide="chevron-left" style="width: 24px; height: 24px; stroke-width: 3;"></i>
        </button>
        <div class="flash-card-counter" id="card-counter">0 / 0</div>
        <button class="flash-card-nav-btn" id="next-btn" title="Next Card">
          <i data-lucide="chevron-right" style="width: 24px; height: 24px; stroke-width: 3;"></i>
        </button>
      </div>
    </div>
  </main>

