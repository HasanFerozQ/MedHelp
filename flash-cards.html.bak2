                            {
                                      "q": "Condition associated with Thymic Hyperplasia?",
                                      "a": "Myasthenia Gravis (present in ~65-75% of cases)."
                            },
                            {
                                      "q": "Definition of a Thymoma?",
                                      "a": "Neoplasm of thymic epithelial cells (can be associated with Pure Red Cell Aplasia or Myasthenia Gravis).\n\nAdvanced Flow Cytometry & Markers"
                            },
                            {
                                      "q": "Pan-B cell markers used in flow cytometry?",
                                      "a": "CD19, CD20, and CD21."
                            },
                            {
                                      "q": "Pan-T cell markers used in flow cytometry?",
                                      "a": "CD2, CD3, CD5, and CD7."
                            },
                            {
                                      "q": "Surface marker used to identify hematopoietic stem cells (HSCs)?",
                                      "a": "CD34."
                            },
                            {
                                      "q": "Diagnostic markers for <b>Reed-Sternberg</b> cells?",
                                      "a": "CD15+ and CD30+."
                            },
                            {
                                      "q": "Classic immunophenotype for <b>Mantle Cell Lymphoma</b>?",
                                      "a": "CD5+, CD19+, and Cyclin D1+.\n\nMyeloid Neoplasms & Rare Variations"
                            },
                            {
                                      "q": "Clinical feature of Chronic Myelomonocytic Leukemia (CMML)?",
                                      "a": "Persistent monocytosis (>1,000/\u00b5L) and absence of the <b>Philadelphia chromosome</b>."
                            },
                            {
                                      "q": "Morphology of \"Faggot cells\" in <b>APL</b>?",
                                      "a": "Promyelocytes containing bundles of <b>Auer rods</b> in the cytoplasm."
                            },
                            {
                                      "q": "Significance of \"Hypersegmentation\" in Myelodysplastic Syndrome?",
                                      "a": "It is a sign of dysgranulopoiesis (though more common in <b>Megaloblastic Anemia</b>).\n\nHemostatic Disorders: Rare & Clinical"
                            },
                            {
                                      "q": "Mechanism of <b>Hemolytic Uremic Syndrome</b> (<b>HUS</b>)?",
