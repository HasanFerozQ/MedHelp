            {
              "q": "Definition of <b>Hypertrophy</b>?",
              "a": "Increase in the size of cells resulting in an increase in the size of the organ; no new cells."
            },
            {
              "q": "Definition of <b>Hyperplasia</b>?",
              "a": "Increase in the number of cells in an organ or tissue in response to a stimulus."
            },
            {
              "q": "What is <b>Metaplasia</b>?",
              "a": "A reversible change in which one adult cell type is replaced by another adult cell type (e.g., Barrett esophagus)."
            },
            {
              "q": "Hallmarks of irreversible cell injury?",
              "a": "Profound mitochondrial dysfunction and severe disturbances in membrane function (plasma and lysosomal)."
            },
            {
              "q": "Features of Pyknosis?",
              "a": "Nuclear shrinkage and increased basophilia."
            },
            {
              "q": "Features of Karyorrhexis?",
              "a": "Fragmentation of the pyknotic nucleus."
            },
            {
              "q": "Features of Karyolysis?",
              "a": "Fading of nuclear basophilia due to DNA degradation by endonucleases."
            },
            {
              "q": "Mechanism of Coagulative <b>Necrosis</b>?",
              "a": "Denaturation of structural proteins and enzymes, preserving the architecture of dead tissue for days (common in infarcts, except brain)."
            },
            {
              "q": "Main characteristic of Liquefactive <b>Necrosis</b>?",
              "a": "Digestion of dead cells into a liquid viscous mass; seen in focal bacterial/fungal infections and CNS hypoxic death."
            },
            {
              "q": "Definition of Caseous <b>Necrosis</b>?",
              "a": "\"Cheese-like\" friable white appearance; characteristic of a focus of inflammation known as a <b>granuloma</b> (e.g., Tuberculosis)."
            },
            {
              "q": "What is Fat <b>Necrosis</b>?",
              "a": "Focal areas of fat destruction typically resulting from the release of activated pancreatic lipases (saponification)."
            },
            {
              "q": "Fundamental mechanism of Fibrinoid <b>Necrosis</b>?",
              "a": "Complexes of antigens and antibodies deposited in the walls of arteries, appearing bright pink and amorphous on H&E."
            },
            {
              "q": "Pathological trigger for the Intrinsic (Mitochondrial) Pathway of <b>Apoptosis</b>?",
              "a": "Increased permeability of the mitochondrial outer membrane leading to the release of cytochrome c into the cytosol."
            },
            {
              "q": "Executioner Caspases in <b>Apoptosis</b>?",
              "a": "Caspase-3 and Caspase-6."
            },
            {
              "q": "Definition of <b>Dystrophic Calcification</b>?",
              "a": "Deposition of calcium salts in dead or dying tissues; occurs despite normal serum calcium levels."
            },
            {
              "q": "Definition of <b>Metastatic Calcification</b>?",
              "a": "Deposition of calcium salts in normal tissues due to hypercalcemia (e.g., hyperparathyroidism)."
            },
            {
              "q": "Five cardinal signs of <b>Acute Inflammation</b>?",
              "a": "Rubor (redness), Calor (heat), Tumor (swelling), Dolor (pain), and Functio laesa (loss of function)."
            },
            {
              "q": "Primary mediator of increased vascular permeability in immediate transient responses?",
              "a": "Histamine (acting on postcapillary venules)."
            },
            {
              "q": "Sequence of Leukocyte Extravasation?",
              "a": "1. Margination/Rolling, 2. Adhesion, 3. Transmigration (Diapedesis), 4. Chemotaxis."
            },
            {
              "q": "Molecules responsible for Leukocyte Rolling?",
              "a": "Selectins (E-selectin, P-selectin, L-selectin)."
            },
            {
              "q": "Molecules responsible for Firm Adhesion of leukocytes?",
              "a": "Integrins (e.g., VLA-4, LFA-1) binding to ICAM-1 and VCAM-1."
            },
            {
              "q": "Major Opsonins in <b>phagocytosis</b>?",
              "a": "IgG, C3b, and Mannose-binding lectin."
            },
            {
              "q": "Key enzyme in the Respiratory Burst?",
              "a": "NADPH Oxidase (converts O<sub>2</sub> to Superoxide)."
            },
            {
              "q": "Genetic defect in Chronic Granulomatous Disease (CGD)?",
              "a": "Deficiency in NADPH Oxidase."
            },
            {
              "q": "Principal mediator of Pain in <b>acute inflammation</b>?",
              "a": "Bradykinin and Prostaglandins (PGE<sub>2</sub>)."
            },
            {
              "q": "Definition of a <b>Granuloma</b>?",
              "a": "A collection of activated macrophages (epithelioid cells) rimmed by lymphocytes; a form of <b>chronic inflammation</b>."
            },
            {
              "q": "Cytokine primarily responsible for attracting and activating neutrophils?",
              "a": "IL-8."
            },
            {
              "q": "Cytokines responsible for the Systemic Acute-Phase Response (Fever)?",
              "a": "TNF, IL-1, and IL-6."
            },
            {
              "q": "Function of Metalloproteinases (MMPs) in tissue repair?",
              "a": "Degrade collagen and other ECM components to allow for remodeling of the scar."
            },
            {
              "q": "Components of Granulation Tissue?",
              "a": "Fibroblasts, delicate capillaries (angiogenesis), and scattered inflammatory cells."
            },
            {
              "q": "Difference between Primary and Secondary Union (Intention)?",
              "a": "<b>Primary:</b> Clean surgical incision; Secondary: Large tissue defect requiring extensive contraction and scarring."
            },
            {
              "q": "Definition of Anasarca?",
              "a": "Severe and generalized edema with widespread subcutaneous tissue swelling."
            },
            {
              "q": "Virchow<sub>s</sub> Triad for Thrombosis?",
              "a": "1. Endothelial injury, 2. Stasis or turbulent blood flow, 3. Hypercoagulability."
            },
            {
              "q": "Define \"Lines of Zahn\"?",
              "a": "Laminations in a thrombus representing alternating layers of platelets/fibrin (pale) and RBCs (dark); signifies formation in flowing blood."
