                            },
                            {
                                      "q": "Potential complication of <b>PID</b> involving the liver?",
                                      "a": "<b>Fitz-Hugh-Curtis Syndrome</b> (violin-string adhesions to the liver capsule)."
                            },
                            {
                                      "q": "Diagnostic finding in <b>Bacterial Vaginosis</b>?",
                                      "a": "\"Clue cells\" (vaginal epithelial cells covered in bacteria).\n\nAdvanced Concepts & Syndromes"
                            },
                            {
                                      "q": "Common genetic mutation in <b>Polycystic Ovarian Syndrome</b> (<b>PCOS</b>)?",
                                      "a": "Hyperinsulinemia leading to deranged LH:FSH ratio (>2:1)."
