            },
            {
              "q": "HBeAg signifies?",
              "a": "Active viral replication and high transmissibility."
            },
            {
              "q": "Anti-HBs signifies?",
              "a": "Immunity (either via recovery or vaccination)."
            },
            {
              "q": "Anti-HBc (Total) with negative HBsAg signifies?",
              "a": "The \"Window Period\" or a distant resolved infection."
            },
            {
              "q": "Most common cause of \"Culture-negative\" endocarditis?",
              "a": "<i>Coxiella burnetii</i> and HACEK organisms."
            },
            {
              "q": "Primary infection site for <i>Nocardia</i>?",
              "a": "Lungs (mimics TB; but Gram-positive and weakly acid-fast)."
            },
            {
              "q": "Mechanism of Erythrogenic toxin?",
              "a": "Superantigen; causes Scarlet Fever."
            },
            {
              "q": "Virus that causes progressive multifocal leukoencephalopathy (PML)?",
              "a": "JC Virus (Polyomavirus)."
            },
            {
              "q": "Most common cause of myocarditis?",
              "a": "Coxsackievirus B."
            },
            {
              "q": "Bacteria associated with colon cancer when found in the blood?",
              "a": "<i>Streptococcus gallolyticus</i> (formerly S. bovis)."
            },
            {
              "q": "Most common cause of osteomyelitis in intravenous drug users (IVDUs)?",
              "a": "<i>Pseudomonas aeruginosa</i> (and <i>S. aureus</i>)."
            },
            {
              "q": "A patient presents with \"Bell\u2019s Palsy\" and a history of hiking in Connecticut. Diagnosis?",
              "a": "Lyme Disease (<i>Borrelia burgdorferi</i>)."
            },
            {
              "q": "Classic diagnostic find in the CSF of a patient with HSV-1 encephalitis?",
              "a": "Increased RBCs (hemorrhagic necrosis of temporal lobes)."
            },
            {
              "q": "Bacteria associated with \"Double zone of hemolysis\" on blood agar?",
              "a": "Clostridium perfringens."
            },
            {
              "q": "Most common cause of \"Spontaneous Bacterial Peritonitis\" (SBP)?",
              "a": "<i>E. coli</i> (followed by <i>Klebsiella</i>)."
            },
            {
              "q": "Causative agent of \"Erysipeloid\" (occupational hazard for butchers/fishermen)?",
              "a": "Erysipelothrix rhusiopathiae."
            },
            {
              "q": "Common cause of pneumonia in Alcoholics?",
              "a": "<i>Klebsiella pneumoniae</i>."
            },
            {
              "q": "Common cause of pneumonia in Cystic Fibrosis patients?",
              "a": "<i>Pseudomonas aeruginosa</i> (adults) and <i>S. aureus</i> (children)."
            },
            {
              "q": "Specialized transduction is a feature of which five toxins?",
              "a": "ABCD'S (Group A Strep toxin, Botulinum toxin, Cholera toxin, Diphtheria toxin, Shiga toxin)."
            },
            {
              "q": "The \"<b>Quellung Reaction</b>\" (capsular swelling) is positive for which organisms?",
              "a": "Encapsulated organisms (e.g., <i>S. pneumoniae</i>, <i>H. influenzae</i>, <i>N. meningitidis</i>)."
            },
            {
              "q": "Nutrient required by <i>Vibrio vulnificus</i> for growth?",
              "a": "Iron (patients with hemochromatosis are at high risk)."
            },
            {
              "q": "Only bacteria with a polypeptide capsule (containing D-glutamate)?",
              "a": "<i>Bacillus anthracis</i>."
            },
            {
              "q": "Cause of Neurocysticercosis?",
              "a": "Ingestion of <i>Taenia solium</i> eggs (not larvae)."
            },
            {
              "q": "Parasite associated with Vitamin B12 deficiency (Megaloblastic anemia)?",
              "a": "Diphyllobothrium latum (Fish tapeworm)."
            },
            {
              "q": "Characteristic of \"Hydatid cysts\" in the liver?",
              "a": "<i>Echinococcus granulosus</i> (eggs from dog feces)."
            },
            {
              "q": "Intermediate host for all Trematodes (Flukes)?",
              "a": "Freshwater snails."
            },
            {
              "q": "Parasite associated with Biliary Tract Disease and Cholangiocarcinoma?",
              "a": "<i>Clonorchis sinensis</i>."
            },
            {
              "q": "Cellular receptor for <i>Parvovirus</i> B19?",
              "a": "Erythrocyte P antigen."
            },
            {
              "q": "Cellular receptor for Rabies virus?",
              "a": "Nicotinic Acetylcholine Receptor (AChR)."
            },
            {
              "q": "Primary cause of \"Aseptic Meningitis\"?",
              "a": "Enteroviruses (Coxsackievirus, Echovirus)."
            },
            {
              "q": "Virus that causes \"Orchitis\" leading to potential sterility in males?",
              "a": "Mumps virus."
            },
            {
              "q": "\"<b>Guarnieri bodies</b>\" are cytoplasmic inclusions found in?",
              "a": "Poxvirus (Smallpox/Molluscum)."
            },
            {
              "q": "The \"<b>Tzanck smear</b>\" looks for?",
              "a": "Multinucleated giant cells (indicative of HSV-1, HSV-2, or VZV)."
            },
            {
              "q": "Mechanism of Oseltamivir (Tamiflu)?",
              "a": "Inhibits Neuraminidase (prevents progeny release)."
            },
            {
              "q": "Mechanism of Griseofulvin?",
              "a": "Interferes with microtubule function; inhibits mitosis."
            },
            {
              "q": "Main side effect of Ganciclovir?",
              "a": "Bone marrow suppression (leukopenia/thrombocytopenia)."
            },
            {
              "q": "Drug used to treat Chronic Hepatitis C (NS5A inhibitor)?",
              "a": "Ledipasvir (or any drug ending in \"-asvir\")."
            },
            {
              "q": "Major side effect of Amphotericin B?",
              "a": "Nephrotoxicity (\"Amphoterrible\")."
            },
            {
              "q": "Media used for Corynebacterium diphtheriae?",
              "a": "L\u00f6ffler medium or Tellurite agar."
            },
            {
              "q": "Media used for <i>Bordetella pertussis</i>?",
              "a": "Bordet-Gengou (potato) agar or Regan-Lowe medium."
            },
            {
              "q": "Organism identified via \"Cold Enrichment\"?",
              "a": "<i>Listeria monocytogenes</i>."
            },
            {
              "q": "Positive \"<b>Nagler Reaction</b>\" identifies?",
              "a": "Clostridium perfringens (alpha-toxin/lecithinase activity)."
            },
            {
              "q": "\"Weil's Disease\" triad?",
              "a": "Jaundice, Azotemia (renal failure), and Hemorrhage (from <i>Leptospira interrogans</i>)."
            },
            {
              "q": "Cause of \"Malignant Otitis Externa\" in Diabetics?",
              "a": "<i>Pseudomonas aeruginosa</i>."
            },
            {
              "q": "Common cause of infection following human bites?",
              "a": "Eikenella corrodens."
            },
            {
              "q": "Mechanism of resistance for Penicillins?",
              "a": "Penicillinase (Beta-lactamase) or altered Penicillin-Binding Proteins (PBP)."
            },
            {
              "q": "Only DNA virus that is NOT icosahedral?",
              "a": "Poxvirus (complex, brick-shaped)."
            },
            {
              "q": "Difference between <i>N. meningitidis</i> and <i>N. gonorrhoeae</i> sugar fermentation?",
              "a": "Meningitidis ferments Maltose and Glucose; Gonorrhoeae only ferments Glucose."
            },
            {
              "q": "Bacteria that causes \"Water-borne\" outbreaks in daycare centers?",
              "a": "<i>Giardia lamblia</i> (protozoa) or Shigella."
            },
            {
              "q": "Leading cause of neonatal sepsis?",
              "a": "<i>Streptococcus agalactiae</i> (Group B Strep)."
            },
            {
              "q": "Most common cause of Myocarditis in the US?",
              "a": "Coxsackie B virus."
            },
            {
              "q": "Bacteria that produces a toxin that \"locks\" the jaw?",
              "a": "Clostridium tetani."
            },
            {
              "q": "Patients with Chronic Granulomatous Disease (CGD) are susceptible to which type of organisms?",
              "a": "Catalase-positive organisms (e.g., <i>S. aureus</i>, <i>Aspergillus</i>, <i>Serratia</i>)."
            },
            {
              "q": "Primary immune deficiency associated with recurrent <i>Neisseria</i> infections?",
              "a": "Terminal Complement Deficiency (C5\u2013C9)."
            },
            {
              "q": "Type of immunity required to clear <i>Listeria</i> or <i>Mycobacterium</i>?",
              "a": "Cell-mediated immunity (T-cells/Macrophages), as they are intracellular."
            },
            {
              "q": "Mechanism of Superantigens (e.g., TSST-1)?",
              "a": "Cross-link the Beta-region of T-cell receptor to MHC Class II; causes massive cytokine storm (IL-1, IL-2, IFN-&gamma;, TNF-&alpha;)."
            },
            {
              "q": "Fungus with \"Broad-based budding\" found in the Great Lakes region?",
              "a": "<i>Blastomyces dermatitidis</i>."
            },
            {
              "q": "Culture medium specifically for fungi?",
              "a": "Sabouraud dextrose agar."
            },
            {
              "q": "Most common cause of \"fungal\" pneumonia in AIDS patients with CD4 &lt; 200?",
              "a": "Pneumocystis jirovecii."
            },
            {
              "q": "Visualizing Pneumocystis jirovecii requires which stain?",
              "a": "Silver stain (Gomori Methenamine Silver)."
            },
            {
              "q": "Causative agent of \"Verruga peruana\" (skin nodules) and \"Oroya fever\" (anemia)?",
              "a": "<i>Bartonella bacilliformis</i>."
            },
            {
              "q": "Vector for <i>Trypanosoma brucei</i> (African Sleeping Sickness)?",
              "a": "Tsetse fly."
            },
            {
              "q": "\"Winterbottom sign\" (posterior cervical lymphadenopathy) is seen in?",
              "a": "African Sleeping Sickness (<i>T. brucei</i>)."
            },
            {
              "q": "Mechanism of \"Antigenic Variation\" in <i>Trypanosoma brucei</i>?",
              "a": "Programmed rearrangement of Variable Surface Glycoproteins (VSG)."
            },
            {
              "q": "Organism causing \"Rat-bite fever\"?",
              "a": "Streptobacillus moniliformis."
            },
            {
              "q": "Bacteria that produces a \"blue-green\" pigment (Pyocyanin)?",
              "a": "<i>Pseudomonas aeruginosa</i>."
            },
            {
              "q": "Bacteria that produces a \"red\" pigment?",
              "a": "<i>Serratia marcescens</i>."
            },
            {
              "q": "Bacteria that produces a \"yellow\" pigment?",
              "a": "<i>Staphylococcus aureus</i> (\"Aureus\" = gold)."
            },
            {
              "q": "The \"Satellite Phenomenon\" involves <i>H. influenzae</i> growing around which organism?",
              "a": "<i>Staphylococcus aureus</i> (which provides Factor V/NAD)."
            },
            {
              "q": "\"Comma-shaped\" bacteria that grows in alkaline media?",
              "a": "<i>Vibrio cholerae</i>."
            },
            {
              "q": "\"S-shaped\" or \"Seagull-wing\" shaped bacteria?",
              "a": "<i>Campylobacter jejuni</i>."
            },
            {
              "q": "Most common cause of viral \"Pink Eye\" (Conjunctivitis)?",
              "a": "Adenovirus."
            },
            {
              "q": "Only RNA virus that is Double-Stranded?",
              "a": "Reovirus (e.g., Rotavirus)."
            },
            {
              "q": "Virus that causes \"Aplastic Crisis\" in Sickle Cell patients?",
              "a": "<i>Parvovirus</i> B19."
            },
            {
              "q": "Difference between <i>Variola</i> (Smallpox) and <i>Varicella</i> (Chickenpox) rashes?",
              "a": "<i>Variola</i>: same stage of development. <i>Varicella</i>: multiple stages (\"dewdrops on a rose petal\")."
            },
            {
              "q": "Leading cause of \"Fatal Diarrhea\" in children worldwide?",
              "a": "Rotavirus."
            },
            {
              "q": "Drug of choice for Bacteroides fragilis (anaerobe)?",
              "a": "Metronidazole."
            },
            {
              "q": "Mechanism of Daptomycin?",
              "a": "Disrupts cell membrane of Gram-positive cocci via depolarization."
            },
            {
              "q": "Why is Daptomycin ineffective for pneumonia?",
              "a": "It is inactivated by pulmonary surfactant."
            },
            {
              "q": "Mechanism of Linezolid?",
              "a": "Inhibits protein synthesis by binding to the 50S subunit and preventing formation of the 70S initiation complex."
            },
            {
              "q": "Classic side effect of Linezolid?",
              "a": "Bone marrow suppression (thrombocytopenia) and Serotonin Syndrome."
            },
            {
              "q": "Only bacteria with a \"Sterol\" containing membrane?",
              "a": "<i>Mycoplasma pneumoniae</i>."
            },
            {
              "q": "Only bacteria with a \"Polypeptide\" capsule?",
              "a": "<i>Bacillus anthracis</i>."
            },
            {
              "q": "Only DNA virus that replicates in the Cytoplasm?",
              "a": "Poxvirus."
            },
            {
              "q": "Only RNA virus that is \"Circular\"?",
              "a": "Delta virus (Hepatitis D), Bunya, and Arena viruses."
            },
            {
              "q": "\"Sulfur granules\" in draining sinus tracts?",
              "a": "<i>Actinomyces israelii</i>."
            },
            {
              "q": "\"Splinter hemorrhages\" and \"Janeway lesions\" suggest?",
              "a": "Infective Endocarditis (often <i>S. aureus</i> or Viridans strep)."
            },
            {
              "q": "Infection associated with \"Reiter Syndrome\" (Reactive Arthritis)?",
              "a": "<i>Chlamydia</i>, Shigella, <i>Salmonella</i>, Campylobacter, or <i>Yersinia</i>."
            },
            {
              "q": "Bacteria associated with \"Hot Tub Folliculitis\"?",
              "a": "<i>Pseudomonas aeruginosa</i>."
            },
            {
              "q": "Causative agent of \"Melioidosis\"?",
              "a": "Burkholderia pseudomallei."
            },
            {
              "q": "Drug used for Leishmaniasis?",
              "a": "Sodium Stibogluconate."
            },
            {
              "q": "Diagnostic feature of Giardia in stool?",
              "a": "Pear-shaped trophozoites with two nuclei (\"Owl\u2019s eyes\")."
            },
            {
              "q": "Most common cause of \"Brain Abscess\" from dental infection?",
              "a": "Viridans streptococci or <i>Fusobacterium</i>."
            },
            {
              "q": "A patient with HIV has a CD4 count &lt; 50. What is the primary prophylaxis for <i>Mycobacterium</i> avium complex (MAC)?",
              "a": "Azithromycin or Clarithromycin."
            },
            {
              "q": "Most common cause of \"Food Poisoning\" from reheated rice?",
              "a": "<i>Bacillus cereus</i>."
            },
            {
              "q": "\"<b>Thumbprint sign</b>\" on lateral X-ray of the neck?",
              "a": "Epiglottitis (typically <i>Haemophilus influenzae</i> type B)."
            },
            {
              "q": "\"<b>Steeple sign</b>\" on AP X-ray of the neck?",
              "a": "Croup (Laryngotracheobronchitis caused by Parainfluenza virus)."
            },
            {
              "q": "Primary infection site for <i>Blastomyces dermatitidis</i>?",
              "a": "Lungs (often disseminates to skin and bone)."
            },
            {
              "q": "Most common cause of meningitis in adults (all ages combined)?",
              "a": "<i>Streptococcus pneumoniae</i>."
            },
            {
              "q": "Most common cause of meningitis in teenagers/young adults in dorms?",
              "a": "<i>Neisseria meningitidis</i>."
            },
            {
              "q": "Most common cause of UTIs in young, sexually active females (second to <i>E. coli</i>)?",
              "a": "<i>Staphylococcus saprophyticus</i>."
            },
            {
              "q": "Most common cause of fungal endocarditis in IV drug users?",
              "a": "<i>Candida albicans</i>."
            },
            {
              "q": "Which bacteria contains a \"Vi capsular antigen\"?",
              "a": "<i>Salmonella</i> Typhi."
            },
            {
              "q": "Mechanism of the \"Toxic Shock Syndrome Toxin-1\" (TSST-1)?",
              "a": "Superantigen that binds to MHC II and T-cell receptor (TCR) simultaneously, causing massive IFN-&gamma; and IL-2 release."
            },
            {
              "q": "Identification of Enterococcus species on agar?",
              "a": "Growth in 6.5% NaCl and ability to hydrolyze esculin in the presence of bile (Bile Esculin agar)."
            },
            {
              "q": "Only RNA virus with a \"bullet-shaped\" envelope?",
              "a": "Rabies virus (Rhabdovirus)."
            },
            {
              "q": "Virus that uses the \"CCR5\" or \"CXCR4\" co-receptors for entry?",
              "a": "HIV (gp120 binds to these after binding CD4)."
            },
            {
              "q": "\"Loeffler syndrome\" is associated with the pulmonary phase of which parasite?",
              "a": "<i>Ascaris lumbricoides</i>."
            },
            {
              "q": "Parasite associated with \"Iron Deficiency Anemia\" due to blood sucking in the GI tract?",
              "a": "<i>Ancylostoma duodenale</i> or <i>Necator americanus</i> (Hookworms)."
            },
            {
              "q": "Diagnosis of <i>Schistosoma</i> mansoni via stool sample?",
              "a": "Eggs with a prominent \"Lateral Spine.\""
            },
            {
              "q": "Diagnosis of <i>Schistosoma haematobium</i> via urine sample?",
              "a": "Eggs with a prominent \"Terminal Spine.\""
            },
            {
              "q": "Treatment for most Trematodes (Flukes) and Cestodes (Tapeworms)?",
              "a": "Praziquantel."
            },
            {
              "q": "\"<b>Elek test</b>\" is used to detect the toxin of which organism?",
              "a": "<i>Corynebacterium diphtheriae</i>."
            },
            {
              "q": "\"Warthin-Starry stain\" (silver stain) is used to visualize which two common pathogens?",
              "a": "<i>Bartonella henselae</i> and <i>Helicobacter pylori</i>."
            },
            {
              "q": "The \"<b>Nagler Test</b>\" for <i>C. perfringens</i> detects the activity of?",
              "a": "Alpha-toxin (Lecithinase)."
            },
            {
              "q": "Media used to isolate <i>Vibrio cholerae</i> from stool?",
              "a": "TCBS (Thiosulfate-Citrate-Bile salts-Sucrose) agar."
            },
            {
              "q": "\"Chocolate agar\" contains which two specific factors?",
              "a": "Factor X (Hematin) and Factor V (NAD)."
            },
            {
              "q": "Resistance to Methicillin (MRSA) is mediated by alterations in?",
              "a": "Penicillin-Binding Proteins (PBP 2a), encoded by the mecA gene."
            },
            {
              "q": "Mechanism of Vancomycin resistance in Enterococci (VRE)?",
              "a": "Alteration of the D-Ala-D-Ala terminal to D-Ala-D-Lac."
            },
            {
              "q": "Drug of choice for Lyme Disease in a child &lt; 8 years old?",
              "a": "Amoxicillin (Doxycycline is avoided due to tooth discoloration)."
            },
            {
              "q": "Antibiotic that can cause \"Gray Baby Syndrome\"?",
              "a": "Chloramphenicol (due to lack of liver UDP-glucuronosyltransferase)."
            },
            {
              "q": "Antibiotic class that can cause \"Tendon Rupture\" (Achilles)?",
              "a": "Fluoroquinolones."
            },
            {
              "q": "Infection following a \"Human Bite\"?",
              "a": "Eikenella corrodens."
            },
            {
              "q": "Infection following a \"Clutch of Chickens\" or \"Reptiles\"?",
              "a": "Non-typhoidal <i>Salmonella</i>."
            },
            {
              "q": "Infection following \"Skinning a Rabbit\"?",
              "a": "<i>Francisella tularensis</i>."
            },
            {
              "q": "Infection following \"Exposure to Parrot/Bird Feces\"?",
              "a": "<i>Chlamydia</i> psittaci."
            },
            {
              "q": "Virus that causes \"Aplastic Crisis\" in patients with hereditary spherocytosis?",
              "a": "<i>Parvovirus</i> B19."
            },
            {
              "q": "Primary cause of \"Hemorrhagic Fever\" with renal syndrome?",
              "a": "Hantavirus (Bunyavirus)."
            },
            {
              "q": "The only \"Live Attenuated\" vaccine given to HIV patients (if CD4 &gt; 200)?",
              "a": "MMR and <i>Varicella</i>."
            },
            {
              "q": "<b>Koplik spots</b> are a prodromal sign of?",
              "a": "Measles (Rubeola)."
            }
          ]
        }


      ,
        {
                  "topic": "General Hematology",
                  "icon": "droplet",
                  "cards": [
                            {
                                      "q": "Rate-limiting step of Heme synthesis?",
                                      "a": "&delta;-aminolevulinic acid (ALA) synthase (requires <b>Vitamin B6</b>)."
                            },
                            {
                                      "q": "Location of the <b>erythropoietin</b> (<b>EPO</b>) sensor in the kidney?",
                                      "a": "Peritubular interstitial cells of the renal cortex."
                            },
                            {
                                      "q": "What state must iron be in to bind Oxygen?",
                                      "a": "Ferrous state (Fe<sup>2+</sup>). (\"It 2nd-ly binds O<sub>2</sub>\")."
                            },
                            {
                                      "q": "Major hemoglobin type in adults (<b>HbA1</b>) composition?",
                                      "a": "&alpha;<sub>2</sub>&beta;<sub>2</sub>."
                            },
                            {
                                      "q": "Major hemoglobin type in fetuses (<b>HbF</b>) composition?",
                                      "a": "&alpha;<sub>2</sub>&gamma;<sub>2</sub>."
                            },
                            {
                                      "q": "Why does <b>HbF</b> have higher oxygen affinity than HbA?",
                                      "a": "Decreased binding of 2,3-BPG to the &gamma;-subunits."
                            },
                            {
                                      "q": "Define \"<i>Reticulocyte</i> Index\" (RI) indicating adequate marrow response to anemia.",
                                      "a": "RI &gt; 2%."
                            },
                            {
                                      "q": "Most common cause of <b>Iron Deficiency</b> Anemia in elderly males?",
                                      "a": "GI blood loss (occult malignancy until proven otherwise)."
                            },
                            {
                                      "q": "Lab findings in <b>Iron Deficiency</b> Anemia (Ferritin, TIBC, Serum Fe)?",
                                      "a": "&darr; Ferritin, &uarr; TIBC, &darr; Serum Iron."
                            },
                            {
                                      "q": "Classic triad of <b>Plummer-Vinson Syndrome</b>?",
                                      "a": "<b>Iron deficiency</b> anemia, Esophageal webs, Glossitis."
                            },
                            {
                                      "q": "Primary defect in <b>Sideroblastic Anemia</b>?",
                                      "a": "Protoporphyrin synthesis defect (<b>lead poisoning</b>, <b>Vitamin B6</b> deficiency, X-linked <b>ALA synthase</b> defect)."
                            },
                            {
                                      "q": "Classic biopsy finding in <b>Sideroblastic Anemia</b> (Prussian Blue stain)?",
                                      "a": "Ringed sideroblasts (iron-laden mitochondria surrounding the nucleus)."
                            },
                            {
                                      "q": "Genetic defect in &alpha;-<b>Thalassemia</b>?",
                                      "a": "Gene deletion (Chromosome 16)."
                            },
                            {
                                      "q": "Genetic defect in &beta;-<b>Thalassemia</b>?",
                                      "a": "Point mutation in splice sites/promoter sequences (Chromosome 11)."
                            },
                            {
                                      "q": "Hemoglobin electrophoresis finding in &beta;-<b>Thalassemia</b> Minor?",
                                      "a": "&uarr; HbA2 (&gt; 3.5%)."
                            },
                            {
                                      "q": "Skull X-ray finding in &beta;-<b>Thalassemia</b> Major?",
                                      "a": "\"Crew-cut\" appearance (marrow expansion)."
                            },
                            {
                                      "q": "Basophilic stippling is most associated with which Microcytic Anemia?",
                                      "a": "<b>Lead Poisoning</b> (inhibition of pyrimidine 5'-nucleotidase)."
                            },
                            {
                                      "q": "Distinguishing lab finding between <b>B12</b> and <b>Folate</b> deficiency?",
                                      "a": "Methylmalonic acid (MMA) is elevated in <b>B12</b> deficiency ONLY."
                            },
                            {
                                      "q": "Neurological symptom associated with <b>B12</b> deficiency?",
                                      "a": "Subacute Combined Degeneration (<b>SCD</b>) of the spinal cord (dorsal columns/lateral corticospinal tract)."
                            },
                            {
                                      "q": "Most common cause of Vitamin <b>B12</b> deficiency?",
                                      "a": "<b>Pernicious Anemia</b> (anti-intrinsic factor antibodies)."
                            },
                            {
                                      "q": "Type of cell seen on peripheral smear in <b>Megaloblastic Anemia</b>?",
                                      "a": "Hypersegmented neutrophils (&gt; 5 lobes)."
                            },
                            {
                                      "q": "Common drug causes of <b>Folate</b> deficiency?",
                                      "a": "Phenytoin, Methotrexate, Trimethoprim."
                            },
                            {
                                      "q": "Two major categories of Normocytic Anemia based on <i>Reticulocyte</i> Count?",
                                      "a": "Hemolytic (High RC) vs. Non-hemolytic/Underproduction (Low RC)."
                            },
                            {
                                      "q": "Intravascular Hemolysis: Serum Haptoglobin levels?",
                                      "a": "Decreased (Haptoglobin binds free Hemoglobin)."
                            },
                            {
                                      "q": "Confirmatory test for Hereditary Spherocytosis?",
                                      "a": "Osmotic Fragility Test (or Eosin-5-maleimide flow cytometry)."
                            },
                            {
                                      "q": "Mechanism of Paroxysmal Nocturnal Hemoglobinuria (<b>PNH</b>)?",
                                      "a": "Acquired PIGA gene mutation &rarr; deficiency of GPI anchor &rarr; loss of CD55/CD59 (complement inhibitors)."
                            },
                            {
                                      "q": "Triad of <b>PNH</b>?",
                                      "a": "<b>Coombs</b>-negative hemolytic anemia, Pancytopenia, Venous thrombosis (e.g., <b>Budd-Chiari</b>)."
                            },
                            {
                                      "q": "Amino acid substitution in <b>Sickle Cell</b> Anemia (HbS)?",
                                      "a": "Glutamic acid to Valine at position 6 of &beta;-globin chain."
                            },
                            {
                                      "q": "Amino acid substitution in Hemoglobin C (HbC)?",
                                      "a": "Glutamic acid to Lysine at position 6 of &beta;-globin chain. (\"LyCine\")."
                            },
                            {
                                      "q": "Most common trigger for <b>G6PD</b> deficiency oxidative stress?",
                                      "a": "Fava beans, Infections, Sulfa drugs, Primaquine."
                            },
                            {
                                      "q": "Histologic hallmark of <b>G6PD</b> deficiency?",
                                      "a": "<b>Heinz bodies</b> and <b>Bite cells</b>."
                            },
                            {
                                      "q": "Warm Agglutinin AIHA: Antibody type and association?",
                                      "a": "IgG; associated with SLE and CLL."
                            },
                            {
                                      "q": "Cold Agglutinin AIHA: Antibody type and association?",
                                      "a": "IgM; associated with <i>Mycoplasma</i> pneumoniae and Mononucleosis."
                            },
                            {
                                      "q": "Translocation associated with Chronic Myeloid Leukemia (<b>CML</b>)?",
                                      "a": "t(9;22); BCR-ABL (<b>Philadelphia chromosome</b>)."
                            },
                            {
                                      "q": "Marker used to differentiate <b>CML</b> from a Leukemoid Reaction?",
                                      "a": "Leukocyte Alkaline Phosphatase (LAP). Low in <b>CML</b>, High in Leukemoid Reaction."
                            },
                            {
                                      "q": "Classic marker for Acute Myeloid Leukemia (<b>AML</b>)?",
                                      "a": "<b>Auer Rods</b> (MPO positive)."
                            },
                            {
                                      "q": "Specific treatment for <b>AML</b> M3 (Acute Promyelocytic Leukemia)?",
                                      "a": "<b>All</b>-trans Retinoic Acid (<b>ATRA</b>)."
                            },
                            {
                                      "q": "Most common childhood leukemia?",
                                      "a": "Acute Lymphoblastic Leukemia (<b>ALL</b>)."
                            },
                            {
                                      "q": "Translocation associated with Burkitt Lymphoma?",
                                      "a": "t(8;14); c-myc activation."
                            },
                            {
                                      "q": "Translocation associated with Follicular Lymphoma?",
                                      "a": "t(14;18); BCL-2 activation."
                            },
                            {
                                      "q": "Translocation associated with Mantle Cell Lymphoma?",
                                      "a": "t(11;14); Cyclin D1 activation."
                            },
                            {
                                      "q": "Diagnostic cell for <b>Hodgkin Lymphoma</b>?",
                                      "a": "<b>Reed-Sternberg</b> cell (\"Owl's eye\" appearance; CD15+, CD30+)."
                            },
                            {
                                      "q": "Clinical hallmark of <b>Multiple Myeloma</b>?",
                                      "a": "<b>CRAB</b>: Hypercalcemia, Renal insufficiency, Anemia, Bone lytic lesions."
                            },
                            {
                                      "q": "Pathognomonic urine finding in <b>Multiple Myeloma</b>?",
                                      "a": "<b>Bence-Jones</b> protein (Ig light chains)."
                            },
                            {
                                      "q": "Role of von Willebrand Factor (<b>vWF</b>) in primary hemostasis?",
                                      "a": "Adhesion of platelets to subendothelial collagen via <b>GpIb</b> receptor."
                            },
                            {
                                      "q": "Platelet receptor for Fibrinogen (aggregation)?",
                                      "a": "<b>GpIIb/IIIa</b>."
                            },
                            {
                                      "q": "Coagulation factor deficiency in Hemophilia A?",
                                      "a": "Factor VIII."
                            },
                            {
                                      "q": "Coagulation factor deficiency in Hemophilia B?",
                                      "a": "Factor IX."
                            },
                            {
                                      "q": "Lab profile of <b>DIC</b> (Platelets, PT/PTT, Fibrinogen, D-dimer)?",
                                      "a": "&darr; Platelets, &uarr; PT/PTT, &darr; Fibrinogen, &uarr; D-dimer."
                            },
                            {
                                      "q": "Deficiency in Thrombotic Thrombocytopenic Purpura (<b>TTP</b>)?",
                                      "a": "<b>ADAMTS13</b> (<b>vWF</b> cleaving protease)."
                            },
                            {
                                      "q": "<b>Pentad</b> of <b>TTP</b>?",
                                      "a": "Fever, Microangiopathic hemolytic anemia (MAHA), Thrombocytopenia, Renal failure, Neurological symptoms."
                            },
                            {
                                      "q": "Effect of Aspirin on platelet function?",
                                      "a": "Irreversible inhibition of COX-1 (inhibits TXA<sub>2</sub> synthesis)."
                            },
                            {
                                      "q": "Mechanism of <b>Heparin</b>?",
                                      "a": "Activates Antithrombin III."
                            },
                            {
                                      "q": "Antidote for <b>Heparin</b> overdose?",
                                      "a": "Protamine sulfate."
                            },
                            {
                                      "q": "Mechanism of <b>Warfarin</b>?",
                                      "a": "Inhibits Epoxide Reductase (interferes with Vitamin K recycling)."
                            },
                            {
                                      "q": "Most common inherited hypercoagulable state?",
                                      "a": "<b>Factor V Leiden</b> (resistance to Protein C cleavage)."
                            },
                            {
                                      "q": "Mutation associated with <b>Polycythemia Vera</b>?",
                                      "a": "<b>JAK2</b> kinase mutation."
                            },
                            {
                                      "q": "Clinical symptom unique to <b>Polycythemia Vera</b>?",
                                      "a": "Aquagenic pruritus (itching after a hot bath)."
                            },
                            {
                                      "q": "Major complication of Essential Thrombocythemia?",
                                      "a": "Bleeding AND thrombosis (paradoxical)."
                            },
                            {
                                      "q": "Bone marrow finding in <b>Myelofibrosis</b>?",
                                      "a": "\"Dry tap\" (extensive fibrosis) and Teardrop RBCs (<b>Dacrocytes</b>)."
                            },
                            {
                                      "q": "Storage form of iron in the marrow?",
                                      "a": "Hemosiderin."
                            },
                            {
                                      "q": "Target cells are typically seen in which three conditions?",
                                      "a": "HbC disease, Asplenia, Liver disease, <b>Thalassemia</b>. (\"<b>HALT</b>\")."
                            },
                            {
                                      "q": "<b>Heinz bodies</b> vs <b>Howell-Jolly</b> bodies (Composition)?",
                                      "a": "Heinz = Denatured Hemoglobin; <b>Howell-Jolly</b> = DNA remnants."
                            },
                            {
                                      "q": "<b>Sideroblastic Anemia</b> vs <b>Lead Poisoning</b> (Enzyme inhibited)?",
                                      "a": "Sideroblastic = <b>ALA Synthase</b>; Lead = ALA Dehydratase & Ferrochelatase."
                            },
                            {
                                      "q": "Primary site of heme degradation?",
                                      "a": "Splenic Macrophages (Heme &rarr; Biliverdin &rarr; Unconjugated Bilirubin)."
                            },
                            {
                                      "q": "Effect of CO<sub>2</sub> and H^+ (acid) on the Oxygen-Hemoglobin dissociation curve?",
                                      "a": "Right shift (Bohr effect) &rarr; increased O<sub>2</sub> unloading to tissues."
                            },
                            {
                                      "q": "Schistocytes + Normal PT/PTT?",
                                      "a": "<b>TTP</b> or <b>HUS</b>."
                            },
                            {
                                      "q": "Schistocytes + Prolonged PT/PTT?",
                                      "a": "<b>DIC</b>."
                            },
                            {
                                      "q": "Isolated &uarr; PTT that corrects with mixing study?",
                                      "a": "Factor deficiency (e.g., Hemophilia A/B)."
                            },
                            {
                                      "q": "Isolated &uarr; PTT that does NOT correct with mixing study?",
                                      "a": "Coagulation factor inhibitor (e.g., Lupus Anticoagulant)."
                            },
                            {
                                      "q": "Massive Splenomegaly + Pancytopenia + <b>TRAP</b> positive?",
                                      "a": "Hairy Cell Leukemia."
                            },
                            {
                                      "q": "Smudge cells on peripheral smear?",
                                      "a": "Chronic Lymphocytic Leukemia (CLL)."
                            },
                            {
                                      "q": "Lytic bone lesions + Hypercalcemia + Rash?",
                                      "a": "Adult T-cell Leukemia/Lymphoma (HTLV-1)."
                            },
                            {
                                      "q": "\"Starry sky\" appearance on lymph node biopsy?",
                                      "a": "Burkitt Lymphoma."
                            },
                            {
                                      "q": "Birbeck granules (tennis rackets) on EM?",
                                      "a": "Langerhans Cell Histiocytosis."
                            },
                            {
                                      "q": "Eosinophilic inclusions in the cytoplasm of plasma cells in <b>Multiple Myeloma</b>?",
                                      "a": "Russell bodies."
                            },
                            {
                                      "q": "Direct effect of 2,3-BPG on the hemoglobin oxygen affinity?",
                                      "a": "It stabilizes the T (Taut) state, shifting the curve to the right and promoting O<sub>2</sub> unloading."
                            },
                            {
                                      "q": "Why is the ESR (<i>Erythrocyte</i> Sedimentation Rate) increased in inflammation?",
                                      "a": "Fibrinogen (an acute phase reactant) coats RBCs, neutralizing their negative surface charge (<b>Zeta potential</b>) and allowing them to aggregate (<b>Rouleaux</b>)."
                            },
                            {
                                      "q": "Distinction between Hemoglobinuria and Myoglobinuria on dipstick?",
                                      "a": "Both show \"Blood\" on dipstick, but only Hemoglobinuria shows pink/red serum (Myoglobin is cleared rapidly, leaving serum clear)."
                            },
                            {
                                      "q": "What is the \"Rule of Three\" in RBC indices?",
                                      "a": "RBC &times; 3 &approx; Hb and Hb &times; 3 &approx; Hct."
                            },
                            {
                                      "q": "Most common cause of Death in <b>Sickle Cell</b> patients (Adults)?",
                                      "a": "<b>Acute Chest Syndrome</b>."
                            },
                            {
                                      "q": "Organism responsible for Osteomyelitis in <b>Sickle Cell</b> patients?",
                                      "a": "<i>Salmonella</i> (most common/classic) and <i>Staphylococcus</i> aureus."
                            },
                            {
                                      "q": "Effect of Hydroxyurea in <b>Sickle Cell</b> Disease?",
                                      "a": "Increases production of <b>HbF</b>, which interferes with the polymerization of HbS."
                            },
                            {
                                      "q": "Clinical finding in <b>Lead Poisoning</b> involving the gums?",
                                      "a": "<b>Burton lines</b> (bluish-gray lead sulfide deposits)."
                            },
                            {
                                      "q": "Mechanism of Bernard-Soulier Syndrome?",
                                      "a": "Deficiency of <b>GpIb</b>; impaired platelet-to-<b>vWF</b> adhesion."
                            },
                            {
                                      "q": "Classic finding on peripheral smear for Bernard-Soulier?",
                                      "a": "Giant platelets (often as large as RBCs)."
                            },
                            {
                                      "q": "Mechanism of Glanzmann Thrombasthenia?",
                                      "a": "Deficiency/defect of <b>GpIIb/IIIa</b>; impaired platelet-to-platelet aggregation."
                            },
                            {
                                      "q": "Ristocetin cofactor assay result in von Willebrand Disease (vWD)?",
                                      "a": "Abnormal (no agglutination), because <b>vWF</b> is required for Ristocetin-induced platelet clumping."
                            },
                            {
                                      "q": "Why is the PTT sometimes prolonged in vWD?",
                                      "a": "<b>vWF</b> acts as a stabilizer/carrier for Factor VIII."
                            },
                            {
                                      "q": "What is the \"Pseudo-Thrombocytopenia\" artifact in lab reports?",
                                      "a": "Platelet clumping in the test tube caused by EDTA (requires re-testing with a citrate tube)."
                            },
                            {
                                      "q": "Mechanism of Immune Thrombocytopenic Purpura (ITP)?",
                                      "a": "Anti-<b>GpIIb/IIIa</b> antibodies &rarr; splenic macrophage consumption of platelets."
                            },
                            {
                                      "q": "First-line treatment for ITP in a patient with a dangerously low platelet count?",
                                      "a": "IVIG (acts as a \"decoy\" for splenic macrophages) or Corticosteroids."
                            },
                            {
                                      "q": "Effect of Protein C/S deficiency on the body?",
                                      "a": "Hypercoagulability; unable to inactivate Factors Va and VIIIa."
                            },
                            {
                                      "q": "Why does <b>Warfarin</b> cause \"Skin Necrosis\" in Protein C deficient patients?",
                                      "a": "Protein C has a shorter half-life than Factors II, IX, and X; its rapid depletion creates a transient hypercoagulable state."
                            },
                            {
                                      "q": "Mechanism of Antithrombin III deficiency?",
                                      "a": "PTT fails to rise significantly after giving <b>Heparin</b> (<b>Heparin</b> resistance)."
                            },
                            {
                                      "q": "Difference between UFH (Unfractionated <b>Heparin</b>) and LMWH (Enoxaparin) mechanism?",
                                      "a": "UFH inhibits both Thrombin and Factor Xa; LMWH predominantly inhibits Factor Xa."
                            },
                            {
                                      "q": "Lab test used to monitor <b>Warfarin</b> therapy?",
                                      "a": "PT / INR."
                            },
                            {
                                      "q": "Direct Thrombin Inhibitors (e.g., Argatroban, Bivalirudin) are the treatment of choice for?",
                                      "a": "<b>Heparin</b>-Induced Thrombocytopenia (<b>HIT</b>)."
                            },
                            {
                                      "q": "Mutation found in almost 100% of Hairy Cell Leukemia cases?",
                                      "a": "BRAF V600E."
                            },
                            {
                                      "q": "Distinctive \"Dry Tap\" on bone marrow aspiration is seen in which two conditions?",
                                      "a": "Primary <b>Myelofibrosis</b> and Hairy Cell Leukemia."
                            },
                            {
                                      "q": "Difference between Leukemoid Reaction and <b>CML</b> regarding Basophils?",
                                      "a": "Basophilia is characteristic of <b>CML</b>, not a Leukemoid Reaction."
                            },
                            {
                                      "q": "Typical immunophenotype of CLL B-cells?",
                                      "a": "CD5+ and CD23+ (Note: CD5 is usually a T-cell marker)."
                            },
                            {
                                      "q": "What is a \"Richter Transformation\"?",
                                      "a": "CLL/SLL transforming into an aggressive Diffuse Large B-Cell Lymphoma (DLBCL)."
                            },
                            {
                                      "q": "\"Waldenstr\u00f6m Macroglobulinemia\" involves the overproduction of which Ig?",
                                      "a": "IgM (leads to hyperviscosity syndrome)."
                            },
                            {
                                      "q": "Radiographic \"Punch-out\" lesions in <b>Multiple Myeloma</b> are caused by?",
                                      "a": "RANKL activation of Osteoclasts (and inhibition of Osteoblasts)."
                            },
                            {
                                      "q": "Key difference between MGUS and <b>Multiple Myeloma</b>?",
                                      "a": "MGUS has &lt; 10% plasma cells in marrow and NO \"<b>CRAB</b>\" symptoms."
                            },
                            {
                                      "q": "Most common transfusion reaction?",
                                      "a": "Febrile Non-hemolytic Transfusion Reaction (caused by cytokines in stored blood)."
                            },
                            {
                                      "q": "Primary symptom of TRALI (Transfusion-Related Acute Lung Injury)?",
                                      "a": "Non-cardiogenic pulmonary edema (sudden onset respiratory distress/hypoxia)."
                            },
                            {
                                      "q": "Mechanism of Acute Hemolytic Transfusion Reaction?",
                                      "a": "Type II Hypersensitivity (preformed antibodies against donor ABO antigens)."
                            },
                            {
                                      "q": "Blood product used to rapidly reverse <b>Warfarin</b>?",
                                      "a": "Prothrombin Complex Concentrate (PCC) or Fresh Frozen Plasma (FFP)."
                            },
                            {
                                      "q": "Indication for giving \"Washed\" Red Blood Cells?",
                                      "a": "IgA deficiency (to prevent anaphylaxis)."
                            },
                            {
                                      "q": "Storage lesion of RBCs involves a decrease in which metabolite?",
                                      "a": "2,3-BPG (leads to increased O<sub>2</sub> affinity and decreased tissue delivery)."
                            },
                            {
                                      "q": "Definition of Pancytopenia?",
                                      "a": "Decrease in <b>all</b> three cell lines (RBCs, WBCs, and Platelets)."
                            },
                            {
                                      "q": "Most common cause of Aplastic Anemia?",
                                      "a": "Idiopathic (immune-mediated T-cell destruction of stem cells)."
                            },
                            {
                                      "q": "Morphology of RBCs in Myelophthisic Anemia?",
                                      "a": "Teardrop cells (<b>Dacrocytes</b>) \u2013 caused by the marrow being \"squeezed\" by fibrosis or tumor."
                            },
                            {
                                      "q": "Deficiency in Acute Intermittent Porphyria (AIP)?",
                                      "a": "Porphobilinogen (PBG) deaminase."
                            },
                            {
                                      "q": "The \"5 Ps\" of Acute Intermittent Porphyria symptoms?",
                                      "a": "Painful abdomen, Port wine-colored urine, Polyneuropathy, Psychological disturbances, Precipitated by drugs (CYP450 inducers)."
                            },
                            {
                                      "q": "Deficiency in Porphyria Cutanea Tarda (PCT)?",
                                      "a": "Uroporphyrinogen decarboxylase."
                            },
                            {
                                      "q": "Classic clinical presentation of Porphyria Cutanea Tarda?",
                                      "a": "Blistering cutaneous photosensitivity and hyperpigmentation (often associated with Hepatitis C)."
                            },
                            {
                                      "q": "Iron overload in the heart (Hemochromatosis) typically leads to?",
                                      "a": "Restrictive or Dilated Cardiomyopathy."
                            },
                            {
                                      "q": "Marker for identifying Hematopoietic Stem Cells (HSC)?",
                                      "a": "CD34+."
                            },
                            {
                                      "q": "Markers used to identify B-cell lineage via Flow Cytometry?",
                                      "a": "CD19, CD20, and CD21."
                            },
                            {
                                      "q": "Marker used to identify the monocyte lineage?",
                                      "a": "CD14 (the receptor for LPS)."
                            },
                            {
                                      "q": "What does a \"Shift to the Left\" signify in a CBC?",
                                      "a": "Increased presence of immature neutrophils (band cells), usually indicating acute infection or inflammation."
                            },
                            {
                                      "q": "How is the \"Mentzer Index\" used to differentiate <b>Iron Deficiency</b> from <b>Thalassemia</b>?",
                                      "a": "MCV / RBC count. If &lt; 13, it suggests <b>Thalassemia</b>; if &gt; 13, it suggests <b>Iron Deficiency</b>."
                            },
                            {
                                      "q": "Meaning of \"Anisocytosis\" on a lab report?",
                                      "a": "Variation in RBC size (measured by RDW - Red Cell Distribution Width)."
                            },
                            {
                                      "q": "Meaning of \"Poikilocytosis\"?",
                                      "a": "Variation in RBC shape."
                            },
                            {
                                      "q": "Mechanism of Parvovirus B19 induced anemia?",
                                      "a": "Directly infects and lyses Erythroid Precursor cells; causes Aplastic Crisis in patients with high RBC turnover (e.g., <b>Sickle Cell</b>)."
                            },
                            {
                                      "q": "Hallmark peripheral smear finding in Microangiopathic Hemolytic Anemia (MAHA)?",
                                      "a": "Schistocytes (Helmet cells)."
                            },
                            {
                                      "q": "What causes the \"Starry Sky\" appearance in Burkitt Lymphoma histology?",
                                      "a": "Tingible body macrophages (white \"stars\") consuming apoptotic B-cells (dark \"sky\")."
                            },
                            {
                                      "q": "Which enzyme is deficient in Methemoglobinemia?",
                                      "a": "Cytochrome b<sub>5</sub> reductase (Methemoglobin reductase)."
                            },
                            {
                                      "q": "Treatment for symptomatic Methemoglobinemia?",
                                      "a": "Methylene blue (reduces Fe<sup>3+</sup> back to Fe<sup>2+</sup>)."
                            },
                            {
                                      "q": "Clinical \"classic\" presentation of Methemoglobinemia?",
                                      "a": "Cyanosis (chocolate-colored blood) that does not improve with supplemental Oxygen."
                            },
                            {
                                      "q": "Diagnostic hallmark of Myelodysplastic Syndromes (MDS)?",
                                      "a": "\"Ringed Sideroblasts\" and \"Pseudo-Pelger-Hu\u00ebt anomaly\" (bilobed neutrophils)."
                            },
                            {
                                      "q": "Major risk of Myelodysplastic Syndrome (MDS)?",
                                      "a": "Transformation into Acute Myeloid Leukemia (<b>AML</b>)."
                            },
                            {
                                      "q": "In <b>Polycythemia Vera</b>, what happens to Serum <b>Erythropoietin</b> (<b>EPO</b>) levels?",
                                      "a": "<b>EPO</b> is low (negative feedback from high RBC mass)."
                            },
                            {
                                      "q": "Difference between \"Primary\" and \"Secondary\" Polycythemia?",
                                      "a": "Primary (PV) has low <b>EPO</b>; Secondary (Altitude, Smoking, RCC) has high <b>EPO</b>."
                            },
                            {
                                      "q": "Term for marrow being replaced by \"non-hematopoietic\" material (tumor, granuloma)?",
                                      "a": "Myelophthisis."
                            },
                            {
                                      "q": "Most common cause of Hydrops Fetalis?",
                                      "a": "&alpha;-<b>Thalassemia</b> (4-gene deletion; Hb Barts / &gamma;<sub>4</sub>)."
                            },
                            {
                                      "q": "Most common clinical presentation of Diamond-Blackfan Anemia?",
                                      "a": "Rapid-onset anemia in the 1st year of life, short stature, and craniofacial/thumb anomalies."
                            },
                            {
                                      "q": "Genetic defect in Fanconi Anemia?",
                                      "a": "DNA cross-link repair defect; leads to marrow failure and increased risk of <b>AML</b>."
                            },
                            {
                                      "q": "Typical physical findings in Fanconi Anemia?",
                                      "a": "Cafe-au-lait spots, short stature, and absent/hypoplastic thumbs."
                            },
                            {
                                      "q": "HbH disease involves how many &alpha;-globin gene deletions?",
                                      "a": "3 gene deletions (&beta;<sub>4</sub> tetramers)."
                            },
                            {
                                      "q": "What is \"Extramedullary Hematopoiesis\"?",
                                      "a": "RBC production outside the marrow (Spleen/Liver), often seen in <b>Thalassemia</b> or <b>Myelofibrosis</b>."
                            },
                            {
                                      "q": "Pathogenesis of \"Bony Bossing\" in <b>Thalassemia</b>?",
                                      "a": "Reactive marrow hyperplasia expanding the marrow space, leading to \"Chipmunk facies.\""
                            },
                            {
                                      "q": "Cause of \"Pain Crisis\" in <b>Sickle Cell</b> Disease?",
                                      "a": "Vaso-occlusion (infarction) in small vessels due to sickled RBCs."
                            },
                            {
                                      "q": "Immediate treatment for <b>Heparin</b>-Induced Thrombocytopenia (<b>HIT</b>)?",
                                      "a": "Stop <b>Heparin</b> immediately and start a Direct Thrombin Inhibitor (e.g., Argatroban)."
                            },
                            {
                                      "q": "Lab marker for effective <b>B12</b> replacement therapy?",
                                      "a": "Significant increase in <i>Reticulocyte</i> count within 3-5 days."
                            },
                            {
                                      "q": "Most common cause of Vitamin K deficiency in newborns?",
                                      "a": "Lack of gut flora and poor placental transfer (prevented by Vitamin K injection at birth)."
                            },
                            {
                                      "q": "Marker for identifying \"Blast\" cells in Acute Leukemia?",
                                      "a": "CD34 (marker of immaturity)."
                            },
                            {
                                      "q": "Most common genetic mutation in Systemic Mastocytosis?",
                                      "a": "KIT D816V mutation."
                            },
                            {
                                      "q": "Enzyme deficient in Congenital Erythropoietic Porphyria (Gunther Disease)?",
                                      "a": "Uroporphyrinogen III cosynthase."
                            },
                            {
                                      "q": "Effect of Hemolysis on Serum LDH (Lactate Dehydrogenase) and \uc65c?",
                                      "a": "LDH is significantly increased; it is an enzyme abundant inside RBCs released upon rupture."
                            },
                            {
                                      "q": "What is the \"Ham Test\" (Acidified Serum Test) historically used for?",
                                      "a": "Paroxysmal Nocturnal Hemoglobinuria (<b>PNH</b>) \u2013 superseded by flow cytometry for CD55/59."
                            },
                            {
                                      "q": "\"Pencil Cells\" on peripheral smear are characteristic of?",
                                      "a": "<b>Iron Deficiency</b> Anemia."
                            },
                            {
                                      "q": "\"<b>Acanthocytes</b>\" (Spur Cells) are most commonly associated with?",
                                      "a": "Liver disease or Abetalipoproteinemia."
                            },
                            {
                                      "q": "\"<b>Echinocytes</b>\" (Burr Cells) are most commonly associated with?",
                                      "a": "Uremia (Renal Failure) or Pyruvate Kinase deficiency."
                            },
                            {
                                      "q": "\"<b>Degmacytes</b>\" is the technical term for which cell type?",
                                      "a": "<b>Bite Cells</b> (seen in <b>G6PD</b> deficiency)."
                            },
                            {
                                      "q": "What are \"<b>Cabot Rings</b>\" and when are they seen?",
                                      "a": "Remnants of the mitotic spindle; seen in <b>Megaloblastic Anemia</b> or <b>Lead Poisoning</b>."
                            },
                            {
                                      "q": "Mechanism of Hereditary Hemorrhagic Telangiectasia (Osler-Weber-Rendu)?",
                                      "a": "Autosomal dominant disorder of blood vessels leading to telangiectasias and AVMs."
                            },
                            {
                                      "q": "Screening test for Factor XIII deficiency?",
                                      "a": "5-Molar Urea Solubility Test (Standard PT/PTT will be normal)."
                            },
                            {
                                      "q": "Function of Protein S?",
                                      "a": "Acts as a cofactor for Protein C to inactivate Factors Va and VIIIa."
                            },
                            {
                                      "q": "What is \"Lupus Anticoagulant\" paradox?",
                                      "a": "It prolongs PTT in vitro but causes a hypercoagulable state (thrombosis) in vivo."
                            },
                            {
                                      "q": "Most common cause of \"Acquired\" Hemophilia?",
                                      "a": "Autoantibodies against Factor VIII (often postpartum or malignancy-associated)."
                            },
                            {
                                      "q": "What are \"Pitting\" and \"Culling\" in the spleen?",
                                      "a": "Pitting: Removing inclusions (<b>Heinz bodies</b>) without destroying the cell. Culling: Removing damaged RBCs entirely."
                            },
                            {
                                      "q": "Immunological consequence of Splenectomy?",
                                      "a": "Decreased IgM and decreased complement activation, leading to susceptibility to encapsulated organisms."
                            },
                            {
                                      "q": "The \"Encapsulated Trio\" to vaccinate against post-splenectomy?",
                                      "a": "S. pneumoniae, H. influenzae type b, and N. meningitidis."
                            },
                            {
                                      "q": "Cause of \"Gaucher Cells\" (crinkled paper appearance) in the marrow?",
                                      "a": "Glucocerebrosidase deficiency."
                            },
                            {
                                      "q": "Specific antidote for Dabigatran?",
                                      "a": "Idarucizumab."
                            },
                            {
                                      "q": "Specific antidote for Factor Xa inhibitors (Rivaroxaban/Apixaban)?",
                                      "a": "Andexanet alfa."
                            },
                            {
                                      "q": "Primary side effect of Desmopressin (DDAVP) when treating vWD?",
                                      "a": "Hyponatremia (due to its ADH-like effect)."
                            },
                            {
                                      "q": "What is \"Leucovorin Rescue\" used for?",
                                      "a": "To reduce the toxicity of high-dose Methotrexate by providing a source of reduced <b>folate</b>."
                            },
                            {
                                      "q": "Formula for Mean Corpuscular Hemoglobin Concentration (MCHC)?",
                                      "a": "MCHC = (Hemoglobin / Hematocrit) &times; 100."
                            },
                            {
                                      "q": "What condition is the ONLY one with an increased MCHC?",
                                      "a": "Hereditary Spherocytosis (due to membrane loss and cellular dehydration)."
                            },
                            {
                                      "q": "Corrected <i>Reticulocyte</i> Count formula?",
                                      "a": "Retics % &times; (Hct / 45)."
                            },
                            {
                                      "q": "How many days does it take for a <i>Reticulocyte</i> to mature in the peripheral blood?",
                                      "a": "Approximately 1 day."
                            },
                            {
                                      "q": "Differentiate \"<b>Iron Deficiency</b>\" vs \"Anemia of Chronic Disease\" via TIBC?",
                                      "a": "Iron Def: TIBC is &uarr;. Chronic Disease: TIBC is &darr;."
                            },
                            {
                                      "q": "Differentiate \"Leukemoid Reaction\" vs \"<b>CML</b>\" via Cytogenetics?",
                                      "a": "<b>CML</b> will have t(9;22); Leukemoid reaction will be cytogenetically normal."
                            },
                            {
                                      "q": "Differentiate \"<b>TTP</b>\" vs \"<b>HUS</b>\" in clinical presentation?",
                                      "a": "<b>HUS</b> typically presents with bloody diarrhea (EHEC) and predominant renal failure; <b>TTP</b> has more neurological symptoms."
                            },
                            {
                                      "q": "Differentiate \"Follicular Lymphoma\" vs \"Reactive Lymph Node Hyperplasia\"?",
                                      "a": "Follicular Lymphoma: BCL-2 (+), lacks tingible body macrophages, monoclonal."
                            },
                            {
                                      "q": "Differentiate \"<b>Multiple Myeloma</b>\" vs \"Primary Amyloidosis\" (AL)?",
                                      "a": "MM is a plasma cell malignancy; AL is a protein folding disorder (misfolded light chains) often secondary to a plasma cell dyscrasia."
                            },
                            {
                                      "q": "Most common inherited cause of <b>Sideroblastic Anemia</b>?",
                                      "a": "X-linked deficiency of ALAS2 (erythroid-specific &delta;-aminolevulinic acid synthase)."
                            },
                            {
                                      "q": "Direct effect of Lead on the heme pathway enzymes?",
                                      "a": "Inhibits Ferrochelatase and ALA Dehydratase."
                            },
                            {
                                      "q": "Which enzyme deficiency is protected against P. falciparum malaria?",
                                      "a": "<b>G6PD</b> deficiency and Pyruvate Kinase deficiency."
                            },
                            {
                                      "q": "Mechanism of Pyruvate Kinase (PK) deficiency?",
                                      "a": "&darr; ATP &rarr; rigid RBCs &rarr; extravascular hemolysis in the splenic red pulp."
                            },
                            {
                                      "q": "Distinctive finding on peripheral smear for Pyruvate Kinase deficiency?",
                                      "a": "<b>Echinocytes</b> (Burr cells) that are not related to uremia."
                            },
                            {
                                      "q": "What is the \"<b>TRAP</b>\" stain?",
                                      "a": "Tartrate-Resistant Acid Phosphatase; used for Hairy Cell Leukemia."
                            },
                            {
                                      "q": "Typical immunophenotype for Hairy Cell Leukemia?",
                                      "a": "CD11c, CD25, CD103."
                            },
                            {
                                      "q": "The \"<b>Sezary Syndrome</b>\" triad?",
                                      "a": "Erythroderma, Lymphadenopathy, and circulating Sezary cells (cerebriform nuclei)."
                            },
                            {
                                      "q": "Distinction between <b>Myelofibrosis</b> and <b>CML</b> on marrow biopsy?",
                                      "a": "<b>Myelofibrosis</b> shows \"collagen fibrosis\" (Silver/Reticulin stain); <b>CML</b> is hypercellular with myeloid maturation."
                            },
                            {
                                      "q": "What is \"Aleukemic Leukemia\"?",
                                      "a": "Leukemia where the abnormal cells are confined to the marrow; the peripheral WBC count is normal or low."
                            },
                            {
                                      "q": "Why is the \"Bleeding Time\" usually normal in Hemophilia?",
                                      "a": "Bleeding time tests primary hemostasis (platelets); Hemophilia is a defect in secondary hemostasis (clotting factors)."
                            },
                            {
                                      "q": "Mechanism of Tranexamic Acid (TXA)?",
                                      "a": "Antifibrinolytic; inhibits Plasminogen activation to Plasmin."
                            },
                            {
                                      "q": "What is \"Glucanzmann Thrombasthenia\" vs \"Bernard-Soulier\" on Ristocetin test?",
                                      "a": "Bernard-Soulier: No agglutination with Ristocetin. Glanzmann: Normal agglutination with Ristocetin (but fails with ADP/Collagen)."
                            },
                            {
                                      "q": "What is the \"Russell Viper Venom Time\" (dRVVT) used for?",
                                      "a": "To confirm the presence of Lupus Anticoagulant (Antiphospholipid Syndrome)."
                            },
                            {
                                      "q": "What is \"Hemoglobin Barts\"?",
                                      "a": "&gamma;<sub>4</sub> (four gamma chains); seen in 4-gene deletion &alpha;-<b>Thalassemia</b> (Hydrops Fetalis)."
                            },
                            {
                                      "q": "What is \"Hemoglobin H\"?",
                                      "a": "&beta;<sub>4</sub> (four beta chains); seen in 3-gene deletion &alpha;-<b>Thalassemia</b>."
                            },
                            {
                                      "q": "Effect of \"Acidosis\" on the P50 of the Oxygen-Hb curve?",
                                      "a": "Increases the P50 (shifts curve to the right, meaning lower affinity)."
                            },
                            {
                                      "q": "What is the \"P50\"?",
                                      "a": "The partial pressure of oxygen at which hemoglobin is 50% saturated."
                            },
                            {
                                      "q": "Which Hemoglobin variant is most \"Polymerization-prone\"?",
                                      "a": "Deoxygenated HbS."
                            },
                            {
                                      "q": "Why is Cimetidine or Sulfa drugs dangerous for <b>G6PD</b> patients?",
                                      "a": "They induce oxidative stress, leading to Hemolysis."
                            },
                            {
                                      "q": "Treatment of choice for \"Iron Overload\" (Hemochromatosis)?",
                                      "a": "Therapeutic phlebotomy (or Deferoxamine/Deferasirox chelation if phlebotomy is contraindicated)."
                            },
                            {
                                      "q": "Common side effect of <b>EPO</b> (<b>Erythropoietin</b>) therapy?",
                                      "a": "Hypertension and increased risk of thromboembolic events."
                            },
                            {
                                      "q": "What is the \"D-dimer\" specifically measuring?",
                                      "a": "Fibrin degradation products that have been cross-linked by Factor XIII."
                            },
                            {
                                      "q": "Association: Thymoma?",
                                      "a": "Pure Red Cell Aplasia (PRCA) or Myasthenia Gravis."
                            },
                            {
                                      "q": "Association: \"Doughnut-shaped\" nuclei in neutrophils?",
                                      "a": "Pseudo-Pelger-Huet anomaly (Myelodysplastic Syndrome)."
                            },
                            {
                                      "q": "Association: \"Hyper-segmented\" neutrophils + Glossitis?",
                                      "a": "<b>Megaloblastic Anemia</b> (<b>B12</b> or <b>Folate</b>)."
                            },
                            {
                                      "q": "Association: Pruritus after a hot shower?",
                                      "a": "<b>Polycythemia Vera</b> (Mast cell degranulation)."
                            }
                  ]
