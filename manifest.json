{
  "manifest_version": 3,
  "name": "MediHelp Now",
  "version": "1.0.0",
  "description": "Audit medical bills, search codes, compare drug prices - locally and privately.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://rxnav.nlm.nih.gov/*",
    "https://bisqgousuvljttesjkkm.supabase.co/*",
    "https://npiregistry.cms.hhs.gov/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
